   // FIX: Permettre d'utiliser le verdict serveur si local est WAIT mais serveur GOOD/PERFECT + 3 TF alignés
   int vn = g_smcGomVerdictNum;
   if(vn == 0)
   {
      vn = g_smcGomVerdictNumServer;
      if(MathAbs(vn) < 2) return false;
      if(!SMCGP_SpikeAlignedGoodProtected(symbol, vn)) return false;
   }
   else
   {
      if(MathAbs(vn) < 2) vn = g_smcGomVerdictNumServer;
      if(!g_smcGomConnected && MathAbs(g_smcGomVerdictNumServer) < 2) return false;
      if(MathAbs(vn) < 2) return false;
   }
   int vnSign = (vn > 0) ? 1 : -1;
   if(vnSign != dirSign) return false;
   if(!SMCGP_MTFTripleAligned(dirSign)) return false;
   return true;
}

