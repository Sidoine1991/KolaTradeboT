void SMCGP_CacheVerdict(const string symbol, int vn, const string &verdict)
{
   string sym = symbol;
   StringToUpper(sym);
   string chartSym = _Symbol;
   StringToUpper(chartSym);
   bool isChartSymbol = (sym == chartSym);
   for(int i = 0; i < g_gomCacheCount; i++)
   {
      if(g_gomCacheSym[i] == sym)
      {
         g_gomCacheVn[i] = vn;
         g_gomCacheVerdict[i] = verdict;
         g_gomCacheTime[i] = TimeCurrent();
         g_gomCacheMarketPriceFresh[i] = (isChartSymbol && g_smcMarketPriceFresh);
         g_gomCacheForecast5mReady[i] = (isChartSymbol && g_smcForecast5mReady);
         g_gomCacheForecast5mVn[i] = isChartSymbol ? g_smcGomVerdictForecastNum : 0;
         g_gomCacheForecast5mHorizon[i] = isChartSymbol ? g_smcForecastHorizonMinutes : 0;
         g_gomCacheMarketPriceAgeSec[i] = isChartSymbol ? g_smcMarketPriceAgeSec : 1000000.0;
         g_gomCacheForecastLastUpdate[i] = isChartSymbol ? g_smcForecastLastUpdate : 0;
         g_gomCacheServerVerdictLastUpdate[i] = isChartSymbol ? g_smcServerVerdictLastUpdate : 0;
         g_gomCacheM1ScalpSimpleAllowed[i] =
            (isChartSymbol && g_smcM1ScalpSimpleAllowed);
         return;
      }
   }
   if(g_gomCacheCount < GOM_CACHE_MAX)
   {
      g_gomCacheSym[g_gomCacheCount] = sym;
      g_gomCacheVn[g_gomCacheCount] = vn;
      g_gomCacheVerdict[g_gomCacheCount] = verdict;
      g_gomCacheTime[g_gomCacheCount] = TimeCurrent();
      g_gomCacheMarketPriceFresh[g_gomCacheCount] = (isChartSymbol && g_smcMarketPriceFresh);
      g_gomCacheForecast5mReady[g_gomCacheCount] = (isChartSymbol && g_smcForecast5mReady);
      g_gomCacheForecast5mVn[g_gomCacheCount] = isChartSymbol ? g_smcGomVerdictForecastNum : 0;
      g_gomCacheForecast5mHorizon[g_gomCacheCount] = isChartSymbol ? g_smcForecastHorizonMinutes : 0;
      g_gomCacheMarketPriceAgeSec[g_gomCacheCount] = isChartSymbol ? g_smcMarketPriceAgeSec : 1000000.0;
      g_gomCacheForecastLastUpdate[g_gomCacheCount] = isChartSymbol ? g_smcForecastLastUpdate : 0;
      g_gomCacheServerVerdictLastUpdate[g_gomCacheCount] = isChartSymbol ? g_smcServerVerdictLastUpdate : 0;
      g_gomCacheM1ScalpSimpleAllowed[g_gomCacheCount] =
         (isChartSymbol && g_smcM1ScalpSimpleAllowed);
      g_gomCacheCount++;
   }
}

int SMCGP_GetCachedVerdictNum(const string symbol)
{
   string sym = symbol;
   StringToUpper(sym);
   for(int i = 0; i < g_gomCacheCount; i++)
   {
      if(g_gomCacheSym[i] == sym)
      {
         if(TimeCurrent() - g_gomCacheTime[i] > 120) return -999;
         return g_gomCacheVn[i];
      }
   }
   return -999;
}

// Comme SMCGP_GetCachedVerdictNum mais renvoie le libellé texte ("GOOD SELL"...).
// Retourne "" si rien de valide en cache (même règle des 120s).
string SMCGP_GetCachedVerdictStr(const string symbol)
{
   string sym = symbol;
   StringToUpper(sym);
   for(int i = 0; i < g_gomCacheCount; i++)
   {
      if(g_gomCacheSym[i] == sym)
      {
         if(TimeCurrent() - g_gomCacheTime[i] > 120) return "";
         return g_gomCacheVerdict[i];
      }
   }
   return "";
}

bool SMCGP_EntryVerdictAllowsTrade(const string symbol, string &reasonOut)
{
   reasonOut = "";
   string resolvedSymbol = (StringLen(symbol) > 0) ? symbol : _Symbol;
   int verdictNum = -999;
   string verdictText = "";
   int serverVerdictNum = -999;
   datetime verdictTime = 0;

   if(resolvedSymbol == _Symbol)
   {
      verdictNum = g_smcGomVerdictNum;
      verdictText = g_smcGomVerdict;
      serverVerdictNum = g_smcGomVerdictNumServer;
      verdictTime = g_smcLastGOMPoll;
      if(verdictNum == 0 && MathAbs(serverVerdictNum) >= 2)
      {
         verdictNum = serverVerdictNum;
         verdictText = (StringLen(g_smcGomVerdictServer) > 0) ? g_smcGomVerdictServer
                           : ((serverVerdictNum > 0) ? "GOOD BUY" : "GOOD SELL");
      }
      if(MathAbs(verdictNum) >= 2)
         return true;
      if(!g_smcGomConnected && !SMCGP_GomLinkOK())
      {
         reasonOut = "GOM déconnecté";
         return false;
      }
   }
   else
   {
      verdictNum = SMCGP_GetCachedVerdictNum(resolvedSymbol);
      verdictText = SMCGP_GetCachedVerdictStr(resolvedSymbol);
      string upperSymbol = resolvedSymbol;
      StringToUpper(upperSymbol);
      for(int i = 0; i < g_gomCacheCount; i++)
      {
         if(g_gomCacheSym[i] == upperSymbol)
         {
            verdictTime = g_gomCacheTime[i];
            break;
         }
      }
   }

   if(MathAbs(verdictNum) >= 2)
      return true;
   StringToUpper(verdictText);
   if(verdictNum == 0 || verdictNum == -999 ||
      StringFind(verdictText, "WAIT") >= 0)
   {
      reasonOut = "verdict GOM WAIT ou absent";
      return false;
   }
   if(verdictTime <= 0 || TimeCurrent() - verdictTime > 300)
   {
      reasonOut = "verdict GOM périmé";
      return false;
   }

   return true;
}

bool SMC_GOMCurrentVerdictIsWait(const string symbol)
{
   string resolvedSymbol = (StringLen(symbol) > 0) ? symbol : _Symbol;
   int verdictNum;
   string verdictText;
   bool marketPriceFresh = false;
   bool forecast5mReady = false;
   int forecast5mVn = 0;
   int forecast5mHorizon = 0;
   double marketPriceAgeSec = 1000000.0;
   bool m1ScalpSimpleAllowed = false;
   if(resolvedSymbol == _Symbol)
   {
      verdictNum = g_smcGomVerdictNum;
      verdictText = g_smcGomVerdict;
      marketPriceFresh = g_smcMarketPriceFresh;
      forecast5mReady = g_smcForecast5mReady;
      forecast5mVn = g_smcGomVerdictForecastNum;
      forecast5mHorizon = g_smcForecastHorizonMinutes;
      marketPriceAgeSec = g_smcMarketPriceAgeSec +
                          (double)MathMax(0, (int)(TimeCurrent() - g_smcLastGOMPoll));
      m1ScalpSimpleAllowed = g_smcM1ScalpSimpleAllowed;
      
      // FIX: Si verdict local est WAIT mais serveur GOOD/PERFECT + 3 TF alignés,
      // ne PAS bloquer (considérer comme non-WAIT pour permettre le trade)
      if(verdictNum == 0 && MathAbs(g_smcGomVerdictNumServer) >= 2)
      {
         return false;
      }
   }
   else
   {
      verdictNum = SMCGP_GetCachedVerdictNum(resolvedSymbol);
      verdictText = SMCGP_GetCachedVerdictStr(resolvedSymbol);
      string upperSymbol = resolvedSymbol;
      StringToUpper(upperSymbol);
      for(int i = 0; i < g_gomCacheCount; i++)
      {
         if(g_gomCacheSym[i] != upperSymbol) continue;
         marketPriceFresh = g_gomCacheMarketPriceFresh[i];
         forecast5mReady = g_gomCacheForecast5mReady[i];
         forecast5mVn = g_gomCacheForecast5mVn[i];
         forecast5mHorizon = g_gomCacheForecast5mHorizon[i];
         marketPriceAgeSec = g_gomCacheMarketPriceAgeSec[i] +
                             (double)(TimeCurrent() - g_gomCacheTime[i]);
         m1ScalpSimpleAllowed = g_gomCacheM1ScalpSimpleAllowed[i];
         break;
      }
   }
   if(resolvedSymbol == _Symbol &&
      SMC_SpikeChainGomEntryOverrideAllowed(
         resolvedSymbol, (g_smcGomVerdictNumServer > 0) ? 1 : -1))
      return false;
   if(MathAbs(verdictNum) >= 2)
      return false;
   if(resolvedSymbol == _Symbol && MathAbs(g_smcGomVerdictNumServer) >= 2)
      return false;
   StringToUpper(verdictText);
   if(verdictNum == -999 || verdictNum == 0)
      return true;
   if(!marketPriceFresh || marketPriceAgeSec < 0.0 || marketPriceAgeSec > 90.0)
      return false;
   if(!forecast5mReady || forecast5mHorizon != 5 || forecast5mVn == 0)
      return false;
   if((verdictNum > 0) == (forecast5mVn > 0))
      return false;
   if(MathAbs(forecast5mVn) >= 2)
      return true;
   return !(m1ScalpSimpleAllowed && MathAbs(verdictNum) == 1);
}

bool SMCGP_M1ScalpSimpleAllowsDirection(const string symbol, const int dirSign)
{
   if(symbol != _Symbol || dirSign == 0 || !g_smcM1ScalpSimpleAllowed ||
      !g_smcGomEntryAllowed || MathAbs(g_smcGomVerdictNum) != 1 ||
      ((g_smcGomVerdictNum > 0) != (dirSign > 0)) ||
      !g_smcGomConnected || g_smcLastGOMPoll <= 0 ||
      TimeCurrent() - g_smcLastGOMPoll > 90 ||
      !g_smcMarketPriceFresh || g_smcMarketPriceAgeSec < 0.0 ||
      g_smcMarketPriceAgeSec > 90.0)
      return false;

   string m1Dir = (StringLen(g_smcTfM1DirLive) > 0) ? g_smcTfM1DirLive : g_smcTfM1Dir;
   StringToUpper(m1Dir);
   return (dirSign > 0)
      ? (StringFind(m1Dir, "BULL") >= 0 || m1Dir == "BUY" || m1Dir == "UP")
      : (StringFind(m1Dir, "BEAR") >= 0 || m1Dir == "SELL" || m1Dir == "DOWN");
}

void SMCGP_ApplyCurrentMarketForecastGate(const string symbol)
{
   if(g_smcGomVerdictNum == 0 && MathAbs(g_smcGomVerdictNumServer) >= 2)
      SMCGP_RestoreAlignedGoodIfWait(symbol);
   int vn = g_smcGomVerdictNum;
   if(vn == 0)
   {
      g_smcGomEntryAllowed = false;
      return;
   }
   if(g_smcGomVerdictForecastNum == 0 && MathAbs(vn) >= 1)
   {
      g_smcGomVerdictForecastNum = vn;
      g_smcForecast5mReady = true;
      g_smcForecastHorizonMinutes = 5;
   }
   if(MathAbs(vn) >= 2)
   {
      g_smcGomEntryAllowed = true;
      g_smcGomCorrectionWait = false;
      return;
   }

   bool snapshotValid = g_smcMarketPriceFresh && g_smcGomPrice > 0.0 &&
                        g_smcMarketPriceAgeSec >= 0.0 && g_smcMarketPriceAgeSec <= 90.0;
   bool forecastValid = g_smcForecast5mReady && g_smcForecastHorizonMinutes == 5 &&
                        g_smcGomVerdictForecastNum != 0;
   bool forecastOpposes = (forecastValid &&
                           ((vn > 0) != (g_smcGomVerdictForecastNum > 0)));
   bool strongForecastOpposition = (forecastOpposes &&
                                    MathAbs(g_smcGomVerdictForecastNum) >= 2);
   bool weakForecastOpposition = (forecastOpposes &&
                                  MathAbs(g_smcGomVerdictForecastNum) == 1);
   int nativeDir = IsBoomLikeSymbol(symbol) ? 1 : (IsCrashLikeSymbol(symbol) ? -1 : 0);
   string h4Dir = g_smcTfH4Dir, d1Dir = g_smcTfD1Dir;
   StringToUpper(h4Dir);
   StringToUpper(d1Dir);
   bool htfAligned = (nativeDir != 0 &&
                      ((nativeDir > 0 &&
                        (StringFind(h4Dir, "BULL") >= 0 || h4Dir == "BUY" || h4Dir == "UP") &&
                        (StringFind(d1Dir, "BULL") >= 0 || d1Dir == "BUY" || d1Dir == "UP")) ||
                       (nativeDir < 0 &&
                        (StringFind(h4Dir, "BEAR") >= 0 || h4Dir == "SELL" || h4Dir == "DOWN") &&
                        (StringFind(d1Dir, "BEAR") >= 0 || d1Dir == "SELL" || d1Dir == "DOWN"))));
   bool qualifiedSpikeSimple = (g_smcSpikeHTFSimpleAllowed &&
                                MathAbs(vn) == 1 &&
                                ((vn > 0) ? 1 : -1) == nativeDir &&
                                weakForecastOpposition && htfAligned);
if(strongForecastOpposition)
   {
      g_smcGomEntryAllowed = false;
      g_smcGomCorrectionReason = "5M_FORECAST_STRONGLY_OPPOSES_VERDICT";
      Print("[GOM-MARKET-5M] ", symbol, " pause entrée (verdict inchangé vn=", vn,
            ") | forecastVn=", g_smcGomVerdictForecastNum);
      return;
   }
   if(weakForecastOpposition && !g_smcM1ScalpSimpleAllowed && !qualifiedSpikeSimple)
   {
      g_smcGomEntryAllowed = (MathAbs(vn) >= 2);
      g_smcGomCorrectionReason = "5M_FORECAST_WEAK_OPPOSE";
      return;
   }

   if(weakForecastOpposition && g_smcM1ScalpSimpleAllowed && MathAbs(vn) < 2)
   {
      g_smcGomVerdictNum = (vn > 0) ? 1 : -1;
      g_smcGomVerdict = SMCGP_VerdictTextFromNum(g_smcGomVerdictNum);
      g_smcGomEntryAllowed = true;
      g_smcGomCorrectionReason = "weak opposing 5m forecast; confirmed M1 scalp SIMPLE";
      return;
   }

   if(qualifiedSpikeSimple)
   {
      g_smcGomEntryAllowed = false;
      g_smcGomCorrectionReason = "weak opposing 5m forecast; server-approved D1/H4 spike SIMPLE";
      Print("[GOM-MARKET-5M] ", symbol,
            " → SPIKE SIMPLE (réservé au blink) | D1/H4 alignés | forecastVn=",
            g_smcGomVerdictForecastNum);
      return;
   }

   if(forecastValid)
   {
      if(MathAbs(vn) >= 2)
      {
         g_smcGomEntryAllowed = true;
      }
      else
      {
         int cap = (int)MathMin(MathAbs(vn), MathAbs(g_smcGomVerdictForecastNum));
         int cappedVn = (vn > 0) ? cap : -cap;
         if(cappedVn != vn)
         {
            Print("[GOM-MARKET-5M] ", symbol, " cap verdict ", vn, " → ", cappedVn);
            g_smcGomVerdictNum = cappedVn;
            g_smcGomVerdict = SMCGP_VerdictTextFromNum(cappedVn);
            if(MathAbs(cappedVn) < 2 &&
               !SMCGP_M1ScalpSimpleAllowsDirection(symbol, cappedVn > 0 ? 1 : -1))
               g_smcGomEntryAllowed = false;
         }
      }
   }
   else if(MathAbs(vn) == 1 &&
           !SMCGP_M1ScalpSimpleAllowsDirection(symbol, vn > 0 ? 1 : -1))
   {
      g_smcGomEntryAllowed = false;
   }
}

// ── ENFORCEMENT: supprimer les LIMIT contre-tendance + max 2 par symbole ──
// À appeler périodiquement (OnTick / OnTimer)
void SMCGP_EnforceLimitDiscipline(const long magic, const int maxLimits = 2)
{
   // Ne PAS exiger g_smcGomConnected : sous WAIT (vn=0) on doit annuler les LIMIT
   // même si le serveur GOM est temporairement down. Le cache conserve le dernier
   // verdict connu. On ne touche pas si le verdict est inconnu (vn=-999).
   if(!g_smcGomConnected && g_smcLastGOMPoll > 0 && TimeCurrent() - g_smcLastGOMPoll > 900)
      return; // déconnexion > 15 min + cache périmé → on ne risque pas d'annuler à tort

   // 1) Supprimer les ordres LIMIT qui vont contre le verdict en cache
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(OrderGetInteger(ORDER_MAGIC) != magic) continue;

      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(t != ORDER_TYPE_BUY_LIMIT && t != ORDER_TYPE_SELL_LIMIT) continue;

       string sym = OrderGetString(ORDER_SYMBOL);
       // Ne jamais toucher aux ordres LIMIT DOW (ancrés sur DOW PROJ)
       string cmt = OrderGetString(ORDER_COMMENT);
       if(StringFind(cmt, "DOW") >= 0)
          continue;

       // Grâce discipline LIMIT (3-5 min) — ne pas supprimer un LIMIT trop jeune
       if(!LimitCancelAllowed(ticket, false, "EnforceLimitDiscipline"))
          continue;

       int vn = 0;
       if(g_smcGomConnected)
       {
          // D'abord vérifier le verdict global actuel
          if(g_smcGomVerdictNum == 0)
          {
             vn = 0; // Verdict global est WAIT - bloquer immédiatement
          }
          else
          {
             // Si le verdict global n'est pas WAIT, utiliser le cache pour le symbole spécifique
             int vnSym = SMCGP_GetCachedVerdictNum(sym);
             vn = (vnSym != -999) ? vnSym : ((sym == _Symbol) ? g_smcGomVerdictNum : 0);
          }
       }
       else
       {
          vn = 0; // Pas connecté = WAIT par défaut
       }

       bool isBuyLimit = (t == ORDER_TYPE_BUY_LIMIT);
      // Ordres contraires Boom/Gainx (SELL) et Crash/Painx (BUY) — suppression immédiate
      string dirStr = isBuyLimit ? "BUY" : "SELL";
      if(!IsDirectionAllowedForBoomCrash(sym, dirStr))
      {
         LimitSafeOrderDelete(ticket, true, "contre-tendance Boom/Crash " + dirStr);
         continue;
      }
      // WAIT / SIMPLE (|vn|<2) : annuler les limits non-DOW (après délai min)
      bool waitOrWeak = (vn == 0 || MathAbs(vn) < 2);
      bool against = (isBuyLimit && vn < 0) || (!isBuyLimit && vn > 0);
      if(waitOrWeak || against)
      {
         string why = waitOrWeak ? "WAIT/WEAK" : "contre-tendance";
         LimitSafeOrderDelete(ticket, false,
                              why + " GOM vn=" + IntegerToString(vn) + " " + sym);
      }
   }

   // 2) Limiter à maxLimits ordres LIMIT par symbole
   struct LimInf { ulong ticket; double price; datetime tm; };
   string syms[]; int symCnt = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(OrderGetInteger(ORDER_MAGIC) != magic) continue;
      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(t != ORDER_TYPE_BUY_LIMIT && t != ORDER_TYPE_SELL_LIMIT) continue;
      string sym = OrderGetString(ORDER_SYMBOL);
      bool found = false;
      for(int s = 0; s < symCnt; s++) if(syms[s] == sym) { found = true; break; }
      if(!found) { ArrayResize(syms, symCnt + 1); syms[symCnt] = sym; symCnt++; }
   }
   for(int s = 0; s < symCnt; s++)
   {
      LimInf arr[]; int cnt = 0;
      for(int i = OrdersTotal() - 1; i >= 0; i--)
      {
         ulong ticket = OrderGetTicket(i);
         if(ticket == 0) continue;
         if(OrderGetInteger(ORDER_MAGIC) != magic) continue;
         ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
         if(t != ORDER_TYPE_BUY_LIMIT && t != ORDER_TYPE_SELL_LIMIT) continue;
         if(OrderGetString(ORDER_SYMBOL) != syms[s]) continue;
         // Ne jamais compter/supprimer un LIMIT DOW comme excédentaire
         if(StringFind(OrderGetString(ORDER_COMMENT), "DOW") >= 0) continue;
         int sz = cnt++; ArrayResize(arr, sz + 1);
         arr[sz].ticket = ticket;
         arr[sz].price  = OrderGetDouble(ORDER_PRICE_OPEN);
         arr[sz].tm     = (datetime)OrderGetInteger(ORDER_TIME_SETUP);
      }
      int excess = cnt - maxLimits;
      if(excess <= 0) continue;
      // Trier : supprimer les plus éloignés du prix d'abord (les plus vieux/lointains)
      int digits = (int)SymbolInfoInteger(syms[s], SYMBOL_DIGITS);
      double cur = SymbolInfoDouble(syms[s], SYMBOL_BID);
      for(int a = 0; a < cnt - 1; a++)
         for(int b = a + 1; b < cnt; b++)
         {
            double da = MathAbs(arr[a].price - cur);
            double db = MathAbs(arr[b].price - cur);
            if(da > db) { LimInf tmp = arr[a]; arr[a] = arr[b]; arr[b] = tmp; }
         }
      for(int k = 0; k < excess; k++)
      {
         LimitSafeOrderDelete(arr[k].ticket, false,
                              "LIMIT excédentaire sym=" + syms[s]);
      }
   }

   // 3) Plafond terminal: max MaxLimitOrdersTerminal LIMIT pending (tout symbole confondu)
   int termTotal = CountOpenLimitOrdersTerminal();
   int termExcess = termTotal - MaxLimitOrdersTerminal;
   if(termExcess > 0)
   {
      struct TermLim { ulong ticket; double price; string sym; datetime tm; };
      TermLim tarr[]; int tcnt = 0;
      for(int i = OrdersTotal() - 1; i >= 0; i--)
      {
         ulong ticket = OrderGetTicket(i);
         if(ticket == 0) continue;
         if((long)OrderGetInteger(ORDER_MAGIC) != magic) continue;
         ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
         if(t != ORDER_TYPE_BUY_LIMIT && t != ORDER_TYPE_SELL_LIMIT) continue;
         if(!LimitCancelAllowed(ticket, false, "terminal excess")) continue;
         int sz = tcnt++; ArrayResize(tarr, sz + 1);
         tarr[sz].ticket = ticket;
         tarr[sz].price  = OrderGetDouble(ORDER_PRICE_OPEN);
         tarr[sz].sym    = OrderGetString(ORDER_SYMBOL);
         tarr[sz].tm     = (datetime)OrderGetInteger(ORDER_TIME_SETUP);
      }
      for(int a = 0; a < tcnt - 1; a++)
         for(int b = a + 1; b < tcnt; b++)
         {
            double curA = SymbolInfoDouble(tarr[a].sym, SYMBOL_BID);
            double curB = SymbolInfoDouble(tarr[b].sym, SYMBOL_BID);
            double da = (curA > 0) ? MathAbs(tarr[a].price - curA) : (double)tarr[a].tm;
            double db = (curB > 0) ? MathAbs(tarr[b].price - curB) : (double)tarr[b].tm;
            if(da > db) { TermLim tmp = tarr[a]; tarr[a] = tarr[b]; tarr[b] = tmp; }
         }
      for(int k = 0; k < termExcess && k < tcnt; k++)
      {
         LimitSafeOrderDelete(tarr[k].ticket, false, "LIMIT terminal excédentaire");
      }
   }
}
