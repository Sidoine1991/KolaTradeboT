//+------------------------------------------------------------------+
//| Mapping canonique GOM (fidèle serveur ↔ EA)                       |
//| WAIT=0 | BUY SIMPLE=1 | SELL SIMPLE=-1 | GOOD BUY=2 | GOOD SELL=-2|
//| PERFECT BUY=3 | PERFECT SELL=-3                                  |
//+------------------------------------------------------------------+
string SMCGP_VerdictTextFromNum(const int vn)
{
   if(vn >= 3)  return "PERFECT BUY";
   if(vn == 2)  return "GOOD BUY";
   if(vn == 1)  return "BUY SIMPLE";
   if(vn == 0)  return "WAIT";
   if(vn == -1) return "SELL SIMPLE";
   if(vn == -2) return "GOOD SELL";
   if(vn <= -3) return "PERFECT SELL";
   return "WAIT";
}

// Parse texte libre → verdict_num (-3..+3). Accepte variantes:
// "PERFECT BUY", "PERFECT_BUY", "PerfectBuy", "GOOD SELL", "BUY", "WAIT"...
int SMCGP_VerdictNumFromText(const string rawVerdict)
{
   string s = rawVerdict;
   StringTrimLeft(s);
   StringTrimRight(s);
   if(StringLen(s) == 0) return 0;
   StringToUpper(s);
   // Normaliser séparateurs
   StringReplace(s, "_", " ");
   StringReplace(s, "-", " ");
   StringReplace(s, "/", " ");
   while(StringFind(s, "  ") >= 0)
      StringReplace(s, "  ", " ");

   // PERFECT d'abord (contient aussi BUY/SELL)
   bool isPerfect = (StringFind(s, "PERFECT") >= 0);
   bool isGood    = (StringFind(s, "GOOD") >= 0);
   bool isBuy     = (StringFind(s, "BUY") >= 0 || StringFind(s, "BULL") >= 0 || StringFind(s, "LONG") >= 0);
   bool isSell    = (StringFind(s, "SELL") >= 0 || StringFind(s, "BEAR") >= 0 || StringFind(s, "SHORT") >= 0);
   bool isWait    = (StringFind(s, "WAIT") >= 0 || s == "0" || s == "NEUT" || s == "NEUTRAL" || s == "HOLD");

   if(isPerfect && isBuy)  return 3;
   if(isPerfect && isSell) return -3;
   // "PERFECT" seul sans direction → indéterminé
   if(isPerfect)           return 0;
   if(isGood && isBuy)     return 2;
   if(isGood && isSell)    return -2;
   if(isGood)              return 0;  // "GOOD" seul sans direction
   if(isBuy && !isSell)    return 1;
   if(isSell && !isBuy)    return -1;
   if(isWait)              return 0;

   // Codes numériques en string
   if(s == "3") return 3;
   if(s == "2") return 2;
   if(s == "1") return 1;
   if(s == "-1") return -1;
   if(s == "-2") return -2;
   if(s == "-3") return -3;
   return 0;
}

// Normaliser : priorité au verdict_num valide (-3..3), sinon texte.
// Si les deux existent et divergent, on resynchronise le TEXTE sur le NUM
// (le serveur envoie verdict_num comme source de vérité d'exécution).
string SMCGP_NormalizeVerdict(const string rawVerdict, int vn)
{
   // Clamp
   if(vn > 3) vn = 3;
   if(vn < -3) vn = -3;

   // Si vn non nul → texte canonique depuis le numéro (fidélité d'exécution)
   if(vn != 0)
      return SMCGP_VerdictTextFromNum(vn);

   // vn==0 : ne PAS forcer WAIT si le texte dit autre chose
   int fromText = SMCGP_VerdictNumFromText(rawVerdict);
   if(fromText != 0)
      return SMCGP_VerdictTextFromNum(fromText);

   return "WAIT";
}

// Applique le couple (texte, num) → globals cohérents
void SMCGP_ApplyCanonicalVerdict(const string rawVerdict, int vn, double quality=-1.0, double coherence=-1.0)
{
   if(vn > 3) vn = 3;
   if(vn < -3) vn = -3;

   // Si num absent/0 mais texte explicite → dériver num
   // FIX 2026-09-11 : uniquement si ce texte est appuyé par une qualité ET
   // une cohérence réelles (>0) pour CE poll. Un payload "orphelin" (ex. store
   // écrasé par /pending-order avant fix serveur, ou tout futur payload
   // partiel) porte un texte résiduel sans confiance derrière — le laisser
   // fabriquer un vn=+/-3 "PERFECT" verrouillait à tort la direction opposée
   // alors que Q=0%/C=0% aurait dû se traduire par WAIT.
   if(vn == 0)
   {
      int fromText = SMCGP_VerdictNumFromText(rawVerdict);
      if(fromText != 0 && quality > 0.0 && coherence > 0.0)
         vn = fromText;
   }

   // Si num présent et texte vide/incohérent → texte depuis num
   string canon = SMCGP_VerdictTextFromNum(vn);
   int textVn = SMCGP_VerdictNumFromText(rawVerdict);
   // Désaccord fort (sens opposé) : num gagne (contrat d'exécution serveur)
   if(vn != 0 && textVn != 0 && ((vn > 0 && textVn < 0) || (vn < 0 && textVn > 0)))
   {
      Print("[GOM-PARSE] Désaccord sens texte='", rawVerdict, "' vs vn=", vn,
            " → priorité verdict_num → ", canon);
   }
   // Désaccord magnitude (ex: texte PERFECT, num GOOD) : num gagne aussi
   else if(vn != 0 && textVn != 0 && vn != textVn)
   {
      Print("[GOM-PARSE] Désaccord magnitude texte='", rawVerdict, "'(", textVn,
            ") vs vn=", vn, " → priorité verdict_num → ", canon);
   }

   g_smcGomVerdictNum = vn;
   g_smcGomVerdict    = canon;
}

void SMCGP_ParseGOMBody(const string &body)
{
   string vmode = SMCGP_JsonString(body, "verdict_mode");
   bool predictiveBlend = (vmode == "predictive_blend");

   g_smcMarketPriceFresh = SMCGP_JsonBool(body, "market_price_fresh");
   g_smcMarketPriceAgeSec = SMCGP_JsonDouble(body, "market_price_age_sec", -1.0);
   g_smcForecast5mReady = SMCGP_JsonBool(body, "cog_forecast_ready");
   g_smcForecastHorizonMinutes = (int)SMCGP_JsonDouble(body, "forecast_horizon_minutes", 0.0);
   g_smcGomVerdictForecastNum = (int)SMCGP_JsonDouble(body, "forecast_verdict_num", 0.0);
   if(g_smcForecast5mReady && g_smcGomVerdictForecastNum != 0)
      g_smcForecastLastUpdate = TimeCurrent();
   g_smcSpikeHTFSimpleAllowed = SMCGP_JsonBool(body, "spike_htf_simple_allowed");
   g_smcM1ScalpSimpleAllowed = SMCGP_JsonBool(body, "m1_scalp_simple_allowed");
   g_smcGomPrice = SMCGP_JsonDouble(
      body, "market_price", SMCGP_JsonDouble(body, "price", 0.0)
   );

   SMCGP_ParseHarmonizedM1Fields(body);

   // --- Parse fidèle WAIT / BUY / SELL / GOOD BUY / GOOD SELL / PERFECT BUY / PERFECT SELL ---
   string rawVerdictTxt = SMCGP_JsonString(body, "verdict");
   if(StringLen(rawVerdictTxt) == 0)
      rawVerdictTxt = SMCGP_JsonString(body, "action");  // alias fréquent API
   // verdict_num : tenter double puis string (certains payloads envoient "2")
   double vnRaw = SMCGP_JsonDouble(body, "verdict_num", -999.0);
   int parsedVn = 0;
   if(vnRaw > -998.0)
      parsedVn = (int)MathRound(vnRaw);
   else
   {
      string vnStr = SMCGP_JsonString(body, "verdict_num");
      if(StringLen(vnStr) > 0)
         parsedVn = (int)StringToInteger(vnStr);
   }
   // AUDIT C6: un payload marqué "stale" ou trop vieux (cache_age_sec) ne doit
   // JAMAIS piloter un trade → forcer WAIT (vn=0) même si verdict_num != 0.
   double cacheAgeSec = SMCGP_JsonDouble(body, "cache_age_sec", -1.0);
   bool staleFlag = SMCGP_JsonBool(body, "stale");
   const int GOM_MAX_PAYLOAD_AGE_SEC = 120; // aligné sur le cache EA (SMCGP_GetCachedVerdictNum)
   bool stalePayload = staleFlag || (cacheAgeSec > 0.0 && cacheAgeSec > GOM_MAX_PAYLOAD_AGE_SEC);
   if(stalePayload)
   {
      Print("[GOM-PARSE] PAYLOAD PÉRIMÉ ignoré → WAIT forcé | stale=", (staleFlag?"true":"false"),
            " | cache_age_sec=", (cacheAgeSec > 0.0 ? DoubleToString(cacheAgeSec,0) : "?"),
            " | raw='", rawVerdictTxt, "' vnRaw=", DoubleToString(vnRaw, 1));
      rawVerdictTxt = "WAIT";
      parsedVn      = 0;
      g_smcGomVerdictReactiveNum = 0;
   }

   // Snapshot intact de la réponse API avant tout veto/cap local. Le scanner
   // affiche le verdict effectif serveur (même valeur que le dashboard API),
   // pas la valeur que les gates MT5 peuvent modifier ensuite.
   double apiEffectiveVn = SMCGP_JsonDouble(body, "effective_verdict_num", -999.0);
   if(stalePayload)
   {
      g_smcGomApiVerdictNum = 0;
      g_smcGomApiVerdict = "WAIT";
      g_smcGomApiVerdictAvailable = false;
   }
   else
   {
      g_smcGomApiVerdictNum = (apiEffectiveVn > -998.0)
                              ? (int)MathRound(apiEffectiveVn) : parsedVn;
      if(g_smcGomApiVerdictNum > 3) g_smcGomApiVerdictNum = 3;
      if(g_smcGomApiVerdictNum < -3) g_smcGomApiVerdictNum = -3;
      g_smcGomApiVerdict = SMCGP_JsonString(body, "effective_verdict");
      if(StringLen(g_smcGomApiVerdict) == 0)
         g_smcGomApiVerdict = SMCGP_VerdictTextFromNum(g_smcGomApiVerdictNum);
      g_smcGomApiVerdictAvailable = true;
   }

   // Clamp + couple canonique
   if(parsedVn > 3) parsedVn = 3;
   if(parsedVn < -3) parsedVn = -3;
   // FIX 2026-09-11 : qualité/cohérence de CE poll (pas celles, périmées, du
   // cycle précédent) — nécessaires pour valider un éventuel fallback texte
   // ci-dessous (payload "orphelin" : verdict_num absent mais texte résiduel).
   double qualityThisPoll    = SMCGP_JsonDouble(body, "entry_quality");
   double coherenceThisPoll  = SMCGP_JsonDouble(body, "coherence_pct");
   SMCGP_ApplyCanonicalVerdict(rawVerdictTxt, parsedVn, qualityThisPoll, coherenceThisPoll);
   g_smcGomEntryAllowed = true;
   if(StringFind(body, "\"entry_allowed\"") >= 0)
      g_smcGomEntryAllowed = SMCGP_JsonBool(body, "entry_allowed");
   g_smcGomEntryBlockReason = stalePayload ? "" : SMCGP_JsonString(body, "entry_block_reason");
   g_smcMarketForecastGateReason = stalePayload
      ? "" : SMCGP_JsonString(body, "market_forecast_gate_reason");
   if(MathAbs(g_smcGomVerdictNum) >= 2 && !g_smcGomEntryAllowed)
   {
      if(StringLen(g_smcGomEntryBlockReason) > 0)
         Print("[GOM-PARSE] entry_allowed=false raison=", g_smcGomEntryBlockReason,
               " | vn=", g_smcGomVerdictNum);
   }
   static datetime s_parseLog = 0;
   if(TimeCurrent() - s_parseLog >= 15)
   {
      s_parseLog = TimeCurrent();
      Print("[GOM-PARSE] ", _Symbol, " | raw='", rawVerdictTxt, "' vnRaw=", DoubleToString(vnRaw, 1),
            " → canon='", g_smcGomVerdict, "' vn=", g_smcGomVerdictNum);
   }

   double strongThr = SMCGP_StrongMoveThreshold(_Symbol);
   double priceDirection = g_smcPriceDir5b;
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(priceDirection == 0.0 && CopyRates(_Symbol, PERIOD_M1, 0, 10, r) >= 5)
   {
      double priceChange = r[0].close - r[4].close;
