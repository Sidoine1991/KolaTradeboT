void SMCGP_CommitM5LockedVerdict()
{
   datetime m5 = iTime(_Symbol, PERIOD_M5, 0);
   if(m5 <= 0) m5 = (datetime)((TimeCurrent() / 300) * 300);

   static datetime s_m5Bar = 0;
   static int      s_m5Vn = 0;
   static string   s_m5Txt = "";
   static int      s_m5Srv = 0;
   static string   s_m5SrvTxt = "";

   int vn = g_smcGomVerdictNum;
   if(vn == 0 && MathAbs(g_smcGomVerdictNumServer) >= 1)
      vn = g_smcGomVerdictNumServer;
   string txt = (vn == g_smcGomVerdictNum) ? g_smcGomVerdict : g_smcGomVerdictServer;
   if(StringLen(txt) == 0)
      txt = SMCGP_VerdictTextFromNum(vn);

   if(m5 != s_m5Bar)
   {
      s_m5Bar = m5;
      if(vn != 0)
      {
         s_m5Vn = vn;
         s_m5Txt = txt;
         s_m5Srv = g_smcGomVerdictNumServer;
         s_m5SrvTxt = g_smcGomVerdictServer;
      }
      Print("[GOM-M5-LOCK] ", _Symbol, " nouveau M5 vn=", s_m5Vn, " ", s_m5Txt);
      if(vn == 0 && s_m5Vn != 0)
      {
         g_smcGomVerdictNum = s_m5Vn;
         g_smcGomVerdict = s_m5Txt;
         g_smcGomCorrectionWait = false;
      }
   }
   else
   {
      bool sameDir = (s_m5Vn == 0 || vn == 0 || ((vn > 0) == (s_m5Vn > 0)));
      if(MathAbs(vn) > MathAbs(s_m5Vn) && sameDir)
      {
         s_m5Vn = vn;
         s_m5Txt = txt;
         if(MathAbs(g_smcGomVerdictNumServer) >= MathAbs(s_m5Srv))
         {
            s_m5Srv = g_smcGomVerdictNumServer;
            s_m5SrvTxt = g_smcGomVerdictServer;
         }
      }
      else
      {
         g_smcGomVerdictNum = s_m5Vn;
         g_smcGomVerdict = s_m5Txt;
         if(MathAbs(s_m5Srv) >= 1)
         {
            g_smcGomVerdictNumServer = s_m5Srv;
            g_smcGomVerdictServer = s_m5SrvTxt;
         }
         g_smcGomCorrectionWait = false;
      }
   }

   if(g_smcGomVerdictForecastNum == 0 && MathAbs(s_m5Vn) >= 1)
   {
      g_smcGomVerdictForecastNum = s_m5Vn;
      g_smcForecast5mReady = true;
      g_smcForecastHorizonMinutes = 5;
   }
}

int SMCGP_LocalM1ImpulseSign(const string symbol)
{
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(symbol, PERIOD_M1, 0, 4, r) < 4)
      return 0;
   bool dump = (r[0].close < r[1].close && r[0].close < r[3].close);
   bool rally = (r[0].close > r[1].close && r[0].close > r[3].close);
   if(dump) return -1;
   if(rally) return 1;
   return 0;
}

bool SMCGP_KeepNativeImpulseVerdict(const string symbol, const int vn)
{
   int imp = SMCGP_LocalM1ImpulseSign(symbol);
   if(imp == 0) return false;
   if(vn != 0 && ((vn < 0 && imp < 0) || (vn > 0 && imp > 0)))
      return true;
   string su = symbol;
   StringToUpper(su);
   bool crashFam = (StringFind(su, "CRASH") >= 0 || StringFind(su, "PAIN") >= 0);
   bool boomFam  = (StringFind(su, "BOOM") >= 0 || StringFind(su, "GAIN") >= 0);
   if(crashFam && imp < 0) return true;
   if(boomFam && imp > 0) return true;
   return false;
}

void SMCGP_CheckCorrectionAndAdjustVerdict()
{
   if(g_smcGomVerdictNum == 0) return;

   int barsNoSpike = g_smcGomBarsSinceSpike;
   if(barsNoSpike < 0)
      barsNoSpike = g_smcBarsSinceLastSpike;

   // Fallback local : incrémenter une fois par nouvelle bougie M1 (pas par poll)
   if(g_smcGomBarsSinceSpike <= 0)
   {
      static datetime s_lastM1BarCount = 0;
      datetime m1Bar = iTime(_Symbol, PERIOD_M1, 0);
      bool spikeConfirmed = (g_smcGomSpikeTradable && g_smcGomSpikePct >= 55.0);

      if(m1Bar > 0 && m1Bar != s_lastM1BarCount)
      {
         s_lastM1BarCount = m1Bar;
         if(spikeConfirmed)
         {
            g_smcBarsSinceLastSpike = 0;
            g_smcLastSpikeTime = TimeCurrent();
         }
         else
            g_smcBarsSinceLastSpike++;
      }
      barsNoSpike = g_smcBarsSinceLastSpike;
   }
   else
      g_smcBarsSinceLastSpike = barsNoSpike;

// Dump/rally natif en cours : ne pas tuer GOOD/PERFECT faute de "spike" détecté
    // FIX v1.34: M1+M5+M15 alignés → conserver GOOD/PERFECT (pas de bandeau WAIT jaune)
    if(barsNoSpike > 20 && MathAbs(g_smcGomVerdictNum) >= 2 && SMC_IsSpikeStyleSymbol(_Symbol))
    {
       if(SMCGP_SpikeAlignedGoodProtected(_Symbol, g_smcGomVerdictNum) ||
          SMCGP_KeepNativeImpulseVerdict(_Symbol, g_smcGomVerdictNum))
          ; // keep
       else
       {
          // Ne plus masquer GOOD/PERFECT par WAIT faute de spike.
          g_smcGomCorrectionReason = "plus de " + IntegerToString(barsNoSpike) + " bougies M1 sans spike";
          return;
       }
    }

   if(barsNoSpike > 10 && MathAbs(g_smcGomVerdictNum) >= 2)
   {
      int prevVn = g_smcGomVerdictNum;
      if(MathAbs(g_smcGomVerdictNum) >= 3)
      {
         g_smcGomVerdictNum = (g_smcGomVerdictNum > 0) ? 2 : -2;
         g_smcGomVerdict = (g_smcGomVerdictNum > 0) ? "GOOD BUY" : "GOOD SELL";
         static datetime s_retroPerfectLog = 0;
         if(TimeCurrent() - s_retroPerfectLog >= 30)
         {
            s_retroPerfectLog = TimeCurrent();
            Print("[GOM-RETROGRADE] ", _Symbol, " | PERFECT → GOOD (", barsNoSpike,
                  " M1 sans spike) | vn=", prevVn, " → ", g_smcGomVerdictNum);
         }
      }
      else if(barsNoSpike > 12)
      {
         // Conserver GOOD : ne plus rétrograder en SIMPLE (bandeau WAIT/SIMPLE).
      }
   }

   if(barsNoSpike > 15)
   {
      if(MathAbs(g_smcGomVerdictNum) >= 3)
      {
         g_smcGomVerdictNum = (g_smcGomVerdictNum > 0) ? 2 : -2;
         g_smcGomVerdict = (g_smcGomVerdictNum > 0) ? "GOOD BUY" : "GOOD SELL";
      }
      return;
   }
}

void SMCGP_ApplyPriceRealityGate(const string symbol)
{
   int vn = g_smcGomVerdictNum;
   if(vn == 0) return;
   if(MathAbs(vn) >= 2) return;
   if(MathAbs(g_smcGomVerdictNumServer) >= 2) return;

   // FxVol / Volatility GOOD/PERFECT : le verdict serveur prime sur la réalité prix M1
   if(SMCGP_VolStrongProtected(symbol, vn)) return;
   // FIX v1.34 ICT: GOOD/PERFECT + M1/M5/M15 alignés → ne jamais forcer WAIT (bande jaune)
   if(SMCGP_SpikeAlignedGoodProtected(symbol, vn)) return;
   // Aussi protéger via verdict serveur si overlay a déjà dégradé l'affichage
   if(SMCGP_SpikeAlignedGoodProtected(symbol, g_smcGomVerdictNumServer)) return;

   int tradeDir = (vn > 0) ? 1 : -1;
   int barsNoSpike = (g_smcGomBarsSinceSpike >= 0) ? g_smcGomBarsSinceSpike : g_smcBarsSinceLastSpike;
   int localSmall  = SMCGP_CountLocalSmallM1Bars(symbol);

   if(barsNoSpike >= 0 && barsNoSpike > 20 && MathAbs(vn) >= 2 && SMC_IsSpikeStyleSymbol(symbol))
   {
      if(!SMCGP_KeepNativeImpulseVerdict(symbol, vn))
      {
         // FIX: Debounce pour éviter le flickering WAIT
         if(SMCGP_IsVerdictChangeAllowed())
         {
            g_smcGomVerdictNum = 0;
            g_smcGomVerdict = "WAIT";
            g_smcGomCorrectionWait = true;
            g_smcGomCorrectionReason = "price_reality stale_spike";
            SMCGP_MarkVerdictChanged();
         }
         return;
      }
   }
   if(barsNoSpike > 12 && MathAbs(vn) >= 2)
   {
      vn = tradeDir;
      g_smcGomVerdictNum = vn;
      g_smcGomVerdict = (vn > 0) ? "BUY SIMPLE" : "SELL SIMPLE";
   }
   else if(barsNoSpike > 10 && MathAbs(vn) >= 3)
   {
      vn = tradeDir * 2;
      g_smcGomVerdictNum = vn;
      g_smcGomVerdict = (vn > 0) ? "GOOD BUY" : "GOOD SELL";
   }

   int m1s = SMCGP_TfDirToSign(StringLen(g_smcTfM1DirLive) > 0 ? g_smcTfM1DirLive : g_smcTfM1Dir);
   if(MathAbs(vn) >= 3 && ((tradeDir > 0 && m1s < 0) || (tradeDir < 0 && m1s > 0)))
   {
      vn = tradeDir * 2;
      g_smcGomVerdictNum = vn;
      g_smcGomVerdict = (vn > 0) ? "GOOD BUY" : "GOOD SELL";
   }

   // ── CALCUL LOCAL DE LA DIRECTION DU PRIX (priorité sur données serveur) ──
   // Demande Sidoine: le verdict doit tenir compte des réalités du prix
   double strongThr = SMCGP_StrongMoveThreshold(symbol);
   double priceDirection = 0.0, priceDir3b = 0.0, priceDir1b = 0.0, mom = 0.0;
   bool useLocalCalc = true;

   MqlRates r[];
   ArraySetAsSeries(r, true);

   // Calcul local de la direction du prix sur 5 bougies
   if(CopyRates(symbol, PERIOD_M1, 0, 6, r) >= 5)
   {
      double avgPrice = (r[0].close + r[4].close) / 2.0;
      if(avgPrice > 0)
         priceDirection = (r[0].close - r[4].close) / avgPrice;
   }

   // Calcul local de la direction sur 3 bougies
   if(CopyRates(symbol, PERIOD_M1, 0, 5, r) >= 4)
   {
      double avg3 = (r[0].close + r[3].close) / 2.0;
      if(avg3 > 0) priceDir3b = (r[0].close - r[3].close) / avg3;
   }

   // Calcul local de la direction sur 1 bougie
   if(CopyRates(symbol, PERIOD_M1, 0, 2, r) >= 2)
   {
      double avg1 = (r[0].close + r[1].close) / 2.0;
      if(avg1 > 0) priceDir1b = (r[0].close - r[1].close) / avg1;
   }

   // Calcul local du momentum
   mom = priceDirection;

   // Utiliser les données serveur uniquement si elles sont disponibles ET valides
   // Sinon, utiliser le calcul local (robuste et indépendant)
   if(g_smcPriceDir5b != 0.0 && MathAbs(g_smcPriceDir5b) > 0.0001)
   {
      priceDirection = g_smcPriceDir5b;
      useLocalCalc = false;
   }
   if(g_smcPriceDir3b != 0.0 && MathAbs(g_smcPriceDir3b) > 0.0001)
      priceDir3b = g_smcPriceDir3b;
   if(g_smcPriceDir1b != 0.0 && MathAbs(g_smcPriceDir1b) > 0.0001)
      priceDir1b = g_smcPriceDir1b;
   if(g_smcM1Momentum != 0.0 && MathAbs(g_smcM1Momentum) > 0.0001)
      mom = g_smcM1Momentum;

   static datetime s_lastPriceRealityLog = 0;
   if(useLocalCalc && TimeCurrent() - s_lastPriceRealityLog >= 30)
   {
      s_lastPriceRealityLog = TimeCurrent();
      Print("[PRICE-REALITY] ", symbol, " | Calcul LOCAL utilisé (données serveur indisponibles) | ",
            "5b=", DoubleToString(priceDirection, 5), " 3b=", DoubleToString(priceDir3b, 5),
            " 1b=", DoubleToString(priceDir1b, 5), " mom=", DoubleToString(mom, 5));
   }

   // FIX v1.34: micro-contre-prix M1 ne tue plus GOOD/PERFECT si MTF triple aligné
   if(tradeDir > 0 && (priceDirection < -strongThr || priceDir3b < -strongThr * 0.85))
   {
      if(!SMCGP_SpikeAlignedGoodProtected(symbol, vn) &&
         !SMCGP_SpikeAlignedGoodProtected(symbol, g_smcGomVerdictNumServer))
      {
         // FIX: Debounce pour éviter le flickering WAIT
         if(SMCGP_IsVerdictChangeAllowed())
         {
            g_smcGomVerdictNum = 0;
            g_smcGomVerdict = "WAIT";
            g_smcGomCorrectionWait = true;
            g_smcGomCorrectionReason = "price_strong_down vs BUY";
            SMCGP_MarkVerdictChanged();
         }
         return;
      }
   }
   if(tradeDir < 0 && (priceDirection > strongThr || priceDir3b > strongThr * 0.85))
   {
      if(!SMCGP_SpikeAlignedGoodProtected(symbol, vn) &&
         !SMCGP_SpikeAlignedGoodProtected(symbol, g_smcGomVerdictNumServer))
      {
         // FIX: Debounce pour éviter le flickering WAIT
         if(SMCGP_IsVerdictChangeAllowed())
         {
            g_smcGomVerdictNum = 0;
            g_smcGomVerdict = "WAIT";
            g_smcGomCorrectionWait = true;
            g_smcGomCorrectionReason = "price_strong_up vs SELL";
            SMCGP_MarkVerdictChanged();
         }
         return;
      }
   }

   if(MathAbs(vn) >= 3 && ((tradeDir > 0 && mom < -strongThr * 0.5) || (tradeDir < 0 && mom > strongThr * 0.5)))
   {
      vn = tradeDir * 2;
      g_smcGomVerdictNum = vn;
      g_smcGomVerdict = (vn > 0) ? "GOOD BUY" : "GOOD SELL";
   }
   if(MathAbs(vn) >= 2 && ((tradeDir > 0 && priceDir1b < -strongThr * 0.55) || (tradeDir < 0 && priceDir1b > strongThr * 0.55)))
   {
      vn = tradeDir;
      g_smcGomVerdictNum = vn;
      g_smcGomVerdict = (vn > 0) ? "BUY SIMPLE" : "SELL SIMPLE";
   }

   int oppBars = g_smcM1OppBars;
   if(oppBars <= 0)
   {
      for(int i = 0; i < 6; i++)
      {
         if(CopyRates(symbol, PERIOD_M1, i, 1, r) < 1) continue;
         if(tradeDir > 0 && r[0].close < r[0].open) oppBars++;
         if(tradeDir < 0 && r[0].close > r[0].open) oppBars++;
      }
   }
   if(MathAbs(vn) >= 3 && oppBars >= 3)
   {
      vn = tradeDir * 2;
      g_smcGomVerdictNum = vn;
      g_smcGomVerdict = (vn > 0) ? "GOOD BUY" : "GOOD SELL";
      g_smcGomCorrectionReason = StringFormat("micro_stairs opp=%d->GOOD", oppBars);
   }
   else if(MathAbs(vn) >= 2 && oppBars >= 5)
   {
      vn = tradeDir;
      g_smcGomVerdictNum = vn;
      g_smcGomVerdict = (vn > 0) ? "BUY SIMPLE" : "SELL SIMPLE";
      g_smcGomCorrectionReason = StringFormat("micro_corr opp=%d->SIMPLE", oppBars);
   }

   if(localSmall >= 10 && MathAbs(g_smcGomVerdictNum) >= 3)
   {
      g_smcGomVerdictNum = (g_smcGomVerdictNum > 0) ? 2 : -2;
      g_smcGomVerdict = (g_smcGomVerdictNum > 0) ? "GOOD BUY" : "GOOD SELL";
      g_smcGomCorrectionReason = StringFormat("local_small_bars=%d", localSmall);
   }
   else if(localSmall >= 18 && MathAbs(g_smcGomVerdictNum) >= 2)
   {
      g_smcGomVerdictNum = (g_smcGomVerdictNum > 0) ? 1 : -1;
      g_smcGomVerdict = (g_smcGomVerdictNum > 0) ? "BUY SIMPLE" : "SELL SIMPLE";
      g_smcGomCorrectionReason = StringFormat("local_small_bars=%d", localSmall);
   }
}

 bool SMCGP_LiveMicroCorrectionAgainstVerdict(const string symbol, const int verdictNum)
 {
    if(verdictNum == 0) return false;
    int tradeDir = (verdictNum > 0) ? 1 : -1;
    bool strongVerdict = (MathAbs(verdictNum) >= 2);
    g_smcGomHardDollarCorrection = false;

    // Correction M1 réelle (en unités de prix, "$") sur les 4 dernières bougies M1,
    // mesurée CONTRE le sens du verdict — vérifiée AVANT le bypass spike ci-dessous,
    // pour que même un symbole Boom/Crash/Painx/Gainx en GOOD/PERFECT bascule en
    // WAIT si le prix corrige de plus de MicroCorrM1DollarThreshold (défaut 2$).
    {
       double cc0 = iClose(symbol, PERIOD_M1, 0);
       double cc4 = iClose(symbol, PERIOD_M1, 4);
       if(cc0 > 0 && cc4 > 0)
       {
          double raw = cc0 - cc4;
          double against = (tradeDir > 0) ? -raw : raw; // positif = mouvement contre le trade
          // FxVol / Volatility GOOD/PERFECT : le serveur prime, pas de hard-$ correction
          // FIX v1.34: M1+M5+M15 alignés + GOOD/PERFECT → pas de hard-$ WAIT (bande jaune)
          if(against > MicroCorrM1DollarThreshold &&
             !SMCGP_VolStrongProtected(symbol, verdictNum) &&
             !SMCGP_SpikeAlignedGoodProtected(symbol, verdictNum))
          {
             g_smcGomCorrectionReason = StringFormat("correction M1 %.2f contre verdict (seuil %.2f)",
                                                      against, MicroCorrM1DollarThreshold);
             g_smcGomHardDollarCorrection = true;
             return true;
          }
       }
    }

    // Spike Boom/Crash : ignorer le bruit M1 résiduel seulement pour GOOD (|vn|=2), pas PERFECT
    if(SMC_IsSpikeStyleSymbol(symbol) && MathAbs(verdictNum) == 2)
       return false;

    // ── EARLY EXIT: Si M1+M5 sont d'accord avec la direction du trade, ignorer les micro-pullbacks ──
   // Le trend macro prime sur le bruit M1. Pas de blocage si le momentum HTF est aligné.
   {
      int m1s = SMCGP_TfDirToSign(g_smcTfM1Dir);
      int m5s = SMCGP_TfDirToSign(g_smcTfM5Dir);
      if(m1s == tradeDir && m5s == tradeDir)
         return false;
      // Même si seulement M5 est aligné et verdict strong, pas de blocage
      if(strongVerdict && m5s == tradeDir)
         return false;
   }

   int oppBars = 0;
   for(int i = 0; i <= 5; i++)
   {
      double o = iOpen(symbol, PERIOD_M1, i);
      double c = iClose(symbol, PERIOD_M1, i);
      if(o <= 0 || c <= 0) continue;
      if(tradeDir < 0 && c > o) oppBars++;
      if(tradeDir > 0 && c < o) oppBars++;
   }

   double c0 = iClose(symbol, PERIOD_M1, 0);
   double c1 = iClose(symbol, PERIOD_M1, 1);
   double c4 = iClose(symbol, PERIOD_M1, 4);
   double o0 = iOpen(symbol, PERIOD_M1, 0);
   double netMove = (c0 > 0 && c4 > 0) ? (c0 - c4) : 0.0;
   double pt = SymbolInfoDouble(symbol, SYMBOL_POINT);
   double atr = 0.0;
   int m1AtrH = iATR(symbol, PERIOD_M1, 14);
   if(m1AtrH != INVALID_HANDLE)
   {
      double atrBuf[];
      ArraySetAsSeries(atrBuf, true);
      if(CopyBuffer(m1AtrH, 0, 0, 1, atrBuf) > 0)
         atr = atrBuf[0];
      IndicatorRelease(m1AtrH);
   }
   double minMove = (atr > 0) ? atr * 0.08 : ((pt > 0) ? pt * 6 : 0.0);
   if(minMove <= 0 && pt > 0) minMove = pt * 6;

   // Bougie courante déjà contre le verdict → correction immédiate
   if(o0 > 0 && c0 > 0)
   {
      if(tradeDir > 0 && c0 < o0) return true;
      if(tradeDir < 0 && c0 > o0) return true;
   }

   // Séquence de closes montants/descendants = correction visible
   if(tradeDir < 0 && c0 > 0 && c1 > 0 && c4 > 0 && c0 > c1 && c1 > c4)
      return true;
   if(tradeDir > 0 && c0 > 0 && c1 > 0 && c4 > 0 && c0 < c1 && c1 < c4)
      return true;

   // PERFECT (|vn|≥3) : 1 bougie opposée suffit pour lever le doute
   bool isPerfect = (MathAbs(verdictNum) >= 3);
   if(tradeDir < 0)
   {
      int needOpp = isPerfect ? 1 : (strongVerdict ? 2 : 3);
      if(oppBars >= needOpp && netMove > minMove) return true;
      if(oppBars >= 2 && netMove > minMove * 0.5) return true;
   }
   else
   {
      int needOpp = isPerfect ? 1 : (strongVerdict ? 2 : 3);
      if(oppBars >= needOpp && netMove < -minMove) return true;
      if(oppBars >= 2 && netMove < -minMove * 0.5) return true;
   }

   int m1s = SMCGP_TfDirToSign(g_smcTfM1Dir);
   int m5s = SMCGP_TfDirToSign(g_smcTfM5Dir);

   // NB: M1+M5 agreement check already handled at function entry (early exit)
   // If we reach here, M1 or M5 disagree with trade direction

   if(tradeDir < 0 && m1s > 0 && m5s > 0) return true;
   if(tradeDir > 0 && m1s < 0 && m5s < 0) return true;
   if(tradeDir < 0 && m1s > 0 && oppBars >= 2) return true;
   if(tradeDir > 0 && m1s < 0 && oppBars >= 2) return true;

   return false;
}

bool SMCGP_VerdictWaitOnCorrectionCycle(const int serverVn)
{
   if(serverVn == 0) return false;

   if(g_smcM1EntryBlocked)
   {
      g_smcGomCorrectionReason = (StringLen(g_smcM1EntryReason) > 0)
                                 ? g_smcM1EntryReason : "M1 correction active";
      return true;
   }

   if(g_smcActiveCorrection)
   {
      string phase = g_smcCorrPhase;
      StringToLower(phase);
      if(phase == "correcting" || phase == "ranging")
      {
         g_smcGomCorrectionReason = StringFormat("correction %s (%s)",
                                                 g_smcCorrType, g_smcCorrPhase);
         return true;
      }
   }

   string ctype = g_smcCorrType;
   StringToLower(ctype);
   if(ctype == "micro_pullback" || ctype == "m5_pullback" || ctype == "counter_move")
   {
      string phase2 = g_smcCorrPhase;
      StringToLower(phase2);
      if(phase2 == "correcting")
      {
         g_smcGomCorrectionReason = StringFormat("phase correcting (%s)", g_smcCorrType);
         return true;
      }
   }

    // Seuil verdict WAIT sans assouplissement PERFECT (contrairement à CorrectionBlocksEntry)
    // Spike Boom/Crash/Painx/Gainx GOOD/PERFECT : ne jamais écraser par WAIT local
    if(!g_smcCorrEntrySafe && !(MathAbs(serverVn) >= 2))
    {
       double thresh = SMCGP_CorrectionBlockThreshold();
      if(thresh > 40.0) thresh = 40.0;
      if(g_smcCorrExhaustPct < thresh)
      {
         g_smcGomCorrectionReason = StringFormat("correction %.0f%% < %.0f%%",
                                                 g_smcCorrExhaustPct, thresh);
         return true;
      }
   }

   return false;
}

bool SMCGP_ShouldForceWaitOnCorrection(const string symbol)
{
   int vn = g_smcGomVerdictNumServer;
   if(vn == 0) return false;

   // FX Vol GOOD seulement : PERFECT reste soumis aux gardes M1
   if(SMC_IsWeltradeVolSymbol(symbol) && MathAbs(vn) == 2)
      return false;

   if(g_smcPaInCorrection && !g_smcCorrEntrySafe)
   {
      g_smcGomCorrectionReason = "PA correction";
      return true;
   }

   if(SMCGP_VerdictWaitOnCorrectionCycle(vn))
      return true;

   if(SMCGP_LiveMicroCorrectionAgainstVerdict(symbol, vn))
   {
      g_smcGomCorrectionReason = "M1 pullback live";
      return true;
   }

   return false;
}

void SMCGP_ArmCorrectionResumeWindow(const int sec = 90)
{
   g_smcGomCorrectionResumeUntil = TimeCurrent() + MathMax(15, sec);
}

bool SMCGP_IsCorrectionResumeWindow()
{
   return (g_smcGomCorrectionResumeUntil > 0 && TimeCurrent() < g_smcGomCorrectionResumeUntil);
}

void SMCGP_RefreshCorrectionWaitOverlay(const string symbol)
{
   // Couche WAIT désactivée : ne plus écraser GOOD/PERFECT par un bandeau jaune.
   g_smcGomCorrectionWait = false;
   if(MathAbs(g_smcGomVerdictNum) < 2 && MathAbs(g_smcGomVerdictNumServer) >= 2)
      SMCGP_RestoreAlignedGoodIfWait(symbol);
   return;

   // Verdict harmonisé serveur : source unique, pas de re-gate client (évite double WAIT).
   if(g_smcGomHarmonizedM1)
   {
      g_smcGomCorrectionWait = false;
      return;
   }

   // FIX v1.34: si GOOD/PERFECT serveur + 3 TF alignés, ne JAMAIS forcer WAIT
   // (évite alternance WAIT/verdict dans le dashboard)
   // FIX: Restaurer le verdict serveur si GOOD/PERFECT + 3 TF alignés, même si local est WAIT
   if(SMCGP_SpikeAlignedGoodProtected(symbol, g_smcGomVerdictNumServer))
   {
      g_smcGomCorrectionWait = false;
      g_smcGomHardDollarCorrection = false;
      // Restaurer le verdict serveur pour permettre les ordres
      SMCGP_RestoreAlignedGoodIfWait(symbol);
      return;
   }

   if(g_smcGomVerdictNumServer == 0 && !g_smcGomServerCorrWait) return;

   bool clientWait = SMCGP_ShouldForceWaitOnCorrection(symbol);

    bool shouldWait = g_smcGomServerCorrWait || clientWait;

     // FXVOL GOOD/PERFECT : ne JAMAIS écraser par WAIT (harmonisé ou non)
     // Le vrai verdict du serveur doit toujours passer pour les Volatility
     if(SMC_IsWeltradeVolSymbol(symbol)
        && MathAbs(g_smcGomVerdictNumServer) >= 2
        && !g_smcGomHardDollarCorrection)
        shouldWait = false;

     // Spike / Weltrade synth GOOD/PERFECT : ne pas écraser par WAIT correction
     if(!g_smcGomHarmonizedM1
        && (SMC_IsSpikeStyleSymbol(symbol) || SMC_IsWeltradeSynthSymbol(symbol))
        && MathAbs(g_smcGomVerdictNumServer) >= 2
        && !g_smcGomHardDollarCorrection)
        shouldWait = false;

   bool wasWait = g_smcGomCorrectionWait;

   if(shouldWait)
   {
      if(!g_smcGomCorrectionWait)
      {
         static datetime s_log = 0;
         if(TimeCurrent() - s_log >= 15)
         {
            s_log = TimeCurrent();
            Print("[GOM-CORR-WAIT] ", symbol, " ", g_smcGomVerdictServer,
                  " (vn=", g_smcGomVerdictNumServer, ") → WAIT | ",
                  g_smcGomCorrectionReason,
                  " | srv=", (g_smcGomServerCorrWait ? "Y" : "N"),
                  " cli=", (clientWait ? "Y" : "N"),
                  " | M1=", g_smcTfM1Dir, " M5=", g_smcTfM5Dir);
         }
      }
      // FIX: Debounce pour éviter le flickering WAIT
      if(SMCGP_IsVerdictChangeAllowed())
      {
         g_smcGomCorrectionWait = true;
         g_smcGomVerdictNum = 0;
         g_smcGomVerdict = "WAIT";
         g_smcGomCorrectionResumeUntil = 0;
         SMCGP_MarkVerdictChanged();
      }
      return;
   }

   if(wasWait)
   {
      g_smcGomCorrectionWait = false;
      g_smcGomCorrectionReason = "";
      g_smcGomVerdictNum = g_smcGomVerdictNumServer;
      g_smcGomVerdict = g_smcGomVerdictServer;
      SMCGP_ArmCorrectionResumeWindow(90);
      Print("[GOM-CORR-RESUME] ", symbol, " ", g_smcGomVerdict,
            " (vn=", g_smcGomVerdictNum, ") — fenêtre exécution 90s");
   }
   else
      SMCGP_RestoreAlignedGoodIfWait(symbol);
}

void SMCGP_ApplyCorrectionVerdictWait(const string symbol, const bool serverFlag = false)
{
   if(serverFlag && StringLen(g_smcGomCorrectionReason) == 0)
      g_smcGomCorrectionReason = "serveur correction";
   SMCGP_RefreshCorrectionWaitOverlay(symbol);
}

void SMCGP_OverlayLiveTfDirs()
{
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 6, r) < 5)
      return;
   double d1 = r[0].close - r[1].close;
   double d3 = r[0].close - r[4].close;
   string u = _Symbol;
   StringToUpper(u);
   bool buyFam = (StringFind(u, "GAINX") >= 0 || StringFind(u, "BOOM") >= 0);
   bool sellFam = (StringFind(u, "PAINX") >= 0 || StringFind(u, "CRASH") >= 0);
   if(d1 < 0.0 && d3 < 0.0)
   {
      g_smcTfM1DirLive = "BEAR";
      g_smcTfM1Dir     = "BEAR";
   }
   else if(d1 > 0.0 && d3 > 0.0)
   {
      g_smcTfM1DirLive = "BULL";
      g_smcTfM1Dir     = "BULL";
   }
   else if(buyFam && (d1 > 0.0 || r[0].close > r[0].open))
   {
      g_smcTfM1DirLive = "BULL";
      g_smcTfM1Dir     = "BULL";
   }
   else if(sellFam && (d1 < 0.0 || r[0].close < r[0].open))
   {
      g_smcTfM1DirLive = "BEAR";
      g_smcTfM1Dir     = "BEAR";
   }
   MqlRates m5[];
   ArraySetAsSeries(m5, true);
   if(CopyRates(_Symbol, PERIOD_M5, 0, 4, m5) >= 3)
   {
      if(m5[0].close < m5[0].open && m5[1].close < m5[1].open && d3 < 0.0)
         g_smcTfM5Dir = "BEAR";
      else if(m5[0].close > m5[0].open && m5[1].close > m5[1].open && d3 > 0.0)
         g_smcTfM5Dir = "BULL";
   }
   SMCGP_ApplyFamilyNativePriceLead();
}

void SMCGP_ApplyFamilyNativePriceLead()
{
   if(MathAbs(g_smcGomVerdictNum) >= 2 || MathAbs(g_smcGomVerdictNumServer) >= 2)
      return;
   string u = _Symbol;
   StringToUpper(u);
   bool buyFam  = (StringFind(u, "GAINX") >= 0 || StringFind(u, "BOOM") >= 0);
   bool sellFam = (StringFind(u, "PAINX") >= 0 || StringFind(u, "CRASH") >= 0);
   if(!buyFam && !sellFam) return;
   if(!GOMFamilyBiasLock) return;   // verdict serveur non modifié

   MqlRates m1[];
   ArraySetAsSeries(m1, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 5, m1) < 4) return;

   int reds = 0, greens = 0;
   for(int i = 1; i <= 3; i++)
   {
      if(m1[i].close < m1[i].open) reds++;
      if(m1[i].close > m1[i].open) greens++;
   }
   bool lastUp = (m1[1].close > m1[1].open) || (m1[0].close > m1[0].open);
   bool lastDn = (m1[1].close < m1[1].open) || (m1[0].close < m1[0].open);
   bool dump   = (reds >= 2 && m1[1].close < m1[1].open);
   bool rally  = (greens >= 2);

   int prevVn = g_smcGomVerdictNum;
   if(buyFam)
   {
      // GainX/Boom : JAMAIS un verdict SELL (le verrou "PERFECT SELL bloqué" vient de là)
      if(g_smcGomVerdictNum < 0)
      {
         if(lastUp && !dump)
         {
            g_smcGomVerdictNum = 2;
            g_smcGomVerdict = "GOOD BUY";
            g_smcGomConnected = true;
            g_smcGomSource = "M1_NATIVE";
         }
         else
         {
            // FIX: Debounce pour éviter le flickering WAIT
            if(SMCGP_IsVerdictChangeAllowed())
            {
               g_smcGomVerdictNum = 0;
               g_smcGomVerdict = "WAIT";
               g_smcGomSource = "M1_NATIVE";
               SMCGP_MarkVerdictChanged();
            }
         }
      }
      else if(lastUp && !dump && g_smcGomVerdictNum == 0)
      {
         g_smcGomVerdictNum = 2;
         g_smcGomVerdict = "GOOD BUY";
         g_smcGomConnected = true;
         g_smcGomSource = "M1_NATIVE";
      }
   }
   else if(sellFam)
   {
      // PainX: pas de SELL dans un M1 haussier (3 Soldiers) — WAIT, pas GOOD SELL
      if(rally || (m1[1].close > m1[1].open && greens >= 2))
      {
         if(g_smcGomVerdictNum < 0)
         {
            // FIX: Debounce pour éviter le flickering WAIT
            if(SMCGP_IsVerdictChangeAllowed())
            {
               g_smcGomVerdictNum = 0;
               g_smcGomVerdict = "WAIT";
               g_smcGomSource = "M1_NATIVE";
               SMCGP_MarkVerdictChanged();
            }
         }
      }
      else if(g_smcGomVerdictNum > 0)
      {
         if(lastDn && dump)
         {
            g_smcGomVerdictNum = -2;
            g_smcGomVerdict = "GOOD SELL";
            g_smcGomConnected = true;
            g_smcGomSource = "M1_NATIVE";
         }
         else
         {
            // FIX: Debounce pour éviter le flickering WAIT
            if(SMCGP_IsVerdictChangeAllowed())
            {
               g_smcGomVerdictNum = 0;
               g_smcGomVerdict = "WAIT";
               g_smcGomSource = "M1_NATIVE";
               SMCGP_MarkVerdictChanged();
            }
         }
      }
      else if(dump && lastDn && g_smcGomVerdictNum == 0)
      {
         g_smcGomVerdictNum = -2;
         g_smcGomVerdict = "GOOD SELL";
         g_smcGomConnected = true;
         g_smcGomSource = "M1_NATIVE";
      }
   }
   if(prevVn != g_smcGomVerdictNum)
      Print("[GOM-NATIVE] ", _Symbol, " vn ", prevVn, " → ", g_smcGomVerdictNum,
            " ", g_smcGomVerdict, " | M1 last ", (lastUp ? "UP" : (lastDn ? "DN" : "FLAT")));
}
