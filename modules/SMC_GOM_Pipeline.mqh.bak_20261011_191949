{
   bodyOut = "";
   g_smcServerUrl = SMCGP_ActiveServerURL() + path;
   char post[], result[];
   string headers = "Content-Type: application/json\r\n";
   string respH;
   int code = WebRequest("GET", g_smcServerUrl, headers, timeoutMs, post, result, respH);
   g_smcLastHttpCode = code;
   if(code != 200)
   {
