color SMCGP_VerdictColor(const int verdictNum)
{
   if(verdictNum >= 2)  return (color)SMC_DASH_C_HDR_BUY;
   if(verdictNum == 1)  return (color)SMC_DASH_C_BUY;
   if(verdictNum == 0)  return (color)SMC_DASH_C_WAIT;
   if(verdictNum == -1) return (color)SMC_DASH_C_SELL;
   if(verdictNum <= -2) return (color)SMC_DASH_C_HDR_SELL;
   return (color)SMC_DASH_C_WAIT;
}

int SMCGP_DisplayVerdictNum()
{
   int loc = g_smcGomVerdictNum;
   int srv = g_smcGomVerdictNumServer;
   if(loc == -999) loc = 0;
   
   // Ne pas afficher de verdict non-WAIT si le poll est périmé (stale)
   if(g_smcGomSource == "CACHE_STALE_POLL_FORCED_WAIT")
      return 0;
   
   if(g_smcGomCorrectionWait && MathAbs(srv) >= 1)
      return srv;
   if(loc == 0 && MathAbs(srv) >= 1)
      return srv;
   if(loc != 0)
      return loc;
   return 0;
}

string SMCGP_DisplayVerdictText()
{
   int displayVn = SMCGP_DisplayVerdictNum();
   if(displayVn == 0)
      return "WAIT";

   string txt;
   if(StringLen(g_smcGomVerdictServer) > 0 && MathAbs(g_smcGomVerdictNumServer) == MathAbs(displayVn))
      txt = SMCGP_NormalizeVerdict(g_smcGomVerdictServer, displayVn);
   else
      txt = SMCGP_NormalizeVerdict(g_smcGomVerdict, displayVn);

   int dirSign = (displayVn > 0) ? 1 : -1;
   if(!g_smcGomEntryAllowed &&
      !SMC_SpikeChainGomEntryOverrideAllowed(_Symbol, dirSign))
      txt += " | ENTRY PAUSED";
   return txt;
}

