         return;
      }
   }

   int bulls = 0, bears = 0;
   if(g_smcTfM1Dir == "BULL") bulls++; else if(g_smcTfM1Dir == "BEAR") bears++;
   if(g_smcTfM5Dir == "BULL") bulls++; else if(g_smcTfM5Dir == "BEAR") bears++;
