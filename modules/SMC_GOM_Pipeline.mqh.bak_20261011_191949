   ObjectDelete(0, "SMC_PA_MA200");

    if(!g_showPriceActionZone) return;
    if(g_smcPaZoneSupport <= 0 || g_smcPaZoneResistance <= 0) return;

    SMCGP_UpdatePriceInActionZone();

    double zLo = MathMin(g_smcPaZoneSupport, g_smcPaZoneResistance);
    double zHi = MathMax(g_smcPaZoneSupport, g_smcPaZoneResistance);
    if(zHi <= zLo) return;

    int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
    datetime t0 = iTime(_Symbol, PERIOD_CURRENT, 40);
    datetime tE = iTime(_Symbol, PERIOD_CURRENT, 0) + PeriodSeconds(PERIOD_CURRENT) * 100;
    if(t0 <= 0) t0 = TimeCurrent() - PeriodSeconds(PERIOD_CURRENT) * 40;

    color zoneClr = g_smcPaPriceInZone ? clrTomato : clrDimGray;
    if(g_smcPaPriceInZone && g_smcPaConsolidation) zoneClr = clrOrangeRed;

    ObjectCreate(0, "SMC_PA_ZONE", OBJ_RECTANGLE, 0, t0, zHi, tE, zLo);
    ObjectSetInteger(0, "SMC_PA_ZONE", OBJPROP_COLOR, zoneClr);
    ObjectSetInteger(0, "SMC_PA_ZONE", OBJPROP_BACK, true);
    ObjectSetInteger(0, "SMC_PA_ZONE", OBJPROP_FILL, true);
    ObjectSetInteger(0, "SMC_PA_ZONE", OBJPROP_SELECTABLE, false);

    string lbl = g_smcPaPriceInZone
       ? StringFormat("PRIX DANS ZONE MA50/200 [%.*f-%.*f] %s RSI=%.0f",
                      dg, zLo, dg, zHi, g_smcPaTrend, g_smcPaRsi)
       : StringFormat("ZONE MA50/200 [%.*f-%.*f] %s RSI=%.0f",
                      dg, zLo, dg, zHi, g_smcPaTrend, g_smcPaRsi);

    ObjectCreate(0, "SMC_PA_LABEL", OBJ_LABEL, 0, 0, 0);
    ObjectSetInteger(0, "SMC_PA_LABEL", OBJPROP_CORNER, CORNER_LEFT_UPPER);
    ObjectSetInteger(0, "SMC_PA_LABEL", OBJPROP_XDISTANCE, 10);
    ObjectSetInteger(0, "SMC_PA_LABEL", OBJPROP_YDISTANCE, 70);
    ObjectSetString(0, "SMC_PA_LABEL", OBJPROP_TEXT, lbl);
    ObjectSetInteger(0, "SMC_PA_LABEL", OBJPROP_COLOR, zoneClr);
    ObjectSetInteger(0, "SMC_PA_LABEL", OBJPROP_FONTSIZE, 9);
}

void SMCGP_EnsurePriceActionData()
{
    if(g_smcPaMa50 > 0 && g_smcPaMa200 > 0)
    {
       g_smcPaZoneSupport = MathMin(g_smcPaMa50, g_smcPaMa200);
       g_smcPaZoneResistance = MathMax(g_smcPaMa50, g_smcPaMa200);
    }
}

//+------------------------------------------------------------------+
//| NIVEAUX D'ENTRÉE GOM PIPELINE                                    |
//| FIX 2026-09-19 : les trendlines GOM_TF_TL_* sont désormais la     |
//| droite de RÉGRESSION LINÉAIRE, cohérente aux 2 ancres (fin unique),|
//| au lieu de l'ancien mélange "ancre à 50 bougies + pente 30 bars"   |
//| qui rendait les niveaux d'entrée décalés dans le temps. La lecture |
//| du niveau (SMC_FindReactionObjectLevel) rend la valeur de la ligne |
//| à TimeCurrent() = le retest d'entrée réel.                        |
//+------------------------------------------------------------------+
input int    GOM_TL_LookbackBars     = 40;   // fenêtre de régression (bars du TF)
input double GOM_TL_ForecastPeriods  = 5.0;  // prolongement du segment au-delà de la bougie courante (périodes)
input double GOM_TL_MaxProjectionATR = 2.5;  // garde-fou : projection max depuis le prix (x ATR)

// Fit linéaire (prix/seconde) + intercept sur les N dernières bougies
bool SMCGP_TfFit(const string sym, const ENUM_TIMEFRAMES tf, const int bars,
                 double &slope, double &intercept)
{
   slope = 0.0; intercept = 0.0;
   if(bars < 5) return false;
   double c[];
   datetime t[];
   ArraySetAsSeries(c, true);
   ArraySetAsSeries(t, true);
   if(CopyClose(sym, tf, 0, bars, c) < bars) return false;
   if(CopyTime(sym, tf, 0, bars, t) < bars) return false;
   double sx = 0.0, sy = 0.0, sxy = 0.0, sxx = 0.0;
   for(int i = 0; i < bars; i++)
   {
      double x = (double)t[i];
      double y = c[i];
      sx += x; sy += y; sxy += x * y; sxx += x * x;
   }
   double n = (double)bars;
   double denom = n * sxx - sx * sx;
   if(MathAbs(denom) < 1.0) return false;
   slope = (n * sxy - sx * sy) / denom;
   intercept = (sy - slope * sx) / n;
   return true;
}

// Pente réelle (prix/seconde) d'un timeframe — régression linéaire
double SMCGP_TfSlope(const string sym, const ENUM_TIMEFRAMES tf, const int bars = 30)
{
   double s = 0.0, i = 0.0;
   SMCGP_TfFit(sym, tf, bars, s, i);
   return s;
}

void SMCGP_DrawTrendlinesMTF()
{
   if(!ShowGOMDashboard) return;
   SMCGP_OverlayLiveTfDirs();

   string tfLabels[] = {"M1", "M5", "M15", "H1", "H4", "D1"};
   string m1Dir = (StringLen(g_smcTfM1DirLive) > 0) ? g_smcTfM1DirLive : g_smcTfM1Dir;
   string tfDirs[] = {m1Dir, g_smcTfM5Dir, g_smcTfM15Dir, g_smcTfH1Dir, g_smcTfH4Dir, g_smcTfD1Dir};
   ENUM_TIMEFRAMES tfs[] = {PERIOD_M1, PERIOD_M5, PERIOD_M15, PERIOD_H1, PERIOD_H4, PERIOD_D1};
   color tfColors[] = {clrAqua, clrGold, clrDeepSkyBlue, clrDodgerBlue, clrBlue, clrPurple};

   for(int i = 0; i < 6; i++)
   {
      string objName = "GOM_TF_TL_" + tfLabels[i];
      string lblName = "GOM_TF_LBL_" + tfLabels[i];
      ObjectDelete(0, objName);
      ObjectDelete(0, lblName);

      if(tfDirs[i] != "BULL" && tfDirs[i] != "BEAR") continue;

      int bars = (int)GOM_TL_LookbackBars;
      if(bars < 10) bars = 10;
      if(bars > 200) bars = 200;

      // Droite de régression : les 2 ancres appartiennent au MÊME fit
      double slope = 0.0, intercept = 0.0;
      if(!SMCGP_TfFit(_Symbol, tfs[i], bars, slope, intercept)) continue;

      // Cohérence avec le sens GOM : la ligne épouse la tendance
      if(tfDirs[i] == "BEAR" && slope > 0) slope = -MathAbs(slope);
      if(tfDirs[i] == "BULL" && slope < 0) slope =  MathAbs(slope);
      if(slope == 0.0)
      {
         double c0 = iClose(_Symbol, tfs[i], 0);
         if(c0 <= 0.0) continue;
         intercept = c0;
      }

      datetime t0 = iTime(_Symbol, tfs[i], bars - 1);
      datetime t1 = iTime(_Symbol, tfs[i], 0) + (datetime)(PeriodSeconds(tfs[i]) * GOM_TL_ForecastPeriods);
      if(t0 <= 0) t0 = TimeCurrent() - PeriodSeconds(tfs[i]) * bars;
      if(t1 <= t0) continue;

      double p0 = slope * (double)t0 + intercept;
      double p1 = slope * (double)t1 + intercept;
      if(p0 <= 0.0 || p1 <= 0.0) continue;

      // Garde-fou extrapolation : le niveau projeté (entrée) ne doit pas
      // s'écarter de plus de GOM_TL_MaxProjectionATR * ATR du prix courant —
      // évite des trendlines installées absurdes hors du marché.
      double atr = 0.0;
      int ha = iATR(_Symbol, tfs[i], 14);
      if(ha != INVALID_HANDLE)
      {
         double ab[];
         ArraySetAsSeries(ab, true);
         if(CopyBuffer(ha, 0, 0, 1, ab) >= 1) atr = ab[0];
         IndicatorRelease(ha);
      }
      double pxNow = iClose(_Symbol, tfs[i], 0);
      if(atr > 0.0 && pxNow > 0.0 && MathAbs(p1 - pxNow) > atr * GOM_TL_MaxProjectionATR)
      {
         double sgn = (slope >= 0.0) ? 1.0 : -1.0;
         p1 = pxNow + sgn * atr * GOM_TL_MaxProjectionATR;
      }

      ObjectCreate(0, objName, OBJ_TREND, 0, t0, p0, t1, p1);
      ObjectSetInteger(0, objName, OBJPROP_COLOR, tfColors[i]);
      ObjectSetInteger(0, objName, OBJPROP_WIDTH, (i == 0) ? 3 : ((i <= 2) ? 2 : 1));
      ObjectSetInteger(0, objName, OBJPROP_STYLE, STYLE_SOLID);
      ObjectSetInteger(0, objName, OBJPROP_RAY_RIGHT, false);
      ObjectSetInteger(0, objName, OBJPROP_BACK, i > 2);
      ObjectSetInteger(0, objName, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, objName, OBJPROP_HIDDEN, false);
      ObjectSetString(0, objName, OBJPROP_TOOLTIP,
                      "GOM " + tfLabels[i] + " " + tfDirs[i] +
                      " | niveau live " + DoubleToString(slope * (double)TimeCurrent() + intercept, _Digits));

      // Keep the actionable M1/M5/M15 references readable above filled zones.
      ObjectCreate(0, lblName, OBJ_TEXT, 0, t1, p1);
      ObjectSetString(0, lblName, OBJPROP_TEXT,
                      "GOM " + tfLabels[i] + " " + tfDirs[i] + " " + DoubleToString(p1, _Digits));
      ObjectSetInteger(0, lblName, OBJPROP_COLOR, tfColors[i]);
      ObjectSetInteger(0, lblName, OBJPROP_FONTSIZE, (i <= 2) ? 9 : 8);
      ObjectSetInteger(0, lblName, OBJPROP_ANCHOR,
                       (tfDirs[i] == "BULL") ? ANCHOR_LOWER : ANCHOR_UPPER);
      ObjectSetInteger(0, lblName, OBJPROP_BACK, i > 2);
      ObjectSetInteger(0, lblName, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, lblName, OBJPROP_HIDDEN, false);
   }
}

