string SMCGP_ResolveGOMSym(const string sym)
{
   if(sym == "XAUEUR" || sym == "GOLD" || sym == "OR") return "XAUUSD";

   string s = sym;
   StringToUpper(s);
   string sc = s;
   StringReplace(sc, " ", "");

   // Weltrade PainX / GainX (compact ou espacé)
   int painPos = StringFind(sc, "PAINX");
   if(painPos >= 0)
   {
      string num = StringSubstr(sc, painPos + 5);
      if(StringLen(num) > 0) return "PainX " + num;
      return "PainX";
   }
   int gainPos = StringFind(sc, "GAINX");
   if(gainPos >= 0)
   {
      string num = StringSubstr(sc, gainPos + 5);
      if(StringLen(num) > 0) return "GainX " + num;
      return "GainX";
   }

   // Weltrade FX Vol / SFV Vol / SFX Vol
   if(StringFind(sc, "FXVOL") == 0)
   {
      string num = StringSubstr(sc, 5);
      if(StringLen(num) > 0) return "FX Vol " + num;
      return "FX Vol 20";
   }
   if(StringFind(sc, "SFVVOL") == 0)
   {
      string num = StringSubstr(sc, 6);
      if(StringLen(num) > 0) return "SFV Vol " + num;
      return "SFV Vol";
   }
   if(StringFind(sc, "SFXVOL") == 0)
   {
      string num = StringSubstr(sc, 6);
      if(StringLen(num) > 0) return "SFX Vol " + num;
      return "SFX Vol";
   }
   if(StringFind(s, "FX VOL") >= 0) return sym;
   if(StringFind(s, "SFV VOL") >= 0) return sym;
   if(StringFind(s, "SFX VOL") >= 0) return sym;

   if(StringFind(sym, "Index") >= 0) return sym;
   return sym;
}

bool SMCGP_HttpPost(const string path, const string &jsonBody, int timeoutMs = 3000)
{
   string url = SMCGP_ActiveServerURL() + path;
   char post[], result[];
   StringToCharArray(jsonBody, post, 0, WHOLE_ARRAY, CP_UTF8);
   string headers = "Content-Type: application/json\r\n";
   string respH;
   int code = WebRequest("POST", url, headers, timeoutMs, post, result, respH);
   g_smcLastHttpCode = code;
   bool ok = (code == 200 || code == 201);
   if(ok) SMCGP_MarkResult(true);
   else   SMCGP_MarkResult(false);
   return ok;
}

