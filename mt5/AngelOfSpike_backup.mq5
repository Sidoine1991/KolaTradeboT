//+------------------------------------------------------------------+
//| Afficher les Fair Value Gaps                                    |
//+------------------------------------------------------------------+
void DisplayFairValueGaps(const string symbol, MqlRates &rates[], int bars)
{
    for(int i = 1; i < bars - 1; i++)
    {
        // Détecter Fair Value Gap (FVG)
        bool isFVG = false;
        double fvgTop = 0, fvgBottom = 0;

        // FVG Bullish (gap haussier)
        if(rates[i-1].high < rates[i+1].low)
        {
            isFVG = true;
            fvgTop = rates[i+1].low;
            fvgBottom = rates[i-1].high;

