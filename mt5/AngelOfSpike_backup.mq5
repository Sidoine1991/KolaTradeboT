                }
            }
        }
    }
}

}

    // Calculer la taille de lot
    double lot = CalculateLotSize(symbol, InpCapitalPerTradeUSD);
    if(lot <= 0) return false;

    // Obtenir les prix
    double ask = SymbolInfoDouble(symbol, SYMBOL_ASK);
    double bid = SymbolInfoDouble(symbol, SYMBOL_BID);
    double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
    int digits = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);

    if(ask <= 0 || bid <= 0 || point <= 0) return false;

    // Calculer les niveaux de SL/TP
    double sl = 0, tp = 0;
    double maxLoss = GetMaxLossForSymbol(symbol);
    double targetProfit = InpTargetProfitUSD;

    // Obtenir les informations de trading du symbole
    double tickValue = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_VALUE);
    double tickSize = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);
    double minStopLevel = SymbolInfoInteger(symbol, SYMBOL_TRADE_STOPS_LEVEL) * point;
    double minLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
    double maxLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MAX);
    double lotStep = SymbolInfoDouble(symbol, SYMBOL_VOLUME_STEP);

    // S'assurer que le lot est dans les limites autorisées
    lot = MathFloor(lot / lotStep) * lotStep;
    lot = MathMax(minLot, MathMin(maxLot, lot));

    // Calculer les points de SL/TP en fonction du risque
    if(tickValue > 0 && tickSize > 0 && lot > 0)
    {
        double usdPerPointPerLot = tickValue * (point / tickSize);
        if(usdPerPointPerLot > 0)
        {
            // Calculer les points nécessaires pour atteindre le risque maximum
            double maxLossPoints = maxLoss / (usdPerPointPerLot * lot);
            double targetPoints = targetProfit / (usdPerPointPerLot * lot);

            // S'assurer que le SL est à une distance minimale
            double minSlDistance = minStopLevel * 1.5; // 1.5x la distance minimale requise
            maxLossPoints = MathMax(maxLossPoints, minSlDistance / point);

            // Calculer les niveaux de SL/TP
            if(direction == POSITION_TYPE_BUY)
            {
                sl = NormalizeDouble(ask - maxLossPoints * point, digits);
                tp = NormalizeDouble(ask + targetPoints * point, digits);

                // Vérifier que le SL est en dessous du prix actuel
                if(sl >= ask - minSlDistance)
                    sl = NormalizeDouble(ask - minSlDistance, digits);

                // Vérifier que le TP est au-dessus du prix actuel
                if(tp <= ask + minSlDistance)
                    tp = NormalizeDouble(ask + minSlDistance, digits);

