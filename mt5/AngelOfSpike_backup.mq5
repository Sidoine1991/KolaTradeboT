//+------------------------------------------------------------------+
//| Vérifier si le prix est près d'un niveau clé                   |
//+------------------------------------------------------------------+
bool IsNearKeyLevel(const string symbol, double price)
{
    // Vérifier les niveaux de support/résistance
    double levels[];
    int count = 0;

    // Analyser les niveaux récents
    MqlRates rates[];
    if(CopyRates(symbol, PERIOD_M5, 0, 50, rates) >= 50)
    {
        // Trouver les hauts et bas significatifs
        for(int i = 2; i < 48; i++)
        {
            if(rates[i].high > rates[i-1].high && rates[i].high > rates[i-2].high &&
               rates[i].high > rates[i+1].high && rates[i].high > rates[i+2].high)
            {
                ArrayResize(levels, count + 1);
                levels[count] = rates[i].high;
                count++;

