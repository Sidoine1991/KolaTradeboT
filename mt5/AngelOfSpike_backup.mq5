//+------------------------------------------------------------------+
//| Fermer la position après capture du spike                      |
//+------------------------------------------------------------------+
void ClosePositionAfterSpikeCapture()
{
    for(int i = PositionsTotal() - 1; i >= 0; i--)
    {
        if(PositionSelectByIndex(i))
        {
            if(PositionGetInteger(POSITION_MAGIC) == InpMagicNumber)
            {
                string symbol = PositionGetString(POSITION_SYMBOL);
                double profit = PositionGetDouble(POSITION_PROFIT);

                // Fermer si profit > 0 (spike capturé) ou si perte > seuil
                if(profit > 0 || profit < -InpMaxLossPerTradeUSD)
                {
                    if(PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
                    {
                        g_trade.Sell(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }
                    else
                    {
                        g_trade.Buy(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }

                    Print("✅ POSITION FERMEE APRES SPIKE: ", symbol, " - Profit: $", DoubleToString(profit, 2));
                }
            }
        }
    }
}

}
    double atr = atr_buffer[0];
    IndicatorRelease(atr_handle);

    double volatility = (atr / SymbolInfoDouble(symbol, SYMBOL_BID)) * 100; // Volatilité en %

    // Ajuster le lot en fonction de la volatilité
    double volatilityMultiplier = 1.0;
    if(volatility > 2.0) volatilityMultiplier = 0.8;  // Réduire le lot si volatilité élevée
    if(volatility < 0.5) volatilityMultiplier = 1.2;  // Augmenter le lot si volatilité faible

    lot = NormalizeDouble(baseLot * volatilityMultiplier, 2);

    // Vérifier les limites du broker
    double minLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
    double maxLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MAX);
    double stepLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_STEP);

    lot = MathMax(minLot, MathMin(maxLot, lot));
    lot = MathFloor(lot / stepLot) * stepLot;

    if(InpDebug)
    {
        Print("📊 Gestion dynamique des lots - ",
              "Base: ", baseLot, ", ",
              "Volatilité: ", DoubleToString(volatility,2), "%, ",
              "Multiplicateur: ", volatilityMultiplier, ", ",
              "Lot final: ", lot);

