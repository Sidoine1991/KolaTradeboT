//+------------------------------------------------------------------+
//| Mettre à jour les positions actives                              |
//+------------------------------------------------------------------+
void UpdateActivePositions()
{
    // Protection contre les boucles infinies
    static int lastUpdateTime = 0;
    int currentTime = (int)TimeCurrent();

    if(currentTime - lastUpdateTime < 1) // Maximum une fois par seconde
        return;

    lastUpdateTime = currentTime;

    // Limiter le nombre d'itérations pour éviter les boucles infinies
    int maxIterations = MathMin(g_positionCount, 100);

    // Vérifier d'abord si des positions ont été fermées
    for(int i = MathMin(g_positionCount - 1, maxIterations - 1); i >= 0; i--)
    {
        bool positionFound = false;

        for(int j = 0; j < PositionsTotal(); j++)
        {
            ulong ticket = PositionGetTicket(j);
            if(ticket > 0)
            {
                string posSymbol = PositionGetString(POSITION_SYMBOL);
                int posDirection = (int)PositionGetInteger(POSITION_TYPE);

                if(posSymbol == g_symbolPositions[i].symbol &&
                   posDirection == g_symbolPositions[i].direction)
                {
                    positionFound = true;

                    // Mettre à jour le prix actuel et le profit
                    double currentPrice = PositionGetDouble(POSITION_PRICE_CURRENT);

                    // Gérer le trailing stop
                    if(InpEnableTrailingStop)
                    {
                        ManageTrailingStop(g_symbolPositions[i].symbol, g_symbolPositions[i].direction, currentPrice);

