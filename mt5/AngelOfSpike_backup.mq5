//+------------------------------------------------------------------+
//| Vérifier si on peut ouvrir un symbole avec une direction donnée |
//+------------------------------------------------------------------+
bool CanOpenSymbol(const string symbol, const int direction)
{
    // Vérifier si c'est un symbole Boom/Crash
    bool isBoom = (StringFind(symbol, "Boom") >= 0);
    bool isCrash = (StringFind(symbol, "Crash") >= 0);
    bool isBoomCrash = isBoom || isCrash;

    // Vérification des trades à contre-tendance (BUY sur Crash ou SELL sur Boom)
    if((isCrash && direction == POSITION_TYPE_BUY) ||
       (isBoom && direction == POSITION_TYPE_SELL))
    {
        if(InpDebug) Print("❌ TRADE BLOQUÉ: Tentative de ",
                          (direction == POSITION_TYPE_BUY ? "BUY" : "SELL"),
                          " sur ", symbol, " interdit");
        return false;

//+------------------------------------------------------------------+
//| Fermer la position après capture du spike                      |
//+------------------------------------------------------------------+
void ClosePositionAfterSpikeCapture()
{
    for(int i = PositionsTotal() - 1; i >= 0; i--)
