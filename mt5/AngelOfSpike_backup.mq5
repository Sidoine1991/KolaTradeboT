//+------------------------------------------------------------------+
//| Calculer la volatilité des prix                                |
//+------------------------------------------------------------------+
double CalculateVolatility(MqlRates &rates[], int bars)
{
    if(bars < 5) return 0.0;

    double sum = 0.0;
    for(int i = 1; i < bars; i++)
    {
        double change = MathAbs(rates[i].close - rates[i-1].close);
        sum += change;

//+------------------------------------------------------------------+
