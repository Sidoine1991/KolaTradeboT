    }
}

}

        // Pivot bas (support)
        if(lows[i] < lows[i-1] && lows[i] < lows[i-2] &&
           lows[i] < lows[i+1] && lows[i] < lows[i+2])
        {
            ArrayResize(supportLevels, supportCount + 1);
            supportLevels[supportCount] = lows[i];
            supportCount++;

