            request.action = TRADE_ACTION_DEAL;
            request.symbol = symbol;
            request.volume = newVolume;
            request.type = (direction == POSITION_TYPE_BUY) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
            request.price = (direction == POSITION_TYPE_BUY) ?
