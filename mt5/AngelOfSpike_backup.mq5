    // Trouver l'index de la position
    int posIndex = -1;
    for(int i = 0; i < g_positionCount; i++)
    {
        if(g_symbolPositions[i].symbol == symbol && g_symbolPositions[i].direction == direction)
        {
            posIndex = i;
            break;

