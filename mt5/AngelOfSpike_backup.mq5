//| Calculer la pression de volume (simulée)                       |
//+------------------------------------------------------------------+
double CalculateVolumePressure(MqlRates &rates[], int bars)
{
    if(bars < 5) return 0.0;

    int bullishBars = 0;
    int bearishBars = 0;

    for(int i = 0; i < 5; i++)
    {
        if(rates[i].close > rates[i].open) bullishBars++;
        else if(rates[i].close < rates[i].open) bearishBars++;

