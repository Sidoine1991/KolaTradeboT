void InitializeTestedLevels()
{
    if(g_levelsInitialized) return;

    ArrayResize(g_testedLevels, 0);
    g_lastLevelUpdate = TimeCurrent();
    g_levelsInitialized = true;

    if(InpDebug)
    {
        Print("🔧 INITIALISATION: Système de niveaux testés positifs activé");

