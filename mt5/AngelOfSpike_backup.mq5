                        g_trade.Buy(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }

                    Print("✅ POSITION FERMEE APRES SPIKE: ", symbol, " - Profit: $", DoubleToString(profit, 2));
                }
            }
        }
    }
}

}

    // Déterminer la direction finale
    if(bullishSignals > bearishSignals) direction = POSITION_TYPE_BUY;
    else if(bearishSignals > bullishSignals) direction = POSITION_TYPE_SELL;
    else return false;

    confidence = totalConfidence;

    return confidence >= InpPredictionConfidenceMin;

