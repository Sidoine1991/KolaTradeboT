//+------------------------------------------------------------------+
//| Gérer le timing de prédiction avec séquence complète            |
//| Flèche → Notification → Exécution                               |
//+------------------------------------------------------------------+
void ManagePredictionTiming(const string symbol)
{
    datetime currentTime = TimeCurrent();

    // Si une prédiction est active pour ce symbole
    if(g_predictionActive && g_predictionSymbol == symbol)
    {
        int elapsedSeconds = (int)(currentTime - g_predictionStartTime);

        // Phase 1: Affichage de la flèche clignotante (0 à 3 secondes)
        if(elapsedSeconds < InpPredictionAdvanceSeconds)
        {
            // Gérer le clignotement de la flèche
            if(currentTime - g_lastBlinkTime >= InpBlinkIntervalMs / 1000)
            {
                g_blinkState = !g_blinkState;
                g_lastBlinkTime = currentTime;

                if(InpShowBlinkingArrows)
                {
                    if(g_blinkState)
                    {
                        DrawPredictiveArrow(symbol, g_predictionProbability);

