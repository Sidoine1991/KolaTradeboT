//+------------------------------------------------------------------+
//| Dessiner une flèche prédictive clignotante et exécuter un trade  |
//+------------------------------------------------------------------+
void DrawPredictiveArrow(const string symbol, double probability)
{
    // Supprimer les anciennes flèches pour ce symbole
    ObjectsDeleteAll(0, "Predictive_" + symbol);

    if(probability < InpSpikeProbabilityThreshold)
        return;

    // Obtenir le prix actuel
    double currentPrice = SymbolInfoDouble(symbol, SYMBOL_BID);
    datetime currentTime = TimeCurrent();

    // Déterminer la direction basée sur la probabilité
    int direction = 0;
    if(probability >= InpAutoExecuteThreshold)
    {
        direction = ChooseSignalDirection(symbol);

        // Exécuter le trade automatiquement si la probabilité est suffisante
        if(direction != 0 && InpAutoExecuteAfterNotification)
        {
            // Déclarer les variables nécessaires
            double lotSize = 0.1; // Taille de lot par défaut
            double stopLoss = 0.0, takeProfit = 0.0;
            double point = SymbolInfoDouble(symbol, SYMBOL_POINT);

            // Vérifier si la fonction CalculateLotSize existe, sinon utiliser une valeur par défaut
            if(GetLastError() == 0) // Vérification simple de l'absence d'erreur
            {
                double tempLot = CalculateLotSize(symbol, 1.0);
                if(tempLot > 0) // Vérifier que la valeur retournée est valide
                    lotSize = tempLot; // 1% de risque par défaut

