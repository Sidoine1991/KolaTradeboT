    ArrayResize(lows, InpZoneLookbackPeriods);

    // Récupérer les hauts et bas
    for(int i = 1; i <= InpZoneLookbackPeriods; i++)
    {
        highs[i-1] = iHigh(symbol, PERIOD_CURRENT, i);
        lows[i-1] = iLow(symbol, PERIOD_CURRENT, i);

