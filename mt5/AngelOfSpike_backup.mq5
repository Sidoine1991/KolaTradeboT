//+------------------------------------------------------------------+
//| Détection de spike ultra-réactive pour Boom/Crash               |
//+------------------------------------------------------------------+
bool DetectBoomCrashSpikeUltraFast(const string symbol, int &direction, double &confidence)
{
    if(!InpUltraFastMode) return false;

    // Vérifier si c'est un symbole Boom/Crash
    bool isBoom = (StringFind(symbol, "Boom") >= 0);
    bool isCrash = (StringFind(symbol, "Crash") >= 0);
    if(!isBoom && !isCrash) return false;

    MqlRates rates[];
    if(CopyRates(symbol, PERIOD_M1, 0, 5, rates) < 5) return false;

    double currentPrice = rates[0].close;
    double previousPrice = rates[1].close;
    double priceChange = MathAbs(currentPrice - previousPrice);
    double point = SymbolInfoDouble(symbol, SYMBOL_POINT);

    if(point <= 0) return false;

    // Seuil ultra-sensible pour Boom/Crash
    double spikeThreshold = InpBoomCrashSpikeThreshold * point;

    if(priceChange >= spikeThreshold)
    {
        // Déterminer la direction
        if(currentPrice > previousPrice)
        {
            direction = POSITION_TYPE_BUY;
            confidence = MathMin(100.0, (priceChange / spikeThreshold) * 50.0);

