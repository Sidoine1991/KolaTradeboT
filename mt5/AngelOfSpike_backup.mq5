//| Calculer le momentum                                            |
//+------------------------------------------------------------------+
double CalculateMomentum(MqlRates &rates[], int periods)
{
    if(periods < 2) return 0.0;

    double sum = 0.0;
    for(int i = 0; i < periods; i++)
    {
        sum += rates[i].close - rates[i+1].close;

