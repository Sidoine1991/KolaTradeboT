                    }
                    else
                    {
                        g_trade.Buy(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }

                    Print("✅ POSITION FERMEE APRES SPIKE: ", symbol, " - Profit: $", DoubleToString(profit, 2));
                }
            }
        }
    }
}

}

    // Pour les indices Boom/Crash, on utilise des règles spécifiques
    if(isBoomCrash)
    {
        // Vérifier le spread (doit être raisonnable)
        double spread = (double)SymbolInfoInteger(symbol, SYMBOL_SPREAD) * SymbolInfoDouble(symbol, SYMBOL_POINT);
        if(spread > 5.0) // Spread maximum de 5 points pour les Boom/Crash (augmenté pour plus d'opportunités)
        {
            if(InpDebug) Print("❌ Spread trop élevé pour ", symbol, ": ", DoubleToString(spread, 1), " points");
            return false;

