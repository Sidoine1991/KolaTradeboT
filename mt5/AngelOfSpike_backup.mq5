                    }
                    else
                    {
                        g_trade.Buy(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }

                    Print("✅ POSITION FERMEE APRES SPIKE: ", symbol, " - Profit: $", DoubleToString(profit, 2));
                }
            }
        }
    }
}

}
    else if(recentVolatility > 0.4)
    {
        probability += 20.0;

