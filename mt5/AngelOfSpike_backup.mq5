//+------------------------------------------------------------------+
//| Afficher les Order Blocks                                       |
//+------------------------------------------------------------------+
void DisplayOrderBlocks(const string symbol, MqlRates &rates[], int bars)
{
    for(int i = 2; i < bars - 2; i++)
    {
        // Détecter un Order Block (candlestick avec corps important)
        double body = MathAbs(rates[i].close - rates[i].open);
        double range = rates[i].high - rates[i].low;

        if(body / range > 0.7) // Corps représente plus de 70% de la bougie
        {
            string obName = "ICT_OB_" + IntegerToString(i);
            datetime startTime = rates[i].time;
            datetime endTime = TimeCurrent() + 3600; // 1 heure dans le futur

            double top = MathMax(rates[i].open, rates[i].close);
            double bottom = MathMin(rates[i].open, rates[i].close);

            // Couleur selon la direction
            color obColor = (rates[i].close > rates[i].open) ? clrLime : clrRed;

            if(ObjectCreate(0, obName, OBJ_RECTANGLE, 0, startTime, top, endTime, bottom))
            {
                ObjectSetInteger(0, obName, OBJPROP_COLOR, obColor);
                ObjectSetInteger(0, obName, OBJPROP_FILL, true);
                ObjectSetInteger(0, obName, OBJPROP_BACK, true);
                ObjectSetInteger(0, obName, OBJPROP_STYLE, STYLE_SOLID);
                ObjectSetInteger(0, obName, OBJPROP_WIDTH, 1);
                ObjectSetInteger(0, obName, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
                ObjectSetInteger(0, obName, OBJPROP_SELECTABLE, false);
                ObjectSetInteger(0, obName, OBJPROP_HIDDEN, true);

