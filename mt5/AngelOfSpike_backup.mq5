//+------------------------------------------------------------------+
//| Vérifier si un nouveau trade peut être exécuté                  |
//+------------------------------------------------------------------+
bool CanExecuteNewTrade(const string symbol, const int direction)
{
    if(!InpStrictSingleTrade) return true;

    // VÉRIFICATION 0: BLOCAGE GLOBAL ULTRA-STRICT
    if(g_globalTradeBlocked && TimeCurrent() < g_globalBlockUntil)
    {
