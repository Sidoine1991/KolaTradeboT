    double highestProfit; // Meilleur profit atteint (pour trailing stop)
    PositionLevel levels[]; // Niveaux d'échellonnage
    bool isHedged; // Si une position de couverture est ouverte
    double hedgeVolume; // Volume de la position de couverture

