                {
                    // Déterminer la direction basée sur la tendance consolidée
                    int direction = 0;
                    if(globalTrend.consolidatedTrend == 1) direction = POSITION_TYPE_BUY;
                    else if(globalTrend.consolidatedTrend == -1) direction = POSITION_TYPE_SELL;

                    // Vérifier la direction pour Boom/Crash
                    bool directionAllowed = true;
                    if(StringFind(symbol, "Boom") >= 0 && direction != POSITION_TYPE_BUY) directionAllowed = false;
                    if(StringFind(symbol, "Crash") >= 0 && direction != POSITION_TYPE_SELL) directionAllowed = false;

                    // Exécuter le trade si conditions remplies
                    if(directionAllowed && direction != 0 && globalTrend.confidence >= 70.0)
                    {
                        tradeExecuted = ExecuteAdvancedTrade(symbol, direction, globalTrend.confidence);

