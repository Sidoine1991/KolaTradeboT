//+------------------------------------------------------------------+
//| Afficher la structure du marché                                |
//+------------------------------------------------------------------+
void DisplayMarketStructure(const string symbol)
{
    MqlRates rates[];
    if(CopyRates(symbol, PERIOD_M5, 0, 20, rates) < 20) return;

    // Analyser la structure du marché (Higher Highs, Lower Lows, etc.)
    int higherHighs = 0, lowerHighs = 0;
    int higherLows = 0, lowerLows = 0;

    for(int i = 1; i < 20; i++)
    {
        if(rates[i].high > rates[i-1].high) higherHighs++;
        else if(rates[i].high < rates[i-1].high) lowerHighs++;

        if(rates[i].low > rates[i-1].low) higherLows++;
        else if(rates[i].low < rates[i-1].low) lowerLows++;

//+------------------------------------------------------------------+
//| Fermer la position après capture du spike                      |
//+------------------------------------------------------------------+
void ClosePositionAfterSpikeCapture()
{
    for(int i = PositionsTotal() - 1; i >= 0; i--)
    {
        if(PositionSelectByIndex(i))
        {
            if(PositionGetInteger(POSITION_MAGIC) == InpMagicNumber)
            {
                string symbol = PositionGetString(POSITION_SYMBOL);
                double profit = PositionGetDouble(POSITION_PROFIT);

                // Fermer si profit > 0 (spike capturé) ou si perte > seuil
                if(profit > 0 || profit < -InpMaxLossPerTradeUSD)
                {
                    if(PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
                    {
                        g_trade.Sell(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }
                    else
                    {
                        g_trade.Buy(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }

                    Print("✅ POSITION FERMEE APRES SPIKE: ", symbol, " - Profit: $", DoubleToString(profit, 2));
                }
            }
        }
    }
}

}

    // Déterminer la structure
    string structure = "";
    if(higherHighs > lowerHighs && higherLows > lowerLows) structure = "UPTREND";
    else if(lowerHighs > higherHighs && lowerLows > higherLows) structure = "DOWNTREND";
    else structure = "RANGING";

    // Afficher la structure
    string structName = "MARKET_STRUCTURE_" + symbol;
    if(ObjectCreate(0, structName, OBJ_TEXT, 0, TimeCurrent(), SymbolInfoDouble(symbol, SYMBOL_BID)))
    {
        ObjectSetString(0, structName, OBJPROP_TEXT, "Structure: " + structure);
        ObjectSetInteger(0, structName, OBJPROP_COLOR, clrWhite);
        ObjectSetInteger(0, structName, OBJPROP_FONTSIZE, 10);
        ObjectSetString(0, structName, OBJPROP_FONT, "Arial Bold");

