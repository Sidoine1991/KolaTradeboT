    if(swingHigh > 0 && swingLow < 1000000)
    {
        double range = swingHigh - swingLow;

        // Zone OTE 61.8% - 78.6%
        double oteTop = swingHigh - (range * 0.382); // 61.8% retracement
        double oteBottom = swingHigh - (range * 0.618); // 78.6% retracement

        string oteName = "ICT_OTE_" + symbol;
        datetime startTime = rates[swingHighIndex].time;
        datetime endTime = TimeCurrent() + 3600;

        if(ObjectCreate(0, oteName, OBJ_RECTANGLE, 0, startTime, oteTop, endTime, oteBottom))
        {
            ObjectSetInteger(0, oteName, OBJPROP_COLOR, clrGold);
            ObjectSetInteger(0, oteName, OBJPROP_FILL, true);
            ObjectSetInteger(0, oteName, OBJPROP_BACK, true);
            ObjectSetInteger(0, oteName, OBJPROP_STYLE, STYLE_DOT);
            ObjectSetInteger(0, oteName, OBJPROP_WIDTH, 2);
            ObjectSetInteger(0, oteName, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
            ObjectSetInteger(0, oteName, OBJPROP_SELECTABLE, false);
            ObjectSetInteger(0, oteName, OBJPROP_HIDDEN, true);

