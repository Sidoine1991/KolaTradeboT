    // Si la position n'existe pas encore dans notre tableau, on la crée
    if(posIndex == -1)
    {
        // Vérifier d'abord qu'il y a une position ouverte
        if(PositionsTotal() == 0) return;

        // Trouver la position réelle
        for(int i = 0; i < PositionsTotal(); i++)
        {
            ulong ticket = PositionGetTicket(i);
            if(ticket > 0)
            {
                string posSymbol = PositionGetString(POSITION_SYMBOL);
                int posDirection = (int)PositionGetInteger(POSITION_TYPE);

                if(posSymbol == symbol && posDirection == direction)
                {
                    // Ajouter une nouvelle entrée dans notre tableau
                    SymbolPositionData newPos;
                    newPos.symbol = symbol;
                    newPos.direction = direction;
                    newPos.scalingLevel = 0;
                    newPos.initialVolume = PositionGetDouble(POSITION_VOLUME);
                    newPos.highestProfit = 0;
                    newPos.isHedged = false;
                    newPos.hedgeVolume = 0;

                    // Ajouter le niveau initial
                    PositionLevel level;
                    level.entryPrice = PositionGetDouble(POSITION_PRICE_OPEN);
                    level.volume = newPos.initialVolume;
                    level.sl = PositionGetDouble(POSITION_SL);
                    level.tp = PositionGetDouble(POSITION_TP);

                    ArrayResize(newPos.levels, 1);
                    newPos.levels[0] = level;

                    // Ajouter au tableau global
                    int newSize = g_positionCount + 1;
                    ArrayResize(g_symbolPositions, newSize);
                    g_symbolPositions[g_positionCount] = newPos;
                    g_positionCount = newSize;

                    posIndex = g_positionCount - 1;
                    break;

