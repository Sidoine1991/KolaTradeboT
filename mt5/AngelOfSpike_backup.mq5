                        g_trade.Buy(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }

                    Print("✅ POSITION FERMEE APRES SPIKE: ", symbol, " - Profit: $", DoubleToString(profit, 2));
                }
            }
        }
    }
}

}

    // Créer des niveaux de volume profile
    double range = maxPrice - minPrice;
    int levels = 10;

    for(int i = 0; i < levels; i++)
    {
        double level = minPrice + (range * i / levels);
        string vpName = "VOLUME_PROFILE_" + IntegerToString(i) + "_" + symbol;

        if(ObjectCreate(0, vpName, OBJ_HLINE, 0, 0, level))
        {
            ObjectSetInteger(0, vpName, OBJPROP_COLOR, clrBlue);
            ObjectSetInteger(0, vpName, OBJPROP_STYLE, STYLE_DOT);
            ObjectSetInteger(0, vpName, OBJPROP_WIDTH, 1);

