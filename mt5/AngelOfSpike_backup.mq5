//+------------------------------------------------------------------+
//| Afficher le Volume Profile                                      |
//+------------------------------------------------------------------+
void DisplayVolumeProfile(const string symbol)
{
    MqlRates rates[];
    if(CopyRates(symbol, PERIOD_M5, 0, 20, rates) < 20) return;

    // Simuler le Volume Profile (pour Boom/Crash, on simule avec la volatilité)
    double maxPrice = 0, minPrice = 1000000;

    for(int i = 0; i < 20; i++)
    {
        if(rates[i].high > maxPrice) maxPrice = rates[i].high;
        if(rates[i].low < minPrice) minPrice = rates[i].low;

//+------------------------------------------------------------------+
//| Fermer la position après capture du spike                      |
//+------------------------------------------------------------------+
void ClosePositionAfterSpikeCapture()
{
    for(int i = PositionsTotal() - 1; i >= 0; i--)
    {
        if(PositionSelectByIndex(i))
        {
            if(PositionGetInteger(POSITION_MAGIC) == InpMagicNumber)
