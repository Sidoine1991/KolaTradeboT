    // Vérifier si on doit ajouter un niveau d'échellonnage
    if(g_symbolPositions[posIndex].scalingLevel < InpMaxScalingLevels)
    {
        double distance = (direction == POSITION_TYPE_BUY) ?
                         (currentPrice - g_symbolPositions[posIndex].levels[0].entryPrice) :
                         (g_symbolPositions[posIndex].levels[0].entryPrice - currentPrice);

        // Vérifier si la distance est suffisante pour un nouvel échelon
        if(distance >= (InpScalingDistance * atrValue / point))
        {
            // Calculer le volume du nouvel échelon
            double newVolume = g_symbolPositions[posIndex].initialVolume *
                             (1.0 + (g_symbolPositions[posIndex].scalingLevel + 1) * InpScalingStep);

            // Arrondir le volume selon les spécifications du broker
            double volumeStep = SymbolInfoDouble(symbol, SYMBOL_VOLUME_STEP);
            newVolume = MathFloor(newVolume / volumeStep) * volumeStep;

            // Vérifier que le volume est valide
            double minVolume = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
            double maxVolume = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MAX);
            newVolume = MathMax(minVolume, MathMin(maxVolume, newVolume));

            // Calculer le nouveau SL et TP
            double sl = 0, tp = 0;
            if(direction == POSITION_TYPE_BUY)
            {
                sl = currentPrice - (atrValue * 1.5);
                tp = currentPrice + (atrValue * 2.5);

