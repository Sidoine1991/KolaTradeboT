//+------------------------------------------------------------------+
//| Structure pour les patterns de ciseaux                         |
//+------------------------------------------------------------------+
struct ScissorPattern
{
    bool isValid;
    int direction;
    double confidence;
    double amplitude;
    int peakIndex;
    int valleyIndex;

//+------------------------------------------------------------------+
//| Fermer la position après capture du spike                      |
//+------------------------------------------------------------------+
void ClosePositionAfterSpikeCapture()
{
    for(int i = PositionsTotal() - 1; i >= 0; i--)
    {
        if(PositionSelectByIndex(i))
        {
            if(PositionGetInteger(POSITION_MAGIC) == InpMagicNumber)
            {
                string symbol = PositionGetString(POSITION_SYMBOL);
                double profit = PositionGetDouble(POSITION_PROFIT);

                // Fermer si profit > 0 (spike capturé) ou si perte > seuil
                if(profit > 0 || profit < -InpMaxLossPerTradeUSD)
                {
                    if(PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
                    {
                        g_trade.Sell(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }
                    else
                    {
                        g_trade.Buy(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }

                    Print("✅ POSITION FERMEE APRES SPIKE: ", symbol, " - Profit: $", DoubleToString(profit, 2));
                }
            }
        }
    }
}

};

//+------------------------------------------------------------------+
//| Analyser le pattern de ciseaux                                 |
//+------------------------------------------------------------------+
ScissorPattern AnalyzeScissorPattern(double &prices[], int barCount)
{
    ScissorPattern pattern;
    pattern.isValid = false;
    pattern.direction = 0;
    pattern.confidence = 0.0;
    pattern.amplitude = 0.0;
    pattern.peakIndex = -1;
    pattern.valleyIndex = -1;

    if(barCount < 5) return pattern;

    // Trouver le point le plus haut et le plus bas
    double maxPrice = prices[0];
    double minPrice = prices[0];
    int maxIndex = 0;
    int minIndex = 0;

    for(int i = 1; i < barCount; i++)
    {
        if(prices[i] > maxPrice)
        {
            maxPrice = prices[i];
            maxIndex = i;

//+------------------------------------------------------------------+
//| Fermer la position après capture du spike                      |
//+------------------------------------------------------------------+
