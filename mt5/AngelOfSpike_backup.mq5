            if(PositionGetInteger(POSITION_MAGIC) == InpMagicNumber)
            {
                string symbol = PositionGetString(POSITION_SYMBOL);
                double profit = PositionGetDouble(POSITION_PROFIT);

                // Fermer si profit > 0 (spike capturé) ou si perte > seuil
                if(profit > 0 || profit < -InpMaxLossPerTradeUSD)
                {
                    if(PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
                    {
                        g_trade.Sell(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }
                    else
                    {
                        g_trade.Buy(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }

                    Print("✅ POSITION FERMEE APRES SPIKE: ", symbol, " - Profit: $", DoubleToString(profit, 2));
                }
            }
        }
    }
}

}

    if(direction == 0)
        return;

    // Couleur de la flèche
    color arrowColor = (direction == POSITION_TYPE_BUY) ? clrLime : clrRed;

    // Créer la flèche
    string arrowName = "Predictive_" + symbol + "_" + IntegerToString(currentTime);

    if(ObjectCreate(0, arrowName, OBJ_ARROW, 0, currentTime, currentPrice))
    {
        ObjectSetInteger(0, arrowName, OBJPROP_ARROWCODE, (direction == POSITION_TYPE_BUY) ? 233 : 234);
        ObjectSetInteger(0, arrowName, OBJPROP_COLOR, arrowColor);
        ObjectSetInteger(0, arrowName, OBJPROP_WIDTH, 3);
        ObjectSetString(0, arrowName, OBJPROP_TEXT, "Prob: " + DoubleToString(probability, 1) + "%");

        // Faire clignoter la flèche
        if(InpShowBlinkingArrows)
        {
            g_lastBlinkTime = currentTime;
            g_blinkState = !g_blinkState;

            if(g_blinkState)
            {
                ObjectSetInteger(0, arrowName, OBJPROP_COLOR, clrYellow);

