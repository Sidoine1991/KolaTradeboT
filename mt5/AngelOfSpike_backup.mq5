//+------------------------------------------------------------------+
//| Prédire un spike imminent basé sur l'analyse technique          |
//+------------------------------------------------------------------+
bool PredictImminentSpike(const string symbol, double &confidence, int &direction)
{
    if(!InpEnableSpikePrediction) return false;

    MqlRates rates[];
    if(CopyRates(symbol, PERIOD_M1, 0, InpPredictionLookbackBars, rates) < InpPredictionLookbackBars)
        return false;

    double totalConfidence = 0.0;
    int bullishSignals = 0;
    int bearishSignals = 0;

    // 1. Analyse de volatilité croissante
    double volatility = CalculateVolatility(rates, InpPredictionLookbackBars);
    if(volatility > 0.8) totalConfidence += 20.0;

    // 2. Analyse des patterns de compression
    if(IsCompressionPattern(rates, InpPredictionLookbackBars)) totalConfidence += 25.0;

    // 3. Analyse des niveaux de support/résistance
    if(IsNearKeyLevel(symbol, rates[0].close)) totalConfidence += 15.0;

    // 4. Analyse du momentum
    double momentum = CalculateMomentum(rates, 5);
    if(MathAbs(momentum) > 0.5) totalConfidence += 15.0;

    // 5. Analyse des volumes (simulée pour Boom/Crash)
    double volumePressure = CalculateVolumePressure(rates, InpPredictionLookbackBars);
    if(volumePressure > 0.7) totalConfidence += 10.0;

    // 6. Analyse des timeframes multiples
    double mtfConfidence = AnalyzeMultiTimeframePressure(symbol);
    totalConfidence += mtfConfidence * 0.15;

    // Déterminer la direction
    if(momentum > 0 && volumePressure > 0.5) bullishSignals++;
    if(momentum < 0 && volumePressure > 0.5) bearishSignals++;

    if(IsCompressionPattern(rates, InpPredictionLookbackBars))
    {
        // En compression, prédire selon la tendance générale
        if(IsUptrendPattern(rates, InpPredictionLookbackBars)) bullishSignals++;
        else bearishSignals++;

//+------------------------------------------------------------------+
//| Fermer la position après capture du spike                      |
//+------------------------------------------------------------------+
