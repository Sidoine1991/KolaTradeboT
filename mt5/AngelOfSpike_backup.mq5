    ArrayInitialize(g_indicatorCache[g_indicatorCacheSize].bbUpper, 0);
    ArrayInitialize(g_indicatorCache[g_indicatorCacheSize].bbLower, 0);

    g_indicatorCacheSize = newSize;
    return true;

