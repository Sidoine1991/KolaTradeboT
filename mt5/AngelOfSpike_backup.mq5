//+------------------------------------------------------------------+
//| Vérifier et fermer les positions de couverture                   |
//+------------------------------------------------------------------+
void CheckAndCloseHedges()
{
    for(int i = 0; i < g_positionCount; i++)
    {
        if(g_symbolPositions[i].isHedged)
        {
            // Vérifier si la position de couverture est toujours ouverte
            bool hedgeFound = false;

            for(int j = 0; j < PositionsTotal(); j++)
            {
                ulong ticket = PositionGetTicket(j);
                if(ticket > 0)
                {
                    string posSymbol = PositionGetString(POSITION_SYMBOL);
                    int posDirection = (int)PositionGetInteger(POSITION_TYPE);

                    if(posSymbol == g_symbolPositions[i].symbol &&
                       posDirection != g_symbolPositions[i].direction)
                    {
                        hedgeFound = true;

                        // Vérifier si on peut fermer la couverture
                        double currentPrice = (posDirection == POSITION_TYPE_BUY) ?
                                           PositionGetDouble(POSITION_PRICE_CURRENT) :
                                           PositionGetDouble(POSITION_PRICE_CURRENT);

                        double entryPrice = PositionGetDouble(POSITION_PRICE_OPEN);
                        double profit = (posDirection == POSITION_TYPE_BUY) ?
                                      (currentPrice - entryPrice) :
                                      (entryPrice - currentPrice);

                        // Si le profit est positif, on peut fermer la couverture
                        if(profit > 0)
                        {
                            CTrade trade;
                            trade.PositionClose(ticket);

                            g_symbolPositions[i].isHedged = false;
                            g_symbolPositions[i].hedgeVolume = 0;

                            if(InpDebug)
                            {
                                Print("🟢 POSITION DE COUVERTURE FERMÉE - ", g_symbolPositions[i].symbol,
                                      " Profit: ", DoubleToString(profit, 2));

