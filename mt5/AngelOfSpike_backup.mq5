    double prices[5];
    bool validData = true;

    // Récupérer les prix de clôture
    for(int i = 1; i <= 5; i++)
    {
        prices[i-1] = iClose(symbol, PERIOD_CURRENT, i);
        if(prices[i-1] <= 0)
        {
            validData = false;
            break;

