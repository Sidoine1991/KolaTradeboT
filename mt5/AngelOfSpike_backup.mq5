    // Afficher les indicateurs sur le graphique actuel
    string currentSymbol = Symbol();
    DrawIndicators(currentSymbol);

    // Activer le mode Boom/Crash
    g_isBoomCrashMode = true;

    // Vérifier les signaux Boom/Crash si le trading est activé
    if(InpEnableBoomCrashTrading)
    {
        // Liste des symboles Boom/Crash disponibles
        string boomCrashSymbols[2] = {"Boom 1000", "Crash 1000"}; // Exemple de symboles, à adapter
        int count = ArraySize(boomCrashSymbols);

        // Vérifier chaque symbole Boom/Crash
        for(int i = 0; i < count; i++)
        {
            symbol = boomCrashSymbols[i];

            // Vérifier si on peut trader ce symbole dans les deux directions
            // car la direction sera déterminée plus tard
            if(CanOpenSymbol(symbol, POSITION_TYPE_BUY) || CanOpenSymbol(symbol, POSITION_TYPE_SELL))
            {
                double confidence = 0.0;
                int signal = CheckBoomCrashSignal(symbol, confidence);

                // Si un signal est détecté et que la confiance est suffisante
                if(signal != 0 && confidence >= 70.0)
                {
                    // Calculer le lot en fonction du risque
                    double lotSize = CalculateBoomCrashLotSize(symbol, 1.0); // 1% de risque

                    // Calculer le stop loss et le take profit
                    double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
                    double entry = (signal == POSITION_TYPE_BUY) ?
                                 SymbolInfoDouble(symbol, SYMBOL_ASK) :
                                 SymbolInfoDouble(symbol, SYMBOL_BID);
                    double stopLoss = (signal == POSITION_TYPE_BUY) ?
                                    entry - (g_boomCrashMinProfitPoints * 0.5 * point) :
                                    entry + (g_boomCrashMinProfitPoints * 0.5 * point);
                    double takeProfit = (signal == POSITION_TYPE_BUY) ?
                                      entry + (g_boomCrashMinProfitPoints * point) :
                                      entry - (g_boomCrashMinProfitPoints * point);

                    // Exécuter le trade
                    CTrade trade;
                    trade.SetExpertMagicNumber(123456); // Utiliser un magic number spécifique pour Boom/Crash

                    if(signal == POSITION_TYPE_BUY)
                    {
                        if(trade.Buy(lotSize, symbol, 0, stopLoss, takeProfit, "Boom/Crash Buy"))
                        {
                            Print("✅ Achat Boom/Crash sur ", symbol,
                                  " - Lot: ", DoubleToString(lotSize, 2),
                                  " - SL: ", DoubleToString(stopLoss, (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS)),
                                  " - TP: ", DoubleToString(takeProfit, (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS)));

