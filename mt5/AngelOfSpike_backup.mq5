//+------------------------------------------------------------------+
//| Afficher les vagues d'Elliott                                   |
//+------------------------------------------------------------------+
void DisplayElliottWaves(const string symbol)
{
    MqlRates rates[];
    if(CopyRates(symbol, PERIOD_M5, 0, 20, rates) < 20) return;

    // Analyser les vagues d'Elliott (simplifié)
    double wave1 = rates[19].close - rates[15].close;
    double wave2 = rates[15].close - rates[10].close;
    double wave3 = rates[10].close - rates[5].close;
    double wave4 = rates[5].close - rates[2].close;
    double wave5 = rates[2].close - rates[0].close;

    // Vérifier les ratios d'Elliott
    bool isElliottPattern = false;
    if(MathAbs(wave3) > MathAbs(wave1) && MathAbs(wave3) > MathAbs(wave5))
    {
        isElliottPattern = true;

