//+------------------------------------------------------------------+
//| Gérer les positions ouvertes avec SL/TP automatiques            |
//+------------------------------------------------------------------+
void ManageOpenPositions()
{
    // CORRECTION: Ne pas fermer automatiquement les positions
    // Les positions restent ouvertes jusqu'à ce que l'utilisateur les ferme manuellement
    // ou qu'elles atteignent leur SL/TP
    if(!InpAutoClosePositions) return;

    // CONTRÔLE STRICT: Empêcher les fermetures/rouvertures automatiques si activé
    if(InpPreventAutoCloseOpen)
    {
        static datetime lastCloseTime = 0;
        if(TimeCurrent() - lastCloseTime < 60) // Attendre 1 minute après une fermeture
        {
            return; // Ne pas gérer les positions pendant cette période

