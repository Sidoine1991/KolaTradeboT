//+------------------------------------------------------------------+
//| Obtenir la perte maximale selon le symbole                      |
//+------------------------------------------------------------------+
double GetMaxLossForSymbol(const string symbol)
{
    if(StringFind(symbol, "Boom") >= 0 || StringFind(symbol, "Crash") >= 0)
        return InpMaxLossBoomCrashUSD;
    return InpMaxLossOtherUSD;

