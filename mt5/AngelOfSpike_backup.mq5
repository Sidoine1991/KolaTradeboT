            request.sl = sl;
            request.tp = tp;
            request.deviation = 10;
            request.magic = InpMagicNumber;
            request.comment = "Scaling " + IntegerToString(g_symbolPositions[posIndex].scalingLevel + 1);

            // Envoyer l'ordre
            bool success = OrderSend(request, result);

            if(success && result.retcode == TRADE_RETCODE_DONE)
            {
                // Mettre à jour les données de position
                g_symbolPositions[posIndex].scalingLevel++;

                // Ajouter le nouveau niveau
                int newSize = g_symbolPositions[posIndex].scalingLevel + 1;
                ArrayResize(g_symbolPositions[posIndex].levels, newSize);

                PositionLevel newLevel;
                newLevel.entryPrice = request.price;
                newLevel.volume = newVolume;
                newLevel.sl = sl;
                newLevel.tp = tp;

                g_symbolPositions[posIndex].levels[g_symbolPositions[posIndex].scalingLevel] = newLevel;

                if(InpDebug)
                {
                    Print("🔵 NOUVEL ÉCHELON AJOUTÉ - ", symbol,
                          " Niveau: ", g_symbolPositions[posIndex].scalingLevel,
                          " Volume: ", DoubleToString(newVolume, 2),
                          " Prix: ", DoubleToString(request.price, (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS)));

