    if(bars < 5) return false;

    int higherHighs = 0;
    int higherLows = 0;

    for(int i = 1; i < 5; i++)
    {
        if(rates[i].high > rates[i-1].high) higherHighs++;
        if(rates[i].low > rates[i-1].low) higherLows++;

