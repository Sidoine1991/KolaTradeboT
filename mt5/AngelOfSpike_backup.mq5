}

        // Arrêter le trading
        Print("🚫 TRADING ARRÊTÉ: Perte totale max atteinte ($", InpMaxTotalLoss, ")");
        Print("📊 Perte finale après fermeture: $", DoubleToString(remainingLoss, 2));

        // Envoyer une notification
        if(InpSendNotifications)
        {
            string message = "ALERTE: Perte maximale atteinte!\n";
            message += "Perte: $" + DoubleToString(currentGlobalLoss, 2) + "\n";
            message += "Seuil: $" + DoubleToString(InpMaxTotalLoss, 2);
            SendNotification(message);

