//+------------------------------------------------------------------+
//| Afficher les patterns harmoniques                               |
//+------------------------------------------------------------------+
void DisplayHarmonicPatterns(const string symbol)
{
    MqlRates rates[];
    if(CopyRates(symbol, PERIOD_M5, 0, 20, rates) < 20) return;

    // Détecter les patterns harmoniques (Gartley, Butterfly, etc.)
    double X = rates[19].low;   // Point X
    double A = rates[15].high;  // Point A
    double B = rates[10].low;   // Point B
    double C = rates[5].high;   // Point C
    double D = rates[0].low;    // Point D

    // Calculer les ratios de Fibonacci
    double AB = MathAbs(A - B);
    double BC = MathAbs(B - C);
    double CD = MathAbs(C - D);
    double XA = MathAbs(X - A);

    // Pattern Gartley (AB = 61.8% de XA, CD = 78.6% de BC)
    double abRatio = (XA > 0) ? AB / XA : 0;
    double cdRatio = (BC > 0) ? CD / BC : 0;

    if(MathAbs(abRatio - 0.618) < 0.1 && MathAbs(cdRatio - 0.786) < 0.1)
    {
        string harmonicName = "HARMONIC_GARTLEY_" + symbol;
        if(ObjectCreate(0, harmonicName, OBJ_TEXT, 0, TimeCurrent(), SymbolInfoDouble(symbol, SYMBOL_BID) + 30))
        {
            ObjectSetString(0, harmonicName, OBJPROP_TEXT, "Gartley Pattern");
            ObjectSetInteger(0, harmonicName, OBJPROP_COLOR, clrCyan);
            ObjectSetInteger(0, harmonicName, OBJPROP_FONTSIZE, 9);

