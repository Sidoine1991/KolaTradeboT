bool CalculateSLTP(const string symbol, int direction, double entryPrice, double &sl, double &tp)
{
    // Validation des paramètres d'entrée
    if(entryPrice <= 0)
    {
        if(InpDebug) Print("❌ Prix d'entrée invalide: ", entryPrice);
        return false;

