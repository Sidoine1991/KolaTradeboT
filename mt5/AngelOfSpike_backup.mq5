//+------------------------------------------------------------------+
//| Afficher la flèche de prédiction de spike                      |
//+------------------------------------------------------------------+
void DisplayPredictionArrow(const string symbol, const int direction, const double confidence)
{
    // Supprimer l'ancienne flèche de prédiction
    ObjectsDeleteAll(0, "Prediction_" + symbol);

    // Obtenir le prix actuel
    double currentPrice = SymbolInfoDouble(symbol, SYMBOL_BID);
    datetime currentTime = TimeCurrent();

    if(currentPrice <= 0) return;

    // Créer la flèche de prédiction
    string arrowName = "Prediction_" + symbol + "_" + IntegerToString(currentTime);

    // Position de la flèche
    double arrowPrice = currentPrice;
    int arrowCode = 0;
    color arrowColor = clrWhite;

    if(direction == POSITION_TYPE_BUY)
    {
        arrowPrice = currentPrice + 30 * SymbolInfoDouble(symbol, SYMBOL_POINT);
        arrowCode = 233; // Flèche vers le haut
        arrowColor = clrAqua; // Cyan pour prédiction

//+------------------------------------------------------------------+
//| Fermer la position après capture du spike                      |
//+------------------------------------------------------------------+
void ClosePositionAfterSpikeCapture()
{
    for(int i = PositionsTotal() - 1; i >= 0; i--)
    {
        if(PositionSelectByIndex(i))
        {
            if(PositionGetInteger(POSITION_MAGIC) == InpMagicNumber)
            {
                string symbol = PositionGetString(POSITION_SYMBOL);
                double profit = PositionGetDouble(POSITION_PROFIT);

                // Fermer si profit > 0 (spike capturé) ou si perte > seuil
                if(profit > 0 || profit < -InpMaxLossPerTradeUSD)
                {
                    if(PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
                    {
                        g_trade.Sell(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }
                    else
                    {
                        g_trade.Buy(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }

                    Print("✅ POSITION FERMEE APRES SPIKE: ", symbol, " - Profit: $", DoubleToString(profit, 2));
                }
            }
        }
    }
}

}
    else if(direction == POSITION_TYPE_SELL)
    {
        arrowPrice = currentPrice - 30 * SymbolInfoDouble(symbol, SYMBOL_POINT);
        arrowCode = 234; // Flèche vers le bas
        arrowColor = clrMagenta; // Magenta pour prédiction

//+------------------------------------------------------------------+
//| Fermer la position après capture du spike                      |
//+------------------------------------------------------------------+
void ClosePositionAfterSpikeCapture()
{
    for(int i = PositionsTotal() - 1; i >= 0; i--)
    {
        if(PositionSelectByIndex(i))
        {
            if(PositionGetInteger(POSITION_MAGIC) == InpMagicNumber)
            {
                string symbol = PositionGetString(POSITION_SYMBOL);
                double profit = PositionGetDouble(POSITION_PROFIT);

                // Fermer si profit > 0 (spike capturé) ou si perte > seuil
                if(profit > 0 || profit < -InpMaxLossPerTradeUSD)
                {
                    if(PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
                    {
                        g_trade.Sell(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }
                    else
                    {
                        g_trade.Buy(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }

                    Print("✅ POSITION FERMEE APRES SPIKE: ", symbol, " - Profit: $", DoubleToString(profit, 2));
                }
            }
        }
    }
}

}

    // Créer la flèche
    if(ObjectCreate(0, arrowName, OBJ_ARROW, 0, currentTime, arrowPrice))
    {
        ObjectSetInteger(0, arrowName, OBJPROP_ARROWCODE, arrowCode);
        ObjectSetInteger(0, arrowName, OBJPROP_COLOR, arrowColor);
        ObjectSetInteger(0, arrowName, OBJPROP_WIDTH, 4);
        ObjectSetInteger(0, arrowName, OBJPROP_BACK, false);
        ObjectSetInteger(0, arrowName, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
        ObjectSetInteger(0, arrowName, OBJPROP_SELECTABLE, false);
        ObjectSetInteger(0, arrowName, OBJPROP_HIDDEN, true);

        // Forcer la mise à jour du graphique
        ChartRedraw(0);

        if(InpDebug)
        {
            Print("🔮 FLÈCHE PRÉDICTION AFFICHÉE [", symbol, "]: ",
                  (direction == POSITION_TYPE_BUY ? "BUY" : "SELL"),
                  " - Confiance ", DoubleToString(confidence, 1), "%");

