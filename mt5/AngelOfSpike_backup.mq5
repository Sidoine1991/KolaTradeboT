//+------------------------------------------------------------------+
//| Fermer la position après capture du spike                      |
//+------------------------------------------------------------------+
void ClosePositionAfterSpikeCapture()
{
    for(int i = PositionsTotal() - 1; i >= 0; i--)
    {
        if(PositionSelectByIndex(i))
        {
            if(PositionGetInteger(POSITION_MAGIC) == InpMagicNumber)
            {
                string symbol = PositionGetString(POSITION_SYMBOL);
                double profit = PositionGetDouble(POSITION_PROFIT);

                // Fermer si profit > 0 (spike capturé) ou si perte > seuil
                if(profit > 0 || profit < -InpMaxLossPerTradeUSD)
                {
                    if(PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
                    {
                        g_trade.Sell(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }
                    else
                    {
                        g_trade.Buy(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }

                    Print("✅ POSITION FERMEE APRES SPIKE: ", symbol, " - Profit: $", DoubleToString(profit, 2));
                }
            }
        }
    }
}

}

    // 2. Définir les prix avec gestion dynamique du risque
    double sl = 0, tp = 0;
    double entryPrice = 0;
    double spread = 0.0;
    point = SymbolInfoDouble(symbol, SYMBOL_POINT);
    spread = SymbolInfoInteger(symbol, SYMBOL_SPREAD) * point;

    // Ajuster les niveaux de SL/TP en fonction de la volatilité
    double slDistance = atr * 1.5;  // 1.5 x ATR pour le stop loss
    double tpDistance = atr * 2.5;  // 2.5 x ATR pour le take profit

    // Pour un ordre au marché, le prix d'entrée est le prix actuel
    double currentAsk = SymbolInfoDouble(symbol, SYMBOL_ASK);
    double currentBid = SymbolInfoDouble(symbol, SYMBOL_BID);
    entryPrice = (direction == POSITION_TYPE_BUY) ? currentAsk : currentBid;

    // 3. Calculer SL et TP avec gestion dynamique
    if(direction == POSITION_TYPE_BUY)
    {
        entryPrice = SymbolInfoDouble(symbol, SYMBOL_ASK);
        sl = entryPrice - (atr * 1.5);  // 1.5 x ATR pour le stop loss
        tp = entryPrice + (atr * 2.5);  // 2.5 x ATR pour le take profit

        // Ajuster pour le spread
        sl = sl - spread;

        // Vérifier les niveaux de prix minimums
        double minStopLevel = SymbolInfoInteger(symbol, SYMBOL_TRADE_STOPS_LEVEL) * point;
        sl = MathMax(sl, entryPrice - (minStopLevel * 3));

        // Vérifier la perte maximale autorisée (3.55$ dans votre cas)
        double maxLoss = 3.55;
        double potentialLoss = (entryPrice - sl) * lot * SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_VALUE);
        if(potentialLoss > maxLoss)
        {
            sl = entryPrice - (maxLoss / (lot * SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_VALUE)));
            if(InpDebug) Print("⚠️ Ajustement du SL pour respecter la perte maximale de ", maxLoss, " $");

