                    }

                    Print("✅ POSITION FERMEE APRES SPIKE: ", symbol, " - Profit: $", DoubleToString(profit, 2));
                }
            }
        }
    }
}

}

    double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
    if(point <= 0)
    {
        if(InpDebug) Print("❌ Point invalide pour ", symbol, ": ", point);
        return false;

//+------------------------------------------------------------------+
