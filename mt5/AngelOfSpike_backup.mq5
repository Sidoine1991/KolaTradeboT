//+------------------------------------------------------------------+
//| Afficher BOS/COS (Break of Structure / Change of Structure)     |
//+------------------------------------------------------------------+
void DisplayBOSCOS(const string symbol, MqlRates &rates[], int bars)
{
    for(int i = 3; i < bars - 3; i++)
    {
        // Détecter BOS (Break of Structure)
        if(rates[i].high > rates[i-1].high && rates[i-1].high > rates[i-2].high)
        {
            string bosName = "ICT_BOS_" + IntegerToString(i);
            if(ObjectCreate(0, bosName, OBJ_ARROW_UP, 0, rates[i].time, rates[i].high))
            {
                ObjectSetInteger(0, bosName, OBJPROP_COLOR, clrLime);
                ObjectSetInteger(0, bosName, OBJPROP_WIDTH, 3);
                ObjectSetInteger(0, bosName, OBJPROP_ARROWCODE, 233);
                ObjectSetString(0, bosName, OBJPROP_TEXT, "BOS");
                ObjectSetInteger(0, bosName, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
                ObjectSetInteger(0, bosName, OBJPROP_SELECTABLE, false);
                ObjectSetInteger(0, bosName, OBJPROP_HIDDEN, true);

