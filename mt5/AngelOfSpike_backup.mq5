    ObjectsDeleteAll(0, "StepPattern_" + symbol + "_");
    ObjectsDeleteAll(0, "StepPattern_Label_" + symbol);
    ChartRedraw(0);

    if(InpDebug) Print("🔄 Flèches prédictives masquées pour ", symbol);

