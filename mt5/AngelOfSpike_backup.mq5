//+------------------------------------------------------------------+
//| Tente d'ouvrir un trade après toutes les vérifications           |
//+------------------------------------------------------------------+
void TryToOpenTrade(const string symbol, int direction, double probability)
{
    // LOG DÉTAILLÉ - TOUJOURS AFFICHÉ
    Print("🚨 ===== TENTATIVE D'OUVERTURE DE TRADE =====");
    Print("📊 Symbole: ", symbol);
    Print("📈 Direction: ", (direction == POSITION_TYPE_BUY ? "BUY" : "SELL"));
    Print("📊 Probabilité: ", DoubleToString(probability, 1), "%");
    Print("⏰ Heure: ", TimeToString(TimeCurrent()));
    Print("🔧 Trading général activé: ", InpEnableTrading ? "OUI" : "NON");
    Print("==========================================");

    Print("✅ SIGNAL FORT [", symbol, "]: Tentative d'ouverture... Prob: ", DoubleToString(probability,1), "%");

    // VÉRIFIER SI LE TRADING EST AUTORISÉ
    if(!InpEnableTrading)
    {
        Print("❌ TRADE BLOQUÉ: Trading général désactivé");
        return;

//+------------------------------------------------------------------+
//| Fermer la position après capture du spike                      |
//+------------------------------------------------------------------+
void ClosePositionAfterSpikeCapture()
{
    for(int i = PositionsTotal() - 1; i >= 0; i--)
    {
        if(PositionSelectByIndex(i))
        {
            if(PositionGetInteger(POSITION_MAGIC) == InpMagicNumber)
            {
                string symbol = PositionGetString(POSITION_SYMBOL);
                double profit = PositionGetDouble(POSITION_PROFIT);

                // Fermer si profit > 0 (spike capturé) ou si perte > seuil
                if(profit > 0 || profit < -InpMaxLossPerTradeUSD)
                {
                    if(PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
                    {
                        g_trade.Sell(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }
                    else
                    {
                        g_trade.Buy(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }

                    Print("✅ POSITION FERMEE APRES SPIKE: ", symbol, " - Profit: $", DoubleToString(profit, 2));
                }
            }
        }
    }
}

}

    // VÉRIFICATION CONTRE-TENDANCE (BUY CRASH ou SELL BOOM INTERDITS)
    bool isBoom = (StringFind(symbol, "Boom") >= 0);
    bool isCrash = (StringFind(symbol, "Crash") >= 0);

    if((isCrash && direction == POSITION_TYPE_BUY) || (isBoom && direction == POSITION_TYPE_SELL))
    {
        string reason = isCrash ?
            "❌ TRADE BLOQUÉ: Tentative d'achat (BUY) sur un indice Crash interdit" :
            "❌ TRADE BLOQUÉ: Tentative de vente (SELL) sur un indice Boom interdit";

        Print(reason);

        // Envoyer une alerte
        if(InpSendNotifications)
        {
            string alertMsg = StringFormat("%s - %s - %s",
                InpNotifyTag,
                symbol,
                reason);
            SendNotification(alertMsg);

