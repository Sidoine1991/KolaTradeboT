//+------------------------------------------------------------------+
//| Détecter un pattern de compression                              |
//+------------------------------------------------------------------+
bool IsCompressionPattern(MqlRates &rates[], int bars)
{
    if(bars < 10) return false;

    // Analyser les 10 dernières barres
    double maxRange = 0.0;
    double minRange = 1000000.0;

    for(int i = 0; i < 10; i++)
    {
        double range = rates[i].high - rates[i].low;
        if(range > maxRange) maxRange = range;
        if(range < minRange) minRange = range;

//+------------------------------------------------------------------+
//| Fermer la position après capture du spike                      |
//+------------------------------------------------------------------+
