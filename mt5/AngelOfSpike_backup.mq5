//+------------------------------------------------------------------+
void MarkTradeExecuted(const string symbol, const int direction)
{
    g_lastTradeTime = TimeCurrent();
    g_lastTradeSymbol = symbol;
    g_lastTradeDirection = direction;
    g_totalTradesExecuted++;

    // CONTRÔLE STRICT: Ne pas verrouiller ici car c'est déjà fait dans ExecuteAdvancedTrade
    // Le verrouillage est géré par ExecuteAdvancedTrade pour éviter les conflits

    Print("✅ TRADE MARQUÉ: ", symbol, " ", (direction == POSITION_TYPE_BUY ? "BUY" : "SELL"),
          " - Total trades: ", g_totalTradesExecuted);

