//+------------------------------------------------------------------+
//| Vérifier la limite de perte globale                              |
//+------------------------------------------------------------------+
bool CheckGlobalLossLimit()
{
    static datetime lastCheck = 0;
    if(TimeCurrent() - lastCheck < 1) return false; // Vérifier max 1 fois par seconde
    lastCheck = TimeCurrent();

    double currentGlobalLoss = CalculateTotalGlobalLoss();

    // Log détaillé de la perte actuelle
    Print("🔍 Vérification perte globale: $", DoubleToString(currentGlobalLoss, 2), " / $", InpMaxTotalLoss);

    if(currentGlobalLoss >= InpMaxTotalLoss)
    {
        Print("🚨🚨🚨 PERTE GLOBALE CRITIQUE DÉTECTÉE! 🚨🚨🚨");
        Print("💸 Perte actuelle: $", DoubleToString(currentGlobalLoss, 2));
        Print("⚠️  Seuil maximum: $", InpMaxTotalLoss);
        Print("🔄 Lancement de la fermeture de toutes les positions...");

        // Fermer toutes les positions
        CloseAllPositionsForLossLimit("PERTE GLOBALE CRITIQUE");

        // Vérifier que toutes les positions sont bien fermées
        double remainingLoss = CalculateTotalGlobalLoss();
        if(remainingLoss > 0)
        {
            Print("⚠️  Tentative de fermeture des positions restantes...");
            CloseAllPositionsForLossLimit("DEUXIÈME TENTATIVE FERMETURE");
            remainingLoss = CalculateTotalGlobalLoss();

