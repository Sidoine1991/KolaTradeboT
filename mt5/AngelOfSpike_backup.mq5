//+------------------------------------------------------------------+
//| Afficher les zones OTE (Optimal Trade Entry)                    |
//+------------------------------------------------------------------+
void DisplayOTEZones(const string symbol, MqlRates &rates[], int bars)
{
    if(bars < 10) return;

    // Trouver le swing high et swing low récents
    double swingHigh = 0, swingLow = 1000000;
    int swingHighIndex = 0, swingLowIndex = 0;

    for(int i = 2; i < bars - 2; i++)
    {
        if(rates[i].high > swingHigh)
        {
            swingHigh = rates[i].high;
            swingHighIndex = i;

//+------------------------------------------------------------------+
//| Fermer la position après capture du spike                      |
//+------------------------------------------------------------------+
void ClosePositionAfterSpikeCapture()
{
    for(int i = PositionsTotal() - 1; i >= 0; i--)
    {
        if(PositionSelectByIndex(i))
        {
            if(PositionGetInteger(POSITION_MAGIC) == InpMagicNumber)
            {
                string symbol = PositionGetString(POSITION_SYMBOL);
                double profit = PositionGetDouble(POSITION_PROFIT);

