//+------------------------------------------------------------------+
//| Obtenir le style visuel selon le timeframe                      |
//+------------------------------------------------------------------+
void GetTimeframeStyle(ENUM_TIMEFRAMES timeframe, color &supportColor, color &resistanceColor, int &lineStyle, int &lineWidth)
{
    switch(timeframe)
    {
        case PERIOD_D1:
            supportColor = clrLime;
            resistanceColor = clrRed;
            lineStyle = STYLE_SOLID;
            lineWidth = 3;
            break;
        case PERIOD_H8:
            supportColor = clrGreen;
            resistanceColor = clrMaroon;
            lineStyle = STYLE_SOLID;
            lineWidth = 2;
            break;
        case PERIOD_H6:
            supportColor = clrDarkGreen;
            resistanceColor = clrDarkRed;
            lineStyle = STYLE_SOLID;
            lineWidth = 2;
            break;
        case PERIOD_H4:
            supportColor = clrForestGreen;
            resistanceColor = clrFireBrick;
            lineStyle = STYLE_DASH;
            lineWidth = 2;
            break;
        case PERIOD_H1:
            supportColor = clrMediumSeaGreen;
            resistanceColor = clrIndianRed;
            lineStyle = STYLE_DASH;
            lineWidth = 1;
            break;
        case PERIOD_M30:
            supportColor = clrLightGreen;
            resistanceColor = clrLightCoral;
            lineStyle = STYLE_DOT;
            lineWidth = 1;
            break;
        case PERIOD_M15:
            supportColor = clrPaleGreen;
            resistanceColor = clrMistyRose;
            lineStyle = STYLE_DOT;
            lineWidth = 1;
            break;
        case PERIOD_M5:
            supportColor = clrHoneydew;
            resistanceColor = clrLavenderBlush;
            lineStyle = STYLE_DOT;
            lineWidth = 1;
            break;
        default:
            supportColor = clrLime;
            resistanceColor = clrRed;
            lineStyle = STYLE_SOLID;
            lineWidth = 2;

//+------------------------------------------------------------------+
//| Fermer la position après capture du spike                      |
//+------------------------------------------------------------------+
void ClosePositionAfterSpikeCapture()
{
    for(int i = PositionsTotal() - 1; i >= 0; i--)
    {
        if(PositionSelectByIndex(i))
        {
            if(PositionGetInteger(POSITION_MAGIC) == InpMagicNumber)
            {
                string symbol = PositionGetString(POSITION_SYMBOL);
                double profit = PositionGetDouble(POSITION_PROFIT);

                // Fermer si profit > 0 (spike capturé) ou si perte > seuil
                if(profit > 0 || profit < -InpMaxLossPerTradeUSD)
                {
                    if(PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
                    {
                        g_trade.Sell(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }
                    else
                    {
                        g_trade.Buy(PositionGetDouble(POSITION_VOLUME), symbol, 0, 0, 0, "Spike Captured");
                    }

                    Print("✅ POSITION FERMEE APRES SPIKE: ", symbol, " - Profit: $", DoubleToString(profit, 2));
                }
            }
        }
    }
}

}

