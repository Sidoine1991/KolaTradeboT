//+------------------------------------------------------------------+
//| Vérifier si un spike est détecté                                 |
//+------------------------------------------------------------------+
bool IsSpikeDetected(const string symbol, const int direction, const double minConfidence=60.0)
{
    if(!InpEnableSpikePrediction) return false;

    MqlRates rates[];
    if(CopyRates(symbol, PERIOD_M1, 0, 3, rates) < 3) return false;

    // Calculer la volatilité sur les dernières bougies
    double volatility = 0;
