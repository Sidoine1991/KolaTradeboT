{

   string s = sym;

   StringToUpper(s);

   return (StringFind(s, "BOOM") >= 0 || StringFind(s, "CRASH") >= 0 ||

           StringFind(s, "PAINX") >= 0 || StringFind(s, "GAINX") >= 0);

}



