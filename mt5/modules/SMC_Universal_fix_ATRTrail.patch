+input double ScannerATRTrailConservative= 2.5;  // Trail large dès profit >= X * ATR
+input double ScannerATRTrailAggrDist    = 0.5;  // Distance du trail serré (X * ATR)
+input double ScannerATRTrailConsDist    = 1.0;  // Distance du trail large (X * ATR)
 
