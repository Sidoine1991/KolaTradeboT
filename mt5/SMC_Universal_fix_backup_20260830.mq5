// Dessin basique des derniers swing high / low sur le graphique courant
void DrawSwingHighLow()
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(_Symbol, PERIOD_CURRENT, 0, 20, rates) < 5) return;

   double lastHigh = rates[0].high;
   double lastLow  = rates[0].low;
   datetime lastTime = rates[0].time;

   // Supprimer les anciens objets pour éviter l'encombrement
   ObjectDelete(0, "SMC_Last_SH");
   ObjectDelete(0, "SMC_Last_SL");

   // Dernier Swing High (simple: high de la dernière bougie)
   if(ObjectCreate(0, "SMC_Last_SH", OBJ_ARROW, 0, lastTime, lastHigh))
   {
      ObjectSetInteger(0, "SMC_Last_SH", OBJPROP_COLOR, clrRed);
      ObjectSetInteger(0, "SMC_Last_SH", OBJPROP_ARROWCODE, 233);
      ObjectSetInteger(0, "SMC_Last_SH", OBJPROP_WIDTH, 2);
   }

   // Dernier Swing Low (simple: low de la dernière bougie)
   if(ObjectCreate(0, "SMC_Last_SL", OBJ_ARROW, 0, lastTime, lastLow))
   {
      ObjectSetInteger(0, "SMC_Last_SL", OBJPROP_COLOR, clrDodgerBlue);
      ObjectSetInteger(0, "SMC_Last_SL", OBJPROP_ARROWCODE, 234);
      ObjectSetInteger(0, "SMC_Last_SL", OBJPROP_WIDTH, 2);
   }
}

// Lignes horizontales "Bookmark" + bande verticale droite sur les derniers Swing High/Low confirmés (vue ICT)
void DrawBookmarkLevels()
{
   // Nom commun pour la bande verticale à droite + panneau d'info
   string bandName  = "SMC_Bookmark_Band_"  + _Symbol;
   string panelName = "SMC_Bookmark_Info_" + _Symbol;

   // Si l'affichage est désactivé, tout nettoyer et sortir
   if(!ShowBookmarkLevels)
   {
      ObjectDelete(0, bandName);
      ObjectDelete(0, "SMC_Bookmark_SH_" + _Symbol);
      ObjectDelete(0, "SMC_Bookmark_SL_" + _Symbol);
      ObjectDelete(0, panelName);
      return;
   }
   
   // Utilise les variables globales g_lastSwingHigh / g_lastSwingLow mises à jour par la détection SMC
   double lastSH = g_lastSwingHigh;
   double lastSL = g_lastSwingLow;
   if(lastSH <= 0 && lastSL <= 0)
   {
      // Aucun bookmark valide -> supprimer la bande et sortir
      ObjectDelete(0, bandName);
      ObjectDelete(0, "SMC_Bookmark_SH_" + _Symbol);
      ObjectDelete(0, "SMC_Bookmark_SL_" + _Symbol);
      ObjectDelete(0, panelName);
      return;
   }
   
   datetime now = TimeCurrent();
   datetime future = now + PeriodSeconds(PERIOD_CURRENT) * 500; // projeter la ligne assez loin dans le futur
   
   // Supprimer d'anciens bookmarks horizontaux pour ce symbole
   string shName = "SMC_Bookmark_SH_" + _Symbol;
   string slName = "SMC_Bookmark_SL_" + _Symbol;
   ObjectDelete(0, shName);
   ObjectDelete(0, slName);
   
   // Swing High bookmark (rouge pointillé)
   bool hasSH = (lastSH > 0.0);
   if(hasSH)
   {
      if(ObjectCreate(0, shName, OBJ_TREND, 0, now, lastSH, future, lastSH))
      {
         ObjectSetInteger(0, shName, OBJPROP_COLOR, clrRed);
         ObjectSetInteger(0, shName, OBJPROP_WIDTH, 1);
         ObjectSetInteger(0, shName, OBJPROP_STYLE, STYLE_DASHDOT);
         ObjectSetString(0, shName, OBJPROP_TEXT, "Bookmark SH");
      }
   }
   
   // Swing Low bookmark (vert pointillé)
   bool hasSL = (lastSL > 0.0);
   if(hasSL)
   {
      if(ObjectCreate(0, slName, OBJ_TREND, 0, now, lastSL, future, lastSL))
      {
         ObjectSetInteger(0, slName, OBJPROP_COLOR, clrLime);
         ObjectSetInteger(0, slName, OBJPROP_WIDTH, 1);
         ObjectSetInteger(0, slName, OBJPROP_STYLE, STYLE_DASHDOT);
         ObjectSetString(0, slName, OBJPROP_TEXT, "Bookmark SL");
      }
   }

   // Dessin de la bande verticale sur le bord droit du graphique (haut en bas)
   // Couleur selon le type de dernier bookmark disponible
   color bandColor = clrYellow;
   if(hasSH && !hasSL)
      bandColor = clrRed;
   else if(hasSL && !hasSH)
      bandColor = clrLime;

   // Récupérer les dimensions du graphique en pixels
   int chartWidthPixels  = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS, 0);
   int chartHeightPixels = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS, 0);
   if(chartWidthPixels <= 0 || chartHeightPixels <= 0)
      return;

   int bandWidth = 10; // largeur en pixels de la bande

   // Créer ou mettre à jour un OBJ_RECTANGLE_LABEL ancré en haut à droite
   if(ObjectFind(0, bandName) == -1)
   {
      if(!ObjectCreate(0, bandName, OBJ_RECTANGLE_LABEL, 0, 0, 0))
         return;
   }

   ObjectSetInteger(0, bandName, OBJPROP_CORNER, CORNER_RIGHT_UPPER);
   ObjectSetInteger(0, bandName, OBJPROP_XDISTANCE, 0);          // collé au bord droit
   ObjectSetInteger(0, bandName, OBJPROP_YDISTANCE, 0);          // depuis le haut
   ObjectSetInteger(0, bandName, OBJPROP_XSIZE, bandWidth);      // largeur bande
   ObjectSetInteger(0, bandName, OBJPROP_YSIZE, chartHeightPixels); // hauteur totale
   ObjectSetInteger(0, bandName, OBJPROP_COLOR, bandColor);
   ObjectSetInteger(0, bandName, OBJPROP_BACK, true);            // en arrière-plan
   ObjectSetInteger(0, bandName, OBJPROP_STYLE, STYLE_SOLID);
   ObjectSetInteger(0, bandName, OBJPROP_WIDTH, 1);

   // Panneau d'information "Bookmark" fixé sur le bord droit du graphique
   if(ObjectFind(0, panelName) == -1)
   {
      if(!ObjectCreate(0, panelName, OBJ_LABEL, 0, 0, 0))
         return;
   }

   string txt = "BOOKMARK";
   if(hasSH)
      txt += "\nSH: " + DoubleToString(lastSH, _Digits);
   if(hasSL)
      txt += "\nSL: " + DoubleToString(lastSL, _Digits);

   ObjectSetInteger(0, panelName, OBJPROP_CORNER, CORNER_RIGHT_UPPER);
   ObjectSetInteger(0, panelName, OBJPROP_XDISTANCE, bandWidth + 4); // juste à gauche de la bande verticale
   ObjectSetInteger(0, panelName, OBJPROP_YDISTANCE, 10);
   ObjectSetString(0,  panelName, OBJPROP_TEXT, txt);
   ObjectSetInteger(0, panelName, OBJPROP_FONTSIZE, 8);
   ObjectSetInteger(0, panelName, OBJPROP_COLOR, clrWhite);
   ObjectSetString(0,  panelName, OBJPROP_FONT, "Arial");
}

//| SMC - Structures et énumérations (intégré)                       |
struct FVGData {
   double top;
   double bottom;
   int direction;
   datetime time;
   bool isInversion;
   int barIndex;
   bool isDisplacement; // Marqueur pour displacement FVG
};
struct OrderBlockData {
   double high;
   double low;
   int direction;
   datetime time;
   int barIndex;
   string type;
};
struct SMC_Signal {
   string action;
   double confidence;
   string concept;
   string reasoning;
   double entryPrice;
   double stopLoss;
   double takeProfit;
};
// SMC_GetSymbolCategory — voir modules/SMC_SymbolCategory.mqh (include ligne 46)

// Un symbole se comporte-t-il comme un indice "spike" (Boom/Crash Deriv, Painx/Gainx Weltrade)?
bool SMC_IsSpikeStyleSymbol(const string symbol)
{
   return (SMC_GetSymbolCategory(symbol) == SYM_BOOM_CRASH);
}

// Symbole Weltrade synthétique (PainX/GainX) — subset de SYM_BOOM_CRASH
bool SMC_IsWeltradeSynthSymbol(const string symbol)
{
   string s = symbol;
   StringToUpper(s);
   return (StringFind(s, "PAINX") >= 0 || StringFind(s, "GAINX") >= 0);
}

// Weltrade: PAINX/GAINX = Boom/Crash, FX Vol/SFx Vol/SFV Vol = Volatility indexes
// (implémentations dans SMC_Stubs.mqh)

// Helpers: Boom-like (Boom + Gainx) et Crash-like (Crash + Painx)
bool IsBoomLikeSymbol(const string symbol)
{
   string s = symbol;
   StringToUpper(s);
   return (StringFind(s, "BOOM") >= 0 || StringFind(s, "GAINX") >= 0);
}
bool IsCrashLikeSymbol(const string symbol)
{
   string s = symbol;
   StringToUpper(s);
   return (StringFind(s, "CRASH") >= 0 || StringFind(s, "PAINX") >= 0);
}

// FlipX / SwitchX / PlusX / FiboX / QuadX — bidirectionnels (suivent GOM)
bool SMC_IsFlipStyleSymbol(const string symbol)
{
   string s = symbol;
   StringToUpper(s);
   return (StringFind(s, "FLIPX") >= 0 || StringFind(s, "SWITCHX") >= 0 ||
           StringFind(s, "PLUSX") >= 0 || StringFind(s, "FIBOX")   >= 0 ||
           StringFind(s, "QUADX") >= 0 || StringFind(s, "FLIP X")  >= 0);
}

// Règle directionnelle spécifique Boom/Crash:
// - Boom/Gainx: BUY only | Crash/Painx: SELL only | FlipX: les deux OK
bool IsDirectionAllowedForBoomCrash(const string symbol, const string action)
{
   string a = action;
   StringToUpper(a);
   if(SMC_IsFlipStyleSymbol(symbol)) return true;
   if(IsBoomLikeSymbol(symbol) && a == "SELL") return false;
   if(IsCrashLikeSymbol(symbol) && a == "BUY") return false;
   return true;
}

bool SMC_SpikeEntryQualityOK(const string symbol, const string direction)
{
   string a = direction;
   StringToUpper(a);
   int dir = (a == "BUY") ? 1 : -1;

   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(symbol, PERIOD_M1, 0, 8, r) < 5)
   {
      Print("🚫 SpikeQuality — rates M1 insuffisants ", symbol);
      return false; // v1.24: ne plus passer en aveugle
   }

   double atr = 0.0;
   int atrH = iATR(symbol, PERIOD_M1, 14);
   if(atrH != INVALID_HANDLE)
   {
      double ab[];
      ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrH, 0, 0, 1, ab) >= 1)
         atr = ab[0];
   }
   if(atr <= 0.0)
      atr = MathAbs(r[1].high - r[1].low);
   if(atr <= 0.0)
      return false;

   // Contre-impulsion M1 (bougie courante trop forte contre le trade)
   double body0 = r[0].close - r[0].open;
   if(dir < 0 && body0 > atr * 0.85)
   {
      Print("🚫 Entrée SELL bloquée — impulsion haussière M1 en cours sur ", symbol);
      return false;
   }
   if(dir > 0 && body0 < -atr * 0.85)
   {
      Print("🚫 Entrée BUY bloquée — impulsion baissière M1 en cours sur ", symbol);
      return false;
   }

   // Pas d'entrée aux extrêmes sans pullback (2-5 barres)
   double hi = r[0].high, lo = r[0].low;
   for(int i = 1; i < 5; i++)
   {
      if(r[i].high > hi) hi = r[i].high;
      if(r[i].low < lo) lo = r[i].low;
   }
   if(dir < 0 && r[0].close >= hi - atr * 0.20)
   {
      Print("🚫 Entrée SELL bloquée — prix au sommet M1 (pas de pullback) ", symbol);
      return false;
   }
   if(dir > 0 && r[0].close <= lo + atr * 0.20)
   {
      Print("🚫 Entrée BUY bloquée — prix au creux M1 (pas de pullback) ", symbol);
      return false;
   }

   // v1.24: au moins 1 bougie M1 récente dans le sens (confirmation micro)
   int sameDir = 0;
   for(int i = 1; i <= 3; i++)
   {
      double b = r[i].close - r[i].open;
      if(dir > 0 && b > 0) sameDir++;
      if(dir < 0 && b < 0) sameDir++;
   }
   if(sameDir < 1)
   {
      Print("🚫 SpikeQuality — aucune bougie M1 récente dans le sens ", a, " | ", symbol);
      return false;
   }
   return true;
}

//+------------------------------------------------------------------+
//| v1.24: Confirmation STRICTE avant entrée Boom/Crash/Painx/Gainx   |
//| Objectif: réduire les petites pertes en série (filtres cumulés).   |
//+------------------------------------------------------------------+
bool SMC_SpikeConfirmStrict(const string symbol, const int dirSign, string &whyOut)
{
   whyOut = "";
   if(dirSign == 0) { whyOut = "dir=0"; return false; }

   // Pause après série de pertes
   if(g_eaLossPauseUntil > 0 && TimeCurrent() < g_eaLossPauseUntil)
   {
      whyOut = StringFormat("pause série pertes jusqu'à %s",
                            TimeToString(g_eaLossPauseUntil, TIME_MINUTES));
      return false;
   }

   // GOM GOOD+ obligatoire (si option)
   if(SpikeRequireGoodGOM || MinGOMVerdictNumAbs >= 2)
   {
      if(!g_smcGomConnected || g_smcGomVerdictNum == 0)
      {
         whyOut = "GOM WAIT/déco";
         return false;
      }
      int need = MathMax(2, MinGOMVerdictNumAbs);
      if(MathAbs(g_smcGomVerdictNum) < need)
      {
         whyOut = StringFormat("GOM trop faible vn=%d (need |vn|>=%d)", g_smcGomVerdictNum, need);
         return false;
      }
      if(dirSign > 0 && g_smcGomVerdictNum < need) { whyOut = "GOM pas BUY"; return false; }
      if(dirSign < 0 && g_smcGomVerdictNum > -need) { whyOut = "GOM pas SELL"; return false; }
   }

   // M1 + M5 alignés
   if(SpikeRequireM1M5Align)
   {
      bool m1ok = (dirSign > 0) ? SMC_ScalpTfDirIsBull(g_smcTfM1Dir) : SMC_ScalpTfDirIsBear(g_smcTfM1Dir);
      bool m5ok = (dirSign > 0) ? SMC_ScalpTfDirIsBull(g_smcTfM5Dir) : SMC_ScalpTfDirIsBear(g_smcTfM5Dir);
      // Si TF neutre, ne pas compter comme aligné
      if(!m1ok || !m5ok)
      {
         whyOut = StringFormat("M1/M5 non alignés (M1=%s M5=%s)", g_smcTfM1Dir, g_smcTfM5Dir);
         return false;
      }
   }

   // v1.26: PRE_SPIKE autorisé seulement si confluence structure (S/R, Impulse, DOW, DISP)
   // ou GOM PERFECT / CHAIN_ACTIVE. Évite les entrées mid-move sans niveau.
   if(g_spikeChainState == SPIKE_STATE_PRE_SPIKE)
   {
      bool hasStruct = false;
      string structSrc = "";
      double atrPre = 0;
      if(atrHandle != INVALID_HANDLE)
      {
         double ab[]; ArraySetAsSeries(ab, true);
         if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atrPre = ab[0];
      }
      if(atrPre <= 0) atrPre = _Point * 50;
      hasStruct = SMC_GOMEnterHasStructure(dirSign, atrPre, structSrc);
      // Aussi SR20 bounce armé / Impulse touch
      if(!hasStruct && dirSign > 0 && (g_sr20BounceArmedBuy || g_impulseSupTouched))
      { hasStruct = true; structSrc = "SR20/IMPULSE_SUP"; }
      if(!hasStruct && dirSign < 0 && (g_sr20BounceArmedSell || g_impulseResTouched))
      { hasStruct = true; structSrc = "SR20/IMPULSE_RES"; }
      if(!SpikeMarketAllowPreChain && MathAbs(g_smcGomVerdictNum) < 3 && !hasStruct)
      {
         whyOut = "PRE_SPIKE seul — attendre CHAÎNE ACTIVE, PERFECT ou confluence S/R|DOW";
         return false;
      }
      if(SpikeMarketAllowPreChain && !hasStruct && MathAbs(g_smcGomVerdictNum) < 3)
      {
         whyOut = "PRE_SPIKE sans confluence structure — attendre S/R|DOW|Impulse|DISP";
         return false;
      }
   }

   // Qualité micro-structure M1
   string dirStr = (dirSign > 0) ? "BUY" : "SELL";
   if(!SMC_SpikeEntryQualityOK(symbol, dirStr))
   {
      whyOut = "SpikeEntryQualityOK fail";
      return false;
   }

   // Score setup si dispo
   double sc = ComputeSetupScore(dirStr);
   if(sc > 0.0 && sc < SpikeMinSetupScore)
   {
      whyOut = StringFormat("setup score %.2f < %.2f", sc, SpikeMinSetupScore);
      return false;
   }

   // Réentrée après perte: conditions strictes
   if(!AllowReentryAfterRecentLoss(symbol, dirStr, true))
   {
      whyOut = "réentrée après perte refusée";
      return false;
   }

   whyOut = "OK";
   return true;
}

void SMC_OnSpikeTradeClosed(const double profit)
{
   if(profit < 0)
   {
      g_eaLossStreak++;
      if(g_eaLossStreak >= MathMax(2, SpikeMaxLossStreak))
      {
         int pauseMin = MathMax(5, SpikeLossStreakPauseMin);
         g_eaLossPauseUntil = TimeCurrent() + pauseMin * 60;
         Print("⏸️ PAUSE SPIKE ", pauseMin, " min — série de ", g_eaLossStreak,
               " pertes | jusqu'à ", TimeToString(g_eaLossPauseUntil, TIME_MINUTES));
         g_eaLossStreak = 0;
      }
   }
   else if(profit > 0)
   {
      g_eaLossStreak = 0;
      g_eaLossPauseUntil = 0;
   }
}


bool SMC_IsCorrectionZoneForDirection(const string symbol, const int dirSign)
{
   // 1) Vérifier EMA21/EMA50 sur M5: si prix entre les deux = zone de retracement
   double emaBuf[];
   ArraySetAsSeries(emaBuf, true);
   double ema21 = 0, ema50 = 0;
   int ema21H = iMA(symbol, PERIOD_M5, 21, 0, MODE_EMA, PRICE_CLOSE);
   int ema50Handle = iMA(symbol, PERIOD_M5, 50, 0, MODE_EMA, PRICE_CLOSE);
   if(ema21H != INVALID_HANDLE && ema50Handle != INVALID_HANDLE)
   {
      if(CopyBuffer(ema21H, 0, 0, 1, emaBuf) >= 1) ema21 = emaBuf[0];
      if(CopyBuffer(ema50Handle, 0, 0, 1, emaBuf) >= 1) ema50 = emaBuf[0];
   }

   double bid = SymbolInfoDouble(symbol, SYMBOL_BID);
   if(bid <= 0) return false;

   bool betweenEMAs = false;
   if(ema21 > 0 && ema50 > 0)
   {
      double emaMin = MathMin(ema21, ema50);
      double emaMax = MathMax(ema21, ema50);
      if(bid > emaMin && bid < emaMax)
         betweenEMAs = true;
   }

   // 2) Vérifier compression ATR sur M5: ATR récent < 70% de la moyenne = consolidation
   bool atrCompressed = false;
   int atrH = iATR(symbol, PERIOD_M5, 14);
   if(atrH != INVALID_HANDLE)
   {
      double atrBuf[];
      ArraySetAsSeries(atrBuf, true);
      if(CopyBuffer(atrH, 0, 0, 20, atrBuf) >= 10)
      {
         double recentATR = atrBuf[0];
         double avgATR = 0;
         for(int i = 1; i < 10; i++) avgATR += atrBuf[i];
         avgATR /= 9.0;
         if(avgATR > 0 && recentATR < avgATR * 0.70)
            atrCompressed = true;
      }
   }

   // 3) Vérifier range M5 étroit: high-low moyen des 10 dernières barres < 0.5 ATR
   bool narrowRange = false;
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(symbol, PERIOD_M5, 0, 12, rates) >= 10)
   {
      double avgRange = 0;
      for(int i = 1; i < 10; i++)
         avgRange += MathAbs(rates[i].high - rates[i].low);
      avgRange /= 9.0;
      double atrVal = 0;
      if(atrH != INVALID_HANDLE)
      {
         double ab[];
         ArraySetAsSeries(ab, true);
         if(CopyBuffer(atrH, 0, 0, 1, ab) >= 1) atrVal = ab[0];
      }
      if(atrVal > 0 && avgRange < atrVal * 0.5)
         narrowRange = true;
   }

   // Correction = prix entre EMA21/EMA50 OU ATR compressé OU range étroit
   // Si 2 sur 3 conditions → corrobore la correction
   int correctionSignals = 0;
   if(betweenEMAs) correctionSignals++;
   if(atrCompressed) correctionSignals++;
   if(narrowRange) correctionSignals++;

   return (correctionSignals >= 2);
}

// Contrôle de duplication de position:
// - Pas de duplication sur Boom/Crash (1 position max par symbole)
// - Sur autres marchés: duplication seulement si
//   * au moins 1 position existe déjà sur le symbole
//   * la première position est en gain >= 2$
//   * l'IA confirme la même direction avec >= 80% de confiance
bool CanOpenAdditionalPositionForSymbol(const string symbol, const string action)
{
   int existing = CountPositionsForSymbol(symbol);
   if(existing <= 0)
      return true; // première position toujours autorisée
   
   // Jamais de duplication sur Boom/Crash
   if(SMC_GetSymbolCategory(symbol) == SYM_BOOM_CRASH)
      return false;
   
   // Vérifier les conditions IA fortes (80% min) et même direction
   string aiAction = g_lastAIAction;
   StringToUpper(aiAction);
   string act = action;
   StringToUpper(act);
   
   if(g_lastAIConfidence < 0.85)
      return false;
   if((act == "BUY"  && aiAction != "BUY") ||
      (act == "SELL" && aiAction != "SELL"))
      return false;
   
   // Vérifier le gain de la position initiale (la plus ancienne) sur ce symbole
   datetime earliestTime = 0;
   double   earliestProfit = 0.0;
   
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      if(posInfo.Symbol() != symbol) continue;
      
      datetime openTime = (datetime)posInfo.Time();
      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      
      if(earliestTime == 0 || openTime < earliestTime)
      {
         earliestTime = openTime;
         earliestProfit = profit;
      }
   }
   
   if(earliestTime == 0)
      return true; // sécurité: si on ne trouve pas, ne pas bloquer complètement
   
   return (earliestProfit >= 2.0);
}

// Compte tous les ordres LIMIT (BUY_LIMIT / SELL_LIMIT) ouverts pour ce symbole (notre EA)
int CountOpenLimitOrdersForSymbol(const string symbol)
{
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) != symbol) continue;
      if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      
      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(t == ORDER_TYPE_BUY_LIMIT || t == ORDER_TYPE_SELL_LIMIT)
         count++;
   }
   return count;
}

// Compte uniquement les ordres LIMIT issus du canal SMC (commentaire "SMC_CH ...")
int CountChannelLimitOrdersForSymbol(const string symbol)
{
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) != symbol) continue;
      if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      
      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(t != ORDER_TYPE_BUY_LIMIT && t != ORDER_TYPE_SELL_LIMIT) continue;
      
      string cmt = OrderGetString(ORDER_COMMENT);
      if(StringFind(cmt, "SMC_CH") >= 0)
         count++;
   }
   return count;
}

// Forward declarations (defined in SMC_GOM_Pipeline.mqh, included later)
int  SMCGP_GetCachedVerdictNum(const string symbol);
void SMCGP_EnforceLimitDiscipline(const long magic, const int maxLimits = 2);
bool LimitPlaceDisciplineOK(const string symbol, const int dirSign, string &reasonOut);
bool LimitCancelAllowed(const ulong ticket, const bool forceCounterTrend = false, const string reason = "");
bool LimitSafeOrderDelete(const ulong ticket, const bool forceCounterTrend = false, const string reason = "");
void LimitRegisterCancel(const string symbol);

// ── GATEKEEPER GOM: WAIT interdit + direction GOOD/PERFECT obligatoire ──
// dirSign: +1 BUY, -1 SELL. Retourne false si bloqué.
// BLOQUE TOUT: WAIT (vn=0), SIMPLE (|vn|=1), CONTRE-VERDICT


//+------------------------------------------------------------------+
//| v1.18c VERROU ABSOLU — jamais contre GOM / jamais WAIT en market  |
//| Boom/GainX: BUY seulement si GOM BUY (vn>0). SELL GOM → 0 BUY.   |
//| Crash/PainX: SELL seulement si GOM SELL (vn<0). BUY GOM → 0 SELL.|
//| S'applique même si un chemin oublie CanPlaceOrderByGOM.           |
//+------------------------------------------------------------------+
bool SMC_AbsoluteNoTradeAgainstGOM(const string symbol, const int dirSign, string &whyOut)
{
   whyOut = "";
   if(dirSign == 0)
   {
      whyOut = "dir=0";
      return false;
   }

   // Sans connexion GOM: refuser market (pas de trading à l'aveugle)
   if(!g_smcGomConnected)
   {
      whyOut = "GOM déconnecté";
      return false;
   }

   // ── VERROU WAIT CHART (v1.21) ──────────────────────────────────────
   // Si le symbole graphique est en WAIT (vn=0), INTERDIRE TOUTE entrée
   // market. Le cache symbole NE DOIT JAMAIS override un WAIT live :
   // cause des entrées FlipX alors que le panel affichait déjà WAIT
   // (cache stale GOOD ≤120s).
   if(symbol == _Symbol && g_smcGomVerdictNum == 0)
   {
      whyOut = "GOM=WAIT (vn=0) chart — cache ignoré";
      return false;
   }

   int vn = g_smcGomVerdictNum;
   // Cache symbole UNIQUEMENT pour un symbole différent du chart.
   // Sur le chart, g_smcGomVerdictNum est la source de vérité.
   if(symbol != _Symbol)
   {
      int vnCache = SMCGP_GetCachedVerdictNum(symbol);
      if(vnCache != -999)
         vn = vnCache; // y compris 0 = WAIT cache → bloquera plus bas
   }
   else
   {
      vn = g_smcGomVerdictNum; // déjà non-WAIT ici
   }

   // WAIT → aucun market / limit
   if(vn == 0)
   {
      whyOut = "GOM=WAIT (vn=0)";
      return false;
   }
   // v1.27: spikes exigent GOOD min (|vn|>=2) — SIMPLE trop faible = pertes sans spike
   if((SMC_IsSpikeStyleSymbol(symbol) || IsBoomLikeSymbol(symbol) || IsCrashLikeSymbol(symbol))
      && MathAbs(vn) < 2 && SpikeRequireGoodGOM)
   {
      whyOut = "GOM trop faible pour spike |vn|=" + IntegerToString(vn) + " need >=2";
      return false;
   }

   // Contre-verdict strict
   if(dirSign > 0 && vn < 0)
   {
      whyOut = "BUY interdit — GOM SELL/PERFECT SELL vn=" + IntegerToString(vn);
      return false;
   }
   if(dirSign < 0 && vn > 0)
   {
      whyOut = "SELL interdit — GOM BUY/PERFECT BUY vn=" + IntegerToString(vn);
      return false;
   }

   // Boom / GainX : native BUY only + GOM doit être BUY
   if(IsBoomLikeSymbol(symbol))
   {
      if(dirSign < 0)
      {
         whyOut = "SELL interdit sur Boom/GainX (règle native)";
         return false;
      }
      if(vn <= 0)
      {
         whyOut = "BUY Boom/GainX interdit — GOM pas haussier vn=" + IntegerToString(vn);
         return false;
      }
   }

   // Crash / PainX : native SELL only + GOM doit être SELL
   if(IsCrashLikeSymbol(symbol))
   {
      if(dirSign > 0)
      {
         whyOut = "BUY interdit sur Crash/PainX (règle native)";
         return false;
      }
      if(vn >= 0)
      {
         whyOut = "SELL Crash/PainX interdit — GOM pas baissier vn=" + IntegerToString(vn);
         return false;
      }
   }

   return true;
}

//+------------------------------------------------------------------+
//| v1.18b: wrappers GOM (SafeTradeBuy/Sell vivent dans SMC_Stubs.mqh)|
//| Toute entrée market doit passer par ici → WAIT impossible.         |
//+------------------------------------------------------------------+
// v1.28j: FlipX / Vol — encore plus strict (anti SELL opportuniste sous WAIT/MIXED/HTTP fail)
bool SMC_FlipVolEntryAllowed(const string symbol, const int dirSign, string &whyOut)
{
   whyOut = "";
   bool isFlip = SMC_IsFlipStyleSymbol(symbol);
   bool isVol  = (SMC_GetSymbolCategory(symbol) == SYM_VOLATILITY);
   if(!isFlip && !isVol) return true;

   // WAIT / déco = jamais
   if(!g_smcGomConnected || g_smcGomVerdictNum == 0)
   {
      whyOut = "FlipX/Vol GOM WAIT ou déco";
      return false;
   }
   // Sens GOM obligatoire + GOOD minimum
   if(dirSign > 0 && g_smcGomVerdictNum < 2) { whyOut = "FlipX/Vol exige GOOD+ BUY"; return false; }
   if(dirSign < 0 && g_smcGomVerdictNum > -2) { whyOut = "FlipX/Vol exige GOOD+ SELL"; return false; }

   // M1 vs M5 contradictoires = structure faible (cas SELL pendant M5 BULL)
   bool m1b = SMC_ScalpTfDirIsBull(g_smcTfM1Dir), m1s = SMC_ScalpTfDirIsBear(g_smcTfM1Dir);
   bool m5b = SMC_ScalpTfDirIsBull(g_smcTfM5Dir), m5s = SMC_ScalpTfDirIsBear(g_smcTfM5Dir);
   bool h1b = SMC_ScalpTfDirIsBull(g_smcTfH1Dir), h1s = SMC_ScalpTfDirIsBear(g_smcTfH1Dir);
   if((m1b && m5s) || (m1s && m5b))
   {
      whyOut = "FlipX/Vol M1/M5 mixtes — pas d'entrée";
      return false;
   }
   if((m5b && h1s) || (m5s && h1b))
   {
      whyOut = "FlipX/Vol M5/H1 mixtes";
      return false;
   }
   // Direction doit être alignée M1+M5 (sauf PERFECT)
   if(MathAbs(g_smcGomVerdictNum) < 3)
   {
      if(dirSign > 0 && (m1s || m5s)) { whyOut = "FlipX BUY contre M1/M5 BEAR"; return false; }
      if(dirSign < 0 && (m1b || m5b)) { whyOut = "FlipX SELL contre M1/M5 BULL"; return false; }
      if(dirSign > 0 && h1s) { whyOut = "FlipX BUY contre H1 BEAR"; return false; }
      if(dirSign < 0 && h1b) { whyOut = "FlipX SELL contre H1 BULL"; return false; }
   }

   if(IsPriceInRange())
   {
      whyOut = "FlipX/Vol en range/consolidation";
      return false;
   }
   if(SMC_PriceIsInBlockedRetraceZone())
   {
      whyOut = "FlipX/Vol mid-retrace";
      return false;
   }
   return true;
}


// v1.29: tendances claires uniquement — bloque range / consol / correction / retrace
bool SMC_IsMarketChoppyOrRetrace(string &whyOut)
{
   whyOut = "";
   // 1) Range / consolidation prix
   if(IsPriceInRange())
   {
      whyOut = "RANGE/consolidation prix";
      return true;
   }
   // 2) Zone retrace mid / équilibre
   if(SMC_PriceIsInBlockedRetraceZone())
   {
      whyOut = "RETRACE mid (" + g_priceZoneLabel + " " + DoubleToString(g_priceZonePct, 0) + "%)";
      return true;
   }
   // 3) ATR compression (début/milieu consolidation)
   if(atrHandle != INVALID_HANDLE)
   {
      double atr[]; ArraySetAsSeries(atr, true);
      if(CopyBuffer(atrHandle, 0, 0, 14, atr) >= 14)
      {
         double sum = 0;
         for(int i = 1; i < 14; i++) sum += atr[i];
         double avg = sum / 13.0;
         if(avg > 0 && atr[0] < avg * 0.55)
         {
            whyOut = "ATR compression (consolidation)";
            return true;
         }
      }
   }
   // 4) Bougies M1 à petits corps (chop)
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 12, r) >= 12)
   {
      double hi = r[0].high, lo = r[0].low;
      double bodySum = 0;
      for(int i = 0; i < 12; i++)
      {
         if(r[i].high > hi) hi = r[i].high;
         if(r[i].low < lo) lo = r[i].low;
         bodySum += MathAbs(r[i].close - r[i].open);
      }
      double span = hi - lo;
      if(span > 0 && (bodySum / 12.0) < span * 0.12)
      {
         whyOut = "chop M1 (petits corps / range)";
         return true;
      }
   }
   return false;
}

// TF essentielles alignées dans le sens de l'entrée (M5 + H1 minimum)
bool SMC_EssentialTfTrendAligned(const int dirSign, string &whyOut)
{
   whyOut = "";
   bool m5b = SMC_ScalpTfDirIsBull(g_smcTfM5Dir), m5s = SMC_ScalpTfDirIsBear(g_smcTfM5Dir);
   bool h1b = SMC_ScalpTfDirIsBull(g_smcTfH1Dir), h1s = SMC_ScalpTfDirIsBear(g_smcTfH1Dir);
   bool m1b = SMC_ScalpTfDirIsBull(g_smcTfM1Dir), m1s = SMC_ScalpTfDirIsBear(g_smcTfM1Dir);

   // M5 et H1 ne doivent pas se contredire
   if((m5b && h1s) || (m5s && h1b))
   {
      whyOut = "M5/H1 mixtes (pas de tendance claire)";
      return false;
   }
   if(dirSign > 0)
   {
      // BUY: M5 BULL requis; H1 pas BEAR; M1 pas BEAR fort si H1 neutre
      if(m5s) { whyOut = "M5 BEAR — pas de BUY tendance"; return false; }
      if(!m5b && !h1b) { whyOut = "M5/H1 non BULL — pas de tendance BUY"; return false; }
      if(h1s) { whyOut = "H1 BEAR — pas de BUY tendance"; return false; }
      if(m1s && m5b && !h1b) { whyOut = "M1 contre M5 sans H1 BULL"; return false; }
   }
   else if(dirSign < 0)
   {
      if(m5b) { whyOut = "M5 BULL — pas de SELL tendance"; return false; }
      if(!m5s && !h1s) { whyOut = "M5/H1 non BEAR — pas de tendance SELL"; return false; }
      if(h1b) { whyOut = "H1 BULL — pas de SELL tendance"; return false; }
      if(m1b && m5s && !h1s) { whyOut = "M1 contre M5 sans H1 BEAR"; return false; }
   }
   return true;
}

bool SMC_TrendOnlyEntryAllowed(const int dirSign, string &whyOut)
{
   whyOut = "";
   string chop = "";
   if(SMC_IsMarketChoppyOrRetrace(chop))
   {
      whyOut = chop;
      return false;
   }
   if(SMC_IsCorrectionZoneForDirection(_Symbol, dirSign))
   {
      whyOut = "correction/consolidation vs direction";
      return false;
   }
   if(!SMC_EssentialTfTrendAligned(dirSign, whyOut))
      return false;
   return true;
}


//+------------------------------------------------------------------+
//| v1.31 LANGAGE UNIQUE — décision finale prudente                   |
//| Toutes stratégies (GOM/DOW/SR20/ENGULF/PERFECT/LIMIT) même règles |
//+------------------------------------------------------------------+
bool SMC_UnifiedFinalDecision(const string symbol, const int dirSign, const string orderKind, string &whyOut)
{
   whyOut = "";
   if(BlockAllTrades)
   {
      whyOut = "BlockAllTrades";
      return false;
   }
   // 1) GOM obligatoire et connecté
   if(!g_smcGomConnected || g_smcGomVerdictNum == 0)
   {
      whyOut = "GOM WAIT ou déconnecté — aucune entrée";
      return false;
   }
   // 2) Sens strictement aligné GOM
   if(dirSign > 0 && g_smcGomVerdictNum < 0)
   {
      whyOut = "refus BUY — GOM est SELL vn=" + IntegerToString(g_smcGomVerdictNum);
      return false;
   }
   if(dirSign < 0 && g_smcGomVerdictNum > 0)
   {
      whyOut = "refus SELL — GOM est BUY vn=" + IntegerToString(g_smcGomVerdictNum);
      return false;
   }
   // 3) Minimum GOOD (|vn|>=2) pour toute entrée décisionnelle
   if(MathAbs(g_smcGomVerdictNum) < 2)
   {
      whyOut = "GOM SIMPLE insuffisant — exige GOOD/PERFECT |vn|=" + IntegerToString(g_smcGomVerdictNum);
      return false;
   }
   // 3b) Stabilité ≥ 60s (éviter entrées sur verdict qui vient de basculer)
   {
      string stWhy = "";
      if(!SMC_GomVerdictStable(dirSign, stWhy))
      {
         whyOut = stWhy;
         return false;
      }
   }
   // 3c) FlipX / FxVol / SfxVol / Volatility: WAIT = blocage total déjà fait en (1)
   //     + retrace zone toujours bloquée (déjà TrendOnly)
   // 4) Direction native Boom/Crash
   string dirStr = (dirSign > 0) ? "BUY" : "SELL";
   if(!IsDirectionAllowedForBoomCrash(symbol, dirStr))
   {
      whyOut = "direction native interdite " + dirStr + " sur " + symbol;
      return false;
   }
   // 5) Verrou absolu GOM
   string absWhy = "";
   if(!SMC_AbsoluteNoTradeAgainstGOM(symbol, dirSign, absWhy))
   {
      whyOut = absWhy;
      return false;
   }
   // 6) FlipX / Vol strict
   string flipWhy = "";
   if(!SMC_FlipVolEntryAllowed(symbol, dirSign, flipWhy))
   {
      whyOut = flipWhy;
      return false;
   }
   // 7) Tendance claire uniquement (pas range/consol/retrace/correction)
   string trendWhy = "";
   if(!SMC_TrendOnlyEntryAllowed(dirSign, trendWhy))
   {
      whyOut = trendWhy;
      return false;
   }
   // Moteur de précision commun à toutes les entrées market/limit encapsulées.
   // Il impose une bougie clôturée, une localisation mesurable et interdit de
   // poursuivre le prix après une impulsion déjà étendue.
   string precisionWhy = "";
   if(!SMC_PrecisionEntryGate(symbol, dirSign, orderKind, precisionWhy))
   {
      whyOut = "precision entry: " + precisionWhy;
      return false;
   }
   // 8) Spike confirm sauf PERFECT fort
   bool isPerfect = (MathAbs(g_smcGomVerdictNum) >= 3);
   if(!isPerfect && (SMC_IsSpikeStyleSymbol(symbol) || IsBoomLikeSymbol(symbol) || IsCrashLikeSymbol(symbol)))
   {
      string spWhy = "";
      if(!SMC_SpikeConfirmStrict(symbol, dirSign, spWhy))
      {
         whyOut = "spike confirm: " + spWhy;
         return false;
      }
   }
   // 9) CanPlaceOrderByGOM (cohérence modules)
   if(UseGOMVerdictFilter && !CanPlaceOrderByGOM(symbol, dirSign, orderKind))
   {
      whyOut = "CanPlaceOrderByGOM refus (" + orderKind + ")";
      return false;
   }
   return true;
}

bool SMC_GatedTradeBuy(double volume, const string symbol, double price, double sl, double tp, const string comment)
{
   string why = "";
   if(!SMC_UnifiedFinalDecision(symbol, +1, "MARKET", why))
   {
      Print("🚫 GatedBuy [UNIFIED] — ", why, " | ", symbol, " | ", comment);
      return false;
   }
   if(price <= 0.0) price = SymbolInfoDouble(symbol, SYMBOL_ASK);
   if(!SMC_BuildIntelligentLevels(symbol, +1, volume, price, sl, tp))
   {
      Print("🚫 GatedBuy [SMART SL/TP] niveaux invalides | ", symbol, " | ", comment);
      return false;
   }
   return SafeTradeBuy(volume, symbol, price, sl, tp, comment);
}

bool SMC_GatedTradeSell(double volume, const string symbol, double price, double sl, double tp, const string comment)
{
   string why = "";
   if(!SMC_UnifiedFinalDecision(symbol, -1, "MARKET", why))
   {
      Print("🚫 GatedSell [UNIFIED] — ", why, " | ", symbol, " | ", comment);
      return false;
   }
   if(price <= 0.0) price = SymbolInfoDouble(symbol, SYMBOL_BID);
   if(!SMC_BuildIntelligentLevels(symbol, -1, volume, price, sl, tp))
   {
      Print("🚫 GatedSell [SMART SL/TP] niveaux invalides | ", symbol, " | ", comment);
      return false;
   }
   return SafeTradeSell(volume, symbol, price, sl, tp, comment);
}

bool CanPlaceOrderByGOM(const string symbol, const int dirSign, const string orderKind)
{
   // v1.32: AUCUN ordre (market/limit/spike/…) tant que GOM = WAIT
   if(!g_smcGomConnected || g_smcGomVerdictNum == 0)
   {
      Print("🚫 ", orderKind, " BLOQUÉ — GOM WAIT — aucun ordre | ", symbol);
      return false;
   }
   // v1.18c: verrou absolu AVANT tout (même si filtre GOM "off" pour market)
   if(orderKind == "MARKET" || orderKind == "ENGULF" || orderKind == "IMPULSE" ||
      orderKind == "SPIKE" || orderKind == "PRESPIKE" || orderKind == "SR20")
   {
      string absWhy = "";
      if(!SMC_AbsoluteNoTradeAgainstGOM(symbol, dirSign, absWhy))
      {
         Print("🚫 ", orderKind, " BLOQUÉ ABSOLU — ", symbol, " — ", absWhy);
         return false;
      }
   }
   else
   {
      // LIMIT: même règle WAIT/contre-verdict que le market (v1.26)
      string absWhy = "";
      if(!SMC_AbsoluteNoTradeAgainstGOM(symbol, dirSign, absWhy))
      {
         Print("🚫 ", orderKind, " BLOQUÉ ABSOLU — ", symbol, " — ", absWhy);
         return false;
      }
   }

   if(!UseGOMVerdictFilter) return true;

   // v1.21: chart WAIT = source de vérité — ne jamais laisser le cache
   // autoriser un ordre si le panel / g_smcGomVerdictNum est déjà WAIT.
   if(symbol == _Symbol && g_smcGomConnected && g_smcGomVerdictNum == 0)
   {
      Print("🚫 ", orderKind, " BLOQUÉ — ", symbol, " — GOM=WAIT (vn=0) chart — AUCUN ORDRE");
      return false;
   }

   int vn = -999;
   if(symbol == _Symbol && g_smcGomConnected)
      vn = g_smcGomVerdictNum; // chart live prioritaire
   else if(g_smcGomConnected)
      vn = SMCGP_GetCachedVerdictNum(symbol);
   // Fallback symbole graphique courant si cache symbole manquant
   if(vn == -999 && symbol == _Symbol)
      vn = g_smcGomVerdictNum;

   if(vn == -999)
   {
      Print("🚫 ", orderKind, " BLOQUÉ — ", symbol, " — PAS DE VERDICT GOM");
      return false;
   }
   // WAIT (vn=0) : BLOQUER TOUT (market + limit)
   if(vn == 0)
   {
      Print("🚫 ", orderKind, " BLOQUÉ — ", symbol, " — GOM=WAIT (vn=0) — AUCUN ORDRE AUTORISÉ");
      return false;
   }
// v1.17: SIMPLE (|vn|>=1) OK pour DOW + symboles SPIKE (Boom/Crash/PainX/GainX)
    // Autres symboles: MinGOMVerdictNumAbs (défaut 1)
    bool isSpikeSym = SMC_IsSpikeStyleSymbol(symbol) || IsBoomLikeSymbol(symbol) || IsCrashLikeSymbol(symbol);
    if(orderKind == "DOW" || orderKind == "DOW EP" || orderKind == "DOW TL" || isSpikeSym)
    {
       if(MathAbs(vn) < 1)
       {
          Print("🚫 ", orderKind, " BLOQUÉ — ", symbol,
                " — GOM=WAIT vn=", vn, " (exige |vn|>=1)");
          return false;
       }
    }
    else if(MathAbs(vn) < MinGOMVerdictNumAbs)
    {
       Print("🚫 ", orderKind, " BLOQUÉ — ", symbol,
             " — GOM trop faible vn=", vn,
             " (exige |vn|>=", MinGOMVerdictNumAbs, ")");
       return false;
    }
   // Cohérence GOM suffisante (règle IA gate par profil : Forex 80%, Silver 85%, Gold 90%, Boom/Crash 65%)
   if(g_smcGomCoherence > 0 && g_smcGomCoherence < SMC_EffectiveGOMMinCoherence())
   {
      Print("🚫 ", orderKind, " BLOQUÉ — ", symbol, " — cohérence GOM ",
            DoubleToString(g_smcGomCoherence,1), "% < ",
            DoubleToString(SMC_EffectiveGOMMinCoherence(),1), "% minimum");
      return false;
   }
   // Contre-verdict INTERDIT : GOOD SELL ⇒ aucun BUY (market/limit), et inverse
   // Utiliser aussi g_smcGomVerdictNum chart si cache flou
   int vnChart = (symbol == _Symbol) ? g_smcGomVerdictNum : vn;
   if(vnChart != 0 && vnChart != -999) vn = vnChart;

   if(dirSign > 0 && vn < 0)
   {
      Print("🚫 BUY ", orderKind, " BLOQUÉ sur ", symbol, " — GOM=", 
            (vn <= -2 ? "GOOD/PERFECT SELL" : "SELL"), " vn=", vn, " (verdict décide)");
      return false;
   }
   if(dirSign < 0 && vn > 0)
   {
      Print("🚫 SELL ", orderKind, " BLOQUÉ sur ", symbol, " — GOM=",
            (vn >= 2 ? "GOOD/PERFECT BUY" : "BUY"), " vn=", vn, " (verdict décide)");
      return false;
   }
   // v1.24: même seuil GOM (GOOD min) sur spikes — plus de SIMPLE faible
   int needAbs = MathMax(1, MinGOMVerdictNumAbs);
   if(SpikeRequireGoodGOM && isSpikeSym)
      needAbs = MathMax(2, needAbs);
   if(dirSign > 0 && vn < needAbs) return false;
   if(dirSign < 0 && vn > -needAbs) return false;
   return true;
}

//+------------------------------------------------------------------+
//| Bougie de rejet sur la dernière bougie clôturée (ZoneConfluenceTF)|
//| Pin bar (mèche dominante + clôture dans le sens attendu) OU       |
//| engulfing (le corps "avale" celui de la bougie précédente).       |
//| Objectif : ne pas entrer sur un simple "passage" dans la zone,    |
//| mais seulement quand la bougie a visiblement réagi dessus.        |
//+------------------------------------------------------------------+
bool SMC_ZoneRejectionCandleOK(const string symbol, const int dirSign)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(symbol, ZoneConfluenceTF, 0, 3, rates) < 3) return false;

   // rates[0] = bougie en cours (non close) — on juge la dernière bougie CLÔTURÉE
   double o = rates[1].open, c = rates[1].close, h = rates[1].high, l = rates[1].low;
   double range = h - l;
   if(range <= 0) return false;

   double lowerWick = MathMin(o, c) - l;
   double upperWick = h - MathMax(o, c);

   if(dirSign > 0)
   {
      bool pinBar    = (lowerWick >= range * 0.5) && (c > o) && (c >= l + range * 0.6);
      bool engulfing = (c > o) && (c > rates[2].open) && (o <= rates[2].close);
      return pinBar || engulfing;
   }
   else
   {
      bool pinBar    = (upperWick >= range * 0.5) && (c < o) && (c <= h - range * 0.6);
      bool engulfing = (c < o) && (c < rates[2].open) && (o >= rates[2].close);
      return pinBar || engulfing;
   }
}

//+------------------------------------------------------------------+
//| Sweep de liquidité récent (≤ LiquiditySweepMaxBarsAgo bougies)    |
//| aligné avec la direction du trade :                               |
//|  - SSL (sweep d'un plus bas / stops vendeurs) → retournement HAUSSIER attendu |
//|  - BSL (sweep d'un plus haut / stops acheteurs) → retournement BAISSIER attendu |
//+------------------------------------------------------------------+
bool SMC_RecentLiquiditySweepAligned(const string symbol, const int dirSign)
{
   string sweepType;
   int barsAgo = 99;
   if(!SMC_DetectLiquiditySweepEx(symbol, ZoneConfluenceTF, sweepType, barsAgo))
      return false;
   if(barsAgo > LiquiditySweepMaxBarsAgo) return false;

   if(dirSign > 0) return (sweepType == "SSL");
   return (sweepType == "BSL");
}

bool SMC_APlusSetupOK(const string symbol, const int dirSign)
{
   if(!UseAPlusSetupOnly) return true;
   if(dirSign == 0) return false;

   static datetime s_aplusLog = 0;
   bool doLog = (TimeCurrent() - s_aplusLog >= 20);

   int vn = -999;
   if(g_smcGomConnected)
      vn = SMCGP_GetCachedVerdictNum(symbol);
   if(vn == -999 && symbol == _Symbol)
      vn = g_smcGomVerdictNum;
   if(vn == -999 || vn == 0 || MathAbs(vn) < 2)
   {
      if(doLog)
      {
         s_aplusLog = TimeCurrent();
         Print("🚫 A+ BLOQUÉ — ", symbol, " — GOM pas GOOD/PERFECT (vn=", vn, ")");
      }
      return false;
   }
   if((dirSign > 0 && vn < 2) || (dirSign < 0 && vn > -2))
   {
      if(doLog)
      {
         s_aplusLog = TimeCurrent();
         Print("🚫 A+ BLOQUÉ — ", symbol, " — GOM vn=", vn, " contre la direction");
      }
      return false;
   }

   if(!SMC_M5H1PreciseAligned(dirSign))
   {
      if(doLog)
      {
         s_aplusLog = TimeCurrent();
         Print("🚫 A+ BLOQUÉ — ", symbol, " — M5+H1 non alignés (M5=", g_smcTfM5Dir,
               " H1=", g_smcTfH1Dir, ")");
      }
      return false;
   }

   double price = (dirSign > 0) ? SymbolInfoDouble(symbol, SYMBOL_ASK)
                                : SymbolInfoDouble(symbol, SYMBOL_BID);
   if(price <= 0) return false;
   double tol = SMCGP_EntryTolerance(price);
   bool onZone = false;
   if(dirSign > 0 && SMCGP_IsPriceInOBBull()) onZone = true;
   if(dirSign < 0 && SMCGP_IsPriceInOBBear()) onZone = true;
   if(!onZone && g_smcOteTop > 0 && g_smcOteBot > 0)
   {
      double lo = MathMin(g_smcOteTop, g_smcOteBot);
      double hi = MathMax(g_smcOteTop, g_smcOteBot);
      if(price >= lo && price <= hi)
         onZone = true;
   }
   if(!onZone)
   {
      double kola = (dirSign > 0) ? g_smcGomKolaBuy : g_smcGomKolaSell;
      if(kola > 0 && MathAbs(price - kola) <= tol)
         onZone = true;
   }
   if(!onZone && g_smcSetupValid && g_smcSetupEntry > 0 && g_smcSetupDir == dirSign)
   {
      if(MathAbs(price - g_smcSetupEntry) <= tol)
         onZone = true;
   }
   if(!onZone)
   {
      if(MathAbs(vn) >= MinGOMVerdictNumAbs)
      {
         if(doLog) { s_aplusLog = TimeCurrent(); Print("⚡ A+ zone soft — GOM GOOD/PERFECT vn=", vn); }
         onZone = true;
      }
      else
      {
         if(doLog)
         {
            s_aplusLog = TimeCurrent();
            Print("🚫 A+ BLOQUÉ — ", symbol, " — prix hors zone (OB / OTE / Kola / setup)");
         }
         return false;
      }
   }

   // Bougie de rejet sur la zone — évite d'entrer sur un simple passage sans réaction
   if(RequireZoneRejectionCandle && !SMC_ZoneRejectionCandleOK(symbol, dirSign))
   {
      if(doLog)
      {
         s_aplusLog = TimeCurrent();
         Print("🚫 A+ BLOQUÉ — ", symbol, " — pas de bougie de rejet (pin bar/engulfing) sur la zone");
      }
      return false;
   }

   // Sweep de liquidité récent aligné — confirme que les stops ont été chassés avant le retournement
   if(RequireLiquiditySweep && !SMC_RecentLiquiditySweepAligned(symbol, dirSign))
   {
      if(doLog)
      {
         s_aplusLog = TimeCurrent();
         Print("🚫 A+ BLOQUÉ — ", symbol, " — pas de liquidity sweep récent aligné (≤", LiquiditySweepMaxBarsAgo, " bougies)");
      }
      return false;
   }

   int maxPos = MathMax(1, APlusMaxPositions);
   if(CountTerminalAllOrders() >= maxPos)
   {
      if(doLog)
      {
         s_aplusLog = TimeCurrent();
         Print("🚫 A+ BLOQUÉ — déjà ", CountTerminalAllOrders(), " ordre(s), max ", maxPos);
      }
      return false;
   }

   if(APlusMaxDailyTrades > 0 && g_cmTradesToday >= APlusMaxDailyTrades)
   {
      if(doLog)
      {
         s_aplusLog = TimeCurrent();
         Print("🚫 A+ BLOQUÉ — max ", APlusMaxDailyTrades, " trades/jour atteint");
      }
      return false;
   }
   return true;
}

bool CanPlaceMarketOrder(const string symbol, const int dirSign)
{
   // ── GARDE DIRECTION BOOM/CRASH: pas de SELL sur Boom/Gainx, pas de BUY sur Crash/Painx ──
   string dirStr = (dirSign > 0) ? "BUY" : "SELL";
   if(!IsDirectionAllowedForBoomCrash(symbol, dirStr))
   {
      Print("🚫 MARKET BLOQUÉ — ", symbol, " — direction ", dirStr, " interdite (règle Boom/Crash)");
      return false;
   }
   // ── GARDE TERMINAL GLOBAL ──
   if(IsTerminalFull())
   {
        Print("🚫 MARKET BLOQUÉ — Terminal plein (", CountTerminalAllOrders(), "/", MaxPositionsTerminal, ")");
      return false;
   }
   // ── GARDE PAR SYMBOLE: pas de 2ème ordre sur même symbole ──
   if(SymbolHasActiveOrder(symbol))
   {
      Print("🚫 MARKET BLOQUÉ — ", symbol, " a déjà un ordre actif (", CountOrdersForSymbol(symbol), ")");
      return false;
   }
   if(!CanPlaceOrderByGOM(symbol, dirSign, "MARKET"))
      return false;
   return SMC_APlusSetupOK(symbol, dirSign);
}

// ── GATEKEEPER: direction GOM + max 2 limit orders ─────────────────────
// Retourne true si l'ordre LIMIT est autorisé, false sinon
bool CanPlaceLimitOrder(const string symbol, ENUM_ORDER_TYPE orderType)
{
   // ── GARDE DIRECTION BOOM/CRASH: pas de SELL sur Boom/Gainx, pas de BUY sur Crash/Painx ──
   string dirStr = "";
   if(orderType == ORDER_TYPE_BUY_LIMIT || orderType == ORDER_TYPE_BUY)
      dirStr = "BUY";
   else if(orderType == ORDER_TYPE_SELL_LIMIT || orderType == ORDER_TYPE_SELL)
      dirStr = "SELL";
   if(dirStr != "" && !IsDirectionAllowedForBoomCrash(symbol, dirStr))
   {
      Print("🚫 LIMIT BLOQUÉ — ", symbol, " — direction ", dirStr, " interdite (règle Boom/Crash)");
      return false;
   }
   // v1.31: même décision unifiée pour LIMIT
   if(dirStr == "BUY" || dirStr == "SELL")
   {
      int dU = (dirStr == "BUY") ? 1 : -1;
      string uw = "";
      if(!SMC_UnifiedFinalDecision(symbol, dU, "LIMIT", uw))
      {
         Print("🚫 LIMIT [UNIFIED] — ", uw, " | ", symbol);
         return false;
      }
   }
   if(!g_smcGomConnected || g_smcGomVerdictNum == 0)
   {
      Print("🚫 LIMIT BLOQUÉ — GOM WAIT/déco | ", symbol, " | ", dirStr);
      return false;
   }
   // v1.27b: JAMAIS de LIMIT contre le sens GOM
   if(dirStr == "BUY" && g_smcGomVerdictNum < 0)
   {
      Print("🚫 LIMIT BUY contre GOM SELL vn=", g_smcGomVerdictNum, " | ", symbol);
      return false;
   }
   if(dirStr == "SELL" && g_smcGomVerdictNum > 0)
   {
      Print("🚫 LIMIT SELL contre GOM BUY vn=", g_smcGomVerdictNum, " | ", symbol);
      return false;
   }
   // v1.27b: conflit zone / GOM → pas de LIMIT
   if(SMC_GomZoneConflict())
   {
      Print("🚫 LIMIT BLOQUÉ — conflit GOM vs ZONE | ", symbol, " | ", dirStr);
      return false;
   }
   // v1.28e: FlipX/Vol — LIMIT uniquement si GOOD+ et pas consolidation
   {
      int dLim = (dirStr == "BUY") ? 1 : ((dirStr == "SELL") ? -1 : 0);
      string fw = "";
      if(dLim != 0 && !SMC_FlipVolEntryAllowed(symbol, dLim, fw))
      {
         Print("🚫 LIMIT BLOQUÉ FlipX/Vol — ", fw, " | ", symbol);
         return false;
      }
      string tw = "";
      if(dLim != 0 && !SMC_TrendOnlyEntryAllowed(dLim, tw))
      {
         Print("🚫 LIMIT BLOQUÉ TENDANCE ONLY — ", tw, " | ", symbol);
         return false;
      }
   }
   // ── GARDE TERMINAL GLOBAL ──
   if(IsTerminalFull())
   {
        Print("🚫 LIMIT BLOQUÉ — Terminal plein (", CountTerminalAllOrders(), "/", MaxPositionsTerminal, ")");
      return false;
   }
   // ── GARDE PAR SYMBOLE: pas de 2ème ordre sur même symbole ──
   if(SymbolHasActiveOrder(symbol))
   {
      Print("🚫 LIMIT BLOQUÉ — ", symbol, " a déjà un ordre actif (", CountOrdersForSymbol(symbol), ")");
      return false;
   }

   if(EnforceSingleDirection && dirStr != "")
   {
      int dirSign = (dirStr == "BUY") ? 1 : -1;
      if(SymbolHasOppositeExposure(symbol, dirSign))
      {
         Print("🚫 LIMIT BLOQUÉ — ", symbol, " exposition opposée à ", dirStr);
         return false;
      }
   }

   int dirSign = 0;
   if(orderType == ORDER_TYPE_BUY_LIMIT || orderType == ORDER_TYPE_BUY)
      dirSign = 1;
   else if(orderType == ORDER_TYPE_SELL_LIMIT || orderType == ORDER_TYPE_SELL)
      dirSign = -1;

   if(!CanPlaceOrderByGOM(symbol, dirSign, "LIMIT"))
      return false;
   if(!SMC_APlusSetupOK(symbol, dirSign))
      return false;

   string limReason = "";
   if(!LimitPlaceDisciplineOK(symbol, dirSign, limReason))
   {
      static datetime s_lastLimPlaceLog = 0;
      if(TimeCurrent() - s_lastLimPlaceLog >= 30)
      {
         s_lastLimPlaceLog = TimeCurrent();
         Print("🚫 LIMIT BLOQUÉ — ", symbol, " — ", limReason);
      }
      return false;
   }

   // Max 2 ordres LIMIT par symbole (garder les meilleurs via CleanupExcessLimits)
   int maxLimits = MathMax(1, MaxLimitOrdersTerminal);
   int total = CountOpenLimitOrdersForSymbol(symbol);
   if(total >= maxLimits)
   {
      Print("🚫 LIMIT BLOQUÉ — déjà ", total, " ordres limit sur ", symbol, " (max=", maxLimits, ")");
      return false;
   }

   return true;
}

// Supprime les ordres LIMIT les plus éloignés du prix courant si > max
void CleanupExcessLimits(const string symbol, int maxOrders)
{
   // Collecter tous nos limit orders
   struct LimitOrderInfo { ulong ticket; double price; ENUM_ORDER_TYPE type; datetime time; };
   LimitOrderInfo orders[];
   ArrayResize(orders, 0);

   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) != symbol) continue;
      if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(t != ORDER_TYPE_BUY_LIMIT && t != ORDER_TYPE_SELL_LIMIT) continue;
      // v1.17d: ne jamais supprimer DOW / SR20 / IMPULSE / PAT_LINE / ENGULF
      string cmt = OrderGetString(ORDER_COMMENT);
      if(SMC_IsPriorityLimitComment(cmt)) continue;

      // Grâce min discipline : ne pas supprimer un LIMIT trop jeune
      datetime orderTime = (datetime)OrderGetInteger(ORDER_TIME_SETUP);
      if(!LimitCancelAllowed(ticket, false, "CleanupExcessLimits"))
         continue;

      int sz = ArraySize(orders);
      ArrayResize(orders, sz + 1);
      orders[sz].ticket = ticket;
      orders[sz].price  = OrderGetDouble(ORDER_PRICE_OPEN);
      orders[sz].type   = t;
      orders[sz].time   = (datetime)OrderGetInteger(ORDER_TIME_SETUP);
   }

   int excess = ArraySize(orders) - maxOrders;
   if(excess <= 0) return;

   double currentPrice = SymbolInfoDouble(symbol, SYMBOL_BID);

   // Trier par distance au prix (plus éloigné en premier)
   for(int a = 0; a < ArraySize(orders) - 1; a++)
   {
      for(int b = a + 1; b < ArraySize(orders); b++)
      {
         double distA = MathAbs(orders[a].price - currentPrice);
         double distB = MathAbs(orders[b].price - currentPrice);
         if(distB > distA) // b plus loin → échanger
         {
            LimitOrderInfo tmp = orders[a];
            orders[a] = orders[b];
            orders[b] = tmp;
         }
      }
   }

   // Supprimer les plus éloignés
   for(int k = 0; k < excess; k++)
   {
      ulong tk = orders[k].ticket;
      if(!OrderSelect(tk)) continue;
      string cmt = OrderGetString(ORDER_COMMENT);
      if(!LimitSafeOrderDelete(tk, false, "CleanupExcessLimits " + cmt))
         Print("❌ Échec/suppression différée limit excessif ticket=", tk);
   }
}

bool SMC_DetectFVG(string symbol, ENUM_TIMEFRAMES tf, int lookback, FVGData &fvgOut)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(symbol, tf, 0, lookback, rates) < lookback) return false;
   for(int fvgIndex = 2; fvgIndex < lookback - 1; fvgIndex++)
   {
      if(rates[fvgIndex-1].low > rates[fvgIndex+1].high)
      {
         double gap = rates[fvgIndex-1].low - rates[fvgIndex+1].high;
         double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
         if(gap > point * 3) {
            fvgOut.top = rates[fvgIndex-1].low; fvgOut.bottom = rates[fvgIndex+1].high; fvgOut.direction = 1;
            fvgOut.time = rates[fvgIndex].time; fvgOut.isInversion = false; fvgOut.barIndex = fvgIndex;
            return true;
         }
      }
      if(rates[fvgIndex-1].high < rates[fvgIndex+1].low)
      {
         double gap = rates[fvgIndex+1].low - rates[fvgIndex-1].high;
         double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
         if(gap > point * 3) {
            fvgOut.top = rates[fvgIndex+1].low; fvgOut.bottom = rates[fvgIndex-1].high; fvgOut.direction = -1;
            fvgOut.time = rates[fvgIndex].time; fvgOut.isInversion = false; fvgOut.barIndex = fvgIndex;
            return true;
         }
      }
   }
   return false;
}
bool SMC_DetectBOS(string symbol, ENUM_TIMEFRAMES tf, int &directionOut)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(symbol, tf, 0, 20, rates) < 20) return false;
   double prevSwingHigh = MathMax(rates[3].high, MathMax(rates[4].high, rates[5].high));
   double prevSwingLow = MathMin(rates[3].low, MathMin(rates[4].low, rates[5].low));
   double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
   double minBreak = point * 5;
   if(rates[1].close > prevSwingHigh + minBreak) { directionOut = 1; return true; }
   if(rates[1].close < prevSwingLow - minBreak) { directionOut = -1; return true; }
   return false;
}
bool SMC_DetectLiquiditySweep(string symbol, ENUM_TIMEFRAMES tf, string &typeOut)
{
   int barsAgo;
   return SMC_DetectLiquiditySweepEx(symbol, tf, typeOut, barsAgo);
}
bool SMC_DetectLiquiditySweepEx(string symbol, ENUM_TIMEFRAMES tf, string &typeOut, int &barsAgoOut)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(symbol, tf, 0, 15, rates) < 15) return false;
   barsAgoOut = 99;
   double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
   double minSweep = point * 5;
   for(int b = 1; b <= 5; b++)
   {
      if(b + 2 >= ArraySize(rates)) break;
      double prevHigh = rates[b+1].high;
      double prevLow = rates[b+1].low;
      double currHigh = rates[b].high;
      double currLow = rates[b].low;
      if(currHigh > prevHigh && (currHigh - prevHigh) > minSweep)
      {
         typeOut = "BSL";
         barsAgoOut = b;
         return true;
      }
      if(currLow < prevLow && (prevLow - currLow) > minSweep)
      {
         typeOut = "SSL";
         barsAgoOut = b;
         return true;
      }
   }
   return false;
}
bool SMC_DetectOrderBlock(string symbol, ENUM_TIMEFRAMES tf, OrderBlockData &obOut)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(symbol, tf, 0, 50, rates) < 50) return false;
   for(int i = 3; i < 45; i++)
   {
      if(rates[i].close < rates[i].open && rates[i+1].close > rates[i+1].open)
      {
         double moveUp = rates[i+2].high - rates[i].low;
         double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
         if(moveUp > point * 20) {
            obOut.high = rates[i].high; obOut.low = rates[i].low; obOut.direction = 1;
            obOut.time = rates[i].time; obOut.barIndex = i; obOut.type = "OB";
            return true;
         }
      }
      if(rates[i].close > rates[i].open && rates[i+1].close < rates[i+1].open)
      {
         double moveDown = rates[i].high - rates[i+2].low;
         double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
         if(moveDown > point * 20) {
            obOut.high = rates[i].high; obOut.low = rates[i].low; obOut.direction = -1;
            obOut.time = rates[i].time; obOut.barIndex = i; obOut.type = "OB";
            return true;
         }
      }
   }
   return false;
}
bool SMC_IsLondonOpen(int hourStart, int hourEnd)
{
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   return (dt.hour >= hourStart && dt.hour <= hourEnd);
}
bool SMC_IsNewYorkOpen(int hourStart, int hourEnd)
{
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   return (dt.hour >= hourStart && dt.hour <= hourEnd);
}
bool SMC_IsKillZone(int loStart, int loEnd, int nyoStart, int nyoEnd)
{
   return SMC_IsLondonOpen(loStart, loEnd) || SMC_IsNewYorkOpen(nyoStart, nyoEnd);
}
double SMC_GetATRMultiplier(ENUM_SYMBOL_CATEGORY cat)
{
   switch(cat) {
      case SYM_BOOM_CRASH:  return 1.5;
      case SYM_VOLATILITY:  return 2.0;
      case SYM_FOREX:       return 2.0;
      case SYM_COMMODITY:   return 2.5;
      case SYM_METAL:       return 2.5;
      case SYM_CRYPTO:      return 3.0;
      default:              return 2.0;
   }
}

