//+------------------------------------------------------------------+
//| v1.17b: Engulfing local (indépendant du module conf=0)            |
//| Retourne +1 BUY engulfing, -1 SELL engulfing, 0 aucun             |
//| Bougie[1] clôturée avale le corps de bougie[2]                    |
//+------------------------------------------------------------------+
int SMC_DetectLocalEngulfingDir()
{
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, PERIOD_CURRENT, 0, 4, r) < 3)
      return 0;

   // rates[1] = dernière bougie clôturée, rates[2] = précédente
   double o1 = r[1].open, c1 = r[1].close, h1 = r[1].high, l1 = r[1].low;
   double o2 = r[2].open, c2 = r[2].close;
   double body1 = MathAbs(c1 - o1);
   double body2 = MathAbs(c2 - o2);
   if(body1 <= 0 || body2 <= 0)
      return 0;
   // Corps dominant
   if(body1 < body2 * 0.9)
      return 0;

   // Bullish Engulfing: bougie1 verte, avale corps2 (qui était rouge de préférence)
   bool bull = (c1 > o1) && (c1 >= MathMax(o2, c2)) && (o1 <= MathMin(o2, c2));
   // Bearish Engulfing: bougie1 rouge, avale corps2
   bool bear = (c1 < o1) && (c1 <= MathMin(o2, c2)) && (o1 >= MathMax(o2, c2));

   if(bull && !bear)
   {
      // Stocker le niveau de retest (low de la bougie bullish engulfing)
      if(g_engulfRetestDir != 1 || MathAbs(l1 - g_engulfRetestLevel) > _Point)
      {
         g_engulfRetestLevel = l1;
         g_engulfRetestDir   = 1;
         g_engulfRetestTime  = r[1].time;
         g_engulfRetestArmed = false;
      }
      return 1;
   }
   if(bear && !bull)
   {
      // Stocker le niveau de retest (high de la bougie bearish engulfing)
      if(g_engulfRetestDir != -1 || MathAbs(h1 - g_engulfRetestLevel) > _Point)
      {
         g_engulfRetestLevel = h1;
         g_engulfRetestDir   = -1;
         g_engulfRetestTime  = r[1].time;
         g_engulfRetestArmed = false;
      }
      return -1;
   }
   return 0;
}

// Trace une ligne pointillée au high/low de l'Engulfing (comme le module patterns)
void SMC_DrawLocalEngulfingLine(const int dir)
{
   if(dir == 0) return;
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, PERIOD_CURRENT, 0, 3, r) < 2) return;

   string name = "SMC_LOCAL_ENGULF_" + _Symbol;
   ObjectDelete(0, name);
   double price = (dir > 0) ? r[1].low : r[1].high;
   datetime t1 = r[1].time;
   datetime t2 = t1 + PeriodSeconds(PERIOD_CURRENT) * 30;
   color clr = (dir > 0) ? clrLime : clrRed;
   if(ObjectCreate(0, name, OBJ_TREND, 0, t1, price, t2, price))
   {
      ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
      ObjectSetInteger(0, name, OBJPROP_STYLE, STYLE_DOT);
      ObjectSetInteger(0, name, OBJPROP_WIDTH, 2);
      ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT, false);
      ObjectSetInteger(0, name, OBJPROP_BACK, false);
      ObjectSetString(0, name, OBJPROP_TEXT, dir > 0 ? "ENGULF BUY" : "ENGULF SELL");
   }
   string lbl = name + "_LBL";
   ObjectDelete(0, lbl);
   if(ObjectCreate(0, lbl, OBJ_TEXT, 0, t1, price))
   {
      ObjectSetString(0, lbl, OBJPROP_TEXT, dir > 0 ? "Engulf BUY" : "Engulf SELL");
      ObjectSetInteger(0, lbl, OBJPROP_COLOR, clr);
      ObjectSetInteger(0, lbl, OBJPROP_FONTSIZE, 8);
   }
}

// Entrée market sur Engulfing local si GOM aligné (SIMPLE+) et direction native OK
void SMC_TryExecuteLocalEngulfingEntry(const int dirSign)
{
   if(dirSign == 0 || BlockAllTrades) return;
   if(CountPositionsForSymbol(_Symbol) > 0) return;
   if(IsCrashLikeSymbol(_Symbol) && dirSign > 0) return;
   if(IsBoomLikeSymbol(_Symbol) && dirSign < 0) return;

   // GOM: au moins SIMPLE dans le même sens (ou déconnecté si filtre off)
   if(UseGOMVerdictFilter)
   {
      if(!g_smcGomConnected || g_smcGomVerdictNum == 0) return;
      if(dirSign > 0 && g_smcGomVerdictNum < 1) return;
      if(dirSign < 0 && g_smcGomVerdictNum > -1) return;
   }

   if(!CanPlaceOrderByGOM(_Symbol, dirSign, "ENGULF")) return;
   if(!CanTradeOnSymbol(_Symbol)) return;
   if(!TryAcquireOpenLock()) return;

   double atr = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[];
      ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atr = ab[0];
   }
   if(atr <= 0) atr = _Point * 50;
   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double lot = NormalizeVolumeForSymbol(0.01);
   if(UseMinLotOnly)
   {
      double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
      if(minLot > 0) lot = NormalizeVolumeForSymbol(minLot);
   }
   if(lot <= 0) { ReleaseOpenLock(); return; }

   double entry, sl, tp;
   bool ok = false;
   if(dirSign > 0)
   {
      entry = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      sl = NormalizeDouble(entry - atr * ImpulseZoneSL_ATRMult, dg);
      tp = NormalizeDouble(entry + atr * MathMax(ImpulseZoneTP_ATRMult, 2.0), dg);
      SMC_CapSLToMaxLossUSD(_Symbol, 1, entry, lot, sl);
      ok = SMC_GatedTradeBuy(lot, _Symbol, entry, sl, tp, "ENGULF BUY");
   }
   else
   {
      entry = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      sl = NormalizeDouble(entry + atr * ImpulseZoneSL_ATRMult, dg);
      tp = NormalizeDouble(entry - atr * MathMax(ImpulseZoneTP_ATRMult, 2.0), dg);
      SMC_CapSLToMaxLossUSD(_Symbol, -1, entry, lot, sl);
      ok = SMC_GatedTradeSell(lot, _Symbol, entry, sl, tp, "ENGULF SELL");
   }
   ReleaseOpenLock();
   if(ok)
   {
      RegisterOrderPlaced();
      SMC_DrawLocalEngulfingLine(dirSign);
      Print("📌 ENGULFING ENTRY ", (dirSign > 0 ? "BUY" : "SELL"), " ", _Symbol,
            " @", DoubleToString(entry, dg), " vn=", g_smcGomVerdictNum,
            " SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg));
      if(UseNotifications)
      {
         Alert("📌 ENGULF ", (dirSign > 0 ? "BUY" : "SELL"), " ", _Symbol);
         SendNotification("📌 ENGULF " + (dirSign > 0 ? "BUY" : "SELL") + " " + _Symbol);
      }
   }
}

//+------------------------------------------------------------------+
//| Met à jour l'état du retest Engulfing (armed si prix dans zone)   |
//+------------------------------------------------------------------+
void SMC_UpdateEngulfRetestState()
{
   if(!EngulfRetestEnable) return;
   if(g_engulfRetestDir == 0) return;

   // Vérifier TTL du niveau
   if(TimeCurrent() - g_engulfRetestTime > EngulfRetestMaxAgeSec)
   {
      g_engulfRetestLevel = 0;
      g_engulfRetestDir   = 0;
      g_engulfRetestArmed = false;
      return;
   }

   // Calculer ATR pour la zone
   double atr = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[];
      ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atr = ab[0];
   }
   if(atr <= 0) atr = _Point * 50;

   double maxDist = atr * EngulfRetestMaxDistATR;
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double price = (g_engulfRetestDir > 0) ? bid : ask;

   // Armer si prix dans la zone du niveau
   double dist = MathAbs(price - g_engulfRetestLevel);
   if(dist <= maxDist)
      g_engulfRetestArmed = true;
}

//+------------------------------------------------------------------+
//| Exécute l'entrée market sur retest Engulfing                     |
//| (armed + M1 flip confirmé + GOM aligné)                          |
//+------------------------------------------------------------------+
void SMC_TryExecuteEngulfRetestEntry()
{
   if(!EngulfRetestEnable) return;
   if(g_engulfRetestDir == 0 || !g_engulfRetestArmed) return;
   if(BlockAllTrades) return;
   if(TimeCurrent() - g_engulfRetestTime > EngulfRetestMaxAgeSec) return;

   // Pas de position ouverte
   if(CountPositionsForSymbol(_Symbol) > 0) return;

   // Direction native respectée
   if(IsCrashLikeSymbol(_Symbol) && g_engulfRetestDir > 0) return;
   if(IsBoomLikeSymbol(_Symbol) && g_engulfRetestDir < 0) return;

   // GOM aligné et ≠ WAIT
   if(UseGOMVerdictFilter)
   {
      if(!g_smcGomConnected || g_smcGomVerdictNum == 0) return;
      if(g_engulfRetestDir > 0 && g_smcGomVerdictNum < 1) return;
      if(g_engulfRetestDir < 0 && g_smcGomVerdictNum > -1) return;
   }

   // Flip bougie M1 confirmée (optionnel)
   if(EngulfRetestRequireM1Bar)
   {
      if(!SMC_M1BarConfirmsDirection(g_engulfRetestDir))
      {
         static datetime s_lastFlipLog = 0;
         if(TimeCurrent() - s_lastFlipLog >= 30)
         {
            s_lastFlipLog = TimeCurrent();
            Print("🔄 ENGULF RETEST — prix dans zone mais M1 pas encore flip ",
                  (g_engulfRetestDir > 0 ? "BUY" : "SELL"));
         }
         return;
      }
   }

   // Gates d'entrée
   if(!CanPlaceOrderByGOM(_Symbol, g_engulfRetestDir, "ENGULF_RETEST")) return;
   if(!CanTradeOnSymbol(_Symbol)) return;
   if(!AllowReentryAfterRecentLoss(_Symbol, g_engulfRetestDir > 0 ? "BUY" : "SELL", true)) return;

   // Cooldown (nb bougies)
   static datetime s_lastRetestBar = 0;
   datetime curBar = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(curBar == s_lastRetestBar) return;
   s_lastRetestBar = curBar;

   if(!TryAcquireOpenLock()) return;

   double atr = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[];
      ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atr = ab[0];
   }
   if(atr <= 0) atr = _Point * 50;

   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double lot = CalculateLotSize();
   if(lot <= 0) { ReleaseOpenLock(); return; }

   double entry = 0, sl = 0, tp = 0;
   bool ok = false;

   if(g_engulfRetestDir > 0)
   {
      entry = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      sl = NormalizeDouble(entry - atr * ImpulseZoneSL_ATRMult, dg);
      tp = NormalizeDouble(entry + atr * ImpulseZoneTP_ATRMult, dg);
      SMC_CapSLToMaxLossUSD(_Symbol, 1, entry, lot, sl);
      ok = SMC_GatedTradeBuy(lot, _Symbol, entry, sl, tp, "ENGULF RETEST BUY");
   }
   else
   {
      entry = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      sl = NormalizeDouble(entry + atr * ImpulseZoneSL_ATRMult, dg);
      tp = NormalizeDouble(entry - atr * ImpulseZoneTP_ATRMult, dg);
      SMC_CapSLToMaxLossUSD(_Symbol, -1, entry, lot, sl);
      ok = SMC_GatedTradeSell(lot, _Symbol, entry, sl, tp, "ENGULF RETEST SELL");
   }

   ReleaseOpenLock();

   if(ok)
   {
      RegisterOrderPlaced();
      g_maxProfit = 0;
      Print("⚡ ENGULF RETEST ", (g_engulfRetestDir > 0 ? "BUY" : "SELL"), " ", _Symbol,
            " @", DoubleToString(entry, dg),
            " | Level=", DoubleToString(g_engulfRetestLevel, dg),
            " | GOM=", g_smcGomVerdict, " vn=", g_smcGomVerdictNum,
            " | SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg));
      if(UseNotifications)
      {
         Alert("⚡ ENGULF RETEST ", (g_engulfRetestDir > 0 ? "BUY" : "SELL"), " ", _Symbol);
         SendNotification("⚡ ENGULF RETEST " + (g_engulfRetestDir > 0 ? "BUY" : "SELL") + " " + _Symbol);
      }
      // Reset état après exécution
      g_engulfRetestLevel = 0;
      g_engulfRetestDir   = 0;
      g_engulfRetestArmed = false;
   }
}

//+------------------------------------------------------------------+
//| v1.17c: Exécute les ordres à partir des LIGNES ENTRY en tirets    |
//| (objets chart: STYLE_DOT/DASH, noms Entry/Pattern/ENGULF/FVG…)    |
//| Le module patterns affiche conf=0% mais les lignes restent utiles.|
//+------------------------------------------------------------------+
void SMC_ExecutePatternDashedEntryLines()
{
   if(!PatternTradeDashedEntryLines || !UsePatternEntrySignals) return;
   if(BlockAllTrades) return;
   if(CountPositionsForSymbol(_Symbol) > 0) return;

   static datetime s_lastTry = 0;
   if(PatternDashedCooldownSec > 0 && (TimeCurrent() - s_lastTry) < PatternDashedCooldownSec)
      return;

   // HOLD n'empêche plus si option active
   if(!PatternDashedIgnoreHold)
   {
      if(g_lastAIAction == "HOLD" || g_lastAIAction == "hold")
         return;
   }

   // GOM min (0 = autorise même WAIT pour LIMIT sur ligne)
   int vn = g_smcGomConnected ? g_smcGomVerdictNum : 0;
   if(UseGOMVerdictFilter && PatternDashedMinGOMAbs > 0)
   {
      if(!g_smcGomConnected || MathAbs(vn) < PatternDashedMinGOMAbs)
         return;
   }

   double atr = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[];
      ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atr = ab[0];
   }
   if(atr <= 0) atr = _Point * 80;
   double maxDist = atr * MathMax(0.15, PatternDashedMaxDistATR);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double mid = (bid + ask) * 0.5;
   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);

   // Meilleure ligne BUY (vert) et SELL (rouge) proches
   double bestBuy = 0, bestSell = 0;
   double bestBuyDist = 1e99, bestSellDist = 1e99;
   string bestBuyName = "", bestSellName = "";

   int total = ObjectsTotal(0, 0, -1);
   for(int i = total - 1; i >= 0; i--)
   {
      string name = ObjectName(0, i);
      if(name == "") continue;
      int otype = (int)ObjectGetInteger(0, name, OBJPROP_TYPE);
      if(otype != OBJ_TREND && otype != OBJ_HLINE)
         continue;

      // Filtrer: style pointillé/tiret OU nom Entry/Pattern/Engulf/FVG/Supply/Demand
      long style = ObjectGetInteger(0, name, OBJPROP_STYLE);
      bool styleOk = (style == STYLE_DOT || style == STYLE_DASH || style == STYLE_DASHDOT
                      || style == STYLE_DASHDOTDOT);
      string nU = name;
      StringToUpper(nU);
      bool nameOk = (StringFind(nU, "ENTRY") >= 0 || StringFind(nU, "PATTERN") >= 0
                     || StringFind(nU, "ENGULF") >= 0 || StringFind(nU, "FVG") >= 0
                     || StringFind(nU, "SUPPLY") >= 0 || StringFind(nU, "DEMAND") >= 0
                     || StringFind(nU, "SMCPS") >= 0 || StringFind(nU, "PAT_") >= 0
                     || StringFind(nU, "RETEST") >= 0 || StringFind(nU, "ZONE") >= 0);
      // Texte objet
      string txt = ObjectGetString(0, name, OBJPROP_TEXT);
      string tU = txt; StringToUpper(tU);
      bool txtOk = (StringFind(tU, "ENTRY") >= 0 || StringFind(tU, "ENGULF") >= 0
                    || StringFind(tU, "BUY") >= 0 || StringFind(tU, "SELL") >= 0
                    || StringFind(tU, "BAISSE") >= 0 || StringFind(tU, "HAUSS") >= 0);
      if(!styleOk && !nameOk && !txtOk) continue;

      double price = 0;
      if(otype == OBJ_HLINE)
         price = ObjectGetDouble(0, name, OBJPROP_PRICE);
      else
         price = ObjectGetDouble(0, name, OBJPROP_PRICE, 0);
      if(price <= 0) continue;

      double dist = MathAbs(mid - price);
      if(dist > maxDist * 2.5) continue; // trop loin, ignore

      color clr = (color)ObjectGetInteger(0, name, OBJPROP_COLOR);
      // Heuristique direction
      int dir = 0;
      if(StringFind(nU, "SELL") >= 0 || StringFind(nU, "SUPPLY") >= 0
         || StringFind(nU, "BAISSE") >= 0 || StringFind(nU, "BEAR") >= 0
         || StringFind(tU, "SELL") >= 0 || StringFind(tU, "BAISSE") >= 0)
         dir = -1;
      else if(StringFind(nU, "BUY") >= 0 || StringFind(nU, "DEMAND") >= 0
              || StringFind(nU, "HAUSS") >= 0 || StringFind(nU, "BULL") >= 0
              || StringFind(tU, "BUY") >= 0 || StringFind(tU, "HAUSS") >= 0)
         dir = 1;
      else
      {
         // Couleur: verts = buy, rouges = sell
         int r = (clr >> 16) & 0xFF;
         int g = (clr >> 8) & 0xFF;
         int b = clr & 0xFF;
         if(g > r + 30 && g > b + 20) dir = 1;
         else if(r > g + 30 && r > b + 20) dir = -1;
         else if(price < mid) dir = 1;  // support sous prix → BUY
         else dir = -1;                 // résistance au-dessus → SELL
      }

      // Boom/Crash native
      if(IsCrashLikeSymbol(_Symbol) && dir > 0) continue;
      if(IsBoomLikeSymbol(_Symbol) && dir < 0) continue;

      // Alignement GOM soft (si vn non nul, ne pas prendre contre-verdict)
      if(UseGOMVerdictFilter && g_smcGomConnected && vn != 0)
      {
         if(dir > 0 && vn < 0) continue;
         if(dir < 0 && vn > 0) continue;
      }

      if(dir > 0 && dist < bestBuyDist)
      {
         bestBuyDist = dist; bestBuy = price; bestBuyName = name;
      }
      if(dir < 0 && dist < bestSellDist)
      {
         bestSellDist = dist; bestSell = price; bestSellName = name;
      }
   }

   // Choisir la meilleure opportunité (plus proche)
   int execDir = 0;
   double level = 0;
   string src = "";
   if(bestSell > 0 && bestBuy > 0)
   {
      if(bestSellDist <= bestBuyDist) { execDir = -1; level = bestSell; src = bestSellName; }
      else { execDir = 1; level = bestBuy; src = bestBuyName; }
   }
   else if(bestSell > 0) { execDir = -1; level = bestSell; src = bestSellName; }
   else if(bestBuy > 0)  { execDir = 1;  level = bestBuy;  src = bestBuyName; }
   if(execDir == 0 || level <= 0) return;

   double distLevel = MathAbs(mid - level);
   if(distLevel > maxDist && !(PatternDashedPreferLimit && distLevel <= maxDist * 2.0))
      return;

   // Déjà un LIMIT proche ?
   for(int j = OrdersTotal() - 1; j >= 0; j--)
   {
      ulong tk = OrderGetTicket(j);
      if(tk == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) != _Symbol) continue;
      if((int)OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      double op = OrderGetDouble(ORDER_PRICE_OPEN);
      if(MathAbs(op - level) <= atr * 0.25)
         return; // déjà armé
   }

   if(!TryAcquireOpenLock()) return;

   double lot = NormalizeVolumeForSymbol(0.01);
   if(UseMinLotOnly)
   {
      double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
      if(minLot > 0) lot = NormalizeVolumeForSymbol(minLot);
   }
   if(lot <= 0) { ReleaseOpenLock(); return; }

   double slMult = ImpulseZoneSL_ATRMult;
   double tpMult = MathMax(ImpulseZoneTP_ATRMult, 2.0);
   bool veryClose = (distLevel <= atr * 0.12);
   bool ok = false;

   if(!PatternDashedPreferLimit || veryClose)
   {
      // MARKET si collé à la ligne
      if(execDir > 0)
      {
         double entry = ask;
         double sl = NormalizeDouble(entry - atr * slMult, dg);
         double tp = NormalizeDouble(entry + atr * tpMult, dg);
         SMC_CapSLToMaxLossUSD(_Symbol, 1, entry, lot, sl);
         // v1.18b: pas de bypass GOM en market (WAIT interdit)
         if(CanPlaceOrderByGOM(_Symbol, 1, "PAT_LINE"))
            ok = SMC_GatedTradeBuy(lot, _Symbol, entry, sl, tp, "PAT_LINE BUY");
      }
      else
      {
         double entry = bid;
         double sl = NormalizeDouble(entry + atr * slMult, dg);
         double tp = NormalizeDouble(entry - atr * tpMult, dg);
         SMC_CapSLToMaxLossUSD(_Symbol, -1, entry, lot, sl);
         if(CanPlaceOrderByGOM(_Symbol, -1, "PAT_LINE"))
            ok = SMC_GatedTradeSell(lot, _Symbol, entry, sl, tp, "PAT_LINE SELL");
      }
      if(ok)
      {
         RegisterOrderPlaced();
         s_lastTry = TimeCurrent();
         Print("📌 PAT_LINE MARKET ", (execDir > 0 ? "BUY" : "SELL"), " ", _Symbol,
               " @level=", DoubleToString(level, dg), " src=", src, " vn=", vn);
      }
   }
   else
   {
      // LIMIT au prix de la ligne pointillée
      MqlTradeRequest req = {};
      MqlTradeResult  res = {};
      req.action = TRADE_ACTION_PENDING;
      req.symbol = _Symbol;
      req.volume = lot;
      req.magic  = InpMagicNumber;
      req.deviation = 30;
      double entry = NormalizeDouble(level, dg);
      if(execDir > 0)
      {
         if(entry >= ask) entry = NormalizeDouble(ask - atr * 0.05, dg);
         req.type  = ORDER_TYPE_BUY_LIMIT;
         req.price = entry;
         req.sl    = NormalizeDouble(entry - atr * slMult, dg);
         req.tp    = NormalizeDouble(entry + atr * tpMult, dg);
         req.comment = "PAT_LINE BUY " + StringSubstr(src, 0, 24);
         SMC_CapSLToMaxLossUSD(_Symbol, 1, entry, lot, req.sl);
      }
      else
      {
         if(entry <= bid) entry = NormalizeDouble(bid + atr * 0.05, dg);
         req.type  = ORDER_TYPE_SELL_LIMIT;
         req.price = entry;
         req.sl    = NormalizeDouble(entry + atr * slMult, dg);
         req.tp    = NormalizeDouble(entry - atr * tpMult, dg);
         req.comment = "PAT_LINE SELL " + StringSubstr(src, 0, 24);
         SMC_CapSLToMaxLossUSD(_Symbol, -1, entry, lot, req.sl);
      }
      if(ValidateAndAdjustLimitPrice(req.price, req.sl, req.tp, req.type))
      {
         if(trade.OrderSend(req, res) && (res.retcode == TRADE_RETCODE_DONE || res.retcode == TRADE_RETCODE_PLACED
             || res.retcode == TRADE_RETCODE_DONE_PARTIAL))
         {
            ok = true;
            s_lastTry = TimeCurrent();
            Print("📌 PAT_LINE LIMIT ", (execDir > 0 ? "BUY" : "SELL"), " ", _Symbol,
                  " @", DoubleToString(req.price, dg), " src=", src, " vn=", vn,
                  " | tirets Entry → ordre placé");
         }
         else
            Print("❌ PAT_LINE LIMIT fail ", res.retcode, " ", res.comment, " src=", src);
      }
   }
   ReleaseOpenLock();
   if(ok && UseNotifications)
   {
      Alert("📌 PAT_LINE ", (execDir > 0 ? "BUY" : "SELL"), " ", _Symbol);
      SendNotification("📌 PAT_LINE " + (execDir > 0 ? "BUY" : "SELL") + " " + _Symbol);
   }
}


void ExecuteBoomCrashSpikeMarketOrder();
void ExecuteSR20TouchMarketOrder();
void UpdatePreSpikeBounceState();     // PRE_SPIKE + rebond SR20/trendline DOW/EP DOW -> arme 2e spike
void ExecutePreSpikeBounceEntry();
