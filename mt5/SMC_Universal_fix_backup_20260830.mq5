//+------------------------------------------------------------------+
//| CALCUL OTE LOCAL — Fibonacci 62-79% depuis derniers swings       |
//+------------------------------------------------------------------+
void SMC_CalculateLocalOTE()
{
   double lastSH, lastSL;
   datetime lastSHTime, lastSLTime;
   GetLatestConfirmedSwings(lastSH, lastSHTime, lastSL, lastSLTime);
   
   if(lastSH > 0 && lastSL > 0 && lastSH > lastSL)
   {
      double range = lastSH - lastSL;
      double oteTop = lastSH - (range * 0.382); // 61.8% retracement
      double oteBottom = lastSH - (range * 0.618); // 78.6% retracement
      
      // Dessiner la zone OTE
      string oteName = "SMC_OTE_Zone";
      if(ObjectCreate(0, oteName, OBJ_RECTANGLE, 0, lastSLTime, oteBottom, TimeCurrent() + PeriodSeconds() * 30, oteTop))
      {
         ObjectSetInteger(0, oteName, OBJPROP_COLOR, clrGold);
         ObjectSetInteger(0, oteName, OBJPROP_FILL, true);
         ObjectSetInteger(0, oteName, OBJPROP_BACK, true);
         ObjectSetInteger(0, oteName, OBJPROP_STYLE, STYLE_DOT);
         ObjectSetInteger(0, oteName, OBJPROP_SELECTABLE, false);
      }
   }
}
//+------------------------------------------------------------------+
//| DÉTECTION CHoCH (Change of Character)                           |
//| Uptrend  : HH + HL → Failed HH → HL cassé = CHoCH SELL           |
//| Downtrend: LL + LH → Failed LL → LH cassé = CHoCH BUY            |
//+------------------------------------------------------------------+
void SMC_DetectCHoCH()
{
   if(swingPointCount < 4) return;

   // Récupérer les 4 derniers swings (SH, SL, SH, SL) en ordre chronologique
   double sw[4]; // sw[0]=SL récent, sw[1]=SH récent, sw[2]=SL avant, sw[3]=SH avant
   int swIdx[4];
   int found = 0;

   for(int i = swingPointCount - 1; i >= 0 && found < 4; i--)
   {
      if(swingPoints[i].isHigh)
      {
         if(found == 1) { sw[1] = swingPoints[i].price; swIdx[1] = i; found++; }
         else if(found == 3) { sw[3] = swingPoints[i].price; swIdx[3] = i; found++; }
      }
      else
      {
         if(found == 0) { sw[0] = swingPoints[i].price; swIdx[0] = i; found++; }
         else if(found == 2) { sw[2] = swingPoints[i].price; swIdx[2] = i; found++; }
      }
   }

   if(found < 4) return;

   // Déterminer la tendance actuelle basée sur les swings
   bool isUptrend = (sw[1] > sw[3] && sw[0] > sw[2]); // HH + HL
   bool isDowntrend = (sw[1] < sw[3] && sw[0] < sw[2]); // LL + LH

   if(isUptrend)
   {
      // CHoCH si SH le plus récent < SH avant (failed HH) ET SL le plus récent < SL avant (break HL)
      if(sw[1] < sw[3] && sw[0] < sw[2])
      {
         g_marketStructure = STRUCT_CHOCH_SELL;
         g_choChPrice = sw[2];
         g_choChTime = swingPoints[swIdx[0]].time;
         Print("[SMC-STRUCT] CHoCH SELL ", _Symbol, " failed HH=", sw[3], "->", sw[1], " break HL=", sw[0]);
         
         // Dessiner le CHoCH sur le graphique
         DrawCHOCHMarker(swingPoints[swIdx[0]].time, sw[0], false);
         return;
      }
      g_marketStructure = STRUCT_TREND_UP;
   }
   else if(isDowntrend)
   {
      // CHoCH si SL le plus récent > SL avant (failed LL) ET SH le plus récent > SH avant (break LH)
      if(sw[1] > sw[3] && sw[0] > sw[2])
      {
         g_marketStructure = STRUCT_CHOCH_BUY;
         g_choChPrice = sw[2];
         g_choChTime = swingPoints[swIdx[0]].time;
         Print("[SMC-STRUCT] CHoCH BUY ", _Symbol, " failed LL=", sw[3], "->", sw[1], " break LH=", sw[0]);
         
         // Dessiner le CHoCH sur le graphique
         DrawCHOCHMarker(swingPoints[swIdx[0]].time, sw[0], true);
         return;
      }
      g_marketStructure = STRUCT_TREND_DOWN;
   }
}

//+------------------------------------------------------------------+
//| Dessiner le marqueur CHoCH sur le graphique                       |
//+------------------------------------------------------------------+
void DrawCHOCHMarker(datetime time, double price, bool isBuy)
{
   string objName = "SMC_CHOCH_" + IntegerToString(time);
   color clr = isBuy ? clrLime : clrRed;
   string label = isBuy ? "CHoCH BUY" : "CHoCH SELL";
   
   if(ObjectCreate(0, objName, OBJ_ARROW, 0, time, price))
   {
      ObjectSetInteger(0, objName, OBJPROP_ARROWCODE, isBuy ? 233 : 234);
      ObjectSetInteger(0, objName, OBJPROP_COLOR, clr);
      ObjectSetInteger(0, objName, OBJPROP_WIDTH, 3);
      ObjectSetInteger(0, objName, OBJPROP_ANCHOR, isBuy ? ANCHOR_TOP : ANCHOR_BOTTOM);
      ObjectSetString(0, objName, OBJPROP_TEXT, label);
      ObjectSetInteger(0, objName, OBJPROP_FONTSIZE, 10);
      ObjectSetInteger(0, objName, OBJPROP_SELECTABLE, false);
   }
   
   // Dessiner la ligne de structure cassée
   string lineName = "SMC_CHOCH_Line_" + IntegerToString(time);
   if(ObjectCreate(0, lineName, OBJ_TREND, 0, time - PeriodSeconds()*10, price, time + PeriodSeconds()*20, price))
   {
      ObjectSetInteger(0, lineName, OBJPROP_COLOR, clr);
      ObjectSetInteger(0, lineName, OBJPROP_WIDTH, 2);
      ObjectSetInteger(0, lineName, OBJPROP_STYLE, STYLE_DASH);
      ObjectSetInteger(0, lineName, OBJPROP_RAY_RIGHT, false);
      ObjectSetInteger(0, lineName, OBJPROP_SELECTABLE, false);
   }
}
//+------------------------------------------------------------------+
//| DÉTECTION MSB (Market Structure Break)                          |
//| Après CHoCH SELL : price brise le dernier swing low (structure)   |
//| Après CHoCH BUY  : price brise le dernier swing high             |
//+------------------------------------------------------------------+
void SMC_DetectMSB()
{
   if(g_marketStructure != STRUCT_CHOCH_BUY && g_marketStructure != STRUCT_CHOCH_SELL)
   {
      g_msbPrice = 0;
      return;
   }
   if(g_msbPrice > 0) return;

   // Trouver le swing structurel à casser
   double target = 0;
   if(g_marketStructure == STRUCT_CHOCH_SELL)
   {
      // Casser le dernier swing low AVANT le CHoCH (le HL)
      for(int i = 0; i < swingPointCount; i++)
      {
         if(!swingPoints[i].isHigh && swingPoints[i].time < g_choChTime)
         {
            target = swingPoints[i].price;
            break;
         }
      }
      
      double currentLow = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      if(target > 0 && currentLow < target)
      {
         g_msbPrice = target;
         g_msbTime = TimeCurrent();
         g_marketStructure = STRUCT_TREND_DOWN;
         Print("[SMC-STRUCT] MSB SELL confirmé ", _Symbol, " break SL=", target);
         DrawMSBMarker(TimeCurrent(), target, false);
      }
   }
   else if(g_marketStructure == STRUCT_CHOCH_BUY)
   {
      // Casser le dernier swing high AVANT le CHoCH (le LH)
      for(int i = 0; i < swingPointCount; i++)
      {
         if(swingPoints[i].isHigh && swingPoints[i].time < g_choChTime)
         {
            target = swingPoints[i].price;
            break;
         }
      }
      
      double currentHigh = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      if(target > 0 && currentHigh > target)
      {
         g_msbPrice = target;
         g_msbTime = TimeCurrent();
         g_marketStructure = STRUCT_TREND_UP;
         Print("[SMC-STRUCT] MSB BUY confirmé ", _Symbol, " break SH=", target);
         DrawMSBMarker(TimeCurrent(), target, true);
      }
   }
}

//+------------------------------------------------------------------+
//| Dessiner le marqueur MSB sur le graphique                        |
//+------------------------------------------------------------------+
void DrawMSBMarker(datetime time, double price, bool isBuy)
{
   string objName = "SMC_MSB_" + IntegerToString(time);
   color clr = isBuy ? clrDodgerBlue : clrOrange;
   string label = isBuy ? "MSB BUY" : "MSB SELL";
   
   if(ObjectCreate(0, objName, OBJ_ARROW, 0, time, price))
   {
      ObjectSetInteger(0, objName, OBJPROP_ARROWCODE, isBuy ? 233 : 234);
      ObjectSetInteger(0, objName, OBJPROP_COLOR, clr);
      ObjectSetInteger(0, objName, OBJPROP_WIDTH, 3);
      ObjectSetInteger(0, objName, OBJPROP_ANCHOR, isBuy ? ANCHOR_TOP : ANCHOR_BOTTOM);
      ObjectSetString(0, objName, OBJPROP_TEXT, label);
      ObjectSetInteger(0, objName, OBJPROP_FONTSIZE, 10);
      ObjectSetInteger(0, objName, OBJPROP_SELECTABLE, false);
   }
}

//+------------------------------------------------------------------+
//| DÉTECTION BREAKER BLOCKS (Order Blocks ratés)                    |
//| Un OB cassé et retesté devient un Breaker                        |
//+------------------------------------------------------------------+
void SMC_DetectBreakerBlocks()
{
   // Nettoyer les anciens breakers (> 50 bougies)
   for(int i = 0; i < g_breakerBlockCount; i++)
   {
      if(!g_breakerBlocks[i].isValid) continue;
      
      int barsSince = (int)((TimeCurrent() - g_breakerBlocks[i].time) / PeriodSeconds());
      if(barsSince > 50)
      {
         g_breakerBlocks[i].isValid = false;
         ObjectDelete(0, "SMC_Breaker_" + IntegerToString(i));
      }
   }

   // Analyser les Order Blocks existants pour détecter ceux cassés
   // Note: Cette fonction devrait être appelée après la détection des OBs
   // Pour l'instant, on utilise une approche simplifiée basée sur les swings
   
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 100, rates) < 50) return;

   double currentPrice = rates[0].close;
   double atr = 0;
   int atrHandleLocal = iATR(_Symbol, PERIOD_M1, 14);
   if(atrHandleLocal != INVALID_HANDLE)
   {
      double atrBuf[];
      ArraySetAsSeries(atrBuf, true);
      if(CopyBuffer(atrHandleLocal, 0, 0, 1, atrBuf) > 0)
         atr = atrBuf[0];
   }

   // Chercher des zones OB potentielles basées sur les bougies fortes
   for(int i = 5; i < 30; i++)
   {
      double bodySize = MathAbs(rates[i].close - rates[i].open);
      double range = rates[i].high - rates[i].low;
      
      // Bougie impulsive (corps > 60% du range)
      if(bodySize > range * 0.6 && range > atr * 0.5)
      {
         bool isBullish = rates[i].close > rates[i].open;
         double obHigh = rates[i].high;
         double obLow = rates[i].low;
         
         // Vérifier si cette zone a été cassée par la suite
         bool wasBroken = false;
         for(int j = i - 1; j >= 0 && j > i - 10; j--)
         {
            if(isBullish && rates[j].low < obLow)
            {
               wasBroken = true;
               break;
            }
            if(!isBullish && rates[j].high > obHigh)
            {
               wasBroken = true;
               break;
            }
         }
         
         // Si cassé, vérifier si c'est un breaker (retest après cassure)
         if(wasBroken)
         {
            bool isRetested = false;
            for(int j = 0; j < i; j++)
            {
               if(isBullish && rates[j].close >= obLow && rates[j].close <= obHigh)
               {
                  isRetested = true;
                  break;
               }
               if(!isBullish && rates[j].close >= obLow && rates[j].close <= obHigh)
               {
                  isRetested = true;
                  break;
               }
            }
            
            if(isRetested)
            {
               // Ajouter comme Breaker Block
               if(g_breakerBlockCount < 20)
               {
                  g_breakerBlocks[g_breakerBlockCount].high = obHigh;
                  g_breakerBlocks[g_breakerBlockCount].low = obLow;
                  g_breakerBlocks[g_breakerBlockCount].time = rates[i].time;
                  g_breakerBlocks[g_breakerBlockCount].isBullish = isBullish;
                  g_breakerBlocks[g_breakerBlockCount].isValid = true;
                  g_breakerBlocks[g_breakerBlockCount].barIndex = i;
                  
                  DrawBreakerBlock(g_breakerBlockCount, obHigh, obLow, rates[i].time, isBullish);
                  g_breakerBlockCount++;
                  
                  Print("[SMC-BREAKER] Breaker détecté ", _Symbol, " ", isBullish ? "BULL" : "BEAR", 
                        " price=", obLow, "-", obHigh);
               }
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Dessiner un Breaker Block sur le graphique                       |
//+------------------------------------------------------------------+
void DrawBreakerBlock(int index, double high, double low, datetime time, bool isBullish)
{
   string objName = "SMC_Breaker_" + IntegerToString(index);
   color clr = isBullish ? clrPurple : clrMagenta;
   
   datetime endTime = time + PeriodSeconds() * 50;
   
   if(ObjectCreate(0, objName, OBJ_RECTANGLE, 0, time, low, endTime, high))
   {
      ObjectSetInteger(0, objName, OBJPROP_COLOR, clr);
      ObjectSetInteger(0, objName, OBJPROP_FILL, true);
      ObjectSetInteger(0, objName, OBJPROP_BACK, true);
      ObjectSetInteger(0, objName, OBJPROP_STYLE, STYLE_DOT);
      ObjectSetInteger(0, objName, OBJPROP_WIDTH, 1);
      ObjectSetInteger(0, objName, OBJPROP_SELECTABLE, false);
   }
   
   // Label
   string lblName = "SMC_Breaker_Lbl_" + IntegerToString(index);
   if(ObjectCreate(0, lblName, OBJ_TEXT, 0, time, high))
   {
      ObjectSetString(0, lblName, OBJPROP_TEXT, "BREAKER");
      ObjectSetInteger(0, lblName, OBJPROP_COLOR, clr);
      ObjectSetInteger(0, lblName, OBJPROP_FONTSIZE, 8);
      ObjectSetInteger(0, lblName, OBJPROP_SELECTABLE, false);
   }
}

//+------------------------------------------------------------------+
//| Vérifier si le prix est proche d'un Breaker Block                |
//+------------------------------------------------------------------+
bool IsPriceNearBreakerBlock(double price, int direction, double tolerance = 0.0)
{
   if(g_breakerBlockCount == 0) return false;
   
   if(tolerance == 0.0)
   {
      double atr = 0;
      int atrHandleLocal = iATR(_Symbol, PERIOD_M1, 14);
      if(atrHandleLocal != INVALID_HANDLE)
      {
         double atrBuf[];
         ArraySetAsSeries(atrBuf, true);
         if(CopyBuffer(atrHandleLocal, 0, 0, 1, atrBuf) > 0)
            atr = atrBuf[0];
      }
      tolerance = atr * 0.3; // 30% de l'ATR par défaut
   }
   
   for(int i = 0; i < g_breakerBlockCount; i++)
   {
      if(!g_breakerBlocks[i].isValid) continue;
      
      // Pour BUY: chercher breaker bearish (cassé vers le bas)
      if(direction == 1 && !g_breakerBlocks[i].isBullish)
      {
         if(price >= g_breakerBlocks[i].low - tolerance && 
            price <= g_breakerBlocks[i].high + tolerance)
         {
            Print("[BREAKER] Prix proche breaker BEAR pour BUY | Zone: ", 
                  g_breakerBlocks[i].low, " - ", g_breakerBlocks[i].high);
            return true;
         }
      }
      // Pour SELL: chercher breaker bullish (cassé vers le haut)
      else if(direction == -1 && g_breakerBlocks[i].isBullish)
      {
         if(price >= g_breakerBlocks[i].low - tolerance && 
            price <= g_breakerBlocks[i].high + tolerance)
         {
            Print("[BREAKER] Prix proche breaker BULL pour SELL | Zone: ", 
                  g_breakerBlocks[i].low, " - ", g_breakerBlocks[i].high);
            return true;
         }
      }
   }
   return false;
}

//+------------------------------------------------------------------+
//| Vérifier si le prix est proche d'un Displacement FVG             |
//+------------------------------------------------------------------+
bool IsPriceNearDisplacementFVG(double price, int direction, double tolerance = 0.0)
{
   if(g_dispFVGCount == 0) return false;
   
   if(tolerance == 0.0)
   {
      double atr = 0;
      int atrHandleLocal = iATR(_Symbol, PERIOD_M1, 14);
      if(atrHandleLocal != INVALID_HANDLE)
      {
         double atrBuf[];
         ArraySetAsSeries(atrBuf, true);
         if(CopyBuffer(atrHandleLocal, 0, 0, 1, atrBuf) > 0)
            atr = atrBuf[0];
      }
      tolerance = atr * 0.4; // 40% de l'ATR par défaut
   }
   
   for(int i = 0; i < g_dispFVGCount; i++)
   {
      if(!g_dispFVGs[i].isValid) continue;
      
      // Pour BUY: chercher FVG bullish (gap vers le haut)
      if(direction == 1 && g_dispFVGs[i].isBullish)
      {
         if(price >= g_dispFVGs[i].bottom - tolerance && 
            price <= g_dispFVGs[i].top + tolerance)
         {
            Print("[DISP FVG] Prix proche FVG BULL pour BUY | Zone: ", 
                  g_dispFVGs[i].bottom, " - ", g_dispFVGs[i].top);
            return true;
         }
      }
      // Pour SELL: chercher FVG bearish (gap vers le bas)
      else if(direction == -1 && !g_dispFVGs[i].isBullish)
      {
         if(price >= g_dispFVGs[i].bottom - tolerance && 
            price <= g_dispFVGs[i].top + tolerance)
         {
            Print("[DISP FVG] Prix proche FVG BEAR pour SELL | Zone: ", 
                  g_dispFVGs[i].bottom, " - ", g_dispFVGs[i].top);
            return true;
         }
      }
   }
   return false;
}

//+------------------------------------------------------------------+
//| DÉTECTION EQUAL HIGHS / EQUAL LOWS (Liquidity Pools)            |
//| Doubles/triples tops et bottoms non balayés                      |
//+------------------------------------------------------------------+
void SMC_DetectEqualLevels()
{
   // Nettoyer les anciens niveaux (> 100 bougies)
   for(int i = 0; i < g_equalLevelCount; i++)
   {
      int barsSince = (int)((TimeCurrent() - g_equalLevels[i].time2) / PeriodSeconds());
      if(barsSince > 100)
      {
         ObjectDelete(0, "SMC_EQ_" + IntegerToString(i));
         ObjectDelete(0, "SMC_EQ_Lbl_" + IntegerToString(i));
         
         // Décaler le tableau
         for(int j = i; j < g_equalLevelCount - 1; j++)
            g_equalLevels[j] = g_equalLevels[j + 1];
         g_equalLevelCount--;
         i--;
      }
   }

   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 200, rates) < 100) return;

   double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   double tolerance = tickSize * 10; // Tolérance de 10 pips

   // Analyser les swing points pour trouver des niveaux égaux
   for(int i = 0; i < swingPointCount - 1; i++)
   {
      for(int j = i + 1; j < swingPointCount; j++)
      {
         // Même type (high avec high, low avec low)
         if(swingPoints[i].isHigh == swingPoints[j].isHigh)
         {
            double priceDiff = MathAbs(swingPoints[i].price - swingPoints[j].price);
            
            // Prix égaux (dans la tolérance)
            if(priceDiff < tolerance)
            {
               // Vérifier si ce niveau n'est pas déjà enregistré
               bool alreadyExists = false;
               for(int k = 0; k < g_equalLevelCount; k++)
               {
                  if(MathAbs(g_equalLevels[k].price - swingPoints[i].price) < tolerance &&
                      g_equalLevels[k].isHigh == swingPoints[i].isHigh)
                  {
                     alreadyExists = true;
                     // Incrémenter le compteur
                     g_equalLevels[k].count++;
                     g_equalLevels[k].time2 = swingPoints[j].time;
                     break;
                  }
               }
               
               if(!alreadyExists && g_equalLevelCount < 30)
               {
                  g_equalLevels[g_equalLevelCount].price = swingPoints[i].price;
                  g_equalLevels[g_equalLevelCount].time1 = swingPoints[i].time;
                  g_equalLevels[g_equalLevelCount].time2 = swingPoints[j].time;
                  g_equalLevels[g_equalLevelCount].isHigh = swingPoints[i].isHigh;
                  g_equalLevels[g_equalLevelCount].count = 2;
                  
                  DrawEqualLevel(g_equalLevelCount, swingPoints[i].price, 
                                 swingPoints[i].isHigh);
                  g_equalLevelCount++;
                  
                  Print("[SMC-EQUAL] ", swingPoints[i].isHigh ? "EQH" : "EQL", 
                        " détecté ", _Symbol, " price=", swingPoints[i].price);
               }
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Dessiner un Equal High/Low sur le graphique                      |
//+------------------------------------------------------------------+
void DrawEqualLevel(int index, double price, bool isHigh)
{
   string objName = "SMC_EQ_" + IntegerToString(index);
   color clr = isHigh ? clrOrangeRed : clrDodgerBlue;
   string label = isHigh ? "EQH" : "EQL";
   
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   CopyRates(_Symbol, PERIOD_M1, 0, 200, rates);
   
   datetime startTime = rates[199].time;
   datetime endTime = TimeCurrent() + PeriodSeconds() * 30;
   
   if(ObjectCreate(0, objName, OBJ_HLINE, 0, startTime, price))
   {
      ObjectSetInteger(0, objName, OBJPROP_COLOR, clr);
      ObjectSetInteger(0, objName, OBJPROP_WIDTH, 2);
      ObjectSetInteger(0, objName, OBJPROP_STYLE, STYLE_DOT);
      ObjectSetInteger(0, objName, OBJPROP_SELECTABLE, false);
   }
   
   // Label
   string lblName = "SMC_EQ_Lbl_" + IntegerToString(index);
   if(ObjectCreate(0, lblName, OBJ_TEXT, 0, endTime, price))
   {
      ObjectSetString(0, lblName, OBJPROP_TEXT, label);
      ObjectSetInteger(0, lblName, OBJPROP_COLOR, clr);
      ObjectSetInteger(0, lblName, OBJPROP_FONTSIZE, 9);
      ObjectSetInteger(0, lblName, OBJPROP_ANCHOR, isHigh ? ANCHOR_LOWER : ANCHOR_UPPER);
      ObjectSetInteger(0, lblName, OBJPROP_SELECTABLE, false);
   }
}

//+------------------------------------------------------------------+
//| FILTRAGE DISPLACEMENT FVG                                        |
//| Marquer les FVG créés par des bougies impulsives fortes           |
//+------------------------------------------------------------------+
bool IsDisplacementCandle(int barIndex, double atrMultiplier = 1.5)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, barIndex + 5, rates) < barIndex + 3) return false;
   
   double bodySize = MathAbs(rates[barIndex].close - rates[barIndex].open);
   double range = rates[barIndex].high - rates[barIndex].low;
   
   // Calculer l'ATR
   double atr = 0;
   int atrHandleLocal = iATR(_Symbol, PERIOD_M1, 14);
   if(atrHandleLocal != INVALID_HANDLE)
   {
      double atrBuf[];
      ArraySetAsSeries(atrBuf, true);
      if(CopyBuffer(atrHandleLocal, 0, 0, 15, atrBuf) > 0)
         atr = atrBuf[0];
   }
   
   if(atr == 0) return false;
   
   // Critères de displacement:
   // 1. Corps > 60% du range
   // 2. Range > ATR * atrMultiplier
   // 3. Bougie de tendance (close dans le sens du corps)
   bool isImpulsive = (bodySize > range * 0.6) && (range > atr * atrMultiplier);
   bool isTrending = (rates[barIndex].close > rates[barIndex].open && rates[barIndex].close > rates[barIndex + 1].close) ||
                      (rates[barIndex].close < rates[barIndex].open && rates[barIndex].close < rates[barIndex + 1].close);
   
   return isImpulsive && isTrending;
}

//+------------------------------------------------------------------+
//| Marquer les FVG de displacement avec une couleur spéciale        |
//+------------------------------------------------------------------+
void MarkDisplacementFVGs()
{
   // Nettoyer les anciens FVGs (> 50 bougies)
   for(int i = 0; i < g_dispFVGCount; i++)
   {
      if(!g_dispFVGs[i].isValid) continue;
      
      int barsSince = (int)((TimeCurrent() - g_dispFVGs[i].time) / PeriodSeconds());
      if(barsSince > 50)
      {
         g_dispFVGs[i].isValid = false;
         ObjectDelete(0, "SMC_DispFVG_" + IntegerToString(i));
         ObjectDelete(0, "SMC_DispFVG_Lbl_" + IntegerToString(i));
      }
   }
   
   // Nettoyer les anciens marqueurs graphiques
   ObjectsDeleteAll(0, "SMC_DispFVG_");
   
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 100, rates) < 50) return;
   
   // Chercher des FVGs potentiels créés par des displacement candles
   for(int i = 3; i < 40; i++)
   {
      if(IsDisplacementCandle(i, 1.5))
      {
         // Vérifier si cette bougie a créé un FVG
         bool isBullishFVG = (rates[i].close > rates[i + 2].high);
         bool isBearishFVG = (rates[i].close < rates[i + 2].low);
         
         if(isBullishFVG || isBearishFVG)
         {
            double fvgTop = rates[i + 2].high;
            double fvgBottom = rates[i + 2].low;
            
            if(isBullishFVG)
            {
               // Bullish FVG: gap entre le candle et le candle 2 bars avant
               fvgBottom = rates[i + 2].high;
               fvgTop = rates[i].low;
            }
            else if(isBearishFVG)
            {
               // Bearish FVG
               fvgTop = rates[i + 2].low;
               fvgBottom = rates[i].high;
            }
            
            // Stocker dans le tableau global
            if(g_dispFVGCount < 30)
            {
               g_dispFVGs[g_dispFVGCount].top = fvgTop;
               g_dispFVGs[g_dispFVGCount].bottom = fvgBottom;
               g_dispFVGs[g_dispFVGCount].time = rates[i].time;
               g_dispFVGs[g_dispFVGCount].isBullish = isBullishFVG;
               g_dispFVGs[g_dispFVGCount].isValid = true;
               g_dispFVGs[g_dispFVGCount].barIndex = i;
               
               // Dessiner sur le graphique
               string objName = "SMC_DispFVG_" + IntegerToString(g_dispFVGCount);
               color clr = isBullishFVG ? clrLime : clrRed;
               
               datetime endTime = TimeCurrent() + PeriodSeconds() * 30;
               
               if(ObjectCreate(0, objName, OBJ_RECTANGLE, 0, rates[i].time, fvgBottom, endTime, fvgTop))
               {
                  ObjectSetInteger(0, objName, OBJPROP_COLOR, clr);
                  ObjectSetInteger(0, objName, OBJPROP_FILL, true);
                  ObjectSetInteger(0, objName, OBJPROP_BACK, true);
                  ObjectSetInteger(0, objName, OBJPROP_STYLE, STYLE_SOLID);
                  ObjectSetInteger(0, objName, OBJPROP_WIDTH, 2);
                  ObjectSetInteger(0, objName, OBJPROP_SELECTABLE, false);
               }
               
               // Label
               string lblName = "SMC_DispFVG_Lbl_" + IntegerToString(g_dispFVGCount);
               if(ObjectCreate(0, lblName, OBJ_TEXT, 0, rates[i].time, isBullishFVG ? fvgTop : fvgBottom))
               {
                  ObjectSetString(0, lblName, OBJPROP_TEXT, "DISP FVG");
                  ObjectSetInteger(0, lblName, OBJPROP_COLOR, clr);
                  ObjectSetInteger(0, lblName, OBJPROP_FONTSIZE, 8);
                  ObjectSetInteger(0, lblName, OBJPROP_SELECTABLE, false);
               }
               
               Print("[SMC-DISPLACEMENT] FVG de displacement détecté ", _Symbol, " ", 
                     isBullishFVG ? "BULL" : "BEAR");
               
               g_dispFVGCount++;
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| DISP FVG TRAIL — relie bords inf (bear) / sup (bull)              |
//| Objectif: éviter entrées fausses, détecter correction, invalider   |
//| structure si cassure.                                            |
//+------------------------------------------------------------------+
void SMC_UpdateDispFVGTrail()
{
   g_dispTrailValid   = false;
   g_dispTrailBroken  = false;
   g_dispInCorrection = false;
   g_dispTrailLevel   = 0;
   g_dispTrailSlope   = 0;
   g_dispTrailDir     = 0;

   // Corrigé: supprimer TOUJOURS les objets de tracé AVANT tout retour anticipé,
   // sinon le trail restait affiché (lignes fantômes) quand il redevenait invalide
   // (pas assez de FVG, règression dégénérée, FVG trop vieux, etc.).
   string lineName = "SMC_DISP_TRAIL_" + _Symbol;
   string lblName  = "SMC_DISP_TRAIL_LBL_" + _Symbol;
   ObjectDelete(0, lineName);
   ObjectDelete(0, lblName);

   if(!UseDispFVGTrail) return;
   if(g_dispFVGCount < DispFVGTrailMinGaps) return;

   // Compter FVG bear / bull valides récents
   datetime tBear[], tBull[];
   double   pBear[], pBull[];
   ArrayResize(tBear, 0); ArrayResize(tBull, 0);
   ArrayResize(pBear, 0); ArrayResize(pBull, 0);

   for(int i = 0; i < g_dispFVGCount; i++)
   {
      if(!g_dispFVGs[i].isValid) continue;
      int bars = (int)((TimeCurrent() - g_dispFVGs[i].time) / MathMax(1, PeriodSeconds()));
      if(bars > 80) continue; // trop vieux
      if(g_dispFVGs[i].isBullish)
      {
         int n = ArraySize(tBull);
         ArrayResize(tBull, n + 1); ArrayResize(pBull, n + 1);
         tBull[n] = g_dispFVGs[i].time;
         pBull[n] = g_dispFVGs[i].top; // bord supérieur des FVG haussiers
      }
      else
      {
         int n = ArraySize(tBear);
         ArrayResize(tBear, n + 1); ArrayResize(pBear, n + 1);
         tBear[n] = g_dispFVGs[i].time;
         pBear[n] = g_dispFVGs[i].bottom; // bord inférieur des FVG baissiers
      }
   }

   // Choisir le sens dominant (plus de FVG = trail prioritaire)
   bool useBear = (ArraySize(tBear) >= DispFVGTrailMinGaps);
   bool useBull = (ArraySize(tBull) >= DispFVGTrailMinGaps);
   if(!useBear && !useBull) return;
   if(useBear && useBull)
   {
      // sens GOM / TF si dispo, sinon majority count
      if(g_smcGomVerdictNum < 0) useBull = false;
      else if(g_smcGomVerdictNum > 0) useBear = false;
      else if(ArraySize(tBear) >= ArraySize(tBull)) useBull = false;
      else useBear = false;
   }

   datetime tArr[];
   double   pArr[];
   int trailDir = 0;
   if(useBear)
   {
      ArrayCopy(tArr, tBear); ArrayCopy(pArr, pBear);
      trailDir = -1;
   }
   else
   {
      ArrayCopy(tArr, tBull); ArrayCopy(pArr, pBull);
      trailDir = 1;
   }
   int n = ArraySize(tArr);
   if(n < DispFVGTrailMinGaps) return;

   // Trier chronologique (bubble simple, n petit)
   for(int a = 0; a < n - 1; a++)
      for(int b = a + 1; b < n; b++)
         if(tArr[b] < tArr[a])
         {
            datetime tt = tArr[a]; tArr[a] = tArr[b]; tArr[b] = tt;
            double pp = pArr[a]; pArr[a] = pArr[b]; pArr[b] = pp;
         }

   // Régression linéaire simple temps → prix (au moins 2 points)
   double sumT = 0, sumP = 0, sumTT = 0, sumTP = 0;
   for(int i = 0; i < n; i++)
   {
      double ti = (double)tArr[i];
      sumT += ti; sumP += pArr[i];
      sumTT += ti * ti; sumTP += ti * pArr[i];
   }
   double den = n * sumTT - sumT * sumT;
   if(MathAbs(den) < 1.0) return;
   double slope = (n * sumTP - sumT * sumP) / den;
   double intercept = (sumP - slope * sumT) / n;

   datetime now = TimeCurrent();
   double level = intercept + slope * (double)now;

   g_dispTrailDir   = trailDir;
   g_dispTrailSlope = slope;
   g_dispTrailLevel = level;
   g_dispTrailValid = true;
   g_dispTrailT1    = tArr[0];
   g_dispTrailP1    = pArr[0];
   g_dispTrailT2    = tArr[n - 1];
   g_dispTrailP2    = pArr[n - 1];

   // ATR pour seuils
   double atr = 0;
   int atrH = iATR(_Symbol, PERIOD_CURRENT, 14);
   if(atrH != INVALID_HANDLE)
   {
      double ab[]; ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrH, 0, 0, 1, ab) >= 1) atr = ab[0];
   }
   if(atr <= 0) atr = _Point * 50;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   if(bid <= 0) return;

   // Cassure structure: prix nettement de l'autre côté du trail
   if(trailDir < 0)
   {
      // Bear trail (bottoms): cassure = clôture/bid nettement AU-DESSUS
      g_dispTrailBroken  = (bid > level + atr * DispFVGTrailBreakATR);
      // Correction = prix au-dessus du trail mais pas encore cassé (pullback)
      g_dispInCorrection = (!g_dispTrailBroken && bid > level + atr * DispFVGTrailCorrATR);
   }
   else
   {
      g_dispTrailBroken  = (bid < level - atr * DispFVGTrailBreakATR);
      g_dispInCorrection = (!g_dispTrailBroken && bid < level - atr * DispFVGTrailCorrATR);
   }

   // Dessin — régression linéaire (pas le 1er point FVG brut)
   if(DispFVGTrailDraw)
   {
      datetime tStart = tArr[0];
      datetime tEnd = now + PeriodSeconds() * 40;
      double pStart = intercept + slope * (double)tStart;
      double pEnd = intercept + slope * (double)tEnd;
      color clr = g_dispTrailBroken ? clrSilver
                 : (g_dispInCorrection ? clrOrange
                 : (trailDir < 0 ? clrOrangeRed : clrLime));
      if(ObjectCreate(0, lineName, OBJ_TREND, 0, tStart, pStart, tEnd, pEnd))
      {
         ObjectSetInteger(0, lineName, OBJPROP_COLOR, clr);
         ObjectSetInteger(0, lineName, OBJPROP_WIDTH, 2);
         ObjectSetInteger(0, lineName, OBJPROP_STYLE, g_dispTrailBroken ? STYLE_DOT : STYLE_SOLID);
         ObjectSetInteger(0, lineName, OBJPROP_RAY_RIGHT, false);
         ObjectSetInteger(0, lineName, OBJPROP_SELECTABLE, false);
         ObjectSetInteger(0, lineName, OBJPROP_BACK, false);
      }
      string tag = trailDir < 0 ? "DISP TRAIL BEAR" : "DISP TRAIL BULL";
      if(g_dispTrailBroken) tag += " BROKEN";
      else if(g_dispInCorrection) tag += " CORR";
      else tag += " OK";
      if(ObjectCreate(0, lblName, OBJ_TEXT, 0, tEnd, pEnd))
      {
         ObjectSetString(0, lblName, OBJPROP_TEXT, tag);
         ObjectSetInteger(0, lblName, OBJPROP_COLOR, clr);
         ObjectSetInteger(0, lblName, OBJPROP_FONTSIZE, 8);
         ObjectSetInteger(0, lblName, OBJPROP_SELECTABLE, false);
      }
   }
}

// true = entrée autorisée selon trail DISP FVG
bool SMC_DispFVGTrailAllowsEntry(const int dirSign, string &reasonOut)
{
   reasonOut = "no trail";
   if(!UseDispFVGTrail || !DispFVGTrailBlockEntries) return true;
   if(!g_dispTrailValid) return true; // pas assez de FVG → ne pas bloquer

   // Trail bear + SELL
   if(dirSign < 0)
   {
      if(g_dispTrailDir > 0)
      {
         // Trail haussier dominant: SELL contre structure → bloquer sauf GOM PERFECT
         if(!(g_smcGomConnected && g_smcGomVerdictNum <= -3))
         {
            reasonOut = "DISP trail BULL dominant — SELL contre structure";
            return false;
         }
      }
      if(g_dispTrailBroken)
      {
         reasonOut = "DISP trail BEAR cassé (prix au-dessus) — pas de SELL";
         return false;
      }
      if(g_dispInCorrection)
      {
         // Correction: autoriser seulement LIMIT proches / retest, pas market agressif
         // On bloque le market "force" mais on laisse un soft si GOM PERFECT
         if(!(g_smcGomConnected && MathAbs(g_smcGomVerdictNum) >= 3))
         {
            reasonOut = "DISP trail BEAR en CORRECTION — attendre retest / fin corr";
            return false;
         }
      }
      reasonOut = "DISP trail BEAR OK";
      return true;
   }

   // Trail bull + BUY
   if(dirSign > 0)
   {
      if(g_dispTrailDir < 0)
      {
         if(!(g_smcGomConnected && g_smcGomVerdictNum >= 3))
         {
            reasonOut = "DISP trail BEAR dominant — BUY contre structure";
            return false;
         }
      }
      if(g_dispTrailBroken)
      {
         reasonOut = "DISP trail BULL cassé (prix en-dessous) — pas de BUY";
         return false;
      }
      if(g_dispInCorrection)
      {
         if(!(g_smcGomConnected && MathAbs(g_smcGomVerdictNum) >= 3))
         {
            reasonOut = "DISP trail BULL en CORRECTION — attendre retest / fin corr";
            return false;
         }
      }
      reasonOut = "DISP trail BULL OK";
      return true;
   }
   return true;
}

//+------------------------------------------------------------------+
//| Détection de croisement GOM_TF_TL + SMC_DISP_TRAIL                |
//| Croisement vers le haut = BUY long terme                         |
//| Croisement vers le bas = SELL long terme                         |
//+------------------------------------------------------------------+
void SMC_DetectGomDispCrossing()
{
   if(!g_dispTrailValid) return;
   if(!g_smcGomConnected) return;
   
   // Utiliser H1 comme timeframe principal pour GOM_TF_TL
   string h1Dir = g_smcTfH1Dir;
   if(StringLen(h1Dir) < 2) return;
   
   bool h1Bull = (h1Dir == "BULL");
   bool h1Bear = (h1Dir == "BEAR");
   
   // Trail DISP FVG direction
   int trailDir = g_dispTrailDir; // +1 bull, -1 bear
   if(trailDir == 0) return;
   
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   if(bid <= 0) return;
   
   // Détection de croisement
   bool crossBuy = false;
   bool crossSell = false;
   
   // Croisement vers le haut: GOM_TF_TL devient BULL et croise au-dessus de DISP trail
   if(h1Bull && trailDir < 0 && bid > g_dispTrailLevel)
   {
      crossBuy = true;
   }
   // Croisement vers le bas: GOM_TF_TL devient BEAR et croise en-dessous de DISP trail  
   else if(h1Bear && trailDir > 0 && bid < g_dispTrailLevel)
   {
      crossSell = true;
   }
   
   // Mise à jour des états avec anti-flicker (min 30 secondes entre croisements)
   datetime now = TimeCurrent();
   if(crossBuy && (now - g_gomDispCrossTime > 30))
   {
      g_gomDispCrossBuy = true;
      g_gomDispCrossSell = false;
      g_gomDispCrossTime = now;
      g_gomDispCrossPrice = bid;
      Print("🔼 CROISEMENT GOM_TF_TL + DISP_TRAIL vers le HAUT | H1=", h1Dir, 
            " TRAIL=", (trailDir > 0 ? "BULL" : "BEAR"), 
            " @", DoubleToString(bid, _Digits));
   }
   else if(crossSell && (now - g_gomDispCrossTime > 30))
   {
      g_gomDispCrossSell = true;
      g_gomDispCrossBuy = false;
      g_gomDispCrossTime = now;
      g_gomDispCrossPrice = bid;
      Print("🔽 CROISEMENT GOM_TF_TL + DISP_TRAIL vers le BAS | H1=", h1Dir,
            " TRAIL=", (trailDir > 0 ? "BULL" : "BEAR"),
            " @", DoubleToString(bid, _Digits));
   }
}

//+------------------------------------------------------------------+
//| Entrée basée sur croisement GOM_TF_TL + SMC_DISP_TRAIL             |
//| Exécute un trade quand un croisement est détecté                  |
//+------------------------------------------------------------------+
void SMC_ExecuteGomDispCrossEntry()
{
   if(!UseGOMDispCrossEntry) return;
   if(BlockAllTrades) return;
   
   // Vérifier si un croisement récent est disponible
   if(!g_gomDispCrossBuy && !g_gomDispCrossSell) return;
   
   // Vérifier l'âge du croisement (max 60 secondes pour entrée)
   datetime now = TimeCurrent();
   if(now - g_gomDispCrossTime > 60) return;
   
   // Déterminer la direction
   int dirSign = g_gomDispCrossBuy ? 1 : -1;
   
   // Vérifier les restrictions de symbole
   if(IsBoomLikeSymbol(_Symbol) && dirSign < 0) return;
   if(IsCrashLikeSymbol(_Symbol) && dirSign > 0) return;
   
   // Vérifier GOM verdict si filtre activé
   if(UseGOMVerdictFilter)
   {
      if(!g_smcGomConnected || g_smcGomVerdictNum == 0) return;
      if(dirSign > 0 && g_smcGomVerdictNum < MinGOMVerdictNumAbs) return;
      if(dirSign < 0 && g_smcGomVerdictNum > -MinGOMVerdictNumAbs) return;
   }
   
   // Calculer le lot
   double lot = CalculateLotSize();
   if(lot <= 0) return;
   
   // Calculer SL/TP
   double atr = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[]; ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atr = ab[0];
   }
   if(atr <= 0)
   {
      int h = iATR(_Symbol, PERIOD_CURRENT, 14);
      if(h != INVALID_HANDLE)
      {
         double ab[]; ArraySetAsSeries(ab, true);
         if(CopyBuffer(h, 0, 0, 1, ab) >= 1) atr = ab[0];
         IndicatorRelease(h);
      }
   }
   if(atr <= 0) atr = _Point * 50;
   
   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double entry = (dirSign > 0) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) 
                                  : SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double sl = (dirSign > 0) ? entry - atr * GomDispCrossSL_ATRMult 
                              : entry + atr * GomDispCrossSL_ATRMult;
   double tp = (dirSign > 0) ? entry + atr * GomDispCrossTP_ATRMult 
                              : entry - atr * GomDispCrossTP_ATRMult;
   
   // Cap SL au max loss
   SMC_CapSLToMaxLossUSD(_Symbol, 1, entry, lot, sl);
   
   // Exécuter le trade
   bool ok = false;
   string reason = "GOM-DISP CROSS " + (dirSign > 0 ? "BUY" : "SELL");
   
   if(dirSign > 0)
      ok = SMC_GatedTradeBuy(lot, _Symbol, entry, sl, tp, reason);
   else
      ok = SMC_GatedTradeSell(lot, _Symbol, entry, sl, tp, reason);
   
   if(ok)
   {
      Print("🚀 GOM-DISP CROSS ENTRY ", (dirSign > 0 ? "BUY" : "SELL"), " ", _Symbol,
            " @", DoubleToString(entry, dg), 
            " SL=", DoubleToString(sl, dg), 
            " TP=", DoubleToString(tp, dg),
            " H1=", g_smcTfH1Dir,
            " TRAIL=", (g_dispTrailDir > 0 ? "BULL" : "BEAR"));
      
      // Réinitialiser le signal pour éviter les entrées multiples
      g_gomDispCrossBuy = false;
      g_gomDispCrossSell = false;
   }
}

//+------------------------------------------------------------------+
//| LIMIT au prochain DISP FVG, guidé par SMC_DISP_TRAIL               |
//| Bear trail → SELL LIMIT sur FVG baissier au-dessus (retest)        |
//| Bull trail → BUY LIMIT  sur FVG haussier en-dessous (retest)       |
//| Fallback: niveau trail projeté si aucun FVG "prochain" clair.      |
//+------------------------------------------------------------------+
void PlaceDispFVGTrailLimitOrders()
{
   if(!UseDispFVGTrail || !UseDispFVGTrailLimits) return;
   if(BlockAllTrades) return;
   if(!g_dispTrailValid || g_dispTrailBroken) return;
   if(g_dispFVGCount <= 0) return;
   if(g_dispTrailSlope == 0 && g_dispTrailLevel <= 0) return;

   int trailDir = g_dispTrailDir; // -1 bear, +1 bull
   if(trailDir == 0) return;
   if(IsBoomLikeSymbol(_Symbol) && trailDir < 0) return;
   if(IsCrashLikeSymbol(_Symbol) && trailDir > 0) return;

   if(UseGOMVerdictFilter)
   {
      if(!g_smcGomConnected || g_smcGomVerdictNum == 0) return;
      if(trailDir > 0 && g_smcGomVerdictNum < MinGOMVerdictNumAbs) return;
      if(trailDir < 0 && g_smcGomVerdictNum > -MinGOMVerdictNumAbs) return;
      // GOOD SELL ⇒ jamais BUY LIMIT (et inverse)
      if(trailDir > 0 && g_smcGomVerdictNum < 0) return;
      if(trailDir < 0 && g_smcGomVerdictNum > 0) return;
   }
   if(!CanPlaceOrderByGOM(_Symbol, trailDir, "LIMIT")) return;
   if(!SMC_ScalpAllowLimitAgainstTf(trailDir)) return;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if(bid <= 0 || ask <= 0) return;

   double atr = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[]; ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atr = ab[0];
   }
   if(atr <= 0)
   {
      int h = iATR(_Symbol, PERIOD_CURRENT, 14);
      if(h != INVALID_HANDLE)
      {
         double ab[]; ArraySetAsSeries(ab, true);
         if(CopyBuffer(h, 0, 0, 1, ab) >= 1) atr = ab[0];
      }
   }
   if(atr <= 0) atr = _Point * 50;

   double minDist = atr * DispFVGLimitMinDistATR;
   double maxDist = atr * DispFVGLimitMaxDistATR;
   datetime now = TimeCurrent();

   // Trail: P(t) = g_dispTrailLevel + slope * (t - now)
   // (g_dispTrailLevel est déjà projeté à "now" dans SMC_UpdateDispFVGTrail)

   // Jointure = clamp( trail@FVG , FVG.bottom, FVG.top )
   // = intersection du segment trail avec le rectangle DISP FVG
   double bestLimit = 0;
   double bestFvgTop = 0, bestFvgBot = 0;
   datetime bestTime = 0;
   double bestScore = 1e100; // plus petit = mieux
   double bestTrailAt = 0;

   for(int i = 0; i < g_dispFVGCount; i++)
   {
      if(!g_dispFVGs[i].isValid) continue;
      // Même sens que le trail
      if(trailDir < 0 && g_dispFVGs[i].isBullish) continue;
      if(trailDir > 0 && !g_dispFVGs[i].isBullish) continue;

      int bars = (int)((now - g_dispFVGs[i].time) / MathMax(1, PeriodSeconds()));
      if(bars > 80) continue;

      double fTop = g_dispFVGs[i].top;
      double fBot = g_dispFVGs[i].bottom;
      if(fTop <= fBot) continue;

      // Projection trail au moment du FVG (et aussi "maintenant" pour retest courant)
      double trailAtFvg = g_dispTrailLevel + g_dispTrailSlope * (double)(g_dispFVGs[i].time - now);
      double trailNow   = g_dispTrailLevel;

      // Jointure = intersection trail ∩ rectangle FVG
      double tn = trailNow;
      if(tn > fTop) tn = fTop;
      if(tn < fBot) tn = fBot;
      double joint = tn;
      if(trailAtFvg >= fBot && trailAtFvg <= fTop)
         joint = 0.55 * tn + 0.45 * trailAtFvg;

      // Le LIMIT doit encore être atteignable (retest)
      // SELL LIMIT: jointure AU-DESSUS du prix (prix doit monter pour fill)
      // BUY LIMIT : jointure EN-DESSOUS du prix
      if(trailDir < 0)
      {
         if(joint <= ask + minDist) continue;
         if(joint - ask > maxDist) continue;
      }
      else
      {
         if(joint >= bid - minDist) continue;
         if(bid - joint > maxDist) continue;
      }

      // Score: distance au prix + pénalité si jointure collée au bord sans trail dedans
      double dist = (trailDir < 0) ? (joint - ask) : (bid - joint);
      double trailInside = (trailNow >= fBot - atr * 0.05 && trailNow <= fTop + atr * 0.05) ? 0.0 : atr * 0.15;
      // Préférer FVG récents
      double agePen = bars * atr * 0.002;
      double score = dist + trailInside + agePen;

      if(score < bestScore)
      {
         bestScore = score;
         bestLimit = joint;
         bestFvgTop = fTop;
         bestFvgBot = fBot;
         bestTime = g_dispFVGs[i].time;
         bestTrailAt = trailNow;
      }
   }

   // Fallback: jointure trail@now si un FVG dominant existe près du trail
   if(bestLimit <= 0 && g_dispTrailLevel > 0)
   {
      // Chercher FVG dont la zone contient ou touche le trail
      for(int i = 0; i < g_dispFVGCount; i++)
      {
         if(!g_dispFVGs[i].isValid) continue;
         if(trailDir < 0 && g_dispFVGs[i].isBullish) continue;
         if(trailDir > 0 && !g_dispFVGs[i].isBullish) continue;
         double fTop = g_dispFVGs[i].top;
         double fBot = g_dispFVGs[i].bottom;
         double tn = g_dispTrailLevel;
         if(tn > fTop + atr * 0.5 || tn < fBot - atr * 0.5) continue;
         double joint = tn;
         if(joint > fTop) joint = fTop;
         if(joint < fBot) joint = fBot;
         if(trailDir < 0 && joint > ask + minDist && joint < ask + maxDist)
         {
            bestLimit = joint; bestFvgTop = fTop; bestFvgBot = fBot;
            bestTrailAt = tn; break;
         }
         if(trailDir > 0 && joint < bid - minDist && joint > bid - maxDist)
         {
            bestLimit = joint; bestFvgTop = fTop; bestFvgBot = fBot;
            bestTrailAt = tn; break;
         }
      }
   }

   if(bestLimit <= 0) return;

   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   bestLimit = NormalizeDouble(bestLimit, dg);

   // Mettre à jour LIMIT DISP existant si le niveau a bougé, sinon skip
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong tk = OrderGetTicket(i);
      if(tk == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) != _Symbol) continue;
      if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      string cmt = OrderGetString(ORDER_COMMENT);
      if(StringFind(cmt, "DISP_TRAIL") < 0) continue;

      double op = OrderGetDouble(ORDER_PRICE_OPEN);
      if(MathAbs(op - bestLimit) <= atr * 0.12)
         return; // déjà bien placé à la jointure

      // Ne repositionner qu'après 20 min minimum
      datetime setup = (datetime)OrderGetInteger(ORDER_TIME_SETUP);
      int age = (setup > 0) ? (int)(TimeCurrent() - setup) : 0;
      int minAge = MathMax(1200, LimitCancelMinAgeSec);
      if(age < minAge)
         return; // laisser l'ordre en place

      if(LimitCancelAllowed(tk, false, "DISP_TRAIL relocate"))
      {
         LimitSafeOrderDelete(tk, false, "DISP_TRAIL relocate");
         Print("🔄 DISP_TRAIL LIMIT repositionné ", op, " → ", bestLimit,
               " après ", age, "s (jointure trail∩FVG)");
      }
      else
         return;
   }

   // Compter restants
   int existingDisp = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong tk = OrderGetTicket(i);
      if(tk == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) != _Symbol) continue;
      if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      if(StringFind(OrderGetString(ORDER_COMMENT), "DISP_TRAIL") >= 0)
         existingDisp++;
   }
   if(existingDisp >= DispFVGTrailLimitMax) return;

   double lot = CalculateLotSize();
   if(lot <= 0) return;

   double sl = 0, tp = 0;
   if(trailDir < 0)
   {
      sl = NormalizeDouble(bestLimit + atr * DispFVGLimitSL_ATR, dg);
      tp = NormalizeDouble(bestLimit - atr * DispFVGLimitTP_ATR, dg);
      SMC_CapSLToMaxLossUSD(_Symbol, -1, bestLimit, lot, sl);
   }
   else
   {
      sl = NormalizeDouble(bestLimit - atr * DispFVGLimitSL_ATR, dg);
      tp = NormalizeDouble(bestLimit + atr * DispFVGLimitTP_ATR, dg);
      SMC_CapSLToMaxLossUSD(_Symbol, 1, bestLimit, lot, sl);
   }

   MqlTradeRequest req; MqlTradeResult res;
   ZeroMemory(req); ZeroMemory(res);
   req.action       = TRADE_ACTION_PENDING;
   req.symbol       = _Symbol;
   req.volume       = lot;
   req.type         = (trailDir < 0) ? ORDER_TYPE_SELL_LIMIT : ORDER_TYPE_BUY_LIMIT;
   req.price        = bestLimit;
   req.sl           = sl;
   req.tp           = tp;
   req.deviation    = 30;
   req.magic        = InpMagicNumber;
   req.comment      = "DISP_TRAIL " + (trailDir < 0 ? "SELL" : "BUY");
   req.type_filling = ORDER_FILLING_RETURN;
   req.type_time    = ORDER_TIME_GTC;

   if(!OrderSend(req, res))
   {
      Print("❌ DISP_TRAIL LIMIT échoué ret=", res.retcode, " ", res.comment, " @", bestLimit);
      return;
   }

   Print("✅ DISP_TRAIL LIMIT ", (trailDir < 0 ? "SELL" : "BUY"),
         " @", bestLimit,
         " | jointure trail∩FVG [", DoubleToString(bestFvgBot, dg), "-", DoubleToString(bestFvgTop, dg), "]",
         " | trailNow=", DoubleToString(bestTrailAt, dg),
         " | SL=", sl, " TP=", tp,
         " | ticket=", res.order);

   // Marqueurs: HLINE + point jointure
   string mk = "SMC_DISP_TRAIL_LIM_" + _Symbol;
   string mk2 = "SMC_DISP_TRAIL_JCT_" + _Symbol;
   ObjectDelete(0, mk);
   ObjectDelete(0, mk2);
   if(ObjectCreate(0, mk, OBJ_HLINE, 0, 0, bestLimit))
   {
      ObjectSetInteger(0, mk, OBJPROP_COLOR, trailDir < 0 ? clrOrangeRed : clrLime);
      ObjectSetInteger(0, mk, OBJPROP_STYLE, STYLE_DASH);
      ObjectSetInteger(0, mk, OBJPROP_WIDTH, 1);
      ObjectSetInteger(0, mk, OBJPROP_BACK, true);
      ObjectSetString(0, mk, OBJPROP_TEXT, "DISP_TRAIL jointure");
   }
   if(ObjectCreate(0, mk2, OBJ_ARROW, 0, now, bestLimit))
   {
      ObjectSetInteger(0, mk2, OBJPROP_ARROWCODE, 159);
      ObjectSetInteger(0, mk2, OBJPROP_COLOR, clrYellow);
      ObjectSetInteger(0, mk2, OBJPROP_WIDTH, 2);
   }

   CleanupExcessLimits(_Symbol, MathMax(2, DispFVGTrailLimitMax + 1));
}

