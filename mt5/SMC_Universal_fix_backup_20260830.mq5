{
   SMC_TryDowEpTouchMarketEntry();
}

bool SMC_FindSmcpsEntryConfirm(const int dirSign, double &levelOut, string &nameOut)
{
   levelOut = 0;
   nameOut = "";
   double atr = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[]; ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atr = ab[0];
   }
   if(atr <= 0) atr = _Point * 50;
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double mid = (bid + ask) * 0.5;
   double maxDist = atr * MathMax(0.15, DowEpSmcpsMaxDistATR);
   double best = 0, bestDist = 1e99;
   string bestName = "";
   int total = ObjectsTotal(0, 0, -1);
   for(int i = total - 1; i >= 0; i--)
   {
      string name = ObjectName(0, i);
      if(name == "") continue;
      string nU = name; StringToUpper(nU);
      bool isSmcps = (StringFind(nU, "SMCPS_TXT") >= 0 || StringFind(nU, "SMCPS") >= 0);
      bool isEntry = (StringFind(nU, "ENTRY") >= 0 || StringFind(nU, "PAT_LINE") >= 0 || StringFind(nU, "PAT_") >= 0);
      if(!isSmcps && !isEntry) continue;
      int otype = (int)ObjectGetInteger(0, name, OBJPROP_TYPE);
      double price = 0;
      if(otype == OBJ_HLINE) price = ObjectGetDouble(0, name, OBJPROP_PRICE);
      else if(otype == OBJ_TREND) price = ObjectGetDouble(0, name, OBJPROP_PRICE, 0);
      else if(otype == OBJ_TEXT || otype == OBJ_LABEL) price = ObjectGetDouble(0, name, OBJPROP_PRICE);
      else continue;
      if(price <= 0) continue;
      long style = ObjectGetInteger(0, name, OBJPROP_STYLE);
      color clr = (color)ObjectGetInteger(0, name, OBJPROP_COLOR);
      string txt = ObjectGetString(0, name, OBJPROP_TEXT);
      string tU = txt; StringToUpper(tU);
      int lineDir = 0;
      if(StringFind(tU, "SELL") >= 0 || StringFind(tU, "BEAR") >= 0 || StringFind(nU, "SELL") >= 0) lineDir = -1;
      else if(StringFind(tU, "BUY") >= 0 || StringFind(tU, "BULL") >= 0 || StringFind(nU, "BUY") >= 0) lineDir = 1;
      else
      {
         int r = (int)(clr & 0xFF), g = (int)((clr >> 8) & 0xFF), b = (int)((clr >> 16) & 0xFF);
         if(g > r + 20 && g > b) lineDir = 1;
         else if(r > g + 20 && r > b) lineDir = -1;
         else if(style == STYLE_DOT || style == STYLE_DASH) lineDir = (price <= mid) ? 1 : -1;
      }
      if(dirSign != 0 && lineDir != 0 && lineDir != dirSign) continue;
      double d = MathAbs(mid - price);
      if(d <= maxDist && d < bestDist) { bestDist = d; best = price; bestName = name; }
   }
   if(best > 0) { levelOut = best; nameOut = bestName; return true; }
   return false;
}

bool SMC_FindDowEpZone(int &dirOut, double &loOut, double &hiOut, string &srcOut)
{
   dirOut = 0; loOut = 0; hiOut = 0; srcOut = "";
   double atr = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[]; ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atr = ab[0];
   }
   if(atr <= 0 && g_dowState.currentATR > 0) atr = g_dowState.currentATR;
   if(atr <= 0) atr = _Point * 50;
   double bestScore = -1;
   int total = ObjectsTotal(0, 0, -1);
   for(int i = total - 1; i >= 0; i--)
   {
      string name = ObjectName(0, i);
      if(name == "") continue;
      string nU = name; StringToUpper(nU);
      string txt = ObjectGetString(0, name, OBJPROP_TEXT);
      string tU = txt; StringToUpper(tU);
      bool isDow = (StringFind(nU, "DOW") >= 0 || StringFind(tU, "DOW") >= 0);
      bool isEp  = (StringFind(nU, "EP") >= 0 || StringFind(tU, "EP") >= 0
                    || StringFind(nU, "CORRECTION") >= 0 || StringFind(tU, "CORRECTION") >= 0);
      bool isBearEp = (StringFind(nU, "BEAR") >= 0 && StringFind(nU, "EP") >= 0);
      bool isBullEp = (StringFind(nU, "BULL") >= 0 && StringFind(nU, "EP") >= 0);
      if(!isDow && !isBearEp && !isBullEp) continue;
      int otype = (int)ObjectGetInteger(0, name, OBJPROP_TYPE);
      double lo = 0, hi = 0;
      int dir = 0;
      if(StringFind(nU, "BEAR") >= 0 || StringFind(tU, "BEAR") >= 0 || StringFind(tU, "SELL") >= 0) dir = -1;
      else if(StringFind(nU, "BULL") >= 0 || StringFind(tU, "BULL") >= 0 || StringFind(tU, "BUY") >= 0) dir = 1;
      if(otype == OBJ_RECTANGLE)
      {
         double p0 = ObjectGetDouble(0, name, OBJPROP_PRICE, 0);
         double p1 = ObjectGetDouble(0, name, OBJPROP_PRICE, 1);
         lo = MathMin(p0, p1); hi = MathMax(p0, p1);
      }
      else if(otype == OBJ_HLINE || otype == OBJ_TREND)
      {
         double pr = (otype == OBJ_HLINE) ? ObjectGetDouble(0, name, OBJPROP_PRICE) : ObjectGetDouble(0, name, OBJPROP_PRICE, 0);
         if(pr <= 0) continue;
         lo = pr - atr * 0.15; hi = pr + atr * 0.15;
      }
      else continue;
      if(lo <= 0 || hi < lo) continue;
      if(dir == 0 && g_dowState.active) dir = g_dowState.isBearish ? -1 : 1;
      if(dir == 0) continue;
      double midZ = (lo + hi) * 0.5;
      double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      double score = 1000.0 - MathAbs(bid - midZ);
      if(StringFind(nU, "EP") >= 0) score += 50.0;
      if(score > bestScore) { bestScore = score; dirOut = dir; loOut = lo; hiOut = hi; srcOut = name; }
   }
   if(dirOut == 0 && g_dowState.active && g_dowState.projectedPrice > 0)
   {
      dirOut = g_dowState.isBearish ? -1 : 1;
      double ep = g_dowState.projectedPrice;
      loOut = ep - atr * MathMax(0.15, DowEpTouchATRMult);
      hiOut = ep + atr * MathMax(0.15, DowEpTouchATRMult);
      srcOut = "DOW_PROJECTED_EP";
   }
   return (dirOut != 0 && loOut > 0 && hiOut >= loOut);
}

// v1.28d: direction serveur même si affichage local = WAIT (ex: "WAIT (srv:BUY)")
int SMC_GomServerDirHint()
{
   // 1) Verdict live non-WAIT
   if(g_smcGomConnected && g_smcGomVerdictNum != 0)
      return (g_smcGomVerdictNum > 0) ? 1 : -1;

   // 2) Sticky serveur encore valide
   if(g_gomCacheStickyUntil > TimeCurrent() && g_gomCacheStickyVn != 0)
      return (g_gomCacheStickyVn > 0) ? 1 : -1;

   // 3) Parser le texte affiché: WAIT (srv:BUY) / WAIT (srv:SELL) / prix≠GOM etc.
   string t = g_smcGomVerdict;
   string u = t;
   StringToUpper(u);
   if(StringFind(u, "SRV:BUY") >= 0 || StringFind(u, "SRV BUY") >= 0 ||
      StringFind(u, "(BUY)") >= 0 || StringFind(u, "SERVER BUY") >= 0)
      return 1;
   if(StringFind(u, "SRV:SELL") >= 0 || StringFind(u, "SRV SELL") >= 0 ||
      StringFind(u, "(SELL)") >= 0 || StringFind(u, "SERVER SELL") >= 0)
      return -1;
   // "WAIT (prix≠GOM)" après un BUY sticky invalidé — sticky déjà 0; rien
   return 0;
}

void SMC_TryDowEpTouchMarketEntry()
{
   // v1.32: DOW EP uniquement si GOM GOOD/PERFECT — JAMAIS sous WAIT
   if(!UseDowEpTouchMarket && !UseDowTrendline) return;
   if(BlockAllTrades) return;
   if(CountPositionsForSymbol(_Symbol) > 0) return;
   if(!g_smcGomConnected || g_smcGomVerdictNum == 0)
   {
      // Aucun ordre tant que WAIT
      return;
   }
   int liveVn = g_smcGomVerdictNum;
   bool liveGood = (MathAbs(liveVn) >= 2);
   if(!liveGood) return; // SIMPLE ou WAIT: rien

   static datetime s_lastTry = 0;
   if(DowEpCooldownSec > 0 && (TimeCurrent() - s_lastTry) < DowEpCooldownSec) return;

   int epDir = 0; double epLo = 0, epHi = 0; string epSrc = "";
   if(!SMC_FindDowEpZone(epDir, epLo, epHi, epSrc))
   {
      // Fallback: g_dowState projeté actif
      if(g_dowState.active && g_dowState.projectedPrice > 0)
      {
         epDir = g_dowState.isBearish ? -1 : 1;
         double atr0 = (g_dowState.currentATR > 0) ? g_dowState.currentATR : _Point * 50;
         double pad0 = atr0 * MathMax(0.15, DowEpTouchATRMult);
         epLo = g_dowState.projectedPrice - pad0;
         epHi = g_dowState.projectedPrice + pad0;
         epSrc = g_dowState.isBearish ? "DOW_BEAR_EP" : "DOW_BULL_EP";
      }
      else
         return;
   }
   if(epDir == 0) return;
   if(IsBoomLikeSymbol(_Symbol) && epDir < 0) return;
   if(IsCrashLikeSymbol(_Symbol) && epDir > 0) return;

   // Alignement: GOM GOOD/PERFECT même sens que EP uniquement (pas de WAIT/srv)
   bool alignLive = liveGood && ((epDir > 0 && liveVn >= 2) || (epDir < 0 && liveVn <= -2));
   if(!alignLive) return;

   double atr = 0;
   if(atrHandle != INVALID_HANDLE) { double ab[]; ArraySetAsSeries(ab, true); if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atr = ab[0]; }
   if(atr <= 0) atr = (g_dowState.currentATR > 0) ? g_dowState.currentATR : _Point * 50;
   double pad = atr * MathMax(0.10, DowEpTouchATRMult);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double mid = (bid + ask) * 0.5;

   // Prix touche la zone EP (BULL ou BEAR)
   bool touched = (mid >= (epLo - pad) && mid <= (epHi + pad));
   // Aussi: wick de la bougie courante a touché la zone
   if(!touched)
   {
      MqlRates r[];
      ArraySetAsSeries(r, true);
      if(CopyRates(_Symbol, PERIOD_CURRENT, 0, 2, r) >= 1)
      {
         if(r[0].low <= epHi + pad && r[0].high >= epLo - pad)
            touched = true;
      }
   }
   if(!touched) return;

   static datetime s_lastBar = 0;
   datetime curBar = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(curBar == s_lastBar) return;

   string action = (epDir > 0) ? "BUY" : "SELL";
   if(!CanTradeOnSymbol(_Symbol)) return;
   if(!TryAcquireOpenLock()) return;
   s_lastTry = TimeCurrent();
   s_lastBar = curBar;

   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double lot = CalculateLotSize();
   if(lot <= 0) { ReleaseOpenLock(); return; }
   double slMult = MathMax(1.0, ImpulseZoneSL_ATRMult);
   double tpMult = MathMax(2.0, ImpulseZoneTP_ATRMult);
   double entry = 0, sl = 0, tp = 0;
   bool ok = false;
   bool isPerfect = (MathAbs(g_smcGomVerdictNum) >= 3);
   string tag = isPerfect ? "DOW EP PERFECT" : "DOW EP GOOD";
   string cmt = tag + " " + action + " " + epSrc;

   // v1.32: Gated uniquement (refuse WAIT automatiquement)
   if(epDir > 0 && g_smcGomVerdictNum < 2) { ReleaseOpenLock(); return; }
   if(epDir < 0 && g_smcGomVerdictNum > -2) { ReleaseOpenLock(); return; }
   if(epDir > 0)
   {
      entry = ask;
      sl = NormalizeDouble(entry - atr * slMult, dg);
      tp = NormalizeDouble(entry + atr * tpMult, dg);
      SMC_CapSLToMaxLossUSD(_Symbol, 1, entry, lot, sl);
      ok = SMC_GatedTradeBuy(lot, _Symbol, entry, sl, tp, cmt);
   }
   else
   {
      entry = bid;
      sl = NormalizeDouble(entry + atr * slMult, dg);
      tp = NormalizeDouble(entry - atr * tpMult, dg);
      SMC_CapSLToMaxLossUSD(_Symbol, -1, entry, lot, sl);
      ok = SMC_GatedTradeSell(lot, _Symbol, entry, sl, tp, cmt);
   }
   ReleaseOpenLock();
   if(ok)
   {
      RegisterOrderPlaced();
      g_maxProfit = 0;
      Print("📌 ", tag, " MARKET ", action, " ", _Symbol, " @", DoubleToString(entry, dg),
            " | zone=[", DoubleToString(epLo, dg), "-", DoubleToString(epHi, dg), "]",
            " | src=", epSrc, " | vn=", g_smcGomVerdictNum,
            " | SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg));
      if(UseNotifications)
      {
         Alert("📌 ", tag, " ", action, " ", _Symbol);
         SendNotification("📌 " + tag + " " + action + " " + _Symbol);
      }
   }
   else
      Print("❌ DOW EP market fail | ", cmt, " err=", GetLastError());
}


void Dow_PlaceRealLimitOrder()
{
   if(!UseDowTrendline || BlockAllTrades) return;
   if(!g_dowState.active || g_dowState.projectedPrice <= 0) return;
   if(!g_smcGomConnected || g_smcGomVerdictNum == 0) return;

   int dowDir = g_dowState.isBearish ? -1 : 1;
   if(IsBoomLikeSymbol(_Symbol) && dowDir < 0) return;
   if(IsCrashLikeSymbol(_Symbol) && dowDir > 0) return;
   // Alignement GOM: accepter SIMPLE (|vn| >= 1) au lieu de GOOD/PERFECT (|vn| >= 2)
   if(dowDir > 0 && g_smcGomVerdictNum < 1) return;
   if(dowDir < 0 && g_smcGomVerdictNum > -1) return;
   if(!CanPlaceOrderByGOM(_Symbol, dowDir, "LIMIT")) return;
   // LIMIT contre M5+H1 interdit (sauf GOM PERFECT)
   if(!SMC_ScalpAllowLimitAgainstTf(dowDir))
   {
      static datetime s_dowTfLog = 0;
      if(TimeCurrent() - s_dowTfLog >= 30)
      {
         s_dowTfLog = TimeCurrent();
         Print("🚫 DOW LIMIT bloqué — contre M5/H1 (M5=", g_smcTfM5Dir, " H1=", g_smcTfH1Dir,
               ") sans GOM PERFECT | dir=", dowDir);
      }
      return;
   }

   // Déjà une position ou un limit DOW ?
   if(CountPositionsForSymbol(_Symbol) > 0) return;
   int dowLimits = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong tk = OrderGetTicket(i);
      if(tk == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) != _Symbol) continue;
      if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      string cm = OrderGetString(ORDER_COMMENT);
      if(StringFind(cm, "DOW") >= 0) dowLimits++;
   }
   if(dowLimits >= 1) return;

   double atr = g_dowState.currentATR;
   if(atr <= 0) atr = _Point * 50;
   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double entry = NormalizeDouble(g_dowState.projectedPrice, dg);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double px = (bid + ask) * 0.5;
   double dist = MathAbs(px - entry);

   // Si le prix est loin (> 0.5 ATR) avec conditions excellentes, exécuter au marché
   bool farFromLimit = (dist > atr * 0.5);
   bool excellentConditions = (MathAbs(g_smcGomVerdictNum) >= 2) && SMC_APlusSetupOK(_Symbol, dowDir);

   if(farFromLimit && excellentConditions)
   {
      // Exécution au marché au lieu de LIMIT
      if(!TryAcquireOpenLock()) return;
      double slMult = ImpulseZoneSL_ATRMult;
      double tpMult = MathMax(ImpulseZoneTP_ATRMult, 2.4);
      bool ok = false;
      if(dowDir > 0)
      {
         double marketEntry = ask;
         double sl = NormalizeDouble(marketEntry - atr * slMult, dg);
         double tp = NormalizeDouble(marketEntry + atr * tpMult, dg);
         ok = SMC_GatedTradeBuy(NormalizeVolumeForSymbol(0.01), _Symbol, marketEntry, sl, tp, "DOW MARKET BUY");
      }
      else
      {
         double marketEntry = bid;
         double sl = NormalizeDouble(marketEntry + atr * slMult, dg);
         double tp = NormalizeDouble(marketEntry - atr * tpMult, dg);
         ok = SMC_GatedTradeSell(NormalizeVolumeForSymbol(0.01), _Symbol, marketEntry, sl, tp, "DOW MARKET SELL");
      }
      ReleaseOpenLock();
      if(ok)
      {
         RegisterOrderPlaced();
         Print("✅ DOW MARKET EXEC (far limit) ", (dowDir > 0 ? "BUY" : "SELL"), " ", _Symbol,
               " @", DoubleToString(dowDir > 0 ? ask : bid, dg), " vn=", g_smcGomVerdictNum);
      }
      return;
   }

   double slMult = ImpulseZoneSL_ATRMult;
   double tpMult = MathMax(ImpulseZoneTP_ATRMult, 2.4);

   MqlTradeRequest req = {};
   MqlTradeResult  res = {};
   req.action = TRADE_ACTION_PENDING;
   req.symbol = _Symbol;
   req.volume = NormalizeVolumeForSymbol(0.01);
   req.magic  = InpMagicNumber;
   req.deviation = 30;

   if(dowDir > 0)
   {
      // BUY LIMIT sous le marché
      if(entry >= ask) entry = NormalizeDouble(ask - atr * 0.05, dg);
      req.type  = ORDER_TYPE_BUY_LIMIT;
      req.price = entry;
      req.sl    = NormalizeDouble(entry - atr * slMult, dg);
      req.tp    = NormalizeDouble(entry + atr * tpMult, dg);
      req.comment = "DOW LIMIT BUY";
   }
   else
   {
      // SELL LIMIT au-dessus du marché
      if(entry <= bid) entry = NormalizeDouble(bid + atr * 0.05, dg);
      req.type  = ORDER_TYPE_SELL_LIMIT;
      req.price = entry;
      req.sl    = NormalizeDouble(entry + atr * slMult, dg);
      req.tp    = NormalizeDouble(entry - atr * tpMult, dg);
      req.comment = "DOW LIMIT SELL";
   }

   if(!CanPlaceLimitOrder(_Symbol, req.type)) return;
   CleanupExcessLimits(_Symbol, 2);
   if(!ValidateAndAdjustLimitPrice(req.price, req.sl, req.tp, req.type)) return;

   // Cap SL $
   int dSign = (dowDir > 0) ? 1 : -1;
   SMC_CapSLToMaxLossUSD(_Symbol, dSign, req.price, req.volume, req.sl);

   if(trade.OrderSend(req, res))
   {
      g_dowState.limitTicket = (long)res.order;
      Print("✅ DOW LIMIT PLACÉ ", (dowDir > 0 ? "BUY" : "SELL"), " @", req.price,
            " | SL=", req.sl, " TP=", req.tp, " | ticket=", res.order,
            " | GOM=", g_smcGomVerdict, " vn=", g_smcGomVerdictNum);
   }
   else
      Print("❌ DOW LIMIT échoué retcode=", res.retcode, " ", res.comment);
}

