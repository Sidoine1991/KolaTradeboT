//| FERMETURE SANS PROFIT APRÈS 7 MINUTES — probable correction de marché |
void CloseUnprofitableAfterDelay()
{
   static datetime s_lastCheck = 0;
   if(TimeCurrent() - s_lastCheck < 15) return; // check toutes les 15s max
   s_lastCheck = TimeCurrent();

   const int    DELAY_SECONDS = 7 * 60; // 7 minutes
   datetime     now           = TimeCurrent();

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if((long)PositionGetInteger(POSITION_MAGIC) != InpMagicNumber) continue;

      datetime openTime = (datetime)PositionGetInteger(POSITION_TIME);
      if(now - openTime < DELAY_SECONDS) continue; // pas encore 7 min

      double profit = PositionGetDouble(POSITION_PROFIT);
      // Attendre au moins 1$ de perte — pas de sortie rapide sans spike
      double minLoss = MathMax(1.0, MinLossBeforeAutoCloseUSD);
      if(profit > -minLoss) continue;

      ulong ticket = PositionGetInteger(POSITION_TICKET);
      int   ageMin = (int)((now - openTime) / 60);
      Print("[7MIN-CLOSE] Perte >= $", DoubleToString(minLoss, 2), " après ", ageMin,
            " min sur ", _Symbol,
            " | profit=", DoubleToString(profit, 2),
            " | ticket=", ticket, " → fermeture");
      PositionCloseWithLog(ticket, "7min loss close");
   }
}

//| ROTATION AUTOMATIQUE DES POSITIONS - Évite de rester bloqué sur un symbole |
void AutoRotatePositions()
{
   int totalPositions = CountPositionsOurEA();
   
   // Si on n'est pas à la limite de positions, pas besoin de rotation
   if(totalPositions < MaxPositionsTerminal)
   {
      return;
   }
   
   // Si on est à la limite, vérifier s'il y a des opportunités sur d'autres symboles
   Print("🔄 ROTATION AUTO - Positions: ", totalPositions, "/", MaxPositionsTerminal, " - Vérification opportunités...");
   
   // Chercher la position la plus ancienne ou la moins performante
   ulong oldestTicket = 0;
   datetime oldestTime = TimeCurrent();
   double worstProfit = 999999;
   ulong worstTicket = 0;
   string worstSymbol = "";
   
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      
      string symbol = posInfo.Symbol();
      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      datetime openTime = posInfo.Time();
      ulong ticket = posInfo.Ticket();
      
      // Priorité 1: Position en perte depuis longtemps
      if(profit < -0.5 && openTime < oldestTime)
      {
         oldestTime = openTime;
         oldestTicket = ticket;
      }
      
      // Priorité 2: Position avec la pire performance
      if(profit < worstProfit)
      {
         worstProfit = profit;
         worstTicket = ticket;
         worstSymbol = symbol;
      }
   }
   
   // Fermer la position la plus ancienne en perte OU la pire position
   ulong ticketToClose = (oldestTicket > 0) ? oldestTicket : worstTicket;
   
   if(ticketToClose > 0)
   {
      if(!PositionSelectByTicket(ticketToClose))
      {
         Print("⚠️ Position déjà fermée avant rotation - ticket=", ticketToClose);
         return;
      }
      
      string symbolToClose = PositionGetString(POSITION_SYMBOL);
      double positionProfit = PositionGetDouble(POSITION_PROFIT);
      
      // Fermer seulement si c'est une position en perte ou si elle est ouverte depuis plus de 30 minutes
      datetime positionTime = (datetime)PositionGetInteger(POSITION_TIME);
      int minutesOpen = (int)(TimeCurrent() - positionTime) / 60;
      
      if(positionProfit < -0.2 || minutesOpen > 30)
      {
         Print("🔄 ROTATION AUTO - Fermeture position: ", symbolToClose, 
               " | Profit: ", DoubleToString(positionProfit, 2), "$",
               " | Âge: ", minutesOpen, " min");
         
         if(PositionCloseWithLog(ticketToClose, "Rotation automatique"))
         {
            Print("✅ ROTATION AUTO - Position fermée avec succès - Libère place pour nouvelles opportunités");
         }
         else
         {
            int err = GetLastError();
            Print("❌ ROTATION AUTO - Échec fermeture position: ", symbolToClose, " | Erreur: ", err);
         }
      }
      else
      {
         Print("🔄 ROTATION AUTO - Position conservée: ", symbolToClose, 
               " | Profit: ", DoubleToString(positionProfit, 2), "$",
               " | Âge: ", minutesOpen, " min (tôt ou profitable)");
      }
   }
   else
   {
      Print("🔄 ROTATION AUTO - Aucune position éligible à la fermeture");
   }
}

//+------------------------------------------------------------------+
//| Place S/R 20-bar limit orders - spike entry points               |
//| BUY_LIMIT juste EN-DESSOUS support (rebond spike haussier)       |
//| SELL_LIMIT juste AU-DESSUS résistance (rebond spike baissier)    |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| S/R 20 bars DÉJÀ TOUCHÉ + REBONDI -> impulsion forte.            |
//| Logique: on suit l'état "prix dans la zone S/R 20 bars". Quand   |
//| le prix ENTRE dans la zone (touch) puis EN SORT vers l'extérieur   |
//| (rebond/refus), on arme le flag de direction. Le flag reste armé   |
//| un certain nombre de bougies (fenêtre de chaîne de spikes).        |
//+------------------------------------------------------------------+
void UpdateSR20BounceState()
{
    if(!UseSR20BarLimits && !UseImpulseZone) return;

    // Limiter aux symboles de type spike (Boom/Crash/Painx/Gainx)
    if(!SMC_IsSpikeStyleSymbol(_Symbol)) return;

    // Calculer (ou rafraîchir) les extrêmes 20 bars indépendamment du flag
    // UseSR20BarLimits, car PlaceSRLimitOrders20Bars peut ne pas tourner.
    double atrVal = 0;
    if(atrHandle != INVALID_HANDLE)
    {
        double atr[]; ArraySetAsSeries(atr, true);
        if(CopyBuffer(atrHandle, 0, 0, 1, atr) >= 1) atrVal = atr[0];
    }
    if(atrVal <= 0) atrVal = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 50;
    if(atrVal <= 0) return;

    int lowestIdx  = iLowest(_Symbol, PERIOD_CURRENT, MODE_LOW, 20, 1);
    int highestIdx = iHighest(_Symbol, PERIOD_CURRENT, MODE_HIGH, 20, 1);
    if(lowestIdx < 0 || highestIdx < 0) return;

    g_impulseSupport20    = iLow(_Symbol, PERIOD_CURRENT, lowestIdx);
    g_impulseResistance20 = iHigh(_Symbol, PERIOD_CURRENT, highestIdx);
    g_impulseSupBuffer   = atrVal * ImpulseZoneBufferATR;
    g_impulseResBuffer   = atrVal * ImpulseZoneBufferATR;

    double sup20 = g_impulseSupport20;
    double res20 = g_impulseResistance20;
    if(sup20 <= 0 || res20 <= 0) return;

    double supBuf = (g_impulseSupBuffer > 0) ? g_impulseSupBuffer : SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10;
    double resBuf = (g_impulseResBuffer > 0) ? g_impulseResBuffer : SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10;

    double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
    double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
    if(bid <= 0 || ask <= 0) return;
    double price = (bid + ask) * 0.5;

    // État actuel: le prix est-il DANS la zone (touch) ?
    bool inSup = (price <= sup20 + supBuf);
    bool inRes = (price >= res20 - resBuf);
    bool outSup = (price > sup20 + supBuf);   // clairement reparti au-dessus
    bool outRes = (price < res20 - resBuf);   // clairement reparti en-dessous

    // Expiration des armes après la fenêtre
    if(g_sr20BounceBuyBars > 0)
    {
        g_sr20BounceBuyBars++;
        if(g_sr20BounceBuyBars > SR20BounceWindowBars)
        {
            g_sr20BounceBuyBars = 0;
            g_sr20BounceArmedBuy = false;
        }
    }
    if(g_sr20BounceSellBars > 0)
    {
        g_sr20BounceSellBars++;
        if(g_sr20BounceSellBars > SR20BounceWindowBars)
        {
            g_sr20BounceSellBars = 0;
            g_sr20BounceArmedSell = false;
        }
    }

    // Compteurs "hors zone" pour confirmation du rebond (>= SR20BounceConfirmBars bougies)
    if(outSup) g_sr20OutOfSupBars++; else g_sr20OutOfSupBars = 0;
    if(outRes) g_sr20OutOfResBars++; else g_sr20OutOfResBars = 0;

    static bool s_prevInSup = false;
    static bool s_prevInRes = false;

    g_impulseSupTouched = inSup;
    g_impulseResTouched = inRes;

    // Touch immédiat → armer sans attendre sortie de zone + confirmation
    if(SR20EnterOnTouch)
    {
       if(inSup && !s_prevInSup && !IsCrashLikeSymbol(_Symbol))
       {
          g_sr20BounceArmedBuy = true;
          g_sr20BounceBuyTime  = TimeCurrent();
          g_sr20BounceBuyBars  = 1;
          g_sr20BounceArmedSell = false;
          g_sr20BounceSellBars  = 0;
          Print("🟢 SR20 TOUCH: support touché → armé BUY sur ", _Symbol,
                " | niveau=", DoubleToString(sup20, _Digits), " prix=", DoubleToString(price, _Digits));
       }
       if(inRes && !s_prevInRes && !IsBoomLikeSymbol(_Symbol))
       {
          g_sr20BounceArmedSell = true;
          g_sr20BounceSellTime  = TimeCurrent();
          g_sr20BounceSellBars  = 1;
          g_sr20BounceArmedBuy  = false;
          g_sr20BounceBuyBars   = 0;
          Print("🔴 SR20 TOUCH: résistance touchée → armé SELL sur ", _Symbol,
                " | niveau=", DoubleToString(res20, _Digits), " prix=", DoubleToString(price, _Digits));
       }
    }

    // Rebond support: était DANS la zone, maintenant HORS zone pendant >= N bougies
    if(!inSup && s_prevInSup && g_sr20OutOfSupBars >= SR20BounceConfirmBars)
    {
        g_sr20BounceArmedBuy = true;
        g_sr20BounceBuyTime  = TimeCurrent();
        g_sr20BounceBuyBars   = 1;
        g_sr20BounceArmedSell = false;  // MUTEX: un seul côté armé à la fois
        g_sr20BounceSellBars  = 0;
        Print("🟢 SR20 BOUNCE: support 20 bars touché+rebondi (HAUSSIER) sur ", _Symbol,
              " | niveau=", DoubleToString(sup20, _Digits), " prix=", DoubleToString(price, _Digits));
    }

    // Rebond résistance: était DANS la zone, maintenant HORS zone pendant >= N bougies
    if(!inRes && s_prevInRes && g_sr20OutOfResBars >= SR20BounceConfirmBars)
    {
        g_sr20BounceArmedSell = true;
        g_sr20BounceSellTime  = TimeCurrent();
        g_sr20BounceSellBars   = 1;
        g_sr20BounceArmedBuy = false;   // MUTEX: un seul côté armé à la fois
        g_sr20BounceBuyBars  = 0;
        Print("🔴 SR20 BOUNCE: résistance 20 bars touchée+rebondie (BAISSIER) sur ", _Symbol,
              " | niveau=", DoubleToString(res20, _Digits), " prix=", DoubleToString(price, _Digits));
    }

    s_prevInSup = inSup;
    s_prevInRes = inRes;
}

//+------------------------------------------------------------------+
//| PRE-SPIKE BOUNCE : après un signal PRE_SPIKE, si le prix rebondit |
//| sur le SR20, une trendline DOW ou un EP DOW dans les 1-2 bougies  |
//| qui suivent, on arme une entrée (probabilité de 2e spike).        |
//| Réutilise les zones déjà calculées ailleurs (aucune duplication   |
//| de calcul) : g_sr20BounceArmedBuy/Sell (SR20) + g_dowState        |
//| (trendline + EP DOW).                                             |
//+------------------------------------------------------------------+
void ArmPreSpikeBounce(const int dir, const string source)
{
   bool alreadyArmedSame = (g_preSpikeBounceDir == dir && g_preSpikeBounceArmedTime > 0);
   g_preSpikeBounceArmedTime = TimeCurrent();
   g_preSpikeBounceDir       = dir;
   g_preSpikeBounceSource    = source;
   if(!alreadyArmedSame)
      Print("⚡ PRE-SPIKE BOUNCE armé (2e spike potentiel) | ", _Symbol,
            " | dir=", (dir == 1 ? "BUY" : "SELL"), " | source=", source);
}

void UpdatePreSpikeBounceState()
{
   if(!UsePreSpikeBounceEntry) return;
   if(!SMC_IsSpikeStyleSymbol(_Symbol)) return;

   // Ne s'active qu'après un signal PRE_SPIKE (volatilité qui gonfle) ou motif
   // de compression/consolidation pré-spike détecté directement sur les bougies.
   bool preSpikeActive = (g_spikeChainState == SPIKE_STATE_PRE_SPIKE) || IsPreSpikePattern();

   bool isBoom  = IsBoomLikeSymbol(_Symbol);
   bool isCrash = IsCrashLikeSymbol(_Symbol);
   int  allowedDir = isBoom ? 1 : (isCrash ? -1 : 0);  // règle directionnelle stricte Boom/Crash déjà en place

   if(preSpikeActive && allowedDir != 0)
   {
      // 1) Rebond SR20 (état déjà calculé par UpdateSR20BounceState, appelée juste avant)
      if(allowedDir == 1 && g_sr20BounceArmedBuy)
         ArmPreSpikeBounce(1, "SR20");
      if(allowedDir == -1 && g_sr20BounceArmedSell)
         ArmPreSpikeBounce(-1, "SR20");

      // 2) Touch trendline DOW (prix proche de la trendline projetée)
      if(g_dowState.active && g_dowState.projectedPrice > 0 && g_dowState.currentATR > 0)
      {
         double bid  = SymbolInfoDouble(_Symbol, SYMBOL_BID);
         double dist = MathAbs(bid - g_dowState.projectedPrice);
         if(dist <= g_dowState.currentATR * DowTouchBounceATRMult)
         {
            int tlDir = g_dowState.isBearish ? -1 : 1;
            if(tlDir == allowedDir)
               ArmPreSpikeBounce(tlDir, "DOW_TL");
         }
      }

      // 3) Touch EP DOW — utilise proximité projectedPrice (epLastTouchTime non dispo dans g_dowState)
      //    Si prix est très proche de la projection DOW, on considère un touch EP valide
      if(g_dowState.active && g_dowState.projectedPrice > 0 && g_dowState.currentATR > 0)
      {
         double bidEp = SymbolInfoDouble(_Symbol, SYMBOL_BID);
         double distEp = MathAbs(bidEp - g_dowState.projectedPrice);
         // Touch plus serré que le touch trendline (0.25 ATR)
         if(distEp <= g_dowState.currentATR * 0.25)
         {
            int epDir = g_dowState.isBearish ? -1 : 1;
            if(epDir == allowedDir)
               ArmPreSpikeBounce(epDir, "DOW_EP");
         }
      }
   }

   // Expiration de l'armement après PreSpikeBounceWindowBars bougies sans exécution
   if(g_preSpikeBounceArmedTime > 0)
   {
      int barsElapsed = (int)((TimeCurrent() - g_preSpikeBounceArmedTime) / PeriodSeconds(PERIOD_CURRENT));
      if(barsElapsed > PreSpikeBounceWindowBars)
      {
         g_preSpikeBounceArmedTime = 0;
         g_preSpikeBounceDir       = 0;
         g_preSpikeBounceSource    = "";
      }
   }
}

void ExecutePreSpikeBounceEntry()
{
   if(!UsePreSpikeBounceEntry || BlockAllTrades) return;
   if(g_preSpikeBounceDir == 0 || g_preSpikeBounceArmedTime == 0) return;
   if(!SMC_IsSpikeStyleSymbol(_Symbol)) return;
   if(Dow_IsDowOnlyLimitMode()) return;
   if(CountPositionsForSymbol(_Symbol) > 0) return;

   if(!g_smcGomConnected || g_smcGomVerdictNum == 0) return;

   int dir = g_preSpikeBounceDir;
   string action = (dir == 1) ? "BUY" : "SELL";
   if(dir == 1  && g_smcGomVerdictNum < 0) return;
   if(dir == -1 && g_smcGomVerdictNum > 0) return;
   if(!SMC_GOMAllowsScalpOrReentry(dir)) return;

   if(!AllowReentryAfterRecentLoss(_Symbol, action, true)) return;
   if(!CanTradeOnSymbol(_Symbol, action)) return;

   static datetime s_lastBounceEntryBar = 0;
   datetime curBar = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(curBar == s_lastBounceEntryBar) return;
   s_lastBounceEntryBar = curBar;

   if(!TryAcquireOpenLock()) return;

   // Filtre A+ identique aux autres entrées SR20/DOW (GOM GOOD/PERFECT + alignement M5/H1 + zone)
   if(!SMC_APlusSetupOK(_Symbol, dir))
   {
      static datetime s_aplusPreSpikeLog = 0;
      if(TimeCurrent() - s_aplusPreSpikeLog >= 20)
      {
         s_aplusPreSpikeLog = TimeCurrent();
         Print("🚫 PRE-SPIKE BOUNCE BLOQUÉ par filtre A+ | ", _Symbol, " ", action, " src=", g_preSpikeBounceSource);
      }
      ReleaseOpenLock(); return;
   }

   double atrVal = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double atrBuf[];
      ArraySetAsSeries(atrBuf, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, atrBuf) >= 1) atrVal = atrBuf[0];
   }
   if(atrVal <= 0) atrVal = SymbolInfoDouble(_Symbol, SYMBOL_ASK) - SymbolInfoDouble(_Symbol, SYMBOL_BID);
   if(atrVal <= 0) atrVal = _Point * 10;

   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double lot = CalculateLotSize();
   if(lot <= 0) { ReleaseOpenLock(); return; }

   bool ok = false;
   double entry = 0, sl = 0, tp = 0;

   if(dir == 1)
   {
      entry = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      sl = NormalizeDouble(entry - atrVal * ImpulseZoneSL_ATRMult, dg);
      tp = NormalizeDouble(entry + atrVal * ImpulseZoneTP_ATRMult, dg);
      ok = SMC_GatedTradeBuy(lot, _Symbol, entry, sl, tp, "PRESPIKE BOUNCE BUY " + g_preSpikeBounceSource);
   }
   else
   {
      entry = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      sl = NormalizeDouble(entry + atrVal * ImpulseZoneSL_ATRMult, dg);
      tp = NormalizeDouble(entry - atrVal * ImpulseZoneTP_ATRMult, dg);
      ok = SMC_GatedTradeSell(lot, _Symbol, entry, sl, tp, "PRESPIKE BOUNCE SELL " + g_preSpikeBounceSource);
   }

   ReleaseOpenLock();

   if(ok)
   {
      RegisterOrderPlaced();
      g_maxProfit = 0;
      Print("⚡⚡ PRE-SPIKE BOUNCE ENTRY ", action, " ", _Symbol, " @", DoubleToString(entry, dg),
            " | source=", g_preSpikeBounceSource,
            " | GOM=", g_smcGomVerdict, " vn=", g_smcGomVerdictNum,
            " | SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg));
      if(UseNotifications)
      {
         Alert("⚡⚡ PRE-SPIKE BOUNCE ", action, " ", _Symbol, " (", g_preSpikeBounceSource, ")");
         SendNotification("⚡⚡ PRE-SPIKE BOUNCE " + action + " " + _Symbol + " (" + g_preSpikeBounceSource + ")");
      }
      // Désarmer une fois exécuté
      g_preSpikeBounceArmedTime = 0;
      g_preSpikeBounceDir       = 0;
      g_preSpikeBounceSource    = "";
   }
}


//+------------------------------------------------------------------+
//| GOM SIMPLE BUY/SELL autorisé si M5 + H1 + trend global alignés   |
//| GOOD/PERFECT toujours OK. SIMPLE (|vn|==1) seulement si alignement |
//+------------------------------------------------------------------+
bool SMC_GlobalTrendAligned(const int dirSign)
{
   // Global ≈ H4/D1 (ou M15 si H4 neutre)
   string h4 = g_smcTfH4Dir; StringToUpper(h4);
   string d1 = g_smcTfD1Dir; StringToUpper(d1);
   string m15 = g_smcTfM15Dir; StringToUpper(m15);
   int bull = 0, bear = 0;
   if(h4 == "BULL" || h4 == "BUY") bull++;
   if(h4 == "BEAR" || h4 == "SELL") bear++;
   if(d1 == "BULL" || d1 == "BUY") bull++;
   if(d1 == "BEAR" || d1 == "SELL") bear++;
   if(m15 == "BULL" || m15 == "BUY") bull++;
   if(m15 == "BEAR" || m15 == "SELL") bear++;
   if(dirSign > 0) return (bull >= bear); // neutre OK pour BUY
   if(dirSign < 0) return (bear >= bull);
   return false;
}



// DOW EP / Trendline market si GOM GOOD/SIMPLE aligné + prix proche projection

//+------------------------------------------------------------------+
//| v1.23: Label clignotant ENTER BUY / ENTER SELL                     |
//+------------------------------------------------------------------+
void SMC_DrawGOMEnterLabel(const int dirSign, const string level)
{
   if(dirSign == 0) return;
   string name = "SMC_GOM_ENTER_LBL_" + _Symbol;
   string txt  = (dirSign > 0) ? ("BUY -> ENTER BUY  [" + level + "]")
                               : ("SELL -> ENTER SELL  [" + level + "]");
   color  clr  = (dirSign > 0) ? clrLime : clrRed;
   static datetime s_blink = 0;
   static bool     s_vis   = true;
   if(TimeCurrent() - s_blink >= 1) { s_blink = TimeCurrent(); s_vis = !s_vis; }
   if(ObjectFind(0, name) < 0)
      ObjectCreate(0, name, OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, 160);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, 42);
   ObjectSetString(0, name, OBJPROP_TEXT, txt);
   ObjectSetString(0, name, OBJPROP_FONT, "Arial Bold");
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, 18);
   ObjectSetInteger(0, name, OBJPROP_COLOR, s_vis ? clr : clrDarkGray);
   ObjectSetInteger(0, name, OBJPROP_BACK, false);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
}

void SMC_ClearGOMEnterLabel()
{
   ObjectDelete(0, "SMC_GOM_ENTER_LBL_" + _Symbol);
}

// Figures chartistes + lignes Entry tirets + S/R / Impulse / Engulf / TF_TL
bool SMC_GOMEnterHasStructure(const int dirSign, const double atrVal, string &srcOut)
{
   srcOut = "";
   if(atrVal <= 0) return false;
   double maxDist = atrVal * 1.50;
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double mid = (bid + ask) * 0.5;

   // 1) Impulse SUP/RES
   if(dirSign > 0 && g_impulseSupport20 > 0 &&
      (MathAbs(mid - g_impulseSupport20) <= maxDist || g_impulseSupTouched))
   { srcOut = "IMPULSE_SUP"; return true; }
   if(dirSign < 0 && g_impulseResistance20 > 0 &&
      (MathAbs(mid - g_impulseResistance20) <= maxDist || g_impulseResTouched))
   { srcOut = "IMPULSE_RES"; return true; }

   // 2) Engulfing
   int eng = SMC_DetectLocalEngulfingDir();
   if(eng == dirSign) { srcOut = "ENGULF"; return true; }
   if(g_engulfRetestArmed && g_engulfRetestDir == dirSign)
   { srcOut = "ENGULF_RETEST"; return true; }

   // 3) DOW / TF_TL
   if(UseDowTrendline && g_dowState.active && g_dowState.projectedPrice > 0)
   {
      int dowDir = g_dowState.isBearish ? -1 : 1;
      if(dowDir == dirSign && MathAbs(mid - g_dowState.projectedPrice) <= maxDist)
      { srcOut = "DOW_TF_TL"; return true; }
   }

   // 4) Objets chart : figures (3 Soldiers, Tweezer, Engulf…) + Entry dashed
   int total = ObjectsTotal(0, 0, -1);
   for(int i = total - 1; i >= 0; i--)
   {
      string name = ObjectName(0, i);
      if(name == "") continue;
      string nU = name; StringToUpper(nU);
      string txt = ObjectGetString(0, name, OBJPROP_TEXT);
      string tU = txt; StringToUpper(tU);

      bool isPattern = (StringFind(nU, "SOLDIER") >= 0 || StringFind(tU, "SOLDIER") >= 0 ||
                        StringFind(nU, "TWEEZER") >= 0 || StringFind(tU, "TWEEZER") >= 0 ||
                        StringFind(nU, "ENGULF")  >= 0 || StringFind(tU, "ENGULF")  >= 0 ||
                        StringFind(nU, "PAT_")    >= 0 || StringFind(nU, "PATTERN") >= 0 ||
                        StringFind(nU, "SMCPS")   >= 0 || StringFind(tU, "3 SOL")   >= 0 ||
                        StringFind(tU, "HAUSS")   >= 0 || StringFind(tU, "BAISS")   >= 0);
      bool isEntryLn = (StringFind(nU, "ENTRY") >= 0 || StringFind(tU, "ENTRY") >= 0 ||
                        StringFind(nU, "RETEST") >= 0);
      if(!isPattern && !isEntryLn) continue;

      int otype = (int)ObjectGetInteger(0, name, OBJPROP_TYPE);
      double price = 0;
      if(otype == OBJ_HLINE) price = ObjectGetDouble(0, name, OBJPROP_PRICE);
      else if(otype == OBJ_TREND || otype == OBJ_TEXT || otype == OBJ_ARROW)
         price = ObjectGetDouble(0, name, OBJPROP_PRICE, 0);
      // Direction depuis nom/texte
      int pDir = 0;
      if(StringFind(nU, "SELL") >= 0 || StringFind(tU, "SELL") >= 0 ||
         StringFind(tU, "BAISS") >= 0 || StringFind(nU, "BEAR") >= 0) pDir = -1;
      else if(StringFind(nU, "BUY") >= 0 || StringFind(tU, "BUY") >= 0 ||
              StringFind(tU, "HAUSS") >= 0 || StringFind(nU, "BULL") >= 0 ||
              StringFind(tU, "SOLDIER") >= 0 || StringFind(tU, "TWEEZER") >= 0) pDir = 1;
      // Si figure bullish sans tag SELL → BUY
      if(pDir == 0 && (StringFind(tU, "SOLDIER") >= 0 || StringFind(tU, "TWEEZER BOT") >= 0))
         pDir = 1;
      if(pDir != 0 && pDir != dirSign) continue;
      if(price > 0 && MathAbs(mid - price) > maxDist * 2.5) continue;
      srcOut = isPattern ? ("PAT_" + name) : ("ENTRY_LN");
      return true;
   }

   // 5) DISP trail aligné
   if(UseDispFVGTrail && g_dispTrailValid && !g_dispTrailBroken)
   {
      if(dirSign > 0 && g_dispTrailDir > 0) { srcOut = "DISP_TRAIL"; return true; }
      if(dirSign < 0 && g_dispTrailDir < 0) { srcOut = "DISP_TRAIL"; return true; }
   }

   // 6) SR20 bounce
   if(dirSign > 0 && g_sr20BounceArmedBuy) { srcOut = "SR20"; return true; }
   if(dirSign < 0 && g_sr20BounceArmedSell) { srcOut = "SR20"; return true; }

   return false;
}

//+------------------------------------------------------------------+
//| v1.28: PERFECT → MARKET immédiat (aucune attente structure/zone) |
//| GOOD → toujours filtres zone/DISP/structure.                      |
//+------------------------------------------------------------------+
// v1.28h: annule tous les LIMIT pending sur le symbole (PERFECT prend le marché)

// v1.28i: PERFECT → priorité structure (DOW Proj/EP, TF_TL, DISP trail, SR20)
// Retourne true si market ou LIMIT déjà placé
bool SMC_PerfectStructurePriorityEntry(const int dirSign, const string symTag)
{
   double atr = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[]; ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atr = ab[0];
   }
   if(atr <= 0) atr = (g_dowState.currentATR > 0) ? g_dowState.currentATR : _Point * 50;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double mid = (bid + ask) * 0.5;
   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double touchPad = atr * 0.35;   // zone "touche" → market
   double maxDist  = atr * 2.50;   // au-delà → ignorer niveau

   // Candidats: level, priority (1=meilleur), name
   double levels[8]; int prios[8]; string names[8];
   int n = 0;

   // 1) DOW projected line
   if(g_dowState.active && g_dowState.projectedPrice > 0)
   {
      int dowDir = g_dowState.isBearish ? -1 : 1;
      if(dowDir == dirSign)
      {
         levels[n] = g_dowState.projectedPrice;
         prios[n]  = 1;
         names[n]  = "DOW_PROJ";
         n++;
      }
   }
   // 2) DOW EP zone (centre)
   {
      int epDir = 0; double epLo = 0, epHi = 0; string epSrc = "";
      if(SMC_FindDowEpZone(epDir, epLo, epHi, epSrc) && epDir == dirSign)
      {
         levels[n] = (epLo + epHi) * 0.5;
         prios[n]  = 2;
         names[n]  = "DOW_EP";
         n++;
      }
      else if(g_dowState.active && g_dowState.projectedPrice > 0)
      {
         int d = g_dowState.isBearish ? -1 : 1;
         if(d == dirSign)
         {
            levels[n] = g_dowState.projectedPrice;
            prios[n]  = 2;
            names[n]  = "DOW_EP_FB";
            n++;
         }
      }
   }
   // 3) TF_TL (même state DOW / best TF) — tag GOM_TF_TL_M1
   if(UseDowTrendline && g_dowState.active && g_dowState.projectedPrice > 0)
   {
      int d = g_dowState.isBearish ? -1 : 1;
      if(d == dirSign)
      {
         levels[n] = g_dowState.projectedPrice;
         prios[n]  = 3;
         names[n]  = "GOM_TF_TL_M1";
         n++;
      }
   }
   // 4) DISP_FVG_TRAIL
   if(g_dispTrailValid && g_dispTrailLevel > 0 && !g_dispTrailBroken)
   {
      // trail baissier → SELL, haussier → BUY (slope / dir)
      int trailDir = 0;
      if(g_dispTrailSlope < 0) trailDir = -1;
      else if(g_dispTrailSlope > 0) trailDir = 1;
      // si slope ~0, inférer: niveau sous prix = support BUY, au-dessus = RES SELL
      if(trailDir == 0)
         trailDir = (g_dispTrailLevel <= mid) ? 1 : -1;
      if(trailDir == dirSign)
      {
         levels[n] = g_dispTrailLevel;
         prios[n]  = 4;
         names[n]  = "DISP_FVG_TRAIL";
         n++;
      }
   }
   // 5) SR20 / Impulse 20 bars
   if(dirSign > 0 && g_impulseSupport20 > 0)
   {
      levels[n] = g_impulseSupport20;
      prios[n]  = 5;
      names[n]  = "SR20_SUP";
      n++;
   }
   if(dirSign < 0 && g_impulseResistance20 > 0)
   {
      levels[n] = g_impulseResistance20;
      prios[n]  = 5;
      names[n]  = "SR20_RES";
      n++;
   }

   if(n == 0) return false; // aucune structure → caller fera market direct

   // Choisir meilleur: priorité puis plus proche du prix (dans le bon sens)
   int best = -1;
   double bestScore = 1e100;
   for(int i = 0; i < n; i++)
   {
      double lv = levels[i];
      if(lv <= 0) continue;
      double dist = MathAbs(mid - lv);
      if(dist > maxDist) continue;
      // BUY: privilégier niveau <= prix (achat en pullback); SELL: >= prix
      bool sideOk = (dirSign > 0 && lv <= mid + touchPad) || (dirSign < 0 && lv >= mid - touchPad);
      if(!sideOk && dist > touchPad) continue;
      double score = (double)prios[i] * atr * 10.0 + dist;
      if(score < bestScore) { bestScore = score; best = i; }
   }
   if(best < 0) return false;

   double lv = NormalizeDouble(levels[best], dg);
   string src = names[best];
   double dist = MathAbs(mid - lv);
   double lot = CalculateLotSize();
   if(lot <= 0) return false;

   double slMult = 1.2, tpMult = 2.4;
   string cmtBase = "PERFECT " + src + " " + (dirSign > 0 ? "BUY" : "SELL") + " " + symTag;

   // Prix touche le niveau → MARKET
   if(dist <= touchPad)
   {
      double entry = 0, sl = 0, tp = 0;
      bool ok = false;
      if(dirSign > 0)
      {
         entry = ask;
         sl = NormalizeDouble(entry - atr * slMult, dg);
         tp = NormalizeDouble(entry + atr * tpMult, dg);
         if(!SMC_BuildIntelligentLevels(_Symbol, 1, lot, entry, sl, tp))
         { ReleaseOpenLock(); return false; }
         ok = trade.Buy(lot, _Symbol, entry, sl, tp, cmtBase + " MKT");
         if(!ok) ok = SafeTradeBuy(lot, _Symbol, entry, sl, tp, cmtBase + " MKT");
      }
      else
      {
         entry = bid;
         sl = NormalizeDouble(entry + atr * slMult, dg);
         tp = NormalizeDouble(entry - atr * tpMult, dg);
         if(!SMC_BuildIntelligentLevels(_Symbol, -1, lot, entry, sl, tp))
         { ReleaseOpenLock(); return false; }
         ok = trade.Sell(lot, _Symbol, entry, sl, tp, cmtBase + " MKT");
         if(!ok) ok = SafeTradeSell(lot, _Symbol, entry, sl, tp, cmtBase + " MKT");
      }
      if(ok)
      {
         RegisterOrderPlaced();
         g_maxProfit = 0;
         Print("🚀 PERFECT STRUCTURE MARKET ", (dirSign > 0 ? "BUY" : "SELL"), " ", _Symbol,
               " @", DoubleToString(entry, dg), " | ", src, " lv=", DoubleToString(lv, dg),
               " dist=", DoubleToString(dist, dg), " | vn=", g_smcGomVerdictNum);
         return true;
      }
      return false;
   }

   // Sinon LIMIT au niveau structure
   SMC_CancelAllPendingLimitsForPerfect(_Symbol);
   MqlTradeRequest req; MqlTradeResult res;
   ZeroMemory(req); ZeroMemory(res);
   req.action    = TRADE_ACTION_PENDING;
   req.symbol    = _Symbol;
   req.volume    = lot;
   req.type      = (dirSign > 0) ? ORDER_TYPE_BUY_LIMIT : ORDER_TYPE_SELL_LIMIT;
   req.price     = lv;
   req.deviation = 20;
   req.magic     = InpMagicNumber;
   req.comment   = cmtBase + " LIM";
   if(dirSign > 0)
   {
      req.sl = NormalizeDouble(lv - atr * slMult, dg);
      req.tp = NormalizeDouble(lv + atr * tpMult, dg);
      SMC_CapSLToMaxLossUSD(_Symbol, 1, lv, lot, req.sl);
   }
   else
   {
      req.sl = NormalizeDouble(lv + atr * slMult, dg);
      req.tp = NormalizeDouble(lv - atr * tpMult, dg);
      SMC_CapSLToMaxLossUSD(_Symbol, -1, lv, lot, req.sl);
   }
   if(!SMC_BuildIntelligentLevels(_Symbol, dirSign, lot, req.price, req.sl, req.tp))
   {
      Print("🚫 PERFECT structure LIMIT — niveaux SL/TP intelligents invalides | ", src);
      return false;
   }
   if(!ValidateAndAdjustLimitPrice(req.price, req.sl, req.tp, req.type))
      return false;
   if(OrderSend(req, res) && res.order > 0)
   {
      RegisterOrderPlaced();
      Print("📌 PERFECT STRUCTURE LIMIT ", (dirSign > 0 ? "BUY" : "SELL"), " ", _Symbol,
            " @", DoubleToString(req.price, dg), " | ", src, " | vn=", g_smcGomVerdictNum);
      return true;
   }
   Print("❌ PERFECT structure LIMIT fail ", res.retcode, " ", res.comment, " | ", src);
   return false;
}

void SMC_CancelAllPendingLimitsForPerfect(const string symbol)
{
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(!OrderSelect(ticket)) continue;
      if(OrderGetString(ORDER_SYMBOL) != symbol) continue;
      if((ulong)OrderGetInteger(ORDER_MAGIC) != (ulong)InpMagicNumber) continue;
      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(t != ORDER_TYPE_BUY_LIMIT && t != ORDER_TYPE_SELL_LIMIT &&
         t != ORDER_TYPE_BUY_STOP  && t != ORDER_TYPE_SELL_STOP) continue;
      string cmt = OrderGetString(ORDER_COMMENT);
      Print("🗑️ PERFECT: annule LIMIT #", ticket, " ", EnumToString(t), " | ", cmt, " | ", symbol);
      if(!trade.OrderDelete(ticket))
         Print("❌ Delete LIMIT fail #", ticket, " err=", GetLastError());
   }
}

void ExecuteGOMForceMarketOrder()
{
   if(BlockAllTrades) return;
   if(!g_smcGomConnected) return;
   if(CountPositionsForSymbol(_Symbol) > 0) return;

   // GOOD (2) ou PERFECT (3+) uniquement pour ce mode ENTER
   if(MathAbs(g_smcGomVerdictNum) < 2) { SMC_ClearGOMEnterLabel(); return; }

   int dirSign = (g_smcGomVerdictNum > 0) ? 1 : -1;

   bool isBoom  = IsBoomLikeSymbol(_Symbol);
   bool isCrash = IsCrashLikeSymbol(_Symbol);
   bool isFlip  = SMC_IsFlipStyleSymbol(_Symbol);
   bool isSpike = (isBoom || isCrash || isFlip || SMC_IsSpikeStyleSymbol(_Symbol));
   bool isPerfect = (MathAbs(g_smcGomVerdictNum) >= 3);
   string verdictLevel = isPerfect ? "PERFECT" : "GOOD";
   bool softGates = isPerfect;

   // Direction native uniquement (seules limites même en PERFECT)
   if(isBoom && dirSign < 0)  { SMC_ClearGOMEnterLabel(); return; }
   if(isCrash && dirSign > 0) { SMC_ClearGOMEnterLabel(); return; }
   if(!IsDirectionAllowedForBoomCrash(_Symbol, dirSign > 0 ? "BUY" : "SELL"))
   { SMC_ClearGOMEnterLabel(); return; }

   // Label ENTER seulement si décision unifiée OK (évite ENTER BUY sous WAIT/MIXED)
   {
      string lw = "";
      if(SMC_UnifiedFinalDecision(_Symbol, dirSign, isPerfect ? "PERFECT" : "MARKET", lw))
         SMC_DrawGOMEnterLabel(dirSign, verdictLevel);
      else
         SMC_ClearGOMEnterLabel();
   }

   // ══════════════════════════════════════════════════════════════════
   // v1.28 PERFECT BUY/SELL → MARKET IMMÉDIAT
   // Pas d'attente zone / DISP / structure / H1 / SpikeConfirmStrict
   // ══════════════════════════════════════════════════════════════════
   if(isPerfect)
   {
      static datetime s_lastPerfect = 0;
      if(TimeCurrent() - s_lastPerfect < 12) return;
      if(CountPositionsForSymbol(_Symbol) > 0) { SMC_ClearGOMEnterLabel(); return; }
      if(IsTerminalFull()) return;

      // v1.29: même PERFECT — pas de range/consol/retrace; TF essentielles alignées
      {
         string tw = "";
         if(!SMC_TrendOnlyEntryAllowed(dirSign, tw))
         {
            static datetime s_tr = 0;
            if(TimeCurrent() - s_tr >= 20)
            {
               s_tr = TimeCurrent();
               Print("🚫 PERFECT bloqué — pas tendance claire | ", tw, " | ", _Symbol);
            }
            return;
         }
      }

      // v1.31: même langage que tout le reste
      {
         string uwhy = "";
         if(!SMC_UnifiedFinalDecision(_Symbol, dirSign, "PERFECT", uwhy))
         {
            static datetime s_up = 0;
            if(TimeCurrent() - s_up >= 20)
            {
               s_up = TimeCurrent();
               Print("🚫 PERFECT [UNIFIED] — ", uwhy, " | ", _Symbol);
            }
            SMC_ClearGOMEnterLabel();
            return;
         }
      }
      if(!TryAcquireOpenLock()) return;

      string symTag = isBoom ? "BOOM" : (isCrash ? "CRASH" : (isFlip ? "FLIP" : "SYM"));

      // 1) Priorité structure: DOW Proj → DOW EP → TF_TL → DISP trail → SR20
      if(SMC_PerfectStructurePriorityEntry(dirSign, symTag))
      {
         s_lastPerfect = TimeCurrent();
         ReleaseOpenLock();
         if(UseNotifications)
         {
            Alert("🚀 PERFECT STRUCT ", (dirSign > 0 ? "BUY" : "SELL"), " ", _Symbol);
            SendNotification("🚀 PERFECT STRUCT " + (dirSign > 0 ? "BUY" : "SELL") + " " + _Symbol);
         }
         return;
      }

      // 2) Fallback market si aucune structure utilisable
      if(CountOrdersForSymbol(_Symbol) > 0)
         SMC_CancelAllPendingLimitsForPerfect(_Symbol);

      double atrVal = 0;
      if(atrHandle != INVALID_HANDLE)
      {
         double atrBuf[]; ArraySetAsSeries(atrBuf, true);
         if(CopyBuffer(atrHandle, 0, 0, 1, atrBuf) >= 1) atrVal = atrBuf[0];
      }
      if(atrVal <= 0) atrVal = _Point * 50;
      int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
      double lot = CalculateLotSize();
      if(lot <= 0) { ReleaseOpenLock(); return; }

      double slMult = 1.2, tpMult = 2.4;
      bool ok = false;
      double entry = 0, sl = 0, tp = 0;
      string cmt = "GOM PERFECT " + (dirSign > 0 ? "BUY" : "SELL") + " " + symTag + " INSTANT";

      if(dirSign > 0)
      {
         entry = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
         sl = NormalizeDouble(entry - atrVal * slMult, dg);
         tp = NormalizeDouble(entry + atrVal * tpMult, dg);
         if(!SMC_BuildIntelligentLevels(_Symbol, 1, lot, entry, sl, tp))
         { ReleaseOpenLock(); return; }
         ok = trade.Buy(lot, _Symbol, entry, sl, tp, cmt);
         if(!ok) ok = SafeTradeBuy(lot, _Symbol, entry, sl, tp, cmt);
      }
      else
      {
         entry = SymbolInfoDouble(_Symbol, SYMBOL_BID);
         sl = NormalizeDouble(entry + atrVal * slMult, dg);
         tp = NormalizeDouble(entry - atrVal * slMult, dg);
         if(!SMC_BuildIntelligentLevels(_Symbol, -1, lot, entry, sl, tp))
         { ReleaseOpenLock(); return; }
         ok = trade.Sell(lot, _Symbol, entry, sl, tp, cmt);
         if(!ok) ok = SafeTradeSell(lot, _Symbol, entry, sl, tp, cmt);
      }
      ReleaseOpenLock();
      if(ok)
      {
         s_lastPerfect = TimeCurrent();
         RegisterOrderPlaced();
         g_maxProfit = 0;
         Print("🚀 PERFECT MARKET INSTANT (no struct) ", (dirSign > 0 ? "BUY" : "SELL"), " ", _Symbol,
               " @", DoubleToString(entry, dg), " | vn=", g_smcGomVerdictNum);
      }
      else
         Print("❌ PERFECT market fail | ", cmt, " err=", GetLastError());
      return;
   }

   // ── Chemin GOOD uniquement (filtres stricts) ──────────────────────
   // FlipX: éviter market contre H1 clair
   if(isFlip)
   {
      bool h1Against = (dirSign > 0 && SMC_ScalpTfDirIsBear(g_smcTfH1Dir))
                    || (dirSign < 0 && SMC_ScalpTfDirIsBull(g_smcTfH1Dir));
      if(h1Against)
      {
         static datetime s_flipH1 = 0;
         if(TimeCurrent() - s_flipH1 >= 25)
         {
            s_flipH1 = TimeCurrent();
            Print("🚫 GOM ENTER FlipX bloqué — H1 contre (", g_smcTfH1Dir, ") dir=",
                  (dirSign > 0 ? "BUY" : "SELL"), " | attendre PERFECT ou H1 aligné");
         }
         return;
      }
   }

   string absWhy = "";
   if(!SMC_AbsoluteNoTradeAgainstGOM(_Symbol, dirSign, absWhy))
   {
      Print("🚫 GOM ENTER AbsoluteGOM | ", absWhy, " | ", _Symbol);
      return;
   }
   if(UseGOMVerdictFilter && !CanPlaceOrderByGOM(_Symbol, dirSign, "GOM_ENTER"))
      return;

   string zoneReason = "";
   bool zoneOk = SMC_ZoneAllowsDirection(dirSign, zoneReason) && !SMC_GomZoneConflict();
   if(!zoneOk)
   {
      static datetime s_zn = 0;
      if(TimeCurrent() - s_zn >= 20)
      { s_zn = TimeCurrent(); Print("🚫 GOM ENTER ZONE | ", zoneReason, " vn=", g_smcGomVerdictNum); }
      return;
   }

   string trailReason = "";
   bool trailOk = SMC_DispFVGTrailAllowsEntry(dirSign, trailReason);
   if(!trailOk)
   {
      static datetime s_tr = 0;
      if(TimeCurrent() - s_tr >= 20)
      { s_tr = TimeCurrent(); Print("🚫 GOM ENTER DISP | ", trailReason); }
      return;
   }

   double atrVal = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double atrBuf[]; ArraySetAsSeries(atrBuf, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, atrBuf) >= 1) atrVal = atrBuf[0];
   }
   if(atrVal <= 0) atrVal = _Point * 50;

   string structSrc = "";
   bool hasStruct = SMC_GOMEnterHasStructure(dirSign, atrVal, structSrc);
   if(!hasStruct)
   {
      static datetime s_st = 0;
      if(TimeCurrent() - s_st >= 15)
      {
         s_st = TimeCurrent();
         Print("⏳ GOM ENTER GOOD attend structure | dir=",
               (dirSign > 0 ? "BUY" : "SELL"));
      }
      return;
   }

   static datetime s_lastForce = 0;
   if(TimeCurrent() - s_lastForce < 25) return;
   if(!CanTradeOnSymbol(_Symbol)) return;
   if(!TryAcquireOpenLock()) return;

   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double lot = CalculateLotSize();
   if(lot <= 0) { ReleaseOpenLock(); return; }

   double slMult = 1.2, tpMult = 2.4;
   bool ok = false;
   double entry = 0, sl = 0, tp = 0;
   string symTag = isBoom ? "BOOM" : (isCrash ? "CRASH" : (isFlip ? "FLIP" : "SYM"));
   string cmt = "GOM GOOD " + (dirSign > 0 ? "BUY" : "SELL") + " " + symTag + " " + structSrc;

   if(dirSign > 0)
   {
      entry = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      sl = NormalizeDouble(entry - atrVal * slMult, dg);
      tp = NormalizeDouble(entry + atrVal * tpMult, dg);
      SMC_CapSLToMaxLossUSD(_Symbol, 1, entry, lot, sl);
      ok = SMC_GatedTradeBuy(lot, _Symbol, entry, sl, tp, cmt);
   }
   else
   {
      entry = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      sl = NormalizeDouble(entry + atrVal * slMult, dg);
      tp = NormalizeDouble(entry - atrVal * tpMult, dg);
      SMC_CapSLToMaxLossUSD(_Symbol, -1, entry, lot, sl);
      ok = SMC_GatedTradeSell(lot, _Symbol, entry, sl, tp, cmt);
   }
   ReleaseOpenLock();

   if(ok)
   {
      s_lastForce = TimeCurrent();
      RegisterOrderPlaced();
      g_maxProfit = 0;
      Print("🚀 GOM ENTER MARKET ", (dirSign > 0 ? "BUY" : "SELL"), " ", _Symbol,
            " [", symTag, "] @", DoubleToString(entry, dg),
            " | ", verdictLevel, " vn=", g_smcGomVerdictNum,
            " | struct=", structSrc,
            " | SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg),
            " | trailing=", (UseTrailingStop ? "ON" : "OFF"));
      if(UseNotifications)
      {
         Alert("🚀 ENTER ", (dirSign > 0 ? "BUY" : "SELL"), " ", _Symbol, " ", verdictLevel, " ", symTag);
         SendNotification("🚀 ENTER " + (dirSign > 0 ? "BUY" : "SELL") + " " + _Symbol + " " + verdictLevel + " " + symTag);
      }
   }
   else
      Print("❌ GOM ENTER OrderSend échoué | ", cmt, " | err=", GetLastError());
}

bool SMC_GOMAllowsScalpOrReentry(const int dirSign)
{
   if(!g_smcGomConnected || dirSign == 0) return false;
   int vn = g_smcGomVerdictNum;
   if((dirSign > 0 && vn <= 0) || (dirSign < 0 && vn >= 0)) return false;

   // GOOD / PERFECT
   if(MathAbs(vn) >= MinGOMVerdictNumAbs) return true;

   // SIMPLE BUY/SELL (|vn|==1) : exiger M5 + H1 alignés + global
   if(MathAbs(vn) >= 1)
   {
      bool m5h1 = SMC_M5H1PreciseAligned(dirSign);
      bool glob = SMC_GlobalTrendAligned(dirSign);
      if(m5h1 && glob)
      {
         static datetime s_simpleOk = 0;
         if(TimeCurrent() - s_simpleOk >= 40)
         {
            s_simpleOk = TimeCurrent();
            Print("✅ SCALP SIMPLE autorisé vn=", vn, " M5+H1+Global alignés dir=", dirSign);
         }
         return true;
      }
   }
   return false;
}


void SMC_CountTfMajority(int &bulls, int &bears)
{
   bulls = 0; bears = 0;
   string tf[7];
   tf[0]=g_smcTfM1Dir; tf[1]=g_smcTfM5Dir; tf[2]=g_smcTfM15Dir;
   tf[3]=g_smcTfH1Dir; tf[4]=g_smcTfH4Dir; tf[5]=g_smcTfD1Dir; tf[6]=g_smcTfH4Dir;
   for(int i=0;i<7;i++){ string d=tf[i]; StringToUpper(d);
      if(d=="BULL"||d=="BUY"||d=="UP") bulls++;
      if(d=="BEAR"||d=="SELL"||d=="DOWN") bears++; }
}

void SMC_CancelStaleLimitOrders(const int maxAgeSec = 1200)
{
   datetime now = TimeCurrent();
   // Plancher 20 min même si l'appelant passe une valeur plus basse
   int minAge = MathMax(MathMax(1200, LimitCancelMinAgeSec), maxAgeSec);
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      ulong ticket=OrderGetTicket(i); if(ticket==0) continue;
      if(OrderGetInteger(ORDER_MAGIC)!=InpMagicNumber) continue;
      ENUM_ORDER_TYPE t=(ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(t!=ORDER_TYPE_BUY_LIMIT && t!=ORDER_TYPE_SELL_LIMIT) continue;
      datetime setup=(datetime)OrderGetInteger(ORDER_TIME_SETUP);
      if(setup<=0) continue;
      int age=(int)(now-setup);
      if(age<minAge) continue;
      string sym=OrderGetString(ORDER_SYMBOL);
      string cmt=OrderGetString(ORDER_COMMENT);
      if(SMC_IsPriorityLimitComment(cmt)) continue; // v1.17d: priorité jamais expirée auto
      if(SMC_NeverCancelLimitsActive()) continue;
      if(trade.OrderDelete(ticket))
         Print("🗑️ LIMIT expiré ",age,"s ≥",minAge,"s | ",sym," #",ticket," | ",cmt);
   }
   CleanupExcessLimits(_Symbol, MathMax(1, MaxLimitOrdersTerminal));
}

bool SMC_GetTfTrendlineEntry(const int dirSign, double &entryOut, string &srcOut)
{
   entryOut=0; srcOut="";
   int dg=(int)SymbolInfoInteger(_Symbol,SYMBOL_DIGITS);
   double atr=0; double atrBuf[]; ArraySetAsSeries(atrBuf,true);
   if(atrHandle!=INVALID_HANDLE && CopyBuffer(atrHandle,0,0,1,atrBuf)>=1) atr=atrBuf[0];
   if(atr<=0) atr=_Point*50;
   if(UseDowTrendline && g_dowState.active && g_dowState.projectedPrice>0)
   {
      int dowDir=g_dowState.isBearish?-1:1;
      if(dowDir==dirSign){ entryOut=NormalizeDouble(g_dowState.projectedPrice,dg); srcOut="DOW_TF_TL"; return true; }
   }
   if(dirSign>0){ int idx=iLowest(_Symbol,PERIOD_M5,MODE_LOW,20,1);
      if(idx>=0){ entryOut=NormalizeDouble(iLow(_Symbol,PERIOD_M5,idx),dg); srcOut="M5_TL_SUP"; } }
   else if(dirSign<0){ int idx=iHighest(_Symbol,PERIOD_M5,MODE_HIGH,20,1);
      if(idx>=0){ entryOut=NormalizeDouble(iHigh(_Symbol,PERIOD_M5,idx),dg); srcOut="M5_TL_RES"; } }
   if(entryOut>0){
      if(dirSign>0){ int idxH=iLowest(_Symbol,PERIOD_H1,MODE_LOW,12,1);
         if(idxH>=0){ double h1=iLow(_Symbol,PERIOD_H1,idxH);
            if(MathAbs(h1-entryOut)<=atr*1.2){ entryOut=NormalizeDouble(h1,dg); srcOut="H1_M5_TL_SUP"; }}}
      else { int idxH=iHighest(_Symbol,PERIOD_H1,MODE_HIGH,12,1);
         if(idxH>=0){ double h1=iHigh(_Symbol,PERIOD_H1,idxH);
            if(MathAbs(h1-entryOut)<=atr*1.2){ entryOut=NormalizeDouble(h1,dg); srcOut="H1_M5_TL_RES"; }}}
   }
   return (entryOut>0);
}

void SMC_PlaceBestTfTrendLimits()
{
   if(BlockAllTrades) return;
   if(!SMC_IsSpikeStyleSymbol(_Symbol) && SMC_GetSymbolCategory(_Symbol)!=SYM_VOLATILITY) return;
   SMC_CancelStaleLimitOrders(1200);
   int dirSign=0;
   if(g_smcGomConnected && g_smcGomVerdictNum!=0)
      dirSign=(g_smcGomVerdictNum>0)?1:-1;
   else { int b=0,s=0; SMC_CountTfMajority(b,s); if(b>=5) dirSign=1; else if(s>=5) dirSign=-1; }
   if(dirSign==0) return;
   if(IsBoomLikeSymbol(_Symbol)&&dirSign<0) return;
   if(IsCrashLikeSymbol(_Symbol)&&dirSign>0) return;
   if(!SMC_ScalpAllowLimitAgainstTf(dirSign))
   {
      static datetime s_tftlLog = 0;
      if(TimeCurrent() - s_tftlLog >= 30)
      {
         s_tftlLog = TimeCurrent();
         Print("🚫 TF_TL LIMIT bloqué — contre M5/H1 sans GOM PERFECT | dir=", dirSign);
      }
      return;
   }
   if(!CanPlaceLimitOrder(_Symbol, dirSign>0?ORDER_TYPE_BUY_LIMIT:ORDER_TYPE_SELL_LIMIT)) return;
   double entry=0; string src="";
   if(!SMC_GetTfTrendlineEntry(dirSign,entry,src)) return;
   double bid=SymbolInfoDouble(_Symbol,SYMBOL_BID);
   double ask=SymbolInfoDouble(_Symbol,SYMBOL_ASK);
   int dg=(int)SymbolInfoInteger(_Symbol,SYMBOL_DIGITS);
   double atr=0; double atrBuf[]; ArraySetAsSeries(atrBuf,true);
   if(atrHandle!=INVALID_HANDLE && CopyBuffer(atrHandle,0,0,1,atrBuf)>=1) atr=atrBuf[0];
   if(atr<=0) atr=_Point*50;
   if(dirSign>0 && entry>=ask) entry=NormalizeDouble(ask-atr*0.15,dg);
   if(dirSign<0 && entry<=bid) entry=NormalizeDouble(bid+atr*0.15,dg);
   if(entry<=0) return;
   for(int i=OrdersTotal()-1;i>=0;i--){
      ulong ticket=OrderGetTicket(i); if(ticket==0) continue;
      if(OrderGetString(ORDER_SYMBOL)!=_Symbol) continue;
      if(OrderGetInteger(ORDER_MAGIC)!=InpMagicNumber) continue;
      ENUM_ORDER_TYPE t=(ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(t!=ORDER_TYPE_BUY_LIMIT && t!=ORDER_TYPE_SELL_LIMIT) continue;
      if(MathAbs(OrderGetDouble(ORDER_PRICE_OPEN)-entry)<=atr*0.25) return;
   }
   MqlTradeRequest req={}; MqlTradeResult res={};
   req.action=TRADE_ACTION_PENDING; req.symbol=_Symbol;
   req.volume=NormalizeVolumeForSymbol(0.01); req.magic=InpMagicNumber; req.price=entry;
   if(dirSign>0){ req.type=ORDER_TYPE_BUY_LIMIT;
      req.sl=NormalizeDouble(entry-atr*ImpulseZoneSL_ATRMult,dg);
      req.tp=NormalizeDouble(entry+atr*ImpulseZoneTP_ATRMult,dg);
      req.comment="TF_TL BUY "+src; }
   else { req.type=ORDER_TYPE_SELL_LIMIT;
      req.sl=NormalizeDouble(entry+atr*ImpulseZoneSL_ATRMult,dg);
      req.tp=NormalizeDouble(entry-atr*ImpulseZoneTP_ATRMult,dg);
      req.comment="TF_TL SELL "+src; }
   if(!SMC_BuildIntelligentLevels(_Symbol, dirSign, req.volume, req.price, req.sl, req.tp))
   {
      Print("🚫 TF_TL LIMIT — niveaux SL/TP intelligents invalides | ", src);
      return;
   }
   CleanupExcessLimits(_Symbol, MathMax(1,MaxLimitOrdersTerminal));
   if(!ValidateAndAdjustLimitPrice(req.price,req.sl,req.tp,req.type)) return;
   if(trade.OrderSend(req,res))
      Print("✅ TF_TL LIMIT ",(dirSign>0?"BUY":"SELL")," ",_Symbol," @",req.price," src=",src," vn=",g_smcGomVerdictNum," | TTL 10min");
   else Print("❌ TF_TL LIMIT fail ",res.retcode," ",res.comment);
}

void PlaceSRLimitOrders20Bars()
{
    if(!UseSR20BarLimits || BlockAllTrades) return;
    if(Dow_IsDowOnlyLimitMode()) return;

    // v1.17d: WAIT ne supprime PLUS les SR20 (priorité — restent jusqu'au fill)
    if(!g_smcGomConnected || g_smcGomVerdictNum == 0)
    {
       if(SMC_NeverCancelLimitsActive() || NeverCancelPriorityLimits)
       {
          // garder SR20 existants ; pas de nouveau placement sans direction GOM
          return;
       }
       for(int i = OrdersTotal() - 1; i >= 0; i--)
       {
          ulong ticket = OrderGetTicket(i);
          if(ticket == 0) continue;
          if(OrderGetString(ORDER_SYMBOL) != _Symbol) continue;
          if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
          if(StringFind(OrderGetString(ORDER_COMMENT), "SR20") < 0) continue;
          trade.OrderDelete(ticket);
          Print("🗑️ SR20 annulé — GOM WAIT");
       }
       return;
    }
    if(MathAbs(g_smcGomVerdictNum) < MinGOMVerdictNumAbs)
    {
       int dS = (g_smcGomVerdictNum > 0) ? 1 : -1;
       if(!SMC_GOMAllowsScalpOrReentry(dS)) return;
    }
    SMC_UpdatePreciseZones();
    if(SMC_PriceIsInBlockedRetraceZone()) return;

    MqlRates rates[];
    ArraySetAsSeries(rates, true);
    if(CopyRates(_Symbol, PERIOD_CURRENT, 0, 25, rates) < 20) return;

   double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   int    dg    = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);

   double atrVal = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double atr[];
      ArraySetAsSeries(atr, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, atr) >= 1) atrVal = atr[0];
   }
   if(atrVal <= 0) atrVal = (SymbolInfoDouble(_Symbol, SYMBOL_ASK) - price) * 2.0;
   if(atrVal <= 0) return;

   // ── Compter SEULEMENT nos ordres SR20 existants (pas les EMA SMC, etc.) ──
   int sr20BuyExists = 0, sr20SellExists = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) != _Symbol) continue;
      if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      string cmt = OrderGetString(ORDER_COMMENT);
      if(StringFind(cmt, "SR20") < 0) continue;
      ENUM_ORDER_TYPE ot = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(ot == ORDER_TYPE_BUY_LIMIT)  sr20BuyExists++;
      if(ot == ORDER_TYPE_SELL_LIMIT) sr20SellExists++;
   }
   int sr20Total = sr20BuyExists + sr20SellExists;
   if(sr20Total >= SR20BarMaxOrders) return;

   // ── Détection pivot highs / lows sur 20 bars ──
   double supports[], resistances[];
   ArrayResize(supports, 0);
   ArrayResize(resistances, 0);

   for(int i = 2; i < 18; i++)
   {
      // Pivot Low (support): low[i] < low[i-1] et low[i] < low[i+1]
      if(rates[i].low < rates[i-1].low && rates[i].low < rates[i+1].low &&
         rates[i].low < rates[i-2].low && rates[i].low < rates[i+2].low)
      {
         int sz = ArraySize(supports);
         ArrayResize(supports, sz + 1);
         supports[sz] = rates[i].low;
      }
      // Pivot High (resistance): high[i] > high[i-1] et high[i] > high[i+1]
      if(rates[i].high > rates[i-1].high && rates[i].high > rates[i+1].high &&
         rates[i].high > rates[i-2].high && rates[i].high > rates[i+2].high)
      {
         int sz = ArraySize(resistances);
         ArrayResize(resistances, sz + 1);
         resistances[sz] = rates[i].high;
      }
   }

   if(ArraySize(supports) == 0 && ArraySize(resistances) == 0) return;

   // ── Choisir le support et la résistance les plus proches ──
   double bestSupport = 0, bestResistance = 0;
   double minDistSupport = 999 * atrVal, minDistResistance = 999 * atrVal;

   for(int i = 0; i < ArraySize(supports); i++)
   {
      if(supports[i] < price && supports[i] > 0)
      {
         double dist = price - supports[i];
         if(dist < minDistSupport && dist < atrVal * SR20BarMaxDistATR)
         {
            minDistSupport = dist;
            bestSupport = supports[i];
         }
      }
   }

   for(int i = 0; i < ArraySize(resistances); i++)
   {
      if(resistances[i] > price && resistances[i] > 0)
      {
         double dist = resistances[i] - price;
         if(dist < minDistResistance && dist < atrVal * SR20BarMaxDistATR)
         {
            minDistResistance = dist;
            bestResistance = resistances[i];
         }
      }
   }

    Print("📊 SR20 Pivots: ", ArraySize(supports), " supports, ", ArraySize(resistances),
          " resistances | Best: S=", DoubleToString(bestSupport, dg),
          " R=", DoubleToString(bestResistance, dg),
          " | Price=", DoubleToString(price, dg),
          " | SR20 orders: ", sr20Total, "/", SR20BarMaxOrders);

    // ── Dessiner les lignes S/R 20 bars sur le graphique ──
    datetime now = TimeCurrent();
    datetime future = now + PeriodSeconds(PERIOD_CURRENT) * 200;

    string supName  = "SR20_Support_"   + _Symbol;
    string resName  = "SR20_Resistance_" + _Symbol;
    string supLabel = "SR20_SUP_LABEL_" + _Symbol;
    string resLabel = "SR20_RES_LABEL_" + _Symbol;

    // Support: ligne blanche épaisse pleine
    if(bestSupport > 0)
    {
       ObjectDelete(0, supName);
       if(ObjectCreate(0, supName, OBJ_TREND, 0, now, bestSupport, future, bestSupport))
       {
          ObjectSetInteger(0, supName, OBJPROP_COLOR, clrWhite);
          ObjectSetInteger(0, supName, OBJPROP_WIDTH, 3);
          ObjectSetInteger(0, supName, OBJPROP_STYLE, STYLE_SOLID);
          ObjectSetInteger(0, supName, OBJPROP_RAY_RIGHT, false);
          ObjectSetInteger(0, supName, OBJPROP_BACK, false);
          ObjectSetString(0, supName, OBJPROP_TEXT, "SR20 Support");
       }
       // Label
       ObjectDelete(0, supLabel);
       if(ObjectCreate(0, supLabel, OBJ_TEXT, 0, now, bestSupport))
       {
          ObjectSetString(0, supLabel, OBJPROP_TEXT, "SR20 ▲ " + DoubleToString(bestSupport, dg));
          ObjectSetInteger(0, supLabel, OBJPROP_COLOR, clrWhite);
          ObjectSetInteger(0, supLabel, OBJPROP_FONTSIZE, 8);
          ObjectSetString(0, supLabel, OBJPROP_FONT, "Arial Bold");
       }
    }
    else
    {
       ObjectDelete(0, supName);
       ObjectDelete(0, supLabel);
    }

    // Résistance: ligne blanche épaisse pleine
    if(bestResistance > 0)
    {
       ObjectDelete(0, resName);
       if(ObjectCreate(0, resName, OBJ_TREND, 0, now, bestResistance, future, bestResistance))
       {
          ObjectSetInteger(0, resName, OBJPROP_COLOR, clrWhite);
          ObjectSetInteger(0, resName, OBJPROP_WIDTH, 3);
          ObjectSetInteger(0, resName, OBJPROP_STYLE, STYLE_SOLID);
          ObjectSetInteger(0, resName, OBJPROP_RAY_RIGHT, false);
          ObjectSetInteger(0, resName, OBJPROP_BACK, false);
          ObjectSetString(0, resName, OBJPROP_TEXT, "SR20 Resistance");
       }
       // Label
       ObjectDelete(0, resLabel);
       if(ObjectCreate(0, resLabel, OBJ_TEXT, 0, now, bestResistance))
       {
          ObjectSetString(0, resLabel, OBJPROP_TEXT, "SR20 ▼ " + DoubleToString(bestResistance, dg));
          ObjectSetInteger(0, resLabel, OBJPROP_COLOR, clrWhite);
          ObjectSetInteger(0, resLabel, OBJPROP_FONTSIZE, 8);
          ObjectSetString(0, resLabel, OBJPROP_FONT, "Arial Bold");
       }
    }
    else
    {
       ObjectDelete(0, resName);
       ObjectDelete(0, resLabel);
    }

   // ── Shift SR20: v1.17d ne pas annuler si priorité / NeverCancel ──
   if(SR20BarCancelOnShift && !SMC_NeverCancelLimitsActive() && !NeverCancelPriorityLimits
      && (bestSupport > 0 || bestResistance > 0))
   {
      for(int i = OrdersTotal() - 1; i >= 0; i--)
      {
         ulong ticket = OrderGetTicket(i);
         if(ticket == 0) continue;
         if(OrderGetString(ORDER_SYMBOL) != _Symbol) continue;
         if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
         string cmt = OrderGetString(ORDER_COMMENT);
         if(StringFind(cmt, "SR20") < 0) continue;

         ENUM_ORDER_TYPE otype = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
         double op = OrderGetDouble(ORDER_PRICE_OPEN);

         if(otype == ORDER_TYPE_BUY_LIMIT && bestSupport > 0 && MathAbs(op - bestSupport) > atrVal * 0.3)
         {
            trade.OrderDelete(ticket);
            sr20BuyExists--;
            Print("🔄 SR20 BUY_LIMIT annulé (shift): prix ", DoubleToString(op, dg),
                  " ≠ support ", DoubleToString(bestSupport, dg));
         }
         if(otype == ORDER_TYPE_SELL_LIMIT && bestResistance > 0 && MathAbs(op - bestResistance) > atrVal * 0.3)
         {
            trade.OrderDelete(ticket);
            sr20SellExists--;
            Print("🔄 SR20 SELL_LIMIT annulé (shift): prix ", DoubleToString(op, dg),
                  " ≠ résistance ", DoubleToString(bestResistance, dg));
         }
      }
   }

     // ── Placer BUY_LIMIT juste en dessous du support (spike rebond) ──
     // Sur Crash/Painx: PAS de BUY LIMIT (uniquement SELL)
     // DOW GATE: Si DOW Proj actif, n'autoriser que si DOW confirme la direction
     bool dowConfirmsBuy  = (!UseDowTrendline || (g_dowState.active && !g_dowState.isBearish));
     bool dowConfirmsSell = (!UseDowTrendline || (g_dowState.active && g_dowState.isBearish));
     bool dowInactive     = (UseDowTrendline && !g_dowState.active);
     bool gomAllowsBuy    = (!EnforceSingleDirection || g_smcGomVerdictNum > 0);
     bool gomAllowsSell   = (!EnforceSingleDirection || g_smcGomVerdictNum < 0);
     
     // Si DOW actif et ne confirme pas BUY → skip
     if(bestSupport > 0 && sr20BuyExists < 1 && sr20Total < SR20BarMaxOrders
        && !IsCrashLikeSymbol(_Symbol) && !dowInactive && dowConfirmsBuy && gomAllowsBuy
        && SMC_ScalpAllowLimitAgainstTf(1))
   {
       // Offset: 2 points sous le support pour capter le spike rebond
       double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
       if(tickSize <= 0) tickSize = point;
       double entry = NormalizeDouble(bestSupport - point * 2, dg);
      double sl    = NormalizeDouble(entry - atrVal * SR20BarSL_ATRMult, dg);
      double tp    = NormalizeDouble(entry + atrVal * SR20BarTP_ATRMult, dg);

      MqlTradeRequest req = {};
      MqlTradeResult  res = {};
      req.action   = TRADE_ACTION_PENDING;
      req.symbol   = _Symbol;
      req.volume   = NormalizeVolumeForSymbol(0.01);
      req.type     = ORDER_TYPE_BUY_LIMIT;
      req.price    = entry;
      req.sl       = sl;
      req.tp       = tp;
      req.magic    = InpMagicNumber;
       req.comment  = "SR20 BUY LIMIT";

        if(!CanPlaceLimitOrder(_Symbol, ORDER_TYPE_BUY_LIMIT)) { ReleaseOpenLock(); return; }
        if(!SMC_BuildIntelligentLevels(_Symbol, 1, req.volume, req.price, req.sl, req.tp))
        { ReleaseOpenLock(); return; }
        CleanupExcessLimits(_Symbol, 2);
        if(ValidateAndAdjustLimitPrice(req.price, req.sl, req.tp, ORDER_TYPE_BUY_LIMIT))
        {
           if(trade.OrderSend(req, res))
          {
             Print("📊 SR20 BUY_LIMIT @ ", req.price, " (support ", bestSupport,
                   ") | SL=", req.sl, " | TP=", req.tp, " | ATR=", DoubleToString(atrVal, dg));
             sr20BuyExists++;
             // WhatsApp SR20 signal
             SendSR20WhatsAppSignal("SR20_ENTRY", _Symbol, "BUY",
                                    req.price, req.sl, req.tp, price,
                                    bestSupport, "SUPPORT", atrVal,
                                    0, 0, "");
          }
          else
             Print("❌ SR20 BUY_LIMIT échoué: ", res.retcode, " - ", res.comment);
       }
   }

     // ── Placer SELL_LIMIT juste au-dessus de la résistance (spike rejet) ──
     // Sur Boom/Gainx: PAS de SELL LIMIT (uniquement BUY)
     if(bestResistance > 0 && sr20SellExists < 1 && sr20Total < SR20BarMaxOrders
        && !IsBoomLikeSymbol(_Symbol) && !dowInactive && dowConfirmsSell && gomAllowsSell
        && SMC_ScalpAllowLimitAgainstTf(-1))
   {
       double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
       if(tickSize <= 0) tickSize = point;
       double entry = NormalizeDouble(bestResistance + point * 2, dg);
      double sl    = NormalizeDouble(entry + atrVal * SR20BarSL_ATRMult, dg);
      double tp    = NormalizeDouble(entry - atrVal * SR20BarTP_ATRMult, dg);

      MqlTradeRequest req = {};
      MqlTradeResult  res = {};
      req.action   = TRADE_ACTION_PENDING;
      req.symbol   = _Symbol;
      req.volume   = NormalizeVolumeForSymbol(0.01);
      req.type     = ORDER_TYPE_SELL_LIMIT;
      req.price    = entry;
      req.sl       = sl;
      req.tp       = tp;
      req.magic    = InpMagicNumber;
       req.comment  = "SR20 SELL LIMIT";

        if(!CanPlaceLimitOrder(_Symbol, ORDER_TYPE_SELL_LIMIT)) { ReleaseOpenLock(); return; }
        if(!SMC_BuildIntelligentLevels(_Symbol, -1, req.volume, req.price, req.sl, req.tp))
        { ReleaseOpenLock(); return; }
        CleanupExcessLimits(_Symbol, 2);
        if(ValidateAndAdjustLimitPrice(req.price, req.sl, req.tp, ORDER_TYPE_SELL_LIMIT))
        {
           if(trade.OrderSend(req, res))
          {
             Print("📊 SR20 SELL_LIMIT @ ", req.price, " (résistance ", bestResistance,
                   ") | SL=", req.sl, " | TP=", req.tp, " | ATR=", DoubleToString(atrVal, dg));
             sr20SellExists++;
             // WhatsApp SR20 signal
             SendSR20WhatsAppSignal("SR20_ENTRY", _Symbol, "SELL",
                                    req.price, req.sl, req.tp, price,
                                    bestResistance, "RESISTANCE", atrVal,
                                    0, 0, "");
          }
         else
             Print("❌ SR20 SELL_LIMIT échoué: ", res.retcode, " - ", res.comment);
      }
   }

   // ══════════════════════════════════════════════════════════════════════
   // IMPULSE ZONE : niveau de forte impulsion 20 bars (spike trigger)
   // Utilise iLowest/iHighest sur 20 barres = extrêmes absolus
   // ══════════════════════════════════════════════════════════════════════
   if(!UseImpulseZone) return;

   ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(_Symbol);
   bool isSpikeSymbol = SMC_IsSpikeStyleSymbol(_Symbol);
   if(!isSpikeSymbol && !ImpulseZoneShowOnChart) return;

   // Calculer les extrêmes absolus sur 20 barres (pas les pivots, les VRAIS min/max)
   int lowestIdx  = iLowest(_Symbol, PERIOD_CURRENT, MODE_LOW, 20, 1);
   int highestIdx = iHighest(_Symbol, PERIOD_CURRENT, MODE_HIGH, 20, 1);

   if(lowestIdx < 0 || highestIdx < 0) return;

   g_impulseSupport20    = iLow(_Symbol, PERIOD_CURRENT, lowestIdx);
   g_impulseResistance20 = iHigh(_Symbol, PERIOD_CURRENT, highestIdx);

   // Buffer en price = ATR × multiplicateur
   g_impulseSupBuffer = atrVal * ImpulseZoneBufferATR;
   g_impulseResBuffer = atrVal * ImpulseZoneBufferATR;

   // Vérifier si le prix touche les zones
   g_impulseSupTouched  = (price <= g_impulseSupport20 + g_impulseSupBuffer);
   g_impulseResTouched  = (price >= g_impulseResistance20 - g_impulseResBuffer);

   // ── Dessiner les zones d'impulsion (rectangles colorés) ──
   if(ImpulseZoneShowOnChart)
   {
      datetime now = TimeCurrent();
      datetime future = now + PeriodSeconds(PERIOD_CURRENT) * 100;

      // Zone Support = vert semi-transparent
      string supZone = "IMPULSE_SUP_ZONE_" + _Symbol;
      string supLine = "IMPULSE_SUP_LINE_" + _Symbol;
      string supTxt  = "IMPULSE_SUP_TXT_" + _Symbol;

      if(g_impulseSupport20 > 0)
      {
         ObjectDelete(0, supZone);
         if(ObjectCreate(0, supZone, OBJ_RECTANGLE, 0, now, g_impulseSupport20 - g_impulseSupBuffer, future, g_impulseSupport20 + g_impulseSupBuffer))
         {
            ObjectSetInteger(0, supZone, OBJPROP_COLOR, g_impulseSupTouched ? clrLime : clrDarkGreen);
            ObjectSetInteger(0, supZone, OBJPROP_BACK, true);
            ObjectSetInteger(0, supZone, OBJPROP_FILL, true);
            ObjectSetInteger(0, supZone, OBJPROP_WIDTH, 1);
         }
         // Ligne centrale
         ObjectDelete(0, supLine);
         if(ObjectCreate(0, supLine, OBJ_TREND, 0, now, g_impulseSupport20, future, g_impulseSupport20))
         {
            ObjectSetInteger(0, supLine, OBJPROP_COLOR, clrLime);
            ObjectSetInteger(0, supLine, OBJPROP_WIDTH, 2);
            ObjectSetInteger(0, supLine, OBJPROP_STYLE, STYLE_SOLID);
            ObjectSetInteger(0, supLine, OBJPROP_RAY_RIGHT, false);
            ObjectSetInteger(0, supLine, OBJPROP_BACK, false);
         }
         // Label
         ObjectDelete(0, supTxt);
         if(ObjectCreate(0, supTxt, OBJ_TEXT, 0, now, g_impulseSupport20))
         {
            string touchTxt = g_impulseSupTouched ? " ⚡ IMPULSE!" : "";
            ObjectSetString(0, supTxt, OBJPROP_TEXT,
               "⚡ IMPULSE SUP " + DoubleToString(g_impulseSupport20, dg) + touchTxt);
            ObjectSetInteger(0, supTxt, OBJPROP_COLOR, g_impulseSupTouched ? clrLime : clrDarkGreen);
            ObjectSetInteger(0, supTxt, OBJPROP_FONTSIZE, 8);
            ObjectSetString(0, supTxt, OBJPROP_FONT, "Consolas Bold");
         }
      }

      // Zone Résistance = rouge semi-transparent
      string resZone = "IMPULSE_RES_ZONE_" + _Symbol;
      string resLine = "IMPULSE_RES_LINE_" + _Symbol;
      string resTxt  = "IMPULSE_RES_TXT_" + _Symbol;

      if(g_impulseResistance20 > 0)
      {
         ObjectDelete(0, resZone);
         if(ObjectCreate(0, resZone, OBJ_RECTANGLE, 0, now, g_impulseResistance20 - g_impulseResBuffer, future, g_impulseResistance20 + g_impulseResBuffer))
         {
            ObjectSetInteger(0, resZone, OBJPROP_COLOR, g_impulseResTouched ? clrRed : clrDarkRed);
            ObjectSetInteger(0, resZone, OBJPROP_BACK, true);
            ObjectSetInteger(0, resZone, OBJPROP_FILL, true);
            ObjectSetInteger(0, resZone, OBJPROP_WIDTH, 1);
         }
         // Ligne centrale
         ObjectDelete(0, resLine);
         if(ObjectCreate(0, resLine, OBJ_TREND, 0, now, g_impulseResistance20, future, g_impulseResistance20))
         {
            ObjectSetInteger(0, resLine, OBJPROP_COLOR, clrRed);
            ObjectSetInteger(0, resLine, OBJPROP_WIDTH, 2);
            ObjectSetInteger(0, resLine, OBJPROP_STYLE, STYLE_SOLID);
            ObjectSetInteger(0, resLine, OBJPROP_RAY_RIGHT, false);
            ObjectSetInteger(0, resLine, OBJPROP_BACK, false);
         }
         // Label
         ObjectDelete(0, resTxt);
         if(ObjectCreate(0, resTxt, OBJ_TEXT, 0, now, g_impulseResistance20))
         {
            string touchTxt = g_impulseResTouched ? " ⚡ IMPULSE!" : "";
            ObjectSetString(0, resTxt, OBJPROP_TEXT,
               "⚡ IMPULSE RES " + DoubleToString(g_impulseResistance20, dg) + touchTxt);
            ObjectSetInteger(0, resTxt, OBJPROP_COLOR, g_impulseResTouched ? clrRed : clrDarkRed);
            ObjectSetInteger(0, resTxt, OBJPROP_FONTSIZE, 8);
            ObjectSetString(0, resTxt, OBJPROP_FONT, "Consolas Bold");
         }
      }
   }

   // ── AUTO-TRADE IMPULSE ZONE (Boom/Crash/Painx/Gainx + Volatility optionnel) ──
   bool isVolSymbol = (cat == SYM_VOLATILITY);
   if(!ImpulseZoneAutoTrade) return;
   if(!isSpikeSymbol && !(ImpulseZoneAutoTradeVol && isVolSymbol)) return;
   // SR20 market actif: impulse quand même si GOM SIMPLE ou mieux
   if(SR20TouchMarketEntry && MathAbs(g_smcGomVerdictNum) < 1) return;
   if(CountPositionsForSymbol(_Symbol) > 0) return;
    // ── GOM WAIT / DÉCONNECTÉ: AUCUN ordre autorisé (toujours, même sans UseGOMVerdictFilter) ──
    if(!g_smcGomConnected || g_smcGomVerdictNum == 0)
    {
       static datetime s_lastImpulseBlock = 0;
       if(TimeCurrent() - s_lastImpulseBlock >= 30)
       {
          Print("❌ IMPULSE REJETÉ — GOM ",
                (!g_smcGomConnected ? "déconnecté" : "verdict=WAIT"),
                " — Aucun ordre autorisé");
          s_lastImpulseBlock = TimeCurrent();
       }
       return;
    }
    // SIMPLE autorisé si M5+H1+Global alignés (scalp impulse)
    if(MathAbs(g_smcGomVerdictNum) < MinGOMVerdictNumAbs)
    {
       int dImp = (g_smcGomVerdictNum > 0) ? 1 : ((g_smcGomVerdictNum < 0) ? -1 : 0);
       if(dImp == 0 || !SMC_GOMAllowsScalpOrReentry(dImp))
       {
          static datetime s_lastImpulseBlockSimple = 0;
          if(TimeCurrent() - s_lastImpulseBlockSimple >= 30)
          {
             Print("❌ IMPULSE REJETÉ — SIMPLE sans alignement M5/H1/Global vn=", g_smcGomVerdictNum);
             s_lastImpulseBlockSimple = TimeCurrent();
          }
          return;
       }
    }

   bool isBoom = IsBoomLikeSymbol(_Symbol);
   bool isCrash = IsCrashLikeSymbol(_Symbol);

   // Boom/Gainx → BUY si prix touche support impulse
   // Crash/Painx → SELL si prix touche résistance impulse
   // Volatility (FxVOL/SFXVOL/SFV) → direction GOM + touch support (BUY) / résistance (SELL)
   bool impulseBuy  = false;
   bool impulseSell = false;
   if(isSpikeSymbol)
   {
      impulseBuy  = (isBoom && g_impulseSupTouched && g_impulseSupport20 > 0);
      impulseSell = (isCrash && g_impulseResTouched && g_impulseResistance20 > 0);
      // Fallback non-Boom/Crash spike-style (rare): follow GOM
      if(!isBoom && !isCrash)
      {
         if(g_smcGomVerdictNum > 0 && g_impulseSupTouched) impulseBuy = true;
         if(g_smcGomVerdictNum < 0 && g_impulseResTouched) impulseSell = true;
      }
   }
   else if(isVolSymbol)
   {
      // Volatility: BUY sur support si GOM haussier, SELL sur résistance si GOM baissier
      if(g_smcGomVerdictNum > 0 && g_impulseSupTouched && g_impulseSupport20 > 0)
         impulseBuy = true;
      if(g_smcGomVerdictNum < 0 && g_impulseResTouched && g_impulseResistance20 > 0)
         impulseSell = true;
      // Si les deux zones touchées (range étroit), prioriser la direction GOM uniquement
   }

   if(!impulseBuy && !impulseSell) return;

   int impulseDir = impulseBuy ? 1 : -1;
   string scalpReasonImp = "";
   if(!SMC_ScalpDirectionClear(impulseDir, scalpReasonImp))
   {
      static datetime s_scalpImpLog = 0;
      if(TimeCurrent() - s_scalpImpLog >= 20)
      {
         s_scalpImpLog = TimeCurrent();
         Print("🚫 IMPULSE SCALP bloqué — ", scalpReasonImp, " | ", _Symbol,
               " ", (impulseBuy ? "BUY" : "SELL"));
      }
      return;
   }
   // Volatility: anti entrée trop tôt (même règles que Vol market)
   if(isVolSymbol)
   {
      string earlyImp = "";
      if(!SMC_VolEntryTimingOK(impulseDir, earlyImp))
      {
         static datetime s_impEarly = 0;
         if(TimeCurrent() - s_impEarly >= 20)
         {
            s_impEarly = TimeCurrent();
            Print("🚫 IMPULSE VOL TROP TÔT — ", earlyImp, " | ", _Symbol);
         }
         return;
      }
   }

   if(!TryAcquireOpenLock()) return;

    double lot = CalculateLotSize();
    if(lot <= 0) { ReleaseOpenLock(); return; }

    // ── GOM verdict != WAIT → exécuter le market order impulse ──
   // Bloquer si direction opposée au verdict GOM
   if(g_smcGomConnected)
   {
      if(impulseBuy && g_smcGomVerdictNum < 0)
      {
         Print("🚫 IMPULSE BUY BLOQUÉ — GOM verdict=", g_smcGomVerdict, " (vn=", g_smcGomVerdictNum, ") — direction SELL");
         ReleaseOpenLock(); return;
      }
      if(impulseSell && g_smcGomVerdictNum > 0)
      {
         Print("🚫 IMPULSE SELL BLOQUÉ — GOM verdict=", g_smcGomVerdict, " (vn=", g_smcGomVerdictNum, ") — direction BUY");
         ReleaseOpenLock(); return;
      }
   }
   bool orderOK = false;

   // GOOD/PERFECT: exécuter impulse sans A+ zone
   if(MathAbs(g_smcGomVerdictNum) < MinGOMVerdictNumAbs)
   {
      if(!SMC_APlusSetupOK(_Symbol, impulseDir))
      {
         static datetime s_aplusImpulseLog = 0;
         if(TimeCurrent() - s_aplusImpulseLog >= 20)
         {
            s_aplusImpulseLog = TimeCurrent();
            Print("🚫 IMPULSE ZONE BLOQUÉ par filtre A+ | ", _Symbol, " ", impulseBuy ? "BUY" : "SELL");
         }
         ReleaseOpenLock(); return;
      }
   }
   else
      Print("⚡ IMPULSE GO — GOM ", g_smcGomVerdict, " vn=", g_smcGomVerdictNum, " (A+ soft)");

if(impulseBuy)
     {
        if(!CanTradeOnSymbol(_Symbol)) { Print("🚫 IMPULSE BUY BLOQUÉ — Terminal plein ou ordre existant sur ", _Symbol); ReleaseOpenLock(); return; }
        double entry = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
        double sl = NormalizeDouble(entry - atrVal * ImpulseZoneSL_ATRMult, dg);
        double tp = NormalizeDouble(entry + atrVal * ImpulseZoneTP_ATRMult, dg);

        if(SMC_GatedTradeBuy(lot, _Symbol, entry, sl, tp, "IMPULSE BUY"))
       {
          RegisterOrderPlaced();
          orderOK = true;
          ulong ticket = trade.ResultOrder();
          if(ticket > 0) SMC_ApplyPostEntrySLBuffer(_Symbol, ticket, 1.0);
          Print("⚡ IMPULSE BUY ", _Symbol, " @", DoubleToString(entry, dg),
                " | Zone supp: ", DoubleToString(g_impulseSupport20, dg),
                " ±", DoubleToString(g_impulseSupBuffer, dg),
                " | GOM=", g_smcGomVerdict, " (vn=", g_smcGomVerdictNum, ")",
                " | SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg));
       }
    }
     else if(impulseSell)
     {
        if(!CanTradeOnSymbol(_Symbol)) { Print("🚫 IMPULSE SELL BLOQUÉ — Terminal plein ou ordre existant sur ", _Symbol); ReleaseOpenLock(); return; }
        double entry = SymbolInfoDouble(_Symbol, SYMBOL_BID);
        double sl = NormalizeDouble(entry + atrVal * ImpulseZoneSL_ATRMult, dg);
        double tp = NormalizeDouble(entry - atrVal * ImpulseZoneTP_ATRMult, dg);

        if(SMC_GatedTradeSell(lot, _Symbol, entry, sl, tp, "IMPULSE SELL"))
       {
          RegisterOrderPlaced();
          orderOK = true;
          ulong ticket = trade.ResultOrder();
          if(ticket > 0) SMC_ApplyPostEntrySLBuffer(_Symbol, ticket, 1.0);
          Print("⚡ IMPULSE SELL ", _Symbol, " @", DoubleToString(entry, dg),
                " | Zone res: ", DoubleToString(g_impulseResistance20, dg),
                " ±", DoubleToString(g_impulseResBuffer, dg),
                " | GOM=", g_smcGomVerdict, " (vn=", g_smcGomVerdictNum, ")",
                " | SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg));
       }
    }

   ReleaseOpenLock();

   if(orderOK)
   {
      g_maxProfit = 0;
      if(UseNotifications)
      {
         string dir = impulseBuy ? "BUY" : "SELL";
         Alert("⚡ IMPULSE ", dir, " ", _Symbol);
         SendNotification("⚡ IMPULSE " + dir + " " + _Symbol);
      }
   }
}

//| END OF PROGRAM                                                  |

// force recompile

   
