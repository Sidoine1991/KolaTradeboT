//+------------------------------------------------------------------+
//| WRAPPER POUR CAPTURER TOUTES LES FERMETURES                    |
//+------------------------------------------------------------------+
bool PositionCloseWithLog(ulong ticket, string reason = "", bool forceClose = false)
{
   // Obtenir les informations avant fermeture
   if(PositionSelectByTicket(ticket))
   {
      string symbol = PositionGetString(POSITION_SYMBOL);
      double profit = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
      datetime openTime = (datetime)PositionGetInteger(POSITION_TIME);
      int secondsSinceOpen = (int)(TimeCurrent() - openTime);

      // Coupure d'urgence (LOSS-GUARD / HARD MAX) — jamais bloquée par âge ou anti-thrash
      // NOTE (2026-08): "WAIT auto-close" ajouté au bypass — c'est déjà une décision de
      // risque à seuil $ dédié (CloseOnWaitLossMinUSD, ex. 1.5$), donc le plancher générique
      // de 2$ ci-dessous ne doit pas l'écraser silencieusement (bug: seuil 1.5$ ignoré tant
      // que la perte n'atteignait pas 2$).
      if(forceClose && (StringFind(reason, "LOSS-GUARD") >= 0 || StringFind(reason, "HARD MAX") >= 0
                         || StringFind(reason, "WAIT auto-close") >= 0
                         || StringFind(reason, "CORRECTION") >= 0
                         || StringFind(reason, "Spike close") >= 0
                         || StringFind(reason, "CONTRE-GOM") >= 0
                         || StringFind(reason, "Giveback") >= 0
                         || StringFind(reason, "HOLD-TIME") >= 0
                         || StringFind(reason, "PROFIT-LOCK") >= 0
                         || StringFind(reason, "PEAK-FADE") >= 0))
      {
         Print("[LOSS-GUARD] Fermeture forcée #", ticket, " ", symbol,
               " P/L=", DoubleToString(profit, 2), "$ | ", reason);
         return trade.PositionClose(ticket);
      }

      // Seuils anti-thrash : ne pas sortir avant ~2$ de perte / âge min
      // (sauf HARD LOSS déjà >= UniversalMaxLossUSD — jamais gonflé par le seuil min)
      double minLossBeforeClose = MathMax(2.0, MinLossBeforeAutoCloseUSD);
      double hardMaxLoss = MathMax(0.50, UniversalMaxLossUSD);
      const int minHoldSec = MathMax(5, MinPositionLifetimeSec); // v1.25: plus de plancher 90s

      bool isHardLoss = (profit <= -hardMaxLoss);
      bool isProfitOk = (profit >= 0.0);

      // 1) Âge minimum — même forceClose ne coupe pas un trade nouveau sauf hard loss
      if(!isHardLoss && secondsSinceOpen < minHoldSec)
      {
         Print("[PROTECT] Fermeture bloquée (âge ", secondsSinceOpen, "s < ", minHoldSec,
               "s) | P/L=", DoubleToString(profit, 2), "$ | raison=", reason,
               " | force=", forceClose);
         return false;
      }

      // 2) Perte trop petite — JAMAIS fermer (même forceClose) avant le seuil ~2$
      if(!isHardLoss && !isProfitOk && profit > -minLossBeforeClose)
      {
         Print("[PROTECT] Fermeture bloquée (perte ", DoubleToString(profit, 2),
               "$ > -", DoubleToString(minLossBeforeClose, 2), "$) | âge=", secondsSinceOpen,
               "s | raison=", reason, " | force=", forceClose,
               " — attendre seuil perte avant décision");
         return false;
      }

      if(isHardLoss)
      {
         Print("⚠️ PERTE HARD MAX — Fermeture autorisée");
         Print("   📊 Position: ", symbol, " | Ticket: ", ticket);
         Print("   💰 Perte: ", DoubleToString(profit, 2), "$ ≤ -",
               DoubleToString(hardMaxLoss, 2), "$");
         Print("   ✅ Raison: ", reason);
      }
      else if(isProfitOk)
      {
         Print("💰 POSITION EN GAIN - Fermeture autorisée");
         Print("   📊 Position: ", symbol, " | Ticket: ", ticket);
         Print("   💰 Profit: ", DoubleToString(profit, 2), "$");
      }
      else
      {
         Print("⚠️ PERTE SEUIL ATTEINT - Fermeture autorisée");
         Print("   📊 Position: ", symbol, " | Ticket: ", ticket);
         Print("   💰 Perte: ", DoubleToString(profit, 2), "$ ≤ -",
               DoubleToString(minLossBeforeClose, 2), "$");
         Print("   ✅ Raison: ", reason);
      }

      Print("🚨 FERMETURE DÉTECTÉE - ", symbol,
            " | Ticket: ", ticket,
            " | Profit: ", DoubleToString(profit, 2), "$",
            " | Âge: ", secondsSinceOpen, "s",
            " | Raison: ", reason);
   }

   // Exécuter la fermeture réelle
   bool result = trade.PositionClose(ticket);

   // Si fermeture réussie, réinitialiser g_maxProfit pour la prochaine position
   if(result)
   {
      g_maxProfit = 0;
      Print("✅ g_maxProfit réinitialisé pour la prochaine position");
   }

   return result;
}

double SMC_HardMaxLossUSD()
{
   double cap = UniversalMaxLossUSD;
   if(MaxLossPerSpikeTradeDollars > 0.0)
      cap = MathMin(cap, MaxLossPerSpikeTradeDollars);
   if(MaxSLDollars > 0.0)
      cap = MathMin(cap, MaxSLDollars);
   if(MaxLossPerTradeDollars > 0.0)
      cap = MathMin(cap, MaxLossPerTradeDollars);
   
   // Cap plus serré Weltrade/Deriv — mais assoupli si equity très basse (min lot)
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   if(SMC_IsWeltradeSymbol(_Symbol) || SMC_IsSpikeStyleSymbol(_Symbol))
   {
      if(equity > 0.0 && equity < 30.0)
         cap = MathMin(cap, MathMax(1.0, equity * 0.12)); // ~12% equity, min 1$
      else
         cap = MathMin(cap, 2.0);
   }
   
   if(cap <= 0.0)
      cap = 3.0;
   return cap;
}

double SMC_EstimateStopLossUSD(const string symbol, const ENUM_ORDER_TYPE type,
                               const double volume, const double entry, const double sl)
{
   if(volume <= 0.0 || entry <= 0.0 || sl <= 0.0)
      return 0.0;
   double profit = 0.0;
   if(OrderCalcProfit(type, symbol, volume, entry, sl, profit))
      return MathMax(0.0, -profit);
   double tickVal  = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);
   if(tickVal <= 0.0 || tickSize <= 0.0)
      return 0.0;
   return MathAbs(entry - sl) / tickSize * tickVal * volume;
}

bool SMC_CapSLToMaxLossUSD(const string symbol, const int dir, const double entry,
                           const double lot, double &sl)
{
   if(dir == 0 || lot <= 0.0 || entry <= 0.0)
      return false;
   double cap = SMC_HardMaxLossUSD();
   ENUM_ORDER_TYPE otype = (dir > 0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   if(sl > 0.0)
   {
      double loss = SMC_EstimateStopLossUSD(symbol, otype, lot, entry, sl);
      if(loss <= cap * 1.001)
         return true;
   }

   double tickVal  = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);
   int    dg       = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);
   if(tickVal <= 0.0 || tickSize <= 0.0)
      return false;
   double maxDist = (cap / (tickVal * lot)) * tickSize;
   double pt = SymbolInfoDouble(symbol, SYMBOL_POINT);
   int stopsLvl = (int)SymbolInfoInteger(symbol, SYMBOL_TRADE_STOPS_LEVEL);
   double minDist = (double)(stopsLvl + 2) * pt;
   if(maxDist < minDist)
   {
      Print("❌ SL $ cap: dist max $", DoubleToString(cap, 2),
            " < stops level sur ", symbol, " lot=", DoubleToString(lot, 2));
      return false;
   }
   sl = (dir > 0) ? NormalizeDouble(entry - maxDist, dg)
                  : NormalizeDouble(entry + maxDist, dg);
   double loss = SMC_EstimateStopLossUSD(symbol, otype, lot, entry, sl);
   if(loss > cap * 1.02)
   {
      Print("❌ SL $ cap: perte ", DoubleToString(loss, 2), "$ > ",
            DoubleToString(cap, 2), "$ sur ", symbol);
      return false;
   }
   Print("🛡️ SL capé à $", DoubleToString(cap, 2), " | ", symbol,
         " | SL=", DoubleToString(sl, dg), " | perte=", DoubleToString(loss, 2), "$");
   return true;
}

void SMC_EnforceHardMaxLoss()
{
   if(PositionsTotal() <= 0)
      return;
   double cap = SMC_HardMaxLossUSD();
   double trigger = cap * 0.80; // Réduit de 95% à 80% pour fermeture plus rapide
   if(trigger < 0.50)
      trigger = cap;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i))
         continue;
      if(posInfo.Magic() != InpMagicNumber)
         continue;

      ulong  ticket = posInfo.Ticket();
      string symbol = posInfo.Symbol();
      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      double volume = posInfo.Volume();
      double open   = posInfo.PriceOpen();
      double sl     = posInfo.StopLoss();
      double tp     = posInfo.TakeProfit();
      int    dir    = (posInfo.PositionType() == POSITION_TYPE_BUY) ? 1 : -1;
      ENUM_ORDER_TYPE otype = (dir > 0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
      int dg = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);

      if(profit <= -trigger)
      {
         Print("🛑 HARD MAX LOSS — close #", ticket, " ", symbol,
               " P/L=", DoubleToString(profit, 2), "$ / cap $", DoubleToString(cap, 2));
         if(!trade.PositionClose(ticket))
            Print("❌ HARD MAX close failed #", ticket, " err=", GetLastError());
         continue;
      }

      if(sl > 0.0)
      {
         double slLoss = SMC_EstimateStopLossUSD(symbol, otype, volume, open, sl);
         if(slLoss > cap * 1.02)
         {
            double newSL = sl;
            if(SMC_CapSLToMaxLossUSD(symbol, dir, open, volume, newSL))
            {
               bool better = (dir > 0) ? (newSL > sl) : (newSL < sl);
               if(better && trade.PositionModify(ticket, newSL, tp))
                  Print("🛡️ SL live resserré ", symbol, " #", ticket, " ",
                        DoubleToString(sl, dg), " → ", DoubleToString(newSL, dg),
                        " (était $", DoubleToString(slLoss, 2), ")");
            }
         }
      }
      else
      {
         double newSL = 0.0;
         if(SMC_CapSLToMaxLossUSD(symbol, dir, open, volume, newSL))
         {
            if(trade.PositionModify(ticket, newSL, tp))
               Print("🛡️ SL $ cap posé (SL vide) ", symbol, " #", ticket,
                     " SL=", DoubleToString(newSL, dg));
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Anti-flicker GOM WAIT : n'agir qu'après WAIT soutenu             |
//+------------------------------------------------------------------+
datetime g_gomWaitSince = 0;
// v1.33: stabilité GOM GOOD/PERFECT avant engagement
datetime g_gomStableSince = 0;
int      g_gomStableVn     = 0;
int GOMStableMinSec = 60; // secondes stabilité GOOD/PERFECT (v1.33)

void SMC_UpdateGomWaitTimer()
{
   if(UseGOMVerdictFilter && g_smcGomConnected && g_smcGomVerdictNum == 0)
   {
      if(g_gomWaitSince <= 0)
         g_gomWaitSince = TimeCurrent();
      // WAIT → reset stabilité
      g_gomStableSince = 0;
      g_gomStableVn = 0;
   }
   else
      g_gomWaitSince = 0;

   // Stabilité: même sens GOOD+ pendant N secondes
   int vn = g_smcGomConnected ? g_smcGomVerdictNum : 0;
   if(MathAbs(vn) >= 2)
   {
      int sign = (vn > 0) ? 1 : -1;
      int prev = (g_gomStableVn > 0) ? 1 : ((g_gomStableVn < 0) ? -1 : 0);
      if(prev != sign || g_gomStableSince <= 0)
      {
         g_gomStableSince = TimeCurrent();
         g_gomStableVn = vn;
      }
      else
         g_gomStableVn = vn; // rafraîchir magnitude
   }
   else
   {
      g_gomStableSince = 0;
      g_gomStableVn = 0;
   }
}

bool SMC_GomVerdictStable(const int dirSign, string &whyOut)
{
   whyOut = "";
   int need = (GOMStableMinSec > 0) ? GOMStableMinSec : 60;
   if(g_gomStableSince <= 0 || MathAbs(g_gomStableVn) < 2)
   {
      whyOut = "GOM pas encore stable (GOOD+)";
      return false;
   }
   int stSign = (g_gomStableVn > 0) ? 1 : -1;
   if(stSign != dirSign)
   {
      whyOut = "GOM stable dans l'autre sens";
      return false;
   }
   int age = (int)(TimeCurrent() - g_gomStableSince);
   if(age < need)
   {
      whyOut = "GOM stable seulement " + IntegerToString(age) + "s / " + IntegerToString(need) + "s";
      return false;
   }
   return true;
}

bool SMC_GomWaitSustained(const int minSec)
{
   if(!(UseGOMVerdictFilter && g_smcGomConnected && g_smcGomVerdictNum == 0))
      return false;
   if(g_gomWaitSince <= 0)
      return false;
   return ((int)(TimeCurrent() - g_gomWaitSince) >= minSec);
}

//+------------------------------------------------------------------+
//| Annule les ordres LIMIT/STOP en attente (cet EA, ce symbole) dès  |
//| que le verdict GOM retombe à WAIT — un ordre placé pendant un     |
//| GOOD/PERFECT ne doit pas se remplir plus tard "hors verdict".     |
//| Anti-flicker : n'agit qu'après WAIT soutenu 15s (comme les autres |
//| managers WAIT) pour ne pas annuler sur un simple aller-retour.    |
//+------------------------------------------------------------------+

//+------------------------------------------------------------------+
//| v1.17d: LIMIT prioritaires — JAMAIS annulés (DOW / SR20 / IMPULSE)|
//+------------------------------------------------------------------+
bool SMC_IsPriorityLimitComment(const string cmt)
{
   if(StringFind(cmt, "DOW") >= 0) return true;
   if(StringFind(cmt, "SR20") >= 0) return true;
   if(StringFind(cmt, "IMPULSE") >= 0) return true;
   if(StringFind(cmt, "PAT_LINE") >= 0) return true;
   if(StringFind(cmt, "ENGULF") >= 0) return true;
   if(StringFind(cmt, "TF_TL") >= 0) return true;
   if(StringFind(cmt, "SCH1") >= 0) return true;
   return false;
}

bool SMC_NeverCancelLimitsActive()
{
   // KeepPendingUntilTrigger OU option dédiée (défaut: ne pas annuler)
   return (KeepPendingUntilTrigger || NeverCancelPriorityLimits);
}


void CancelPendingOrdersOnGomWait()
{
   // v1.25e: GOM WAIT ou déconnecté → annuler TOUS les LIMIT/STOP du symbole
   // Un LIMIT ne doit JAMAIS se remplir sous WAIT
   if(!UseGOMVerdictFilter) return;
   bool isWait = (!g_smcGomConnected) || (g_smcGomVerdictNum == 0);
   if(!isWait) return;

   // Si connecté et WAIT: anti-flicker 2s. Si déco: cancel immédiat
   if(g_smcGomConnected && !SMC_GomWaitSustained(2)) return;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(!OrderSelect(ticket)) continue;
      if(OrderGetString(ORDER_SYMBOL) != _Symbol) continue;
      if((ulong)OrderGetInteger(ORDER_MAGIC) != (ulong)InpMagicNumber) continue;

      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(t != ORDER_TYPE_BUY_LIMIT && t != ORDER_TYPE_SELL_LIMIT &&
         t != ORDER_TYPE_BUY_STOP  && t != ORDER_TYPE_SELL_STOP)
         continue;

      string cmt = OrderGetString(ORDER_COMMENT);
      Print("🗑️ LIMIT annulé (GOM WAIT) #", ticket, " | ", cmt, " | ", _Symbol);
      if(!trade.OrderDelete(ticket))
      {
         // fallback
         if(!LimitSafeOrderDelete(ticket, true, "GOM WAIT — annulation immédiate"))
            Print("❌ Delete LIMIT WAIT fail #", ticket, " err=", GetLastError());
      }
   }
}

void CancelLimitsAgainstGomVerdict()
{
   // v1.27b: toujours actif si GOM connecté — même priorité DOW/SR20 annulée si contre-sens
   if(!g_smcGomConnected) return;
   int vn = g_smcGomVerdictNum;
   // WAIT: géré par CancelPendingOrdersOnGomWait
   if(vn == 0) return;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(!OrderSelect(ticket)) continue;
      if(OrderGetString(ORDER_SYMBOL) != _Symbol) continue;
      if((ulong)OrderGetInteger(ORDER_MAGIC) != (ulong)InpMagicNumber) continue;

      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      bool isBuy  = (t == ORDER_TYPE_BUY_LIMIT  || t == ORDER_TYPE_BUY_STOP);
      bool isSell = (t == ORDER_TYPE_SELL_LIMIT || t == ORDER_TYPE_SELL_STOP);
      if(!isBuy && !isSell) continue;

      string cmt = OrderGetString(ORDER_COMMENT);

      // GOM SELL (vn < 0) → aucun BUY pending (priorité incluse)
      if(vn < 0 && isBuy)
      {
         Print("🗑️ LIMIT BUY ANNULÉ IMMÉDIAT — GOM SELL vn=", vn,
               " | #", ticket, " | ", cmt, " | ", _Symbol);
         if(!trade.OrderDelete(ticket))
            Print("❌ Delete BUY LIMIT fail #", ticket, " err=", GetLastError());
         continue;
      }
      // GOM BUY (vn > 0) → aucun SELL pending (priorité incluse)
      if(vn > 0 && isSell)
      {
         Print("🗑️ LIMIT SELL ANNULÉ IMMÉDIAT — GOM BUY vn=", vn,
               " | #", ticket, " | ", cmt, " | ", _Symbol);
         if(!trade.OrderDelete(ticket))
            Print("❌ Delete SELL LIMIT fail #", ticket, " err=", GetLastError());
         continue;
      }
   }
}

// Ferme les positions ouvertes CONTRE le verdict GOM actuel (fill LIMIT trop tard)
// GainX BUY alors que GOM SELL → close immédiat (évite risque inutile)
void ClosePositionsOpenedAgainstGom()
{
   if(!UseGOMVerdictFilter) return;
   if(!g_smcGomConnected) return;
   int vn = g_smcGomVerdictNum;
   if(vn == 0) return; // WAIT: autre manager
   if(PositionsTotal() <= 0) return;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      if(posInfo.Symbol() != _Symbol) continue;

      int pdir = (posInfo.PositionType() == POSITION_TYPE_BUY) ? 1 : -1;
      bool against = false;
      if(vn < 0 && pdir > 0) against = true;  // GOM SELL, position BUY
      if(vn > 0 && pdir < 0) against = true;  // GOM BUY, position SELL

      if(!against) continue;

      // Sur spike symbols: close dès que contre-verdict (pas d'âge min)
      // Sur forex: close seulement si perte ou gain faible (< 0.30$) pour éviter de couper un trade en gros profit
      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      bool isSpike = SMC_IsSpikeStyleSymbol(_Symbol) || IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol);
      bool isFlip  = SMC_IsFlipStyleSymbol(_Symbol);
      // v1.27b FlipX/Vol: fermer dès que contre GOM (même petit profit) — évite fill LIMIT contraire
      if(isFlip || SMC_GetSymbolCategory(_Symbol) == SYM_VOLATILITY)
      {
         // force close always when against
      }
      else if(!isSpike && profit >= 0.50)
      {
         static datetime s_fxLog = 0;
         if(TimeCurrent() - s_fxLog >= 30)
         {
            s_fxLog = TimeCurrent();
            Print("⚠️ Pos contre GOM mais gain ≥0.50$ — trail/manage, pas force close | ",
                  _Symbol, " P/L=", DoubleToString(profit, 2));
         }
         continue;
      }

      ulong ticket = posInfo.Ticket();
      string why = StringFormat("Contre GOM vn=%d (pos %s)", vn, (pdir > 0 ? "BUY" : "SELL"));
      Print("🛑 CLOSE CONTRE-GOM ", _Symbol, " #", ticket, " | ", why,
            " | P/L=", DoubleToString(profit, 2), "$");
      // forceClose: on ne veut pas rester coincé par anti-thrash sur un trade déjà dans le mauvais sens
      PositionCloseWithLog(ticket, "CONTRE-GOM: " + why, true);
      g_maxProfit = 0;
   }
}



