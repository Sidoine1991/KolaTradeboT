// ── CHoCH / MSB State ──
enum ENUM_MARKET_STRUCTURE {
   STRUCT_TREND_UP,      // HH, HL
   STRUCT_TREND_DOWN,    // LL, LH
   STRUCT_CHOCH_BUY,     // Changement de caractère → haussier
   STRUCT_CHOCH_SELL,    // Changement de caractère → baissier
   STRUCT_NEUTRAL
};
ENUM_MARKET_STRUCTURE g_marketStructure = STRUCT_NEUTRAL;
double   g_choChPrice         = 0.0;
datetime g_choChTime          = 0;
double   g_msbPrice           = 0.0;
datetime g_msbTime            = 0;
double   g_lastSwingHigh2     = 0.0; // Swing high n-2 (2 avant)
double   g_lastSwingLow2      = 0.0; // Swing low n-2
datetime g_structUpdateTime   = 0;

// ── Breaker Block State ──
struct BreakerBlock {
   double high;
   double low;
   datetime time;
   bool isBullish;
   bool isValid;
   int barIndex;
};
BreakerBlock g_breakerBlocks[20];
int g_breakerBlockCount = 0;

// ── Equal Highs/Lows State ──
struct EqualLevel {
   double price;
   datetime time1;
   datetime time2;
   bool isHigh;
   int count;
};
EqualLevel g_equalLevels[30];
int g_equalLevelCount = 0;

// ── Displacement FVG State ──
struct DisplacementFVG {
   double top;
   double bottom;
   datetime time;
   bool isBullish;
   bool isValid;
   int barIndex;
};
DisplacementFVG g_dispFVGs[30];
int g_dispFVGCount = 0;

// DISP FVG trail (ligne des bords) — anti-faux signaux / détection correction
double   g_dispTrailLevel     = 0;      // niveau projeté au prix actuel
double   g_dispTrailSlope     = 0;      // pente (prix / seconde)
int      g_dispTrailDir       = 0;      // +1 bull trail (tops), -1 bear trail (bottoms)
bool     g_dispTrailValid     = false;
bool     g_dispTrailBroken    = false;  // structure cassée
bool     g_dispInCorrection   = false;  // prix en correction vs trail
datetime g_dispTrailT1        = 0;
datetime g_dispTrailT2        = 0;
double   g_dispTrailP1        = 0;
double   g_dispTrailP2        = 0;

// ── Croisement GOM_TF_TL + SMC_DISP_TRAIL ───────────────────────────────
bool     g_gomDispCrossBuy    = false;  // croisement vers le haut détecté
bool     g_gomDispCrossSell   = false;  // croisement vers le bas détecté
datetime g_gomDispCrossTime  = 0;      // timestamp du dernier croisement
double   g_gomDispCrossPrice = 0;      // prix du croisement

// ── TP1 state (used by GOM dashboard in SMC_GOM_Pipeline.mqh) ─────────
datetime g_tp1LastCloseTime  = 0;       // Dernière fermeture TP1
string   g_tp1LastCloseDir   = "";      // Direction (BUY/SELL)
double   g_tp1LastClosePrice = 0;       // Prix de fermeture
double   g_tp1LastCloseATR   = 0;       // ATR au moment de la fermeture
