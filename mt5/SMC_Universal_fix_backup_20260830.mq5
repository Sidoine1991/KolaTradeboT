// Position ouverte alors que GOM est déjà WAIT (LIMIT rempli trop tard) → fermer
void ClosePositionsFilledOnGomWait()
{
   if(!UseGOMVerdictFilter) return;
   if(g_smcGomConnected && g_smcGomVerdictNum != 0) return;
   // WAIT ou déco
   if(g_smcGomConnected && !SMC_GomWaitSustained(2)) return;
   if(PositionsTotal() <= 0) return;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      if(posInfo.Symbol() != _Symbol) continue;

      datetime openT = posInfo.Time();
      int age = (int)(TimeCurrent() - openT);
      // v1.28k: plus patient (180s) — laisse la structure parler
      if(age > 180) continue;

      ulong ticket = posInfo.Ticket();
      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      // Ne pas sortir micro-perte / flat sous WAIT fill
      if(profit > -CloseOnWaitLossMinUSD) continue;
      string why = StringFormat("FILL sous GOM WAIT (âge %ds P/L=$%.2f)", age, profit);
      Print("🛑 ", why, " | ", _Symbol, " #", ticket);
      PositionCloseWithLog(ticket, "WAIT auto-close: " + why, true);
      g_maxProfit = 0;
   }
}


