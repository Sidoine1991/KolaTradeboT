input double MaxLossPerSpikeTradeDollars = 1.5;  // v1.27: perte max spike 1.5$
input double WeltradeFxVolFixedLot       = 0.02; // Lot fixe Weltrade FX Vol / SFx Vol / SFV Vol
input double MaxRiskPerTradePercent   = 1.5;  // Risque normal par trade (% equity)
input double MaxDailyDrawdownPercent  = 30.0; // Drawdown max journalier (%)
input double MinSetupScoreEntry      = 55.0;  // v1.17: plus réactif PRE-SPIKE
input double MinAIConfidencePercent   = 65.0;  // Confiance IA min (%)
input group "=== SNIPER SCALPER MODE (cap $ + RR + confluence) ==="
input bool   UseSniperScalperMode    = true;   // Active le cap $ universel + RR mini sur tous les trades
input double MaxLossPerTradeDollars  = 1.2;   // v1.27: 1.2$ max unitaire
input int    MinPositionLifetimeSec = 20;    // v1.25: 20s (était 120 — bloquait sorties profit)
input double MinRewardRiskRatio      = 3.0;    // RR minimum exigé (TP = SL_dist x ce ratio)
input int    MinSniperConfluenceGates = 3;     // v1.24: 3 min — moins d'entrées faibles
input bool   SniperRequireGOMOrAI    = true;   // v1.24: GOM ou IA obligatoires
input group "=== PRECISION ENTRY ENGINE (anti-entrée à vue) ==="
input bool   UsePrecisionEntryEngine       = true;  // Entrées seulement sur confluence mesurable
input bool   PrecisionRequireClosedBar     = true;  // Ne jamais valider une bougie M1 en formation
input int    PrecisionMinConfirmations     = 4;     // Confirmations minimales sur 6
input double PrecisionMaxChaseATR          = 0.35;  // Distance max au dernier close M1 (ATR)
input double PrecisionMinBodyATR           = 0.35;  // Corps M1 directionnel minimal (ATR)
input double PrecisionLocationATR          = 0.60;  // Tolérance support/résistance/OTE (ATR)
input int    PrecisionEntryCooldownBars   = 2;     // Evite les entrées répétées dans la même impulsion
input group "=== SMART SL/TP & PROFIT MANAGEMENT ==="
input bool   UseIntelligentSLTP            = true;  // SL structurel + TP selon risque réel
input double IntelligentSLBufferATR        = 0.15;  // Buffer derrière le swing protégé
input double IntelligentMinRR              = 2.5;   // RR minimal initial
input bool   UseDynamicProfitManagement     = true;  // BE, trailing et TP extensible en gain
input double DynamicBreakEvenR             = 1.0;   // Passage BE à partir de R
input double DynamicTrailStartR            = 1.5;   // Trailing structurel à partir de R
input double DynamicTrailATRMult           = 1.0;   // Distance du trailing en ATR
input double DynamicProfitKeepPct          = 70.0;  // Gain peak protégé (0-100)
input bool   DynamicTPOverridesFixedTP1    = true;  // Laisser courir au lieu de fermer systématiquement à TP1
input double DynamicTP_ATRMult             = 2.5;   // Extension du TP depuis le prix courant (ATR)
input int    DynamicModifyMinPoints        = 3;     // Ecart minimal entre deux modifications SL/TP
input group "=== SETUP A+ (moins de trades, winrate) ==="
input bool   UseAPlusSetupOnly       = false;  // v1.17: false = A+ soft (spikes passent)
input int    APlusMaxDailyTrades     = 6;      // Max trades / jour en mode A+
input int    APlusMaxPositions       = 1;      // Max 1 position/ordre terminal en A+
input group "=== A+ CONFLUENCE RENFORCÉE (scalping M1/M5) ==="
