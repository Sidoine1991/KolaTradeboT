//+------------------------------------------------------------------+
//| Recalcule avec précision les zones Premium/Discount/Retrace     |
//| et indique si le PRIX est DANS la zone (oui/non)                 |
//+------------------------------------------------------------------+
void SMC_UpdatePreciseZones()
{
   g_priceInPremium = false;
   g_priceInDiscount = false;
   g_priceInEquilibrium = false;
   g_priceInFibRetrace = false;
   g_priceInRetraceZone = false;
   g_priceZonePct = 50.0;
   g_priceZoneLabel = "UNKNOWN";
   g_zoneEq = 0; g_zonePremHigh = 0; g_zoneDiscLow = 0;
   g_zoneFib618 = 0; g_zoneFib786 = 0;
   g_zoneRangeHigh = 0; g_zoneRangeLow = 0;
   g_inRetrace = false;

   double high[], low[], close[];
   ArraySetAsSeries(high, true);
   ArraySetAsSeries(low, true);
   ArraySetAsSeries(close, true);

   // TF plus réactif pour le scalping (M15 prioritaire, H1 en secours contextuel)
   ENUM_TIMEFRAMES tf = PERIOD_M15;
   int copied = CopyHigh(_Symbol, PERIOD_M15, 0, 60, high);
   if(copied < 25)
   {
      tf = PERIOD_M5;
      if(CopyHigh(_Symbol, tf, 0, 60, high) < 25)
      {
         tf = PERIOD_H1;
         if(CopyHigh(_Symbol, tf, 0, 40, high) < 20) return;
      }
   }
   if(CopyLow(_Symbol, tf, 0, 60, low) < 20) return;
   if(CopyClose(_Symbol, tf, 0, 60, close) < 20) return;

   int n = ArraySize(close);
   // Range court = 12 barres (récent) — évite un "mid" figé sur un vieux range large
   int lookback = MathMin(12, n - 1);
   if(lookback < 8) lookback = MathMin(20, n - 1);
   int iHi = ArrayMaximum(high, 0, lookback);
   int iLo = ArrayMinimum(low, 0, lookback);
   if(iHi < 0 || iLo < 0) return;

   double rangeHigh = high[iHi];
   double rangeLow  = low[iLo];
   if(rangeHigh <= rangeLow) return;

   double sma = 0;
   int smaN = MathMin(12, n);
   for(int i = 0; i < smaN; i++) sma += close[i];
   sma /= (double)smaN;
   double mid = (rangeHigh + rangeLow) * 0.5;
   double eq = 0.5 * mid + 0.5 * sma;

   g_zoneRangeHigh = rangeHigh;
   g_zoneRangeLow  = rangeLow;
   g_zoneEq        = eq;
   g_zonePremHigh  = rangeHigh;
   g_zoneDiscLow   = rangeLow;

   double rng = rangeHigh - rangeLow;
   if(rng <= 0) return;
   g_zoneFib618 = rangeHigh - rng * 0.618;
   g_zoneFib786 = rangeHigh - rng * 0.786;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double px  = (bid + ask) * 0.5;
   if(px <= 0) px = bid;
   if(px <= 0) return;

   g_priceZonePct = 100.0 * (px - rangeLow) / rng;
   if(g_priceZonePct < 0) g_priceZonePct = 0;
   if(g_priceZonePct > 100) g_priceZonePct = 100;

   // Équilibre plus serré: ±2% du range (était 3%)
   double eqBand = rng * 0.02;
   g_priceInEquilibrium = (px >= eq - eqBand && px <= eq + eqBand);

   g_priceInPremium  = (px > eq + eqBand);
   g_priceInDiscount = (px < eq - eqBand);

   double oteHi = MathMax(g_zoneFib618, g_zoneFib786);
   double oteLo = MathMin(g_zoneFib618, g_zoneFib786);
   g_priceInFibRetrace = (px >= oteLo && px <= oteHi);

   // Momentum court: si le prix s'éloigne vite du mid, ce n'est PLUS un retrace mid
   double distFromMidPct = MathAbs(g_priceZonePct - 50.0);
   double recentMove = MathAbs(close[0] - close[MathMin(3, n - 1)]);
   bool strongEscape = (recentMove >= rng * 0.35) && (distFromMidPct >= 12.0);

   // Retrace "visuel" (label) — bande moyenne, mais pas bloquante seule
   bool midBandLabel = (g_priceZonePct >= 35.0 && g_priceZonePct <= 65.0);
   g_priceInRetraceZone = (!strongEscape && (midBandLabel || g_priceInEquilibrium));

   // Labels
   if(g_priceInEquilibrium && !strongEscape)
      g_priceZoneLabel = "EQUILIBRE";
   else if(g_priceZonePct <= 15.0)
      g_priceZoneLabel = "DISCOUNT_EXTREME";
   else if(g_priceZonePct >= 85.0)
      g_priceZoneLabel = "PREMIUM_EXTREME";
   else if(g_priceInDiscount && g_priceZonePct <= 35.0)
      g_priceZoneLabel = "DISCOUNT";
   else if(g_priceInPremium && g_priceZonePct >= 65.0)
      g_priceZoneLabel = "PREMIUM";
   else if(strongEscape)
      g_priceZoneLabel = (g_priceZonePct >= 50.0 ? "BREAK_UP" : "BREAK_DOWN");
   else if(midBandLabel)
      g_priceZoneLabel = "MID_RETRACE";
   else if(g_priceInFibRetrace)
      g_priceZoneLabel = "FIB_OTE";
   else
      g_priceZoneLabel = "TRANSITION";

   // g_inRetrace = seulement vrai cœur d'équilibre (pas toute la bande 25-75)
   g_inRetrace = (g_priceInEquilibrium && !strongEscape);
}

// Bloque UNIQUEMENT le vrai milieu / équilibre — pas 25-75% trop large
// Rafraîchit toujours les zones (évite un label "mid" périmé)
bool SMC_PriceIsInBlockedRetraceZone()
{
   SMC_UpdatePreciseZones();

   // Escape momentum → jamais bloquer (prix déjà parti)
   double rng = g_zoneRangeHigh - g_zoneRangeLow;
   if(rng > 0)
   {
      double distFromMidPct = MathAbs(g_priceZonePct - 50.0);
      if(distFromMidPct >= 18.0)  // clairement hors milieu
         return false;
   }

   // v1.26: Blocage strict équilibre OU bande 38-62% (moins d'entrées mid-range)
   if(g_priceInEquilibrium) return true;
   if(g_priceZonePct > 38.0 && g_priceZonePct < 62.0) return true;
   return false;
}

// Affiche panneau statut zone sur le graphique
void SMC_DrawZoneStatusPanel()
{
   // Juste AU-DESSUS du dashboard GOM (bas gauche)
   string name = "SMC_ZONE_STATUS_" + _Symbol;
   ObjectDelete(0, name);
   if(!ObjectCreate(0, name, OBJ_LABEL, 0, 0, 0)) return;

   string status = "OK";
   bool spikeSym = SMC_IsSpikeStyleSymbol(_Symbol);
   if(g_priceInEquilibrium || (g_priceZonePct > 38.0 && g_priceZonePct < 62.0))
      status = "RETRACE mid — wait extreme";
   else if(g_priceZoneLabel == "BREAK_UP" || g_priceZoneLabel == "BREAK_DOWN")
      status = "BREAK — direction OK";
   else if(spikeSym && IsCrashLikeSymbol(_Symbol) && g_priceInDiscount && g_priceZonePct <= 40)
   {
      // PainX: discount + GOM SELL = continuation, pas "OK BUY"
      if(g_smcGomConnected && g_smcGomVerdictNum <= -MinGOMVerdictNumAbs)
         status = "DISCOUNT + GOM SELL — SELL OK (spike)";
      else if(SMC_ScalpTfDirIsBear(g_smcTfM1Dir) || SMC_ScalpTfDirIsBear(g_smcTfM5Dir))
         status = "DISCOUNT + TF BEAR — SELL OK";
      else if(SMC_ScalpTfDirIsBull(g_smcTfM1Dir) && SMC_ScalpTfDirIsBull(g_smcTfM5Dir))
         status = "DISCOUNT + M1/M5 BULL — correction, wait";
      else
         status = "DISCOUNT (PainX) — suivre GOM/TF";
   }
   else if(spikeSym && IsBoomLikeSymbol(_Symbol) && g_priceInPremium && g_priceZonePct >= 60)
   {
      if(g_smcGomConnected && g_smcGomVerdictNum >= MinGOMVerdictNumAbs)
         status = "PREMIUM + GOM BUY — BUY OK (spike)";
      else if(SMC_ScalpTfDirIsBull(g_smcTfM1Dir) || SMC_ScalpTfDirIsBull(g_smcTfM5Dir))
         status = "PREMIUM + TF BULL — BUY OK";
      else if(SMC_ScalpTfDirIsBear(g_smcTfM1Dir) && SMC_ScalpTfDirIsBear(g_smcTfM5Dir))
         status = "PREMIUM + M1/M5 BEAR — correction, wait";
      else
         status = "PREMIUM (Boom) — suivre GOM/TF";
   }
   else if(g_priceInDiscount && g_priceZonePct <= 35)
      status = "DISCOUNT OK BUY";
   else if(g_priceInPremium && g_priceZonePct >= 65)
      status = "PREMIUM OK SELL";
   else
      status = "TRANSITION OK";

   // Conflit réel seulement hors spike, ou spike avec M1+M5 contre GOM
   if(g_smcGomConnected && g_smcGomVerdictNum != 0)
   {
      if(spikeSym)
      {
         if(g_smcGomVerdictNum < 0 && SMC_ScalpTfDirIsBull(g_smcTfM1Dir) && SMC_ScalpTfDirIsBull(g_smcTfM5Dir))
            status = "CORRECTION M1/M5 BULL vs GOM SELL — wait";
         else if(g_smcGomVerdictNum > 0 && SMC_ScalpTfDirIsBear(g_smcTfM1Dir) && SMC_ScalpTfDirIsBear(g_smcTfM5Dir))
            status = "CORRECTION M1/M5 BEAR vs GOM BUY — wait";
      }
      else
      {
         bool zoneBuy  = (g_priceInDiscount && g_priceZonePct <= 40.0) || g_priceZoneLabel == "DISCOUNT_EXTREME";
         bool zoneSell = (g_priceInPremium  && g_priceZonePct >= 60.0) || g_priceZoneLabel == "PREMIUM_EXTREME";
         if(g_smcGomVerdictNum < 0 && zoneBuy)
            status = "CONFLIT GOM SELL vs ZONE BUY — wait";
         else if(g_smcGomVerdictNum > 0 && zoneSell)
            status = "CONFLIT GOM BUY vs ZONE SELL — wait";
      }
   }

   string txt = "ZONE " + g_priceZoneLabel + " " + DoubleToString(g_priceZonePct, 0) + "% | " + status;

   color c = clrSilver;
   if(StringFind(status, "CONFLIT") >= 0 || StringFind(status, "risqué") >= 0) c = clrMagenta;
   else if(g_priceInDiscount && g_priceZonePct <= 35) c = clrLime;
   else if(g_priceInPremium && g_priceZonePct >= 65) c = clrOrangeRed;
   else if(g_priceInEquilibrium || (g_priceZonePct > 42.0 && g_priceZonePct < 58.0)) c = clrGold;
   else if(g_priceZoneLabel == "BREAK_UP" || g_priceZoneLabel == "BREAK_DOWN") c = clrAqua;

   ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_LOWER);
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, 8);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, 268);
   ObjectSetString(0, name, OBJPROP_TEXT, txt);
   ObjectSetInteger(0, name, OBJPROP_COLOR, c);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, 9);
   ObjectSetString(0, name, OBJPROP_FONT, "Consolas Bold");
   ObjectSetInteger(0, name, OBJPROP_BACK, false);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
}

