//+------------------------------------------------------------------+
//| Sortie anticipée: correction / pas de spike, GOM encore GOOD     |
//| Évite de perdre ~2$ en attendant que le verdict bascule WAIT.    |
//+------------------------------------------------------------------+
void ManageCorrectionNoSpikeExit()
{
   if(!UseCorrectionNoSpikeExit) return;
   if(PositionsTotal() <= 0) return;

   // Signaux de "correction sans spike"
   bool trailCorr = (UseDispFVGTrail && g_dispTrailValid && (g_dispInCorrection || g_dispTrailBroken));
   bool chainCalm = (g_spikeChainState == SPIKE_STATE_CALM);
   // Pas de spike récent (proxy: state calm + pré-spike absent)
   bool noSpike = chainCalm && (g_spikeChainState != SPIKE_STATE_CHAIN_ACTIVE)
                  && (g_spikeChainState != SPIKE_STATE_PRE_SPIKE);

   // Aussi: GOM SIMPLE (déjà dégradé) traité comme risque élevé
   bool gomWeak = (!g_smcGomConnected) || (MathAbs(g_smcGomVerdictNum) <= 1);

   if(!trailCorr && !(noSpike && gomWeak) && !g_dispTrailBroken)
   {
      // Si toujours GOOD/PERFECT et pas de trail corr, ne pas sortir ici
      // (sauf trail broken déjà couvert)
      if(g_smcGomConnected && MathAbs(g_smcGomVerdictNum) >= 2 && !trailCorr)
         return;
   }

   double minLoss = MathMax(1.0, CloseOnCorrectionLossUSD); // v1.28c: jamais fermer sous 1$
   int minAge = MathMax(20, CorrectionExitMinAgeSec);

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      if(posInfo.Symbol() != _Symbol) continue;

      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      if(profit >= 0.0) continue;
      if(profit > -minLoss) continue;

      datetime openTime = (datetime)posInfo.Time();
      int age = (int)(TimeCurrent() - openTime);
      if(age < minAge) continue;

      // Direction de la position vs correction
      int pdir = (posInfo.PositionType() == POSITION_TYPE_BUY) ? 1 : -1;
      // Si trail corr et position dans le sens du trail cassé / contre → sortir
      bool shouldClose = false;
      string why = "";

      if(g_dispTrailBroken)
      {
         shouldClose = true;
         why = "DISP trail BROKEN";
      }
      else if(g_dispInCorrection)
      {
         shouldClose = true;
         why = "DISP trail CORRECTION";
      }
      else if(noSpike && MathAbs(g_smcGomVerdictNum) >= 2 && age >= minAge)
      {
         // v1.27: GOOD figé sans spike → cut rapide (évite -2$)
         shouldClose = true;
         why = "GOOD sans spike (stale)";
      }
      else if(gomWeak && noSpike)
      {
         shouldClose = true;
         why = "GOM faible + pas de spike";
      }
      // v1.28c: perte >= 1.0$ + chaîne CALME → sortir (plus de micro-pertes 0.xx$)
      else if(noSpike && profit <= -1.0 && age >= 20)
      {
         shouldClose = true;
         why = "perte>=1.0$ sans spike (CALM)";
      }

      if(!shouldClose) continue;

      ulong ticket = posInfo.Ticket();
      Print("🛑 CORRECTION-EXIT ", _Symbol, " #", ticket,
            " P/L=", DoubleToString(profit, 2), "$ age=", age, "s | ", why,
            " | GOM vn=", g_smcGomVerdictNum);
      // forceClose pour contourner le plancher anti-thrash si raison correction
      PositionCloseWithLog(ticket, "CORRECTION no-spike exit: " + why, true);
      g_maxProfit = 0;
   }
}

