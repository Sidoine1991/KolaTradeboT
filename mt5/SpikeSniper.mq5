//-------------------- UTILITIES --------------------
double NormalizeLotToStep(double lot)
{
   double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   if(step <= 0.0) step = 0.01;
   double n = MathFloor(lot/step + 0.0000001);
   double res = n * step;
   if(res < minLot) res = minLot;
   if(res > maxLot) res = maxLot;
   // choose reasonable precision
   int prec = 2;
   if(step < 0.01) prec = 3;
   return NormalizeDouble(res, prec);
}

double LotFromRiskPercent(double riskPercent, double stopDistancePoints)
{
   if(stopDistancePoints <= 0.0) return NormalizeLotToStep(InpFixedLot);
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double riskAmount = balance * (riskPercent/100.0);
   // approximate value per point for 1 lot:
   double tick_value = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double tick_size  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   double valuePerPointPerLot = 0.0;
   if(tick_size > 0.0) valuePerPointPerLot = tick_value / tick_size;
   if(valuePerPointPerLot <= 0.0) valuePerPointPerLot = 0.0001; // fallback
   double lot = riskAmount / (stopDistancePoints * valuePerPointPerLot);
   if(lot <= 0.0) lot = InpFixedLot;
   return NormalizeLotToStep(lot);
}

bool AnyOpenPositionOnSymbol()
{
   for(int i=0;i<PositionsTotal();i++)
   {
      ulong ticket = PositionGetTicket(i);
      if(PositionSelectByTicket(ticket))
      {
         string sym = PositionGetString(POSITION_SYMBOL);
         if(sym == _Symbol) return true;
      }
   }
   return false;
}

bool CanTradeNow()
{
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)) return false;
   double spread_points = (SymbolInfoDouble(_Symbol,SYMBOL_ASK) - SymbolInfoDouble(_Symbol,SYMBOL_BID)) / _Point;
   if(spread_points > InpMaxSpreadPoints) return false;
   return true;
}

//-------------------- BLINKER --------------------
void CreateBlinkArrow(string name, datetime t, double price, int arrow, color c)
{
   // delete old
   if(StringLen(blinkName) > 0)
   {
      if(ObjectFind(0, blinkName) != -1) ObjectDelete(0, blinkName);
   }
   blinkName = name;
   blinkCreated = TimeCurrent();
   blinkPrice = price;
   blinkArrowCode = arrow;
   // create initial arrow
   bool ok = ObjectCreate(0, blinkName, OBJ_ARROW, 0, t, price);
   if(ok)
   {
      ObjectSetInteger(0, blinkName, OBJPROP_ARROWCODE, arrow);
      ObjectSetInteger(0, blinkName, OBJPROP_COLOR, c);
      ObjectSetInteger(0, blinkName, OBJPROP_WIDTH, 2);
      ObjectSetInteger(0, blinkName, OBJPROP_SELECTABLE, false);
   }
   // start timer
   int interval = InpBlinkInterval;
   if(interval <= 0) interval = 1;
   EventSetTimer(interval);
}

void RemoveBlinkArrow()
{
   if(StringLen(blinkName) > 0)
   {
      if(ObjectFind(0, blinkName) != -1) ObjectDelete(0, blinkName);
      blinkName = "";
      blinkCreated = 0;
      blinkPrice = 0.0;
   }
   EventKillTimer();
}

// toggle visible/invisible for blink (called from OnTimer)
void ToggleBlink()
{
   if(StringLen(blinkName) == 0) return;
   if(ObjectFind(0, blinkName) != -1)
   {
      ObjectDelete(0, blinkName);
   }
   else
   {
      // recreate at stored time; find the nearest bar time for safety
      datetime t = 0;
      datetime times[];
      ArrayResize(times, 2);
      ArraySetAsSeries(times, true);
      if(CopyTime(_Symbol, Period(), 0, 2, times) > 0) t = times[1]; else t = TimeCurrent();
      ObjectCreate(0, blinkName, OBJ_ARROW, 0, t, blinkPrice);
      ObjectSetInteger(0, blinkName, OBJPROP_ARROWCODE, blinkArrowCode);
      color c = (blinkArrowCode==233) ? clrLime : clrRed;
      ObjectSetInteger(0, blinkName, OBJPROP_COLOR, c);
      ObjectSetInteger(0, blinkName, OBJPROP_WIDTH, 2);
      ObjectSetInteger(0, blinkName, OBJPROP_SELECTABLE, false);
   }
}

