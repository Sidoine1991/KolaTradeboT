   // Delete old objects
   ObjectDelete(0, bbUpperName);
   ObjectDelete(0, bbMiddleName);
   ObjectDelete(0, bbLowerName);
   
   // Create new line objects
   ObjectCreate(0, bbUpperName, OBJ_HLINE, 0, 0, upper[0]);
   ObjectSetInteger(0, bbUpperName, OBJPROP_COLOR, InpBBColor);
