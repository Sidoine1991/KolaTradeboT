}

// Volume Spike Detection
bool IsVolumeSpike(int index)
{
   if(!InpUseVolumeFilter) return true;
   
   long volume[];
   ArraySetAsSeries(volume, true);
   if(CopyRealVolume(_Symbol, Period(), 0, InpVolumePeriod + 1, volume) <= 0) return false;
   
   double avgVolume = 0;
   for(int i = 1; i <= InpVolumePeriod; i++)
   {
      avgVolume += (double)volume[i];
   }
   avgVolume /= InpVolumePeriod;
   
   return ((double)volume[0] > avgVolume * InpVolumeMultiplier);
}

// Momentum Confirmation
bool IsMomentumConfirm(int index, bool isBuy)
{
   if(!InpUseMomentumFilter) return true;
   
   double momentum[];
   ArraySetAsSeries(momentum, true);
   if(CopyBuffer(handleMomentum, 0, 0, InpMomentumPeriod + 1, momentum) <= 0) return false;
   
   if(isBuy)
   {
      return (momentum[0] > InpMomentumThreshold && momentum[0] > momentum[1]);
   }
   else
   {
      return (momentum[0] < -InpMomentumThreshold && momentum[0] < momentum[1]);
   }
}

// Volatility Filter
bool IsVolatilityHigh(int index)
{
   if(!InpUseVolatilityFilter) return true;
   
   double atr[];
   ArraySetAsSeries(atr, true);
   if(CopyBuffer(handleVolatility, 0, 0, InpVolatilityPeriod + 1, atr) <= 0) return false;
   
   double currentVolatility = atr[0] / SymbolInfoDouble(_Symbol, SYMBOL_BID);
   return (currentVolatility > InpVolatilityThreshold);
}

// Price Action Pattern Detection
bool IsBullishEngulfing(int index)
{
   if(!InpUsePriceActionFilter) return true;
   
   double open1 = iOpen(_Symbol, Period(), index);
   double close1 = iClose(_Symbol, Period(), index);
   double open2 = iOpen(_Symbol, Period(), index + 1);
   double close2 = iClose(_Symbol, Period(), index + 1);
   
   // Bullish engulfing: previous bearish, current bullish, current engulfs previous
   return (close2 < open2 && close1 > open1 && close1 > open2 && open1 < close2);
}

bool IsBearishEngulfing(int index)
{
   if(!InpUsePriceActionFilter) return true;
   
   double open1 = iOpen(_Symbol, Period(), index);
   double close1 = iClose(_Symbol, Period(), index);
   double open2 = iOpen(_Symbol, Period(), index + 1);
   double close2 = iClose(_Symbol, Period(), index + 1);
   
   // Bearish engulfing: previous bullish, current bearish, current engulfs previous
   return (close2 > open2 && close1 < open1 && close1 < open2 && open1 > close2);
}

// Support and Resistance Levels
bool IsNearSupport(int index)
{
   if(!InpUseSupportResistance) return true;
   
   double low = iLow(_Symbol, Period(), index);
   double support = 999999;
   
   // Find lowest low in the period
   for(int i = 1; i <= InpSRPeriod; i++)
   {
      double currentLow = iLow(_Symbol, Period(), index + i);
      if(currentLow < support) support = currentLow;
   }
   
   // Augmenter le seuil pour plus de flexibilité
   double threshold = 50 * _Point;  // Augmenté de 10 à 50 points
   return (MathAbs(low - support) < threshold);
}

bool IsNearResistance(int index)
{
   if(!InpUseSupportResistance) return true;
   
   double high = iHigh(_Symbol, Period(), index);
   double resistance = 0;
   
   // Find highest high in the period
   for(int i = 1; i <= InpSRPeriod; i++)
   {
      double currentHigh = iHigh(_Symbol, Period(), index + i);
      if(currentHigh > resistance) resistance = currentHigh;
   }
   
   // Augmenter le seuil pour plus de flexibilité
   double threshold = 50 * _Point;  // Augmenté de 10 à 50 points
   return (MathAbs(high - resistance) < threshold);
}

// Nouvelle fonction: Détecter les rebonds sur S/R (plus permissive)
bool IsSupportBounce(int index)
{
   if(!InpUseSupportResistance || !InpUseSRBounceLogic) return true;
   
   double low = iLow(_Symbol, Period(), index);
   double close = iClose(_Symbol, Period(), index);
   double support = 999999;
   
   // Find lowest low in the period
   for(int i = 1; i <= InpSRPeriod; i++)
   {
      double currentLow = iLow(_Symbol, Period(), index + i);
      if(currentLow < support) support = currentLow;
   }
   
   // Vérifier si le prix a touché le support et rebondi
   double threshold = InpSRBounceThreshold * _Point;  // Utiliser l'input
   bool touchedSupport = (low <= support + threshold);
   bool bounced = (close > low + InpSRBounceMinMove * _Point);  // Utiliser l'input
   
   return (touchedSupport && bounced);
}

bool IsResistanceBounce(int index)
{
   if(!InpUseSupportResistance || !InpUseSRBounceLogic) return true;
   
   double high = iHigh(_Symbol, Period(), index);
   double close = iClose(_Symbol, Period(), index);
   double resistance = 0;
   
   // Find highest high in the period
   for(int i = 1; i <= InpSRPeriod; i++)
   {
      double currentHigh = iHigh(_Symbol, Period(), index + i);
      if(currentHigh > resistance) resistance = currentHigh;
   }
   
   // Vérifier si le prix a touché la résistance et rebondi
   double threshold = InpSRBounceThreshold * _Point;  // Utiliser l'input
   bool touchedResistance = (high >= resistance - threshold);
   bool bounced = (close < high - InpSRBounceMinMove * _Point);  // Utiliser l'input
   
   return (touchedResistance && bounced);
}

// Multiple Timeframe Analysis
bool IsMTFBullish()
{
   if(!InpUseMultipleTimeframe) return true;
   
   double bb1_upper[], bb1_middle[], bb1_lower[];
   double rsi1[];
   ArraySetAsSeries(bb1_upper, true); ArraySetAsSeries(bb1_middle, true); ArraySetAsSeries(bb1_lower, true);
   ArraySetAsSeries(rsi1, true);
   
   if(CopyBuffer(handleMTF_BB1, 0, 0, 2, bb1_upper) <= 0) return false;
   if(CopyBuffer(handleMTF_BB1, 1, 0, 2, bb1_middle) <= 0) return false;
   if(CopyBuffer(handleMTF_RSI1, 0, 0, 2, rsi1) <= 0) return false;
   
   double price = iClose(_Symbol, InpMTF1, 0);
   return (price > bb1_middle[0] && rsi1[0] < 70);
}

bool IsMTFBearish()
{
   if(!InpUseMultipleTimeframe) return true;
   
   double bb1_upper[], bb1_middle[], bb1_lower[];
   double rsi1[];
   ArraySetAsSeries(bb1_upper, true); ArraySetAsSeries(bb1_middle, true); ArraySetAsSeries(bb1_lower, true);
   ArraySetAsSeries(rsi1, true);
   
   if(CopyBuffer(handleMTF_BB1, 0, 0, 2, bb1_upper) <= 0) return false;
   if(CopyBuffer(handleMTF_BB1, 1, 0, 2, bb1_middle) <= 0) return false;
   if(CopyBuffer(handleMTF_RSI1, 0, 0, 2, rsi1) <= 0) return false;
   
   double price = iClose(_Symbol, InpMTF1, 0);
   return (price < bb1_middle[0] && rsi1[0] > 30);
}

// News Filter (simplified - avoid high volatility periods)
bool IsNewsSafeTime()
{
   if(!InpUseNewsFilter) return true;
   
   // Simple approach: avoid first and last minutes of hours when news often hits
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   
   // Avoid minutes 0-5 and 55-59 of each hour
   if(dt.min <= 5 || dt.min >= 55) return false;
   
   // Avoid major news hours (simplified)
   if(dt.hour == 8 || dt.hour == 13 || dt.hour == 15) return false;
   
   return true;
}

// Spread Filter
bool IsSpreadAcceptable()
{
   if(!InpUseSpreadFilter) return true;
   
   double spread = (SymbolInfoDouble(_Symbol, SYMBOL_ASK) - SymbolInfoDouble(_Symbol, SYMBOL_BID)) / _Point;
   return (spread <= InpMaxSpreadPointsAdvanced);
}

// Session Filter
bool IsTradingSession()
{
   if(!InpUseSessionFilter) return true;
   
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   
   return (dt.hour >= InpStartHour && dt.hour <= InpEndHour);
}

// Confirmation Filter
bool HasEnoughConfirmations(bool isBuy)
{
   if(!InpUseConfirmationFilter) return true;
   
   int confirmations = 0;
   
   if(isBuy)
   {
      if(IsVolumeSpike(0)) confirmations++;
      if(IsMomentumConfirm(0, true)) confirmations++;
      if(IsVolatilityHigh(0)) confirmations++;
      if(IsBullishEngulfing(0)) confirmations++;
      if(IsNearSupport(0)) confirmations++;
      if(IsMTFBullish()) confirmations++;
   }
   else
   {
      if(IsVolumeSpike(0)) confirmations++;
      if(IsMomentumConfirm(0, false)) confirmations++;
      if(IsVolatilityHigh(0)) confirmations++;
      if(IsBearishEngulfing(0)) confirmations++;
      if(IsNearResistance(0)) confirmations++;
      if(IsMTFBearish()) confirmations++;
   }
   
   return (confirmations >= InpMinConfirmations);
}

// Advanced Spike Strength Calculator
double CalculateSpikeStrength(int index, bool isBuy)
{
   double strength = 0.0;
   
   // Volume contribution (30%)
   if(InpUseVolumeFilter)
   {
      long volume[];
      ArraySetAsSeries(volume, true);
      if(CopyRealVolume(_Symbol, Period(), 0, InpVolumePeriod + 1, volume) > 0)
      {
         double avgVolume = 0;
         for(int i = 1; i <= InpVolumePeriod; i++) avgVolume += (double)volume[i];
         avgVolume /= InpVolumePeriod;
         double volumeRatio = (double)volume[0] / avgVolume;
         strength += MathMin(volumeRatio, 3.0) * 0.3; // Cap at 3x average
      }
   }
   
   // Momentum contribution (25%)
   if(InpUseMomentumFilter)
   {
      double momentum[];
      ArraySetAsSeries(momentum, true);
      if(CopyBuffer(handleMomentum, 0, 0, 2, momentum) > 0)
      {
         strength += MathAbs(momentum[0]) * 0.25;
      }
   }
   
   // Volatility contribution (20%)
   if(InpUseVolatilityFilter)
   {
      double atr[];
      ArraySetAsSeries(atr, true);
      if(CopyBuffer(handleVolatility, 0, 0, 2, atr) > 0)
      {
         double currentVolatility = atr[0] / SymbolInfoDouble(_Symbol, SYMBOL_BID);
         strength += MathMin(currentVolatility / InpVolatilityThreshold, 2.0) * 0.2;
      }
   }
   
   // Price Action contribution (15%)
   if(InpUsePriceActionFilter)
   {
      if((isBuy && IsBullishEngulfing(index)) || (!isBuy && IsBearishEngulfing(index)))
      {
         strength += 0.15;
      }
   }
   
   // MTF contribution (10%)
   if(InpUseMultipleTimeframe)
   {
      if((isBuy && IsMTFBullish()) || (!isBuy && IsMTFBearish()))
      {
         strength += 0.1;
      }
   }
   
   return MathMin(strength, 1.0); // Cap at 1.0
}
// Simple higher timeframe trend: compare two moving averages on HTF
bool HTF_TrendUp()
{
   // use MA(50) vs MA(200) on HTF
   double ma50[], ma200[];
   ArraySetAsSeries(ma50, true);
   ArraySetAsSeries(ma200, true);
   
   int handle50 = iMA(_Symbol, InpHTF, 50, 0, MODE_EMA, PRICE_CLOSE);
   int handle200 = iMA(_Symbol, InpHTF, 200, 0, MODE_EMA, PRICE_CLOSE);
   
   if(handle50 == INVALID_HANDLE || handle200 == INVALID_HANDLE) return false;
   
   if(CopyBuffer(handle50, 0, 0, 2, ma50) <= 0) return false;
   if(CopyBuffer(handle200, 0, 0, 2, ma200) <= 0) return false;
   
   IndicatorRelease(handle50);
   IndicatorRelease(handle200);
   
   return (ma50[0] > ma200[0]);
}
bool HTF_TrendDown()
{
   double ma50[], ma200[];
   ArraySetAsSeries(ma50, true);
   ArraySetAsSeries(ma200, true);
   
   int handle50 = iMA(_Symbol, InpHTF, 50, 0, MODE_EMA, PRICE_CLOSE);
   int handle200 = iMA(_Symbol, InpHTF, 200, 0, MODE_EMA, PRICE_CLOSE);
   
   if(handle50 == INVALID_HANDLE || handle200 == INVALID_HANDLE) return false;
   
   if(CopyBuffer(handle50, 0, 0, 2, ma50) <= 0) return false;
   if(CopyBuffer(handle200, 0, 0, 2, ma200) <= 0) return false;
   
   IndicatorRelease(handle50);
   IndicatorRelease(handle200);
   
   return (ma50[0] < ma200[0]);
}

// Detect liquidity sweep: candle wick extends beyond recent swing high/low by threshold percent
bool IsLiquiditySweepBuy(double low_i, double recentLow)
{
   // check if low_i < recentLow by a small threshold
   double diff = recentLow - low_i;
   return (diff > (SymbolInfoDouble(_Symbol,SYMBOL_POINT) * 5)); // >5 points below recent low
}
bool IsLiquiditySweepSell(double high_i, double recentHigh)
{
   double diff = high_i - recentHigh;
   return (diff > (SymbolInfoDouble(_Symbol,SYMBOL_POINT) * 5));
}

// Simple Order Block: check if previous bearish/bullish candle has large body compared to average
bool IsOrderBlockBuy(int idx)
{
   // search a few bars back for bullish engulfing / big bullish body
   double avgBody = 0.0;
   int count=0;
   for(int k=2;k<=6;k++)
   {
      double o = iOpen(_Symbol, Period(), k);
      double c = iClose(_Symbol, Period(), k);
      avgBody += MathAbs(c-o);
      count++;
   }
   if(count>0) avgBody = avgBody/count;
   double o1 = iOpen(_Symbol, Period(), idx);
   double c1 = iClose(_Symbol, Period(), idx);
   double body = MathAbs(c1 - o1);
   return (c1 > o1 && body > avgBody * 1.2); // bullish OB
}
bool IsOrderBlockSell(int idx)
{
   double avgBody = 0.0;
   int count=0;
   for(int k=2;k<=6;k++)
   {
      double o = iOpen(_Symbol, Period(), k);
      double c = iClose(_Symbol, Period(), k);
      avgBody += MathAbs(c-o);
      count++;
   }
   if(count>0) avgBody = avgBody/count;
   double o1 = iOpen(_Symbol, Period(), idx);
   double c1 = iClose(_Symbol, Period(), idx);
   double body = MathAbs(c1 - o1);
   return (c1 < o1 && body > avgBody * 1.2); // bearish OB
}

// Simple BOS/CHOCH: check if current bar breaks last swing high/low
double LastSwingHigh(int lookback)
{
   double maxv = -1e18;
   for(int i=2;i<=lookback;i++)
   {
      double h = iHigh(_Symbol, Period(), i);
      if(h > maxv) maxv = h;
   }
   return maxv;
}
double LastSwingLow(int lookback)
{
   double minv = 1e18;
   for(int i=2;i<=lookback;i++)
   {
      double l = iLow(_Symbol, Period(), i);
      if(l < minv) minv = l;
   }
   return minv;
}

//-------------------- INITIALIZATION --------------------
int OnInit()
{
   g_symbol = _Symbol;
   g_point = _Point;
   g_digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   g_magic = (ulong)InpMagicNumber;
   
   // Initialisation des variables globales
   globalPoint = _Point;
   globalMagicNumber = InpMagicNumber;

   // Initialize chart display
   InitializeChartDisplay();

   // Initialize main indicators
   handleBB = iBands(_Symbol, Period(), InpBBPeriod, InpBBDev, 0, PRICE_CLOSE);
   handleRSI = iRSI(_Symbol, Period(), InpRSIPeriod, PRICE_CLOSE);
   handleATR = iATR(_Symbol, Period(), InpATRPeriod);

   // Initialize advanced indicators
   if(InpUseVolumeFilter)
   {
      handleVolume = iVolumes(_Symbol, Period(), VOLUME_TICK);
   }
   
   if(InpUseMomentumFilter)
   {
      handleMomentum = iMomentum(_Symbol, Period(), InpMomentumPeriod, PRICE_CLOSE);
   }
   
   if(InpUseVolatilityFilter)
   {
      handleVolatility = iATR(_Symbol, Period(), InpVolatilityPeriod);
   }
   
   if(InpUseMultipleTimeframe)
   {
      handleMTF_BB1 = iBands(_Symbol, InpMTF1, InpBBPeriod, InpBBDev, 0, PRICE_CLOSE);
      handleMTF_BB2 = iBands(_Symbol, InpMTF2, InpBBPeriod, InpBBDev, 0, PRICE_CLOSE);
      handleMTF_RSI1 = iRSI(_Symbol, InpMTF1, InpRSIPeriod, PRICE_CLOSE);
      handleMTF_RSI2 = iRSI(_Symbol, InpMTF2, InpRSIPeriod, PRICE_CLOSE);
   }

   // Check main handles
   if(handleBB == INVALID_HANDLE || handleRSI == INVALID_HANDLE || handleATR == INVALID_HANDLE)
   {
      Print("SpikeSniper: failed to create main handles.");
      return INIT_FAILED;
   }

   // Check advanced handles
   if(InpUseVolumeFilter && handleVolume == INVALID_HANDLE)
   {
      Print("SpikeSniper: failed to create volume handle.");
   }
   
   if(InpUseMomentumFilter && handleMomentum == INVALID_HANDLE)
   {
      Print("SpikeSniper: failed to create momentum handle.");
   }
   
   if(InpUseVolatilityFilter && handleVolatility == INVALID_HANDLE)
   {
      Print("SpikeSniper: failed to create volatility handle.");
   }

   Print("SpikeSniper_Ultimate_EA with Advanced Spike Prediction and Chart Display initialized on ", _Symbol);
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   // remove blink arrow if present
   if(StringLen(blinkName) > 0)
   {
      if(ObjectFind(0, blinkName) != -1) ObjectDelete(0, blinkName);
      blinkName = "";
   }
   
   // Clean up chart display objects
   CleanupChartObjects();
   
   // release handles (not strictly required)
   if(handleBB != INVALID_HANDLE) IndicatorRelease(handleBB);
   if(handleRSI != INVALID_HANDLE) IndicatorRelease(handleRSI);
   if(handleATR != INVALID_HANDLE) IndicatorRelease(handleATR);

   EventKillTimer();
}

//-------------------- TIMER (for blinking) --------------------
void OnTimer()
{
   // blink toggle
   if(StringLen(blinkName) == 0) return;
   // auto remove if duration exceeded
   if(InpBlinkDuration > 0 && blinkCreated != 0)
   {
      if(TimeCurrent() - blinkCreated >= InpBlinkDuration)
      {
         RemoveBlinkArrow();
         return;
      }
   }
   ToggleBlink();
}

//-------------------- MAIN LOOP --------------------
void OnTick()
{
   if(!CanTradeNow()) return;
   if(InpOnlyOnePosPerSym && AnyOpenPositionOnSymbol()) return;

   // Advanced filters check
   if(!IsSpreadAcceptable()) return;
   if(!IsTradingSession()) return;
   if(!IsNewsSafeTime()) return;

   // read indicator buffers for last few bars
   int barsToCopy = 32;
   double upper[], middle[], lower[], rsi[], atr[];
   ArraySetAsSeries(upper, true); ArraySetAsSeries(middle, true); ArraySetAsSeries(lower, true);
   ArraySetAsSeries(rsi, true); ArraySetAsSeries(atr, true);

   if(CopyBuffer(handleBB, 0, 0, barsToCopy, upper) <= 0) return;
   if(CopyBuffer(handleBB, 1, 0, barsToCopy, middle) <= 0) return;
   if(CopyBuffer(handleBB, 2, 0, barsToCopy, lower) <= 0) return;
   if(CopyBuffer(handleRSI, 0, 0, barsToCopy, rsi) <= 0) return;
   if(CopyBuffer(handleATR, 0, 0, barsToCopy, atr) <= 0) return;

   // Copy advanced indicator buffers for display
   double momentum[], volatility[];
   ArraySetAsSeries(momentum, true);
   ArraySetAsSeries(volatility, true);
   
   if(InpUseMomentumFilter && handleMomentum != INVALID_HANDLE)
   {
      CopyBuffer(handleMomentum, 0, 0, barsToCopy, momentum);
   }
   
   if(InpUseVolatilityFilter && handleVolatility != INVALID_HANDLE)
   {
      CopyBuffer(handleVolatility, 0, 0, barsToCopy, volatility);
   }

   // Update chart display with current indicator values
   UpdateChartDisplay(upper, middle, lower, rsi, atr, momentum, volatility, barsToCopy);

   // iterate last few closed candles (skip current)
   for(int i=1;i<barsToCopy;i++)
   {
      double high_i = iHigh(_Symbol, Period(), i);
      double low_i = iLow(_Symbol, Period(), i);
      double open_i = iOpen(_Symbol, Period(), i);
      double close_i = iClose(_Symbol, Period(), i);
      double body = MathAbs(close_i - open_i);
      double wick = high_i - low_i;
      double upper_i = upper[i];
      double lower_i = lower[i];
      double middle_i = middle[i];
      double rsi_i = rsi[i];

      // wick spike detection: wick > body * factor AND candle touches BB
      bool wick_spike = (wick > body * InpWickFactor) && ((high_i >= upper_i) || (low_i <= lower_i));
      if(!wick_spike) continue;

      // RSI filter
      bool rsi_ok = (close_i > open_i) ? (rsi_i < InpRSIBuyLevel) : (rsi_i > InpRSISellLevel);
      if(!rsi_ok) continue;

      // BUY signal
      if(close_i > open_i && InpAllowBuy)
      {
         // Higher timeframe trend filter
         if(InpHTF != PERIOD_CURRENT && !HTF_TrendUp()) continue;

         // Advanced spike prediction filters - PLUS PERMISSIFS
         bool volumeSpike = IsVolumeSpike(i);
         bool momentumConfirm = IsMomentumConfirm(i, true);
         bool volatilityHigh = IsVolatilityHigh(i);
         bool bullishEngulfing = IsBullishEngulfing(i);
         bool nearSupport = IsNearSupport(i);
         bool supportBounce = IsSupportBounce(i);  // NOUVEAU: Rebound sur support
         bool mtfBullish = IsMTFBullish();
         
         // Display volume spike
         DisplayVolumeSpike(volumeSpike);
         
         // LOGIQUE SIMPLIFIÉE: Priorité aux rebonds S/R
         bool basicSignal = wick_spike && rsi_ok;
         bool sRBounceSignal = supportBounce && basicSignal;
         bool advancedSignal = volumeSpike && momentumConfirm && volatilityHigh;
         
         // Prendre le trade si: (1) Rebound S/R OU (2) Signal avancé
         if(!sRBounceSignal && !advancedSignal) continue;
         
         // Si c'est un rebound S/R, moins de confirmations requises
         if(sRBounceSignal)
         {
            // Seulement besoin du spike de base
            if(!basicSignal) continue;
         }
         else
         {
            // Pour les signaux avancés, garder les filtres
            if(!bullishEngulfing) continue;
            if(!mtfBullish) continue;
            if(!HasEnoughConfirmations(true)) continue;
         }

         // Calculate spike strength
         double spikeStrength = CalculateSpikeStrength(i, true);
         if(spikeStrength < InpMinSpikeStrength) continue; // Utiliser l'input

         // Display spike signal
         DisplaySpikeSignals(i, true, false, spikeStrength);
         
         // Count confirmations for display
         int confirmations = 0;
         if(volumeSpike) confirmations++;
         if(momentumConfirm) confirmations++;
         if(volatilityHigh) confirmations++;
         if(bullishEngulfing) confirmations++;
         if(nearSupport) confirmations++;
         if(mtfBullish) confirmations++;
         if(supportBounce) confirmations += 2;  // Bonus pour rebound S/R
         DisplayConfirmationSignals(confirmations, InpMinConfirmations);

         // SMC-like filters
         double lastSwingLow = 999999;
         for(int s=1;s<=10;s++)
         {
            double sl = iLow(_Symbol, Period(), s);
            if(sl < lastSwingLow) lastSwingLow = sl;
         }
         bool sweep = IsLiquiditySweepBuy(low_i, lastSwingLow);
         bool ob = IsOrderBlockBuy(i+1);
         bool bos = (close_i > lastSwingLow);

         // require at least one of sweep/ob/bos to be true for higher confidence
         if(sweep || ob || bos)
         {
            // compute SL = lowest low of last InpMaxStopBars closed candles (1..InpMaxStopBars)
            double lowest = low_i;
            for(int k=1;k<=InpMaxStopBars;k++)
            {
               double lk = iLow(_Symbol, Period(), k);
               if(lk < lowest) lowest = lk;
            }
            double sl_price = lowest - (10.0 * _Point);
            // compute TP
            double tp_price = middle_i;
            if(InpUseATRTP && !InpUseBBMiddleTP && ArraySize(atr) > i)
            {
               double atrVal = atr[i];
               if(atrVal > 0.0) tp_price = SymbolInfoDouble(_Symbol, SYMBOL_ASK) + (atrVal * InpATRMultiplierTP);
            }
            if(InpUseATRTP && InpUseBBMiddleTP) tp_price = middle_i; // BB middle prioritized

            // compute lot
            double stopDistancePoints = MathAbs((SymbolInfoDouble(_Symbol,SYMBOL_ASK) - sl_price) / _Point);
            if(stopDistancePoints < 1.0) stopDistancePoints = 1.0;
            double lot = InpFixedLot;
            if(InpUseRiskPercent) lot = LotFromRiskPercent(InpRiskPercent, stopDistancePoints);
            lot = NormalizeLotToStep(lot);

            MqlTradeRequest request = {};
            MqlTradeResult result = {};
            request.action = TRADE_ACTION_DEAL;
            request.symbol = _Symbol;
            request.volume = lot;
            request.type = ORDER_TYPE_BUY;
            request.price = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
            request.sl = sl_price;
            request.tp = tp_price;
            request.deviation = 10;
            request.magic = InpMagicNumber;
            request.comment = "SpikeSniper BUY - Strength: " + DoubleToString(spikeStrength, 2);
            
            bool ok = OrderSend(request, result);
            if(ok)
            {
               string msg = StringFormat("SpikeSniper: BUY placed %s lot=%.2f SL=%.5f TP=%.5f (rsi=%.1f sweep=%d ob=%d bos=%d strength=%.2f)", _Symbol, lot, sl_price, tp_price, rsi_i, (int)sweep, (int)ob, (int)bos, spikeStrength);
               Print(msg);
               if(AlertsOn) Alert(msg);
               // create blink arrow
               datetime arrowTime = iTime(_Symbol, Period(), i);
               string name = "SpikeSniper_Buy_" + IntegerToString((int)arrowTime);
               CreateBlinkArrow(name, arrowTime, low_i - (10.0*_Point), 233, clrLime);
            }
            else
            {
               Print("SpikeSniper: BUY failed. rc=", GetLastError());
            }
         } // end sweep/ob/bos
      } // end buy

      // SELL signal
      if(close_i < open_i && InpAllowSell)
      {
         // Higher timeframe trend filter
         if(InpHTF != PERIOD_CURRENT && !HTF_TrendDown()) continue;

         // Advanced spike prediction filters - PLUS PERMISSIFS
         bool volumeSpike = IsVolumeSpike(i);
         bool momentumConfirm = IsMomentumConfirm(i, false);
         bool volatilityHigh = IsVolatilityHigh(i);
         bool bearishEngulfing = IsBearishEngulfing(i);
         bool nearResistance = IsNearResistance(i);
         bool resistanceBounce = IsResistanceBounce(i);  // NOUVEAU: Rebound sur résistance
         bool mtfBearish = IsMTFBearish();
         
         // Display volume spike
         DisplayVolumeSpike(volumeSpike);
         
         // LOGIQUE SIMPLIFIÉE: Priorité aux rebonds S/R
         bool basicSignal = wick_spike && rsi_ok;
         bool sRBounceSignal = resistanceBounce && basicSignal;
         bool advancedSignal = volumeSpike && momentumConfirm && volatilityHigh;
         
         // Prendre le trade si: (1) Rebound S/R OU (2) Signal avancé
         if(!sRBounceSignal && !advancedSignal) continue;
         
         // Si c'est un rebound S/R, moins de confirmations requises
         if(sRBounceSignal)
         {
            // Seulement besoin du spike de base
            if(!basicSignal) continue;
         }
         else
         {
            // Pour les signaux avancés, garder les filtres
            if(!bearishEngulfing) continue;
            if(!mtfBearish) continue;
            if(!HasEnoughConfirmations(false)) continue;
         }

         // Calculate spike strength
         double spikeStrength = CalculateSpikeStrength(i, false);
         if(spikeStrength < InpMinSpikeStrength) continue; // Utiliser l'input

         // Display spike signal
         DisplaySpikeSignals(i, false, true, spikeStrength);
         
         // Count confirmations for display
         int confirmations = 0;
         if(volumeSpike) confirmations++;
         if(momentumConfirm) confirmations++;
         if(volatilityHigh) confirmations++;
         if(bearishEngulfing) confirmations++;
         if(nearResistance) confirmations++;
         if(mtfBearish) confirmations++;
         if(resistanceBounce) confirmations += 2;  // Bonus pour rebound S/R
         DisplayConfirmationSignals(confirmations, InpMinConfirmations);

         // SMC-like filters
         double lastSwingHigh = 0;
         for(int s=1;s<=10;s++)
         {
            double sh = iHigh(_Symbol, Period(), s);
            if(sh > lastSwingHigh) lastSwingHigh = sh;
         }
         bool sweep = IsLiquiditySweepSell(high_i, lastSwingHigh);
         bool ob = IsOrderBlockSell(i+1);
         bool bos = (high_i > lastSwingHigh);
         if(sweep || ob || bos)
         {
            double highest = high_i;
            for(int k=1;k<=InpMaxStopBars;k++)
            {
               double hk = iHigh(_Symbol, Period(), k);
               if(hk > highest) highest = hk;
            }
            double sl_price = highest + (10.0 * _Point);
            double tp_price = middle_i;
            if(InpUseATRTP && !InpUseBBMiddleTP && ArraySize(atr) > i)
            {
               double atrVal = atr[i];
               if(atrVal > 0.0) tp_price = SymbolInfoDouble(_Symbol, SYMBOL_BID) - (atrVal * InpATRMultiplierTP);
            }
            if(InpUseATRTP && InpUseBBMiddleTP) tp_price = middle_i;

            double stopDistancePoints = MathAbs((sl_price - SymbolInfoDouble(_Symbol,SYMBOL_BID)) / _Point);
            if(stopDistancePoints < 1.0) stopDistancePoints = 1.0;
            double lot = InpFixedLot;
            if(InpUseRiskPercent) lot = LotFromRiskPercent(InpRiskPercent, stopDistancePoints);
            lot = NormalizeLotToStep(lot);

            MqlTradeRequest request = {};
            MqlTradeResult result = {};
            request.action = TRADE_ACTION_DEAL;
            request.symbol = _Symbol;
            request.volume = lot;
            request.type = ORDER_TYPE_SELL;
            request.price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
            request.sl = sl_price;
            request.tp = tp_price;
            request.deviation = 10;
            request.magic = InpMagicNumber;
            request.comment = "SpikeSniper SELL - Strength: " + DoubleToString(spikeStrength, 2);
            
            bool ok = OrderSend(request, result);
            if(ok)
            {
               string msg = StringFormat("SpikeSniper: SELL placed %s lot=%.2f SL=%.5f TP=%.5f (rsi=%.1f sweep=%d ob=%d bos=%d strength=%.2f)", _Symbol, lot, sl_price, tp_price, rsi_i, (int)sweep, (int)ob, (int)bos, spikeStrength);
               Print(msg);
               if(AlertsOn) Alert(msg);
               datetime arrowTime = iTime(_Symbol, Period(), i);
               string name = "SpikeSniper_Sell_" + IntegerToString((int)arrowTime);
               CreateBlinkArrow(name, arrowTime, high_i + (10.0*_Point), 234, clrRed);
            }
            else
            {
               Print("SpikeSniper: SELL failed. rc=", GetLastError());
            }
         }
      }
   }

   // Manage trailing / BE for open positions
   ManageOpenPositions();
}

//-------------------- POSITION MANAGEMENT --------------------
void ManageOpenPositions()
{
   // iterate positions for this symbol & magic
   for(int iPos = PositionsTotal()-1; iPos >= 0; iPos--)
   {
      ulong ticket = PositionGetTicket(iPos);
      if(PositionSelectByTicket(ticket))
      {
         string sym = PositionGetString(POSITION_SYMBOL);
         if(sym != _Symbol) continue;
         long magic = (long)PositionGetInteger(POSITION_MAGIC);
         if((ulong)magic != InpMagicNumber) continue;

         double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
         double currentPrice = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? SymbolInfoDouble(_Symbol, SYMBOL_BID) : SymbolInfoDouble(_Symbol, SYMBOL_ASK);
         double sl = PositionGetDouble(POSITION_SL);
         double tp = PositionGetDouble(POSITION_TP);
         double volume = PositionGetDouble(POSITION_VOLUME);
         long type = PositionGetInteger(POSITION_TYPE);

         // trailing
         if(InpTrailingStart > 0.0)
         {
            if(type == POSITION_TYPE_BUY)
            {
               double profitPoints = (currentPrice - openPrice) / _Point;
               if(profitPoints >= InpTrailingStart)
               {
                  double newSL = currentPrice - (InpTrailingStep * _Point);
                  if(newSL > sl)
                  {
                     // modify position SL
                  MqlTradeRequest modRequest = {};
                  MqlTradeResult modResult = {};
                  modRequest.action = TRADE_ACTION_SLTP;
                  modRequest.position = ticket;
                  modRequest.sl = newSL;
                  modRequest.tp = tp;
                  modRequest.magic = InpMagicNumber;
                  if(!OrderSend(modRequest, modResult))
                  {
                     Print("Failed to modify BUY position SL. Error: ", GetLastError());
                  }
                  }
               }
            }
            else
            {
               double profitPoints = (openPrice - currentPrice) / _Point;
               if(profitPoints >= InpTrailingStart)
               {
                  double newSL = currentPrice + (InpTrailingStep * _Point);
                  if(newSL < sl || sl==0.0)
                  {
                     MqlTradeRequest modRequest = {};
                     MqlTradeResult modResult = {};
                     modRequest.action = TRADE_ACTION_SLTP;
                     modRequest.position = ticket;
                     modRequest.sl = newSL;
                     modRequest.tp = tp;
                     modRequest.magic = InpMagicNumber;
                     if(!OrderSend(modRequest, modResult))
                     {
                        Print("Failed to modify SELL position SL. Error: ", GetLastError());
                     }
                  }
               }
            }
         }

         // break-even logic (optional) - simplified
         if(InpBreakEvenOnTP && tp > 0.0)
         {
            // if price has moved favorably to reach midpoint between open and TP, set SL to openPrice + small buffer
            double midpoint;
            if(type == POSITION_TYPE_BUY) midpoint = (openPrice + tp)/2.0;
            else midpoint = (openPrice + tp)/2.0;
            if((type==POSITION_TYPE_BUY && SymbolInfoDouble(_Symbol,SYMBOL_BID) >= midpoint) ||
               (type==POSITION_TYPE_SELL && SymbolInfoDouble(_Symbol,SYMBOL_ASK) <= midpoint))
            {
               double beSL = openPrice + ((type==POSITION_TYPE_BUY) ? (5.0*_Point) : (-5.0*_Point));
               // set SL nearer to BE (only if improves)
               if((type==POSITION_TYPE_BUY && beSL > sl) || (type==POSITION_TYPE_SELL && beSL < sl) || sl==0.0)
               {
                  MqlTradeRequest modRequest = {};
                  MqlTradeResult modResult = {};
                  modRequest.action = TRADE_ACTION_SLTP;
                  modRequest.position = ticket;
                  modRequest.sl = beSL;
                  modRequest.tp = tp;
                  modRequest.magic = InpMagicNumber;
                  if(!OrderSend(modRequest, modResult))
                  {
                     Print("Failed to modify position BE. Error: ", GetLastError());
                  }
               }
            }
         }
      }
   }
}

//-------------------- HELPER: safe CopyTime wrapper --------------------
int CopyTimeSafe(string symbol, ENUM_TIMEFRAMES tf, int start, int count, datetime &times[])
{
   ArraySetAsSeries(times, true);
   return CopyTime(symbol, tf, start, count, times);
}

