// Display Support and Resistance Levels
void DisplaySupportResistance()
{
   if(!InpShowIndicators || !InpShowSupportResistance) return;
   
   // Calculate support and resistance
   double support = 999999;
   double resistance = 0;
   
   for(int i = 1; i <= InpSRPeriod; i++)
   {
      double low = iLow(_Symbol, Period(), i);
      double high = iHigh(_Symbol, Period(), i);
      if(low < support) support = low;
      if(high > resistance) resistance = high;
   }
   
   // Delete old objects
   ObjectDelete(0, srSupportName);
   ObjectDelete(0, srResistanceName);
   
   // Create support line
   ObjectCreate(0, srSupportName, OBJ_HLINE, 0, 0, support);
   ObjectSetInteger(0, srSupportName, OBJPROP_COLOR, InpSRColor);
   ObjectSetInteger(0, srSupportName, OBJPROP_STYLE, STYLE_DASH);
   ObjectSetInteger(0, srSupportName, OBJPROP_WIDTH, 1);
   
   // Create resistance line
   ObjectCreate(0, srResistanceName, OBJ_HLINE, 0, 0, resistance);
   ObjectSetInteger(0, srResistanceName, OBJPROP_COLOR, InpSRColor);
   ObjectSetInteger(0, srResistanceName, OBJPROP_STYLE, STYLE_DASH);
   ObjectSetInteger(0, srResistanceName, OBJPROP_WIDTH, 1);
}

// Display Spike Signals
void DisplaySpikeSignals(int index, bool isBuy, bool isSell, double spikeStrength)
{
   if(!InpShowIndicators || !InpShowSpikes) return;
   
   // Delete old object
   ObjectDelete(0, spikeSignalName);
   
   if(isBuy || isSell)
   {
      // Create spike signal arrow
      datetime signalTime = iTime(_Symbol, Period(), index);
      double signalPrice = (isBuy) ? iLow(_Symbol, Period(), index) : iHigh(_Symbol, Period(), index);
      int arrowCode = (isBuy) ? 233 : 234; // Up or down arrow
      
      ObjectCreate(0, spikeSignalName, OBJ_ARROW, 0, signalTime, signalPrice);
      ObjectSetInteger(0, spikeSignalName, OBJPROP_ARROWCODE, arrowCode);
      ObjectSetInteger(0, spikeSignalName, OBJPROP_COLOR, InpSpikeColor);
      ObjectSetInteger(0, spikeSignalName, OBJPROP_WIDTH, 3);
      
      // Add strength text
      string strengthText = StringFormat("%.2f", spikeStrength);
      ObjectCreate(0, spikeSignalName + "_Text", OBJ_TEXT, 0, signalTime, signalPrice + (isBuy ? 20*_Point : -20*_Point));
      ObjectSetString(0, spikeSignalName + "_Text", OBJPROP_TEXT, strengthText);
      ObjectSetInteger(0, spikeSignalName + "_Text", OBJPROP_COLOR, InpSpikeColor);
      ObjectSetInteger(0, spikeSignalName + "_Text", OBJPROP_FONTSIZE, 8);
   }
}

