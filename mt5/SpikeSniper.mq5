// Update all chart displays
void UpdateChartDisplay(double &upper[], double &middle[], double &lower[], double &rsi[], double &atr[], double &momentum[], double &volatility[], int bars)
{
   if(!InpShowIndicators) return;
   
   DisplayBollingerBands(upper, middle, lower, bars);
   DisplayRSI(rsi, bars);
   DisplayATR(atr, bars);
   DisplayMomentum(momentum, bars);
   DisplayVolatility(volatility, bars);
   DisplaySupportResistance();
}

