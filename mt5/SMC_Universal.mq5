void SMC_ManagePurePAPendingLimits(const string symbol)
{
   int maxAgeSec = (int)MathMax(60, PurePA_LimitExpirySec);
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      ENUM_ORDER_TYPE type = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(type != ORDER_TYPE_BUY_LIMIT && type != ORDER_TYPE_SELL_LIMIT) continue;
      if(OrderGetString(ORDER_SYMBOL) != symbol ||
         (ulong)OrderGetInteger(ORDER_MAGIC) != InpMagicNumber ||
         StringFind(OrderGetString(ORDER_COMMENT), "PURE_PA") < 0)
         continue;

      int dir = (type == ORDER_TYPE_BUY_LIMIT) ? 1 : -1;
      string invalidReason = "";
      datetime setupTime = (datetime)OrderGetInteger(ORDER_TIME_SETUP);
      if(setupTime > 0 && TimeCurrent() - setupTime >= maxAgeSec)
         invalidReason = "expiration contexte PurePA";
      else if(!g_smcGomConnected || MathAbs(g_smcGomVerdictNum) < 2 ||
              (dir > 0 && g_smcGomVerdictNum < 0) ||
              (dir < 0 && g_smcGomVerdictNum > 0))
         invalidReason = "verdict GOM devenu invalide";
      else if(!PurePA_UseLimitOrder)
         invalidReason = "ordres LIMIT PurePA dÃ©sactivÃ©s";
      else if(PurePA_UseMultiTF && !PurePA_HigherTFAligned(dir))
         invalidReason = "alignement timeframe perdu";
      else
      {
         double sl = OrderGetDouble(ORDER_SL);
         double bid = SymbolInfoDouble(symbol, SYMBOL_BID);
         double ask = SymbolInfoDouble(symbol, SYMBOL_ASK);
         if((dir > 0 && sl > 0.0 && bid <= sl) ||
            (dir < 0 && sl > 0.0 && ask >= sl))
            invalidReason = "prix a invalidÃ© le stop du setup";
      }

      if(invalidReason != "")
         LimitSafeOrderDelete(ticket, true, "PurePA: " + invalidReason);
   }
}

