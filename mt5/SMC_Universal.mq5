//| FERMETURE SANS PROFIT APRÃˆS 7 MINUTES â€” probable correction de marchÃ© |
void CloseUnprofitableAfterDelay()
{
   static datetime s_lastCheck = 0;
   if(TimeCurrent() - s_lastCheck < 15) return; // check toutes les 15s max
   s_lastCheck = TimeCurrent();

   const int    DELAY_SECONDS = 7 * 60; // 7 minutes
   datetime     now           = TimeCurrent();

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if((long)PositionGetInteger(POSITION_MAGIC) != InpMagicNumber) continue;

      datetime openTime = (datetime)PositionGetInteger(POSITION_TIME);
      if(now - openTime < DELAY_SECONDS) continue; // pas encore 7 min

      double profit = PositionGetDouble(POSITION_PROFIT);
      // Attendre au moins 1$ de perte â€” pas de sortie rapide sans spike
      double minLoss = MathMax(1.0, MinLossBeforeAutoCloseUSD);
      if(profit > -minLoss) continue;

      ulong ticket = PositionGetInteger(POSITION_TICKET);
      int   ageMin = (int)((now - openTime) / 60);
      Print("[7MIN-CLOSE] Perte >= $", DoubleToString(minLoss, 2), " aprÃ¨s ", ageMin,
            " min sur ", _Symbol,
            " | profit=", DoubleToString(profit, 2),
            " | ticket=", ticket, " â†’ fermeture");
      PositionCloseWithLog(ticket, "7min loss close");
   }
}

//| ROTATION AUTOMATIQUE DES POSITIONS - Ã‰vite de rester bloquÃ© sur un symbole |
void AutoRotatePositions()
{
   int totalPositions = CountPositionsOurEA();
   
   // Si on n'est pas Ã  la limite de positions, pas besoin de rotation
   if(totalPositions < MaxPositionsTerminal)
   {
      return;
   }
   
   // Si on est Ã  la limite, vÃ©rifier s'il y a des opportunitÃ©s sur d'autres symboles
   Print("ðŸ”„ ROTATION AUTO - Positions: ", totalPositions, "/", MaxPositionsTerminal, " - VÃ©rification opportunitÃ©s...");
   
   // Chercher la position la plus ancienne ou la moins performante
   ulong oldestTicket = 0;
   datetime oldestTime = TimeCurrent();
   double worstProfit = 999999;
   ulong worstTicket = 0;
   string worstSymbol = "";
   
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      
      string symbol = posInfo.Symbol();
      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      datetime openTime = posInfo.Time();
      ulong ticket = posInfo.Ticket();
      
      // PrioritÃ© 1: Position en perte depuis longtemps
      if(profit < -0.5 && openTime < oldestTime)
      {
         oldestTime = openTime;
         oldestTicket = ticket;
      }
      
      // PrioritÃ© 2: Position avec la pire performance
      if(profit < worstProfit)
      {
         worstProfit = profit;
         worstTicket = ticket;
         worstSymbol = symbol;
      }
   }
   
   // Fermer la position la plus ancienne en perte OU la pire position
   ulong ticketToClose = (oldestTicket > 0) ? oldestTicket : worstTicket;
   
   if(ticketToClose > 0)
   {
      if(!PositionSelectByTicket(ticketToClose))
      {
         Print("âš ï¸ Position dÃ©jÃ  fermÃ©e avant rotation - ticket=", ticketToClose);
         return;
      }
      
      string symbolToClose = PositionGetString(POSITION_SYMBOL);
      double positionProfit = PositionGetDouble(POSITION_PROFIT);
      
      // Fermer seulement si c'est une position en perte ou si elle est ouverte depuis plus de 30 minutes
      datetime positionTime = (datetime)PositionGetInteger(POSITION_TIME);
      int minutesOpen = (int)(TimeCurrent() - positionTime) / 60;
      
      if(positionProfit < -0.2 || minutesOpen > 30)
      {
         Print("ðŸ”„ ROTATION AUTO - Fermeture position: ", symbolToClose, 
               " | Profit: ", DoubleToString(positionProfit, 2), "$",
               " | Ã‚ge: ", minutesOpen, " min");
         
         if(PositionCloseWithLog(ticketToClose, "Rotation automatique"))
         {
            Print("âœ… ROTATION AUTO - Position fermÃ©e avec succÃ¨s - LibÃ¨re place pour nouvelles opportunitÃ©s");
         }
         else
         {
            int err = GetLastError();
            Print("âŒ ROTATION AUTO - Ã‰chec fermeture position: ", symbolToClose, " | Erreur: ", err);
         }
      }
      else
      {
         Print("ðŸ”„ ROTATION AUTO - Position conservÃ©e: ", symbolToClose, 
               " | Profit: ", DoubleToString(positionProfit, 2), "$",
               " | Ã‚ge: ", minutesOpen, " min (tÃ´t ou profitable)");
      }
   }
   else
   {
      Print("ðŸ”„ ROTATION AUTO - Aucune position Ã©ligible Ã  la fermeture");
   }
}

//+------------------------------------------------------------------+
//| Place S/R 20-bar limit orders - spike entry points               |
//| BUY_LIMIT juste EN-DESSOUS support (rebond spike haussier)       |
//| SELL_LIMIT juste AU-DESSUS rÃ©sistance (rebond spike baissier)    |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| S/R 20 bars DÃ‰JÃ€ TOUCHÃ‰ + REBONDI -> impulsion forte.            |
//| Logique: on suit l'Ã©tat "prix dans la zone S/R 20 bars". Quand   |
//| le prix ENTRE dans la zone (touch) puis EN SORT vers l'extÃ©rieur   |
//| (rebond/refus), on arme le flag de direction. Le flag reste armÃ©   |
//| un certain nombre de bougies (fenÃªtre de chaÃ®ne de spikes).        |
//+------------------------------------------------------------------+
void UpdateSR20BounceState()
{
    if(!UseSR20BarLimits && !UseImpulseZone) return;

    // Limiter aux symboles de type spike (Boom/Crash/Painx/Gainx)
    if(!SMC_IsSpikeStyleSymbol(_Symbol)) return;

    // Calculer (ou rafraÃ®chir) les extrÃªmes 20 bars indÃ©pendamment du flag
    // UseSR20BarLimits, car PlaceSRLimitOrders20Bars peut ne pas tourner.
    double atrVal = 0;
    if(atrHandle != INVALID_HANDLE)
    {
        double atr[]; ArraySetAsSeries(atr, true);
        if(CopyBuffer(atrHandle, 0, 0, 1, atr) >= 1) atrVal = atr[0];
    }
    if(atrVal <= 0) atrVal = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 50;
    if(atrVal <= 0) return;

    int lowestIdx  = iLowest(_Symbol, PERIOD_CURRENT, MODE_LOW, 20, 1);
    int highestIdx = iHighest(_Symbol, PERIOD_CURRENT, MODE_HIGH, 20, 1);
    if(lowestIdx < 0 || highestIdx < 0) return;

    g_impulseSupport20    = iLow(_Symbol, PERIOD_CURRENT, lowestIdx);
    g_impulseResistance20 = iHigh(_Symbol, PERIOD_CURRENT, highestIdx);
    g_impulseSupBuffer   = atrVal * ImpulseZoneBufferATR;
    g_impulseResBuffer   = atrVal * ImpulseZoneBufferATR;

    double sup20 = g_impulseSupport20;
    double res20 = g_impulseResistance20;
    if(sup20 <= 0 || res20 <= 0) return;

    double supBuf = (g_impulseSupBuffer > 0) ? g_impulseSupBuffer : SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10;
    double resBuf = (g_impulseResBuffer > 0) ? g_impulseResBuffer : SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10;

    double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
    double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
    if(bid <= 0 || ask <= 0) return;
    double price = (bid + ask) * 0.5;

    // Ã‰tat actuel: le prix est-il DANS la zone (touch) ?
    bool inSup = (price <= sup20 + supBuf);
    bool inRes = (price >= res20 - resBuf);
    bool outSup = (price > sup20 + supBuf);   // clairement reparti au-dessus
    bool outRes = (price < res20 - resBuf);   // clairement reparti en-dessous

    // Expiration des armes aprÃ¨s la fenÃªtre
    if(g_sr20BounceBuyBars > 0)
    {
        g_sr20BounceBuyBars++;
        if(g_sr20BounceBuyBars > SR20BounceWindowBars)
        {
            g_sr20BounceBuyBars = 0;
            g_sr20BounceArmedBuy = false;
        }
    }
    if(g_sr20BounceSellBars > 0)
    {
        g_sr20BounceSellBars++;
        if(g_sr20BounceSellBars > SR20BounceWindowBars)
        {
            g_sr20BounceSellBars = 0;
            g_sr20BounceArmedSell = false;
        }
    }

    // Compteurs "hors zone" pour confirmation du rebond (>= SR20BounceConfirmBars bougies)
    if(outSup) g_sr20OutOfSupBars++; else g_sr20OutOfSupBars = 0;
    if(outRes) g_sr20OutOfResBars++; else g_sr20OutOfResBars = 0;

    static bool s_prevInSup = false;
    static bool s_prevInRes = false;

    // Rebond support: Ã©tait DANS la zone, maintenant HORS zone pendant >= N bougies
    if(!inSup && s_prevInSup && g_sr20OutOfSupBars >= SR20BounceConfirmBars)
    {
        g_sr20BounceArmedBuy = true;
        g_sr20BounceBuyTime  = TimeCurrent();
        g_sr20BounceBuyBars   = 1;
        g_sr20BounceArmedSell = false;  // MUTEX: un seul cÃ´tÃ© armÃ© Ã  la fois
        g_sr20BounceSellBars  = 0;
        Print("ðŸŸ¢ SR20 BOUNCE: support 20 bars touchÃ©+rebondi (HAUSSIER) sur ", _Symbol,
              " | niveau=", DoubleToString(sup20, _Digits), " prix=", DoubleToString(price, _Digits));
    }

    // Rebond rÃ©sistance: Ã©tait DANS la zone, maintenant HORS zone pendant >= N bougies
    if(!inRes && s_prevInRes && g_sr20OutOfResBars >= SR20BounceConfirmBars)
    {
        g_sr20BounceArmedSell = true;
        g_sr20BounceSellTime  = TimeCurrent();
        g_sr20BounceSellBars   = 1;
        g_sr20BounceArmedBuy = false;   // MUTEX: un seul cÃ´tÃ© armÃ© Ã  la fois
        g_sr20BounceBuyBars  = 0;
        Print("ðŸ”´ SR20 BOUNCE: rÃ©sistance 20 bars touchÃ©e+rebondie (BAISSIER) sur ", _Symbol,
              " | niveau=", DoubleToString(res20, _Digits), " prix=", DoubleToString(price, _Digits));
    }

    s_prevInSup = inSup;
    s_prevInRes = inRes;
}

void PlaceSRLimitOrders20Bars()
{
    if(!UseSR20BarLimits || BlockAllTrades) return;
    if(Dow_IsDowOnlyLimitMode()) return;

    // GOM=WAIT : dÃ©jÃ  annulÃ© par le gate centralisÃ© OnTick â€” on sort simplement
    if(g_smcGomVerdictNum == 0 || !g_smcGomConnected) return;

    MqlRates rates[];
    ArraySetAsSeries(rates, true);
    if(CopyRates(_Symbol, PERIOD_CURRENT, 0, 25, rates) < 20) return;

   double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   int    dg    = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);

   double atrVal = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double atr[];
      ArraySetAsSeries(atr, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, atr) >= 1) atrVal = atr[0];
   }
   if(atrVal <= 0) atrVal = (SymbolInfoDouble(_Symbol, SYMBOL_ASK) - price) * 2.0;
   if(atrVal <= 0) return;

   // â”€â”€ Compter SEULEMENT nos ordres SR20 existants (pas les EMA SMC, etc.) â”€â”€
   int sr20BuyExists = 0, sr20SellExists = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) != _Symbol) continue;
      if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      string cmt = OrderGetString(ORDER_COMMENT);
      if(StringFind(cmt, "SR20") < 0) continue;
      ENUM_ORDER_TYPE ot = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(ot == ORDER_TYPE_BUY_LIMIT)  sr20BuyExists++;
      if(ot == ORDER_TYPE_SELL_LIMIT) sr20SellExists++;
   }
   int sr20Total = sr20BuyExists + sr20SellExists;
   if(sr20Total >= SR20BarMaxOrders) return;

   // â”€â”€ DÃ©tection pivot highs / lows sur 20 bars â”€â”€
   double supports[], resistances[];
   ArrayResize(supports, 0);
   ArrayResize(resistances, 0);

   for(int i = 2; i < 18; i++)
   {
      // Pivot Low (support): low[i] < low[i-1] et low[i] < low[i+1]
      if(rates[i].low < rates[i-1].low && rates[i].low < rates[i+1].low &&
         rates[i].low < rates[i-2].low && rates[i].low < rates[i+2].low)
      {
         int sz = ArraySize(supports);
         ArrayResize(supports, sz + 1);
         supports[sz] = rates[i].low;
      }
      // Pivot High (resistance): high[i] > high[i-1] et high[i] > high[i+1]
      if(rates[i].high > rates[i-1].high && rates[i].high > rates[i+1].high &&
         rates[i].high > rates[i-2].high && rates[i].high > rates[i+2].high)
      {
         int sz = ArraySize(resistances);
         ArrayResize(resistances, sz + 1);
         resistances[sz] = rates[i].high;
      }
   }

   if(ArraySize(supports) == 0 && ArraySize(resistances) == 0) return;

   // â”€â”€ Choisir le support et la rÃ©sistance les plus proches â”€â”€
   double bestSupport = 0, bestResistance = 0;
   double minDistSupport = 999 * atrVal, minDistResistance = 999 * atrVal;

   for(int i = 0; i < ArraySize(supports); i++)
   {
      if(supports[i] < price && supports[i] > 0)
      {
         double dist = price - supports[i];
         if(dist < minDistSupport && dist < atrVal * SR20BarMaxDistATR)
         {
            minDistSupport = dist;
            bestSupport = supports[i];
         }
      }
   }

   for(int i = 0; i < ArraySize(resistances); i++)
   {
      if(resistances[i] > price && resistances[i] > 0)
      {
         double dist = resistances[i] - price;
         if(dist < minDistResistance && dist < atrVal * SR20BarMaxDistATR)
         {
            minDistResistance = dist;
            bestResistance = resistances[i];
         }
      }
   }

    Print("ðŸ“Š SR20 Pivots: ", ArraySize(supports), " supports, ", ArraySize(resistances),
          " resistances | Best: S=", DoubleToString(bestSupport, dg),
          " R=", DoubleToString(bestResistance, dg),
          " | Price=", DoubleToString(price, dg),
          " | SR20 orders: ", sr20Total, "/", SR20BarMaxOrders);

    // â”€â”€ Dessiner les lignes S/R 20 bars sur le graphique â”€â”€
    datetime now = TimeCurrent();
    datetime future = now + PeriodSeconds(PERIOD_CURRENT) * 200;

    string supName  = "SR20_Support_"   + _Symbol;
    string resName  = "SR20_Resistance_" + _Symbol;
    string supLabel = "SR20_SUP_LABEL_" + _Symbol;
    string resLabel = "SR20_RES_LABEL_" + _Symbol;

    // Support: ligne blanche Ã©paisse pleine
    if(bestSupport > 0)
    {
       ObjectDelete(0, supName);
       if(ObjectCreate(0, supName, OBJ_TREND, 0, now, bestSupport, future, bestSupport))
       {
          ObjectSetInteger(0, supName, OBJPROP_COLOR, clrWhite);
          ObjectSetInteger(0, supName, OBJPROP_WIDTH, 3);
          ObjectSetInteger(0, supName, OBJPROP_STYLE, STYLE_SOLID);
          ObjectSetInteger(0, supName, OBJPROP_RAY_RIGHT, false);
          ObjectSetInteger(0, supName, OBJPROP_BACK, false);
          ObjectSetString(0, supName, OBJPROP_TEXT, "SR20 Support");
       }
       // Label
       ObjectDelete(0, supLabel);
       if(ObjectCreate(0, supLabel, OBJ_TEXT, 0, now, bestSupport))
       {
          ObjectSetString(0, supLabel, OBJPROP_TEXT, "SR20 â–² " + DoubleToString(bestSupport, dg));
          ObjectSetInteger(0, supLabel, OBJPROP_COLOR, clrWhite);
          ObjectSetInteger(0, supLabel, OBJPROP_FONTSIZE, 8);
          ObjectSetString(0, supLabel, OBJPROP_FONT, "Arial Bold");
       }
    }
    else
    {
       ObjectDelete(0, supName);
       ObjectDelete(0, supLabel);
    }

    // RÃ©sistance: ligne blanche Ã©paisse pleine
    if(bestResistance > 0)
    {
       ObjectDelete(0, resName);
       if(ObjectCreate(0, resName, OBJ_TREND, 0, now, bestResistance, future, bestResistance))
       {
          ObjectSetInteger(0, resName, OBJPROP_COLOR, clrWhite);
          ObjectSetInteger(0, resName, OBJPROP_WIDTH, 3);
          ObjectSetInteger(0, resName, OBJPROP_STYLE, STYLE_SOLID);
          ObjectSetInteger(0, resName, OBJPROP_RAY_RIGHT, false);
          ObjectSetInteger(0, resName, OBJPROP_BACK, false);
          ObjectSetString(0, resName, OBJPROP_TEXT, "SR20 Resistance");
       }
       // Label
       ObjectDelete(0, resLabel);
       if(ObjectCreate(0, resLabel, OBJ_TEXT, 0, now, bestResistance))
       {
          ObjectSetString(0, resLabel, OBJPROP_TEXT, "SR20 â–¼ " + DoubleToString(bestResistance, dg));
          ObjectSetInteger(0, resLabel, OBJPROP_COLOR, clrWhite);
          ObjectSetInteger(0, resLabel, OBJPROP_FONTSIZE, 8);
          ObjectSetString(0, resLabel, OBJPROP_FONT, "Arial Bold");
       }
    }
    else
    {
       ObjectDelete(0, resName);
       ObjectDelete(0, resLabel);
    }

   // â”€â”€ Supprimer les anciens ordres SR20 si le niveau a shiftÃ© â”€â”€
   if(SR20BarCancelOnShift && (bestSupport > 0 || bestResistance > 0))
   {
      for(int i = OrdersTotal() - 1; i >= 0; i--)
      {
         ulong ticket = OrderGetTicket(i);
         if(ticket == 0) continue;
         if(OrderGetString(ORDER_SYMBOL) != _Symbol) continue;
         if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
         string cmt = OrderGetString(ORDER_COMMENT);
         if(StringFind(cmt, "SR20") < 0) continue;

         ENUM_ORDER_TYPE otype = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
         double op = OrderGetDouble(ORDER_PRICE_OPEN);

         if(otype == ORDER_TYPE_BUY_LIMIT && bestSupport > 0 && MathAbs(op - bestSupport) > atrVal * 0.3)
         {
            trade.OrderDelete(ticket);
            sr20BuyExists--;
            Print("ðŸ”„ SR20 BUY_LIMIT annulÃ© (shift): prix ", DoubleToString(op, dg),
                  " â‰  support ", DoubleToString(bestSupport, dg));
         }
         if(otype == ORDER_TYPE_SELL_LIMIT && bestResistance > 0 && MathAbs(op - bestResistance) > atrVal * 0.3)
         {
            trade.OrderDelete(ticket);
            sr20SellExists--;
            Print("ðŸ”„ SR20 SELL_LIMIT annulÃ© (shift): prix ", DoubleToString(op, dg),
                  " â‰  rÃ©sistance ", DoubleToString(bestResistance, dg));
         }
      }
   }

     // â”€â”€ Placer BUY_LIMIT juste en dessous du support (spike rebond) â”€â”€
     // Sur Crash/Painx: PAS de BUY LIMIT (uniquement SELL)
     // DOW GATE: Si DOW Proj actif, n'autoriser que si DOW confirme la direction
     bool dowConfirmsBuy  = (!UseDowTrendline || (g_dowState.active && !g_dowState.isBearish));
     bool dowConfirmsSell = (!UseDowTrendline || (g_dowState.active && g_dowState.isBearish));
     bool dowInactive     = (UseDowTrendline && !g_dowState.active);
     
     // Si DOW actif et ne confirme pas BUY â†’ skip
     if(bestSupport > 0 && sr20BuyExists < 1 && sr20Total < SR20BarMaxOrders
        && !IsCrashLikeSymbol(_Symbol) && !dowInactive && dowConfirmsBuy)
   {
       // Offset: 2 points sous le support pour capter le spike rebond
       double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
       if(tickSize <= 0) tickSize = point;
       double entry = NormalizeDouble(bestSupport - point * 2, dg);
      double sl    = NormalizeDouble(entry - atrVal * SR20BarSL_ATRMult, dg);
      double tp    = NormalizeDouble(entry + atrVal * SR20BarTP_ATRMult, dg);

      MqlTradeRequest req = {};
      MqlTradeResult  res = {};
      req.action   = TRADE_ACTION_PENDING;
      req.symbol   = _Symbol;
      req.volume   = NormalizeVolumeForSymbol(0.01);
      req.type     = ORDER_TYPE_BUY_LIMIT;
      req.price    = entry;
      req.sl       = sl;
      req.tp       = tp;
      req.magic    = InpMagicNumber;
       req.comment  = "SR20 BUY LIMIT";

        if(!CanPlaceLimitOrder(_Symbol, ORDER_TYPE_BUY_LIMIT)) { ReleaseOpenLock(); return; }
        CleanupExcessLimits(_Symbol, 2);
        if(!SMC_FinalOpenGate(_Symbol, ORDER_TYPE_BUY_LIMIT)) { ReleaseOpenLock(); return; }
        if(ValidateAndAdjustLimitPrice(req.price, req.sl, req.tp, ORDER_TYPE_BUY_LIMIT))
        {
           if(trade.OrderSend(req, res))
          {
             Print("ðŸ“Š SR20 BUY_LIMIT @ ", req.price, " (support ", bestSupport,
                   ") | SL=", req.sl, " | TP=", req.tp, " | ATR=", DoubleToString(atrVal, dg));
             sr20BuyExists++;
             SMC_GateRegisterOpened(_Symbol, true);
             // WhatsApp SR20 signal
             SendSR20WhatsAppSignal("SR20_ENTRY", _Symbol, "BUY",
                                    req.price, req.sl, req.tp, price,
                                    bestSupport, "SUPPORT", atrVal,
                                    0, 0, "");
             return; // â”€â”€ un seul ordre d'ouverture par appel : jamais BUY+SELL dans le mÃªme passage â”€â”€
          }
          else
             Print("âŒ SR20 BUY_LIMIT Ã©chouÃ©: ", res.retcode, " - ", res.comment);
       }
   }

     // â”€â”€ Placer SELL_LIMIT juste au-dessus de la rÃ©sistance (spike rejet) â”€â”€
     // Sur Boom/Gainx: PAS de SELL LIMIT (uniquement BUY)
     if(bestResistance > 0 && sr20SellExists < 1 && sr20Total < SR20BarMaxOrders
        && !IsBoomLikeSymbol(_Symbol) && !dowInactive && dowConfirmsSell)
   {
       double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
       if(tickSize <= 0) tickSize = point;
       double entry = NormalizeDouble(bestResistance + point * 2, dg);
      double sl    = NormalizeDouble(entry + atrVal * SR20BarSL_ATRMult, dg);
      double tp    = NormalizeDouble(entry - atrVal * SR20BarTP_ATRMult, dg);

      MqlTradeRequest req = {};
      MqlTradeResult  res = {};
      req.action   = TRADE_ACTION_PENDING;
      req.symbol   = _Symbol;
      req.volume   = NormalizeVolumeForSymbol(0.01);
      req.type     = ORDER_TYPE_SELL_LIMIT;
      req.price    = entry;
      req.sl       = sl;
      req.tp       = tp;
      req.magic    = InpMagicNumber;
       req.comment  = "SR20 SELL LIMIT";

        if(!CanPlaceLimitOrder(_Symbol, ORDER_TYPE_SELL_LIMIT)) { ReleaseOpenLock(); return; }
        CleanupExcessLimits(_Symbol, 2);
        if(!SMC_FinalOpenGate(_Symbol, ORDER_TYPE_SELL_LIMIT)) { ReleaseOpenLock(); return; }
        if(ValidateAndAdjustLimitPrice(req.price, req.sl, req.tp, ORDER_TYPE_SELL_LIMIT))
        {
           if(trade.OrderSend(req, res))
          {
             Print("ðŸ“Š SR20 SELL_LIMIT @ ", req.price, " (rÃ©sistance ", bestResistance,
                   ") | SL=", req.sl, " | TP=", req.tp, " | ATR=", DoubleToString(atrVal, dg));
             sr20SellExists++;
             SMC_GateRegisterOpened(_Symbol, false);
             // WhatsApp SR20 signal
             SendSR20WhatsAppSignal("SR20_ENTRY", _Symbol, "SELL",
                                    req.price, req.sl, req.tp, price,
                                    bestResistance, "RESISTANCE", atrVal,
                                    0, 0, "");
             return; // â”€â”€ un seul ordre d'ouverture par appel : jamais BUY+SELL dans le mÃªme passage â”€â”€
          }
         else
             Print("âŒ SR20 SELL_LIMIT Ã©chouÃ©: ", res.retcode, " - ", res.comment);
      }
   }

   // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   // IMPULSE ZONE : niveau de forte impulsion 20 bars (spike trigger)
   // Utilise iLowest/iHighest sur 20 barres = extrÃªmes absolus
   // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   if(!UseImpulseZone) return;

   ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(_Symbol);
   bool isSpikeSymbol = (cat == SYM_BOOM_CRASH);
   if(!isSpikeSymbol && !ImpulseZoneShowOnChart) return;

   // Calculer les extrÃªmes absolus sur 20 barres (pas les pivots, les VRAIS min/max)
   int lowestIdx  = iLowest(_Symbol, PERIOD_CURRENT, MODE_LOW, 20, 1);
   int highestIdx = iHighest(_Symbol, PERIOD_CURRENT, MODE_HIGH, 20, 1);

   if(lowestIdx < 0 || highestIdx < 0) return;

   g_impulseSupport20    = iLow(_Symbol, PERIOD_CURRENT, lowestIdx);
   g_impulseResistance20 = iHigh(_Symbol, PERIOD_CURRENT, highestIdx);

   // Buffer en price = ATR Ã— multiplicateur
   g_impulseSupBuffer = atrVal * ImpulseZoneBufferATR;
   g_impulseResBuffer = atrVal * ImpulseZoneBufferATR;

   // VÃ©rifier si le prix touche les zones
   g_impulseSupTouched  = (price <= g_impulseSupport20 + g_impulseSupBuffer);
   g_impulseResTouched  = (price >= g_impulseResistance20 - g_impulseResBuffer);

   // â”€â”€ Dessiner les zones d'impulsion (rectangles colorÃ©s) â”€â”€
   if(ImpulseZoneShowOnChart)
   {
      datetime now = TimeCurrent();
      datetime future = now + PeriodSeconds(PERIOD_CURRENT) * 100;

      // Zone Support = vert semi-transparent
      string supZone = "IMPULSE_SUP_ZONE_" + _Symbol;
      string supLine = "IMPULSE_SUP_LINE_" + _Symbol;
      string supTxt  = "IMPULSE_SUP_TXT_" + _Symbol;

      if(g_impulseSupport20 > 0)
      {
         ObjectDelete(0, supZone);
         if(ObjectCreate(0, supZone, OBJ_RECTANGLE, 0, now, g_impulseSupport20 - g_impulseSupBuffer, future, g_impulseSupport20 + g_impulseSupBuffer))
         {
            ObjectSetInteger(0, supZone, OBJPROP_COLOR, g_impulseSupTouched ? clrLime : clrDarkGreen);
            ObjectSetInteger(0, supZone, OBJPROP_BACK, true);
            ObjectSetInteger(0, supZone, OBJPROP_FILL, true);
            ObjectSetInteger(0, supZone, OBJPROP_WIDTH, 1);
         }
         // Ligne centrale
         ObjectDelete(0, supLine);
         if(ObjectCreate(0, supLine, OBJ_TREND, 0, now, g_impulseSupport20, future, g_impulseSupport20))
         {
            ObjectSetInteger(0, supLine, OBJPROP_COLOR, clrLime);
            ObjectSetInteger(0, supLine, OBJPROP_WIDTH, 2);
            ObjectSetInteger(0, supLine, OBJPROP_STYLE, STYLE_SOLID);
            ObjectSetInteger(0, supLine, OBJPROP_RAY_RIGHT, false);
            ObjectSetInteger(0, supLine, OBJPROP_BACK, false);
         }
         // Label
         ObjectDelete(0, supTxt);
         if(ObjectCreate(0, supTxt, OBJ_TEXT, 0, now, g_impulseSupport20))
         {
            string touchTxt = g_impulseSupTouched ? " âš¡ IMPULSE!" : "";
            ObjectSetString(0, supTxt, OBJPROP_TEXT,
               "âš¡ IMPULSE SUP " + DoubleToString(g_impulseSupport20, dg) + touchTxt);
            ObjectSetInteger(0, supTxt, OBJPROP_COLOR, g_impulseSupTouched ? clrLime : clrDarkGreen);
            ObjectSetInteger(0, supTxt, OBJPROP_FONTSIZE, 8);
            ObjectSetString(0, supTxt, OBJPROP_FONT, "Consolas Bold");
         }
      }

      // Zone RÃ©sistance = rouge semi-transparent
      string resZone = "IMPULSE_RES_ZONE_" + _Symbol;
      string resLine = "IMPULSE_RES_LINE_" + _Symbol;
      string resTxt  = "IMPULSE_RES_TXT_" + _Symbol;

      if(g_impulseResistance20 > 0)
      {
         ObjectDelete(0, resZone);
         if(ObjectCreate(0, resZone, OBJ_RECTANGLE, 0, now, g_impulseResistance20 - g_impulseResBuffer, future, g_impulseResistance20 + g_impulseResBuffer))
         {
            ObjectSetInteger(0, resZone, OBJPROP_COLOR, g_impulseResTouched ? clrRed : clrDarkRed);
            ObjectSetInteger(0, resZone, OBJPROP_BACK, true);
            ObjectSetInteger(0, resZone, OBJPROP_FILL, true);
            ObjectSetInteger(0, resZone, OBJPROP_WIDTH, 1);
         }
         // Ligne centrale
         ObjectDelete(0, resLine);
         if(ObjectCreate(0, resLine, OBJ_TREND, 0, now, g_impulseResistance20, future, g_impulseResistance20))
         {
            ObjectSetInteger(0, resLine, OBJPROP_COLOR, clrRed);
            ObjectSetInteger(0, resLine, OBJPROP_WIDTH, 2);
            ObjectSetInteger(0, resLine, OBJPROP_STYLE, STYLE_SOLID);
            ObjectSetInteger(0, resLine, OBJPROP_RAY_RIGHT, false);
            ObjectSetInteger(0, resLine, OBJPROP_BACK, false);
         }
         // Label
         ObjectDelete(0, resTxt);
         if(ObjectCreate(0, resTxt, OBJ_TEXT, 0, now, g_impulseResistance20))
         {
            string touchTxt = g_impulseResTouched ? " âš¡ IMPULSE!" : "";
            ObjectSetString(0, resTxt, OBJPROP_TEXT,
               "âš¡ IMPULSE RES " + DoubleToString(g_impulseResistance20, dg) + touchTxt);
            ObjectSetInteger(0, resTxt, OBJPROP_COLOR, g_impulseResTouched ? clrRed : clrDarkRed);
            ObjectSetInteger(0, resTxt, OBJPROP_FONTSIZE, 8);
            ObjectSetString(0, resTxt, OBJPROP_FONT, "Consolas Bold");
         }
      }
   }

   // â”€â”€ AUTO-TRADE IMPULSE ZONE (Boom/Crash/Painx/Gainx) â”€â”€
   if(!ImpulseZoneAutoTrade || !isSpikeSymbol) return;
   if(CountPositionsForSymbol(_Symbol) > 0) return;
    // â”€â”€ GOM WAIT / DÃ‰CONNECTÃ‰: AUCUN ordre autorisÃ© (toujours, mÃªme sans UseGOMVerdictFilter) â”€â”€
    if(!g_smcGomConnected || g_smcGomVerdictNum == 0)
    {
       static datetime s_lastImpulseBlock = 0;
       if(TimeCurrent() - s_lastImpulseBlock >= 30)
       {
          Print("âŒ IMPULSE REJETÃ‰ â€” GOM ",
                (!g_smcGomConnected ? "dÃ©connectÃ©" : "verdict=WAIT"),
                " â€” Aucun ordre autorisÃ©");
          s_lastImpulseBlock = TimeCurrent();
       }
       return;
    }
    // â”€â”€ GOM SIMPLE: bloquer si UseGOMVerdictFilter activÃ© â”€â”€
    if(UseGOMVerdictFilter && MathAbs(g_smcGomVerdictNum) < MinGOMVerdictNumAbs)
    {
       static datetime s_lastImpulseBlockSimple = 0;
       if(TimeCurrent() - s_lastImpulseBlockSimple >= 30)
       {
          Print("âŒ IMPULSE REJETÃ‰ â€” GOM verdict=SIMPLE vn=", g_smcGomVerdictNum,
                " â€” exige GOOD/PERFECT |vn|>=", MinGOMVerdictNumAbs);
          s_lastImpulseBlockSimple = TimeCurrent();
       }
       return;
    }

   bool isBoom = IsBoomLikeSymbol(_Symbol);

   // Boom/Gainx â†’ BUY si prix touche support impulse
   // Crash/Painx â†’ SELL si prix touche rÃ©sistance impulse
   bool impulseBuy  = (isBoom && g_impulseSupTouched && g_impulseSupport20 > 0);
   bool impulseSell = (!isBoom && g_impulseResTouched && g_impulseResistance20 > 0);

   if(!impulseBuy && !impulseSell) return;

   if(!TryAcquireOpenLock()) return;

    double lot = CalculateLotSize();
    if(lot <= 0) { ReleaseOpenLock(); return; }

    // â”€â”€ GOM verdict != WAIT â†’ exÃ©cuter le market order impulse â”€â”€
   // Bloquer si direction opposÃ©e au verdict GOM
   if(g_smcGomConnected)
   {
      if(impulseBuy && g_smcGomVerdictNum < 0)
      {
         Print("ðŸš« IMPULSE BUY BLOQUÃ‰ â€” GOM verdict=", g_smcGomVerdict, " (vn=", g_smcGomVerdictNum, ") â€” direction SELL");
         ReleaseOpenLock(); return;
      }
      if(impulseSell && g_smcGomVerdictNum > 0)
      {
         Print("ðŸš« IMPULSE SELL BLOQUÃ‰ â€” GOM verdict=", g_smcGomVerdict, " (vn=", g_smcGomVerdictNum, ") â€” direction BUY");
         ReleaseOpenLock(); return;
      }
   }
   bool orderOK = false;

double entry = 0;
if(impulseBuy)
     {
        if(!CanTradeOnSymbol(_Symbol, "BUY")) { Print("ðŸš« IMPULSE BUY BLOQUÃ‰ â€” Terminal plein, sens interdit, retournement ou ordre existant sur ", _Symbol); ReleaseOpenLock(); return; }
        entry = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
        double sl = NormalizeDouble(entry - atrVal * ImpulseZoneSL_ATRMult, dg);
        double tp = NormalizeDouble(entry + atrVal * ImpulseZoneTP_ATRMult, dg);

        if(!SMC_FinalOpenGate(_Symbol, ORDER_TYPE_BUY)) { ReleaseOpenLock(); return; }
        if(SafeTradeBuy(lot, _Symbol, entry, sl, tp, "IMPULSE BUY"))
       {
          RegisterOrderPlaced();
          SMC_GateRegisterOpened(_Symbol, true);
          orderOK = true;
          ulong ticket = trade.ResultOrder();
          if(ticket > 0) SMC_ApplyPostEntrySLBuffer(_Symbol, ticket, 1.0);
          Print("âš¡ IMPULSE BUY ", _Symbol, " @", DoubleToString(entry, dg),
                " | Zone supp: ", DoubleToString(g_impulseSupport20, dg),
                " Â±", DoubleToString(g_impulseSupBuffer, dg),
                " | GOM=", g_smcGomVerdict, " (vn=", g_smcGomVerdictNum, ")",
                " | SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg));
       }
    }
     else if(impulseSell)
     {
        if(!CanTradeOnSymbol(_Symbol, "SELL")) { Print("ðŸš« IMPULSE SELL BLOQUÃ‰ â€” Terminal plein, sens interdit, retournement ou ordre existant sur ", _Symbol); ReleaseOpenLock(); return; }
        entry = SymbolInfoDouble(_Symbol, SYMBOL_BID);
        double sl = NormalizeDouble(entry + atrVal * ImpulseZoneSL_ATRMult, dg);
        double tp = NormalizeDouble(entry - atrVal * ImpulseZoneTP_ATRMult, dg);

        if(!SMC_FinalOpenGate(_Symbol, ORDER_TYPE_SELL)) { ReleaseOpenLock(); return; }
        if(SafeTradeSell(lot, _Symbol, entry, sl, tp, "IMPULSE SELL"))
       {
          RegisterOrderPlaced();
          SMC_GateRegisterOpened(_Symbol, false);
          orderOK = true;
          ulong ticket = trade.ResultOrder();
          if(ticket > 0) SMC_ApplyPostEntrySLBuffer(_Symbol, ticket, 1.0);
          Print("âš¡ IMPULSE SELL ", _Symbol, " @", DoubleToString(entry, dg),
                " | Zone res: ", DoubleToString(g_impulseResistance20, dg),
                " Â±", DoubleToString(g_impulseResBuffer, dg),
                " | GOM=", g_smcGomVerdict, " (vn=", g_smcGomVerdictNum, ")",
                " | SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg));
       }
    }

   ReleaseOpenLock();

   if(orderOK)
   {
      g_maxProfit = 0;
      if(UseNotifications)
      {
         string dir = impulseBuy ? "BUY" : "SELL";
         SendNotification("âš¡ IMPULSE " + dir + " " + _Symbol + " @ " + DoubleToString(entry, dg));
      }
   }
}

//+------------------------------------------------------------------+ 
//| DIAGNOSTIC v1.28 - Terminal et test d'ordre                     |
//+------------------------------------------------------------------+ 
void SMC_RunTerminalDiagnostic()
{
   Print("=== DIAGNOSTIC TERMINAL v1.28 ===");
   Print("Terminal: ", TerminalInfoString(TERMINAL_COMPANY));
   Print("Account: ", AccountInfoInteger(ACCOUNT_LOGIN));
   Print("Server: ", AccountInfoString(ACCOUNT_SERVER));
   Print("Balance: ", DoubleToString(AccountInfoDouble(ACCOUNT_BALANCE), 2), " $");
   Print("Equity: ", DoubleToString(AccountInfoDouble(ACCOUNT_EQUITY), 2), " $");
   Print("Margin Free: ", DoubleToString(AccountInfoDouble(ACCOUNT_MARGIN_FREE), 2), " $");
   Print("Trade Allowed: ", TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) ? "YES" : "NO");
   Print("Connected: ", TerminalInfoInteger(TERMINAL_CONNECTED) ? "YES" : "NO");
   Print("AutoTrading: ", TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) ? "ENABLED" : "DISABLED");
   Print("Symbol: ", _Symbol);
   Print("Bid: ", SymbolInfoDouble(_Symbol, SYMBOL_BID));
   Print("Ask: ", SymbolInfoDouble(_Symbol, SYMBOL_ASK));
   Print("Spread: ", DoubleToString((SymbolInfoDouble(_Symbol, SYMBOL_ASK) - SymbolInfoDouble(_Symbol, SYMBOL_BID)) / SymbolInfoDouble(_Symbol, SYMBOL_BID) * 100, 2), "%");
   Print("=== FIN DIAGNOSTIC ===");
}

void SMC_PlaceDiagnosticTestOrder()
{
   Print("=== TEST ORDRE DIAGNOSTIC ===");
   Print("Symbole: ", DiagnosticTestSymbol);
   Print("Lot: ", DiagnosticTestLot);
   // FIX 2026-10-09: Passer par FinalOpenGate pour validation cohÃ©rente
   // (l'ordre de test doit respecter les mÃªmes gates que les ordres rÃ©els)

   // VÃ©rifier FinalOpenGate
   if(!SMC_FinalOpenGate(DiagnosticTestSymbol, ORDER_TYPE_BUY))
   {
      Print("âŒ TEST ORDRE BLOQUÃ‰ par FinalOpenGate");
      return;
   }

   MqlTradeRequest request = {};
   MqlTradeResult result = {};
   
   request.action = TRADE_ACTION_DEAL;
   request.symbol = DiagnosticTestSymbol;
   request.volume = DiagnosticTestLot;
   request.type = ORDER_TYPE_BUY;
   request.price = SymbolInfoDouble(DiagnosticTestSymbol, SYMBOL_ASK);
   request.sl = 0;
   request.tp = 0;
   request.deviation = 10;
   request.magic = InpMagicNumber;
   request.comment = "DIAGNOSTIC TEST v1.28";
   
   bool success = OrderSend(request, result);
   
   if(success)
   {
      Print("âœ… TEST ORDRE RÃ‰USSI - Ticket: ", result.order);
   }
   else
   {
      int error = GetLastError();
      Print("âŒ TEST ORDRE Ã‰CHOUÃ‰");
      Print("Error code: ", error);
      Print("Retcode: ", result.retcode);
      Print("Comment: ", result.comment);
      
      // Codes d'erreur dÃ©taillÃ©s
      switch(error)
      {
         case 4756: Print("Erreur: Trade request failed"); break;
         case 10004: Print("Erreur: Requote"); break;
         case 10006: Print("Erreur: Request rejected"); break;
         case 10007: Print("Erreur: Order cancelled by trader"); break;
         case 10010: Print("Erreur: Only partial execution"); break;
         case 10011: Print("Erreur: Trade error"); break;
         case 10012: Print("Erreur: Request timeout"); break;
         case 10013: Print("Erreur: Invalid request"); break;
         case 10014: Print("Erreur: Invalid volume"); break;
         case 10015: Print("Erreur: Invalid price"); break;
         case 10016: Print("Erreur: Invalid stops"); break;
         case 10017: Print("Erreur: Trade disabled"); break;
         case 10018: Print("Erreur: Market closed"); break;
         case 10019: Print("Erreur: Insufficient funds"); break;
         case 10020: Print("Erreur: Prices changed"); break;
         case 10021: Print("Erreur: No quotes"); break;
         case 10022: Print("Erreur: Invalid expiration"); break;
         case 10023: Print("Erreur: Order state changed"); break;
         case 10024: Print("Erreur: Too many requests"); break;
         case 10025: Print("Erreur: No changes"); break;
         case 10026: Print("Erreur: Autotrading disabled"); break;
         case 10027: Print("Erreur: Autotrading disabled by client"); break;
         case 10028: Print("Erreur: Request blocked"); break;
         case 10029: Print("Erreur: Connection lost"); break;
         case 10030: Print("Erreur: Only for real accounts"); break;
         case 10031: Print("Erreur: Position limit reached"); break;
         case 10032: Print("Erreur: Pending order limit reached"); break;
         case 10033: Print("Erreur: Volume limit reached"); break;
         case 10034: Print("Erreur: Prohibition"); break;
         case 10035: Print("Erreur: Connection rejected"); break;
         case 10036: Print("Erreur: Only for demo accounts"); break;
         case 10038: Print("Erreur: Order filled"); break;
         case 10039: Print("Erreur: Order not found"); break;
         case 10040: Print("Erreur: Order already exists"); break;
         case 10041: Print("Erreur: Order executed"); break;
         case 10042: Print("Erreur: Order expired"); break;
         case 10043: Print("Erreur: Order cancelled"); break;
         case 10044: Print("Erreur: Order rejected"); break;
         case 10045: Print("Erreur: Order cancelled by client"); break;
         case 10046: Print("Erreur: Order rejected by broker"); break;
         case 10047: Print("Erreur: Order rejected by broker"); break;
         default: Print("Erreur: Unknown error"); break;
      }
   }
   Print("=== FIN TEST ORDRE ===");
}

//+------------------------------------------------------------------+ 
//| DÃ©tecte si l'heure du serveur correspond Ã  une Killzone ICT      |
//| IntÃ©grÃ© depuis SMC_Universal_Improved.mq5                        |
//+------------------------------------------------------------------+ 
bool ICT_IsInsideKillzone()
{
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);

   // Conversion de l'heure serveur en heure de New York
   int nyHour = dt.hour - ServerToNYOffset;
   if(nyHour < 0) nyHour += 24;

   // London Open Killzone (2:00 - 5:00 NY Time)
   if(nyHour >= 2 && nyHour < 5)
   {
      //Print("ðŸ• ICT Killzone: London Open activÃ©");
      return true;
   }

   // New York Open Killzone (7:00 - 10:00 NY Time)
   if(nyHour >= 7 && nyHour < 10)
   {
      //Print("ðŸ• ICT Killzone: New York Open activÃ©");
      return true;
   }

   // London Close Killzone (10:00 - 12:00 NY Time)
   if(nyHour >= 10 && nyHour < 12)
   {
      //Print("ðŸ• ICT Killzone: London Close activÃ©");
      return true;
   }

   return false;
}

//+------------------------------------------------------------------+
//| Scan et enregistre les Fair Value Gaps (FVG)                     |
//| IntÃ©grÃ© depuis SMC_Universal_Improved.mq5                        |
//+------------------------------------------------------------------+
void ICT_ScanForFVGs()
{
   if(!UseFVGDetection) return;

   double high[], low[];
   ArraySetAsSeries(high, true);
   ArraySetAsSeries(low, true);

   if(CopyHigh(_Symbol, _Period, 0, 4, high) < 4 || CopyLow(_Symbol, _Period, 0, 4, low) < 4) return;

   // FVG clÃ´turÃ©: bougie 1 vs bougie 3 (la bougie 2 = displacement)
   if(low[1] > high[3])
   {
      bool alreadyExists = false;
      for(int i = 0; i < ArraySize(fvgDataArray); i++)
      {
         if(MathAbs(fvgDataArray[i].bottom - high[3]) < _Point * 10)
         {
            alreadyExists = true;
            break;
         }
      }

      if(!alreadyExists)
      {
         int newSize = ArraySize(fvgDataArray) + 1;
         if(newSize > FVGMaxStored)
         {
            ArrayCopy(fvgDataArray, fvgDataArray, 0, 1, newSize - 2);
            newSize = FVGMaxStored;
         }
         ArrayResize(fvgDataArray, newSize);

         fvgDataArray[newSize - 1].top = low[1];
         fvgDataArray[newSize - 1].bottom = high[3];
         fvgDataArray[newSize - 1].direction = 1;
         fvgDataArray[newSize - 1].time = iTime(_Symbol, _Period, 1);
         fvgDataArray[newSize - 1].isMitigated = false;
         fvgDataArray[newSize - 1].isInversion = false;
         fvgDataArray[newSize - 1].barIndex = 1;

         Print("ðŸ“Š Nouveau FVG Haussier dÃ©tectÃ© entre ", DoubleToString(high[3], _Digits), " et ", DoubleToString(low[1], _Digits));
      }
   }

   if(high[1] < low[3])
   {
      bool alreadyExists = false;
      for(int i = 0; i < ArraySize(fvgDataArray); i++)
      {
         if(MathAbs(fvgDataArray[i].top - low[3]) < _Point * 10)
         {
            alreadyExists = true;
            break;
         }
      }

      if(!alreadyExists)
      {
         int newSize = ArraySize(fvgDataArray) + 1;
         if(newSize > FVGMaxStored)
         {
            ArrayCopy(fvgDataArray, fvgDataArray, 0, 1, newSize - 2);
            newSize = FVGMaxStored;
         }
         ArrayResize(fvgDataArray, newSize);

         fvgDataArray[newSize - 1].top = low[3];
         fvgDataArray[newSize - 1].bottom = high[1];
         fvgDataArray[newSize - 1].direction = -1;
         fvgDataArray[newSize - 1].time = iTime(_Symbol, _Period, 1);
         fvgDataArray[newSize - 1].isMitigated = false;
         fvgDataArray[newSize - 1].isInversion = false;
         fvgDataArray[newSize - 1].barIndex = 1;

         Print("ðŸ“Š Nouveau FVG Baissier dÃ©tectÃ© entre ", DoubleToString(low[3], _Digits), " et ", DoubleToString(high[1], _Digits));
      }
   }
}

//+------------------------------------------------------------------+
//| VÃ©rifie si le prix est Ã  l'intÃ©rieur d'un FVG actif              |
//+------------------------------------------------------------------+
bool ICT_PriceInsideFVG(double price)
{
   if(!UseFVGDetection) return false;

   for(int i = 0; i < ArraySize(fvgDataArray); i++)
   {
      if(!fvgDataArray[i].isMitigated)
      {
         if(price >= fvgDataArray[i].bottom && price <= fvgDataArray[i].top)
         {
            return true;
         }
      }
   }
   return false;
}

//+------------------------------------------------------------------+
//| Marque les FVGs comme mitigÃ©s si le prix les traverse            |
//+------------------------------------------------------------------+
void ICT_UpdateFVGStatus(double currentPrice)
{
   if(!UseFVGDetection) return;

   for(int i = 0; i < ArraySize(fvgDataArray); i++)
   {
      if(!fvgDataArray[i].isMitigated)
      {
         if(fvgDataArray[i].direction == 1 && currentPrice < fvgDataArray[i].bottom)
         {
            fvgDataArray[i].isMitigated = true;
            Print("âœ… FVG Haussier mitigÃ© Ã  ", DoubleToString(currentPrice, _Digits));
         }
         else if(fvgDataArray[i].direction == -1 && currentPrice > fvgDataArray[i].top)
         {
            fvgDataArray[i].isMitigated = true;
            Print("âœ… FVG Baissier mitigÃ© Ã  ", DoubleToString(currentPrice, _Digits));
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Structure M5 (CHoCH) â€” Improved, filtrÃ©e par GOM ensuite         |
//+------------------------------------------------------------------+
void ICT_UpdateMarketStructure()
{
   int look = MathMax(8, ICTSwingLookback);
   double high[], low[], close[];
   ArraySetAsSeries(high, true);
   ArraySetAsSeries(low, true);
   ArraySetAsSeries(close, true);
   if(CopyHigh(_Symbol, PERIOD_M5, 0, look * 2, high) < look * 2) return;
   if(CopyLow(_Symbol, PERIOD_M5, 0, look * 2, low) < look * 2) return;
   if(CopyClose(_Symbol, PERIOD_M5, 0, look * 2, close) < look * 2) return;

   int highestIndex = ArrayMaximum(high, 1, look);
   int lowestIndex = ArrayMinimum(low, 1, look);
   if(highestIndex < 0 || lowestIndex < 0) return;
   double currentHigh = high[highestIndex];
   double currentLow = low[lowestIndex];

   if(g_ictMarketTrend == "BEARISH" && close[1] > currentHigh)
      g_ictMarketTrend = "BULLISH";
   else if(g_ictMarketTrend == "BULLISH" && close[1] < currentLow)
      g_ictMarketTrend = "BEARISH";
   else if(g_ictMarketTrend == "NEUTRAL")
   {
      if(close[1] > close[look]) g_ictMarketTrend = "BULLISH";
      else if(close[1] < close[look]) g_ictMarketTrend = "BEARISH";
   }
}

//+------------------------------------------------------------------+
//| Sweep + rÃ©intÃ©gration (Improved) â€” GOM GOOD/PERFECT obligatoire  |
//+------------------------------------------------------------------+
void ICT_CheckLiquiditySweepsAndExecute()
{
   if(!UseICTLiquiditySweep) return;
   if(BlockAllTrades) return;
   if(UseICTKillzoneFilter && !ICT_IsInsideKillzone()) return;
   if(!SMCGP_GomLinkOK() || !SMCGP_IsGoodPerfect(g_smcGomVerdictNum)) return;

   int dirSign = (g_smcGomVerdictNum > 0) ? 1 : -1;
   if(g_ictMarketTrend == "BULLISH" && dirSign < 0) return;
   if(g_ictMarketTrend == "BEARISH" && dirSign > 0) return;

   static datetime lastSweepEntry = 0;
   if(TimeCurrent() - lastSweepEntry < MathMax(15, UnifiedEntryCooldownSec)) return;
   if(CountPositionsForSymbol(_Symbol) > 0) return;

   MqlRates m1[];
   ArraySetAsSeries(m1, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 4, m1) < 4) return;

   bool sweptBuy = (dirSign > 0 &&
                    m1[1].low < m1[2].low &&
                    m1[1].close > m1[2].low &&
                    m1[1].close > m1[1].open);
   bool sweptSell = (dirSign < 0 &&
                     m1[1].high > m1[2].high &&
                     m1[1].close < m1[2].high &&
                     m1[1].close < m1[1].open);
   if(!sweptBuy && !sweptSell) return;

   if(!CanPlaceMarketOrder(_Symbol, dirSign)) return;
   ENUM_ORDER_TYPE ot = (dirSign > 0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   if(!SMC_FinalOpenGate(_Symbol, ot)) return;
   if(!TryAcquireOpenLock()) return;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if(bid <= 0.0 || ask <= bid) { ReleaseOpenLock(); return; }
   double price = (dirSign > 0) ? ask : bid;
   double atr = SMC_EffectiveSymbolATR(_Symbol);
   if(atr <= 0.0) atr = MathAbs(m1[1].high - m1[1].low);
   if(atr <= 0.0) { ReleaseOpenLock(); return; }

   double risk = MathMax(atr * 0.80, MathAbs(price - ((dirSign > 0) ? m1[1].low : m1[1].high)) + atr * 0.20);
   double rr = MathMax(2.0, MinRewardRiskRatio);
   double sl = (dirSign > 0) ? price - risk : price + risk;
   double tp = (dirSign > 0) ? price + risk * rr : price - risk * rr;
   int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   sl = NormalizeDouble(sl, digits);
   tp = NormalizeDouble(tp, digits);
   double lot = CalculateLotSize(_Symbol, price, sl);
   if(lot <= 0.0) { ReleaseOpenLock(); return; }

   bool ok = (dirSign > 0)
             ? SafeTradeBuy(lot, _Symbol, ask, sl, tp, "ICT-SWEEP BUY")
             : SafeTradeSell(lot, _Symbol, bid, sl, tp, "ICT-SWEEP SELL");
   if(ok)
   {
      lastSweepEntry = TimeCurrent();
      RegisterOrderPlaced();
      SMC_GateRegisterOpened(_Symbol, dirSign > 0);
      Print("[ICT-SWEEP] ", (dirSign > 0 ? "BUY" : "SELL"),
            " | GOM=", g_smcGomVerdict, " vn=", g_smcGomVerdictNum,
            " trend=", g_ictMarketTrend);
   }
   ReleaseOpenLock();
}

