int SMC_GetReactionTracker(const string symbol)
{
   for(int i = 0; i < g_reactionTrackerCount; i++)
      if(g_reactionTrackers[i].symbol == symbol) return i;
   if(g_reactionTrackerCount >= 64) return -1;
   int n = g_reactionTrackerCount++;
   g_reactionTrackers[n].symbol = symbol;
   g_reactionTrackers[n].dirSign = 0;
   g_reactionTrackers[n].m1Touched = false;
   g_reactionTrackers[n].fvgBrokenNoSpike = false;
   g_reactionTrackers[n].dowRetouched = false;
   g_reactionTrackers[n].m5Reacted = false;
   g_reactionTrackers[n].spikeSeen = false;
   g_reactionTrackers[n].stayAway = false;
   g_reactionTrackers[n].correctionExit = false;
   g_reactionTrackers[n].immTouchPending = false;
   g_reactionTrackers[n].immTouchBar = 0;
   g_reactionTrackers[n].immTouchLevel = 0.0;
   g_reactionTrackers[n].lastM1Touch = 0;
   g_reactionTrackers[n].lastFVGBreak = 0;
   g_reactionTrackers[n].lastDOWTouch = 0;
   g_reactionTrackers[n].rearmUntil = 0;
   g_reactionTrackers[n].lastPrice = 0.0;
   return n;
}

//+------------------------------------------------------------------+
//| Valeur d'une trendline OBJ_TREND Ã  l'instant `at` (interpolation) |
//+------------------------------------------------------------------+
double SMC_TrendLineValueAt(const string objName, const datetime at)
{
   long type = ObjectGetInteger(0, objName, OBJPROP_TYPE);
   if(type != OBJ_TREND) return 0.0;
   double p0 = ObjectGetDouble(0, objName, OBJPROP_PRICE, 0);
   double p1 = ObjectGetDouble(0, objName, OBJPROP_PRICE, 1);
   double x0 = (double)ObjectGetInteger(0, objName, OBJPROP_TIME, 0);
   double x1 = (double)ObjectGetInteger(0, objName, OBJPROP_TIME, 1);
   if(p0 <= 0.0 || p1 <= 0.0 || x1 <= x0) return 0.0;
   double x = (double)at;
   if(x <= x0) x = x0;
   if(x >= x1) x = x1;          // clamp : projection max = extrÃ©mitÃ© du segment
   return p0 + (p1 - p0) * (x - x0) / (x1 - x0);
}

bool SMC_FindReactionObjectLevel(const string symbol, const string token, double &level)
{
   level = 0.0;
   string searchTok = token;
   if(StringFind(searchTok, "SMC_FVG_DISP") == 0)
      StringReplace(searchTok, "SMC_FVG_DISP", "SMC_DISP_FVG");
   string exact[4];
   exact[0] = searchTok;
   exact[1] = searchTok + "_" + symbol;
   exact[2] = symbol + "_" + searchTok;
   exact[3] = searchTok + "_" + _Symbol;
   for(int k = 0; k < 4; k++)
   {
      if(ObjectFind(0, exact[k]) < 0) continue;
      // FIX 2026-09-19 (niveaux d'entrÃ©e GOM Pipeline) : pour les
      // trendlines GOM_TF_TL_*/TF_TL_*, le niveau d'entrÃ©e est la VALEUR
      // de la ligne Ã  TimeCurrent() (retest) â€” l'ancien code renvoyait le
      // prix de l'ancre gauche (~50 bougies en arriÃ¨re), dÃ©calÃ© dans le temps.
      if(StringFind(exact[k], "GOM_TF_TL") >= 0 || StringFind(exact[k], "TF_TL") >= 0 ||
         StringFind(exact[k], "DOW_TL") >= 0)
      {
         double lv = SMC_TrendLineValueAt(exact[k], TimeCurrent());
         if(lv > 0.0) { level = lv; return true; }
      }
      double p0 = ObjectGetDouble(0, exact[k], OBJPROP_PRICE, 0);
      double p1 = ObjectGetDouble(0, exact[k], OBJPROP_PRICE, 1);
      if(p0 > 0.0) { level = p0; return true; }
      if(p1 > 0.0) { level = p1; return true; }
   }

   // FIX Calibrage 2026-09-19 : les objets de trail FVG sont nommÃ©s
   // "SMC_DISP_FVG_TRAIL_Bull_2" (token + "_" + index) sans le symbole.
   // L'ancien code exigeait StringFind(name, symbol)>=0 -> la touche FVG
   // ne partait JAMAIS. On cherche maintenant par token seul, et parmi
   // plusieurs objets on retient celui dont le niveau est le PLUS PROCHE
   // du prix courant (pour FVG trail ce sont toutes les lignes mÃ©dianes).
   double bidPx = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double best = 0.0, bestDist = 1e100;
   int total = ObjectsTotal(0, 0, -1);
   for(int i = 0; i < total; i++)
   {
      string name = ObjectName(0, i, 0, -1);
      if(StringFind(name, searchTok) < 0 && StringFind(name, token) < 0) continue;
      double p0 = ObjectGetDouble(0, name, OBJPROP_PRICE, 0);
      double p1 = ObjectGetDouble(0, name, OBJPROP_PRICE, 1);
      double p = (p0 > 0.0) ? p0 : p1;
      // MÃªme traitement "valeur de la ligne Ã  maintenant" pour les trendlines
      if(StringFind(name, "GOM_TF_TL") >= 0 || StringFind(name, "TF_TL") >= 0 ||
         StringFind(name, "DOW_TL") >= 0)
      {
         double lv = SMC_TrendLineValueAt(name, TimeCurrent());
         if(lv > 0.0) p = lv;
      }
      if(p <= 0.0) continue;
      double d = (bidPx > 0.0) ? MathAbs(bidPx - p) : 0.0;
      if(d < bestDist) { bestDist = d; best = p; }
   }
   if(best > 0.0) { level = best; return true; }
   return false;
}

bool SMC_FindDOWProjectedLevel(double &level, bool &bearish)
{
   level = 0.0;
   bearish = false;

   double epBull = 0.0, epBear = 0.0;
   bool hasBull = SMC_FindReactionObjectLevel(_Symbol, "DOW_BULL_EP", epBull);
   bool hasBear = SMC_FindReactionObjectLevel(_Symbol, "DOW_BEAR_EP", epBear);
   if(hasBull && epBull > 0.0 && !(hasBear && epBear > 0.0))
   { level = epBull; bearish = false; return true; }
   if(hasBear && epBear > 0.0 && !(hasBull && epBull > 0.0))
   { level = epBear; bearish = true; return true; }
   if(hasBull && hasBear && epBull > 0.0 && epBear > 0.0)
   {
      double bidPx = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      if(MathAbs(bidPx - epBear) < MathAbs(bidPx - epBull))
      { level = epBear; bearish = true; }
      else
      { level = epBull; bearish = false; }
      return true;
   }

   if(ObjectFind(0, "DOW_TL_line") >= 0)
   {
      double lv = SMC_TrendLineValueAt("DOW_TL_line", TimeCurrent());
      if(lv <= 0.0) lv = ObjectGetDouble(0, "DOW_TL_line", OBJPROP_PRICE, 1);
      if(lv > 0.0)
      {
         level = lv;
         string tip = ObjectGetString(0, "DOW_TL_line", OBJPROP_TOOLTIP);
         string upper = tip;
         StringToUpper(upper);
         bearish = (StringFind(upper, "BEAR") >= 0);
         return true;
      }
   }

   if(ObjectFind(0, "DOW_TL_hline") >= 0)
   {
      double lv = ObjectGetDouble(0, "DOW_TL_hline", OBJPROP_PRICE, 0);
      if(lv > 0.0)
      {
         level = lv;
         string tip = ObjectGetString(0, "DOW_TL_line", OBJPROP_TOOLTIP);
         string upper = tip;
         StringToUpper(upper);
         bearish = (StringFind(upper, "BEAR") >= 0);
         return true;
      }
   }
   return false;
}

bool SMC_ReactionCrossed(const double previous, const double px, const double level)
{
   return (level > 0.0 && previous > 0.0 &&
           ((previous <= level && px >= level) || (previous >= level && px <= level)));
}

bool SMC_ReactionSpikeNow(const int dirSign, const double atr)
{
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 4, r) < 3) return false;
   double thr = atr * MathMax(0.70, SecondSpikeMinBodyATR * 0.55);
   for(int i = 0; i <= 1; i++)
   {
      double body = MathAbs(r[i].close - r[i].open);
      double range = r[i].high - r[i].low;
      bool dirOk = (dirSign > 0 && r[i].close > r[i].open) ||
                   (dirSign < 0 && r[i].close < r[i].open);
      if(dirOk && (body >= thr || range >= thr * 1.15))
         return true;
   }
   return false;
}

//| Prix a rÃ©agi (touch + reject) sur le trendline GOM_TF_TL_M5
//+------------------------------------------------------------------+
bool SMC_PriceReactedOnGOM_TL_M5(const int dirSign)
{
   if(dirSign == 0) return false;
   double lvl = 0.0;
   if(!SMC_FindReactionObjectLevel(_Symbol, "GOM_TF_TL_M5", lvl) || lvl <= 0.0)
   {
      string alt = "TF_TL_M5";
      if(!SMC_FindReactionObjectLevel(_Symbol, alt, lvl) || lvl <= 0.0)
         return false;
   }

   double atr = 0.0;
   double ab[];
   ArraySetAsSeries(ab, true);
   if(atrHandle != INVALID_HANDLE && CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1)
      atr = ab[0];
   if(atr <= 0.0) atr = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 50.0;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if(bid <= 0.0 || ask <= 0.0) return false;
   double px = (bid + ask) * 0.5;
   bool nearTL = (MathAbs(px - lvl) <= atr * 0.35);

   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, PERIOD_M5, 0, 2, r) < 1) return false;

   if(dirSign > 0)
   {
      // BUY : touch du support (low <= lvl + tol) puis rejet haussier (close > lvl)
      bool touch = (r[0].low <= lvl + atr * 0.15);
      bool reject = (r[0].close > lvl) && (r[0].close > r[0].open);
      return nearTL && touch && reject;
   }
   else
   {
      // SELL : touch de la rÃ©sistance (high >= lvl - tol) puis rejet baissier (close < lvl)
      bool touch = (r[0].high >= lvl - atr * 0.15);
      bool reject = (r[0].close < lvl) && (r[0].close < r[0].open);
      return nearTL && touch && reject;
   }
}

// 1 petite bougie M1 clÃ´turÃ©e dans le sens du trade (confirmation GOOD/PERFECT)
bool SMC_HasM1ConfirmCandle(const int dirSign, const double atr)
{
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 3, r) < 2) return false;
   double body = MathAbs(r[1].close - r[1].open);
   double range = r[1].high - r[1].low;
   if(range <= 0.0) return false;
   bool dirOk = (dirSign > 0 && r[1].close > r[1].open) ||
                (dirSign < 0 && r[1].close < r[1].open);
   if(!dirOk) return false;
   double smallMax = (atr > 0.0) ? atr * PostSpikeSmallBodyRatio : range;
   return (body <= smallMax * 1.35 || body >= range * 0.35);
}

bool SMC_HasM1LevelRejection(const int dirSign, const double level, const double atr)
{
   if(dirSign == 0 || level <= 0.0 || atr <= 0.0) return false;

   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 2, r) < 2) return false;

   double tol = MathMax(SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 2.0, atr * 0.08); // RÃ‰DUIT de 12% Ã  8% ATR pour plus de prÃ©cision
   double body = MathAbs(r[1].close - r[1].open);
   bool bullishReject = (r[1].low <= level + tol &&
                         r[1].close > level &&
                         r[1].close > r[1].open);
   bool bearishReject = (r[1].high >= level - tol &&
                         r[1].close < level &&
                         r[1].close < r[1].open);
   bool rejected = (dirSign > 0) ? bullishReject : bearishReject;
   if(!rejected) return false;

   double closeDistance = MathAbs(r[1].close - level);
   if(closeDistance > atr * 0.75)
   {
      Print("â›” EntrÃ©e retardÃ©e â€” clÃ´ture M1 Ã  ", DoubleToString(closeDistance / atr, 2),
            " ATR du niveau ", DoubleToString(level, _Digits), " | attente d'un nouveau retest");
      return false;
   }
   if(body > atr * 1.0)
   {
      Print("â›” EntrÃ©e retardÃ©e â€” bougie de rejet M1 trop Ã©tendue (",
            DoubleToString(body / atr, 2), " ATR) | ", _Symbol);
      return false;
   }
   return true;
}

int SMC_CountRecentSmallM1Bars(const int maxLookback, const double atr, const double bodyRatio)
{
   if(maxLookback <= 0 || atr <= 0.0) return 0;
   MqlRates r[];
   ArraySetAsSeries(r, true);
   int need = maxLookback + 1;
   if(CopyRates(_Symbol, PERIOD_M1, 0, need, r) < need) return 0;
   int count = 0;
   double smallMax = atr * MathMax(0.25, bodyRatio);
   for(int b = 1; b <= maxLookback && b < ArraySize(r); b++)
   {
      double body = MathAbs(r[b].close - r[b].open);
      if(body <= smallMax) count++;
      else break;
   }
   return count;
}

bool SMC_IsImmediateEntryComment(const string cmt)
{
   return (StringFind(cmt, "GOM_IMM") >= 0 ||
           StringFind(cmt, "GOM_TF_TL_M1") >= 0 ||
           StringFind(cmt, "GP_IMM") >= 0);
}

bool SMC_ReactionEntryBlocked(const string symbol, const string direction)
{
   int n = SMC_GetReactionTracker(symbol);
   if(n < 0) return false;
   if(!g_reactionTrackers[n].stayAway) return false;
   if(g_reactionTrackers[n].m5Reacted ||
      (g_reactionTrackers[n].rearmUntil > 0 && TimeCurrent() <= g_reactionTrackers[n].rearmUntil))
      return false;
   Print("ðŸš« RÃ‰ACTION TRACKER â€” nouvelle entrÃ©e bloquÃ©e sur ", symbol,
         " : M1/FVG/DOW traversÃ©s sans spike, attente rÃ©action M5");
   return true;
}

void SMC_TryGOM_TF_TL_M1_MarketEntry(const int dirSign, const double m1Level, const double atr);
void SMC_TryPatientSimpleEntry();
void SMC_TryM5RecoverySpikeEntry();
void SMC_TryDowEpRectMarketEntry();
void SMC_TryAggressiveDowGomEntry();
void SMC_TryChartistCounterTrendEntry();
void SMC_TryChartistOrderEntry();
void SMC_ProtectCapturedSpikeSL();
bool SMC_SpikeBlink_TripleTFAligned(const int dirSign);
bool CanPlacePatientSimpleOrderByGOM(const string symbol, const int dirSign);
bool CanPlaceDowLimitByGOM(const string symbol, const int dirSign);
bool SMCPS_HasPatternForDirection(const int dirSign); // dÃ©finie dans SMC_PatternSignals.mqh (inclus plus bas)

//+------------------------------------------------------------------+
//| GATE UNIFIÃ‰ D'ENTRÃ‰E â€” entrÃ©es prioritaires (DOW / GOM_TF_TL /    |
//| patterns / FVG).                                                  |
//| WAIT (vn=0) : BLOQUE TOUJOURS â€” mÃªme si srv:PERFECT.              |
//| GOOD/PERFECT (|vn|>=2) + direction alignÃ©e : seul cas autorisÃ©.  |
//| SIMPLE (|vn|=1) : refusÃ© ici (les entrÃ©es privilÃ©giÃ©es n'ouvrent  |
//| que sur GOOD/PERFECT). Patient SIMPLE a son propre chemin.        |
//| EXCEPTION: symboles synthÃ©tiques autonomes (FXVOL, FLIPX, PLUSX,  |
//| Boom/Crash, PainX/GainX) â€” autorisÃ©s dÃ¨s SIMPLE (|vn|>=1) alignÃ©. |
//+------------------------------------------------------------------+
bool SMC_EntryVerdictOK(const string symbol, const int dirSign)
{
   if(dirSign == 0) return false;
   if(!g_smcGomConnected) return false;
   int vn = (symbol == _Symbol) ? g_smcGomVerdictNum : SMCGP_GetCachedVerdictNum(symbol);
   // WAIT strict â€” jamais de bypass via srv PERFECT / pattern / spike
   if(vn == -999 || vn == 0) return false;
   if((dirSign > 0 && vn < 0) || (dirSign < 0 && vn > 0)) return false;
   
   // Symboles synthÃ©tiques autonomes (Weltrade FXVOL/FLIPX/PLUSX, Boom/Crash, PainX/GainX) :
   // acceptent le verdict SIMPLE (|vn|>=1) au lieu d'exiger GOOD/PERFECT (|vn|>=2)
   if(SMC_IsSyntheticAutonomousSym(symbol))
   {
      return (MathAbs(vn) >= 1);
   }
   
   return SMCGP_IsGoodPerfect(vn);
}

void SMC_TrackReactionLevelsOnTick()
{
   int n = SMC_GetReactionTracker(_Symbol);
   if(n < 0) return;
   // Les rÃ©actions de niveaux ne sont tradables qu'avec un GOM GOOD/PERFECT
   // live et M1/M5/M15 alignÃ©s dans le mÃªme sens.
   if(!g_smcGomConnected || !g_smcGomEntryAllowed ||
      !SMCGP_IsGoodPerfect(g_smcGomVerdictNum))
   {
      g_reactionTrackers[n].immTouchPending = false;
      g_reactionTrackers[n].immTouchBar = 0;
      g_reactionTrackers[n].immTouchLevel = 0.0;
      return;
   }
   int dirSign = (g_smcGomVerdictNum > 0) ? 1 : -1;
   if(!SMC_SpikeBlink_TripleTFAligned(dirSign))
   {
      double currentBid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      double currentAsk = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      if(currentBid > 0.0 && currentAsk > 0.0)
         g_reactionTrackers[n].lastPrice = (currentBid + currentAsk) * 0.5;
      g_reactionTrackers[n].immTouchPending = false;
      g_reactionTrackers[n].immTouchBar = 0;
      g_reactionTrackers[n].immTouchLevel = 0.0;
      return;
   }
   if(g_reactionTrackers[n].dirSign != 0 &&
      g_reactionTrackers[n].dirSign != dirSign)
   {
      g_reactionTrackers[n].m1Touched = false;
      g_reactionTrackers[n].fvgBrokenNoSpike = false;
      g_reactionTrackers[n].dowRetouched = false;
      g_reactionTrackers[n].m5Reacted = false;
      g_reactionTrackers[n].spikeSeen = false;
      g_reactionTrackers[n].stayAway = false;
      g_reactionTrackers[n].correctionExit = false;
      g_reactionTrackers[n].immTouchPending = false;
      g_reactionTrackers[n].immTouchBar = 0;
      g_reactionTrackers[n].immTouchLevel = 0.0;
      g_reactionTrackers[n].rearmUntil = 0;
   }

   double atr = 0.0;
   double ab[];
   ArraySetAsSeries(ab, true);
   if(atrHandle != INVALID_HANDLE && CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1)
      atr = ab[0];
   if(atr <= 0.0) atr = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 50.0;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if(bid <= 0.0 || ask <= 0.0) return;
   double px = (bid + ask) * 0.5;
   double tol = atr * ReactionTouchATRMult;
   double previous = g_reactionTrackers[n].lastPrice;
   g_reactionTrackers[n].dirSign = dirSign;

   double m1 = 0.0, fvg = 0.0, m5 = 0.0, dowTrend = 0.0, dowEP = 0.0;
   bool hasM1 = SMC_FindReactionObjectLevel(_Symbol, "GOM_TF_TL_M1", m1);
   string fvgToken = (dirSign > 0) ? "SMC_DISP_FVG_TRAIL_Bull" : "SMC_DISP_FVG_TRAIL_Bear";
   bool hasFVG = SMC_FindReactionObjectLevel(_Symbol, fvgToken, fvg);
   bool hasM5 = SMC_FindReactionObjectLevel(_Symbol, "GOM_TF_TL_M5", m5);
   bool dowDirectionMatches = g_dowState.active &&
                              (g_dowState.isBearish == (dirSign < 0));
   bool hasDowTrend = dowDirectionMatches &&
                      SMC_FindReactionObjectLevel(_Symbol, "DOW_TL_line", dowTrend);
   if(!hasDowTrend && dowDirectionMatches)
      hasDowTrend = SMC_FindReactionObjectLevel(_Symbol, "DOW_TL_hline", dowTrend);
   string epToken = (dirSign > 0) ? "DOW_BULL_EP" : "DOW_BEAR_EP";
   bool hasDowEP = SMC_FindReactionObjectLevel(_Symbol, epToken, dowEP);

   bool fvgTouch = hasFVG && (MathAbs(px - fvg) <= tol || SMC_ReactionCrossed(previous, px, fvg));
   bool m1Touch = hasM1 && (MathAbs(px - m1) <= tol || SMC_ReactionCrossed(previous, px, m1));
   bool dowTrendTouch = hasDowTrend &&
      (MathAbs(px - dowTrend) <= tol || SMC_ReactionCrossed(previous, px, dowTrend));
   bool dowEPTouch = hasDowEP &&
      (MathAbs(px - dowEP) <= tol || SMC_ReactionCrossed(previous, px, dowEP));
   bool dowTouch = dowTrendTouch || dowEPTouch;

   if(m1Touch)
   {
      g_reactionTrackers[n].m1Touched = true;
      g_reactionTrackers[n].lastM1Touch = TimeCurrent();
      Print("ðŸ“ REACTION M1 TOUCH â€” ", _Symbol, " niveau=", DoubleToString(m1, _Digits),
            " | vn=", g_smcGomVerdictNum);
   }

   bool anyReactionTouch = fvgTouch || m1Touch || dowTrendTouch || dowEPTouch;
   if(anyReactionTouch && SMC_EntryVerdictOK(_Symbol, dirSign) &&
      CountPositionsForSymbol(_Symbol) == 0)
   {
      double touchedLevel = m1Touch ? m1 : (fvgTouch ? fvg :
                            (dowTrendTouch ? dowTrend : dowEP));
      if(!g_reactionTrackers[n].immTouchPending)
      {
         g_reactionTrackers[n].immTouchPending = true;
         g_reactionTrackers[n].immTouchBar = iTime(_Symbol, PERIOD_M1, 0);
         g_reactionTrackers[n].immTouchLevel = touchedLevel;
         string source = m1Touch ? "GOM_TF_TL_M1" : (fvgTouch ? "FVG_TRAIL" :
                         (dowTrendTouch ? "DOW_TL" : "DOW_EP"));
         Print("â³ ", source, " touch â€” attente clÃ´ture M1 de confirmation sur ",
               _Symbol, " | niveau=", DoubleToString(touchedLevel, _Digits));
      }
   }

   if(g_reactionTrackers[n].immTouchPending &&
      CountPositionsForSymbol(_Symbol) > 0)
   {
      g_reactionTrackers[n].immTouchPending = false;
      g_reactionTrackers[n].immTouchBar = 0;
      g_reactionTrackers[n].immTouchLevel = 0.0;
   }
   if(g_reactionTrackers[n].immTouchPending &&
      iTime(_Symbol, PERIOD_M1, 0) > g_reactionTrackers[n].immTouchBar)
   {
      double confirmedLevel = g_reactionTrackers[n].immTouchLevel;
      g_reactionTrackers[n].immTouchPending = false;
      g_reactionTrackers[n].immTouchBar = 0;
      g_reactionTrackers[n].immTouchLevel = 0.0;
      if(SMC_HasM1LevelRejection(dirSign, confirmedLevel, atr) &&
         SMC_EntryVerdictOK(_Symbol, dirSign) &&
         SMC_SpikeBlink_TripleTFAligned(dirSign) &&
         CountPositionsForSymbol(_Symbol) == 0)
      {
         SMC_TryGOM_TF_TL_M1_MarketEntry(dirSign, confirmedLevel, atr);
      }
   }

   bool spikeNow = SMC_ReactionSpikeNow(dirSign, atr);
   if(spikeNow)
   {
      g_reactionTrackers[n].spikeSeen = true;
      g_reactionTrackers[n].fvgBrokenNoSpike = false;
      g_reactionTrackers[n].dowRetouched = false;
      g_reactionTrackers[n].stayAway = false;
      g_reactionTrackers[n].rearmUntil = 0;
      Print("âš¡ REACTION TRACKER â€” spike confirmÃ© aprÃ¨s niveau sur ", _Symbol);
   }

   bool fvgBroken = hasFVG && ((dirSign > 0 && px < fvg - tol) ||
                               (dirSign < 0 && px > fvg + tol));
   if(fvgBroken && !spikeNow)
   {
      if(!g_reactionTrackers[n].fvgBrokenNoSpike)
         Print("â›” FVG TRAIL cassÃ©e sans spike â€” surveillance perte -$",
               DoubleToString(ReactionBreakLossUSD, 2), " sur ", _Symbol);
      g_reactionTrackers[n].fvgBrokenNoSpike = true;
      g_reactionTrackers[n].lastFVGBreak = TimeCurrent();

      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         if(!posInfo.SelectByIndex(i)) continue;
         if(posInfo.Symbol() != _Symbol || posInfo.Magic() != InpMagicNumber) continue;
         double p = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
         if(p > -ReactionBreakLossUSD) continue;
         ulong ticket = posInfo.Ticket();
         Print("ðŸ›‘ FVG cassÃ©e sans spike â€” fermeture position ", ticket,
               " P/L=", DoubleToString(p, 2), "$ sur ", _Symbol);
         if(!PositionCloseWithLog(ticket, "FVG cassÃ©e sans spike"))
            Print("âš ï¸ Ã‰chec fermeture FVG cassÃ©e â€” ticket=", ticket,
                  " err=", GetLastError());
      }
   }

   if(dowTouch)
   {
      g_reactionTrackers[n].lastDOWTouch = TimeCurrent();
   }
   if(dowTouch && g_reactionTrackers[n].fvgBrokenNoSpike && !spikeNow)
   {
      g_reactionTrackers[n].dowRetouched = true;
      g_reactionTrackers[n].lastDOWTouch = TimeCurrent();
      g_reactionTrackers[n].rearmUntil = 0;
      g_reactionTrackers[n].stayAway = true;
      g_reactionTrackers[n].m5Reacted = false;
      Print("ðŸš« DOW trendline/EP retouch aprÃ¨s cassure FVG sans spike â€” verrou tracker actif sur ", _Symbol,
            " jusqu'Ã  rÃ©action M5");
   }

   bool m5React = false;
   if(hasM5 && MathAbs(px - m5) <= tol * 1.75)
   {
      MqlRates mr[];
      ArraySetAsSeries(mr, true);
      if(CopyRates(_Symbol, PERIOD_M5, 0, 2, mr) >= 2)
      {
         bool reject = (dirSign > 0 && mr[0].low <= m5 + tol && mr[0].close > m5 && mr[0].close > mr[0].open) ||
                       (dirSign < 0 && mr[0].high >= m5 - tol && mr[0].close < m5 && mr[0].close < mr[0].open);
         m5React = reject || spikeNow;
      }
   }
   if(m5React)
   {
      g_reactionTrackers[n].m5Reacted = true;
      g_reactionTrackers[n].stayAway = false;
      g_reactionTrackers[n].m1Touched = false;
      g_reactionTrackers[n].fvgBrokenNoSpike = false;
      g_reactionTrackers[n].dowRetouched = false;
      g_reactionTrackers[n].spikeSeen = false;
      g_reactionTrackers[n].rearmUntil = TimeCurrent() + ReactionM5RearmWindowSec;
      Print("âœ… GOM_TF_TL_M5 rÃ©agi â€” fin probable de correction, nouvelle chaÃ®ne autorisÃ©e sur ", _Symbol);
      if(g_reactionTrackers[n].correctionExit && spikeNow && SMCGP_IsGoodPerfect(g_smcGomVerdictNum))
         SMC_TryM5RecoverySpikeEntry();
   }

   // M1 puis FVG puis DOW sans spike = correction longue : on s'Ã©carte.
   if(g_reactionTrackers[n].m1Touched && g_reactionTrackers[n].fvgBrokenNoSpike && g_reactionTrackers[n].dowRetouched && !spikeNow && !m5React)
   {
      g_reactionTrackers[n].stayAway = true;
      g_reactionTrackers[n].m5Reacted = false;
      g_reactionTrackers[n].rearmUntil = 0;
      Print("ðŸš« FORTE CORRECTION â€” M1/FVG/DOW traversÃ©s sans spike sur ", _Symbol,
            " ; aucune nouvelle entrÃ©e avant rÃ©action M5");
   }
   g_reactionTrackers[n].lastPrice = px;
}

// Confirme une vraie chaine : compression forte, puis trois spikes
// de meme sens avec des espacements M1 reguliers.
bool SMC_IsStrongCompressionSpikeChain(const int dirSign)
{
   if(dirSign == 0) return false;
   if(!FirstSpikeGuardRequireChain) return true;

   // Si le tracker de reaction signale une longue correction en cours sur ce
   // symbole (M1 touchÃ©, FVG cassÃ©e sans spike, DOW retouchÃ©, et TOUJOURS pas
   // de rÃ©action M5), on refuse la chaÃ®ne quoi qu'il arrive : l'EA doit rester
   // Ã  l'Ã©cart, pas lui accorder une "patience" supplÃ©mentaire.
   int rtIdx = SMC_GetReactionTracker(_Symbol);
   if(rtIdx >= 0 && g_reactionTrackers[rtIdx].stayAway && !g_reactionTrackers[rtIdx].m5Reacted)
   {
      Print("ðŸš« CHAÃŽNE REFUSÃ‰E : longue correction en cours sur ", _Symbol,
            " (M5 pas encore rÃ©agi) â€” pas de patience giveback accordÃ©e");
      return false;
   }

   // Confluence multi-niveaux exigÃ©e en plus de la gÃ©omÃ©trie des 3 spikes :
   // GOM_TF_TL_M1 touchÃ© ET rÃ©agi (spike/verdict GOOD-PERFECT), DOW touchÃ© ET
   // rÃ©agi, DISP_FVG_TRAIL rÃ©agi. Sans au moins une rÃ©action confirmÃ©e par le
   // tracker, la compression peut Ãªtre forte sans qu'on soit "sÃ»r" de la chaÃ®ne.
   if(RequireReactionConfluenceForChain && rtIdx >= 0)
   {
      bool hasConfirmedReaction = g_reactionTrackers[rtIdx].spikeSeen || g_reactionTrackers[rtIdx].m5Reacted;
      if(!hasConfirmedReaction && g_reactionTrackers[rtIdx].m1Touched)
      {
         Print("â„¹ï¸ CHAÃŽNE NON QUALIFIÃ‰E : niveau touchÃ© sur ", _Symbol,
               " mais aucune rÃ©action confirmÃ©e (spike/M5) â€” gÃ©omÃ©trie seule insuffisante");
         return false;
      }
   }

   // La compression pertinente est celle qui prÃ©cÃ¨de le premier spike,
   // pas forcÃ©ment l'ATR actuel aprÃ¨s l'impulsion.
   double currentCompression = CalculateVolatilityCompression();

   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 45, r) < 40) return false;

   double atr[];
   ArraySetAsSeries(atr, true);
   int atrCopied = 0;
   if(atrHandle != INVALID_HANDLE)
      atrCopied = CopyBuffer(atrHandle, 0, 1, 40, atr);

   // 45 bougies sont chargÃ©es : a+20 doit rester dans le tableau.
   for(int a = 24; a >= 11; a--)
   {
      for(int d1 = FirstSpikeGuardMinIntervalBars; d1 <= FirstSpikeGuardMaxIntervalBars; d1++)
      {
         int b = a - d1;
         if(b < 6) continue;
         for(int d2 = FirstSpikeGuardMinIntervalBars; d2 <= FirstSpikeGuardMaxIntervalBars; d2++)
         {
            int c = b - d2;
            if(c < 1) continue;
            double aAtr = (atrCopied >= a) ? atr[a-1] : 0.0;
            double bAtr = (atrCopied >= b) ? atr[b-1] : aAtr;
            double cAtr = (atrCopied >= c) ? atr[c-1] : bAtr;
            if(aAtr <= 0.0) aAtr = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 50.0;
            if(bAtr <= 0.0) bAtr = aAtr;
            if(cAtr <= 0.0) cAtr = bAtr;
            double preShortHigh = r[a+1].high, preShortLow = r[a+1].low;
            double preLongHigh  = r[a+1].high, preLongLow  = r[a+1].low;
            for(int q = a+1; q <= a+5; q++)
            {
               preShortHigh = MathMax(preShortHigh, r[q].high);
               preShortLow  = MathMin(preShortLow, r[q].low);
            }
            for(int q = a+1; q <= a+20; q++)
            {
               preLongHigh = MathMax(preLongHigh, r[q].high);
               preLongLow  = MathMin(preLongLow, r[q].low);
            }
            double preCompression = (preLongHigh > preLongLow) ?
                                    (preShortHigh-preShortLow)/(preLongHigh-preLongLow) : 1.0;
            if(preCompression > FirstSpikeGuardMaxCompression) continue;

            bool aDir = (dirSign > 0) ? (r[a].close > r[a].open) : (r[a].close < r[a].open);
            bool bDir = (dirSign > 0) ? (r[b].close > r[b].open) : (r[b].close < r[b].open);
            bool cDir = (dirSign > 0) ? (r[c].close > r[c].open) : (r[c].close < r[c].open);
            bool aSpike = aDir && (r[a].high-r[a].low >= aAtr * SpikeChainBodyATRMult);
            bool bSpike = bDir && (r[b].high-r[b].low >= bAtr * SpikeChainBodyATRMult);
            bool cSpike = cDir && (r[c].high-r[c].low >= cAtr * SpikeChainBodyATRMult);
            double avgGap = (d1 + d2) / 2.0;
            if(aSpike && bSpike && cSpike && avgGap >= FirstSpikeGuardAvgIntervalMin && avgGap <= FirstSpikeGuardAvgIntervalMax)
            {
               Print("âœ… CHAÃŽNE SPIKE CONFIRMÃ‰E : gaps=", d1, "/", d2,
                     " bougies, compression avant chaÃ®ne=", DoubleToString(preCompression, 3),
                     " | ATR actuel=", DoubleToString(currentCompression, 3));
               return true;
            }
         }
      }
   }
   return false;
}

//+------------------------------------------------------------------+
//| 2e SPIKE : aprÃ¨s 1Ã¨re capture (DOW react / spike), rester armÃ©   |

//| pour prendre la vague suivante au lieu de rester Ã  plat.         |
//+------------------------------------------------------------------+
void SMC_ArmSecondSpikeWindow(const int dirSign, const string reason)
{
   if(!UseSecondSpikeCapture) return;
   if(dirSign == 0) return;

   g_firstSpikeChainQualified = SMC_IsStrongCompressionSpikeChain(dirSign);
   g_secondSpikeArmed      = true;
   g_secondSpikeArmedSince = TimeCurrent();
   g_secondSpikeDirSign    = dirSign;
   g_secondSpikeReason     = reason;
   g_firstSpikeTicket      = 0;
   g_firstSpikePeakProfit  = 0.0;
   g_firstSpikeLastBarTime = iTime(_Symbol, PERIOD_M1, 0);

   Print("âš¡ 2e SPIKE WINDOW | dir=", (dirSign > 0 ? "BUY" : "SELL"),
         " | ", reason, " | pause ", SecondSpikePauseMinBars, "-",
         SecondSpikePauseMaxBars, " petites M1 | fenÃªtre ", SecondSpikeWindowSec, "s");
}

void SMC_CloseAfterSpikeCapture(const string reason)
{
   int closed = 0;
   ulong ticket = g_firstSpikeTicket;
   bool positionFound = (ticket > 0 && PositionSelectByTicket(ticket) &&
                         PositionGetString(POSITION_SYMBOL) == _Symbol &&
                         PositionGetInteger(POSITION_MAGIC) == InpMagicNumber);
   if(positionFound)
   {
      double profit = PositionGetDouble(POSITION_PROFIT) +
                      PositionGetDouble(POSITION_SWAP);
      Print("ðŸŽ¯ SPIKE CAPTURÃ‰ â€” clÃ´ture position avant nouvelle entrÃ©e | ticket=", ticket,
            " | P/L=", DoubleToString(profit, 2), "$ | ", reason);
      if(PositionCloseWithLogSpikeCapture(ticket, "Spike close - " + reason, true))
         closed++;
      else
      {
         int err = GetLastError();
         Print("âš ï¸ Ã‰chec clÃ´ture post-capture â€” ticket=", ticket,
               " | err=", err, " | Ã©tat conservÃ© pour nouvelle tentative");
         return;
      }
   }
   else if(ticket > 0)
   {
      // Le ticket n'existe plus (SL/TP/manuel/autre gestionnaire) : on peut
      // rÃ©initialiser l'Ã©tat sans risquer de laisser une position ouverte.
      Print("â„¹ï¸ SPIKE CAPTURÃ‰ â€” ticket dÃ©jÃ  absent, rÃ©initialisation de l'Ã©tat");
   }

   g_secondSpikeArmed = false;
   g_secondSpikeDirSign = 0;
   g_secondSpikeLastEntry = 0;
   g_firstSpikeChainQualified = false;
   g_firstSpikeTicket = 0;
   g_firstSpikePeakProfit = 0.0;
   g_firstSpikeLastBarTime = 0;
   g_maxProfit = 0.0;

   int rn = SMC_GetReactionTracker(_Symbol);
   if(rn >= 0)
   {
      g_reactionTrackers[rn].m1Touched = false;
      g_reactionTrackers[rn].fvgBrokenNoSpike = false;
      g_reactionTrackers[rn].dowRetouched = false;
      g_reactionTrackers[rn].m5Reacted = false;
      g_reactionTrackers[rn].spikeSeen = true;
      g_reactionTrackers[rn].stayAway = false;
      g_reactionTrackers[rn].rearmUntil = 0;
   }
   Print("âœ… SPIKE CAPTURÃ‰ â€” ", closed,
         " position(s) clÃ´turÃ©e(s), EA Ã  plat et en attente dâ€™une nouvelle entrÃ©e");
}

//+------------------------------------------------------------------+
//| v1.46 FIX: fenetre de re-entree CHAINE DE SPIKES.                |
//| Vrai = un spike vient d'etre capture/ferme, la fenetre est active|
//| et verdict GOOD/PERFECT + M1/M5/M15 alignes dans le sens chaine. |
//| Pendant cette fenetre : pas de trade de correction (unifie en    |
//| attente) et pas de GAIN COOLDOWN pour la re-entree chaine.       |
//+------------------------------------------------------------------+
bool SMC_SpikeChainReentryWindow(const int dirSign = 0)
{
   if(!UseSecondSpikeCapture || !g_secondSpikeArmed) return false;
   if(g_secondSpikeDirSign == 0) return false;
   if(StringFind(g_secondSpikeReason, "spike capture close") < 0 &&
      StringFind(g_secondSpikeReason, "M5 recovery") < 0) return false;
   if(g_secondSpikeArmedSince > 0 &&
      (TimeCurrent() - g_secondSpikeArmedSince) > SecondSpikeWindowSec) return false;
   if(dirSign != 0 && dirSign != g_secondSpikeDirSign) return false;
   if(!g_smcGomConnected || !SMCGP_IsGoodPerfect(g_smcGomVerdictNum)) return false;
   if((g_secondSpikeDirSign > 0 && g_smcGomVerdictNum < 0) ||
      (g_secondSpikeDirSign < 0 && g_smcGomVerdictNum > 0)) return false;
   return SMC_SpikeBlink_TripleTFAligned(g_secondSpikeDirSign);
}

void SMC_TrySecondSpikeCapture()
{
   if(!UseSecondSpikeCapture || !g_secondSpikeArmed) return;
   if(BlockAllTrades) return;

   if(g_secondSpikeArmedSince > 0 &&
      (TimeCurrent() - g_secondSpikeArmedSince) > SecondSpikeWindowSec)
   {
      Print("âŒ› 2e SPIKE WINDOW expirÃ©e (", SecondSpikeWindowSec, "s)");
      g_secondSpikeArmed = false;
      g_secondSpikeDirSign = 0;
      g_firstSpikeChainQualified = false;
      return;
   }

   int dirSign = g_secondSpikeDirSign;
   if(dirSign == 0) return;

   string direction = (dirSign > 0) ? "BUY" : "SELL";
   if(!IsDirectionAllowedForBoomCrash(_Symbol, direction)) return;

   if(!g_smcGomConnected || !g_smcGomEntryAllowed ||
      !SMCGP_IsGoodPerfect(g_smcGomVerdictNum) ||
      (dirSign > 0 && g_smcGomVerdictNum < 0) ||
      (dirSign < 0 && g_smcGomVerdictNum > 0) ||
      !SMC_SpikeBlink_TripleTFAligned(dirSign))
   {
      Print("ðŸ”’ 2e SPIKE annulÃ© â€” verdict GOOD/PERFECT ou alignement M1/M5/M15 perdu");
      g_secondSpikeArmed = false;
      g_secondSpikeDirSign = 0;
      g_firstSpikeChainQualified = false;
      return;
   }

   if(g_secondSpikeLastEntry > 0 &&
      (TimeCurrent() - g_secondSpikeLastEntry) < SecondSpikeMinGapSec)
      return;

   int openSame = CountPositionsForSymbol(_Symbol);
   if(openSame > 0 && !SecondSpikeAllowScaleIn)
      return;
   if(openSame >= MathMax(1, MaxPositionsTerminal))
      return;

   double atrVal = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[];
      ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atrVal = ab[0];
   }
   if(atrVal <= 0) atrVal = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 50.0;

   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 12, r) < 5) return;

   datetime since = g_secondSpikeArmedSince;
   double smallThr = atrVal * MathMax(0.25, SpikeCloseSmallBodyATR);
   double imminentThr = atrVal * MathMax(0.40, SecondSpikeMinBodyATR);
   double chaseThr = atrVal * 1.85;

   int smallBars = 0;
   bool pauseBroken = false;
   for(int i = 1; i < ArraySize(r); i++)
   {
      if(r[i].time <= since) break;
      double bd = MathAbs(r[i].close - r[i].open);
      if(bd < smallThr)
         smallBars++;
      else
      {
         pauseBroken = true;
         break;
      }
   }

   int needPause = MathMax(3, SecondSpikePauseMinBars);
   int maxPause  = MathMax(needPause, SecondSpikePauseMaxBars);
   if(smallBars < needPause) return;
   if(smallBars > maxPause && !pauseBroken) return;

   double body0 = MathAbs(r[0].close - r[0].open);
   double rng0  = r[0].high - r[0].low;
   double body1 = MathAbs(r[1].close - r[1].open);
   bool dir0 = (dirSign > 0 && r[0].close > r[0].open) ||
               (dirSign < 0 && r[0].close < r[0].open);
   bool dir1 = (dirSign > 0 && r[1].close > r[1].open) ||
               (dirSign < 0 && r[1].close < r[1].open);

   bool liveStart = dir0 && body0 >= imminentThr && body0 < chaseThr;
   bool closedStart = dir1 && r[1].time > since && body1 >= imminentThr && body1 < chaseThr;
   bool chainOk = false;
   string chainDir = "";
   if(UseSpikeChainDetector && UseSpikeChainEarlyEntry)
   {
      if(SMC_IsSpikeChainEarlyEntry(chainDir))
      {
         string cd = chainDir; StringToUpper(cd);
         chainOk = (dirSign > 0 && cd == "BUY") || (dirSign < 0 && cd == "SELL");
      }
   }
   bool imminent = liveStart || closedStart || chainOk;
   if(!imminent) return;
   if(body0 >= chaseThr && dir0)
   {
      Print("[2e SPIKE] skip chase: barre live dÃ©jÃ  trop Ã©tendue");
      return;
   }

   double prob = CalculateSpikeProbability();
   double body = body0;

   g_secondSpikeInFlight = true;
   bool savedLead = g_dowPriceLeadInFlight;
   g_dowPriceLeadInFlight = true;

   if(!CanTradeOnSymbol(_Symbol, direction) || !CanPlaceMarketOrder(_Symbol, dirSign))
   {
      g_dowPriceLeadInFlight = savedLead;
      g_secondSpikeInFlight = false;
      return;
   }

   if(!TryAcquireOpenLock())
   {
      g_dowPriceLeadInFlight = savedLead;
      g_secondSpikeInFlight = false;
      return;
   }
   double lot = CalculateLotSize();
   if(lot <= 0)
   {
      ReleaseOpenLock();
      g_dowPriceLeadInFlight = savedLead;
      g_secondSpikeInFlight = false;
      return;
   }

   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double slDist = atrVal * MathMax(1.2, SL_ATRMult * 0.7);
   double tpDist = slDist * (UseSniperScalperMode ? MathMax(2.0, MinRewardRiskRatio * 0.8) : 2.0);
   if(UseSniperScalperMode)
   {
      double tpAdj = tpDist;
      if(!SMC_ApplySniperRiskCap(_Symbol, slDist, lot, tpAdj))
      {
         ReleaseOpenLock();
         g_dowPriceLeadInFlight = savedLead;
         g_secondSpikeInFlight = false;
         return;
      }
      tpDist = tpAdj;
   }

   bool ok = false;
   string cmt = "2nd SPIKE " + direction;
   if(dirSign > 0)
   {
      double sl = NormalizeDouble(ask - slDist, dg);
      double tp = NormalizeDouble(ask + tpDist, dg);
      if(SMC_FinalOpenGate(_Symbol, ORDER_TYPE_BUY))
      {
         ok = SafeTradeBuy(lot, _Symbol, ask, sl, tp, cmt);
         if(ok) SMC_GateRegisterOpened(_Symbol, true);
      }
   }
   else
   {
      double sl = NormalizeDouble(bid + slDist, dg);
      double tp = NormalizeDouble(bid - tpDist, dg);
      if(SMC_FinalOpenGate(_Symbol, ORDER_TYPE_SELL))
      {
         ok = SafeTradeSell(lot, _Symbol, bid, sl, tp, cmt);
         if(ok) SMC_GateRegisterOpened(_Symbol, false);
      }
   }

   g_dowPriceLeadInFlight = savedLead;
   g_secondSpikeInFlight = false;

   if(ok)
   {
      RegisterOrderPlaced();
      g_secondSpikeLastEntry = TimeCurrent();
      ulong ticket = trade.ResultOrder();
      if(ticket > 0) SMC_ApplyPostEntrySLBuffer(_Symbol, ticket, 1.0);
      Print("ðŸš€ 2nd SPIKE ", direction, " ", _Symbol,
            " aprÃ¨s ", smallBars, " petites M1 | bodyATR=",
            DoubleToString(body / atrVal, 2),
            " | prob=", DoubleToString(prob, 2),
            " | GOM vn=", g_smcGomVerdictNum);
      if(UseNotifications)
         SendNotification("2nd SPIKE " + direction + " " + _Symbol);
      g_secondSpikeArmed = false;
      g_secondSpikeDirSign = 0;
      g_firstSpikeChainQualified = false;
      g_firstSpikeTicket = 0;
      g_firstSpikePeakProfit = 0.0;
   }
   ReleaseOpenLock();
}

//+------------------------------------------------------------------+
//| Garde anti-giveback : si le 2e spike attendu n'est toujours pas   |
//| arrivÃ© Ã  la clÃ´ture d'une bougie M1, fermer la position du 1er    |
//| spike plutÃ´t que de rendre plus de FirstSpikeGiveBackMaxPct % de  |
//| son gain (pic de profit atteint pendant l'attente).                |
//+------------------------------------------------------------------+
void SMC_ManageFirstSpikeGiveBackGuard()
{
      if(!UseFirstSpikeGiveBackGuard) return;
   if(!UseSecondSpikeCapture) return;
   if(!g_firstSpikeChainQualified) return;     // jamais pour une capture isolÃ©e
   if(!g_secondSpikeArmed) return;              // 2e spike dÃ©jÃ  captÃ© ou fenÃªtre dÃ©jÃ  refermÃ©e

   if(g_firstSpikeTicket == 0) return;

   if(!PositionSelectByTicket(g_firstSpikeTicket))
   {
            // Position dÃ©jÃ  fermÃ©e par ailleurs (SL/TP/manuel/autre garde) -> rien Ã  protÃ©ger
      g_firstSpikeChainQualified = false;
      g_firstSpikeTicket     = 0;

      g_firstSpikePeakProfit = 0.0;
      return;
   }

   double profit = PositionGetDouble(POSITION_PROFIT) +
                   PositionGetDouble(POSITION_SWAP);

   if(profit > g_firstSpikePeakProfit)
      g_firstSpikePeakProfit = profit;

   // FIX 2026-09-05 (Claude): l'ancienne version ne vÃ©rifiait le plancher
   // anti-giveback qu'Ã  la clÃ´ture de la bougie M1 ("On ne juge qu'Ã  la
   // clÃ´ture d'une bougie M1"). Or SMC_ManageGeneralGiveBackGuard() EXEMPTE
   // explicitement ce mÃªme ticket pendant toute la fenÃªtre d'attente du 2e
   // spike (exemptTicket = g_firstSpikeTicket), en s'appuyant justement sur
   // CETTE garde-ci pour le protÃ©ger. ConsÃ©quence rÃ©elle observÃ©e: un spike
   // captÃ© (ex: -1$ -> +3$ en quelques secondes) peut intÃ©gralement se
   // rendre, voire repasser en perte, PENDANT la bougie M1 en cours, sans
   // qu'aucune des deux gardes n'intervienne â€” exactement le symptÃ´me
   // "l'EA ne ferme pas au spike / ne sÃ©curise pas le profit".
   // Le plancher est maintenant vÃ©rifiÃ© Ã  CHAQUE tick, comme un vrai trailing
   // de profit. Le calcul par bougie M1 est conservÃ© uniquement pour les
   // logs/diagnostics, plus pour la dÃ©cision de fermeture.
   if(g_firstSpikePeakProfit >= FirstSpikeGiveBackMinPeakUSD)
   {
      double keepFloor = g_firstSpikePeakProfit * (1.0 - FirstSpikeGiveBackMaxPct / 100.0);

      if(profit <= keepFloor)
      {
         ulong ticket = g_firstSpikeTicket;
         Print("ðŸ›¡ï¸âš¡ GIVEBACK DÃ‰PASSÃ‰ (tick) â€” fermeture 1er spike ", _Symbol,
               " | ticket=", ticket,
               " | pic=", DoubleToString(g_firstSpikePeakProfit, 2), "$",
               " | profit actuel=", DoubleToString(profit, 2), "$",
               " | plancher(", DoubleToString(100.0 - FirstSpikeGiveBackMaxPct, 0), "% du pic)=",
               DoubleToString(keepFloor, 2), "$");

         if(PositionCloseWithLog(ticket, "1er spike - giveback > seuil (tick)"))
         {
            if(UseNotifications)
            {
               Alert("ðŸ›¡ï¸ 1er spike fermÃ© (giveback) - ", _Symbol);
               SendNotification("1er spike fermÃ© (giveback) - " + _Symbol);
            }
            g_secondSpikeArmed     = false;
            g_secondSpikeDirSign   = 0;
            g_firstSpikeTicket     = 0;
            g_firstSpikePeakProfit = 0.0;
         }
         else
         {
            int err = GetLastError();
            Print("âŒ Ã‰chec fermeture garde 1er spike - ticket=", ticket, " | code=", err);
         }
         return; // position traitÃ©e (fermÃ©e ou tentative faite) - rien d'autre Ã  faire ce tick
      }
   }

   // Suivi par bougie M1 conservÃ© pour compat/diagnostics uniquement
   // (n'est plus utilisÃ© pour dÃ©clencher une fermeture).
   datetime curBarTime = iTime(_Symbol, PERIOD_M1, 0);
   if(g_firstSpikeLastBarTime == 0 || curBarTime != g_firstSpikeLastBarTime)
      g_firstSpikeLastBarTime = curBarTime;
}

//+------------------------------------------------------------------+
//| Garde GENERALE anti-giveback : active par defaut, sur TOUTE       |
//| position en profit de ce EA (magic), sans condition de chaine.    |
//| Ferme immediatement (au marche) des qu'une position a rendu plus  |
//| de GeneralGiveBackMaxPct % de son pic de profit.                  |
//|                                                                    |
//| La SEULE position exemptee est le ticket "1er spike" pendant la   |
//| fenetre ou g_firstSpikeChainQualified ET g_secondSpikeArmed sont   |
//| vrais tous les deux : c'est le cas exceptionnel ou une vraie       |
//| chaine de compression forte (3 spikes, ~3-5 bougies d'ecart, avec  |
//| confluence GOM_TF_TL_M1/DOW/DISP_FVG/M5 - voir                     |
//| SMC_IsStrongCompressionSpikeChain) a ete confirmee, et ou l'on     |
//| tolere sciemment d'attendre le 2e spike jusqu'a la cloture de      |
//| bougie (cf. SMC_ManageFirstSpikeGiveBackGuard, meme seuil 30%).    |
//+------------------------------------------------------------------+
void SMC_ManageGeneralGiveBackGuard()
{
   if(!UseGeneralGiveBackGuard) return;

   // Ticket actuellement sous la garde SPECIFIQUE "chaine confirmee" -> exempte ici,
   // pour ne pas avoir deux gardes qui se contredisent sur le meme ticket.
   ulong exemptTicket = (g_firstSpikeChainQualified && g_secondSpikeArmed) ? g_firstSpikeTicket : 0;

   // Marque tous les slots comme "vus" ce passage pour purger les tickets fermes ensuite.
   bool seen[128];
   ArrayInitialize(seen, false);

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;

      ulong ticket = posInfo.Ticket();
      if(ticket == exemptTicket) continue; // laissee a la garde specifique chaine

      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();

      int slot = -1;
      for(int s = 0; s < g_giveBackCount; s++)
         if(g_giveBackTicket[s] == ticket) { slot = s; break; }
      if(slot < 0 && g_giveBackCount < 128)
      {
         slot = g_giveBackCount++;
         g_giveBackTicket[slot] = ticket;
         g_giveBackPeak[slot]   = 0.0;
      }
      if(slot < 0) continue; // table pleine, ignorer ce ticket ce passage
      seen[slot] = true;

      if(profit > g_giveBackPeak[slot])
         g_giveBackPeak[slot] = profit;

      double peak = g_giveBackPeak[slot];
      string gbSym = posInfo.Symbol();
      bool synthGB = (IsBoomLikeSymbol(gbSym) || IsCrashLikeSymbol(gbSym) || SMC_IsWeltradeBoomCrash(gbSym));
      double minPeak = synthGB ? MathMin(0.10, GeneralGiveBackMinPeakUSD) : GeneralGiveBackMinPeakUSD;
      if(peak < minPeak) continue;

      double maxPct = synthGB ? MathMin(15.0, GeneralGiveBackMaxPct) : GeneralGiveBackMaxPct;
      if(synthGB && peak >= minPeak && profit <= 0.0)
      {
         Print("ðŸ›¡ï¸ GARDE GENERALE â€” spike PainX/GainX rendu en perte ", gbSym,
               " | ticket=", ticket, " | pic=", DoubleToString(peak, 2), "$");
         PositionCloseWithLog(ticket, "Garde generale â€” spike rendu en perte");
         continue;
      }
      double keepFloor = peak * (1.0 - maxPct / 100.0);
      if(profit <= keepFloor)
      {
         Print("ðŸ›¡ï¸ GARDE GENERALE ", DoubleToString(maxPct, 0), "% â€” giveback depasse sur ", gbSym,
               " | ticket=", ticket,
               " | pic=", DoubleToString(peak, 2), "$",
               " | profit actuel=", DoubleToString(profit, 2), "$",
               " | plancher(", DoubleToString(100.0 - maxPct, 0), "% du pic)=",
               DoubleToString(keepFloor, 2), "$");

         if(PositionCloseWithLog(ticket, "Garde generale 30% - giveback depasse"))
         {
            if(UseNotifications)
            {
               Alert("ðŸ›¡ï¸ Position fermee (giveback >30% du pic) - ", posInfo.Symbol());
               SendNotification("Position fermee (giveback >30% du pic) - " + posInfo.Symbol());
            }
         }
         else
         {
            int err = GetLastError();
            Print("âŒ Ã‰chec fermeture garde generale - ticket=", ticket, " | code=", err);
         }
      }
   }

   // Purge des slots dont le ticket n'existe plus (position fermee ailleurs).
   for(int s = g_giveBackCount - 1; s >= 0; s--)
   {
      if(seen[s]) continue;
      if(g_giveBackTicket[s] == exemptTicket) continue; // toujours suivi ailleurs
      // Decale le dernier element dans ce slot puis reduit le compte.
      g_giveBackTicket[s] = g_giveBackTicket[g_giveBackCount - 1];
      g_giveBackPeak[s]   = g_giveBackPeak[g_giveBackCount - 1];
      g_giveBackCount--;
   }
}

//+------------------------------------------------------------------+
//| SMC_ManageStagnationTimeExit                                       |
//| Deux mecanismes independants, sur TOUTE position de ce EA (magic): |
//|                                                                    |
//| 1) STAGNATION : suit le pic de profit par ticket. Si aucun nouveau |
//|    pic n'est fait depuis StagnationMaxAgeMinutes ET que la         |
//|    position est ENCORE en gain -> fermeture immediate au marche.   |
//|    Objectif : sÃ©curiser un gain qui "fige"/oscille au lieu de      |
//|    laisser le trailing classique (ManageTrailingStop) attendre un  |
//|    mouvement de prix qui peut ne jamais venir, voire redonner le   |
//|    gain, voire finir en perte.                                     |
//|                                                                    |
//| 2) FILET DE SECURITE TEMPS (paliers degressifs) : si la position   |
//|    atteint un palier d'age TOTAL (TimeCutStage1/TimeCutMax/        |
//|    TimeCutStage3) sans jamais avoir declenche la regle stagnation  |
//|    (donc sans avoir ete franchement profitable), elle est fermee - |
//|    mais UNIQUEMENT si la perte actuelle est deja sous le plafond   |
//|    de CE palier (0.60$ / 1.20$ / 1.80$ par defaut). Plus le trade  |
//|    est vieux, plus le plafond tolere est haut - jusqu'a juste sous |
//|    MaxLossDollars, pour ne jamais dupliquer la coupure prix finale.|
//|    Objectif : eviter qu'un trade sans edge reste ouvert 10-20 min  |
//|    a osciller entre -1$ et -MaxLossDollars$ sans jamais declencher |
//|    ni le stop $ fixe, ni un changement de verdict GOM/IA.          |
//|                                                                    |
//| Idee generale (Sidoine, 2026-09-08) : une position ne doit jamais  |
//| etre gardee trop longtemps a esperer un mouvement qui finit par la |
//| faire terminer en grosse perte - le TEMPS devient un declencheur   |
//| de sortie a part entiere, en plus du prix.                        |
//+------------------------------------------------------------------+
void SMC_ManageStagnationTimeExit()
{
   if(!UseStagnationTimeExit) return;
   if(PositionsTotal() == 0) return;

   datetime now = TimeCurrent();
   bool seen[128];
   ArrayInitialize(seen, false);

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;

      ulong    ticket   = posInfo.Ticket();
      double   profit   = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      datetime openTime = (datetime)posInfo.Time();
      int      ageMin   = (int)((now - openTime) / 60);

      // Trouver/creer le slot de suivi pour ce ticket
      int slot = -1;
      for(int s = 0; s < g_stagCount; s++)
         if(g_stagTicket[s] == ticket) { slot = s; break; }
      if(slot < 0 && g_stagCount < 128)
      {
         slot = g_stagCount++;
         g_stagTicket[slot]     = ticket;
         g_stagPeakProfit[slot] = profit;
         g_stagPeakTime[slot]   = now;
      }
      if(slot < 0) continue; // table pleine ce passage
      seen[slot] = true;

      // Nouveau pic de profit -> on reinitialise l'horloge de stagnation
      if(profit > g_stagPeakProfit[slot])
      {
         g_stagPeakProfit[slot] = profit;
         g_stagPeakTime[slot]   = now;
      }

      // â”€â”€ DÃ‰TECTION WHIPSAW (oscillations gain/perte) â”€â”€
      // Met Ã  jour le tracker de whipsaw pour dÃ©tecter les oscillations rapides
      if(UseWhipsawFilter)
         UpdateWhipsawDetection(profit);

      // â”€â”€ 1) STAGNATION : gain fige/oscillant depuis N minutes, encore en gain â”€â”€
      int stagnantMin = (int)((now - g_stagPeakTime[slot]) / 60);
      if(g_stagPeakProfit[slot] >= StagnationMinPeakUSD &&
         stagnantMin >= StagnationMaxAgeMinutes &&
         profit > 0.0)
      {
         Print("â±ï¸ STAGNATION â€” gain fige depuis ", stagnantMin, " min sur ", posInfo.Symbol(),
               " | ticket=", ticket,
               " | pic=", DoubleToString(g_stagPeakProfit[slot], 2), "$",
               " | profit actuel=", DoubleToString(profit, 2), "$ -> securisation");

         if(PositionCloseWithLog(ticket, "Stagnation - gain fige, securisation par temps"))
         {
            if(UseNotifications)
            {
               Alert("â±ï¸ Position fermee (stagnation gain) - ", posInfo.Symbol());
               SendNotification("Position fermee (stagnation gain) - " + posInfo.Symbol());
            }
            continue; // ticket ferme, rien d'autre a faire pour lui ce tick
         }
         else
         {
            int err = GetLastError();
            Print("âŒ Ã‰chec fermeture garde stagnation - ticket=", ticket, " | code=", err);
         }
      }

      // â”€â”€ 2) FILET DE SECURITE TEMPS : jamais franchement profitable, age max atteint â”€â”€
      // Paliers degressifs : on regarde le palier le plus eleve (age le plus grand)
      // dont l'age est atteint, et on ferme si la perte actuelle est encore sous
      // son plafond. Une perte plus grande que le plafond du palier atteint est
      // laissee au SL / MaxLossDollars (on ne double pas la coupure prix).
      if(profit < 0.0)
      {
         int    tcAgeMin  = -1;
         double tcCapUSD  = 0.0;
         string tcLabel   = "";

         if(ageMin >= TimeCutStage3AgeMinutes)
         {
            tcAgeMin = TimeCutStage3AgeMinutes; tcCapUSD = TimeCutStage3MaxLossUSD; tcLabel = "palier 3";
         }
         else if(ageMin >= TimeCutMaxAgeMinutes)
         {
            tcAgeMin = TimeCutMaxAgeMinutes; tcCapUSD = TimeCutMaxLossUSD; tcLabel = "palier 2";
         }
         else if(ageMin >= TimeCutStage1AgeMinutes)
         {
            tcAgeMin = TimeCutStage1AgeMinutes; tcCapUSD = TimeCutStage1MaxLossUSD; tcLabel = "palier 1";
         }

         if(tcAgeMin >= 0 && profit >= -tcCapUSD)
         {
            Print("â±ï¸ðŸ›‘ FILET SECURITE TEMPS (", tcLabel, ") â€” position ouverte depuis ", ageMin, " min sans profit sur ",
                  posInfo.Symbol(), " | ticket=", ticket,
                  " | perte actuelle=", DoubleToString(profit, 2), "$",
                  " (plafond=", DoubleToString(-tcCapUSD, 2), "$) -> coupure preventive");

            if(PositionCloseWithLog(ticket, "Filet securite temps (" + tcLabel + ") - coupure preventive"))
            {
               if(UseNotifications)
               {
                  Alert("â±ï¸ðŸ›‘ Position fermee (filet temps, ", tcLabel, ") - ", posInfo.Symbol());
                  SendNotification("Position fermee (filet temps, " + tcLabel + ") - " + posInfo.Symbol());
               }
            }
            else
            {
               int err = GetLastError();
               Print("âŒ Ã‰chec fermeture filet securite temps - ticket=", ticket, " | code=", err);
            }
         }
      }
   }

   // Purge des slots dont le ticket n'existe plus (position fermee ailleurs)
   for(int s = g_stagCount - 1; s >= 0; s--)
   {
      if(seen[s]) continue;
      g_stagTicket[s]     = g_stagTicket[g_stagCount - 1];
      g_stagPeakProfit[s] = g_stagPeakProfit[g_stagCount - 1];
      g_stagPeakTime[s]   = g_stagPeakTime[g_stagCount - 1];
      g_stagCount--;
   }
}

// DÃ©place le SL pour verrouiller 70% du pic (ex: spike $1 â†’ SL Ã  $0.70).
// FIX 2026-09-20: AppliquÃ© Ã  TOUS les symboles pour protÃ©ger 30% du gain max aprÃ¨s spike capture
void SMC_ProtectCapturedSpikeSL()
{
   if(PositionsTotal() <= 0) return;
   const double keepPct = MathMax(50.0, MathMin(95.0, SpikeCloseKeepPct)) / 100.0;
   const double minPeak = MathMax(0.10, SpikeCloseMinProfitUSD);

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      string symbol = posInfo.Symbol();
      if(!SMC_IsSynthSpikeFamily(symbol))
         continue;

      ulong ticket = posInfo.Ticket();
      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      int slot = -1;
      for(int s = 0; s < g_giveBackCount; s++)
         if(g_giveBackTicket[s] == ticket) { slot = s; break; }
      double peak = (slot >= 0) ? g_giveBackPeak[slot] : profit;
      if(profit > peak) peak = profit;
      if(peak < minPeak) continue;

      double protectUSD = peak * keepPct;
      double tickVal = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_VALUE);
      double tickSize = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);
      double lot = posInfo.Volume();
      if(tickVal <= 0.0 || tickSize <= 0.0 || lot <= 0.0) continue;

      int dg = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);
      int stopsLvl = (int)SymbolInfoInteger(symbol, SYMBOL_TRADE_STOPS_LEVEL);
      double pt = SymbolInfoDouble(symbol, SYMBOL_POINT);
      double minDist = (double)(stopsLvl + 2) * pt;
      double openPx = posInfo.PriceOpen();
      double curSL = posInfo.StopLoss();
      double tp = posInfo.TakeProfit();
      double dist = (protectUSD / (tickVal * lot)) * tickSize;

      if(posInfo.PositionType() == POSITION_TYPE_BUY)
      {
         double bid = SymbolInfoDouble(symbol, SYMBOL_BID);
         double newSL = NormalizeDouble(openPx + dist, dg);
         double floorSL = NormalizeDouble(openPx + minDist, dg);
         if(newSL < floorSL) newSL = floorSL;
         if(newSL >= bid - minDist) continue;
         if(curSL > 0.0 && newSL <= curSL) continue;
         newSL = NormalizeSLForBroker(symbol, newSL, curSL);
         if(PositionSelectByTicket(ticket) && trade.PositionModify(ticket, newSL, tp))
            Print("ðŸ›¡ï¸ SL SPIKE BUY ", symbol, " #", ticket,
                  " peak=$", DoubleToString(peak, 2),
                  " lock=$", DoubleToString(protectUSD, 2),
                  " SLâ†’", DoubleToString(newSL, dg));
      }
      else
      {
         double ask = SymbolInfoDouble(symbol, SYMBOL_ASK);
         double newSL = NormalizeDouble(openPx - dist, dg);
         double floorSL = NormalizeDouble(openPx - minDist, dg);
         if(newSL > floorSL) newSL = floorSL;
         if(newSL <= ask + minDist) continue;
         if(curSL > 0.0 && newSL >= curSL && curSL > 0.0) continue;
         if(curSL > 0.0 && newSL >= curSL) continue;
         newSL = NormalizeSLForBroker(symbol, newSL, curSL);
         if(PositionSelectByTicket(ticket) && trade.PositionModify(ticket, newSL, tp))
            Print("ðŸ›¡ï¸ SL SPIKE SELL ", symbol, " #", ticket,
                  " peak=$", DoubleToString(peak, 2),
                  " lock=$", DoubleToString(protectUSD, 2),
                  " SLâ†’", DoubleToString(newSL, dg));
      }
   }
}

