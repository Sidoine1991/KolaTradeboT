datetime g_gomWaitSince = 0;

// FIX v1.32: Anti-flicker Pattern Override - Ã©viter oscillations verdict GOM
int      g_gomOriginalVerdictNum = 0;         // Verdict original du serveur GOM
datetime g_gomOriginalSince = 0;             // Timestamp du verdict original
int      g_gomLastAdjustedVerdict = 0;       // Dernier verdict ajustÃ© par patterns
datetime g_gomLastAdjustTime = 0;            // Timestamp du dernier ajustement
int      g_gomDebounceMinSec = 30;           // Min secondes avant override pattern

// Pattern Override guards - traÃ§abilitÃ© corrections et source
