//| ENVOI DE FEEDBACK DE TRADES Ã€ L'IA SERVER                        |
void OnTradeTransaction(const MqlTradeTransaction &trans,
                        const MqlTradeRequest &request,
                        const MqlTradeResult &result)
{
   // Ne traiter que les transactions de clÃ´ture de positions
   if(trans.type != TRADE_TRANSACTION_POSITION)
      return;

   // Learning Journal: log open/close/trades
   LJ_OnTransaction(trans);

   // Pour les transactions de position, vÃ©rifier si c'est une clÃ´ture
   // En MQL5, on vÃ©rifie si la position existe encore
   CPositionInfo pos;
   if(!pos.SelectByTicket(trans.position))
   {
      // La position n'existe plus = elle a Ã©tÃ© fermÃ©e
      // RÃ©initialiser le maxProfit pour cette position
      g_maxProfit = 0;
      
      // On doit rÃ©cupÃ©rer les informations depuis l'historique des deals
      if(HistorySelectByPosition(trans.position))
      {
         // RÃ©cupÃ©rer le dernier deal de cette position
         int deals = HistoryDealsTotal();
         for(int i = deals - 1; i >= 0; i--)
         {
            ulong deal_ticket = HistoryDealGetTicket(i);
            if(deal_ticket > 0)
            {
               CDealInfo deal;
               if(deal.SelectByIndex(i) && deal.PositionId() == trans.position)
               {
                  long dealEntry = deal.Entry();
                  if(dealEntry != DEAL_ENTRY_OUT && dealEntry != DEAL_ENTRY_OUT_BY)
                     continue;

                  if(deal.Magic() != InpMagicNumber)
                     return;

                  string symbol = deal.Symbol();
                  double profit = deal.Profit() + deal.Swap() + deal.Commission();
                  bool is_win = (profit > 0);
                  string side = (deal.Type() == DEAL_TYPE_BUY) ? "BUY" : "SELL";

                  CM_OnClosedTrade(profit);

                  // MÃ©moriser perte rÃ©cente par symbole (Ã©viter 2e perte consÃ©cutive sans conditions strictes)
                  if(profit < 0)
                  {
                     g_lastLossSymbol = symbol;
                     g_lastLossTime   = (datetime)deal.Time();
                  }
                  else if(symbol == g_lastLossSymbol)
                  {
                     g_lastLossSymbol = "";
                     g_lastLossTime   = 0;
                  }

                  // MÃ©moriser gain rÃ©cent par symbole (Ã©viter rÃ©entrÃ©e immÃ©diate - demande Sidoine)
                  if(profit > 0)
                  {
                     g_lastGainSymbol = symbol;
                     g_lastGainTime   = (datetime)deal.Time();
                     Print("âœ… GAIN COOLDOWN ENREGISTRÃ‰ â€” ", symbol, " | Profit: $", DoubleToString(profit, 2),
                           " | Cooldown ", GainCooldownMinutes, " min activÃ© jusqu'Ã  ", TimeToString(g_lastGainTime + GainCooldownMinutes * 60, TIME_DATE|TIME_MINUTES));
                  }
                  else if(symbol == g_lastGainSymbol)
                  {
                     Print("ðŸ”„ GAIN COOLDOWN RÃ‰INITIALISÃ‰ â€” ", symbol, " | Perte dÃ©tectÃ©e sur symbole prÃ©cÃ©dent");
                     g_lastGainSymbol = "";
                     g_lastGainTime   = 0;
                  }
                  // Compteur pertes consÃ©cutives + mode patient FVG TRAIL
                  SMC_RecordSymbolTradeResult(symbol, profit);
                  // FIX v1.19: pauses 15 min (2 wins / 3 losses > $4)
                  UpdateSymbolPauseInfo(symbol, profit);
                  if(ShouldPauseSymbol(symbol, profit))
                     ApplySymbolPause(symbol, (profit > 0) ? PauseAfterTwoWinsMin : PauseAfterLossStreakMin);
                  SMC_OnClosedTradeForPause(profit);
                  PRO_OnPositionClosed(profit); // PRO v1.55 : serie de pertes / stop journalier

                  // Timestamps (convertir en millisecondes pour compatibilitÃ© JSON)
                  long open_time = (long)deal.Time() * 1000;  // Time of the deal
                  long close_time = (long)deal.Time() * 1000;

                  // Utiliser la derniÃ¨re confiance IA connue
                  double ai_confidence = g_lastAIConfidence;

                  // CrÃ©er le payload JSON
                  string json_payload = StringFormat(
                     "{"
                     "\"symbol\":\"%s\","
                     "\"timeframe\":\"M1\","
                     "\"profit\":%.2f,"
                     "\"is_win\":%s,"
                     "\"ai_confidence\":%.4f,"
                     "\"side\":\"%s\","
                     "\"open_time\":%lld,"
                     "\"close_time\":%lld"
                     "}",
                     symbol,
                     profit,
                     is_win ? "true" : "false",
                     ai_confidence,
                     side,
                     open_time,
                     close_time
                  );

                  // Envoyer Ã  l'IA server (essayer primaire puis secondaire)
                  string url1 = AI_ServerURL + "/trades/feedback";
                  string url2 = AI_ServerURL + "/trades/feedback";
                  
                  Print("ðŸ“¤ ENVOI FEEDBACK IA - URL1: ", url1);
                  Print("ðŸ“¤ ENVOI FEEDBACK IA - URL2: ", url2);
                  Print("ðŸ“¤ ENVOI FEEDBACK IA - DonnÃ©es: symbol=", symbol, " profit=", DoubleToString(profit, 2), " ai_conf=", DoubleToString(ai_confidence, 2));

                  string headers = "Content-Type: application/json\r\n";
                  char post_data[];
                  char result_data[];
                  string result_headers;

                  // Convertir string JSON en array de char
                  StringToCharArray(json_payload, post_data, 0, StringLen(json_payload));

                  // Premier essai
                  int http_result = WebRequest("POST", url1, headers, AI_Timeout_ms, post_data, result_data, result_headers);

                  // Si Ã©chec, essayer le serveur secondaire
                  if(http_result != 200)
                  {
                     http_result = WebRequest("POST", url2, headers, AI_Timeout_ms, post_data, result_data, result_headers);
                  }

                  // Log du rÃ©sultat
                  if(http_result == 200)
                  {
                     Print("âœ… FEEDBACK IA ENVOYÃ‰: ", symbol, " ", side, " Profit: ", DoubleToString(profit, 2), " IA Conf: ", DoubleToString(ai_confidence, 2));
                  }
                  else
                  {
                     Print("âŒ Ã‰CHEC ENVOI FEEDBACK IA: HTTP ", http_result, " pour ", symbol, " ", side);
                  }

                  break; // On a trouvÃ© le deal de clÃ´ture, sortir de la boucle
               }
            }
         }
      }
   }
}

//| RÃ©cupÃ©rer les donnÃ©es de l'endpoint Decision                        |
bool GetAISignalData()
{
   static datetime lastAPICall = 0;
   static string lastCachedResponse = "";
   
   datetime currentTime = TimeCurrent();
   
   // Cache API: Ã©viter les appels trop frÃ©quents (toutes les 30 secondes)
   if((currentTime - lastAPICall) < 30 && lastCachedResponse != "")
   {
      // Utiliser la rÃ©ponse en cache
      if(StringFind(lastCachedResponse, "\"action\":") >= 0)
      {
         int actionStart = StringFind(lastCachedResponse, "\"action\":");
         actionStart = StringFind(lastCachedResponse, "\"", actionStart + 9) + 1;
         int actionEnd = StringFind(lastCachedResponse, "\"", actionStart);
         if(actionEnd > actionStart)
         {
            g_lastAIAction = StringSubstr(lastCachedResponse, actionStart, actionEnd - actionStart);
            return true;
         }
      }
   }
   
   // Endpoint POST /decision sur Render ou serveur local
   string base = AI_ServerURL;
   string url  = base + "/decision";
   string headers = "Content-Type: application/json\r\n";
   char post[];
   uchar response[];
   
   // PrÃ©parer les donnÃ©es de marchÃ© de base
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   
   // ATR via handle principal (si disponible)
   double atr = 0.0;
   double atrBuf[];
   ArraySetAsSeries(atrBuf, true);
   if(atrHandle != INVALID_HANDLE && CopyBuffer(atrHandle, 0, 0, 1, atrBuf) > 0)
      atr = atrBuf[0];
   
   // Calcul d'un RSI M15 pour alimenter le backend simplifiÃ©
   double rsi = 50.0;
   MqlRates rsiRates[];
   ArraySetAsSeries(rsiRates, true);
   if(CopyRates(_Symbol, PERIOD_M15, 0, 50, rsiRates) >= 15)
   {
      // Utilise la fonction ComputeRSI dÃ©jÃ  dÃ©finie (pÃ©riode 14)
      rsi = ComputeRSI(rsiRates, 14, 14);
   }
   // SÃ©curitÃ© supplÃ©mentaire : clamp 0-100 pour l'envoi JSON
   if(rsi < 0.0) rsi = 0.0;
   if(rsi > 100.0) rsi = 100.0;
   
   // RÃ©cupÃ©rer les EMA rapides/lentes via les handles existants (M1, M5, H1)
   double emaFastM1Val = 0.0, emaSlowM1Val = 0.0;
   double emaFastM5Val = 0.0, emaSlowM5Val = 0.0;
   double emaFastH1Val = 0.0, emaSlowH1Val = 0.0;
   double bufFast[], bufSlow[];
   ArraySetAsSeries(bufFast, true);
   ArraySetAsSeries(bufSlow, true);
   
   // M1
   if(emaFastM1 != INVALID_HANDLE && CopyBuffer(emaFastM1, 0, 0, 1, bufFast) > 0)
      emaFastM1Val = bufFast[0];
   if(emaSlowM1 != INVALID_HANDLE && CopyBuffer(emaSlowM1, 0, 0, 1, bufSlow) > 0)
      emaSlowM1Val = bufSlow[0];
   
   // M5
   if(emaFastM5 != INVALID_HANDLE && CopyBuffer(emaFastM5, 0, 0, 1, bufFast) > 0)
      emaFastM5Val = bufFast[0];
   if(emaSlowM5 != INVALID_HANDLE && CopyBuffer(emaSlowM5, 0, 0, 1, bufSlow) > 0)
      emaSlowM5Val = bufSlow[0];
   
   // H1
   if(emaFastH1 != INVALID_HANDLE && CopyBuffer(emaFastH1, 0, 0, 1, bufFast) > 0)
      emaFastH1Val = bufFast[0];
   if(emaSlowH1 != INVALID_HANDLE && CopyBuffer(emaSlowH1, 0, 0, 1, bufSlow) > 0)
      emaSlowH1Val = bufSlow[0];
   
   // Construire la requÃªte JSON enrichie pour /decision (compatible decision_simplified)
   // Ajouter les indicateurs de dÃ©tection de spike avancÃ©e - VERSION OPTIMISÃ‰E
   double volCompression = 1.0; // Valeur par dÃ©faut
   double priceAccel = 0.0;
   bool volumeSpike = false;
   double spikeProb = 0.5; // Valeur neutre par dÃ©faut
   
   // Calcul rapide avec protection
   if(atrHandle != INVALID_HANDLE)
   {
      // Compression ATR rapide
      double buffer[];
      ArraySetAsSeries(buffer, true);
      if(CopyBuffer(atrHandle, 0, 0, 10, buffer) >= 5)
      {
         double recentATR = buffer[0];
         double avgATR = 0.0;
         for(int i = 0; i < 5; i++) avgATR += buffer[i];
         avgATR /= 5.0;
         if(avgATR > 0) volCompression = recentATR / avgATR;
      }
      
      // AccÃ©lÃ©ration prix rapide
      MqlRates rates[];
      ArraySetAsSeries(rates, true);
      if(CopyRates(_Symbol, PERIOD_M1, 0, 3, rates) >= 2)
      {
         double change1 = (rates[0].close - rates[1].close) / rates[1].close;
         double change2 = (rates[1].close - rates[2].close) / rates[2].close;
         priceAccel = (change1 - change2) / 2.0;
      }
      
      // Volume spike rapide
      long volume[];
      ArraySetAsSeries(volume, true);
      if(CopyTickVolume(_Symbol, PERIOD_M1, 0, 5, volume) >= 3)
      {
         double recentVolume = (double)volume[0];
         double avgVolume = 0.0;
         for(int i = 1; i < 3; i++) avgVolume += (double)volume[i];
         avgVolume /= 2.0;
         volumeSpike = (recentVolume > avgVolume * 1.5);
      }
      
      // ProbabilitÃ© spike rapide - AJUSTÃ‰ pour 70% de certitude
      spikeProb = 0.0;
      if(volCompression < 0.7) spikeProb += 0.4; // Compression forte (< 70%)
      if(MathAbs(priceAccel) > 0.001) spikeProb += 0.3; // AccÃ©lÃ©ration notable
      if(volumeSpike) spikeProb += 0.3; // Volume spike confirmÃ©
      spikeProb = MathMin(spikeProb, 1.0);

      // MÃ©moriser la probabilitÃ© locale de spike pour rÃ©utilisation (CheckImminentSpike, filtres ML, etc.)
      g_lastSpikeProbability = spikeProb;
      g_lastSpikeUpdate      = TimeCurrent();
   }
   
   string jsonRequest = StringFormat(
      "{\"symbol\":\"%s\",\"bid\":%.5f,\"ask\":%.5f,"
      "\"atr\":%.5f,\"rsi\":%.2f,"
      "\"ema_fast_m1\":%.5f,\"ema_slow_m1\":%.5f,"
      "\"ema_fast_m5\":%.5f,\"ema_slow_m5\":%.5f,"
      "\"ema_fast_h1\":%.5f,\"ema_slow_h1\":%.5f,"
      "\"volatility_compression\":%.3f,"
      "\"price_acceleration\":%.6f,"
      "\"volume_spike\":%s,"
      "\"spike_probability\":%.3f,"
      "\"timestamp\":\"%s\"}",
      _Symbol, bid, ask, atr, rsi,
      emaFastM1Val, emaSlowM1Val,
      emaFastM5Val, emaSlowM5Val,
      emaFastH1Val, emaSlowH1Val,
      volCompression,
      priceAccel,
      volumeSpike ? "true" : "false",
      spikeProb,
      TimeToString(TimeCurrent())
   );
   
   Print("ðŸ“¦ ENVOI IA: ", jsonRequest);
   
   StringToCharArray(jsonRequest, post);
   
   // Timeout rÃ©duit pour Ã©viter le dÃ©tachement
   int res = WebRequest("POST", url, headers, 2000, post, response, headers);
   
      if(res == 200)
      {
         string jsonResponse = CharArrayToString(response);
         Print("ðŸ“¥ RÃ‰PONSE IA: ", jsonResponse);
         
         // Mettre Ã  jour le cache
         lastAPICall = currentTime;
         lastCachedResponse = jsonResponse;
         
         // Parser la rÃ©ponse JSON
         int actionStart = StringFind(jsonResponse, "\"action\":");
         if(actionStart >= 0)
         {
            actionStart = StringFind(jsonResponse, "\"", actionStart + 9) + 1;
            int actionEnd = StringFind(jsonResponse, "\"", actionStart);
            if(actionEnd > actionStart)
            {
               g_lastAIAction = StringSubstr(jsonResponse, actionStart, actionEnd - actionStart);
               
               int confStart = StringFind(jsonResponse, "\"confidence\":");
               if(confStart >= 0)
               {
                  confStart = StringFind(jsonResponse, ":", confStart) + 1;
                  int confEnd = StringFind(jsonResponse, ",", confStart);
                  if(confEnd < 0) confEnd = StringFind(jsonResponse, "}", confStart);
                  if(confEnd > confStart)
                  {
                     string confStr = StringSubstr(jsonResponse, confStart, confEnd - confStart);
                     g_lastAIConfidence = StringToDouble(confStr);
                  }
               }

               // Extraire la probabilitÃ© de spike renvoyÃ©e par le modÃ¨le ML (si disponible)
               int spikeStart = StringFind(jsonResponse, "\"spike_probability\"");
               if(spikeStart >= 0)
               {
                  spikeStart = StringFind(jsonResponse, ":", spikeStart) + 1;
                  int spikeEnd = StringFind(jsonResponse, ",", spikeStart);
                  if(spikeEnd < 0) spikeEnd = StringFind(jsonResponse, "}", spikeStart);
                  if(spikeEnd > spikeStart)
                  {
                     string spikeStr = StringSubstr(jsonResponse, spikeStart, spikeEnd - spikeStart);
                     double spikeVal = StringToDouble(spikeStr);
                     
                     // Accepter 0â€‘1 ou 0â€‘100%
                     if(spikeVal > 1.0)
                        spikeVal /= 100.0;
                     
                     if(spikeVal >= 0.0 && spikeVal <= 1.0)
                     {
                        g_lastSpikeProbability = spikeVal;
                        g_lastSpikeUpdate      = TimeCurrent();
                     }
                  }
               }
               
               // Extraire alignement et cohÃ©rence
            int alignStart = StringFind(jsonResponse, "\"alignment\":");
            if(alignStart >= 0)
            {
               alignStart = StringFind(jsonResponse, "\"", alignStart + 12) + 1;
               int alignEnd = StringFind(jsonResponse, "\"", alignStart);
               if(alignEnd > alignStart)
               {
                  g_lastAIAlignment = StringSubstr(jsonResponse, alignStart, alignEnd - alignStart);
               }
            }
            
            int cohStart = StringFind(jsonResponse, "\"coherence\":");
            if(cohStart >= 0)
            {
               cohStart = StringFind(jsonResponse, "\"", cohStart + 13) + 1;
               int cohEnd = StringFind(jsonResponse, "\"", cohStart);
               if(cohEnd > cohStart)
               {
                  g_lastAICoherence = StringSubstr(jsonResponse, cohStart, cohEnd - cohStart);
               }
            }
            
            g_lastAIUpdate = TimeCurrent();
            g_aiConnected = true;
            
            g_lastAISource = "SERVER";
            Print("âœ… IA MISE Ã€ JOUR: ", g_lastAIAction, " | ", DoubleToString(g_lastAIConfidence*100,1), "% | ", g_lastAIAlignment, " | ", g_lastAICoherence);
            
            return true;
         }
      }
   }
   else
   {
      Print("âŒ ERREUR IA: HTTP ", res);
      g_aiConnected = false;
      
      // FALLBACK: Le fallback sera gÃ©rÃ© par OnTick directement
      // GenerateFallbackAIDecision(); // DÃ©placÃ© dans OnTick
   }
   
   return false;
}

//| GÃ©nÃ©rer une dÃ©cision IA de fallback basÃ©e sur les donnÃ©es de marchÃ© |
void GenerateFallbackAIDecision()
{
   // FIX v1.42: cette fonction est un fallback LOCAL (EMA/momentum), pas une
   // intelligence. Toutes ses ecritures sont taggees source FallBACK pour que
   // les consommateurs (IA HOLD close / gate entree) puissent les ignorer.
   g_lastAISource = "FALLBACK_EMA";

   // RÃ©cupÃ©rer les donnÃ©es de marchÃ© actuelles
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   
   // Calculer une tendance SMC EMA avancÃ©e
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   
   string action = "HOLD";
   double confidence = 0.5;
   double alignment = 50.0;
   double coherence = 50.0;
   
   if(CopyRates(_Symbol, PERIOD_M1, 0, 50, rates) >= 20)
   {
      // Calculer les EMA pour analyse SMC
      double ema8 = 0, ema21 = 0, ema50 = 0, ema200 = 0;
      
      // EMA 8 (trÃ¨s court terme)
      double multiplier8 = 2.0 / (8 + 1);
      ema8 = rates[0].close;
      for(int i = 1; i < 8; i++)
         ema8 = rates[i].close * multiplier8 + ema8 * (1 - multiplier8);
      
      // EMA 21 (court terme)
      double multiplier21 = 2.0 / (21 + 1);
      ema21 = rates[0].close;
      for(int i = 1; i < 21; i++)
         ema21 = rates[i].close * multiplier21 + ema21 * (1 - multiplier21);
      
      // EMA 50 (moyen terme)
      double multiplier50 = 2.0 / (50 + 1);
      ema50 = rates[0].close;
      for(int i = 1; i < 50; i++)
         ema50 = rates[i].close * multiplier50 + ema50 * (1 - multiplier50);
      
      // EMA 200 (long terme)
      double multiplier200 = 2.0 / (200 + 1);
      ema200 = rates[0].close;
      for(int i = 1; i < MathMin(200, ArraySize(rates)); i++)
         ema200 = rates[i].close * multiplier200 + ema200 * (1 - multiplier200);
      
      double currentPrice = rates[0].close;
      
      // LOGIQUE SMC EMA AVANCÃ‰E
      bool bullishStructure = (ema8 > ema21) && (ema21 > ema50) && (ema50 > ema200);
      bool bearishStructure = (ema8 < ema21) && (ema21 < ema50) && (ema50 < ema200);
      
      // DÃ©tecter les croisements EMA
      bool ema8Cross21Up = (ema8 > ema21) && (rates[1].close <= rates[2].close);
      bool ema8Cross21Down = (ema8 < ema21) && (rates[1].close >= rates[2].close);
      
      // DÃ©tecter la momentum
      double momentum = (currentPrice - ema50) / ema50;
      double momentumShort = (currentPrice - ema21) / ema21;
      
      // DÃ‰CISION BASÃ‰E SUR SMC EMA
      if(bullishStructure && momentum > 0.002)
      {
         action = "BUY";
         confidence = MathMin(0.95, 0.6 + MathAbs(momentum) * 100);
         alignment = MathMin(98.0, 60.0 + MathAbs(momentum) * 100);
         coherence = MathMin(95.0, 55.0 + MathAbs(momentumShort) * 80);
      }
      else if(bearishStructure && momentum < -0.002)
      {
         action = "SELL";
         confidence = MathMin(0.95, 0.6 + MathAbs(momentum) * 100);
         alignment = MathMin(98.0, 60.0 + MathAbs(momentum) * 100);
         coherence = MathMin(95.0, 55.0 + MathAbs(momentumShort) * 80);
      }
      else if(ema8Cross21Up && momentum > 0.001)
      {
         action = "BUY";
         // FIX: confiance fixe faible pour éviter passages non déterministes sous le seuil 75%
         // cohérence dérivée de la structure EMA (non aléatoire)
         confidence = 0.50;  // FIXED: low fixed confidence
         alignment = 70.0;    // FIXED: fixed alignment
         coherence = 65.0;    // FIXED: fixed coherence from EMA structure
      }
      else if(ema8Cross21Down && momentum < -0.001)
      {
         action = "SELL";
         // FIX: confiance fixe faible pour éviter passages non déterministes sous le seuil 75%
         // cohérence dérivée de la structure EMA (non aléatoire)
         confidence = 0.50;  // FIXED: low fixed confidence
         alignment = 70.0;    // FIXED: fixed alignment
         coherence = 65.0;    // FIXED: fixed coherence from EMA structure
      }
      else if(MathAbs(momentum) < 0.0005)
      {
         action = "HOLD";
         // FIX: confiance fixe faible, pas de trading sur HOLD
         // cohérence fixée bas car pas de verdict significatif
         confidence = 0.20;  // FIXED: very low confidence for HOLD
         alignment = 35.0;    // FIXED: low alignment for HOLD
         coherence = 20.0;    // FIXED: very low coherence for HOLD
      }
      else
      {
         // DÃ©cision basÃ©e sur le momentum restant
         if(momentum > 0)
         {
            action = "BUY";
            confidence = 0.55 + MathAbs(momentum) * 30;
            alignment = 50.0 + MathAbs(momentum) * 40;
            coherence = 45.0 + MathAbs(momentum) * 35;
         }
         else
         {
            action = "SELL";
            confidence = 0.55 + MathAbs(momentum) * 30;
            alignment = 50.0 + MathAbs(momentum) * 40;
            coherence = 45.0 + MathAbs(momentum) * 35;
         }
      }
   }
   else
   {
      // FIX v1.42 (verite): plus AUCUN tirage aleatoire d action/Conf/Align/Coh.
      // Sans donnees suffisantes le statut devient un HOLD honnete & neutre ;
      // les consommateurs identifient ce statut via g_lastAISource= FALLBACK_RAND
      // et ne ferment pas / ne bloquent pas d entree sur de la decoration.
      action = "HOLD";
      confidence = 0.0;
      alignment = 0.0;
      coherence = 0.0;
      g_lastAISource = "FALLBACK_RAND";
   }
   
   // Mettre Ã  jour les variables globales
   g_lastAIAction = action;
   g_lastAIConfidence = confidence;
   g_lastAIAlignment = DoubleToString(alignment, 1) + "%";
   g_lastAICoherence = DoubleToString(coherence, 1) + "%";
   g_lastAIUpdate = TimeCurrent();
   
   Print("ðŸ”„ IA SMC-EMA - Action: ", action, " | Conf: ", DoubleToString(confidence*100,1), "% | Align: ", g_lastAIAlignment, " | CohÃ©r: ", g_lastAICoherence);
}

// Petit helper de debug pour inspecter rapidement la derniÃ¨re dÃ©cision IA
void DebugPrintAIDecision()
{
   Print("ðŸ¤– DEBUG IA - Symbole: ", _Symbol,
         " | Action: ", g_lastAIAction,
         " | Confiance: ", DoubleToString(g_lastAIConfidence*100, 1), "%",
         " | Alignement: ", g_lastAIAlignment,
         " | CohÃ©rence: ", g_lastAICoherence);
}

//| DÃ‰TECTION SWING HIGH/LOW SPÃ‰CIALE BOOM/CRASH (LOGIQUE TRADING) |
bool DetectBoomCrashSwingPoints()
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   int barsToAnalyze = 100;
   
   if(CopyRates(_Symbol, PERIOD_M1, 0, barsToAnalyze, rates) < barsToAnalyze)
      return false;
   
   // Nettoyer les anciens objets Boom/Crash
   ObjectsDeleteAll(0, "SMC_BC_SH_");
   ObjectsDeleteAll(0, "SMC_BC_SL_");
   
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   double avgMove = 0;
   
   // Calculer le mouvement moyen pour dÃ©tecter les spikes
   for(int i = 1; i < barsToAnalyze; i++)
   {
      double move = MathAbs(rates[i-1].close - rates[i].close);
      avgMove += move;
   }
   avgMove /= (barsToAnalyze - 1);
   
   // Seuil de spike (8x le mouvement normal pour Boom/Crash)
   double spikeThreshold = avgMove * 8.0;
   
   Print("ðŸ“Š BOOM/CRASH - Mouvement moyen: ", DoubleToString(avgMove, _Digits), " | Seuil spike: ", DoubleToString(spikeThreshold, _Digits));
   
   bool isBoom = IsBoomLikeSymbol(_Symbol);
   bool isCrash = IsCrashLikeSymbol(_Symbol);
   
   // DÃ‰TECTION DES SPIKES D'ABORD
   for(int i = 5; i < barsToAnalyze - 5; i++)
   {
      double priceChange = MathAbs(rates[i].close - rates[i-1].close);
      bool isSpike = (priceChange > spikeThreshold);
      
      if(!isSpike) continue;
      
      Print("ðŸš¨ SPIKE DÃ‰TECTÃ‰ - Barre ", i, " | Mouvement: ", DoubleToString(priceChange, _Digits), " | Type: ", isBoom ? "BOOM" : "CRASH");
      
      // LOGIQUE BOOM : SH APRÃˆS SPIKE (pour annoncer le sell)
      if(isBoom)
      {
         // Chercher le Swing High APRÃˆS le spike (confirmation de retournement)
         for(int j = MathMax(0, i - 8); j <= MathMax(0, i - 2); j++) // 2-8 barres aprÃ¨s le spike
         {
            double currentHigh = rates[j].high;
            
            // VÃ©rifier si c'est un swing high local
            bool isPotentialSH = true;
            for(int k = MathMax(0, j - 3); k <= MathMin(barsToAnalyze - 1, j + 3); k++)
            {
               if(k != j && rates[k].high >= currentHigh)
               {
                  isPotentialSH = false;
                  break;
               }
            }
            
            // Confirmation : le SH doit Ãªtre plus bas que le pic du spike
            if(isPotentialSH && currentHigh < rates[i].high)
            {
               // Confirmer que c'est bien aprÃ¨s le spike
               bool confirmedAfterSpike = true;
               for(int k = j + 1; k <= MathMin(barsToAnalyze - 1, j + 3); k++)
               {
                  if(rates[k].high > currentHigh)
                  {
                     confirmedAfterSpike = false;
                     break;
                  }
               }
               
               if(confirmedAfterSpike)
               {
                  string shName = "SMC_BC_SH_" + IntegerToString(j);
                  if(ObjectCreate(0, shName, OBJ_ARROW, 0, rates[j].time, currentHigh))
                  {
                     ObjectSetInteger(0, shName, OBJPROP_COLOR, clrRed);
                     ObjectSetInteger(0, shName, OBJPROP_STYLE, STYLE_SOLID);
                     ObjectSetInteger(0, shName, OBJPROP_WIDTH, 6);
                     ObjectSetInteger(0, shName, OBJPROP_ARROWCODE, 233);
                     ObjectSetString(0, shName, OBJPROP_TOOLTIP, 
                                   "SH APRÃˆS SPIKE BOOM (Signal SELL): " + DoubleToString(currentHigh, _Digits) + " | Spike: " + DoubleToString(rates[i].high, _Digits));
                     
                     // Ligne horizontale
                     string lineName = shName + "_Line";
                     if(ObjectCreate(0, lineName, OBJ_HLINE, 0, rates[j].time, currentHigh))
                     {
                        ObjectSetInteger(0, lineName, OBJPROP_COLOR, clrRed);
                        ObjectSetInteger(0, lineName, OBJPROP_STYLE, STYLE_DASH);
                        ObjectSetInteger(0, lineName, OBJPROP_WIDTH, 3);
                        ObjectSetInteger(0, lineName, OBJPROP_BACK, true);
                     }
                     
                     Print("ðŸ”´ SH APRÃˆS SPIKE BOOM (Signal SELL) - Prix: ", DoubleToString(currentHigh, _Digits), " | Spike: ", DoubleToString(rates[i].high, _Digits), " | Time: ", TimeToString(rates[j].time));
                  }
                  break; // Prendre le premier SH valide aprÃ¨s le spike
               }
            }
         }
      }
      
      // LOGIQUE CRASH : SL AVANT SPIKE (pour annoncer le crash)
      if(isCrash)
      {
         // Chercher le Swing Low AVANT le spike (prÃ©paration du crash)
         for(int j = i + 2; j <= MathMin(barsToAnalyze - 1, i + 8); j++) // 2-8 barres avant le spike
         {
            double currentLow = rates[j].low;
            
            // VÃ©rifier si c'est un swing low local
            bool isPotentialSL = true;
            for(int k = MathMax(0, j - 3); k <= MathMin(barsToAnalyze - 1, j + 3); k++)
            {
               if(k != j && rates[k].low <= currentLow)
               {
                  isPotentialSL = false;
                  break;
               }
            }
            
            // Confirmation : le SL doit Ãªtre plus haut que le creux du spike
            if(isPotentialSL && currentLow > rates[i].low)
            {
               // Confirmer que c'est bien avant le spike
               bool confirmedBeforeSpike = true;
               for(int k = MathMax(0, j - 3); k <= j - 1; k++)
               {
                  if(rates[k].low < currentLow)
                  {
                     confirmedBeforeSpike = false;
                     break;
                  }
               }
               
               if(confirmedBeforeSpike)
               {
                  string slName = "SMC_BC_SL_" + IntegerToString(j);
                  if(ObjectCreate(0, slName, OBJ_ARROW, 0, rates[j].time, currentLow))
                  {
                     ObjectSetInteger(0, slName, OBJPROP_COLOR, clrBlue);
                     ObjectSetInteger(0, slName, OBJPROP_STYLE, STYLE_SOLID);
                     ObjectSetInteger(0, slName, OBJPROP_WIDTH, 6);
                     ObjectSetInteger(0, slName, OBJPROP_ARROWCODE, 234);
                     ObjectSetString(0, slName, OBJPROP_TOOLTIP, 
                                   "SL AVANT SPIKE CRASH (Signal CRASH): " + DoubleToString(currentLow, _Digits) + " | Spike: " + DoubleToString(rates[i].low, _Digits));
                     
                     // Ligne horizontale
                     string lineName = slName + "_Line";
                     if(ObjectCreate(0, lineName, OBJ_HLINE, 0, rates[j].time, currentLow))
                     {
                        ObjectSetInteger(0, lineName, OBJPROP_COLOR, clrBlue);
                        ObjectSetInteger(0, lineName, OBJPROP_STYLE, STYLE_DASH);
                        ObjectSetInteger(0, lineName, OBJPROP_WIDTH, 3);
                        ObjectSetInteger(0, lineName, OBJPROP_BACK, true);
                     }
                     
                     Print("ðŸ”µ SL AVANT SPIKE CRASH (Signal CRASH) - Prix: ", DoubleToString(currentLow, _Digits), " | Spike: ", DoubleToString(rates[i].low, _Digits), " | Time: ", TimeToString(rates[j].time));
                  }
                  break; // Prendre le premier SL valide avant le spike
               }
            }
         }
      }
   }
   
   return true;
}

//| DÃ‰TECTION SWING HIGH/LOW NON-REPAINTING (ANTI-REPAINT)          |
// SwingPoint struct, swingPoints[], swingPointCount defined in SMC_SharedCore.mqh

//| DÃ©tecter les Swing High/Low sans repaint (confirmation requise)    |
bool DetectNonRepaintingSwingPoints()
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   int barsToAnalyze = 200;
   
   if(CopyRates(_Symbol, PERIOD_M1, 0, barsToAnalyze, rates) < barsToAnalyze)
      return false;
   
   // Nettoyer les anciens points non confirmÃ©s
   for(int i = 0; i < swingPointCount; i++)
   {
      if(swingPoints[i].confirmedBar > 10) // Garder seulement les 10 derniÃ¨res barres
      {
         for(int j = i; j < swingPointCount - 1; j++)
            swingPoints[j] = swingPoints[j + 1];
         swingPointCount--;
         i--;
      }
   }
   
   // Analyser les barres pour dÃ©tecter les swings potentiels
   for(int i = 10; i < barsToAnalyze - 10; i++) // Ã‰viter les bords
   {
      // DÃ‰TECTION SWING HIGH (NON-REPAINTING)
      bool isPotentialSH = true;
      double currentHigh = rates[i].high;
      
      // VÃ©rifier si c'est le plus haut sur au moins 5 barres de chaque cÃ´tÃ©
      for(int j = MathMax(0, i - 5); j <= MathMin(barsToAnalyze - 1, i + 5); j++)
      {
         if(j != i && rates[j].high >= currentHigh)
         {
            isPotentialSH = false;
            break;
         }
      }
      
      // CONFIRMATION SWING HIGH : Attendre 3 barres aprÃ¨s le point potentiel
      if(isPotentialSH && i >= 13) // Assez de barres pour confirmer
      {
         bool confirmed = true;
         
         // VÃ©rifier que les 3 barres suivantes n'ont pas dÃ©passÃ© ce high
         for(int j = i - 3; j >= MathMax(0, i - 5); j--) // 3 barres aprÃ¨s le point
         {
            if(rates[j].high > currentHigh)
            {
               confirmed = false;
               break;
            }
         }
         
         // VÃ©rifier que ce n'est pas dÃ©jÃ  enregistrÃ©
         if(confirmed)
         {
            bool alreadyRecorded = false;
            for(int k = 0; k < swingPointCount; k++)
            {
               if(swingPoints[k].isHigh && 
                  MathAbs(swingPoints[k].price - currentHigh) < SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 5 &&
                  MathAbs(swingPoints[k].time - rates[i].time) <= 300) // 5 minutes tolerance
               {
                  alreadyRecorded = true;
                  break;
               }
            }
            
            if(!alreadyRecorded && swingPointCount < 100)
            {
               swingPoints[swingPointCount].price = currentHigh;
               swingPoints[swingPointCount].time = rates[i].time;
               swingPoints[swingPointCount].isHigh = true;
               swingPoints[swingPointCount].confirmedBar = i;
               swingPointCount++;
               
               Print("ðŸ”´ SWING HIGH CONFIRMÃ‰ - Prix: ", DoubleToString(currentHigh, _Digits), " | Time: ", TimeToString(rates[i].time));
            }
         }
      }
      
      // DÃ‰TECTION SWING LOW (NON-REPAINTING)
      bool isPotentialSL = true;
      double currentLow = rates[i].low;
      
      // VÃ©rifier si c'est le plus bas sur au moins 5 barres de chaque cÃ´tÃ©
      for(int j = MathMax(0, i - 5); j <= MathMin(barsToAnalyze - 1, i + 5); j++)
      {
         if(j != i && rates[j].low <= currentLow)
         {
            isPotentialSL = false;
            break;
         }
      }
      
      // CONFIRMATION SWING LOW : Attendre 3 barres aprÃ¨s le point potentiel
      if(isPotentialSL && i >= 13) // Assez de barres pour confirmer
      {
         bool confirmed = true;
         
         // VÃ©rifier que les 3 barres suivantes n'ont pas dÃ©passÃ© ce low
         for(int j = i - 3; j >= MathMax(0, i - 5); j--) // 3 barres aprÃ¨s le point
         {
            if(rates[j].low < currentLow)
            {
               confirmed = false;
               break;
            }
         }
         
         // VÃ©rifier que ce n'est pas dÃ©jÃ  enregistrÃ©
         if(confirmed)
         {
            bool alreadyRecorded = false;
            for(int k = 0; k < swingPointCount; k++)
            {
               if(!swingPoints[k].isHigh && 
                  MathAbs(swingPoints[k].price - currentLow) < SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 5 &&
                  MathAbs(swingPoints[k].time - rates[i].time) <= 300) // 5 minutes tolerance
               {
                  alreadyRecorded = true;
                  break;
               }
            }
            
            if(!alreadyRecorded && swingPointCount < 100)
            {
               swingPoints[swingPointCount].price = currentLow;
               swingPoints[swingPointCount].time = rates[i].time;
               swingPoints[swingPointCount].isHigh = false;
               swingPoints[swingPointCount].confirmedBar = i;
               swingPointCount++;
               
               Print("ðŸ”µ SWING LOW CONFIRMÃ‰ - Prix: ", DoubleToString(currentLow, _Digits), " | Time: ", TimeToString(rates[i].time));
            }
         }
      }
   }
   
   return true;
}

//| Obtenir les derniers Swing High/Low confirmÃ©s (non-repainting)     |
void GetLatestConfirmedSwings(double &lastSH, datetime &lastSHTime, double &lastSL, datetime &lastSLTime)
{
   lastSH = 0;
   lastSHTime = 0;
   lastSL = 999999;
   lastSLTime = 0;
   
   // Parcourir tous les points pour trouver les plus rÃ©cents
   for(int i = 0; i < swingPointCount; i++)
   {
      if(swingPoints[i].isHigh && swingPoints[i].time > lastSHTime)
      {
         lastSH = swingPoints[i].price;
         lastSHTime = swingPoints[i].time;
      }
      else if(!swingPoints[i].isHigh && swingPoints[i].time > lastSLTime)
      {
         lastSL = swingPoints[i].price;
         lastSLTime = swingPoints[i].time;
      }
   }
}

//| Dessiner les Swing Points confirmÃ©s (non-repainting)              |
// LimitÃ© Ã  25 points pour Ã©viter trop d'objets graphiques â†’ dÃ©tachement
#define MAX_SWING_POINTS_DRAWN 25

void DrawConfirmedSwingPoints()
{
   long chId = ChartID();
   if(chId <= 0) return;
   
   ObjectsDeleteAll(chId, "SMC_Confirmed_SH_");
   ObjectsDeleteAll(chId, "SMC_Confirmed_SL_");
   
   // Limiter le nombre de points affichÃ©s pour Ã©viter saturation objets â†’ dÃ©tachement
   int toDraw = MathMin(swingPointCount, MAX_SWING_POINTS_DRAWN);
   int futureBars = (SMCChannelFutureBars > 0 && SMCChannelFutureBars <= 5000) ? SMCChannelFutureBars : 5000;
   
   for(int i = 0; i < toDraw; i++)
   {
      if(!MathIsValidNumber(swingPoints[i].price) || swingPoints[i].time <= 0) continue;
      
      string objName;
      color objColor;
      int objCode;
      
      if(swingPoints[i].isHigh)
      {
         objName = "SMC_Confirmed_SH_" + IntegerToString(i);
         objColor = clrRed;
         objCode = 233;
      }
      else
      {
         objName = "SMC_Confirmed_SL_" + IntegerToString(i);
         objColor = clrBlue;
         objCode = 234;
      }
      
      if(ObjectCreate(chId, objName, OBJ_ARROW, 0, swingPoints[i].time, swingPoints[i].price))
      {
         ObjectSetInteger(chId, objName, OBJPROP_COLOR, objColor);
         ObjectSetInteger(chId, objName, OBJPROP_STYLE, STYLE_SOLID);
         ObjectSetInteger(chId, objName, OBJPROP_WIDTH, 4);
         ObjectSetInteger(chId, objName, OBJPROP_ARROWCODE, objCode);
         ObjectSetString(chId, objName, OBJPROP_TOOLTIP, 
                       swingPoints[i].isHigh ? "SH ConfirmÃ©: " + DoubleToString(swingPoints[i].price, _Digits) 
                                            : "SL ConfirmÃ©: " + DoubleToString(swingPoints[i].price, _Digits));
         
         string lineName = objName + "_Line";
         datetime startTime = TimeCurrent();
         datetime endTime = startTime + (datetime)((long)futureBars * 60);
         
         if(MathIsValidNumber(swingPoints[i].price) && 
            ObjectCreate(chId, lineName, OBJ_TREND, 0, startTime, swingPoints[i].price, endTime, swingPoints[i].price))
         {
            ObjectSetInteger(chId, lineName, OBJPROP_COLOR, objColor);
            ObjectSetInteger(chId, lineName, OBJPROP_STYLE, STYLE_DASH);
            ObjectSetInteger(chId, lineName, OBJPROP_WIDTH, 2);
            ObjectSetInteger(chId, lineName, OBJPROP_BACK, true);
            ObjectSetInteger(chId, lineName, OBJPROP_RAY_RIGHT, true);
            ObjectSetInteger(chId, lineName, OBJPROP_RAY_LEFT, false);
         }
      }
   }
}

//| VÃ‰RIFICATION ET EXÃ‰CUTION IMMÃ‰DIATE DU DERIV ARROW               |
void CheckAndExecuteDerivArrowTrade()
{
   // DEBUG: Log pour voir si la fonction est appelÃ©e
   static datetime lastLog = 0;
   if(TimeCurrent() - lastLog >= 10) // Log toutes les 10 secondes maximum
   {
      Print("ðŸ” DEBUG - CheckAndExecuteDerivArrowTrade appelÃ©e pour: ", _Symbol, " | Time: ", TimeToString(TimeCurrent(), TIME_SECONDS));
      lastLog = TimeCurrent();
   }
   
   // RÃˆGLE FONDAMENTALE: Boom/Crash + Volatility (avec conditions)
   ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(_Symbol);
   string catStr = "";
   switch(cat)
   {
      case SYM_BOOM_CRASH: catStr = "BOOM_CRASH"; break;
      case SYM_VOLATILITY: catStr = "VOLATILITY"; break;
      case SYM_FOREX: catStr = "FOREX"; break;
      default: catStr = "UNKNOWN"; break;
   }
   
   // Autoriser Boom/Crash ET Volatility ET FOREX (XAUUSD et autres commoditÃ©s)
   bool isBoomCrash = (cat == SYM_BOOM_CRASH);
   bool isVolatility = (cat == SYM_VOLATILITY);
   bool isForex = (cat == SYM_FOREX);

   if(!isBoomCrash && !isVolatility && !isForex)
   {
      return; // Ignorer les autres symboles
   }

    if(UseGOMVerdictFilter && (!g_smcGomConnected || g_smcGomVerdictNum == 0))
       return;

   // Antiâ€‘duplication SPIKE uniquement : autoriser les autres stratÃ©gies sur le mÃªme symbole,
   // mais Ã©viter plusieurs trades de type "SPIKE TRADE" en parallÃ¨le.
   if(HasOpenSpikeTradeForSymbol(_Symbol))
   {
      Print("ðŸš« SPIKE TRADE BLOQUÃ‰ - Une position SPIKE TRADE est dÃ©jÃ  ouverte sur ", _Symbol, " (pas de doublon)");
      return;
   }
   
   // Confirmer le type de symbole
   Print("âœ… DEBUG - Symbole validÃ©: ", _Symbol, " = ", catStr);
   
   // VALIDATION IA: BLOQUER TOUS LES TRADES SI IA EST EN HOLD
   if(UseAIServer && (g_lastAIAction == "HOLD" || g_lastAIAction == "hold"))
   {
      Print("ðŸš« TRADE BLOQUÃ‰ - IA en HOLD sur ", _Symbol);
      return;
   }
   
   // NOUVEAU: DÃ‰TECTION DES FLÃˆCHES DERIV ARROW EXISTANTES
   string arrowDirection = "";
   bool hasDerivArrow = GetDerivArrowDirection(arrowDirection);
   
   if(hasDerivArrow)
   {
      Print("ðŸŽ¯ FLÃˆCHE DERIV ARROW DÃ‰TECTÃ‰E - Direction: ", arrowDirection, " sur ", _Symbol);
      
      // Validation stricte: Boom = BUY uniquement, Crash = SELL uniquement
      bool isBoom = IsBoomLikeSymbol(_Symbol);
      bool isCrash = IsCrashLikeSymbol(_Symbol);
      
    if(isBoom && arrowDirection == "BUY")
       {
          Print("âœ… FLÃˆCHE VERTE + BOOM = COMPATIBLE - ExÃ©cution BUY autorisÃ©e");
          ExecuteDerivArrowTrade("BUY");
          return;
       }
       else if(isCrash && arrowDirection == "SELL")
       {
          Print("âœ… FLÃˆCHE ROUGE + CRASH = COMPATIBLE - ExÃ©cution SELL autorisÃ©e");
          ExecuteDerivArrowTrade("SELL");
          return;
       }
       else if(isVolatility)
       {
          // Volatility: les flÃ¨ches sont des SIGNAUX, pas des rÃ¨gles directionnelles strictes
          // Continuer vers la logique Volatility spÃ©cialisÃ©e ci-dessous
          Print("â„¹ï¸ FLÃˆCHE DERIV ARROW sur Volatility - Direction suggÃ©rÃ©e: ", arrowDirection, " â†’ passer aux gates techniques");
       }
       else
       {
          Print("ðŸš« FLÃˆCHE DERIV ARROW INCOMPATIBLE - ", arrowDirection, " sur ", _Symbol, " (rÃ¨gle Boom/Crash)");
          return;
       }
   }
   
   // RÃˆGLE STRICTE: BLOQUER TOUS LES TRADES BUY SUR BOOM SI IA = SELL
   bool isBoom = IsBoomLikeSymbol(_Symbol);
   bool isCrash = IsCrashLikeSymbol(_Symbol);
   string aiAction = g_lastAIAction;
   if(aiAction == "buy") aiAction = "BUY";
   if(aiAction == "sell") aiAction = "SELL";
   
   if(isBoom && aiAction == "SELL")
   {
      Print("ðŸš« DERIV ARROW BOOM BLOQUÃ‰ - IA = SELL (", DoubleToString(g_lastAIConfidence*100, 1), "%) | Attendre signal BUY avant de placer trade BUY");
      return;
   }
   
   if(isCrash && aiAction == "BUY")
   {
      Print("ðŸš« DERIV ARROW CRASH BLOQUÃ‰ - IA = BUY (", DoubleToString(g_lastAIConfidence*100, 1), "%) | Attendre signal SELL avant de placer trade SELL");
      return;
   }
   
   // VALIDATION IA: Confiance minimum diffÃ©rente selon le type ET la zone ICT (Premium/Discount)
   // Objectif: Ã©viter de prendre des positions avec une confiance IA faible,
   // surtout lorsque la dÃ©cision IA est CONTRAIRE Ã  la zone Premium/Discount.
   bool inDiscount = IsInDiscountZone();
   bool inPremium  = IsInPremiumZone();
   
   double requiredConfidence = 0.0;
   if(isBoomCrash)
   {
      // Sur Boom/Crash: exiger au minimum 65% (mÃªme si MinAIConfidence est plus bas)
      double baseBoomConf = MathMax(MinAIConfidence, 0.65);
      requiredConfidence = baseBoomConf;
      
      // Si l'IA est SELL en zone Discount (achat) ou BUY en zone Premium (vente),
      // augmenter encore l'exigence de confiance (trade "contre-zone").
      bool contrarianToZone = (aiAction == "SELL" && inDiscount) || (aiAction == "BUY" && inPremium);
      if(contrarianToZone)
         requiredConfidence = MathMax(requiredConfidence, 0.75);
   }
    else
    {
       // Pour Volatility: seuil identique Boom/Crash (65%) â€” les gates techniques assurent la qualitÃ©
       requiredConfidence = MathMax(MinAIConfidence, 0.65);
    }
   
   if(UseAIServer && g_lastAIConfidence < requiredConfidence)
   {
      string zoneStr = "Equilibre";
      if(inDiscount) zoneStr = "Discount";
      else if(inPremium) zoneStr = "Premium";
      
      Print("ðŸš« TRADE BLOQUÃ‰ - Confiance IA insuffisante sur ", _Symbol, " | Zone: ", zoneStr,
            " | ", DoubleToString(g_lastAIConfidence*100, 1), "% < ", DoubleToString(requiredConfidence*100, 1), "%");
      return;
   }
   
   // DÃ‰TECTION DIFFÃ‰RENCIÃ‰E: Spike requis pour Boom/Crash, signal IA fort pour Volatility
   bool spikeDetected = false;
   bool shouldTrade = false;
   
   if(isBoomCrash)
   {
      // Boom/Crash: deux modes possibles
      // - Mode "prÃ©-spike only" : entrer dÃ¨s que le prix est dans la zone SMC / prÃ©â€‘spike (avant le 1er spike)
      // - Mode "spike confirmÃ©" : attendre un spike rÃ©cent + proba ML suffisante (avec option prÃ©â€‘spike strict)
      bool preSpike = IsPreSpikePattern();
      spikeDetected = DetectRecentSpike();
      
      // Filtre supplÃ©mentaire basÃ© sur la probabilitÃ© ML de spike (si activÃ©)
      double spikeProbML = g_lastSpikeProbability;
      bool probaOk = true;
      if(UseSpikeMLFilter)
      {
         // Toujours calculer/rafraÃ®chir une probabilitÃ© locale (Ã©viter le cas "0%/N/A" qui court-circuite le filtre)
         if(g_lastSpikeUpdate == 0 || (TimeCurrent() - g_lastSpikeUpdate) > 300)
            spikeProbML = CalculateSpikeProbability();
         probaOk = (spikeProbML >= SpikeML_MinProbability);
      }
      
      if(SpikeUsePreSpikeOnlyForBoomCrash)
      {
         // Entrer AVANT le premier spike: pattern prÃ©â€‘spike + proba ML OK
         shouldTrade = (preSpike && probaOk);
      }
      else
      {
         // Mode par dÃ©faut: spike rÃ©cent + proba ML OK, avec option prÃ©â€‘spike strict
         shouldTrade = (spikeDetected && probaOk && (!SpikeRequirePreSpikePattern || preSpike));
      }
      
// Bypass: signal IA trÃ¨s fort (â‰¥85%) â†’ autoriser l'entrÃ©e pour capter les spikes en escalier
       // mÃªme si preSpike/spike rÃ©cent/proba ML ne sont pas remplis (Ã©vite de rater une forte tendance)
       // Exige un alignement de tendance M5/H1 pour Ã©viter les entrÃ©es contre-tendance
       if(!shouldTrade && g_lastAIConfidence >= 0.85)
       {
          int bypassDirSign = (aiAction == "BUY") ? 1 : -1;
          bool trendAligned = SMC_M5H1PreciseAligned(bypassDirSign) || SMC_M5EMATrendAligned(bypassDirSign);
          if(((isBoom && aiAction == "BUY") || (isCrash && aiAction == "SELL")) && trendAligned)
          {
             shouldTrade = true;
             Print("âœ… Boom/Crash - EntrÃ©e autorisÃ©e par confiance IA forte (", DoubleToString(g_lastAIConfidence*100, 1), "%) + alignement tendance - capture spikes/tendance");
          }
       }
      // Rebond canal: Boom â†’ BUY quand prix touche low_chan; Crash â†’ SELL quand prix touche upper chan
      if(!shouldTrade && isBoom && aiAction == "BUY" && PriceTouchesLowerChannel())
      {
         shouldTrade = true;
         Print("âœ… Boom - EntrÃ©e autorisÃ©e (prix touche canal bas â†’ rebond haussier attendu)");
      }
      if(!shouldTrade && isCrash && aiAction == "SELL" && PriceTouchesUpperChannel())
      {
         shouldTrade = true;
         Print("âœ… Crash - EntrÃ©e autorisÃ©e (prix touche canal haut â†’ rebond baissier attendu)");
      }
      // SPIKE CHAIN DETECTOR: entrÃ©e prÃ©coce dÃ¨s le dÃ©but d'une chaÃ®ne (2e bougie forte confirmÃ©e),
      // sans attendre le spike classique - uniquement si la direction est compatible Boom(BUY)/Crash(SELL)
      // ET si les indicateurs classiques sont alignÃ©s (confluence supplÃ©mentaire car entrÃ©e plus risquÃ©e)
      g_lastSpikeEntryWasEarly = false;
      if(!shouldTrade)
      {
         string chainDir = "";
         if(SMC_IsSpikeChainEarlyEntry(chainDir))
         {
             bool chainDirCompatible = (isBoom && chainDir == "BUY") || (isCrash && chainDir == "SELL");
             // FIX v1.29: Bypass indicateurs classiques si GOM PERFECT (pour capturer sÃ©ries de spikes)
             bool isGomPerfect = (MathAbs(g_smcGomVerdictNum) >= 2);
             if(isGomPerfect)
             {
                // GOM PERFECT: autoriser l'entrÃ©e sans vÃ©rifier les indicateurs classiques
                if(chainDirCompatible && chainDir == aiAction)
                {
                   shouldTrade = true;
                   g_lastSpikeEntryWasEarly = true;
                   Print("ðŸŽ¯ SPIKE CHAIN - EntrÃ©e PRÃ‰COCE autorisÃ©e (GOM PERFECT, chaÃ®ne ", chainDir,
                         " active, ", g_spikeChainStrongBars, " bougies fortes) sur ", _Symbol);
                }
             }
             else
             {
                // Sinon, vÃ©rifier l'alignement des indicateurs classiques
                string chainClassicSummary;
                bool classicOk = IsClassicIndicatorsAligned(chainDir, chainClassicSummary);
                if(chainDirCompatible && chainDir == aiAction && classicOk)
               {
                  shouldTrade = true;
                  g_lastSpikeEntryWasEarly = true;
                  Print("ðŸŽ¯ SPIKE CHAIN - EntrÃ©e PRÃ‰COCE autorisÃ©e (chaÃ®ne ", chainDir,
                        " active, ", g_spikeChainStrongBars, " bougies fortes, indicateurs classiques alignÃ©s) sur ", _Symbol);
               }
               else if(chainDirCompatible && chainDir == aiAction && !classicOk)
               {
                  Print("ðŸš« SPIKE CHAIN - EntrÃ©e prÃ©coce refusÃ©e (indicateurs classiques non alignÃ©s, confluence insuffisante) sur ", _Symbol);
               }
             }
         }
      }
      // Spike/vol: GOM GOOD/PERFECT + tendance M1+M5 alignÃ©e (mÃªme gate que FinalOpenGate)
      if(shouldTrade && SMC_IsM1M5GomAlignSymbol(_Symbol))
      {
         int gomDirSign = (isBoom ? 1 : (isCrash ? -1 : ((g_smcGomVerdictNum > 0) ? 1 : -1)));
         string alignReason = "";
         if(gomDirSign == 0 || !SMCGP_IsGoodPerfect(g_smcGomVerdictNum))
         {
            Print("âŒ SPIKE/VOL - BloquÃ©: verdict GOM insuffisant (vn=", g_smcGomVerdictNum, ")");
            shouldTrade = false;
         }
         else if(SMCGP_CorrectionBlocksEntry(true))
         {
            Print("âŒ SPIKE/VOL - BloquÃ© en correction: ", SMCGP_CorrectionBlockReason(true));
            shouldTrade = false;
         }
         else if(!SMC_M1M5GomAlignGateOK(_Symbol, gomDirSign, alignReason))
         {
            Print("âŒ SPIKE/VOL - BloquÃ© (M1+M5 / GOM) : ", alignReason);
            shouldTrade = false;
         }
         else
         {
            string m1DirLog = (StringLen(g_smcTfM1DirLive) > 0) ? g_smcTfM1DirLive : g_smcTfM1Dir;
            Print("âœ… SPIKE/VOL - GOM GOOD/PERFECT et M1+M5 alignÃ©s (M1=",
                  m1DirLog, " M5=", g_smcTfM5Dir, " GOM=", g_smcGomVerdict, ")");
         }
      }
      // AprÃ¨s une perte sur ce symbole: exiger conditions meilleures + spike imminant pour Ã©viter 2e perte consÃ©cutive
      if(shouldTrade && !AllowReentryAfterRecentLoss(_Symbol,
                                                     (isBoom ? "BUY" : "SELL"),
                                                     spikeDetected && (preSpike || spikeProbML >= 0.75)))
         shouldTrade = false;
      
      Print("ðŸ” DEBUG - Boom/Crash SNIPER - PreSpike: ", preSpike ? "OUI" : "NON",
            " | Spike rÃ©cent: ", spikeDetected ? "OUI" : "NON",
            " | Proba ML spike: ",
            (spikeProbML > 0.0 ? DoubleToString(spikeProbML*100.0, 1) + "%" : "N/A"),
            " (min ",
            (UseSpikeMLFilter ? DoubleToString(SpikeML_MinProbability*100.0, 1) + "%" : "N/A"),
            ")",
            " | Mode prÃ©-spike only: ", SpikeUsePreSpikeOnlyForBoomCrash ? "OUI" : "NON",
            " | Mode prÃ©-spike strict: ", SpikeRequirePreSpikePattern ? "OUI" : "NON",
            " | AutorisÃ©: ", shouldTrade ? "OUI" : "NON");
   }
      else if(isVolatility)
     {
        // Volatility: stratÃ©gie MULTI-CONFLUENCE technique (pas de spike requis)
        spikeDetected = false;
        
        // Direction IA locale (iaDirection n'est dÃ©clarÃ© que plus bas)
        string volDir = "";
        if(g_lastAIAction == "BUY" || g_lastAIAction == "buy") volDir = "BUY";
        else if(g_lastAIAction == "SELL" || g_lastAIAction == "sell") volDir = "SELL";
        if(volDir == "") { Print("âŒ Volatility - Aucun signal IA clair (", g_lastAIAction, ")"); }
        else
        {
           MqlRates volRates[];
           ArraySetAsSeries(volRates, true);
           if(CopyRates(_Symbol, PERIOD_M1, 0, 60, volRates) < 30)
           {
              Print("âŒ Volatility - DonnÃ©es M1 insuffisantes");
           }
           else
           {
              int volConfirmations = 0;
              string volDetails = "";
              double volPrice = volRates[0].close;
              
              // Conf 1: EMA trend alignment (EMA9 > EMA21 = bullish)
              double bufF[], bufS[];
              ArraySetAsSeries(bufF, true);
              ArraySetAsSeries(bufS, true);
              double volEmaFast = 0, volEmaSlow = 0;
              if(emaFastM1 != INVALID_HANDLE && CopyBuffer(emaFastM1, 0, 0, 1, bufF) > 0)
                 volEmaFast = bufF[0];
              if(emaSlowM1 != INVALID_HANDLE && CopyBuffer(emaSlowM1, 0, 0, 1, bufS) > 0)
                 volEmaSlow = bufS[0];
              if(volEmaFast > 0 && volEmaSlow > 0)
              {
                 if((volDir == "BUY" && volEmaFast > volEmaSlow) ||
                    (volDir == "SELL" && volEmaFast < volEmaSlow))
                 {
                    volConfirmations++;
                    volDetails += "[EMA OK] ";
                 }
              }
              
              // Conf 2: RSI non-contre-tendance (< 70 pour BUY, > 30 pour SELL)
              double volRSI = ComputeRSI(volRates, 14, 0);
              if((volDir == "BUY" && volRSI < 70.0 && volRSI > 30.0) ||
                 (volDir == "SELL" && volRSI > 30.0 && volRSI < 70.0))
              {
                 volConfirmations++;
                 volDetails += StringFormat("[RSI %.0f OK] ", volRSI);
              }
              else if((volDir == "BUY" && volRSI < 40.0) ||
                      (volDir == "SELL" && volRSI > 60.0))
              {
                 volConfirmations += 2;
                 volDetails += StringFormat("[RSI %.0f FAVORABLE] ", volRSI);
              }
              
              // Conf 3: MACD alignment
              double volMACD = ComputeMACD(volRates, 12, 26, 9, 0);
              if((volDir == "BUY" && volMACD > 0) ||
                 (volDir == "SELL" && volMACD < 0))
              {
                 volConfirmations++;
                 volDetails += "[MACD OK] ";
              }
              
              // Conf 4: Bollinger Band position (prix dans la bonne moitiÃ©)
              if(UseBollingerFilter)
              {
                 int volBB = iBands(_Symbol, PERIOD_M1, 20, 2.0, 0, PRICE_CLOSE);
                 if(volBB != INVALID_HANDLE)
                 {
                    double bbUp[], bbMid[], bbLow[];
                    ArraySetAsSeries(bbUp, true);
                    ArraySetAsSeries(bbMid, true);
                    ArraySetAsSeries(bbLow, true);
                    if(CopyBuffer(volBB, 0, 0, 1, bbUp) == 1 &&
                       CopyBuffer(volBB, 1, 0, 1, bbMid) == 1 &&
                       CopyBuffer(volBB, 2, 0, 1, bbLow) == 1)
                    {
                       if((volDir == "BUY" && volPrice < bbMid[0]) ||
                          (volDir == "SELL" && volPrice > bbMid[0]))
                       {
                          volConfirmations++;
                          volDetails += "[BB OK] ";
                       }
                    }
                    IndicatorRelease(volBB);
                 }
              }
              
              // Conf 5: Momentum â€” 3 derniÃ¨res bougies dans la bonne direction
              int momentumCount = 0;
              for(int v = 1; v <= 3 && v < ArraySize(volRates); v++)
              {
                 if(volDir == "BUY" && volRates[v].close > volRates[v].open) momentumCount++;
                 if(volDir == "SELL" && volRates[v].close < volRates[v].open) momentumCount++;
              }
              if(momentumCount >= 2)
              {
                 volConfirmations++;
                 volDetails += StringFormat("[MOM %d/3] ", momentumCount);
              }
              
              // CritÃ¨re de validation: au moins 2 confirmations sur 5
              int minVolConfirmations = 2;
              if(volConfirmations >= minVolConfirmations)
              {
                 shouldTrade = true;
                 Print("âœ… Volatility - Trade autorisÃ© (", volConfirmations, "/5 confirmations: ", volDetails,
                       " | IA: ", DoubleToString(g_lastAIConfidence*100, 1), "%)");
              }
              else
              {
                 Print("âŒ Volatility - Insuffisant (", volConfirmations, "/5 < ", minVolConfirmations,
                       " min) | ", volDetails);
              }
           }
        }
    }
   
   // --- Chaine de Spikes H1/M5 (Kola): gate obligatoire optionnel pour Boom/Crash/Painx/Gainx ---
   g_sch1_tpHint = 0.0;
   if(shouldTrade && isBoomCrash && UseSCH1_Strategy && SCH1_RequireForBoomCrash)
   {
      string sch1Dir = isBoom ? "BUY" : (isCrash ? "SELL" : "");
      if(sch1Dir != "")
      {
         string sch1Reason;
         double sch1Tp = 0.0;
         bool sch1Ok = SCH1_StrategyGate(sch1Dir, sch1Reason, sch1Tp);
         if(!sch1Ok)
         {
            Print("ðŸš« CHAINE DE SPIKES H1/M5 - Gate obligatoire non validÃ© (", sch1Reason, ") sur ", _Symbol);
            shouldTrade = false;
         }
         else
         {
            g_sch1_tpHint = sch1Tp;
            Print("âœ… CHAINE DE SPIKES H1/M5 - Gate validÃ© | ", sch1Reason,
                  (sch1Tp > 0 ? " | TP extension S/R=" + DoubleToString(sch1Tp, _Digits) : ""));
         }
      }
   }

   if(!shouldTrade)
   {
      if(isBoomCrash)
         Print("âŒ Conditions spike non remplies - trade Boom/Crash ignorÃ© (Spike rÃ©cent requis",
               SpikeRequirePreSpikePattern ? " + PrÃ©-spike" : "",
               UseSpikeMLFilter ? " + Filtre proba" : "",
               ")");
      else
         Print("âŒ Conditions non remplies - trade Volatility ignorÃ©");
      return;
   }
   
   // DÃ‰TERMINER LA DIRECTION basÃ©e sur le signal IA et le type de symbole
   string direction = "";
   string iaDirection = "";
   
   // RÃ©cupÃ©rer la direction de l'IA
   if(g_lastAIAction == "BUY" || g_lastAIAction == "buy")
      iaDirection = "BUY";
   else if(g_lastAIAction == "SELL" || g_lastAIAction == "sell")
      iaDirection = "SELL";
   else
   {
      Print("âŒ Aucun signal IA clair (", g_lastAIAction, ") - trade ignorÃ©");
      return;
   }
   
    // VÃ©rifier la compatibilitÃ© entre le signal IA et le type de symbole
    if(isBoomCrash)
    {
       // RÃ¨gles Boom/Crash/Painx/Gainx: directions spÃ©cifiques
       if(IsBoomLikeSymbol(_Symbol))
       {
          if(iaDirection == "BUY")
          {
             direction = "BUY"; // Boom/Gainx + IA BUY = OK
          }
          else
          {
             Print("âŒ CONFLIT: IA dit ", iaDirection, " mais Boom/Gainx n'accepte que BUY - trade ignorÃ©");
             return;
          }
       }
       else if(IsCrashLikeSymbol(_Symbol))
       {
          if(iaDirection == "SELL")
          {
             direction = "SELL"; // Crash/Painx + IA SELL = OK
          }
          else
          {
             Print("âŒ CONFLIT: IA dit ", iaDirection, " mais Crash/Painx n'accepte que SELL - trade ignorÃ©");
             return;
          }
      }
   }
   else if(isVolatility)
   {
      // Volatility: BUY et SELL autorisÃ©s (suivre l'IA)
      direction = iaDirection; // Volatility suit directement l'IA
      Print("âœ… Volatility - Direction IA acceptÃ©e: ", direction, " sur ", _Symbol);
   }
   
   Print("âœ… Signal IA validÃ©: ", iaDirection, " compatible avec ", _Symbol, " â†’ Direction: ", direction);

   // VÃ©rifier l'alignement avec les indicateurs techniques classiques (TradingView-like)
   string classicSummary;
   bool classicOk = IsClassicIndicatorsAligned(direction, classicSummary);

   Print("ðŸ” DEBUG - Indicateurs classiques (", direction, ") => ", classicOk ? "ALIGNÃ‰S" : "NON ALIGNÃ‰S",
         " | ", classicSummary);

   if(!classicOk)
   {
      if(UseClassicIndicatorsFilter)
      {
         Print("ðŸš« TRADE SPIKE BLOQUÃ‰ - Indicateurs classiques insuffisants (min ",
               ClassicMinConfirmations, " confirmations) sur ", _Symbol);
         return;
      }
   }

   // Protection capital: en zone d'achat au bord infÃ©rieur â†’ SELL seulement si confiance IA >= 85%
   if(direction == "SELL" && IsAtDiscountLowerEdge() && g_lastAIConfidence < 0.85)
   {
      Print("ðŸš« TRADE BLOQUÃ‰ - Zone Discount au bord infÃ©rieur: SELL autorisÃ© seulement si confiance IA â‰¥ 85% (actuel: ",
            DoubleToString(g_lastAIConfidence*100, 1), "%)");
      return;
   }
   // Protection capital: en zone premium au bord supÃ©rieur (Boom) â†’ BUY seulement si confiance IA >= 85%
   if(direction == "BUY" && isBoom && IsAtPremiumUpperEdge() && g_lastAIConfidence < 0.85)
   {
      Print("ðŸš« TRADE BLOQUÃ‰ - Zone Premium au bord supÃ©rieur (Boom): BUY autorisÃ© seulement si confiance IA â‰¥ 85% (actuel: ",
            DoubleToString(g_lastAIConfidence*100, 1), "%)");
      return;
   }

   // RÃ©entrÃ©e aprÃ¨s perte sur ce symbole (hors Boom/Crash): exiger conditions exceptionnelles
   if(!AllowReentryAfterRecentLoss(_Symbol, direction, spikeDetected))
      return;

   if(isBoomCrash)
   {
      int dFire = (direction == "BUY") ? 1 : -1;
      if(!SMCGP_SpikeFireAllowed(_Symbol, dFire))
      {
         Print("ðŸš« SPIKE FLECHE BLOQUÃ‰ â€” GOM GOOD/PERFECT + M1/M5/M15 requis | ",
               _Symbol, " ", direction, " vn=", g_smcGomVerdictNum);
         return;
      }
   }

   Print("ðŸš€ SPIKE DÃ‰TECTÃ‰ - Direction: ", direction, " | Symbole: ", _Symbol);

   // --- ONNX Spike Chain Directional Filter ---
   if(UseOnnxSpikeFilter && g_spikePredictorReady && (isBoom || isCrash))
   {
      // Extraire les features du dernier spike depuis les barres rÃ©centes
      MqlRates spikeRates[];
      ArraySetAsSeries(spikeRates, true);
      if(CopyRates(_Symbol, PERIOD_M1, 0, 10, spikeRates) >= 10)
      {
         // Trouver la derniÃ¨re bougie "forte" (spike) parmi les 5 derniÃ¨res bougies clÃ´turÃ©es
         double atrBuf[];
         ArraySetAsSeries(atrBuf, true);
         double atrVal = 0;
         if(atrHandle != INVALID_HANDLE && CopyBuffer(atrHandle, 0, 0, 1, atrBuf) >= 1)
            atrVal = atrBuf[0];

         int spikeIdx = -1;
         for(int i = 1; i <= 5 && i < ArraySize(spikeRates); i++)
         {
            double bodyI = MathAbs(spikeRates[i].close - spikeRates[i].open);
            if(atrVal > 0 && bodyI >= atrVal * SpikeChainBodyATRMult)
            { spikeIdx = i; break; }
         }

         if(spikeIdx > 0)
         {
            double body     = spikeRates[spikeIdx].close - spikeRates[spikeIdx].open;
            double bodyAbs  = MathAbs(body);
            bool   spikeUp  = (body > 0);

            // Amplitude en pips
            double point    = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
            double ampPips  = (point > 0) ? bodyAbs / point : bodyAbs * 100;
            // Amplitude en ATR
            double ampAtr   = (atrVal > 0) ? bodyAbs / atrVal : 0;
            // Velocity proxy = amplitude / nb_secondes depuis la bougie prÃ©cÃ©dente
            double dtSec    = (spikeIdx > 0 && spikeIdx < ArraySize(spikeRates))
                              ? (double)(spikeRates[spikeIdx - 1].time - spikeRates[spikeIdx].time)
                              : 60.0;
            if(dtSec <= 0) dtSec = 60.0;
            double velProxy = ampPips / dtSec;

            // Minutes depuis le spike prÃ©cÃ©dent
            double minSincePrev = 0;
            if(g_lastSpikeDetectTime > 0)
               minSincePrev = (double)(spikeRates[spikeIdx].time - g_lastSpikeDetectTime) / 60.0;

            // Construire l'entrÃ©e ONNX
            SpikeChainInput sci;
            sci.dirIsUp              = spikeUp;
            sci.amplitudePips        = ampPips;
            sci.amplitudeAtr         = ampAtr;
            sci.velocityProxy        = velProxy;
            sci.minutesSincePrevSpike = minSincePrev;
            MqlDateTime spikeTm;
            TimeToStruct(spikeRates[spikeIdx].time, spikeTm);
            sci.hour                 = spikeTm.hour;
            sci.minute               = spikeTm.min;

            double pUp = g_spikePredictor.PredictNextSpikeUpProbability(sci);

            // Mettre Ã  jour la mÃ©moire des spikes
            g_prevSpikeDetectTime      = g_lastSpikeDetectTime;
            g_lastSpikeDetectTime      = spikeRates[spikeIdx].time;
            g_lastSpikeAmplitudePips   = ampPips;
            g_lastSpikeAmplitudeAtr    = ampAtr;
            g_lastSpikeVelocityProxy   = velProxy;
            g_lastSpikeWasUp           = spikeUp;

            if(pUp >= 0)
            {
               Print("ðŸ§  ONNX SPIKE PREDICT - P(up)=", DoubleToString(pUp, 3),
                     " | spikeDir=", spikeUp ? "UP" : "DOWN",
                     " | ampAtr=", DoubleToString(ampAtr, 2),
                     " | vel=", DoubleToString(velProxy, 4),
                     " | prevMin=", DoubleToString(minSincePrev, 1));

               // Filtre directionnel: refuser BUY si P(up) trop bas, refuser SELL si P(up) trop haut
               if(direction == "BUY" && pUp < OnnxSellThreshold)
               {
                  Print("âŒ ONNX BLOQUÃ‰ BUY - P(up)=", DoubleToString(pUp, 3),
                        " < seuil=", DoubleToString(OnnxSellThreshold, 2),
                        " â†’ probabilitÃ© de contre-spike trop Ã©levÃ©e");
                  return;
               }
               if(direction == "SELL" && pUp > OnnxBuyThreshold)
               {
                  Print("âŒ ONNX BLOQUÃ‰ SELL - P(up)=", DoubleToString(pUp, 3),
                        " > seuil=", DoubleToString(OnnxBuyThreshold, 2),
                        " â†’ probabilitÃ© de spike haussier trop Ã©levÃ©e");
                  return;
               }
               Print("âœ… ONNX FILTRE PASSÃ‰ - P(up)=", DoubleToString(pUp, 3), " compatible direction=", direction);
            }
            else
               Print("âš ï¸ ONNX prÃ©diction Ã©chouÃ©e (err) â€” filtre ignorÃ©");
         }
         else
            Print("â„¹ï¸ ONNX - Pas de bougie forte trouvÃ©e dans les 5 derniÃ¨res â€” filtre ignorÃ©");
      }
    }

    // â•â•â• CHAIN PREDICTOR â€” Score d'imminence + boost corrÃ©lation croisÃ©e â•â•â•
    if(UseChainPredictor && (IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol) ||
        SMC_IsWeltradeSynthSymbol(_Symbol)))
   {
      double chainScore = ChainPred_GetImminence();
      double crossBoost = CrossCorr_GetImminenceBoost();
      double totalScore = MathMin(100.0, chainScore + crossBoost);

      Print("ðŸ“Š CHAIN SCORE: ", DoubleToString(totalScore, 1),
            " (chain=", DoubleToString(chainScore, 1),
            " + cross=", DoubleToString(crossBoost, 1),
            ") | ISI=", DoubleToString(ChainPred_GetISICompression(), 2),
            " | Chain len=", ChainPred_GetChainLength(),
            " | Regime=", ChainPred_IsPreChain() ? "PRE_CHAIN" : (ChainPred_IsUncertainOrBetter() ? "UNCERTAIN" : "NORMAL"));

      // Signal croisÃ© actif â†’ log
      if(CrossCorr_IsSignalActive())
      {
         Print("ðŸ”€ CROSS-CORR: spike inverse de ", CrossCorr_GetTriggerSymbol(),
               " il y a ", CrossCorr_GetDelayBars(), " bars â†’ boost ",
               DoubleToString(crossBoost, 1), " pts sur ", _Symbol);
      }
   }

    // EXÃ‰CUTION DU TRADE â€” Volatility utilise un exÃ©cuteur dÃ©diÃ© (market order + ATR SL/TP)
    if(isVolatility)
       ExecuteVolatilityTrade(direction);
    else
       ExecuteSpikeTrade(direction);
}

//| DÃ‰TECTER SI UNE FLÃˆCHE DERIV ARROW EST PRÃ‰SENTE SUR LE GRAPHIQUE |
bool IsDerivArrowPresent()
{
   // Chercher les objets flÃ¨che sur le graphique avec des noms typiques
   for(int i = ObjectsTotal(0, -1, OBJ_ARROW) - 1; i >= 0; i--)
   {
      string objName = ObjectName(0, i, -1, OBJ_ARROW);
      
      // VÃ©rifier si c'est une flÃ¨che Deriv Arrow (noms communs)
      if(StringFind(objName, "DERIV") >= 0 || StringFind(objName, "Deriv") >= 0 || 
         StringFind(objName, "ARROW") >= 0 || StringFind(objName, "Arrow") >= 0 ||
         StringFind(objName, "SIGNAL") >= 0 || StringFind(objName, "Signal") >= 0)
      {
         // VÃ©rifier que l'objet est visible et sur la bougie rÃ©cente
         datetime objTime = (datetime)ObjectGetInteger(0, objName, OBJPROP_TIME, 0);
         datetime currentTime = TimeCurrent();
         
         // La flÃ¨che doit Ãªtre sur les 5 derniÃ¨res bougies maximum
         if(currentTime - objTime <= PeriodSeconds() * 5)
         {
            return true;
         }
      }
   }
   
   return false;
}

// Exige la prÃ©sence rÃ©cente de la flÃ¨che SMC_DERIV_ARROW_<symbol> avant d'exÃ©cuter un ordre au marchÃ©.
// Direction: "BUY" ou "SELL" (insensible Ã  la casse).
bool HasRecentSMCDerivArrowForDirection(string direction)
{
   if(!RequireSMCDerivArrowForMarketOrders) return true;

   string dir = direction;
   StringToUpper(dir);
   if(dir != "BUY" && dir != "SELL") return false;

   string arrowName = "SMC_DERIV_ARROW_" + _Symbol;
   if(ObjectFind(0, arrowName) < 0) return false;

   // VÃ©rifier que la flÃ¨che est rÃ©cente (N bougies max sur timeframe courant)
   datetime arrowTime = (datetime)ObjectGetInteger(0, arrowName, OBJPROP_TIME, 0);
   int maxAgeBars = MathMax(1, SMCDerivArrowMaxAgeBars);
   int maxAgeSec = PeriodSeconds(PERIOD_CURRENT) * maxAgeBars;
   if(maxAgeSec <= 0) maxAgeSec = 60 * maxAgeBars;
   if(TimeCurrent() - arrowTime > maxAgeSec) return false;

   // VÃ©rifier direction via le code de flÃ¨che
   int arrowCode = (int)ObjectGetInteger(0, arrowName, OBJPROP_ARROWCODE);
   bool isBuyArrow = (arrowCode == 233);
   bool isSellArrow = (arrowCode == 234);
   if(dir == "BUY" && !isBuyArrow) return false;
   if(dir == "SELL" && !isSellArrow) return false;

   return true;
}

//| VARIABLES GLOBALES POUR ORDRES LIMIT POST-HOLD |
static bool g_postHoldLimitOrderPending = false;
static datetime g_lastHoldCloseTime = 0;

//| PLACER ORDRE LIMIT POST-HOLD APRÃˆS PERTE 2,0$ |
void PlacePostHoldLimitOrder(string closedSymbol, ENUM_POSITION_TYPE closedType, double closedProfit)
{
   // Bloquer si GOM dÃ©connectÃ© ou en WAIT (vn==0) â€” toujours, quel que soit le rÃ©glage
   if(!g_smcGomConnected || g_smcGomVerdictNum == 0)
   {
      Print("[GOM-WAIT] PlacePostHoldLimitOrder bloquÃ© â€” GOM dÃ©connectÃ© ou verdict=WAIT");
      return;
   }
   if(UseGOMVerdictFilter && MathAbs(g_smcGomVerdictNum) < MinGOMVerdictNumAbs)
   {
      Print("[GOM-SIMPLE] PlacePostHoldLimitOrder bloquÃ© â€” verdict pas GOOD/PERFECT (vn=", g_smcGomVerdictNum, ")");
      return;
   }

   Print("ðŸ” DEBUG POST-HOLD - DÃ©but fonction");
   Print("   ðŸ“Š Symbole: ", closedSymbol, " | Type: ", (closedType == POSITION_TYPE_BUY ? "BUY" : "SELL"), " | Profit: ", DoubleToString(closedProfit, 2), "$");

   // VÃ©rifier si la fermeture Ã©tait bien due Ã  HOLD avec perte â‰¥ 2,0$
   if(closedProfit > -2.0)
   {
      Print("ðŸ“Š POST-HOLD - Perte insuffisante: ", DoubleToString(closedProfit, 2), "$ > -2.00$");
      return;
   }
   Print("âœ… POST-HOLD - Perte suffisante: ", DoubleToString(closedProfit, 2), "$ â‰¤ -2.00$");
   
   // VÃ©rifier si c'est bien Boom/Crash
    bool isBoom = IsBoomLikeSymbol(closedSymbol);
    bool isCrash = IsCrashLikeSymbol(closedSymbol);
   
   if(!isBoom && !isCrash)
   {
      Print("ðŸ“Š POST-HOLD - Symbole non Boom/Crash: ", closedSymbol);
      return;
   }
   Print("âœ… POST-HOLD - Symbole valide - Boom: ", isBoom, " | Crash: ", isCrash);
   
   // VÃ©rifier si un ordre limit est dÃ©jÃ  en attente
   if(g_postHoldLimitOrderPending)
   {
      Print("ðŸ“Š POST-HOLD - Ordre limit dÃ©jÃ  en attente, annulation");
      return;
   }
   Print("âœ… POST-HOLD - Aucun ordre limit en attente");
   
   // DÃ©tecter si nous Ã©tions en zone Premium (vente) ou Discount (achat)
   bool inDiscount = IsInDiscountZone();
   bool inPremium = IsInPremiumZone();
   
   Print("ðŸ” POST-HOLD - Zones SMC - Discount: ", inDiscount, " | Premium: ", inPremium);
   
   // Conditions dÃ©taillÃ©es pour ordre limit
   bool shouldPlaceLimit = false;
   ENUM_ORDER_TYPE limitType = WRONG_VALUE;
   double limitPrice = 0.0;
   string limitReason = "";
   
   if(isBoom && inDiscount && closedType == POSITION_TYPE_BUY)
   {
      // Boom en zone Discount avec position BUY fermÃ©e â†’ ordre BUY limit au support
      limitType = ORDER_TYPE_BUY_LIMIT;
      limitPrice = GetSupportLevel(20); // Support sur 20 barres
      limitReason = "Boom Discount - Support 20 bars (post-HOLD)";
      shouldPlaceLimit = true;
      Print("ðŸŽ¯ POST-HOLD - Condition Boom+Discount+BUY remplie");
   }
   else if(isCrash && inPremium && closedType == POSITION_TYPE_SELL)
   {
      // Crash en zone Premium avec position SELL fermÃ©e â†’ ordre SELL limit Ã  la rÃ©sistance
      limitType = ORDER_TYPE_SELL_LIMIT;
      limitPrice = GetResistanceLevel(20); // RÃ©sistance sur 20 barres
      limitReason = "Crash Premium - Resistance 20 bars (post-HOLD)";
      shouldPlaceLimit = true;
      Print("ðŸŽ¯ POST-HOLD - Condition Crash+Premium+SELL remplie");
   }
   
   if(!shouldPlaceLimit)
   {
      Print("ðŸš« POST-HOLD - Conditions non remplies pour ordre limit");
      Print("   ðŸ“ Symbole: ", closedSymbol, " | Type: ", (closedType == POSITION_TYPE_BUY ? "BUY" : "SELL"));
      Print("   ðŸ“ Zones - Discount: ", inDiscount, " | Premium: ", inPremium);
      Print("   ðŸ“ Attendu: (Boom+Discount+BUY) ou (Crash+Premium+SELL)");
      return;
   }
   
   Print("âœ… POST-HOLD - Conditions validÃ©es - Calcul niveau de prix...");
   
   // Placer l'ordre limit
   double lot = CalculateLotSize();
   if(lot <= 0.0) return; // respecter le blocage (drawdown / cap $ dynamique)
   MqlTradeRequest request = {};
   MqlTradeResult result = {};
   
   request.action = TRADE_ACTION_PENDING;
   request.symbol = closedSymbol;
   request.volume = lot;
   request.type = limitType;
   request.price = limitPrice;
   request.sl = 0;
   request.tp = 0;
   request.deviation = 10;
   request.magic = InpMagicNumber;
   request.comment = "POST-HOLD Limit - " + limitReason;
   request.type_time = ORDER_TIME_GTC; // Good till cancelled
   request.expiration = 0;
   
   Print("ðŸ” POST-HOLD - RequÃªte ordre limit prÃ©parÃ©e:");
   Print("   ðŸ“Š Type: ", (limitType == ORDER_TYPE_BUY_LIMIT ? "BUY LIMIT" : "SELL LIMIT"));
   Print("   ðŸ’° Prix: ", DoubleToString(limitPrice, _Digits), " | Lot: ", DoubleToString(lot, 2));
   Print("   ðŸ“ Raison: ", limitReason);
   
   if(!CanPlaceLimitOrder(closedSymbol, limitType)) return;
   CleanupExcessLimits(closedSymbol, 2);
   if(!SMC_FinalOpenGate(closedSymbol, limitType)) return;
   if(SafeOrderSend(request, result, request.comment))
   {
      RegisterOrderPlaced();
      SMC_GateRegisterOpened(closedSymbol, limitType == ORDER_TYPE_BUY_LIMIT);
      g_postHoldLimitOrderPending = true;
      g_lastHoldCloseTime = TimeCurrent();
      Print("âœ… POST-HOLD - Ordre limit placÃ© avec succÃ¨s");
      Print("   ðŸ“Š Symbole: ", closedSymbol, " | Type: ", (limitType == ORDER_TYPE_BUY_LIMIT ? "BUY LIMIT" : "SELL LIMIT"));
      Print("   ðŸ’° Prix: ", DoubleToString(limitPrice, _Digits), " | Lot: ", DoubleToString(lot, 2));
      Print("   ðŸ“ Raison: ", limitReason);
      Print("   ðŸŽ« Ticket: ", result.order);
   }
   else
   {
      Print("âŒ POST-HOLD - Ã‰chec placement ordre limit");
      Print("   ðŸ“Š Erreur: ", result.retcode, " - ", result.comment);
      Print("   ðŸ“Š Code erreur: ", GetLastError());
   }
}

//| OBTENIR NIVEAU DE SUPPORT (20 BARRES) |
double GetSupportLevel(int bars)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   
   if(CopyRates(_Symbol, PERIOD_M1, 0, bars + 1, rates) < bars + 1)
   {
      Print("âŒ Impossible de copier les rates pour support");
      return 0.0;
   }
   
   double support = rates[0].low;
   for(int i = 1; i <= bars; i++)
   {
      if(rates[i].low < support)
         support = rates[i].low;
   }
   
   return support;
}

//| OBTENIR NIVEAU DE RÃ‰SISTANCE (20 BARRES) |
double GetResistanceLevel(int bars)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   
   if(CopyRates(_Symbol, PERIOD_M1, 0, bars + 1, rates) < bars + 1)
   {
      Print("âŒ Impossible de copier les rates pour rÃ©sistance");
      return 0.0;
   }
   
   double resistance = rates[0].high;
   for(int i = 1; i <= bars; i++)
   {
      if(rates[i].high > resistance)
         resistance = rates[i].high;
   }
   
   return resistance;
}
static string g_lastAIActionPrevious = ""; // Action IA prÃ©cÃ©dente

//| SURVEILLER ET FERMER POSITIONS SI IA DEVIENT HOLD |
void MonitorAndClosePositionsOnHold()
{
   if(!UseAIServer) return; // Seulement si serveur IA actif

   // FIX v1.43: la transition ->HOLD n a de sens que si elle vient du serveur.
   // Un HOLD issue d un fallback local (timeout / noise) ne ferme rien.
   if(g_lastAISource != "SERVER")
   {
      static datetime s_holdMonSkipLog = 0;
      if(TimeCurrent() - s_holdMonSkipLog >= 60)
      {
         s_holdMonSkipLog = TimeCurrent();
         Print("[IA-HOLD-MON] SKIP â€” source statut IA = ", g_lastAISource, " (non-serveur)");
      }
      return;
   }
   
   // VÃ©rifier si l'IA est passÃ©e de BUY/SELL Ã  HOLD
   if(g_lastAIActionPrevious != "" && g_lastAIActionPrevious != "HOLD" && g_lastAIActionPrevious != "hold" &&
      (g_lastAIAction == "HOLD" || g_lastAIAction == "hold"))
   {
      Print("ðŸ”„ CHANGEMENT IA DÃ‰TECTÃ‰ - ", g_lastAIActionPrevious, " â†’ HOLD");
      Print("   âš ï¸ SURVEILLANCE DES POSITIONS - Attente perte â‰¥ 2.0$ avant fermeture");
      
      // Parcourir toutes les positions ouvertes
      int totalPositions = PositionsTotal();
      for(int i = totalPositions - 1; i >= 0; i--)
      {
         if(PositionGetTicket(i) > 0)
         {
            string posSymbol = PositionGetString(POSITION_SYMBOL);
            ENUM_POSITION_TYPE posType = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
            ulong posTicket = PositionGetInteger(POSITION_TICKET);
            double posProfit = PositionGetDouble(POSITION_PROFIT);
            
            // VÃ©rifier si la position correspond Ã  l'action prÃ©cÃ©dente
            bool shouldClose = false;
            if(g_lastAIActionPrevious == "BUY" && posType == POSITION_TYPE_BUY)
            {
               shouldClose = true;
               Print("   ðŸ”„ SURVEILLANCE BUY - ", posSymbol, " | Ticket: ", posTicket, " | Profit: ", DoubleToString(posProfit, 2), "$");
            }
            else if(g_lastAIActionPrevious == "SELL" && posType == POSITION_TYPE_SELL)
            {
               shouldClose = true;
               Print("   ðŸ”„ SURVEILLANCE SELL - ", posSymbol, " | Ticket: ", posTicket, " | Profit: ", DoubleToString(posProfit, 2), "$");
            }
            
            if(shouldClose)
            {
               // NOUVEAU: VÃ©rifier si perte â‰¥ 2.0$ avant de fermer
               if(posProfit <= -2.0)
               {
                  Print("   ðŸ’° SEUIL DE PERTE ATTEINT - ", DoubleToString(posProfit, 2), "$ â‰¤ -2.00$");
                  Print("   ðŸ”„ FERMETURE AUTOMATIQUE sur HOLD - Perte â‰¥ 2.0$");
                  
                  // Fermer la position
                  MqlTradeRequest request = {};
                  MqlTradeResult result = {};
                  
                  request.action = TRADE_ACTION_DEAL;
                  request.position = posTicket;
                  request.symbol = posSymbol;
                  request.volume = PositionGetDouble(POSITION_VOLUME);
                  request.type = (posType == POSITION_TYPE_BUY) ? ORDER_TYPE_SELL : ORDER_TYPE_BUY;
                  request.price = (posType == POSITION_TYPE_BUY) ? SymbolInfoDouble(posSymbol, SYMBOL_BID) : SymbolInfoDouble(posSymbol, SYMBOL_ASK);
                  request.deviation = 10;
                  request.magic = InpMagicNumber;
                  request.comment = "IA HOLD Auto-Close (Loss â‰¥ 2.0$)";
                  
                  if(SafeOrderSend(request, result, request.comment))
                  {
                     Print("âœ… POSITION FERMÃ‰E - ", posSymbol, " | Ticket: ", posTicket, " | Profit: ", DoubleToString(posProfit, 2), "$");
                     
                     // NOUVEAU: Placer ordre limit post-HOLD si perte â‰¥ 2.0$
                     PlacePostHoldLimitOrder(posSymbol, posType, posProfit);
                  }
                  else
                  {
                     Print("âŒ ERREUR FERMETURE - ", posSymbol, " | Erreur: ", result.comment);
                  }
               }
               else
               {
                  Print("   â³ SURVEILLANCE CONTINUE - Perte: ", DoubleToString(posProfit, 2), "$ > -2.00$ (seuil non atteint)");
                  Print("   ðŸ“Š Attente HOLD - Position maintenue jusqu'Ã  perte â‰¥ 2.0$");
               }
            }
         }
      }
   }
   
   // Mettre Ã  jour l'action prÃ©cÃ©dente
   g_lastAIActionPrevious = g_lastAIAction;
}
bool IsMaxPositionsReached()
{
   int totalPositions = PositionsTotal();
   
   // NOUVEAU: Protection capital faible - Si < 20$, limiter Ã  1 position seulement
   double accountEquity = AccountInfoDouble(ACCOUNT_EQUITY);
   int maxAllowedPositions = (accountEquity < 20.0) ? 1 : MaxPositionsTerminal;
   
   // Si on a dÃ©jÃ  le nombre maximum de positions autorisÃ©es, bloquer les nouveaux trades
   if(totalPositions >= maxAllowedPositions)
   {
      // Si exactement le nombre maximum, log d'information
      if(totalPositions == maxAllowedPositions)
      {
         static datetime lastLog = 0;
         if(TimeCurrent() - lastLog >= 60) // Log toutes les minutes maximum
         {
            if(accountEquity < 20.0)
            {
               Print("ðŸš¨ CAPITAL FAIBLE - Ã‰quitÃ©: ", DoubleToString(accountEquity, 2), "$ < 20.00$");
               Print("   ðŸ”’ LIMITATION Ã€ 1 POSITION SEULEMENT pour protÃ©ger le capital");
            }
            else
            {
               Print("ðŸ›¡ï¸ PROTECTION CAPITAL - ", totalPositions, "/", maxAllowedPositions, " positions atteintes (sur symboles diffÃ©rents)");
            }
            
            Print("   ðŸ“Š Positions actuelles :");
            for(int i = 0; i < totalPositions; i++)
            {
               if(PositionGetTicket(i) > 0)
               {
                  string posSymbol = PositionGetString(POSITION_SYMBOL);
                  double posProfit = PositionGetDouble(POSITION_PROFIT);
                  ENUM_POSITION_TYPE posType = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
                  ulong posTicket = PositionGetInteger(POSITION_TICKET);
                  
                  Print("   - ", posType == POSITION_TYPE_BUY ? "BUY" : "SELL", " ", posSymbol, 
                        " | Ticket: ", posTicket, " | Profit: ", DoubleToString(posProfit, 2), "$");
               }
            }
            
            if(accountEquity < 20.0)
            {
               Print("   â¸ï¸ NOUVEAUX TRADES BLOQUÃ‰S - Capital faible, 1 position max");
            }
            else
            {
               Print("   â¸ï¸ NOUVEAUX TRADES BLOQUÃ‰S jusqu'Ã  libÃ©ration d'une position");
               Print("   ðŸ’¡ RÃ¨gle: Max ", maxAllowedPositions, " positions sur symboles diffÃ©rents autorisÃ©es");
            }
            lastLog = TimeCurrent();
         }
      }
      return true; // Bloquer les nouveaux trades
   }
   
   return false; // Autoriser les trades
}

//| OBTENIR LA DIRECTION DE LA FLÃˆCHE DERIV ARROW |
bool GetDerivArrowDirection(string &direction)
{
   direction = "";
   
   // NOUVEAU: MÃ‰MOIRE DES FLÃˆCHES DÃ‰JÃ€ DÃ‰TECTÃ‰ES
   static string lastDetectedArrow = "";
   static datetime lastDetectedTime = 0;
   
   // Chercher les objets flÃ¨che sur le graphique
   for(int i = ObjectsTotal(0, -1, OBJ_ARROW) - 1; i >= 0; i--)
   {
      string objName = ObjectName(0, i, -1, OBJ_ARROW);
      
      // VÃ©rifier si c'est une flÃ¨che Deriv Arrow - PLUS SPÃ‰CIFIQUE
      bool isDerivArrow = false;
      if(StringFind(objName, "DERIV") >= 0 || StringFind(objName, "Deriv") >= 0 || 
         StringFind(objName, "ARROW") >= 0 || StringFind(objName, "Arrow") >= 0 ||
         StringFind(objName, "SIGNAL") >= 0 || StringFind(objName, "Signal") >= 0)
      {
         isDerivArrow = true;
      }
      
      // VÃ‰RIFICATION SUPPLÃ‰MENTAIRE: chercher les grandes flÃ¨ches typiques
      if(!isDerivArrow)
      {
         // Noms de grandes flÃ¨ches trading
         if(StringFind(objName, "BUY") >= 0 || StringFind(objName, "SELL") >= 0 ||
            StringFind(objName, "ENTRY") >= 0 || StringFind(objName, "Entry") >= 0 ||
            StringFind(objName, "TRADE") >= 0 || StringFind(objName, "Trade") >= 0)
         {
            isDerivArrow = true;
         }
      }
      
      if(!isDerivArrow) continue;
      
      datetime objTime = (datetime)ObjectGetInteger(0, objName, OBJPROP_TIME, 0);
      datetime currentTime = TimeCurrent();
      
      // La flÃ¨che doit Ãªtre sur les 3 derniÃ¨res bougies maximum (plus rÃ©actif)
      if(currentTime - objTime <= PeriodSeconds() * 3)
      {
         // VÃ©rifier que la flÃ¨che est VRAIMENT visible (propriÃ©tÃ©s visuelles)
         color arrowColor = (color)ObjectGetInteger(0, objName, OBJPROP_COLOR);
         int arrowWidth = (int)ObjectGetInteger(0, objName, OBJPROP_WIDTH);
         bool arrowVisible = (bool)ObjectGetInteger(0, objName, OBJPROP_TIME, 0) > 0;
         
         // IGNORER les flÃ¨ches trop petites ou invisibles
         if(arrowWidth < 2 || !arrowVisible)
         {
            Print("ðŸ” FlÃ¨che ignorÃ©e - Trop petite ou invisible: ", objName, " | Width: ", arrowWidth);
            continue;
         }
         
         // CrÃ©er une clÃ© unique pour cette flÃ¨che
         string arrowKey = _Symbol + "_" + objName + "_" + TimeToString(objTime, TIME_MINUTES);
         
         // VÃ©rifier si cette flÃ¨che a dÃ©jÃ  Ã©tÃ© dÃ©tectÃ©e
         if(lastDetectedArrow == arrowKey && (currentTime - lastDetectedTime) < 300) // 5 minutes
         {
            continue; // Ignorer cette flÃ¨che dÃ©jÃ  traitÃ©e
         }
         
         // Vert = BUY, Rouge = SELL
         if(arrowColor == clrGreen || arrowColor == clrLime || arrowColor == clrForestGreen)
         {
            direction = "BUY";
            Print("ðŸŸ¢ GRANDE FLÃˆCHE VERTE DÃ‰TECTÃ‰E - Signal BUY sur ", _Symbol, 
                  " | Objet: ", objName, 
                  " | Width: ", arrowWidth,
                  " | Time: ", TimeToString(objTime, TIME_SECONDS));
            
            // MÃ‰MORISER CETTE FLÃˆCHE COMME DÃ‰TECTÃ‰E
            lastDetectedArrow = arrowKey;
            lastDetectedTime = currentTime;
            return true;
         }
         else if(arrowColor == clrRed || arrowColor == clrCrimson || arrowColor == clrIndianRed)
         {
            direction = "SELL";
            Print("ðŸ”´ GRANDE FLÃˆCHE ROUGE DÃ‰TECTÃ‰E - Signal SELL sur ", _Symbol,
                  " | Objet: ", objName,
                  " | Width: ", arrowWidth,
                  " | Time: ", TimeToString(objTime, TIME_SECONDS));
            
            // MÃ‰MORISER CETTE FLÃˆCHE COMME DÃ‰TECTÃ‰E
            lastDetectedArrow = arrowKey;
            lastDetectedTime = currentTime;
            return true;
         }
         else
         {
            // Si la couleur n'est pas claire, essayer de deviner par le code de la flÃ¨che
            long arrowCode = ObjectGetInteger(0, objName, OBJPROP_ARROWCODE);
            
            // Codes de flÃ¨che UP (BUY) - plus de codes pour les grandes flÃ¨ches
            if(arrowCode == 241 || arrowCode == 242 || arrowCode == 233 || arrowCode == 225 ||
               arrowCode == 67 || arrowCode == 68 || arrowCode == 71 || arrowCode == 72) // Codes grandes flÃ¨ches
            {
               direction = "BUY";
               Print("ðŸŸ¢ GRANDE FLÃˆCHE UP DÃ‰TECTÃ‰E - Signal BUY sur ", _Symbol, 
                     " (code: ", arrowCode, ") | Objet: ", objName,
                     " | Width: ", arrowWidth);
               
               // MÃ‰MORISER CETTE FLÃˆCHE COMME DÃ‰TECTÃ‰E
               lastDetectedArrow = arrowKey;
               lastDetectedTime = currentTime;
               return true;
            }
            // Codes de flÃ¨che DOWN (SELL) - plus de codes pour les grandes flÃ¨ches
            else if(arrowCode == 240 || arrowCode == 243 || arrowCode == 234 || arrowCode == 226 ||
                     arrowCode == 76 || arrowCode == 77 || arrowCode == 78 || arrowCode == 79) // Codes grandes flÃ¨ches
            {
               direction = "SELL";
               Print("ðŸ”´ GRANDE FLÃˆCHE DOWN DÃ‰TECTÃ‰E - Signal SELL sur ", _Symbol,
                     " (code: ", arrowCode, ") | Objet: ", objName,
                     " | Width: ", arrowWidth);
               
               // MÃ‰MORISER CETTE FLÃˆCHE COMME DÃ‰TECTÃ‰E
               lastDetectedArrow = arrowKey;
               lastDetectedTime = currentTime;
               return true;
            }
            else
            {
               Print("ðŸ” FlÃ¨che ignorÃ©e - Code non reconnu: ", arrowCode, " | Objet: ", objName);
            }
         }
      }
   }
   
   return false;
}

//| EXÃ‰CUTER UN TRADE BASÃ‰ SUR LA FLÃˆCHE DERIV ARROW |
void ExecuteDerivArrowTrade(string direction)
{
   Print("ðŸ” DÃ‰BUT ANALYSE FLÃˆCHE DERIV ARROW - Direction: ", direction, " | Symbole: ", _Symbol);
   
   // NOUVEAU: VÃ‰RIFICATION PROTECTION CAPITAL - MAX 2 POSITIONS
   if(IsMaxPositionsReached())
   {
      Print("ðŸš« FLÃˆCHE DERIV ARROW BLOQUÃ‰E - Protection capital activÃ©e (max ", MaxPositionsTerminal, " positions)");
      return;
   }
   Print("âœ… Protection capital OK");
   
   // NOUVEAU: VÃ‰RIFICATION CONFIANCE IA MINIMALE
   if(UseAIServer)
   {
      double aiConfidencePct = (g_lastAIConfidence <= 1.0)
                               ? g_lastAIConfidence * 100.0
                               : g_lastAIConfidence;
      Print("ðŸ“Š VÃ©rification IA - Confiance: ", DoubleToString(aiConfidencePct, 1), "% | Action: ", g_lastAIAction);
      if(aiConfidencePct < MinAIConfidencePercent)
      {
         Print("ðŸš« FLÃˆCHE DERIV ARROW BLOQUÃ‰E - Confiance IA insuffisante: ", 
               DoubleToString(aiConfidencePct, 1), "% < ", DoubleToString(MinAIConfidencePercent, 1), "% minimum");
         Print("   ðŸ“Š IA Action: ", g_lastAIAction);
         return;
      }
      else
      {
         Print("âœ… CONFIANCE IA VALIDÃ‰E - ", DoubleToString(aiConfidencePct, 1), "% â‰¥ ", 
               DoubleToString(MinAIConfidencePercent, 1), "% minimum");
      }
   }
   else
   {
      Print("ðŸ“Š Serveur IA dÃ©sactivÃ© - Utilisation flÃ¨che uniquement");
   }

   if(UseGOMVerdictFilter && !SMCGP_GOMAllowsAction(direction))
   {
      Print("[ARROW] BloquÃ© â€” GOM ", g_smcGomVerdict, " (vn=", g_smcGomVerdictNum, ")");
      return;
   }

   // GATE COHÃ‰RENCE GOM >= 70% (rÃ¨gle absolue IA gate)
   if(g_smcGomCoherence > 0 && g_smcGomCoherence < 70.0)
   {
      Print("[ARROW] BloquÃ© â€” coherence ", DoubleToString(g_smcGomCoherence,1), "% < 70% requis");
      return;
   }

   // GATE M1 : M1 ne doit pas Ãªtre opposÃ© Ã  la direction (micro-tendance)
   string m1Dir = g_smcTfM1Dir;
   if((direction == "BUY"  && m1Dir == "BEAR") ||
      (direction == "SELL" && m1Dir == "BULL"))
   {
      Print("[ARROW] BloquÃ© â€” M1=", m1Dir, " opposÃ© Ã  ", direction, " (entrÃ©e vouÃ©e Ã  l'Ã©chec)");
      return;
   }

   // GATE M5 : M5 ne doit pas Ãªtre opposÃ© Ã  la direction (confirmation court terme).
   // FIX 2026-09-09 (Claude, demande Sidoine, GainX 800 BUY 23:02:51 en pleine
   // downtrend) : le seul gate M1 laissait passer un simple rebond d'une bougie
   // alors que M5/M15/H1/H4 restaient tous BEAR (cf. dashboard "IA SELL 82%").
   // M5 est le TF prioritaire utilisÃ© cÃ´tÃ© serveur (ia_status_v2) ; l'aligner ici
   // Ã©vite d'entrer contre une tendance confirmÃ©e sur plusieurs timeframes.
   string m5DirArrow = g_smcTfM5Dir;
   if((direction == "BUY"  && m5DirArrow == "BEAR") ||
      (direction == "SELL" && m5DirArrow == "BULL"))
   {
      Print("[ARROW] BloquÃ© â€” M5=", m5DirArrow, " opposÃ© Ã  ", direction, " (contre-tendance court terme)");
      return;
   }

   // GATE tf_global_dir : tendance globale GOM ne doit pas contredire la direction
   string globalDir = g_smcGomGlobalDir;
   if((direction == "BUY"  && globalDir == "BEAR") ||
      (direction == "SELL" && globalDir == "BULL"))
   {
      Print("[ARROW] BloquÃ© â€” tf_global=", globalDir, " opposÃ© Ã  ", direction, " (contre-tendance globale)");
      return;
   }

   // GATE STRICT PAIX/GAINx : verdict GOM GOOD/PERFECT + tendance Global/M5/M1
   // alignÃ©e dans le mÃªme sens (rÃ¨gle PainX/GainX) â€” la vraie position n'est prise
   // que si le GOM est GOOD/PERFECT ET que global, M5 et M1 pointent tous dans le
   // sens de la direction (BUY/SELL), pas seulement "non opposÃ©s".
   bool isPairxGainxArrow = false;
   {
      string symUpArrow = _Symbol;
      StringToUpper(symUpArrow);
      isPairxGainxArrow = (StringFind(symUpArrow, "PAINX") >= 0 || StringFind(symUpArrow, "GAINX") >= 0);
   }
   if(isPairxGainxArrow)
   {
      int arrowDirSign = (direction == "BUY") ? 1 : (direction == "SELL") ? -1 : 0;
      if(arrowDirSign == 0 || !SMCGP_IsGoodPerfect(g_smcGomVerdictNum))
      {
         Print("âŒ PAIx/GAINx - BloquÃ©: verdict GOM insuffisant (vn=", g_smcGomVerdictNum, ")");
         return;
      }
      if(!SMC_TfDirMatchesSign(arrowDirSign, g_smcGomGlobalDir) ||
         !SMC_TfDirMatchesSign(arrowDirSign, g_smcTfM5Dir) ||
         !SMC_TfDirMatchesSign(arrowDirSign, g_smcTfM1Dir))
      {
         Print("âŒ PAIx/GAINx - BloquÃ©: tendance non alignÃ©e avec le GOM pour ",
               direction,
               " | Global=", g_smcGomGlobalDir,
               " M5=", g_smcTfM5Dir,
               " M1=", g_smcTfM1Dir);
         return;
      }
      Print("âœ… PAIx/GAINx - GOM GOOD/PERFECT et tendance alignÃ©e (Global=",
            g_smcGomGlobalDir, " M5=", g_smcTfM5Dir, " M1=", g_smcTfM1Dir, ") direction ", direction);
   }

   // Validation : Boom = BUY uniquement, Crash = SELL uniquement
   bool isBoom = IsBoomLikeSymbol(_Symbol);
   bool isCrash = IsCrashLikeSymbol(_Symbol);
   
   Print("ðŸŽ¯ Validation symbole - Boom: ", isBoom, " | Crash: ", isCrash, " | Direction: ", direction);
   
   if(isBoom && direction != "BUY")
   {
      Print("ðŸš« FLÃˆCHE DERIV ARROW IGNOREE - ", direction, " sur Boom (seul BUY autorisÃ©)");
      return;
   }
   
   if(isCrash && direction != "SELL")
   {
      Print("ðŸš« FLÃˆCHE DERIV ARROW IGNOREE - ", direction, " sur Crash (seul SELL autorisÃ©)");
      return;
   }
   Print("âœ… Validation symbole OK");
   
   // VÃ©rifier que l'IA n'est pas en HOLD
   if(UseAIServer && (g_lastAIAction == "HOLD" || g_lastAIAction == "hold"))
   {
      Print("ðŸš« FLÃˆCHE DERIV ARROW BLOQUÃ‰E - IA en HOLD sur ", _Symbol);
      return;
   }
   Print("âœ… IA non-HOLD OK");
   
   // NOUVEAU: VÃ‰RIFIER SI LE PRIX EST DANS LA ZONE D'Ã‰QUILIBRE
   bool inDiscount = IsInDiscountZone();
   bool inPremium  = IsInPremiumZone();
   
   Print("ðŸ“ Zones SMC - Discount: ", inDiscount, " | Premium: ", inPremium);
   
   // Si le prix est dans la zone d'Ã©quilibre (ni premium ni discount), bloquer le trade
   if(!inDiscount && !inPremium)
   {
      Print("ðŸš« FLÃˆCHE DERIV ARROW BLOQUÃ‰E - Prix dans zone d'Ã©quilibre sur ", _Symbol, 
            " (ni Premium ni Discount) - Trade non autorisÃ©");
      return;
   }
   Print("âœ… Zone SMC OK (ni Premium ni Discount)");
   
   // Protection capital: zone d'achat au bord infÃ©rieur â†’ SELL seulement si confiance IA >= 85%
   if(direction == "SELL" && IsAtDiscountLowerEdge() && g_lastAIConfidence < 0.85)
   {
      Print("ðŸš« FLÃˆCHE DERIV ARROW BLOQUÃ‰E - Zone Discount au bord infÃ©rieur: SELL autorisÃ© seulement si confiance IA â‰¥ 85% (actuel: ",
            DoubleToString(g_lastAIConfidence*100, 1), "%)");
      return;
   }
   // Protection capital: zone premium au bord supÃ©rieur (Boom) â†’ BUY seulement si confiance IA >= 85%
   if(direction == "BUY" && isBoom && IsAtPremiumUpperEdge() && g_lastAIConfidence < 0.85)
   {
      Print("ðŸš« FLÃˆCHE DERIV ARROW BLOQUÃ‰E - Zone Premium au bord supÃ©rieur (Boom): BUY autorisÃ© seulement si confiance IA â‰¥ 85% (actuel: ",
            DoubleToString(g_lastAIConfidence*100, 1), "%)");
      return;
   }
   
   // Anti-doublon et Conflit: Utiliser le gate universel
   if(!CanTradeOnSymbol(_Symbol, direction))
   {
      Print("ðŸš« FLÃˆCHE DERIV ARROW BLOQUÃ‰E - Terminal plein, sens interdit, retournement ou ordre existant sur ", _Symbol);
      return;
   }
   Print("âœ… Gate universel OK");
   
   Print("ðŸš€ TOUTES LES VALIDATIONS RÃ‰USSIES - EXÃ‰CUTION DU TRADE...");
   
   // NOUVEAU: MÃ‰MOIRE DES FLÃˆCHES DÃ‰JÃ€ TRAITÃ‰ES
   static string lastProcessedArrow = "";
   static datetime lastProcessedTime = 0;
   
   // CrÃ©er une clÃ© unique pour cette flÃ¨che (symbole + direction + heure)
   string currentArrowKey = _Symbol + "_" + direction + "_" + TimeToString(TimeCurrent(), TIME_MINUTES);
   
   // VÃ©rifier si cette flÃ¨che a dÃ©jÃ  Ã©tÃ© traitÃ©e rÃ©cemment
   if(lastProcessedArrow == currentArrowKey && (TimeCurrent() - lastProcessedTime) < 300) // 5 minutes
   {
      Print("ðŸ”„ FLÃˆCHE DERIV ARROW DÃ‰JÃ€ TRAITÃ‰E - ", direction, " sur ", _Symbol, " (ignorer pour Ã©viter duplication)");
      return;
   }
   
   // Obtenir le prix actuel
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, PERIOD_CURRENT, 0, 1, r) < 1)
   {
      Print("âŒ ERREUR - Impossible d'obtenir les prix pour ", _Symbol);
      return;
   }
   
   double currentPrice = r[0].close;
   double stopLoss, takeProfit;
   
   // NOUVEAU: CALCUL SL/TP CORRECT POUR Ã‰VITER "INVALID STOPS"
   // Approche radicale : utiliser les exigences du courtier
   long stopsLevel = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL);
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   
   // Distance minimale obligatoire du courtier
   double minStopDistance = (double)stopsLevel * point;
   
   // Si stopsLevel = 0, utiliser une distance par dÃ©faut sÃ©curitaire
   if(minStopDistance <= 0)
   {
      if(isCrash || isBoom)
      {
         minStopDistance = 1.0; // 1 point minimum pour Crash/Boom
      }
      else
      {
         minStopDistance = 20 * point; // 20 pips pour autres
      }
   }
   
   // Utiliser 2x la distance minimale pour Ãªtre sÃ»r
   double safeDistance = minStopDistance * 2.0;
   
   // Calculer SL/TP selon la direction
   if(direction == "BUY")
   {
      stopLoss = currentPrice - safeDistance;
      takeProfit = currentPrice + (safeDistance * 2.0);
   }
   else // SELL
   {
      stopLoss = currentPrice + safeDistance;
      takeProfit = currentPrice - (safeDistance * 2.0);
   }
   
   Print("ðŸ” DEBUG SL/TP - ", _Symbol, " ", direction, 
         " | Prix: ", DoubleToString(currentPrice, _Digits),
         " | Courtier StopsLevel: ", stopsLevel,
         " | MinDistance: ", DoubleToString(minStopDistance, _Digits),
         " | SafeDistance: ", DoubleToString(safeDistance, _Digits),
         " | SL: ", DoubleToString(stopLoss, _Digits),
         " | TP: ", DoubleToString(takeProfit, _Digits));
   
   // VALIDATION FINALE DES DISTANCES
   double askPrice = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bidPrice = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   
   if(direction == "BUY")
   {
      // VÃ©rifier que SL est assez loin de l'ask
      if(askPrice - stopLoss < safeDistance)
      {
         stopLoss = askPrice - safeDistance;
         Print("ðŸ”§ SL ajustÃ© pour BUY sur ", _Symbol, " | Nouveau SL: ", DoubleToString(stopLoss, _Digits));
      }
      // VÃ©rifier que TP est assez loin de l'ask
      if(takeProfit - askPrice < safeDistance)
      {
         takeProfit = askPrice + (safeDistance * 2.0);
         Print("ðŸ”§ TP ajustÃ© pour BUY sur ", _Symbol, " | Nouveau TP: ", DoubleToString(takeProfit, _Digits));
      }
   }
   else // SELL
   {
      // VÃ©rifier que SL est assez loin du bid
      if(stopLoss - bidPrice < safeDistance)
      {
         stopLoss = bidPrice + safeDistance;
         Print("ðŸ”§ SL ajustÃ© pour SELL sur ", _Symbol, " | Nouveau SL: ", DoubleToString(stopLoss, _Digits));
      }
      // VÃ©rifier que TP est assez loin du bid
      if(bidPrice - takeProfit < safeDistance)
      {
         takeProfit = bidPrice - (safeDistance * 2.0);
         Print("ðŸ”§ TP ajustÃ© pour SELL sur ", _Symbol, " | Nouveau TP: ", DoubleToString(takeProfit, _Digits));
      }
   }
   
   // Normaliser les prix
   stopLoss = NormalizeDouble(stopLoss, _Digits);
   takeProfit = NormalizeDouble(takeProfit, _Digits);
   
   // Envoyer la notification
   SendDerivArrowNotification(direction, currentPrice, stopLoss, takeProfit);
   
   // ExÃ©cuter l'ordre au marchÃ©
   MqlTradeRequest request = {};
   MqlTradeResult result = {};
   
   request.action = TRADE_ACTION_DEAL;
   request.symbol = _Symbol;
   request.volume = CalculateLotSize();
   request.type = (direction == "BUY") ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   request.price = (direction == "BUY") ? askPrice : bidPrice;
   request.sl = stopLoss;
   request.tp = takeProfit;
   request.deviation = 20;
   request.magic = InpMagicNumber;
   request.comment = "DERIV ARROW " + direction;
   
   if(!SMC_FinalOpenGate(_Symbol, request.type)) return;
   if(SafeOrderSend(request, result, request.comment))
   {
      RegisterOrderPlaced();
      SMC_GateRegisterOpened(_Symbol, direction == "BUY");
      Print("âœ… ORDRE DERIV ARROW EXÃ‰CUTÃ‰ - ", direction, " sur ", _Symbol,
            " | Prix: ", DoubleToString((direction == "BUY") ? askPrice : bidPrice, _Digits),
            " | SL: ", DoubleToString(stopLoss, _Digits),
            " | TP: ", DoubleToString(takeProfit, _Digits),
            " | Ticket: ", result.order);
      
      // MÃ‰MORISER CETTE FLÃˆCHE COMME TRAITÃ‰E
      lastProcessedArrow = currentArrowKey;
      lastProcessedTime = TimeCurrent();
   }
   else
   {
      Print("âŒ Ã‰CHEC ORDRE DERIV ARROW - Erreur: ", GetLastError());
   }
}

//| VÃ©rifier si toutes les directions TF sont alignÃ©es dans un sens      |
bool AreAllTimeframesAligned(string &direction)
{
   // VÃ©rifier que toutes les 6 TFs ont la mÃªme direction (BULL ou BEAR)
   string tf[6] = { g_smcTfM1Dir, g_smcTfM5Dir, g_smcTfM15Dir,
                     g_smcTfH1Dir, g_smcTfH4Dir, g_smcTfD1Dir };

   int bulls = 0, bears = 0;
   for(int i = 0; i < 6; i++)
   {
      if(tf[i] == "BULL") bulls++;
      else if(tf[i] == "BEAR") bears++;
   }

   // Toutes les 6 TFs doivent Ãªtre alignÃ©es dans le mÃªme sens
   if(bulls == 6) { direction = "BUY"; return true; }
   if(bears == 6) { direction = "SELL"; return true; }

   // Au minimum 5/6 avec le global alignÃ©
   string globalDir = g_smcGomGlobalDir;
   if(globalDir == "BULL" && bulls >= 5) { direction = "BUY"; return true; }
   if(globalDir == "BEAR" && bears >= 5) { direction = "SELL"; return true; }

   return false;
}

//| EntrÃ©e prÃ©cise si H1 + M5 alignÃ©s dans le sens du verdict GOM       |
bool AreH1M5AlignedForGOM(string &direction)
{
   string m5 = g_smcTfM5Dir;
   string h1 = g_smcTfH1Dir;
   if(m5 == "BULL" && h1 == "BULL") { direction = "BUY";  return true; }
   if(m5 == "BEAR" && h1 == "BEAR") { direction = "SELL"; return true; }
   return false;
}

// NOUVEAU: VÃ©rifier alignement H1+M5 pour N'IMPORTE QUELLE position (pas seulement GOM)
bool IsH1M5AlignedForPosition(const string symbol, const ENUM_POSITION_TYPE posType)
{
   // RÃ©cupÃ©rer M5 et H1 trend via EMA
   int emaFastM5Handle = iMA(symbol, PERIOD_M5, 9, 0, MODE_EMA, PRICE_CLOSE);
   int emaSlowM5Handle = iMA(symbol, PERIOD_M5, 21, 0, MODE_EMA, PRICE_CLOSE);
   int emaFastH1Handle = iMA(symbol, PERIOD_H1, 9, 0, MODE_EMA, PRICE_CLOSE);
   int emaSlowH1Handle = iMA(symbol, PERIOD_H1, 21, 0, MODE_EMA, PRICE_CLOSE);
   
   if(emaFastM5Handle == INVALID_HANDLE || emaSlowM5Handle == INVALID_HANDLE ||
      emaFastH1Handle == INVALID_HANDLE || emaSlowH1Handle == INVALID_HANDLE)
      return false;
   
    double emaFastM5Buf[], emaSlowM5Buf[], emaFastH1Buf[], emaSlowH1Buf[];
    ArraySetAsSeries(emaFastM5Buf, true); ArraySetAsSeries(emaSlowM5Buf, true);
    ArraySetAsSeries(emaFastH1Buf, true); ArraySetAsSeries(emaSlowH1Buf, true);

    if(CopyBuffer(emaFastM5Handle, 0, 0, 2, emaFastM5Buf) < 2) return false;
    if(CopyBuffer(emaSlowM5Handle, 0, 0, 2, emaSlowM5Buf) < 2) return false;
    if(CopyBuffer(emaFastH1Handle, 0, 0, 2, emaFastH1Buf) < 2) return false;
    if(CopyBuffer(emaSlowH1Handle, 0, 0, 2, emaSlowH1Buf) < 2) return false;

    bool m5Bull = (emaFastM5Buf[0] > emaSlowM5Buf[0]);
    bool h1Bull = (emaFastH1Buf[0] > emaSlowH1Buf[0]);
   
   IndicatorRelease(emaFastM5Handle); IndicatorRelease(emaSlowM5Handle);
   IndicatorRelease(emaFastH1Handle); IndicatorRelease(emaSlowH1Handle);
   
   if(posType == POSITION_TYPE_BUY)
      return (m5Bull && h1Bull);
   else
      return (!m5Bull && !h1Bull);
}

//| EntrÃ©e PATIENTE verdict SIMPLE/BAIL (|vn|=1) : DOW + 1-2 petites bougies  |
//+------------------------------------------------------------------+
void SMC_TryPatientSimpleEntry()
{
   if(!UsePatientSimpleEntry) return;
   if(!g_smcGomConnected || MathAbs(g_smcGomVerdictNum) != 1) return;
   // SIMPLE : l'entrÃ©e est le LIMIT sur la trendline taux (DOW projetÃ©e),
   // pas un MARKET au touch. DowTrendline_OnTick pose le LIMIT.
   if(UseDowTrendline && g_dowState.active && g_dowState.projectedPrice > 0.0)
      return;
   if(CountPositionsForSymbol(_Symbol) > 0) return;
   if(SMC_ReactionEntryBlocked(_Symbol, g_smcGomVerdictNum > 0 ? "BUY" : "SELL")) return;

   int dirSign = (g_smcGomVerdictNum > 0) ? 1 : -1;
   string dirStr = (dirSign > 0) ? "BUY" : "SELL";

   if(!CanPlacePatientSimpleOrderByGOM(_Symbol, dirSign)) return;
   if(!IsDirectionAllowedForBoomCrash(_Symbol, dirStr)) return;
   if(!CanTradeOnSymbol(_Symbol, dirStr)) return;

   double atr = 0.0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[]; ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atr = ab[0];
   }
   if(atr <= 0.0) atr = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 50.0;
   double tol = atr * ReactionTouchATRMult;

   // FIX: l'ancien code testait ICI la mÃªme condition (UseDowTrendline && g_dowState.active
   // && g_dowState.projectedPrice > 0.0) que le "return" en tÃªte de fonction. Or si cette
   // condition est vraie, on est dÃ©jÃ  sorti plus haut (voie LIMIT gÃ©rÃ©e par DowTrendline_OnTick).
   // Donc Ã  ce stade DOW est forcÃ©ment inactif/non projetÃ© -> l'ancien "if(!dowTouch) return;"
   // se dÃ©clenchait TOUJOURS et bloquait 100% des entrÃ©es patientes. La confirmation de
   // "touch" pour ce cas (DOW inactif) est dÃ©jÃ  assurÃ©e plus bas par obTouch / smallBars.

   int rt = SMC_GetReactionTracker(_Symbol);
   if(rt < 0) return;
   if(!g_reactionTrackers[rt].spikeSeen && !g_reactionTrackers[rt].m1Touched) return;

   int smallBars = SMC_CountRecentSmallM1Bars(PatientSimpleConfirmBars, atr, PostSpikeSmallBodyRatio);
   double obMid = 0.0;
   bool obTouch = SMC_PriceNearThickOB(dirSign, tol, obMid);
   if(!obTouch && (smallBars < 1 || smallBars > PatientSimpleConfirmBars)) return;

   static datetime s_lastPatient = 0;
   if(TimeCurrent() - s_lastPatient < 60) return;
   if(!TryAcquireOpenLock()) return;

   double lot = CalculateLotSize();
   if(lot <= 0.0) return; // ne plus forcer un lot min : respecter le blocage (drawdown / cap $ dynamique)
   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double slDist = atr * MathMax(2.5, SL_ATRMult);
   double tpDist = slDist * 2.0;

   bool ok = false;
   if(dirSign > 0)
   {
      double sl = NormalizeDouble(ask - slDist, dg);
      double tp = NormalizeDouble(ask + tpDist, dg);
      if(SMC_FinalOpenGate(_Symbol, ORDER_TYPE_BUY))
         ok = SafeTradeBuy(lot, _Symbol, ask, sl, tp, "PATIENT SIMPLE BUY");
   }
   else
   {
      double sl = NormalizeDouble(bid + slDist, dg);
      double tp = NormalizeDouble(bid - tpDist, dg);
      if(SMC_FinalOpenGate(_Symbol, ORDER_TYPE_SELL))
         ok = SafeTradeSell(lot, _Symbol, bid, sl, tp, "PATIENT SIMPLE SELL");
   }
   ReleaseOpenLock();

   if(ok)
   {
      s_lastPatient = TimeCurrent();
      RegisterOrderPlaced();
      Print("âœ… PATIENT SIMPLE ", dirStr, " ", _Symbol, " vn=", g_smcGomVerdictNum,
            " smallM1=", smallBars, " ob=", (obTouch ? "Y" : "N"));
   }
}

//| AprÃ¨s correction (3 M1 sans rÃ©action) : trader le 1er spike M5 TFTL   |
//+------------------------------------------------------------------+
void SMC_TryM5RecoverySpikeEntry()
{
   int rt = SMC_GetReactionTracker(_Symbol);
   if(rt < 0 || !g_reactionTrackers[rt].correctionExit) return;
   if(!g_reactionTrackers[rt].m5Reacted) return;
   if(!SMCGP_IsGoodPerfect(g_smcGomVerdictNum)) return;
   if(CountPositionsForSymbol(_Symbol) > 0) return;

   int dirSign = g_reactionTrackers[rt].dirSign;
   if(dirSign == 0) dirSign = (g_smcGomVerdictNum > 0) ? 1 : -1;
   string dirStr = (dirSign > 0) ? "BUY" : "SELL";
   if(SMC_ReactionEntryBlocked(_Symbol, dirStr)) return;
   if(!CanPlaceMarketOrder(_Symbol, dirSign)) return;
   if(!CanTradeOnSymbol(_Symbol, dirStr)) return;

   double atr = 0.0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[]; ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atr = ab[0];
   }
   if(atr <= 0.0) atr = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 50.0;
   if(!SMC_ReactionSpikeNow(dirSign, atr)) return;
   if(!SMC_PriceReactedOnGOM_TL_M5(dirSign)) return;

   static datetime s_lastM5Rec = 0;
   if(TimeCurrent() - s_lastM5Rec < 45) return;
   if(!TryAcquireOpenLock()) return;

   double lot = CalculateLotSize();
   if(lot <= 0.0) return; // ne plus forcer un lot min : respecter le blocage (drawdown / cap $ dynamique)
   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double slDist = atr * MathMax(2.0, SL_ATRMult);
   double tpDist = slDist * 2.0;

   bool ok = false;
   string cmt = "M5 RECOVERY SPIKE " + dirStr;
   if(dirSign > 0)
   {
      double sl = NormalizeDouble(ask - slDist, dg);
      double tp = NormalizeDouble(ask + tpDist, dg);
      if(SMC_FinalOpenGate(_Symbol, ORDER_TYPE_BUY))
         ok = SafeTradeBuy(lot, _Symbol, ask, sl, tp, cmt);
   }
   else
   {
      double sl = NormalizeDouble(bid + slDist, dg);
      double tp = NormalizeDouble(bid - tpDist, dg);
      if(SMC_FinalOpenGate(_Symbol, ORDER_TYPE_SELL))
         ok = SafeTradeSell(lot, _Symbol, bid, sl, tp, cmt);
   }
   ReleaseOpenLock();

   if(ok)
   {
      s_lastM5Rec = TimeCurrent();
      RegisterOrderPlaced();
      g_reactionTrackers[rt].correctionExit = false;
      g_reactionTrackers[rt].stayAway = false;
      g_reactionTrackers[rt].spikeSeen = true;
      Print("ðŸš€ M5 RECOVERY SPIKE ", dirStr, " ", _Symbol, " â€” 1er spike M5 aprÃ¨s correction");
      SMC_ArmSecondSpikeWindow(dirSign, "M5 recovery 1er spike");
   }
}

//| EntrÃ©e marchÃ© GOM : BUY/SELL si verdict GOOD/PERFECT + H1/M5 alignÃ©s |
//+------------------------------------------------------------------+
//| PRIORITÃ‰ 1: EntrÃ©e marchÃ© sur touch GOM_TF_TL_M1                 |
//| PERFECT/GOOD + touch ligne M1 â†’ MARKET immÃ©diat                  |
//| DOW EP reste en prioritÃ© 2 (module DowTrendline)                 |
//+------------------------------------------------------------------+
void SMC_TryGOM_TF_TL_M1_MarketEntry(const int dirSign, const double m1Level, const double atr)
{
   if(dirSign == 0 || m1Level <= 0 || atr <= 0) return;
   if(!g_smcGomConnected) return;
   if(!SMC_EntryVerdictOK(_Symbol, dirSign)) return;
   if(!SMC_SpikeBlink_TripleTFAligned(dirSign)) return;
   if(PurePA_ConfirmGOMEntries && !PurePA_ConfirmsGOMDirection(_Symbol, dirSign)) return;

   // Boom/GainX = BUY only, Crash/PainX = SELL only
   if(IsBoomLikeSymbol(_Symbol) && dirSign < 0) return;
   if(IsCrashLikeSymbol(_Symbol) && dirSign > 0) return;

   if(CountPositionsForSymbol(_Symbol) > 0) return;
   if(IsTerminalFull()) return;

   static datetime s_lastM1TlEntry = 0;
   if(TimeCurrent() - s_lastM1TlEntry < 45) return; // anti-spam

   if(SMC_ReactionEntryBlocked(_Symbol, dirSign > 0 ? "BUY" : "SELL")) return;
   if(!SMC_HasM1ConfirmCandle(dirSign, atr)) return;
   if(!CanPlaceMarketOrder(_Symbol, dirSign)) return;

   string dir = dirSign > 0 ? "BUY" : "SELL";
   if(!CanTradeOnSymbol(_Symbol, dir)) return;
   if(!SMC_FinalOpenGate(_Symbol, dirSign > 0 ? ORDER_TYPE_BUY : ORDER_TYPE_SELL)) return;

   double lot = CalculateLotSize();
   if(lot <= 0) return; // ne plus forcer un lot min : respecter le blocage (drawdown / cap $ dynamique)
   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   // SL min = max(ATR*2.5, ~$2)
   double slDist = atr * MathMax(2.5, GOMAlignSL_ATRMult);
   {
      double tv = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
      double ts = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
      if(tv > 0 && ts > 0 && lot > 0)
      {
         double ppd = (tv * lot) / ts;
         if(ppd > 0) slDist = MathMax(slDist, 2.0 / ppd);
      }
   }
   double tpDist = slDist * MathMax(2.0, GOMAlignTP_ATRMult / MathMax(GOMAlignSL_ATRMult, 1.0));

   if(!TryAcquireOpenLock()) return;
   bool ok = false;
   if(dirSign > 0)
   {
      double sl = NormalizeDouble(ask - slDist, dg);
      double tp = NormalizeDouble(ask + tpDist, dg);
      ok = SafeTradeBuy(lot, _Symbol, ask, sl, tp, "GOM_TF_TL_M1 BUY");
      if(ok) SMC_GateRegisterOpened(_Symbol, true);
   }
   else
   {
      double sl = NormalizeDouble(bid + slDist, dg);
      double tp = NormalizeDouble(bid - tpDist, dg);
      ok = SafeTradeSell(lot, _Symbol, bid, sl, tp, "GOM_TF_TL_M1 SELL");
      if(ok) SMC_GateRegisterOpened(_Symbol, false);
   }
   ReleaseOpenLock();

   if(ok)
   {
      s_lastM1TlEntry = TimeCurrent();
      RegisterOrderPlaced();
      ulong ticket = trade.ResultOrder();
      if(ticket > 0) SMC_ApplyPostEntrySLBuffer(_Symbol, ticket, 2.0);
      Print("ðŸš€ PRIORITÃ‰1 GOM_TF_TL_M1 ", dir, " MARKET | TL=", DoubleToString(m1Level, dg),
            " | Entry=", DoubleToString(dirSign > 0 ? ask : bid, dg),
            " | vn=", g_smcGomVerdictNum, " (PERFECT/GOOD) | ", _Symbol);
      if(UseNotifications)
         SendNotification("ðŸš€ GOM_TF_TL_M1 " + dir + " " + _Symbol + " vn=" + IntegerToString(g_smcGomVerdictNum));
   }
   else
   {
      static datetime s_failLog = 0;
      if(TimeCurrent() - s_failLog >= 20)
      {
         s_failLog = TimeCurrent();
         Print("âŒ GOM_TF_TL_M1 MARKET Ã©chouÃ© ", dir, " sur ", _Symbol,
               " | vn=", g_smcGomVerdictNum, " | err=", GetLastError());
      }
   }
}

//+------------------------------------------------------------------+
//| EntrÃ©e AGGRESSIVE au touch DOW/GOM_TF_TL_M1 (GainX/PainX)         |
//| GOOD/PERFECT + M1/M5/M15 requis sur les niveaux clÃ©s             |
//+------------------------------------------------------------------+
void SMC_TryAggressiveDowGomEntry()
{
   if(!UseAggressiveDowGomEntry) return;

   // Uniquement GainX/PainX
   string symUpper = _Symbol;
   StringToUpper(symUpper);
   bool isGainPain = (StringFind(symUpper, "GAINX") >= 0 || StringFind(symUpper, "PAINX") >= 0);
   if(!isGainPain) return;

   if(CountPositionsForSymbol(_Symbol) > 0) return;
   if(IsTerminalFull()) return;

   // GOOD/PERFECT et M1/M5/M15 alignÃ©s sont requis pour les entrÃ©es sur niveaux.
   if(!g_smcGomConnected || !SMCGP_IsGoodPerfect(g_smcGomVerdictNum)) return;
   bool isBearish = (g_smcGomVerdictNum < 0);
   int dirSign = isBearish ? -1 : 1;
   if(!SMC_SpikeBlink_TripleTFAligned(dirSign)) return;
   if(PurePA_ConfirmGOMEntries && !PurePA_ConfirmsGOMDirection(_Symbol, dirSign)) return;

   // Cooldown
   static datetime s_lastAggressiveEntry = 0;
   if(s_lastAggressiveEntry > 0 && TimeCurrent() - s_lastAggressiveEntry < AggressiveEntryCooldownSec) return;

   // Boom/GainX = BUY only, Crash/PainX = SELL only
   if(IsBoomLikeSymbol(_Symbol) && dirSign < 0) return;
   if(IsCrashLikeSymbol(_Symbol) && dirSign > 0) return;

   // VÃ©rifier touch DOW EP ou GOM_TF_TL_M1
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double price = (bid + ask) * 0.5;
   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   static datetime s_aggressiveTouchBar = 0;
   static double s_aggressiveTouchLevel = 0.0;
   static int s_aggressiveTouchDir = 0;
   static string s_aggressiveTouchSource = "";
   datetime currentM1Bar = iTime(_Symbol, PERIOD_M1, 0);
   if(s_aggressiveTouchDir != 0 && s_aggressiveTouchDir != dirSign)
   {
      s_aggressiveTouchBar = 0;
      s_aggressiveTouchLevel = 0.0;
      s_aggressiveTouchDir = 0;
      s_aggressiveTouchSource = "";
   }

   // ATR pour tolÃ©rance
   double atr = 0;
   double atrBuf[];
   ArraySetAsSeries(atrBuf, true);
   if(atrHandle != INVALID_HANDLE && CopyBuffer(atrHandle, 0, 0, 1, atrBuf) >= 1)
      atr = atrBuf[0];
   if(atr <= 0) atr = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 50;
   double tolerance = atr * 0.15; // 15% ATR tolÃ©rance

   // 1) VÃ©rifier touch DOW EP (BULL_EP ou BEAR_EP)
   string epToken = (dirSign > 0) ? "DOW_BULL_EP" : "DOW_BEAR_EP";
   double epLevel = 0;
   bool epTouched = false;
   if(SMC_FindReactionObjectLevel(_Symbol, epToken, epLevel) && epLevel > 0)
   {
      epTouched = (MathAbs(price - epLevel) <= tolerance);
   }

   // 2) VÃ©rifier touch GOM_TF_TL_M1
   double gomTlLevel = 0;
   bool gomTlTouched = false;
   if(SMC_FindReactionObjectLevel(_Symbol, "GOM_TF_TL_M1", gomTlLevel) && gomTlLevel > 0)
   {
      gomTlTouched = (MathAbs(price - gomTlLevel) <= tolerance);
   }

   if((epTouched || gomTlTouched) && s_aggressiveTouchBar == 0)
   {
      s_aggressiveTouchBar = currentM1Bar;
      s_aggressiveTouchLevel = epTouched ? epLevel : gomTlLevel;
      s_aggressiveTouchDir = dirSign;
      s_aggressiveTouchSource = epTouched ? "DOW EP" : "GOM_TF_TL_M1";
      Print("â³ AGGRESSIVE niveau touchÃ© â€” confirmation M1 exigÃ©e | ",
            s_aggressiveTouchSource, "=", DoubleToString(s_aggressiveTouchLevel, dg));
      return;
   }
   if(s_aggressiveTouchBar == 0 || currentM1Bar <= s_aggressiveTouchBar) return;

   double entryLevel = s_aggressiveTouchLevel;
   string entrySource = s_aggressiveTouchSource;
   s_aggressiveTouchBar = 0;
   s_aggressiveTouchLevel = 0.0;
   s_aggressiveTouchDir = 0;
   s_aggressiveTouchSource = "";
   if(!SMC_HasM1LevelRejection(dirSign, entryLevel, atr))
   {
      Print("ðŸš« AGGRESSIVE entrÃ©e annulÃ©e â€” absence de rejet M1 confirmÃ© au niveau ",
            DoubleToString(entryLevel, dg));
      return;
   }
   epTouched = (entrySource == "DOW EP");
   gomTlTouched = (entrySource == "GOM_TF_TL_M1");

   // VÃ©rifications de base
   if(SMC_ReactionEntryBlocked(_Symbol, dirSign > 0 ? "BUY" : "SELL")) return;
   if(!CanPlaceMarketOrder(_Symbol, dirSign)) return;

   string dir = dirSign > 0 ? "BUY" : "SELL";
   if(!CanTradeOnSymbol(_Symbol, dir)) return;
   if(!SMC_FinalOpenGate(_Symbol, dirSign > 0 ? ORDER_TYPE_BUY : ORDER_TYPE_SELL)) return;

   // ATR
   double atrVal = 0;
   double atrBuf2[];
   ArraySetAsSeries(atrBuf2, true);
   if(atrHandle != INVALID_HANDLE && CopyBuffer(atrHandle, 0, 0, 2, atrBuf2) >= 2)
      atrVal = atrBuf2[1];
   if(atrVal <= 0.0) return;

   double lot = CalculateLotSize();
   if(lot <= 0) return;

   // SL/TP
   double slDist = atrVal * MathMax(2.5, GOMAlignSL_ATRMult);
   double tpDist = slDist * MathMax(2.0, GOMAlignTP_ATRMult / MathMax(GOMAlignSL_ATRMult, 1.0));

   if(!TryAcquireOpenLock()) return;
   bool ok = false;
   if(dirSign > 0)
   {
      double sl = NormalizeDouble(ask - slDist, dg);
      double tp = NormalizeDouble(ask + tpDist, dg);
      ok = SafeTradeBuy(lot, _Symbol, ask, sl, tp, "AGGRESSIVE DOW/GOM BUY");
      if(ok) SMC_GateRegisterOpened(_Symbol, true);
   }
   else
   {
      double sl = NormalizeDouble(bid + slDist, dg);
      double tp = NormalizeDouble(bid - tpDist, dg);
      ok = SafeTradeSell(lot, _Symbol, bid, sl, tp, "AGGRESSIVE DOW/GOM SELL");
      if(ok) SMC_GateRegisterOpened(_Symbol, false);
   }
   ReleaseOpenLock();

   if(ok)
   {
      s_lastAggressiveEntry = TimeCurrent();
      RegisterOrderPlaced();
      string levelSource = entrySource;
      double levelUsed = entryLevel;
      Print("âš¡ AGGRESSIVE ENTRY ", dir, " @ ", DoubleToString(dirSign > 0 ? ask : bid, dg),
            " | Level=", levelSource, "=", DoubleToString(levelUsed, dg),
            " | vn=", g_smcGomVerdictNum, " | ", _Symbol);
      if(UseNotifications)
         SendNotification("âš¡ AGGRESSIVE " + dir + " " + _Symbol + " vn=" + IntegerToString(g_smcGomVerdictNum));
   }
}

void ExecuteGOMAlignmentMarketOrder()
{

   if(!UseGOMTFAlignmentEntry) return;
   if(!g_smcGomConnected) return;

   // Verdict GOM GOOD/PERFECT uniquement
   if(g_smcGomVerdictNum < 2 && g_smcGomVerdictNum > -2) return;

   // Une position mÃªme sens n'est plus bloquante ici : le gate universel
   // dÃ©cidera plus bas si un scale-in GOOD/PERFECT est autorisÃ©.

   // EntrÃ©e prÃ©cise : H1 + M5 alignÃ©s (prioritaire) ; sinon fallback 6 TF
   string tfDirection = "";
   bool aligned = AreH1M5AlignedForGOM(tfDirection);
   if(!aligned)
      aligned = AreAllTimeframesAligned(tfDirection);
   if(!aligned) return;

   bool gomBuy  = (g_smcGomVerdictNum >= 2 && tfDirection == "BUY");
   bool gomSell = (g_smcGomVerdictNum <= -2 && tfDirection == "SELL");
   if(!gomBuy && !gomSell) return;

   // Gate centralisÃ© WAIT / contre-verdict
   int dirSign = gomBuy ? 1 : -1;
   if(!CanPlaceMarketOrder(_Symbol, dirSign)) return;

   // Spike symbols : GOM GOOD/PERFECT + chain spike + cross-corr obligatoires
   if(SMC_IsSpikeStyleSymbol(_Symbol))
   {
      string tripleReason = "";
      if(!SMC_MarketEntryTripleGateOK(dirSign, tripleReason))
      {
         static datetime s_lastTripleLog = 0;
         if(TimeCurrent() - s_lastTripleLog >= 30)
         {
            s_lastTripleLog = TimeCurrent();
            Print("ðŸš« GOM-ALIGN bloquÃ© â€” ", tripleReason);
         }
         return;
      }
   }

   // VÃ©rifier le spread
   if(UseMaxSpreadFilter || GOMAlignMaxSpreadPts > 0)
   {
      double spread = SymbolInfoDouble(_Symbol, SYMBOL_ASK) - SymbolInfoDouble(_Symbol, SYMBOL_BID);
      double maxSpread = GOMAlignMaxSpreadPts * SymbolInfoDouble(_Symbol, SYMBOL_POINT);
      if(maxSpread > 0 && spread > maxSpread)
      {
         static datetime lastSpreadLog = 0;
         if(TimeCurrent() - lastSpreadLog >= 30)
         {
            lastSpreadLog = TimeCurrent();
            Print("ðŸš« GOM-ALIGN Spread trop Ã©levÃ©: ", DoubleToString(spread, (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS)),
                  " > ", DoubleToString(maxSpread, (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS)));
         }
         return;
      }
   }

   // Calculer ATR pour SL/TP
   double atr[];
   ArraySetAsSeries(atr, true);
   double atrValue = 0;
   if(atrHandle != INVALID_HANDLE && CopyBuffer(atrHandle, 0, 0, 1, atr) >= 1)
      atrValue = atr[0];
   if(atrValue <= 0) return;

   // Anti-doublon cooldown (60 secondes entre entrÃ©es GOM-ALIGN)
   static datetime s_lastGomAlignEntry = 0;
   if(TimeCurrent() - s_lastGomAlignEntry < 60) return;

   // VÃ©rifier lock
   if(!TryAcquireOpenLock()) return;

   double lot = CalculateLotSize();
   if(lot <= 0) { ReleaseOpenLock(); return; }

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   int    dg  = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);

   bool orderExecuted = false;

   if(gomBuy)
   {
      if(!CanTradeOnSymbol(_Symbol, "BUY")) { Print("ðŸš« GOM-ALIGN BUY BLOQUÃ‰ â€” Terminal plein, sens interdit, retournement ou ordre existant sur ", _Symbol); ReleaseOpenLock(); return; }
      if(!SMC_FinalOpenGate(_Symbol, ORDER_TYPE_BUY)) { ReleaseOpenLock(); return; }
      double sl = NormalizeDouble(ask - atrValue * GOMAlignSL_ATRMult, dg);
      double tp = NormalizeDouble(ask + atrValue * GOMAlignTP_ATRMult, dg);

if(SafeTradeBuy(lot, _Symbol, ask, sl, tp, "GOM-ALIGN BUY"))
       {
          RegisterOrderPlaced();
          SMC_GateRegisterOpened(_Symbol, true);
          orderExecuted = true;
          s_lastGomAlignEntry = TimeCurrent();
          ulong ticket = trade.ResultOrder();
          if(ticket > 0) SMC_ApplyPostEntrySLBuffer(_Symbol, ticket, 1.0);
          Print("ðŸš€ GOM-ALIGN BUY EXÃ‰CUTÃ‰ | Entry=", DoubleToString(ask, dg),
                " SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg),
                " Lot=", DoubleToString(lot, 2),
                " | vn=", g_smcGomVerdictNum, " TFs: M1=", g_smcTfM1Dir,
                " M5=", g_smcTfM5Dir, " M15=", g_smcTfM15Dir,
                " H1=", g_smcTfH1Dir, " H4=", g_smcTfH4Dir, " D1=", g_smcTfD1Dir);
         if(UseNotifications)
         {
            Alert("ðŸš€ GOM-ALIGN BUY ", _Symbol, " @", DoubleToString(ask, dg),
                  " vn=", g_smcGomVerdictNum, " 6TF aligned");
            SendNotification("ðŸš€ GOM-ALIGN BUY " + _Symbol + " vn=" + IntegerToString(g_smcGomVerdictNum) + " 6TF aligned");
             // WhatsApp SR20 signal
             string gomBuyMsg = "6 TFs alignes vn=" + IntegerToString(g_smcGomVerdictNum);
             SendSR20WhatsAppSignal("SR20_ENTRY", _Symbol, "BUY",
                                    ask, ask - atrValue * SL_ATRMult, ask + atrValue * TP_ATRMult,
                                    ask, 0, "GOM-ALIGN", atrValue,
                                    0, 0, gomBuyMsg);
         }
      }
      else
      {
         Print("âŒ GOM-ALIGN BUY Ã‰CHOUÃ‰ - Erreur: ", trade.ResultRetcode(), " - ", trade.ResultRetcodeDescription());
      }
   }
   else if(gomSell)
   {
      if(!CanTradeOnSymbol(_Symbol, "SELL")) { Print("ðŸš« GOM-ALIGN SELL BLOQUÃ‰ â€” Terminal plein, sens interdit, retournement ou ordre existant sur ", _Symbol); ReleaseOpenLock(); return; }
      if(!SMC_FinalOpenGate(_Symbol, ORDER_TYPE_SELL)) { ReleaseOpenLock(); return; }
      double sl = NormalizeDouble(bid + atrValue * GOMAlignSL_ATRMult, dg);
      double tp = NormalizeDouble(bid - atrValue * GOMAlignTP_ATRMult, dg);

if(SafeTradeSell(lot, _Symbol, bid, sl, tp, "GOM-ALIGN SELL"))
       {
          RegisterOrderPlaced();
          SMC_GateRegisterOpened(_Symbol, false);
          orderExecuted = true;
          s_lastGomAlignEntry = TimeCurrent();
          ulong ticket = trade.ResultOrder();
          if(ticket > 0) SMC_ApplyPostEntrySLBuffer(_Symbol, ticket, 1.0);
          Print("ðŸš€ GOM-ALIGN SELL EXÃ‰CUTÃ‰ | Entry=", DoubleToString(bid, dg),
                " SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg),
                " Lot=", DoubleToString(lot, 2),
                " | vn=", g_smcGomVerdictNum, " TFs: M1=", g_smcTfM1Dir,
                " M5=", g_smcTfM5Dir, " M15=", g_smcTfM15Dir,
                " H1=", g_smcTfH1Dir, " H4=", g_smcTfH4Dir, " D1=", g_smcTfD1Dir);
         if(UseNotifications)
         {
            Alert("ðŸš€ GOM-ALIGN SELL ", _Symbol, " @", DoubleToString(bid, dg),
                  " vn=", g_smcGomVerdictNum, " 6TF aligned");
            SendNotification("ðŸš€ GOM-ALIGN SELL " + _Symbol + " vn=" + IntegerToString(g_smcGomVerdictNum) + " 6TF aligned");
             // WhatsApp SR20 signal
             string gomSellMsg = "6 TFs alignes vn=" + IntegerToString(g_smcGomVerdictNum);
             SendSR20WhatsAppSignal("SR20_ENTRY", _Symbol, "SELL",
                                    bid, bid + atrValue * SL_ATRMult, bid - atrValue * TP_ATRMult,
                                    bid, 0, "GOM-ALIGN", atrValue,
                                    0, 0, gomSellMsg);
         }
      }
      else
      {
         Print("âŒ GOM-ALIGN SELL Ã‰CHOUÃ‰ - Erreur: ", trade.ResultRetcode(), " - ", trade.ResultRetcodeDescription());
      }
   }

   ReleaseOpenLock();

    if(orderExecuted)
       g_maxProfit = 0;
 }

//| EntrÃ©e MARKET directe Boom/Crash quand GOM GOOD/PERFECT + chaÃ®ne ACTIVE |
//| Contourne les gates LIMIT DOW et canal SMC pour entrer rapidement pendant un spike.
void ExecuteBoomCrashSpikeMarketOrder()
{
    if(!IsBoomLikeSymbol(_Symbol) && !IsCrashLikeSymbol(_Symbol)) return;
    if(BlockAllTrades) return;
    if(UseGOMVerdictFilter && (!g_smcGomConnected || g_smcGomVerdictNum == 0)) return;

    int dir = IsBoomLikeSymbol(_Symbol) ? 1 : -1;
    string action = (dir > 0) ? "BUY" : "SELL";

    // Sens natif : GainX/Boom=BUY, PainX/Crash=SELL â€” refuser le contre-verdict
    if((dir > 0 && g_smcGomVerdictNum < 0) || (dir < 0 && g_smcGomVerdictNum > 0)) return;

    // GOOD/PERFECT (|vn|>=2) : entrÃ©e libre
    // SIMPLE (|vn|==1) : autorisÃ© si chaÃ®ne ACTIVE/EXHAUSTION OU spike GOM tradable
    bool isGP = (MathAbs(g_smcGomVerdictNum) >= 2);
    bool chainOk = (g_spikeChainState == SPIKE_STATE_CHAIN_ACTIVE ||
                    g_spikeChainState == SPIKE_STATE_EXHAUSTION);
    bool spikeOk = (g_smcGomSpikeTradable || g_smcGomImminencePct >= 55.0 ||
                    (g_smcGomBarsSinceSpike >= 0 && g_smcGomBarsSinceSpike <= 3));
    if(!isGP)
    {
       if(MathAbs(g_smcGomVerdictNum) < 1) return;
       if(!chainOk && !spikeOk) return;
       Print("[SPIKE-MARKET] SIMPLE vn=", g_smcGomVerdictNum,
             " autorisÃ© (chain=", chainOk, " spikeTradable=", g_smcGomSpikeTradable,
             " imm=", DoubleToString(g_smcGomImminencePct, 1), "%)");
    }
    else if(!chainOk && !spikeOk)
    {
       // GOOD sans spike : laisser d'autres stratÃ©gies (GOM-ALIGN, LIMIT) gÃ©rer
       return;
    }

    if(!CanTradeOnSymbol(_Symbol, action)) return;
    // FIX: ce chemin "spike market" contournait volontairement les gates LIMIT/DOW,
    // mais il sautait aussi (par erreur) la pause anti-surtrading 2 gains / N pertes
    // successifs (PauseAfterTwoWinsMin / PauseAfterLossStreakMin). On la restaure ici.
    if(IsSymbolPaused(_Symbol) || IsGlobalTradingPaused())
    {
       Print("ðŸ”’ SPIKE MARKET BLOQUÃ‰ (PAUSE trading) : ", _Symbol, " ", action);
       return;
    }
    if(!TryAcquireOpenLock()) return;

    double lot = CalculateLotSize();
    if(lot <= 0) { ReleaseOpenLock(); return; }

    // Pas de SL/TP pour Boom/Crash spike MARKET (SL naturel ou trailing)
    bool noSLTP = NoSLTP_BoomCrash;
    double sl = 0, tp = 0;
    double entryPx = 0;

    if(!noSLTP)
    {
       double tickVal = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
       double tickSz  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
       double atrVal  = 0;
       if(atrHandle != INVALID_HANDLE)
       {
          double atrBuf[];
          ArraySetAsSeries(atrBuf, true);
          if(CopyBuffer(atrHandle, 0, 0, 1, atrBuf) >= 1) atrVal = atrBuf[0];
       }
       if(atrVal <= 0) atrVal = SymbolInfoDouble(_Symbol, SYMBOL_ASK) - SymbolInfoDouble(_Symbol, SYMBOL_BID);
       if(atrVal <= 0) atrVal = _Point * 10;

       entryPx = (dir > 0) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);

       double pricePerDollar = (tickVal * lot) / tickSz;
       double slDist = (pricePerDollar > 0) ? (2.0 / pricePerDollar) : atrVal * 1.0;
       slDist = NormalizeDouble(MathMax(slDist, tickSz * 2), _Digits);

       sl  = NormalizeDouble(entryPx - slDist * dir, _Digits);
       tp  = NormalizeDouble(entryPx + slDist * dir * DOW_TP_ATRMULT, _Digits);
    }

    MqlTradeRequest req = {};
    MqlTradeResult  res = {};
    ZeroMemory(req);
    ZeroMemory(res);
    req.action   = TRADE_ACTION_DEAL;
    req.symbol   = _Symbol;
    req.volume   = lot;
    req.magic    = InpMagicNumber;
    req.deviation = 30;

    if(dir > 0)
    {
       req.type   = ORDER_TYPE_BUY;
       req.price  = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
       req.sl     = sl;
       req.tp     = tp;
       req.comment = "SPIKE MARKET Boom";
    }
    else
    {
       req.type   = ORDER_TYPE_SELL;
       req.price  = SymbolInfoDouble(_Symbol, SYMBOL_BID);
       req.sl     = sl;
       req.tp     = tp;
       req.comment = "SPIKE MARKET Crash";
    }

    if(SafeOrderSend(req, res, req.comment) && res.retcode == TRADE_RETCODE_DONE)
    {
       Print("ðŸš€ BOOM/CRASH SPIKE MARKET ", action, " @ ", req.price,
             " | SL=", DoubleToString(sl, _Digits), " TP=", DoubleToString(tp, _Digits),
             " | Lot=", DoubleToString(lot, 2), " | vn=", g_smcGomVerdictNum);
       if(UseNotifications)
       {
          Alert("ðŸš€ SPIKE MARKET ", action, " ", _Symbol, " @ ", DoubleToString(req.price, _Digits));
          SendNotification("ðŸš€ SPIKE MARKET " + action + " " + _Symbol);
       }
       SendSR20WhatsAppSignal("SR20_ENTRY", _Symbol, action,
                                req.price, sl, tp, req.price,
                                0, "", 0, 0.9, 0, "Spike MARKET direct");
    }
    else
    {
       Print("âŒ BOOM/CRASH SPIKE MARKET Ã©chouÃ©: ", res.retcode, " - ", res.comment);
    }

    ReleaseOpenLock();
    g_maxProfit = 0;
 }

//| ExÃ©cuter les ordres au marchÃ© basÃ©s sur les dÃ©cisions IA SMC EMA   |
void ExecuteAIDecisionMarketOrder()
{
   if(UseGOMVerdictFilter && !SMCGP_GOMAllowsAction(g_lastAIAction))
   {
      static datetime lastGomLog = 0;
      if(TimeCurrent() - lastGomLog >= 30)
      {
         lastGomLog = TimeCurrent();
         Print("[SMC-GOM] EntrÃ©e IA bloquÃ©e â€” verdict=", g_smcGomVerdict,
               " vn=", g_smcGomVerdictNum, " connected=", g_smcGomConnected);
      }
      return;
   }

   // CatÃ©gorie du symbole pour adapter le seuil de confiance IA
   ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(_Symbol);
   double requiredConf = MinAIConfidence;
   // Pour tous les marchÃ©s HORS Boom/Crash: 85% minimum
   if(cat != SYM_BOOM_CRASH)
      requiredConf = 0.85;
   
   // VÃ©rifier si on a une dÃ©cision IA valide
   if(g_lastAIAction == "" || g_lastAIConfidence < requiredConf)
   {
      return;
   }
   
   // BLOQUER LES ORDRES SI IA EST EN HOLD
   Print("ðŸ” DEBUG HOLD (Market): g_lastAIAction = '", g_lastAIAction, "' | g_lastAIConfidence = ", DoubleToString(g_lastAIConfidence*100, 1), "%");
   
   if(g_lastAIAction == "HOLD" || g_lastAIAction == "hold")
   {
      Print("ðŸš« ORDRES MARCHÃ‰ BLOQUÃ‰S - IA en HOLD - Attente de changement de statut");
      return;
   }
   
   // Calculer une note de setup globale et bloquer si trop basse
   double setupScore = ComputeSetupScore(g_lastAIAction);
   if(setupScore < MinSetupScoreEntry)
   {
      Print("ðŸš« ORDRE IA BLOQUÃ‰ - SetupScore trop bas: ",
            DoubleToString(setupScore, 1), " < ",
            DoubleToString(MinSetupScoreEntry, 1),
            " pour ", _Symbol, " (", g_lastAIAction, ")");
      return;
   }
   
   Print("âœ… ORDRES MARCHÃ‰ AUTORISÃ‰S - IA: ", g_lastAIAction,
         " | SetupScore=", DoubleToString(setupScore, 1));

   // RÃ©entrÃ©e aprÃ¨s perte sur ce symbole: exiger conditions exceptionnelles
   if(!AllowReentryAfterRecentLoss(_Symbol, g_lastAIAction, false))
      return;
   
   // Une exposition dÃ©jÃ  ouverte sera contrÃ´lÃ©e juste avant l'envoi :
   // opposÃ© toujours interdit ; mÃªme sens autorisÃ© seulement en GOOD/PERFECT,
   // sous cap et cooldown du mode sniper.
   
   // BOOM/CRASH/PainX/GainX: GOM GOOD/PERFECT + chain spike + cross-corr
   if(cat == SYM_BOOM_CRASH || SMC_IsSpikeStyleSymbol(_Symbol))
   {
      int aiDirSign = 0;
      if(g_lastAIAction == "BUY" || g_lastAIAction == "buy") aiDirSign = 1;
      else if(g_lastAIAction == "SELL" || g_lastAIAction == "sell") aiDirSign = -1;
      if(aiDirSign == 0) return;

      string tripleReason = "";
      if(!SMC_MarketEntryTripleGateOK(aiDirSign, tripleReason))
      {
         static datetime s_lastAiTripleLog = 0;
         if(TimeCurrent() - s_lastAiTripleLog >= 30)
         {
            s_lastAiTripleLog = TimeCurrent();
            Print("ðŸš« ORDRE IA MARCHÃ‰ BLOQUÃ‰ â€” ", tripleReason);
         }
         return;
      }
      Print("âœ… SPIKE MARKET ENTRY â€” ", tripleReason, " | vn=", g_smcGomVerdictNum);
   }
   
   // BLOQUER LES ORDRES SI PRIX EST DANS UN RANGE (bypass si PERFECT)
   bool isPerfectVerdict = (g_smcGomVerdictNum >= 3 || g_smcGomVerdictNum <= -3);
   if(IsPriceInRange() && !isPerfectVerdict)
   {
      Print("ðŸš« ORDRES MARCHÃ‰ BLOQUÃ‰S - Prix dans un range sur ", _Symbol, " - Attente de breakout");
      return;
   }
   
   // VÃ©rifier le lock pour Ã©viter les doublons
   if(!TryAcquireOpenLock()) return;
   
   // RÃ¨gle Boom/Crash: pas de SELL sur Boom, pas de BUY sur Crash
   if(!IsDirectionAllowedForBoomCrash(_Symbol, g_lastAIAction))
   {
      Print("âŒ Ordre IA ", g_lastAIAction, " bloquÃ© sur ", _Symbol, " (rÃ¨gle Boom/Crash)");
      ReleaseOpenLock();
      return;
   }
   
   // VALIDATION MULTI-SIGNAUX POUR ENTRÃ‰ES PRÃ‰CISES (bypass si PERFECT)
   if(!isPerfectVerdict && !ValidateEntryWithMultipleSignals(g_lastAIAction))
   {
      Print("âŒ ENTRÃ‰E BLOQUÃ‰E - Validation multi-signaux Ã©chouÃ©e pour ", g_lastAIAction, " sur ", _Symbol);
      ReleaseOpenLock();
      return;
   }
   
   // CALCULER L'ENTRÃ‰E PRÃ‰CISE AU LIEU DU PRIX ACTUEL
   double preciseEntry, preciseSL, preciseTP;
   if(!CalculatePreciseEntryPoint(g_lastAIAction, preciseEntry, preciseSL, preciseTP))
   {
      Print("âŒ CALCUL D'ENTRÃ‰E PRÃ‰CISE Ã‰CHOUÃ‰ pour ", g_lastAIAction, " sur ", _Symbol);
      ReleaseOpenLock();
      return;
   }
   
   double lot = CalculateLotSize();
   if(lot <= 0)
   {
      ReleaseOpenLock();
      return;
   }
   
   if(UseSniperScalperMode)
   {
      double slDistPrecise = MathAbs(preciseEntry - preciseSL);
      double tpDistPrecise = 0;
      if(!SMC_ApplySniperRiskCap(_Symbol, slDistPrecise, lot, tpDistPrecise))
      {
         Print("ðŸš« ENTRÃ‰E IA PRÃ‰CISE bloquÃ©e par Sniper Risk Cap sur ", _Symbol);
         ReleaseOpenLock();
         return;
      }
      preciseTP = (g_lastAIAction == "BUY" || g_lastAIAction == "buy") ?
                  (preciseEntry + tpDistPrecise) : (preciseEntry - tpDistPrecise);
   }
   
   bool orderExecuted = false;
   string preciseDirection = (g_lastAIAction == "BUY" || g_lastAIAction == "buy") ? "BUY" : "SELL";

   if(RequireSMCDerivArrowForAllOrders && !HasRecentSMCDerivArrowForDirection(preciseDirection))
   {
      Print("ðŸš« ENTRÃ‰E SNIPER BLOQUÃ‰E - Attendre flÃ¨che SMC_DERIV_ARROW ",
            preciseDirection, " sur ", _Symbol);
      ReleaseOpenLock();
      return;
   }

   if(!CanTradeOnSymbol(_Symbol, preciseDirection))
   {
      Print("ðŸš« IA SNIPER ", preciseDirection,
            " BLOQUÃ‰E â€” conflit, sens interdit, cooldown, pending ou cap sur ", _Symbol);
      ReleaseOpenLock();
      return;
   }

   int gomQuality = SMC_CurrentGOMQuality(_Symbol, preciseDirection);
   string qualityLabel = (gomQuality >= 3) ? "PERFECT" : ((gomQuality >= 2) ? "GOOD" : "STANDARD");
   ulong sniperTicket = 0;
   string executionMode = "";
   string sniperComment = "IA SNIPER " + qualityLabel + " " + preciseDirection;

   if(SMC_PlacePreciseSniperEntry(preciseDirection, lot, preciseEntry, preciseSL, preciseTP,
                                  sniperComment, sniperTicket, executionMode))
   {
      RegisterOrderPlaced();
      orderExecuted = true;
      if(executionMode == "MARKET" && sniperTicket > 0)
         SMC_ApplyPostEntrySLBuffer(_Symbol, sniperTicket, 1.0);

      Print("ðŸŽ¯ IA SNIPER ", qualityLabel, " ", preciseDirection, " ", executionMode,
            " | Entry=", DoubleToString(preciseEntry, _Digits),
            " | SL=", DoubleToString(preciseSL, _Digits),
            " | TP=", DoubleToString(preciseTP, _Digits),
            " | Lot=", DoubleToString(lot, 2),
            " | Conf=", DoubleToString(g_lastAIConfidence * 100.0, 1), "%");

      if(UseNotifications)
      {
         string msg = "IA SNIPER " + qualityLabel + " " + preciseDirection + " " +
                      executionMode + " " + _Symbol + " @" + DoubleToString(preciseEntry, _Digits);
         Alert(msg);
         SendNotification(msg);
      }
   }
   else
   {
      Print("âŒ Ã‰chec IA SNIPER ", preciseDirection, " sur ", _Symbol,
            " | retcode=", trade.ResultRetcode(), " ", trade.ResultRetcodeDescription());
   }
   
   ReleaseOpenLock();
   
   if(orderExecuted)
   {
      // RÃ©initialiser le gain maximum pour la nouvelle position
      g_maxProfit = 0;
   }
}

//| FONCTIONS DE GESTION DES PAUSES ET BLACKLIST TEMPORAIRE        |
void InitializeSymbolPauseSystem()
{
   g_pauseCount = 0;
   for(int i = 0; i < 20; i++)
   {
      g_symbolPauses[i].symbol = "";
      g_symbolPauses[i].pauseUntil = 0;
      g_symbolPauses[i].consecutiveLosses = 0;
      g_symbolPauses[i].consecutiveWins = 0;
      g_symbolPauses[i].lastTradeTime = 0;
      g_symbolPauses[i].lastProfit = 0;
   }
}

bool IsGlobalTradingPaused()
{
   if(!UseTradingPauses) return false;
   if(g_globalPauseUntil <= 0) return false;
   if(TimeCurrent() < g_globalPauseUntil)
   {
      static datetime s_lastLog = 0;
      if(TimeCurrent() - s_lastLog >= 60)
      {
         s_lastLog = TimeCurrent();
         Print("â¸ï¸ PAUSE GLOBALE active jusqu'Ã  ", TimeToString(g_globalPauseUntil, TIME_MINUTES|TIME_SECONDS),
               " | wins=", g_globalConsecWins, " losses=", g_globalConsecLosses,
               " lossStreak=$", DoubleToString(g_globalLossStreakUSD, 2));
      }
      return true;
   }
   return false;
}

void SMC_ApplyGlobalPause(const int minutes, const string reason)
{
   if(!UseTradingPauses || minutes <= 0) return;
   datetime until = TimeCurrent() + minutes * 60;
   if(until > g_globalPauseUntil)
      g_globalPauseUntil = until;
   Print("â¸ï¸ PAUSE GLOBALE ", minutes, " min â€” ", reason,
         " | jusqu'Ã  ", TimeToString(g_globalPauseUntil, TIME_MINUTES|TIME_SECONDS));
   if(UseNotifications)
      SendNotification("â¸ï¸ PAUSE " + IntegerToString(minutes) + "min â€” " + reason);
}

// AppelÃ© Ã  chaque clÃ´ture de position de notre EA
void SMC_OnClosedTradeForPause(const double profit)
{
   if(!UseTradingPauses) return;

   if(profit > 0.0)
   {
      g_globalConsecWins++;
      g_globalConsecLosses = 0;
      g_globalLossStreakUSD = 0.0;
      g_globalLossStreakCount = 0;
      Print("ðŸ“ˆ SÃ©rie gains: ", g_globalConsecWins, " | profit=$", DoubleToString(profit, 2));
      // 2 gains successifs â†’ pause 15 min
      if(g_globalConsecWins >= 2)
      {
         SMC_ApplyGlobalPause(PauseAfterTwoWinsMin,
            StringFormat("2 gains successifs (dernier +$%.2f)", profit));
         g_globalConsecWins = 0; // reset aprÃ¨s pause armÃ©e
      }
   }
   else if(profit < 0.0)
   {
      g_globalConsecWins = 0;
      g_globalConsecLosses++;
      g_globalLossStreakCount++;
      g_globalLossStreakUSD += MathAbs(profit);
      Print("ðŸ“‰ SÃ©rie pertes: ", g_globalLossStreakCount,
            " | cumul=$", DoubleToString(g_globalLossStreakUSD, 2),
            " | dernier=$", DoubleToString(profit, 2));
      // 3 pertes successives ET cumul > 4$ â†’ pause 15 min
      if(g_globalLossStreakCount >= PauseLossStreakCount &&
         g_globalLossStreakUSD >= PauseLossStreakUSD)
      {
         SMC_ApplyGlobalPause(PauseAfterLossStreakMin,
            StringFormat("%d pertes cumulÃ©es $%.2f", g_globalLossStreakCount, g_globalLossStreakUSD));
         g_globalLossStreakCount = 0;
         g_globalLossStreakUSD = 0.0;
         g_globalConsecLosses = 0;
      }
   }
}

bool IsSymbolPaused(string symbol)
{
   if(IsGlobalTradingPaused()) return true;

   datetime currentTime = TimeCurrent();
   for(int i = 0; i < g_pauseCount; i++)
   {
      if(g_symbolPauses[i].symbol == symbol)
      {
         if(currentTime < g_symbolPauses[i].pauseUntil)
         {
            Print("ðŸš« SYMBOLE EN PAUSE: ", symbol, " - Jusqu'Ã : ", TimeToString(g_symbolPauses[i].pauseUntil, TIME_SECONDS));
            return true;
         }
         break;
      }
   }
   return false;
}

void UpdateSymbolPauseInfo(string symbol, double profit)
{
   if(!UseTradingPauses) return; // FIX: VÃ©rifier si les pauses sont activÃ©es

   datetime currentTime = TimeCurrent();
   int index = -1;

   // Trouver ou crÃ©er l'entrÃ©e pour ce symbole
   for(int i = 0; i < g_pauseCount; i++)
   {
      if(g_symbolPauses[i].symbol == symbol)
      {
         index = i;
         break;
      }
   }

   if(index == -1 && g_pauseCount < 20)
   {
      // CrÃ©er nouvelle entrÃ©e
      index = g_pauseCount;
      g_symbolPauses[index].symbol = symbol;
      g_symbolPauses[index].pauseUntil = 0;
      g_symbolPauses[index].consecutiveLosses = 0;
      g_symbolPauses[index].consecutiveWins = 0;
      g_symbolPauses[index].cumulativeLossUSD = 0;
      g_pauseCount++;
      Print("ðŸ”§ [PAUSE] Nouvelle entrÃ©e crÃ©Ã©e pour: ", symbol);
   }

   if(index >= 0)
   {
      // Mettre Ã  jour les compteurs
      if(profit < 0)
      {
         g_symbolPauses[index].consecutiveLosses++;
         g_symbolPauses[index].consecutiveWins = 0;
         g_symbolPauses[index].cumulativeLossUSD += MathAbs(profit);
         Print("ðŸ“‰ [PAUSE] PERTE: ", symbol, " | -$", DoubleToString(MathAbs(profit), 2),
               " | Pertes consÃ©cutives: ", g_symbolPauses[index].consecutiveLosses, "/",
               PauseLossStreakCount, " | Cumul: $", DoubleToString(g_symbolPauses[index].cumulativeLossUSD, 2),
               " / Seuil: $", DoubleToString(PauseLossStreakUSD, 2));
      }
      else if(profit > 0)
      {
         g_symbolPauses[index].consecutiveWins++;
         g_symbolPauses[index].consecutiveLosses = 0;
         g_symbolPauses[index].cumulativeLossUSD = 0; // Reset cumul sur gain
         Print("ðŸ“ˆ [PAUSE] GAIN: ", symbol, " | +$", DoubleToString(profit, 2),
               " | Gains consÃ©cutifs: ", g_symbolPauses[index].consecutiveWins, "/2");
      }

      g_symbolPauses[index].lastTradeTime = currentTime;
      g_symbolPauses[index].lastProfit = profit;
   }
}

bool ShouldPauseSymbol(string symbol, double profit)
{
   // Pause symbole: 2 gains d'affilÃ©e
   if(profit > 0)
   {
      for(int i = 0; i < g_pauseCount; i++)
      {
         if(g_symbolPauses[i].symbol == symbol)
         {
            if(g_symbolPauses[i].consecutiveWins >= 2)
            {
               Print("ðŸš« [PAUSE] Symbole ", symbol, " â€” 2 gains successifs â†’ pause ", PauseAfterTwoWinsMin, " min");
               return true;
            }
            break;
         }
      }
   }
   // Pause symbole: pertes cumulÃ©es (FIX: vÃ©rifier cumul USD ET nombre de pertes)
   if(profit < 0)
   {
      for(int i = 0; i < g_pauseCount; i++)
      {
         if(g_symbolPauses[i].symbol == symbol)
         {
            // Condition: 2 pertes successives ET cumul >= $2
            if(g_symbolPauses[i].consecutiveLosses >= PauseLossStreakCount &&
               g_symbolPauses[i].cumulativeLossUSD >= PauseLossStreakUSD)
            {
               Print("ðŸš« [PAUSE] Symbole ", symbol, " â€” ",
                     g_symbolPauses[i].consecutiveLosses, " pertes successives, cumul $",
                     DoubleToString(g_symbolPauses[i].cumulativeLossUSD, 2), " â†’ pause ",
                     PauseAfterLossStreakMin, " min");
               return true;
            }
            break;
         }
      }
   }
   return false;
}

void ApplySymbolPause(string symbol, int minutes)
{
   datetime currentTime = TimeCurrent();
   datetime pauseUntil = currentTime + (minutes * 60);
   
   for(int i = 0; i < g_pauseCount; i++)
   {
      if(g_symbolPauses[i].symbol == symbol)
      {
         g_symbolPauses[i].pauseUntil = pauseUntil;
         Print("â¸ï¸ SYMBOLE MIS EN PAUSE: ", symbol, " - DurÃ©e: ", minutes, " minutes | Jusqu'Ã : ", TimeToString(pauseUntil, TIME_SECONDS));
         break;
      }
   }
}

//| DÃ‰TECTION DE RANGE - Ã‰VITER DE TRADER DANS LES RANGES         |
bool DetectPriceRange()
{
   // Utiliser les 20 derniÃ¨res bougies pour dÃ©tecter un range
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 20, rates) < 20) return false;
   
   double highs[], lows[];
   ArrayResize(highs, 20);
   ArrayResize(lows, 20);
   
   for(int i = 0; i < 20; i++)
   {
      highs[i] = rates[i].high;
      lows[i] = rates[i].low;
   }
   
   // Calculer le plus haut et plus bas sur la pÃ©riode
   double highestHigh = rates[0].high;
   double lowestLow = rates[0].low;
   
   for(int i = 1; i < 20; i++)
   {
      if(rates[i].high > highestHigh) highestHigh = rates[i].high;
      if(rates[i].low < lowestLow) lowestLow = rates[i].low;
   }
   
   double rangeSize = highestHigh - lowestLow;
   double currentPrice = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   
   // DÃ©terminer si le prix est dans le range (zone mÃ©diane 40-60%)
   double rangeMiddle = lowestLow + (rangeSize * 0.5);
   double rangeWidth = rangeSize * 0.2; // 20% de chaque cÃ´tÃ© du milieu
   
   bool inRange = (currentPrice >= (rangeMiddle - rangeWidth) && currentPrice <= (rangeMiddle + rangeWidth));
   
   // CritÃ¨res supplÃ©mentaires pour confirmer le range
   bool isConsolidating = false;
   
   // VÃ©rifier si les bougies ont des corps petits (indique de consolidation)
   double avgBodySize = 0;
   for(int i = 0; i < 20; i++)
   {
      double bodySize = MathAbs(rates[i].close - rates[i].open);
      avgBodySize += bodySize;
   }
   avgBodySize /= 20;
   
   // Si les corps sont petits par rapport au range, c'est une consolidation
   isConsolidating = (avgBodySize < rangeSize * 0.1);
   
   // DÃ©tection finale de range
   bool isRange = inRange && isConsolidating && (rangeSize > 0);
   
   if(isRange)
   {
      Print("ðŸ” RANGE DÃ‰TECTÃ‰ sur ", _Symbol, 
             " | Range: ", DoubleToString(lowestLow, _Digits), " - ", DoubleToString(highestHigh, _Digits),
             " | Prix actuel: ", DoubleToString(currentPrice, _Digits),
             " | Largeur range: ", DoubleToString(rangeSize, _Digits),
             " | Corps moyen: ", DoubleToString(avgBodySize, _Digits));
   }
   
   return isRange;
}

bool IsPriceInRange()
{
   return DetectPriceRange();
}

//| VÃ©rifie si les niveaux BUY/SELL limit sont trop serrÃ©s (indique range) |
bool AreLimitLevelsTooClose(double atr)
{
   if(atr <= 0) return false;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double midPrice = (bid + ask) / 2.0;

   string srcBuy = "", srcSell = "";
   double buyLevel = GetClosestBuyLevel(midPrice, atr, MaxDistanceLimitATR, srcBuy);
   double sellLevel = GetClosestSellLevel(midPrice, atr, MaxDistanceLimitATR, srcSell);

   // Si aucun niveau trouvÃ©, pas de blocage
   if(buyLevel <= 0 || sellLevel <= 0) return false;

   // Calculer la distance entre les niveaux
   double levelSpacing = sellLevel - buyLevel;
   double minSpacing = atr * LimitSpacingMinATR;

   // Si l'Ã©cart est infÃ©rieur au seuil minimum â†’ range dÃ©tectÃ©
   if(levelSpacing < minSpacing)
   {
      Print("ðŸš« [LIMIT SPACING] Niveaux trop serrÃ©s: BUY=", DoubleToString(buyLevel, 5),
            " (", srcBuy, ") | SELL=", DoubleToString(sellLevel, 5), " (", srcSell, ")",
            " | Ã‰cart=", DoubleToString(levelSpacing, 5), " / Min=", DoubleToString(minSpacing, 5),
            " ATR | MARKET bloquÃ©");
      return true;
   }

   return false;
}

//| NOTE DE SETUP IA (0-100)                                         |
double ComputeSetupScore(const string direction)
{
   // 1) Base: confiance IA (0-60 pts)
   double score = 0.0;
   double confPct = g_lastAIConfidence * 100.0;
   if(confPct < 0.0) confPct = 0.0;
   if(confPct > 100.0) confPct = 100.0;
   score += confPct * 0.60;

   // 2) Alignement et cohÃ©rence (0-20 pts chaque) Ã  partir des chaÃ®nes "xx.x%"
   double alignPct = 0.0, cohPct = 0.0;
   if(StringLen(g_lastAIAlignment) > 0)
   {
      string s = g_lastAIAlignment;
      StringReplace(s, "%", "");
      alignPct = StringToDouble(s);
      if(alignPct < 0.0) alignPct = 0.0;
      if(alignPct > 100.0) alignPct = 100.0;
   }
   if(StringLen(g_lastAICoherence) > 0)
   {
      string s2 = g_lastAICoherence;
      StringReplace(s2, "%", "");
      cohPct = StringToDouble(s2);
      if(cohPct < 0.0) cohPct = 0.0;
      if(cohPct > 100.0) cohPct = 100.0;
   }
   score += alignPct * 0.20;
   score += cohPct * 0.20;

   // 2b) GOM verdict bonus â€” PERFECT/GOOD dans la bonne direction booste le score
   string dir = direction;
   StringToUpper(dir);
   if(g_smcGomConnected && g_smcGomVerdictNum != 0)
   {
      bool gomAligned = (dir == "BUY" && g_smcGomVerdictNum > 0) ||
                        (dir == "SELL" && g_smcGomVerdictNum < 0);
      if(gomAligned)
      {
         int absVn = MathAbs(g_smcGomVerdictNum);
         if(absVn >= 3) score += 25.0;      // PERFECT
         else if(absVn >= 2) score += 18.0;  // GOOD
         else score += 8.0;                  // BUY/SELL simple
      }
      // GOM coherence comme substitut si IA coherence vide
      if(cohPct <= 0.0 && g_smcGomCoherence > 0)
      {
         cohPct = g_smcGomCoherence;
         score += cohPct * 0.20;
      }
   }

   // 3) Contexte de tendance HTF (bonus/malus)
   bool bullHTF = IsBullishHTF();
   bool bearHTF = IsBearishHTF();

   if(dir == "BUY" && bullHTF)       score += 5.0;
   if(dir == "SELL" && bearHTF)      score += 5.0;
   if(dir == "BUY" && bearHTF)       score -= 10.0;
   if(dir == "SELL" && bullHTF)      score -= 10.0;

   // 4) Ã‰viter les ranges (gros malus si range dÃ©tectÃ©)
   if(IsPriceInRange())
      score -= 15.0;

   // Clamp final 0-100
   if(score < 0.0)   score = 0.0;
   if(score > 100.0) score = 100.0;

   Print("ðŸ“Š SETUP SCORE ", _Symbol, " ", dir, " = ", DoubleToString(score, 1),
         " (Conf=", DoubleToString(confPct,1), "% Align=", DoubleToString(alignPct,1),
         "% Coh=", DoubleToString(cohPct,1), "%)");

   return score;
}

//| MÃ‰TRIQUES ML FALLBACK - SI SERVEUR IA INDISPONIBLE          |
void GenerateFallbackMLMetrics()
{
   // Si le serveur IA n'est pas connectÃ©, gÃ©nÃ©rer des mÃ©triques basiques
   if(!g_aiConnected)
   {
      // Calculer des mÃ©triques basÃ©es sur l'analyse technique locale
      double currentPrice = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      MqlRates rates[];
      ArraySetAsSeries(rates, true);
      
      if(CopyRates(_Symbol, PERIOD_M1, 0, 20, rates) >= 20)
      {
         // Calculer la tendance simple
         double priceChange = rates[0].close - rates[19].close;
         bool isUptrend = priceChange > 0;
         
         // Calculer la volatilitÃ©
         double avgRange = 0;
         for(int i = 0; i < 20; i++)
         {
            avgRange += rates[i].high - rates[i].low;
         }
         avgRange /= 20;
         
         // GÃ©nÃ©rer des mÃ©triques de fallback
         if(isUptrend)
         {
            g_lastAIAction = "BUY";
            g_lastAIConfidence = MathMin(0.65, 0.5 + (priceChange / currentPrice) * 10); // Max 65%
         }
         else
         {
            g_lastAIAction = "SELL";
            g_lastAIConfidence = MathMin(0.65, 0.5 + MathAbs(priceChange / currentPrice) * 10); // Max 65%
         }
         
         // Alignement et cohÃ©rence basÃ©s sur la volatilitÃ©
         double volatilityScore = MathMin(1.0, avgRange / currentPrice * 100);
         g_lastAIAlignment = DoubleToString(volatilityScore * 80, 1) + "%"; // Max 80%
         g_lastAICoherence = DoubleToString(volatilityScore * 70, 1) + "%"; // Max 70%
         
         g_lastAISource = "FALLBACK_TREND";
         Print("ðŸ¤– MÃ‰TRIQUES FALLBACK - Action: ", g_lastAIAction, 
               " | Confiance: ", DoubleToString(g_lastAIConfidence * 100, 1), "%",
               " | Alignement: ", g_lastAIAlignment,
               " | CohÃ©rence: ", g_lastAICoherence);
      }
      else
      {
         // Valeurs par dÃ©faut si pas assez de donnÃ©es
         g_lastAIAction = "HOLD";
         g_lastAIConfidence = 0.0;
         g_lastAIAlignment = "0.0%";
         g_lastAICoherence = "0.0%";
         g_lastAISource = "FALLBACK_RAND";
         
         Print("âš ï¸ MÃ‰TRIQUES DÃ‰FAUT - Pas assez de donnÃ©es pour fallback");
      }
   }
}

//| FONCTIONS IA - COMMUNICATION AVEC LE SERVEUR                       |

bool UpdateAIDecision(int timeoutMs = -1)
{
   // DÃ©porter toute la logique rÃ©seau sur GetAISignalData()
   bool ok = GetAISignalData();
   if(!ok)
   {
      // En cas d'Ã©chec complet, gÃ©nÃ©rer immÃ©diatement un fallback local
      GenerateFallbackAIDecision();
      return false;
   }
   // GetAISignalData met dÃ©jÃ  Ã  jour g_lastAIAction / g_lastAIConfidence / alignement / cohÃ©rence
   Print("âœ… DÃ©cision IA mise Ã  jour via /decision - Action: ", g_lastAIAction,
         " | Confiance: ", DoubleToString(g_lastAIConfidence*100, 1), "%");
   return true;
}

string GetAISignalData(string symbol, string timeframe)
{
   string symEnc = symbol;
   StringReplace(symEnc, " ", "%20");
   
   string baseUrl = AI_ServerURL;
   string path = "/ml/signal?symbol=" + symEnc + "&timeframe=" + timeframe;
   string headers = "";
   char post[], result[];
   string resultHeaders;
   
   int res = WebRequest("GET", baseUrl + path, headers, AI_Timeout_ms, post, result, resultHeaders);
   
   if(res == 200)
   {
      return CharArrayToString(result);
   }
   
   return "";
}

