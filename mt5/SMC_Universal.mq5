bool SMC_AllowEAExitAfterM1Bars(const ulong ticket, const string reason,
                                const bool spikeCaptureException = false);

class SMC_GatedTrade : public CTrade
{
public:
   // FIX v1.36 (trailing / securisation du gain) :
   // La porte "6 bougies M1" (SMC_AllowEAExitAfterM1Bars) est DEJA appliquee
   // UNE SEULE FOIS dans PositionCloseWithLogEx(), et elle est volontairement
   // court-circuitee quand forceClose=true.
   // La re-application ici bloquait AUSSI toutes les fermetures d'URGENCE
   // (hard loss, giveback DynSL, anti-hedge, conflit IA) : un trade spike de
   // moins de ~6 min ne pouvait plus securiser son gain a +0.50$ et repartait
   // en perte. Les appels directs a trade.PositionClose ci-dessous sont tous
   // des sorties de protection -> pas de re-gate.
   bool PositionClose(const ulong ticket, const ulong deviation = ULONG_MAX)
   {
      return CTrade::PositionClose(ticket, deviation);
   }

   bool PositionClosePartial(const ulong ticket, const double volume, const ulong deviation = ULONG_MAX)
   {
      return CTrade::PositionClosePartial(ticket, volume, deviation);
   }

   bool PositionCloseAfterCapturedSpike(const ulong ticket, const string reason)
   {
      return CTrade::PositionClose(ticket, ULONG_MAX);
   }
};

