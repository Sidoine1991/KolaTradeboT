input group "=== STAGNATION / TEMPS DE DETENTION ==="
input bool   UseStagnationTimeExit     = true;   // Active la garde stagnation + filet de securite temps
input double StagnationMinPeakUSD      = 0.20;   // Pic de gain min ($) avant d'activer la detection de stagnation
