// Une sortie EA ne peut Ãªtre exÃ©cutÃ©e qu'aprÃ¨s six bougies M1 entiÃ¨rement clÃ´turÃ©es.
bool SMC_AllowEAExitAfterM1Bars(const ulong ticket, const string reason,
                                const bool spikeCaptureException)
{
   if(!PositionSelectByTicket(ticket))
      return false;

   string symbol = PositionGetString(POSITION_SYMBOL);
   double profit = PositionGetDouble(POSITION_PROFIT) +
                   PositionGetDouble(POSITION_SWAP);
   if(spikeCaptureException && profit > 0.0 &&
      StringFind(reason, "Spike close") >= 0)
   {
      Print("[EXIT-GATE] Exception capture spike | ", symbol, " #", ticket,
            " | P/L=", DoubleToString(profit, 2), "$ | ", reason);
      return true;
   }

   datetime openTime = (datetime)PositionGetInteger(POSITION_TIME);
   MqlRates closedBars[];
   ArraySetAsSeries(closedBars, true);

   const int requiredBars = 6;
   int copied = CopyRates(symbol, PERIOD_M1, 1, requiredBars, closedBars);
   int barsSinceOpen = 0;
   if(copied > 0)
   {
      for(int i = 0; i < copied; i++)
      {
         if(closedBars[i].time >= openTime)
            barsSinceOpen++;
      }
   }

   if(copied >= requiredBars && barsSinceOpen >= requiredBars)
      return true;

   static datetime lastLogMinute = 0;
   static ulong lastLogTicket = 0;
   datetime currentMinute = (datetime)(TimeCurrent() / 60 * 60);
   if(lastLogMinute != currentMinute || lastLogTicket != ticket)
   {
      lastLogMinute = currentMinute;
      lastLogTicket = ticket;
      Print("[EXIT-GATE] Fermeture EA retardee | ", symbol, " #", ticket,
            " | M1 cloturees depuis ouverture=", barsSinceOpen, "/",
            requiredBars, " | raison=", reason);
   }
   return false;
}

//+------------------------------------------------------------------+
//| WRAPPER POUR CAPTURER TOUTES LES FERMETURES                    |
//+------------------------------------------------------------------+
bool PositionCloseWithLogEx(ulong ticket, string reason, bool forceClose,
                            bool spikeCaptureException)
{
   bool capturedSpikeClose = spikeCaptureException &&
      StringFind(reason, "Spike close") >= 0 &&
      PositionSelectByTicket(ticket) &&
      PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP) > 0.0;

   // FIX: Si forceClose=true, bypass toutes les protections (fermeture manuelle/urgence)
   if(!forceClose && !capturedSpikeClose)
   {
      if(!SMC_AllowEAExitAfterM1Bars(ticket, reason, capturedSpikeClose))
         return false;
   }

   string symbol = "";
   double profit = 0.0;
   string gomVerdict = "NO_GOM";
   // Obtenir les informations avant fermeture
   if(PositionSelectByTicket(ticket))
   {
      symbol = PositionGetString(POSITION_SYMBOL);
      profit = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
      datetime openTime = (datetime)PositionGetInteger(POSITION_TIME);
      int secondsSinceOpen = (int)(TimeCurrent() - openTime);

      // Reset whipsaw tracker lors de la fermeture d'une position
      ResetWhipsawTracker();

      // Seuils anti-thrash : ne pas sortir avant ~2$ de perte / Ã¢ge min
      // (sauf HARD LOSS dÃ©jÃ  >= UniversalMaxLossUSD)
      double minLossBeforeClose = MathMax(0.50, MinLossBeforeAutoCloseUSD);
      double hardMaxLoss = MathMin(MaxLossHardCapDollars, MathMin(MaxLossDollars, UniversalMaxLossUSD));
      if(hardMaxLoss <= 0.0) hardMaxLoss = 3.0;
      if(hardMaxLoss > 4.50) hardMaxLoss = 4.50;
      const int minHoldSec = MathMax(MinPositionLifetimeSec, 90);

      bool isHardLoss = (profit <= -hardMaxLoss);
      bool isProfitOk = (profit >= 0.0);
      bool protectCapturedGain = isProfitOk && (
         capturedSpikeClose ||
         StringFind(reason, "giveback") >= 0 ||
         StringFind(reason, "Garde") >= 0 ||
         StringFind(reason, "1er spike") >= 0);

      // FIX v1.11: GOOD/PERFECT â†’ WAIT : fermer dÃ¨s perte >= 0.50$ (bypass anti-thrash 2$)
      bool isWaitExit = (StringFind(reason, "WAIT") >= 0 || StringFind(reason, "Wait") >= 0);
      double waitLossTh = MathMax(0.50, MathMin(GOMWaitCloseMinLossUSD, CloseOnWaitLossMinUSD));
      bool waitExitAllowed = (isWaitExit && !isProfitOk && profit <= -waitLossTh);
      
      // FIX: forceClose bypass toutes les protections sauf hard loss dÃ©jÃ  gÃ©rÃ©
      bool bypassProtections = forceClose || waitExitAllowed || capturedSpikeClose || isHardLoss || protectCapturedGain;
      
      if(!bypassProtections)
      {
         // 1) Ã‚ge minimum â€” ne pas sortir un trade neuf, SAUF hard loss
         if(!isHardLoss && !protectCapturedGain && secondsSinceOpen < minHoldSec)
         {
            Print("[PROTECT] Fermeture bloquÃ©e (Ã¢ge ", secondsSinceOpen, "s < ", minHoldSec,
                  "s) | P/L=", DoubleToString(profit, 2), "$ | raison=", reason,
                  " | force=", forceClose);
            return false;
         }

         // 2) Perte trop petite â€” JAMAIS fermer (mÃªme forceClose) avant le seuil ~2$
         //    (sauf WAIT-exit ci-dessus)
         if(!isHardLoss && !isProfitOk && profit > -minLossBeforeClose)
         {
            Print("[PROTECT] Fermeture bloquÃ©e (perte ", DoubleToString(profit, 2),
                  "$ > -", DoubleToString(minLossBeforeClose, 2), "$) | Ã¢ge=", secondsSinceOpen,
                  "s | raison=", reason, " | force=", forceClose,
                  " â€” attendre seuil perte avant dÃ©cision");
            return false;
         }
      }

      if(isHardLoss)
      {
         Print("âš ï¸ PERTE HARD MAX â€” Fermeture autorisÃ©e");
         Print("   ðŸ“Š Position: ", symbol, " | Ticket: ", ticket);
         Print("   ðŸ’° Perte: ", DoubleToString(profit, 2), "$ â‰¤ -",
               DoubleToString(hardMaxLoss, 2), "$");
         Print("   âœ… Raison: ", reason);
      }
      else if(isProfitOk)
      {
         Print("ðŸ’° POSITION EN GAIN - Fermeture autorisÃ©e");
         Print("   ðŸ“Š Position: ", symbol, " | Ticket: ", ticket);
         Print("   ðŸ’° Profit: ", DoubleToString(profit, 2), "$");
      }
      else
      {
         Print("âš ï¸ PERTE SEUIL ATTEINT - Fermeture autorisÃ©e");
         Print("   ðŸ“Š Position: ", symbol, " | Ticket: ", ticket);
         Print("   ðŸ’° Perte: ", DoubleToString(profit, 2), "$ â‰¤ -",
               DoubleToString(minLossBeforeClose, 2), "$");
         Print("   âœ… Raison: ", reason);
      }

      Print("ðŸš¨ FERMETURE DÃ‰TECTÃ‰E - ", symbol,
            " | Ticket: ", ticket,
            " | Profit: ", DoubleToString(profit, 2), "$",
            " | Ã‚ge: ", secondsSinceOpen, "s",
            " | Raison: ", reason);
   }

   // ExÃ©cuter la fermeture rÃ©elle
   bool result = capturedSpikeClose
      ? trade.PositionCloseAfterCapturedSpike(ticket, reason)
      : trade.PositionClose(ticket);

   // Si fermeture rÃ©ussie, rÃ©initialiser g_maxProfit pour la prochaine position
   if(result)
   {
      g_maxProfit = 0;
      Print("âœ… g_maxProfit rÃ©initialisÃ© pour la prochaine position");
      
      SMC_LiveGOMEntry_RegisterClose(symbol, profit);
      // FIX 2026-09-20 (Opportunity Filter) : Enregistrer le gain/perte
      if(profit >= 0)
         SMC_OPF_RegisterWin(symbol);
      else
         SMC_OPF_RegisterLoss(symbol);
      
      // FIX 2026-09-20 (GOM Trust) : Enregistrer le trade avec le verdict GOM
      gomVerdict = (g_smcGomConnected) ? g_smcGomVerdict : "NO_GOM";
      SMC_GOMTrust_RegisterTrade(symbol, gomVerdict, profit);
   }

   return result;
}

bool PositionCloseWithLog(ulong ticket, string reason = "", bool forceClose = false)
{
   return PositionCloseWithLogEx(ticket, reason, forceClose, false);
}

bool PositionCloseWithLogSpikeCapture(ulong ticket, string reason, bool forceClose = false)
{
   return PositionCloseWithLogEx(ticket, reason, forceClose, true);
}

