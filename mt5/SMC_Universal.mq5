// SMC_GetSymbolCategory â€” voir modules/SMC_SymbolCategory.mqh (include ligne 46)

// Un symbole se comporte-t-il comme un indice "spike" (Boom/Crash Deriv, Painx/Gainx Weltrade)?
bool SMC_IsSpikeStyleSymbol(const string symbol)
{
   return (SMC_GetSymbolCategory(symbol) == SYM_BOOM_CRASH);
}

// Symbole Weltrade synthÃ©tique (PainX/GainX) â€” subset de SYM_BOOM_CRASH
bool SMC_IsWeltradeSynthSymbol(const string symbol)
{
   string s = symbol;
   StringToUpper(s);
   return (StringFind(s, "PAINX") >= 0 || StringFind(s, "GAINX") >= 0);
}

// Symboles autonomes (stratÃ©gie GOM autonome autorisÃ©e)
bool SMC_IsSyntheticAutonomousSym(const string symbol)
{
   string s = symbol;
   StringToUpper(s);
   // PainX / GainX / Boom / Crash / Vol index Weltrade
   if(StringFind(s, "PAINX") >= 0 || StringFind(s, "GAINX") >= 0)
      return true;
   if(StringFind(s, "BOOM") >= 0 || StringFind(s, "CRASH") >= 0)
      return true;
   string sc = s;
   StringReplace(sc, " ", "");
   if(StringFind(sc, "FXVOL") >= 0 || StringFind(sc, "SFXVOL") >= 0 ||
      StringFind(sc, "SFVVOL") >= 0 || StringFind(sc, "FLIPX") >= 0 ||
      StringFind(sc, "PLUSX") >= 0 || StringFind(sc, "FLIP") >= 0 ||
      StringFind(sc, "PLUS") >= 0)
      return true;
   return false;
}

// SMC_GOMAutonomousAllowed â†’ corps dans SMC_Stubs.mqh (ne pas redÃ©finir)

// Weltrade helpers
bool SMC_IsWeltradeSymbol(const string symbol)
{
   string s = symbol;
   StringToUpper(s);
   string sc = s;
   StringReplace(sc, " ", "");
   return (StringFind(s, "PAINX") >= 0 || StringFind(s, "GAINX") >= 0 ||
           StringFind(sc, "FXVOL") >= 0 || StringFind(sc, "SFVVOL") >= 0 ||
           StringFind(sc, "SFXVOL") >= 0 ||
           StringFind(s, "FX VOL") >= 0 || StringFind(s, "SFX VOL") >= 0 ||
           StringFind(s, "SFV VOL") >= 0);
}

// Helpers: Boom-like (Boom + Gainx) et Crash-like (Crash + Painx)
bool IsBoomLikeSymbol(const string symbol)
{
   string s = symbol;
   StringToUpper(s);
   return (StringFind(s, "BOOM") >= 0 || StringFind(s, "GAINX") >= 0);
}
bool IsCrashLikeSymbol(const string symbol)
{
   string s = symbol;
   StringToUpper(s);
   return (StringFind(s, "CRASH") >= 0 || StringFind(s, "PAINX") >= 0);
}

// RÃ¨gle directionnelle spÃ©cifique Boom/Crash:
// - Sur Boom/Gainx: uniquement BUY (jamais SELL)
// - Sur Crash/Painx: uniquement SELL (jamais BUY)
// EXCEPTION: Mode Loss Recover autorise BUY sur PainX et SELL sur GainX
bool IsDirectionAllowedForBoomCrash(const string symbol, const string action)
{
   string a = action;
   StringToUpper(a);

   // FIX v1.30: Loss Recover exception - autoriser BUY sur PainX et SELL sur GainX
   if(g_lossRecoverArmed && g_lossRecoverSymbol == symbol)
   {
      int dirSign = (a == "BUY") ? 1 : -1;
      if(IsCrashLikeSymbol(symbol) && a == "BUY")
      {
         // PainX BUY autorisÃ© en Loss Recover si conditions strictes OK
         if(SMC_LossRecoverConditionsOK(symbol, dirSign))
         {
            Print("ðŸ”„ LOSS RECOVER - BUY autorisÃ© sur PainX ", symbol);
            return true;
         }
         else
         {
            Print("âŒ LOSS RECOVER - BUY refusÃ© sur PainX ", symbol, " (conditions non remplies)");
            return false;
         }
      }
      if(IsBoomLikeSymbol(symbol) && a == "SELL")
      {
         // GainX SELL autorisÃ© en Loss Recover si conditions strictes OK
         if(SMC_LossRecoverConditionsOK(symbol, dirSign))
         {
            Print("ðŸ”„ LOSS RECOVER - SELL autorisÃ© sur GainX ", symbol);
            return true;
         }
         else
         {
            Print("âŒ LOSS RECOVER - SELL refusÃ© sur GainX ", symbol, " (conditions non remplies)");
            return false;
         }
      }
   }

   if(IsBoomLikeSymbol(symbol) && a == "SELL")
      return false;
    if(IsCrashLikeSymbol(symbol) && a == "BUY")
       return false;
    return true;
}

//+------------------------------------------------------------------+
//| DÃ©tecte si le prix est en zone de correction/correction          |
//| Retourne true si en correction â†’ bloquer les LIMIT DOW           |
//+------------------------------------------------------------------+
// Helper: obtenir le trend EMA21 vs EMA50 sur un TF
int GetEMATrend(const string symbol, const ENUM_TIMEFRAMES tf)
{
   double emaBuf[];
   ArraySetAsSeries(emaBuf, true);
   double ema21 = 0, ema50 = 0;
   int ema21H = iMA(symbol, tf, 21, 0, MODE_EMA, PRICE_CLOSE);
   int ema50H_local = iMA(symbol, tf, 50, 0, MODE_EMA, PRICE_CLOSE);
   if(ema21H != INVALID_HANDLE && ema50H_local != INVALID_HANDLE)
   {
      if(CopyBuffer(ema21H, 0, 0, 1, emaBuf) >= 1) ema21 = emaBuf[0];
      if(CopyBuffer(ema50H_local, 0, 0, 1, emaBuf) >= 1) ema50 = emaBuf[0];
   }
   if(ema21 > ema50) return 1;  // Bullish
   if(ema21 < ema50) return -1; // Bearish
   return 0; // Neutre
}

bool SMC_IsCorrectionZoneForDirection(const string symbol, const int dirSign)
{
   // NOUVELLE LOGIQUE: Bloquer SEULEMENT si M1 va changer de direction par rapport aux autres TF
   // Si tous les TF (H1, M15, M5, M1) sont alignÃ©s dans le mÃªme sens â†’ PAS de blocage
   // Si M1 est dans le sens opposÃ© Ã  H1/M15/M5 â†’ blocage (changement de direction imminent)

   // 1) DÃ©terminer la direction du trend sur chaque TF via EMA21 vs EMA50
   int m1Trend = GetEMATrend(symbol, PERIOD_M1);
   int m5Trend = GetEMATrend(symbol, PERIOD_M5);
   int m15Trend = GetEMATrend(symbol, PERIOD_M15);
   int h1Trend = GetEMATrend(symbol, PERIOD_H1);

   // 2) Compter combien de TF sont alignÃ©s avec la direction demandÃ©e
   int alignedTF = 0;
   if(m1Trend == dirSign) alignedTF++;
   if(m5Trend == dirSign) alignedTF++;
   if(m15Trend == dirSign) alignedTF++;
   if(h1Trend == dirSign) alignedTF++;

   // 3) Logique de blocage:
   // - Si M1 est OPPOSÃ‰ Ã  la direction demandÃ©e ET que les autres TF (M5, M15, H1) sont alignÃ©s avec la direction
   //   â†’ C'est un changement de direction imminent sur M1 â†’ BLOQUER
   // - Si M1 est alignÃ© avec la direction demandÃ©e â†’ PAS de blocage (continuitÃ© de tendance)
   // - Si les TF sont divergents (pas clair) â†’ PAS de blocage (laissons le verdict GOM dÃ©cider)

   // Cas 1: M1 opposÃ© Ã  la direction demandÃ©e
   if(m1Trend != 0 && m1Trend != dirSign)
   {
      // VÃ©rifier si les autres TF (M5, M15, H1) sont alignÃ©s avec la direction demandÃ©e
      int higherTFAligned = 0;
      if(m5Trend == dirSign) higherTFAligned++;
      if(m15Trend == dirSign) higherTFAligned++;
      if(h1Trend == dirSign) higherTFAligned++;

      // Si au moins 2 des 3 TF supÃ©rieurs sont alignÃ©s avec la direction mais M1 est opposÃ©
      // â†’ M1 va changer de direction â†’ BLOQUER
      if(higherTFAligned >= 2)
      {
         Print("âš ï¸ CORRECTION dÃ©tectÃ©e: M1 trend=", m1Trend, " opposÃ© Ã  dir=", dirSign,
               " mais M5/M15/H1 alignÃ©s (", higherTFAligned, "/3) sur ", symbol);
         return true;
      }
   }

   // Cas 2: M1 alignÃ© avec la direction â†’ PAS de blocage
   // Cas 3: TF divergents â†’ PAS de blocage
   return false;
}

//+------------------------------------------------------------------+
//| VALIDATION NIVEAU SMC PRÃ‰CIS â€” Ã©viter entrÃ©es pÃªle-mÃªle         |
//| Exige que le prix soit Ã  un niveau SMC clÃ© + confirmation M5    |
//+------------------------------------------------------------------+
bool SMC_IsAtValidSMCLevel(const string symbol, const int dirSign, string &levelName)
{
   levelName = "";
   double price = (dirSign > 0) ? SymbolInfoDouble(symbol, SYMBOL_ASK) : SymbolInfoDouble(symbol, SYMBOL_BID);
   double atr = 0;
   int atrH = iATR(symbol, PERIOD_M5, 14);
   if(atrH != INVALID_HANDLE)
   {
      double atrBuf[];
      ArraySetAsSeries(atrBuf, true);
      if(CopyBuffer(atrH, 0, 0, 1, atrBuf) >= 1) atr = atrBuf[0];
   }
   if(atr <= 0) atr = SymbolInfoDouble(symbol, SYMBOL_POINT) * 100;
   double tolerance = atr * SMCLevelATRTolerance; // TolÃ©rance configurable

   // 1) Support/RÃ©sistance 20 bars
   if(dirSign > 0 && g_impulseSupport20 > 0)
   {
      if(MathAbs(price - g_impulseSupport20) <= tolerance)
      {
         levelName = "Support 20 bars";
         return true;
      }
   }
   else if(dirSign < 0 && g_impulseResistance20 > 0)
   {
      if(MathAbs(price - g_impulseResistance20) <= tolerance)
      {
         levelName = "RÃ©sistance 20 bars";
         return true;
      }
   }

   // 2) DOW projected level
   double dowLevel = 0;
   bool dowBearish = false;
   if(SMC_FindDOWProjectedLevel(dowLevel, dowBearish))
   {
      if((dirSign > 0 && !dowBearish) || (dirSign < 0 && dowBearish))
      {
         if(MathAbs(price - dowLevel) <= tolerance)
         {
            levelName = "DOW Projected Line";
            return true;
         }
      }
   }

   // 3) GOM_TF_TL_M1 ou M5
   double m1Level = 0;
   if(SMC_FindReactionObjectLevel(symbol, "GOM_TF_TL_M1", m1Level) && m1Level > 0)
   {
      if(MathAbs(price - m1Level) <= tolerance)
      {
         levelName = "GOM_TF_TL_M1";
         return true;
      }
   }
   double m5Level = 0;
   if(SMC_FindReactionObjectLevel(symbol, "GOM_TF_TL_M5", m5Level) && m5Level > 0)
   {
      if(MathAbs(price - m5Level) <= tolerance)
      {
         levelName = "GOM_TF_TL_M5";
         return true;
      }
   }

   // 4) Pivot High/Low (20 bars)
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(symbol, PERIOD_M5, 0, 25, rates) >= 20)
   {
      for(int i = 2; i < 18; i++)
      {
         // Pivot Low (support)
         if(dirSign > 0 && 
            rates[i].low < rates[i-1].low && rates[i].low < rates[i+1].low &&
            rates[i].low < rates[i-2].low && rates[i].low < rates[i+2].low)
         {
            if(MathAbs(price - rates[i].low) <= tolerance)
            {
               levelName = "Pivot Low";
               return true;
            }
         }
         // Pivot High (rÃ©sistance)
         if(dirSign < 0 && 
            rates[i].high > rates[i-1].high && rates[i].high > rates[i+1].high &&
            rates[i].high > rates[i-2].high && rates[i].high > rates[i+2].high)
         {
            if(MathAbs(price - rates[i].high) <= tolerance)
            {
               levelName = "Pivot High";
               return true;
            }
         }
      }
   }

   // 5) DOW BULL EP / DOW BEAR EP (Entry Point)
   string epToken = (dirSign > 0) ? "DOW_BULL_EP" : "DOW_BEAR_EP";
   double epLevel = 0;
   if(SMC_FindReactionObjectLevel(symbol, epToken, epLevel) && epLevel > 0)
   {
      if(MathAbs(price - epLevel) <= tolerance)
      {
         levelName = "DOW Entry Point";
         return true;
      }
   }

   // 6) FVG_DISP_TRAIL
   string fvgToken = (dirSign > 0) ? "SMC_DISP_FVG_TRAIL_Bull" : "SMC_DISP_FVG_TRAIL_Bear";
   double fvgLevel = 0;
   if(SMC_FindReactionObjectLevel(symbol, fvgToken, fvgLevel) && fvgLevel > 0)
   {
      if(MathAbs(price - fvgLevel) <= tolerance)
      {
         levelName = "FVG DISP TRAIL";
         return true;
      }
   }

   // 7) CHOCH/BOS (via dÃ©tection structurelle)
   int bosDir = 0;
   if(UseBOS && SMC_DetectBOS(symbol, PERIOD_M5, bosDir))
   {
      if((dirSign > 0 && bosDir > 0) || (dirSign < 0 && bosDir < 0))
      {
         levelName = "BOS Structure";
         return true;
      }
   }

   return false;
}

//+------------------------------------------------------------------+
//| Confirmation M5 pour entrÃ©e SMC prÃ©cise                           |
//+------------------------------------------------------------------+
bool SMC_HasM5Confirmation(const string symbol, const int dirSign)
{
   MqlRates m5Rates[];
   ArraySetAsSeries(m5Rates, true);
   if(CopyRates(symbol, PERIOD_M5, 0, 3, m5Rates) < 3) return false;

   double close0 = m5Rates[0].close;
   double close1 = m5Rates[1].close;
   double open0 = m5Rates[0].open;
   double open1 = m5Rates[1].open;

   // Confirmation BUY: bougie M1 bullish qui ferme au-dessus de l'ouverture
   if(dirSign > 0)
   {
      return (close0 > open0 && close0 > close1);
   }
   // Confirmation SELL: bougie M1 bearish qui ferme en-dessous de l'ouverture
   else if(dirSign < 0)
   {
      return (close0 < open0 && close0 < close1);
   }

   return false;
}

// Confirmation M15 : au moins une bougie M15 fermÃ©e rÃ©cemment dans le sens
bool SMC_HasM15Confirmation(const string symbol, const int dirSign)
{
   MqlRates m15Rates[];
   ArraySetAsSeries(m15Rates, true);
   if(CopyRates(symbol, PERIOD_M15, 0, 4, m15Rates) < 3) return false;

   // r[0] = bougie en formation ; on exige confirmation sur bougies fermÃ©es
   for(int i = 1; i < 3; i++)
   {
      double close0 = m15Rates[i].close;
      double close1 = m15Rates[i + 1].close;
      double open0  = m15Rates[i].open;
      if(dirSign > 0 && close0 > open0 && close0 > close1) return true;
      if(dirSign < 0 && close0 < open0 && close0 < close1) return true;
   }
   return false;
}

// ContrÃ´le de duplication de position:
// - Pas de duplication sur Boom/Crash (1 position max par symbole)
// - Sur autres marchÃ©s: duplication seulement si
//   * au moins 1 position existe dÃ©jÃ  sur le symbole
//   * la premiÃ¨re position est en gain >= 2$
//   * l'IA confirme la mÃªme direction avec >= 80% de confiance
bool CanOpenAdditionalPositionForSymbol(const string symbol, const string action)
{
   int existing = CountPositionsForSymbol(symbol);
   if(existing <= 0)
      return true; // premiÃ¨re position toujours autorisÃ©e

   // FIX v1.12: jamais de 2e position (scale-in OFF)
   Print("ðŸš« CanOpenAdditional â€” dÃ©jÃ  ", existing, " pos sur ", symbol, " â€” REFUS");
   return false; // v1.25: scale-in mort retirÃ© (MQL5 n'accepte pas #if 0)
}

// Compte tous les ordres LIMIT (BUY_LIMIT / SELL_LIMIT) ouverts pour ce symbole (notre EA)
int CountOpenLimitOrdersForSymbol(const string symbol)
{
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) != symbol) continue;
      if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      
      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(t == ORDER_TYPE_BUY_LIMIT || t == ORDER_TYPE_SELL_LIMIT)
         count++;
   }
   return count;
}

// Compte uniquement les ordres LIMIT issus du canal SMC (commentaire "SMC_CH ...")
int CountChannelLimitOrdersForSymbol(const string symbol)
{
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) != symbol) continue;
      if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      
      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(t != ORDER_TYPE_BUY_LIMIT && t != ORDER_TYPE_SELL_LIMIT) continue;
      
      string cmt = OrderGetString(ORDER_COMMENT);
      if(StringFind(cmt, "SMC_CH") >= 0)
         count++;
   }
   return count;
}

// Forward declarations (defined in SMC_GOM_Pipeline.mqh, included later)
int  SMCGP_GetCachedVerdictNum(const string symbol);
bool SMC_GOMCurrentVerdictIsWait(const string symbol);
void SMCGP_EnforceLimitDiscipline(const long magic, const int maxLimits = 2);
bool LimitPlaceDisciplineOK(const string symbol, const int dirSign, string &reasonOut);
bool LimitCancelAllowed(const ulong ticket, const bool forceCounterTrend = false, const string reason = "");
bool LimitSafeOrderDelete(const ulong ticket, const bool forceCounterTrend = false, const string reason = "");
void LimitRegisterCancel(const string symbol);

// â”€â”€ GATEKEEPER GOM: WAIT interdit + direction GOOD/PERFECT obligatoire â”€â”€
// dirSign: +1 BUY, -1 SELL. Retourne false si bloquÃ©.
// BLOQUE TOUT: WAIT (vn=0), SIMPLE (|vn|=1), CONTRE-VERDICT
bool CanPlaceOrderByGOM(const string symbol, const int dirSign, const string orderKind)
{
   if(MathAbs(g_smcGomVerdictNum) < 2 && MathAbs(g_smcGomVerdictNumServer) < 2 &&
      SMC_GOMCurrentVerdictIsWait(symbol))
   {
      Print("ðŸš« ", orderKind, " BLOQUÃ‰ â€” ", symbol, " â€” verdict GOM courant WAIT");
      return false;
   }
   // FIX 2026-09-14: WAIT/OFF toujours bloquÃ©, mÃªme si UseGOMVerdictFilter=false.
   SMCGP_RestoreCachedIfDisconnected();
   int vn = -999;
   if(symbol == _Symbol)
      vn = g_smcGomVerdictNum;
   if(vn == 0 || vn == -999)
   {
      if(SMCGP_GomLinkOK())
         vn = SMCGP_GetCachedVerdictNum(symbol);
      if((vn == 0 || vn == -999) && symbol == _Symbol)
         vn = g_smcGomVerdictNum;
   }
   if((vn == 0 || vn == -999) && symbol == _Symbol && MathAbs(g_smcGomVerdictNumServer) >= 2)
      vn = g_smcGomVerdictNumServer;

   if(MathAbs(vn) < 2 && (!SMCGP_GomLinkOK() || vn == -999))
   {
      Print("ðŸš« ", orderKind, " BLOQUÃ‰ â€” ", symbol, " â€” PAS DE VERDICT GOM / dÃ©connectÃ©");
      return false;
   }
   // WAIT (vn=0) : AUCUN ordre â€” sauf GOOD/PERFECT serveur
   if(vn == 0)
   {
      SMCGP_RestoreAlignedGoodIfWait(symbol);
      vn = g_smcGomVerdictNum;
   }
   if(vn == 0)
   {
      if(MathAbs(g_smcGomVerdictNumServer) >= 2 &&
         ((dirSign > 0 && g_smcGomVerdictNumServer > 0) ||
          (dirSign < 0 && g_smcGomVerdictNumServer < 0)))
      {
         vn = g_smcGomVerdictNumServer;
         g_smcGomVerdictNum = vn;
         Print("âœ… ", orderKind, " WAIT ignorÃ© â€” srv GOOD/PERFECT | vn=", vn);
      }
      else if(g_secondSpikeInFlight && SMC_SpikePredictConfirms(dirSign))
         return true;
      else
      {
         Print("ðŸš« ", orderKind, " BLOQUÃ‰ â€” ", symbol, " â€” GOM=WAIT (vn=0) â€” AUCUN ORDRE AUTORISÃ‰");
         return false;
      }
   }
   if(!UseGOMVerdictFilter) return true;
// SIMPLE (|vn|=1) : refusÃ© si RequireGoodPerfectAlways (qualitÃ© A+)
    // Sinon autorisÃ© uniquement sur symboles spike. Pas de bypass Dow.
    int minAbsVn = MinGOMVerdictNumAbs;
    if(!RequireGoodPerfectAlways && SMCGP_IsSpikeTradableSym(symbol))
       minAbsVn = 1;
    if(MathAbs(vn) < minAbsVn)
    {
       // FIX 2026-09-17g: IPA structure claire peut passer en SIMPLE
       if(g_ipaEntryInFlight && MathAbs(vn) == 1)
       {
          // autorisÃ© â€” structure validÃ©e dans IPA_GOMAllows
       }
       else
       {
          Print("ðŸš« ", orderKind, " BLOQUÃ‰ â€” ", symbol,
                " â€” GOM vn=", vn,
                " (exige |vn|>=", minAbsVn, " ",
                (minAbsVn == 1 ? "SIMPLE sur spike" : "GOOD/PERFECT"), ")");
          return false;
       }
    }
   // Contre-verdict interdit : le verdict DÃ‰CIDE le trade
   if(dirSign > 0 && vn < 0)
   {
      Print("ðŸš« BUY ", orderKind, " BLOQUÃ‰ sur ", symbol, " â€” GOM vn=", vn, " = SELL (verdict dÃ©cide)");
      return false;
   }
   if(dirSign < 0 && vn > 0)
   {
      Print("ðŸš« SELL ", orderKind, " BLOQUÃ‰ sur ", symbol, " â€” GOM vn=", vn, " = BUY (verdict dÃ©cide)");
      return false;
   }
   return true;
}

bool CanPlacePatientSimpleOrderByGOM(const string symbol, const int dirSign)
{
   if(!UseGOMVerdictFilter) return true;
   int vn = (symbol == _Symbol && g_smcGomConnected) ? g_smcGomVerdictNum : -999;
   if(vn == -999) return false;
   if(vn == 0) return false; // WAIT: rien
   if(MathAbs(vn) != 1) return false;
   if((dirSign > 0 && vn < 0) || (dirSign < 0 && vn > 0)) return false;
   return true;
}

bool CanPlaceDowLimitByGOM(const string symbol, const int dirSign)
   {
      if(!UseGOMVerdictFilter) return true;
      // FIX: Symboles synthÃ©tiques autonomes contournent la vÃ©rification de connexion GOM
      bool isSynthAuto = SMC_IsSyntheticAutonomousSym(symbol);
      if(!isSynthAuto && !g_smcGomConnected) return false;
      // Pour symboles synthÃ©tiques, utiliser le verdict serveur si disponible
      int vn = isSynthAuto ? g_smcGomVerdictNumServer : (symbol == _Symbol ? g_smcGomVerdictNum : -999);
      
      // WAIT : autoriser LIMIT DOW si M5 n'est PAS contraire
      if(vn == 0 || vn == -999)
      {
      // VÃ©rifier le trend M5 : s'il n'est pas contraire, autoriser
      string m5Dir = g_smcTfM5Dir;
      StringToUpper(m5Dir);
      int m5Sign = 0;
      if(StringFind(m5Dir, "BULL") >= 0 || m5Dir == "BUY" || m5Dir == "UP" || m5Dir == "LONG")
         m5Sign = 1;
      else if(StringFind(m5Dir, "BEAR") >= 0 || m5Dir == "SELL" || m5Dir == "DOWN" || m5Dir == "SHORT")
         m5Sign = -1;
      
      // Si M5 est contraire, bloquer
      if(m5Sign != 0 && m5Sign != dirSign)
      {
         Print("ðŸš« DOW LIMIT BLOQUÃ‰ â€” ", symbol, " | WAIT + M5 trend contraire (M5=",
               m5Dir, " dirSign=", dirSign, ")");
         return false;
      }
      // M5 alignÃ© ou neutre â†’ autoriser le LIMIT DOW
      Print("âœ… DOW LIMIT AUTORISÃ‰ malgrÃ© WAIT â€” ", symbol, " | M5 trend OK (M5=",
            m5Dir, " dirSign=", dirSign, ")");
   }
   // SIMPLE : bloquer (exige GOOD/PERFECT pour les entrÃ©es privilÃ©giÃ©es)
   else if(MathAbs(vn) == 1)
   {
      Print("ðŸš« DOW LIMIT BLOQUÃ‰ â€” ", symbol, " | verdict SIMPLE (vn=1), GOOD/PERFECT requis");
      return false;
   }
   // GOOD/PERFECT : vÃ©rifier direction
   else
   {
      if((dirSign > 0 && vn < 0) || (dirSign < 0 && vn > 0)) return false;
      if(!SMCGP_IsGoodPerfect(vn)) return false;
   }
   return CanPlaceOrderByGOM(symbol, dirSign, "LIMIT");
}

bool CanPlaceMarketOrder(const string symbol, const int dirSign)
{
   // â”€â”€ GARDE DIRECTION BOOM/CRASH: pas de SELL sur Boom/Gainx, pas de BUY sur Crash/Painx â”€â”€
   string dirStr = (dirSign > 0) ? "BUY" : "SELL";
   bool spikeChainGomOverride = SMC_SpikeChainGomEntryOverrideAllowed(symbol, dirSign);
   if(!spikeChainGomOverride &&
      MathAbs(g_smcGomVerdictNum) < 2 && MathAbs(g_smcGomVerdictNumServer) < 2 &&
      SMC_GOMCurrentVerdictIsWait(symbol))
   {
      Print("ðŸš« MARKET BLOQUÃ‰ â€” ", symbol, " â€” verdict GOM courant WAIT");
      return false;
   }
   if(!IsDirectionAllowedForBoomCrash(symbol, dirStr))
   {
      Print("ðŸš« MARKET BLOQUÃ‰ â€” ", symbol, " â€” direction ", dirStr, " interdite (rÃ¨gle Boom/Crash)");
      return false;
   }
   // FIX v1.14: WAIT + capital + spread
   if(!g_smcGomConnected || g_smcGomVerdictNum == 0 || g_smcGomVerdictNum == -999)
   {
      SMCGP_RestoreCachedIfDisconnected();
      SMCGP_RestoreAlignedGoodIfWait(symbol);
      if(!SMCGP_GomLinkOK() || g_smcGomVerdictNum == 0 || g_smcGomVerdictNum == -999)
      {
         if(SMCGP_SpikeAlignedGoodProtected(symbol, g_smcGomVerdictNumServer) &&
            ((dirSign > 0 && g_smcGomVerdictNumServer > 0) ||
             (dirSign < 0 && g_smcGomVerdictNumServer < 0)))
            ; // 3 TF + srv GOOD/PERFECT : CanPlaceOrderByGOM restaure
         else if(g_secondSpikeInFlight && SMC_SpikePredictConfirms(dirSign))
            ; // chaÃ®ne / jauge spike : laisser CanPlaceOrderByGOM dÃ©cider
         else
         {
            Print("ðŸš« MARKET BLOQUÃ‰ â€” WAIT/OFF sur ", symbol);
            return false;
         }
      }
   }
   if(!SMC_LowCapitalAllowsSymbol(symbol)) return false;
   if(!SMC_SpreadAllowsEntry(symbol)) return false;
   if(AccountInfoDouble(ACCOUNT_MARGIN_FREE) < 1.0) return false;
   // â”€â”€ GARDE TERMINAL GLOBAL â”€â”€
   if(IsTerminalFull())
   {
        Print("ðŸš« MARKET BLOQUÃ‰ â€” Terminal plein (", CountTerminalAllOrders(), "/", MaxPositionsTerminal, ")");
      return false;
   }
   // Le contrÃ´le anti-hedge/scale-in est exÃ©cutÃ© juste avant l'envoi via CanTradeOnSymbol().
   // Ici, conserver uniquement le gate directionnel GOM afin de ne pas bloquer
   // les opportunitÃ©s GOOD/PERFECT dans le mÃªme sens.
   return CanPlaceOrderByGOM(symbol, dirSign, "MARKET");
}

// â”€â”€ GATEKEEPER: direction GOM + max 2 limit orders â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Retourne true si l'ordre LIMIT est autorisÃ©, false sinon
bool CanPlaceLimitOrder(const string symbol, ENUM_ORDER_TYPE orderType)
{
   // â”€â”€ GARDE DIRECTION BOOM/CRASH: pas de SELL sur Boom/Gainx, pas de BUY sur Crash/Painx â”€â”€
   string dirStr = "";
   if(orderType == ORDER_TYPE_BUY_LIMIT || orderType == ORDER_TYPE_BUY)
      dirStr = "BUY";
   else if(orderType == ORDER_TYPE_SELL_LIMIT || orderType == ORDER_TYPE_SELL)
      dirStr = "SELL";
   if(dirStr != "" && !IsDirectionAllowedForBoomCrash(symbol, dirStr))
   {
      Print("ðŸš« LIMIT BLOQUÃ‰ â€” ", symbol, " â€” direction ", dirStr, " interdite (rÃ¨gle Boom/Crash)");
      return false;
   }
   // â”€â”€ GARDE TERMINAL GLOBAL â”€â”€
   if(IsTerminalFull())
   {
        Print("ðŸš« LIMIT BLOQUÃ‰ â€” Terminal plein (", CountTerminalAllOrders(), "/", MaxPositionsTerminal, ")");
      return false;
   }
   // Gate anti-hedge commun aux ordres marchÃ© et pending. Il autorise au plus
   // un scale-in GOOD/PERFECT dans le MÃŠME sens, sous cap et cooldown.
   if(dirStr == "" || !CanTradeOnSymbol(symbol, dirStr))
   {
      Print("ðŸš« LIMIT BLOQUÃ‰ â€” conflit, doublon, cooldown ou cap sur ", symbol,
            " direction=", dirStr);
      return false;
   }

   int dirSign = 0;
   if(orderType == ORDER_TYPE_BUY_LIMIT || orderType == ORDER_TYPE_BUY)
      dirSign = 1;
   else if(orderType == ORDER_TYPE_SELL_LIMIT || orderType == ORDER_TYPE_SELL)
      dirSign = -1;

   if(!CanPlaceOrderByGOM(symbol, dirSign, "LIMIT"))
      return false;

   string limReason = "";
   if(!LimitPlaceDisciplineOK(symbol, dirSign, limReason))
   {
      static datetime s_lastLimPlaceLog = 0;
      if(TimeCurrent() - s_lastLimPlaceLog >= 30)
      {
         s_lastLimPlaceLog = TimeCurrent();
         Print("ðŸš« LIMIT BLOQUÃ‰ â€” ", symbol, " â€” ", limReason);
      }
      return false;
   }

   // Max 2 ordres LIMIT par symbole (garder les meilleurs via CleanupExcessLimits)
   int maxLimits = MathMax(1, MaxLimitOrdersTerminal);
   int total = CountOpenLimitOrdersForSymbol(symbol);
   if(total >= maxLimits)
   {
      Print("ðŸš« LIMIT BLOQUÃ‰ â€” dÃ©jÃ  ", total, " ordres limit sur ", symbol, " (max=", maxLimits, ")");
      return false;
   }

   return true;
}

// Supprime les ordres LIMIT les plus Ã©loignÃ©s du prix courant si > max
void CleanupExcessLimits(const string symbol, int maxOrders)
{
   // Collecter tous nos limit orders
   struct LimitOrderInfo { ulong ticket; double price; ENUM_ORDER_TYPE type; datetime time; };
   LimitOrderInfo orders[];
   ArrayResize(orders, 0);

   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) != symbol) continue;
      if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(t != ORDER_TYPE_BUY_LIMIT && t != ORDER_TYPE_SELL_LIMIT) continue;
      // Ne jamais supprimer un LIMIT DOW (ancrÃ© sur trendline PROJ)
      string cmt = OrderGetString(ORDER_COMMENT);
      if(StringFind(cmt, "DOW") >= 0) continue;

      // GrÃ¢ce min discipline : ne pas supprimer un LIMIT trop jeune
      datetime orderTime = (datetime)OrderGetInteger(ORDER_TIME_SETUP);
      if(!LimitCancelAllowed(ticket, false, "CleanupExcessLimits"))
         continue;

      int sz = ArraySize(orders);
      ArrayResize(orders, sz + 1);
      orders[sz].ticket = ticket;
      orders[sz].price  = OrderGetDouble(ORDER_PRICE_OPEN);
      orders[sz].type   = t;
      orders[sz].time   = (datetime)OrderGetInteger(ORDER_TIME_SETUP);
   }

   int excess = ArraySize(orders) - maxOrders;
   if(excess <= 0) return;

   double currentPrice = SymbolInfoDouble(symbol, SYMBOL_BID);

   // Trier par distance au prix (plus Ã©loignÃ© en premier)
   for(int a = 0; a < ArraySize(orders) - 1; a++)
   {
      for(int b = a + 1; b < ArraySize(orders); b++)
      {
         double distA = MathAbs(orders[a].price - currentPrice);
         double distB = MathAbs(orders[b].price - currentPrice);
         if(distB > distA) // b plus loin â†’ Ã©changer
         {
            LimitOrderInfo tmp = orders[a];
            orders[a] = orders[b];
            orders[b] = tmp;
         }
      }
   }

   // Supprimer les plus Ã©loignÃ©s
   for(int k = 0; k < excess; k++)
   {
      ulong tk = orders[k].ticket;
      if(!OrderSelect(tk)) continue;
      string cmt = OrderGetString(ORDER_COMMENT);
      if(!LimitSafeOrderDelete(tk, false, "CleanupExcessLimits " + cmt))
         Print("âŒ Ã‰chec/suppression diffÃ©rÃ©e limit excessif ticket=", tk);
   }
}

bool SMC_DetectFVG(string symbol, ENUM_TIMEFRAMES tf, int lookback, FVGData &fvgOut)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(symbol, tf, 0, lookback, rates) < lookback) return false;
   for(int fvgIndex = 2; fvgIndex < lookback - 1; fvgIndex++)
   {
      if(rates[fvgIndex-1].low > rates[fvgIndex+1].high)
      {
         double gap = rates[fvgIndex-1].low - rates[fvgIndex+1].high;
         double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
         if(gap > point * 3) {
            fvgOut.top = rates[fvgIndex-1].low; fvgOut.bottom = rates[fvgIndex+1].high; fvgOut.direction = 1;
            fvgOut.time = rates[fvgIndex].time; fvgOut.isInversion = false; fvgOut.barIndex = fvgIndex;
            return true;
         }
      }
      if(rates[fvgIndex-1].high < rates[fvgIndex+1].low)
      {
         double gap = rates[fvgIndex+1].low - rates[fvgIndex-1].high;
         double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
         if(gap > point * 3) {
            fvgOut.top = rates[fvgIndex+1].low; fvgOut.bottom = rates[fvgIndex-1].high; fvgOut.direction = -1;
            fvgOut.time = rates[fvgIndex].time; fvgOut.isInversion = false; fvgOut.barIndex = fvgIndex;
            return true;
         }
      }
   }
   return false;
}
bool SMC_DetectBOS(string symbol, ENUM_TIMEFRAMES tf, int &directionOut)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(symbol, tf, 0, 20, rates) < 20) return false;
   double prevSwingHigh = MathMax(rates[3].high, MathMax(rates[4].high, rates[5].high));
   double prevSwingLow = MathMin(rates[3].low, MathMin(rates[4].low, rates[5].low));
   double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
   double minBreak = point * 5;
   if(rates[1].close > prevSwingHigh + minBreak) { directionOut = 1; return true; }
   if(rates[1].close < prevSwingLow - minBreak) { directionOut = -1; return true; }
   return false;
}
bool SMC_DetectLiquiditySweep(string symbol, ENUM_TIMEFRAMES tf, string &typeOut)
{
   int barsAgo;
   return SMC_DetectLiquiditySweepEx(symbol, tf, typeOut, barsAgo);
}
bool SMC_DetectLiquiditySweepEx(string symbol, ENUM_TIMEFRAMES tf, string &typeOut, int &barsAgoOut)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(symbol, tf, 0, 15, rates) < 15) return false;
   barsAgoOut = 99;
   double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
   double minSweep = point * 5;
   for(int b = 1; b <= 5; b++)
   {
      if(b + 2 >= ArraySize(rates)) break;
      double prevHigh = rates[b+1].high;
      double prevLow = rates[b+1].low;
      double currHigh = rates[b].high;
      double currLow = rates[b].low;
      if(currHigh > prevHigh && (currHigh - prevHigh) > minSweep)
      {
         typeOut = "BSL";
         barsAgoOut = b;
         return true;
      }
      if(currLow < prevLow && (prevLow - currLow) > minSweep)
      {
         typeOut = "SSL";
         barsAgoOut = b;
         return true;
      }
   }
   return false;
}

//+------------------------------------------------------------------+
//| DÃ‰TECTION CONSOLIDATION EN TEMPS RÃ‰EL (2 segments de rÃ©gression) |
//| Segment 1: Horizontal (range)                                    |
//| Segment 2: Pente (trend)                                          |
//| DÃ©duit si le prix consolide, corrige ou a une impulsion franche    |
//+------------------------------------------------------------------+
struct ConsolidationData
{
   bool isInConsolidation;
   bool isInCorrection;
   bool hasStrongImpulse;
   double horizontalSlope;      // Pente segment horizontal (devrait Ãªtre ~0)
   double trendSlope;           // Pente segment trend
   double rSquaredHorizontal;  // RÂ² segment horizontal (qualitÃ© fit)
   double rSquaredTrend;       // RÂ² segment trend (qualitÃ© fit)
   datetime lastUpdate;
   // Range box + cassure (ne reprendre BUY/SELL qu'aprÃ¨s breakout)
   double rangeHigh;
   double rangeLow;
   double rangeWidthATR;
   bool   breakoutBuy;   // close au-dessus de rangeHigh
   bool   breakoutSell;  // close en-dessous de rangeLow
};

ConsolidationData g_consolidationData;

// Calcul rÃ©gression linÃ©aire simple (y = mx + b) et RÂ²
bool CalculateLinearRegression(const double &prices[], const int startIdx, const int length, 
                              double &slopeOut, double &interceptOut, double &rSquaredOut)
{
   if(length < 3) return false;
   
   double sumX = 0, sumY = 0, sumXY = 0, sumX2 = 0, sumY2 = 0;
   int n = length;
   
   for(int i = 0; i < n; i++)
   {
      double x = i;
      double y = prices[startIdx + i];
      sumX += x;
      sumY += y;
      sumXY += x * y;
      sumX2 += x * x;
      sumY2 += y * y;
   }
   
   double denom = n * sumX2 - sumX * sumX;
   if(MathAbs(denom) < 1e-10) return false;
   
   slopeOut = (n * sumXY - sumX * sumY) / denom;
   interceptOut = (sumY - slopeOut * sumX) / n;
   
   // Calcul RÂ²
   double meanY = sumY / n;
   double ssTotal = 0, ssResidual = 0;
   for(int i = 0; i < n; i++)
   {
      double x = i;
      double y = prices[startIdx + i];
      double predicted = slopeOut * x + interceptOut;
      ssTotal += (y - meanY) * (y - meanY);
      ssResidual += (y - predicted) * (y - predicted);
   }
   
   if(ssTotal < 1e-10) 
   {
      rSquaredOut = 1.0; // Parfait fit horizontal
   }
   else
   {
      rSquaredOut = 1.0 - (ssResidual / ssTotal);
   }
   
   return true;
}

// Met Ã  jour la dÃ©tection de consolidation
void UpdateConsolidationDetection(const string symbol)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   int lookback = ConsolidationLookbackBars;
   if(CopyRates(symbol, PERIOD_M1, 0, lookback, rates) < lookback) return;

   // Si structure dÃ©jÃ  connue: rafraÃ®chir UNIQUEMENT la cassure chaque tick
   // (Ã©vite un lag de 30s pendant lequel l'EA pourrait encore trader le range)
   if(g_consolidationData.lastUpdate > 0 &&
      (TimeCurrent() - g_consolidationData.lastUpdate) < 30 &&
      g_consolidationData.rangeHigh > 0.0 && g_consolidationData.rangeLow > 0.0)
   {
      double atrQuick = 0.0;
      int atrHQ = iATR(symbol, PERIOD_M1, 14);
      if(atrHQ != INVALID_HANDLE)
      {
         double ab[];
         ArraySetAsSeries(ab, true);
         if(CopyBuffer(atrHQ, 0, 0, 1, ab) >= 1) atrQuick = ab[0];
      }
      if(atrQuick <= 0.0) atrQuick = SymbolInfoDouble(symbol, SYMBOL_POINT) * 50.0;
      double bufQ = atrQuick * MathMax(0.0, RangeBreakoutBufferATR);
      double c0 = rates[0].close;
      if(g_consolidationData.isInConsolidation)
      {
         g_consolidationData.breakoutBuy  = (c0 > g_consolidationData.rangeHigh + bufQ);
         g_consolidationData.breakoutSell = (c0 < g_consolidationData.rangeLow  - bufQ);
      }
      else
      {
         g_consolidationData.breakoutBuy  = true;
         g_consolidationData.breakoutSell = true;
      }
      return;
   }

   
   double prices[];
   ArrayResize(prices, lookback);
   for(int i = 0; i < lookback; i++)
      prices[i] = rates[i].close;
   
   // Segment 1: Horizontal (toute la pÃ©riode)
   double slopeH, interceptH, r2H;
   bool okH = CalculateLinearRegression(prices, 0, lookback, slopeH, interceptH, r2H);
   
   // Segment 2: Trend (derniÃ¨res 15 bougies)
   double slopeT, interceptT, r2T;
   bool okT = CalculateLinearRegression(prices, 0, 15, slopeT, interceptT, r2T);
   
   if(!okH || !okT) return;
   
   g_consolidationData.horizontalSlope = slopeH;
   g_consolidationData.trendSlope = slopeT;
   g_consolidationData.rSquaredHorizontal = r2H;
   g_consolidationData.rSquaredTrend = r2T;
   g_consolidationData.lastUpdate = TimeCurrent();
   
   // DÃ©duire l'Ã©tat du marchÃ©
   double atr = 0;
   int atrH = iATR(symbol, PERIOD_M1, 14);
   if(atrH != INVALID_HANDLE)
   {
      double atrBuf[];
      ArraySetAsSeries(atrBuf, true);
      if(CopyBuffer(atrH, 0, 0, 1, atrBuf) >= 1) atr = atrBuf[0];
   }
   if(atr <= 0) atr = SymbolInfoDouble(symbol, SYMBOL_POINT) * 50;
   
   // CALCUL RANGE WIDTH (hauteur du range)
   double maxPrice = rates[0].high;
   double minPrice = rates[0].low;
   for(int i = 0; i < lookback; i++)
   {
      if(rates[i].high > maxPrice) maxPrice = rates[i].high;
      if(rates[i].low < minPrice) minPrice = rates[i].low;
   }
   double rangeWidth = maxPrice - minPrice;
   double rangeWidthATR = rangeWidth / atr; // Range en multiples d'ATR
   
   // â”€â”€ RANGE BOX pratique (ce que l'Å“il voit sur le graphique) â”€â”€
   // Un range n'est PAS seulement un canal ultra-Ã©troit (<0.5 ATR).
   // Sur FX Vol / synthÃ©tiques, une correction horizontale fait souvent 1â€“2.5 ATR
   // de large avec des bougies qui touchent haut ET bas du box.
   g_consolidationData.rangeHigh = maxPrice;
   g_consolidationData.rangeLow  = minPrice;
   g_consolidationData.rangeWidthATR = rangeWidthATR;

   // Oscillation: le prix a touchÃ© le tiers haut ET le tiers bas du box
   double third = rangeWidth / 3.0;
   bool touchedTop = false, touchedBot = false;
   for(int i = 0; i < lookback; i++)
   {
      if(rates[i].high >= maxPrice - third) touchedTop = true;
      if(rates[i].low  <= minPrice + third) touchedBot = true;
   }
   bool oscillating = touchedTop && touchedBot;

   // Pente horizontale (plate) sur le lookback
   bool flatSlope = (MathAbs(slopeH) < atr * ConsolidationSlopeThreshold * 3.0);

   // Corps moyens petits vs largeur du box â†’ chop / range
   double avgBody = 0.0;
   for(int i = 0; i < lookback; i++)
      avgBody += MathAbs(rates[i].close - rates[i].open);
   avgBody /= (double)lookback;
   bool smallBodies = (rangeWidth > 0.0 && avgBody < rangeWidth * 0.22);

   // Consolidation = largeur raisonnable + (oscillation OU pente plate + petits corps)
   double maxRangeATR = MathMax(0.8, ConsolidationMaxRangeATR);
   bool widthOk = (rangeWidthATR > 0.15 && rangeWidthATR <= maxRangeATR);
   bool isHorizontal = widthOk && (oscillating || (flatSlope && smallBodies) ||
                       ((MathAbs(slopeH) < atr * ConsolidationSlopeThreshold) && (r2H > ConsolidationR2Threshold)));

   // Correction: pente trend faible + RÂ² modÃ©rÃ©
   bool isCorrection = (MathAbs(slopeT) < atr * ConsolidationSlopeThreshold * 2) &&
                        (r2T > 0.5) && (r2T < 0.8);

   // Impulsion franche: pente forte + RÂ² Ã©levÃ©
   bool isImpulse = (MathAbs(slopeT) > atr * ConsolidationSlopeThreshold * 5) && (r2T > 0.8);

   // Cassure du range (close hors box + buffer ATR)
   double buf = atr * MathMax(0.0, RangeBreakoutBufferATR);
   double lastClose = rates[0].close;
   bool brkBuy  = (lastClose > maxPrice + buf);
   bool brkSell = (lastClose < minPrice - buf);

   // Si on n'est plus en range "structure", les breakouts ne servent Ã  rien
   if(!isHorizontal)
   {
      brkBuy = true;   // marchÃ© libre â†’ autoriser les deux sens cÃ´tÃ© filtre range
      brkSell = true;
   }

   g_consolidationData.isInConsolidation = isHorizontal;
   g_consolidationData.isInCorrection = isCorrection && !isHorizontal;
   g_consolidationData.hasStrongImpulse = isImpulse;
   g_consolidationData.breakoutBuy  = brkBuy;
   g_consolidationData.breakoutSell = brkSell;

   // Log pour debug
   if(isHorizontal)
      Print("ðŸ“Š RANGE/CONSOLIDATION: ", symbol,
            " | box=[", DoubleToString(minPrice, _Digits), " - ", DoubleToString(maxPrice, _Digits), "]",
            " | width=", DoubleToString(rangeWidthATR, 2), "xATR",
            " | osc=", (oscillating ? "Y" : "N"),
            " | flat=", (flatSlope ? "Y" : "N"),
            " | brkBuy=", (brkBuy ? "Y" : "N"),
            " | brkSell=", (brkSell ? "Y" : "N"),
            " â†’ attendre cassure avant entrÃ©e");
   else if(isCorrection)
      Print("ðŸ“‰ CORRECTION dÃ©tectÃ©e: ", symbol, " | Slope T=", DoubleToString(slopeT, 6),
            " | RÂ² T=", DoubleToString(r2T, 3));
   else if(isImpulse)
      Print("ðŸš€ IMPULSION franche dÃ©tectÃ©e: ", symbol, " | Slope T=", DoubleToString(slopeT, 6),
            " | RÂ² T=", DoubleToString(r2T, 3));
   else
      Print("ðŸ“ˆ MARCHÃ‰ NEUTRE: ", symbol, " | Range=", DoubleToString(rangeWidthATR, 2), "x ATR");
}

// VÃ©rifie si le marchÃ© est en consolidation (bloque les trades)
bool IsMarketInConsolidation(const string symbol)
{
   // La mise Ã  jour est faite dans OnTick, ici on retourne juste l'Ã©tat
   return g_consolidationData.isInConsolidation;
}

// VÃ©rifie si le marchÃ© est en correction (autorise mais avec prudence)
bool IsMarketInCorrection(const string symbol)
{
   // La mise Ã  jour est faite dans OnTick, ici on retourne juste l'Ã©tat
   return g_consolidationData.isInCorrection;
}

// VÃ©rifie si le marchÃ© a une impulsion franche (idÃ©al pour entrÃ©es)
bool HasStrongImpulse(const string symbol)
{
   // La mise Ã  jour est faite dans OnTick, ici on retourne juste l'Ã©tat
   return g_consolidationData.hasStrongImpulse;
}

//+------------------------------------------------------------------+
//| Range box: autorise l'entrÃ©e seulement aprÃ¨s cassure directionnelle|
//| BUY  â†’ close au-dessus du high du range                            |
//| SELL â†’ close en-dessous du low du range                            |
//| Si pas en range â†’ true (filtre inactif).                           |
//+------------------------------------------------------------------+
bool SMC_RangeAllowsEntry(const int dirSign)
{
   // Nouveau module rÃ©gime (ADX + structure + ATR + box + correction %)
   // Prioritaire si MR_Enable ; sinon fallback consolidation historique.
   if(MR_Enable)
   {
      string why = "";
      bool ok = MR_AllowsEntry(_Symbol, dirSign, why);
      if(!ok)
         Print("ðŸ”’ MARKET REGIME â€” entrÃ©e refusÃ©e ", (dirSign > 0 ? "BUY" : "SELL"),
               " | ", why);
      return ok;
   }

   if(!UseConsolidationFilter) return true;
   if(!g_consolidationData.isInConsolidation) return true;
   if(!RequireRangeBreakout) return false;

   if(dirSign > 0) return g_consolidationData.breakoutBuy;
   if(dirSign < 0) return g_consolidationData.breakoutSell;
   return false;
}

//+------------------------------------------------------------------+
//| DÃ‰TECTION WHIPSAW GAIN/PERTE (oscillations rapides)            |
//| DÃ©tecte si le prix oscille gain/perte rapidement = range         |
//+------------------------------------------------------------------+
struct WhipsawData
{
   int gainLossTransitions;  // Nombre de transitions gainâ†’perteâ†’gain
   datetime lastTransitionTime;
   double lastProfit;
   bool wasInGain;
};

WhipsawData g_whipsawData;

// Met Ã  jour le compteur de whipsaw pour une position
void UpdateWhipsawDetection(const double currentProfit)
{
   bool nowInGain = (currentProfit > 0);
   
   if(g_whipsawData.wasInGain != nowInGain && g_whipsawData.wasInGain)
   {
      // Transition dÃ©tectÃ©e
      g_whipsawData.gainLossTransitions++;
      g_whipsawData.lastTransitionTime = TimeCurrent();
      Print("ðŸ”„ WHIPSAW dÃ©tectÃ©: transition #", g_whipsawData.gainLossTransitions,
            " | Profit: ", DoubleToString(currentProfit, 2), "$");
   }
   
   g_whipsawData.wasInGain = nowInGain;
   g_whipsawData.lastProfit = currentProfit;
}

// VÃ©rifie si le marchÃ© est en whipsaw (trop d'oscillations)
bool IsInWhipsawMode()
{
   // Reset si trop ancien
   if(TimeCurrent() - g_whipsawData.lastTransitionTime > WhipsawResetMinutes * 60)
   {
      g_whipsawData.gainLossTransitions = 0;
      return false;
   }
   
   // Whipsaw si transitions >= seuil configurable
   return (g_whipsawData.gainLossTransitions >= WhipsawMaxTransitions);
}

// Reset whipsaw tracker (aprÃ¨s fermeture position)
void ResetWhipsawTracker()
{
   g_whipsawData.gainLossTransitions = 0;
   g_whipsawData.lastTransitionTime = 0;
   g_whipsawData.lastProfit = 0;
   g_whipsawData.wasInGain = false;
}

bool SMC_DetectOrderBlock(string symbol, ENUM_TIMEFRAMES tf, OrderBlockData &obOut)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(symbol, tf, 0, 50, rates) < 50) return false;
   for(int i = 3; i < 45; i++)
   {
      if(rates[i].close < rates[i].open && rates[i+1].close > rates[i+1].open)
      {
         double moveUp = rates[i+2].high - rates[i].low;
         double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
         if(moveUp > point * 20) {
            obOut.high = rates[i].high; obOut.low = rates[i].low; obOut.direction = 1;
            obOut.time = rates[i].time; obOut.barIndex = i; obOut.type = "OB";
            return true;
         }
      }
      if(rates[i].close > rates[i].open && rates[i+1].close < rates[i+1].open)
      {
         double moveDown = rates[i].high - rates[i+2].low;
         double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
         if(moveDown > point * 20) {
            obOut.high = rates[i].high; obOut.low = rates[i].low; obOut.direction = -1;
            obOut.time = rates[i].time; obOut.barIndex = i; obOut.type = "OB";
            return true;
         }
      }
   }
   return false;
}

bool SMC_PriceNearThickOB(const int dirSign, const double tol, double &obMid)
{
   obMid = 0.0;
   if(!UseOrderBlocks) return false;
   OrderBlockData ob;
   if(!SMC_DetectOrderBlock(_Symbol, PERIOD_M5, ob)) return false;
   obMid = (ob.high + ob.low) * 0.5;
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double px = (bid + ask) * 0.5;
   if(MathAbs(px - obMid) > tol) return false;
   if(dirSign > 0 && ob.direction <= 0) return false;
   if(dirSign < 0 && ob.direction >= 0) return false;
   double obHeight = MathAbs(ob.high - ob.low);
   return (obHeight >= tol * 0.85);
}

bool SMC_IsLondonOpen(int hourStart, int hourEnd)
{
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   return (dt.hour >= hourStart && dt.hour <= hourEnd);
}
bool SMC_IsNewYorkOpen(int hourStart, int hourEnd)
{
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   return (dt.hour >= hourStart && dt.hour <= hourEnd);
}
bool SMC_IsKillZone(int loStart, int loEnd, int nyoStart, int nyoEnd)
{
   return SMC_IsLondonOpen(loStart, loEnd) || SMC_IsNewYorkOpen(nyoStart, nyoEnd);
}
double SMC_GetATRMultiplier(ENUM_SYMBOL_CATEGORY cat)
{
   switch(cat) {
      case SYM_BOOM_CRASH:  return 1.5;
      case SYM_VOLATILITY:  return 2.0;
      case SYM_FOREX:       return 2.0;
      case SYM_COMMODITY:   return 2.5;
      case SYM_METAL:       return 2.5;
      case SYM_CRYPTO:      return 3.0;
      default:              return 2.0;
   }
}

