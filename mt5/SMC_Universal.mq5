void ProcessAIDecision(string jsonData)
{
   // Parser la rÃ©ponse JSON du serveur IA
   // Format attendu: {"action": "BUY/SELL/HOLD", "confidence": 0.85, "alignment": "75%", "coherence": "82%"}
   
   g_lastAIUpdate = TimeCurrent();
   
   // Extraire l'action
   if(StringFind(jsonData, "\"action\":") >= 0)
   {
      int start = StringFind(jsonData, "\"action\":") + 9;
      int end = StringFind(jsonData, ",", start);
      if(end < 0) end = StringFind(jsonData, "}", start);
      
      if(end > start)
      {
         string action = StringSubstr(jsonData, start, end - start);
         StringReplace(action, "\"", "");
         StringReplace(action, " ", "");
         g_lastAIAction = action;
      }
   }
   
   // Extraire la confiance
   if(StringFind(jsonData, "\"confidence\":") >= 0)
   {
      int start = StringFind(jsonData, "\"confidence\":") + 13;
      int end = StringFind(jsonData, ",", start);
      if(end < 0) end = StringFind(jsonData, "}", start);
      
      if(end > start)
      {
         string confStr = StringSubstr(jsonData, start, end - start);
         g_lastAIConfidence = StringToDouble(confStr);
      }
   }
   
   // Extraire l'alignement
   if(StringFind(jsonData, "\"alignment\":") >= 0)
   {
      int start = StringFind(jsonData, "\"alignment\":") + 12;
      int end = StringFind(jsonData, ",", start);
      if(end < 0) end = StringFind(jsonData, "}", start);
      
      if(end > start)
      {
         string alignStr = StringSubstr(jsonData, start, end - start);
         StringReplace(alignStr, "\"", "");
         g_lastAIAlignment = alignStr;
      }
   }
   
   // Extraire la cohÃ©rence
   if(StringFind(jsonData, "\"coherence\":") >= 0)
   {
      int start = StringFind(jsonData, "\"coherence\":") + 13;
      int end = StringFind(jsonData, ",", start);
      if(end < 0) end = StringFind(jsonData, "}", start);
      
      if(end > start)
      {
         string cohStr = StringSubstr(jsonData, start, end - start);
         StringReplace(cohStr, "\"", "");
         g_lastAICoherence = cohStr;
      }
   }
   
   // Si aucune donnÃ©e trouvÃ©e, valeurs par dÃ©faut
   if(g_lastAIAction == "") g_lastAIAction = "HOLD";
   if(g_lastAIConfidence == 0) g_lastAIConfidence = 0.5;
   if(g_lastAIAlignment == "") g_lastAIAlignment = "50%";
   if(g_lastAICoherence == "") g_lastAICoherence = "50%";
}

//| NOTIFICATION MOBILE POUR APPARITION FLÃˆCHE DERIV ARROW          |
void SendDerivArrowNotification(string direction, double entryPrice, double stopLoss, double takeProfit)
{
   // Calculer le gain estimÃ©
   double risk = MathAbs(entryPrice - stopLoss);
   double reward = MathAbs(takeProfit - entryPrice);
   double estimatedGain = 0;
   
   // Calculer le gain en points et en dollars (pour lot 0.01)
   double pointValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   double pointsToTP = MathAbs(takeProfit - entryPrice) / tickSize;
   estimatedGain = pointsToTP * pointValue * 0.01; // Pour lot 0.01
   
   // Calculer le ratio Risk/Reward
   double riskRewardRatio = reward / risk;
   
   // Formater les prix
   string entryStr = DoubleToString(entryPrice, _Digits);
   string slStr = DoubleToString(stopLoss, _Digits);
   string tpStr = DoubleToString(takeProfit, _Digits);
   string gainStr = DoubleToString(estimatedGain, 2);
   string ratioStr = DoubleToString(riskRewardRatio, 2);
   
   // CrÃ©er le message de notification
   string notificationMsg = "ðŸŽ¯ DERIV ARROW " + direction + "\n" +
                           "Symbole: " + _Symbol + "\n" +
                           "Entry: " + entryStr + "\n" +
                           "SL: " + slStr + "\n" +
                           "TP: " + tpStr + "\n" +
                           "Gain estimÃ©: $" + gainStr + "\n" +
                           "Risk/Reward: 1:" + ratioStr;
   
   // CrÃ©er le message d'alerte desktop
   string alertMsg = "ðŸŽ¯ DERIV ARROW " + direction + " - " + _Symbol + 
                    " @ " + entryStr + 
                    " | SL: " + slStr + 
                    " | TP: " + tpStr + 
                    " | Gain: $" + gainStr + 
                    " | R/R: 1:" + ratioStr;
   
   // Envoyer la notification mobile
   SendNotification(notificationMsg);
   
   // Envoyer l'alerte desktop
   Alert(alertMsg);
   
   // Log dÃ©taillÃ©
   Print("ðŸ“± NOTIFICATION ENVOYÃ‰E - DERIV ARROW ", direction);
   Print("ðŸ“ Symbole: ", _Symbol);
   Print("ðŸ’° Entry: ", entryStr, " | SL: ", slStr, " | TP: ", tpStr);
   Print("ðŸ“Š Gain estimÃ©: $", gainStr, " | Risk/Reward: 1:", ratioStr);
   Print("ðŸ”” Notification mobile envoyÃ©e avec succÃ¨s!");
}

//| CALCUL D'ENTRÃ‰E PRÃ‰CISE - SYSTÃˆME AMÃ‰LIORÃ‰                    |
bool CalculatePreciseEntryPoint(string direction, double &entryPrice, double &stopLoss, double &takeProfit)
{
   // RÃ©cupÃ©rer les donnÃ©es de marchÃ© rÃ©centes
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 50, rates) < 50) return false;
   
   if(atrHandle == INVALID_HANDLE) return false;
   double atr[];
   ArraySetAsSeries(atr, true);
   if(CopyBuffer(atrHandle, 0, 0, 1, atr) < 1) return false;
   double atrValue = atr[0];
   
   // Analyser la structure de marchÃ©
   double currentPrice = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double support = rates[0].low;
   double resistance = rates[0].high;
   
   // Trouver le support/rÃ©sistance le plus proche (last 10 bougies)
   for(int i = 1; i < 10; i++)
   {
      if(rates[i].low < support) support = rates[i].low;
      if(rates[i].high > resistance) resistance = rates[i].high;
   }
   
   // Calculer les niveaux de Fibonacci sur les 20 derniÃ¨res bougies
   double highest = rates[0].high;
   double lowest = rates[0].low;
   for(int i = 1; i < 20; i++)
   {
      if(rates[i].high > highest) highest = rates[i].high;
      if(rates[i].low < lowest) lowest = rates[i].low;
   }
   
   double fib38_2 = lowest + (highest - lowest) * 0.382;
   double fib61_8 = lowest + (highest - lowest) * 0.618;
   
   // Calculer l'entrÃ©e prÃ©cise selon la direction
   if(direction == "BUY")
   {
      // EntrÃ©e BUY: au-dessus du support ou fib38_2
      double buyLevel1 = support + (atrValue * 0.5);
      double buyLevel2 = fib38_2 + (atrValue * 0.3);
      
      entryPrice = MathMax(buyLevel1, buyLevel2);
      
      // SL: sous le support avec marge de sÃ©curitÃ©
      stopLoss = support - (atrValue * 0.2);
      
      // TP: ratio 2:1 minimum
      double risk = entryPrice - stopLoss;
      takeProfit = entryPrice + (risk * 2.5);
      
      // Validation: l'entrÃ©e doit Ãªtre < prix actuel + 1 ATR
      if(entryPrice > currentPrice + atrValue) return false;
   }
   else // SELL
   {
      // EntrÃ©e SELL: sous la rÃ©sistance ou fib61_8
      double sellLevel1 = resistance - (atrValue * 0.5);
      double sellLevel2 = fib61_8 - (atrValue * 0.3);
      
      entryPrice = MathMin(sellLevel1, sellLevel2);
      
      // SL: au-dessus de la rÃ©sistance avec marge
      stopLoss = resistance + (atrValue * 0.2);
      
      // TP: ratio 2:1 minimum
      double risk = stopLoss - entryPrice;
      takeProfit = entryPrice - (risk * 2.5);
      
      // Validation: l'entrÃ©e doit Ãªtre > prix actuel - 1 ATR
      if(entryPrice < currentPrice - atrValue) return false;
   }
   
   // Validation finale des distances
   long stopsLevel = 0;
   double point = 0.0;
   SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL, stopsLevel);
   SymbolInfoDouble(_Symbol, SYMBOL_POINT, point);
   double minDistance = (double)stopsLevel * point;
   if(minDistance == 0) minDistance = atrValue * 0.5; // Distance par dÃ©faut
   
   if(MathAbs(entryPrice - stopLoss) < minDistance) return false;
   if(MathAbs(takeProfit - entryPrice) < minDistance * 2) return false;
   
   Print("ðŸŽ¯ ENTRÃ‰E PRÃ‰CISE CALCULÃ‰E - ", direction,
         " | Entry: ", DoubleToString(entryPrice, _Digits),
         " | SL: ", DoubleToString(stopLoss, _Digits),
         " | TP: ", DoubleToString(takeProfit, _Digits),
         " | Risk/Reward: 1:", DoubleToString(MathAbs(takeProfit - entryPrice) / MathAbs(entryPrice - stopLoss), 2));
   
   return true;
}

//| VALIDATION MULTI-SIGNAUX POUR ENTRÃ‰ES PRÃ‰CISES               |
bool ValidateEntryWithMultipleSignals(string direction)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 30, rates) < 30) return false;
   
   int confirmationCount = 0;
   
   // 1. Confirmation par momentum (last 5 bougies)
   double momentum = 0;
   for(int i = 0; i < 5; i++)
   {
      momentum += (rates[i].close - rates[i].open) / rates[i].open;
   }
   bool momentumConfirm = (direction == "BUY" && momentum > 0.001) || 
                          (direction == "SELL" && momentum < -0.001);
   if(momentumConfirm) confirmationCount++;
   
   // 2. Confirmation par volume (comparaison aux 10 bougies prÃ©cÃ©dentes)
   double recentVolume = 0;
   double avgVolume = 0;
   for(int i = 0; i < 5; i++) recentVolume += (double)rates[i].tick_volume;
   for(int i = 5; i < 15; i++) avgVolume += (double)rates[i].tick_volume;
   recentVolume /= 5;
   avgVolume /= 10;
   
   bool volumeConfirm = recentVolume > avgVolume * 1.2; // Volume > 20% moyenne
   if(volumeConfirm) confirmationCount++;
   
   // 3. Confirmation par structure (pas de range)
   double range = rates[0].high - rates[0].low;
   double avgRange = 0;
   for(int i = 1; i < 10; i++) avgRange += rates[i].high - rates[i].low;
   avgRange /= 9;
   
   bool structureConfirm = range > avgRange * 0.8; // Range actuel > 80% moyenne
   if(structureConfirm) confirmationCount++;
   
   // 4. Confirmation par EMA (trend alignÃ©)
   double ema[];
   ArraySetAsSeries(ema, true);
   bool emaConfirm = false;
   if(ema50H != INVALID_HANDLE && CopyBuffer(ema50H, 0, 0, 1, ema) >= 1)
   {
      emaConfirm = (direction == "BUY" && rates[0].close > ema[0]) ||
                   (direction == "SELL" && rates[0].close < ema[0]);
      if(emaConfirm) confirmationCount++;
   }
   
   // 5. Confirmation par volatilitÃ© (ni trop basse, ni trop Ã©levÃ©e)
   double volatility = range / rates[0].close;
   bool volatilityConfirm = (volatility > 0.0005 && volatility < 0.02);
   if(volatilityConfirm) confirmationCount++;
   
   Print("ðŸ” VALIDATION MULTI-SIGNAUX - ", direction,
         " | Confirmations: ", confirmationCount, "/5",
         " | Momentum: ", momentumConfirm ? "âœ…" : "âŒ",
         " | Volume: ", volumeConfirm ? "âœ…" : "âŒ",
         " | Structure: ", structureConfirm ? "âœ…" : "âŒ",
         " | EMA: ", emaConfirm ? "âœ…" : "âŒ",
         " | VolatilitÃ©: ", volatilityConfirm ? "âœ…" : "âŒ");
   
   // Exiger au moins 3 confirmations sur 5
   return confirmationCount >= 3;
}

//| DÃ‰TECTION AVANCÃ‰E DE SPIKE IMMINENT                          |

// Calcule la compression de volatilitÃ© (prÃ©dicteur de spike)
double CalculateVolatilityCompression()
{
   // VÃ©rifier si l'handle ATR est valide
   if(atrHandle == INVALID_HANDLE) return 0.0;
   
   double buffer[];
   ArraySetAsSeries(buffer, true);
   
   // Utiliser ATR sur 20 pÃ©riodes pour la volatilitÃ© rÃ©cente
   if(CopyBuffer(atrHandle, 0, 0, 20, buffer) < 20) return 0.0;
   
   double recentATR = buffer[0];
   double avgATR = 0.0;
   
   // Calculer la moyenne ATR sur 20 pÃ©riodes
   for(int i = 0; i < 20; i++)
   {
      avgATR += buffer[i];
   }
   avgATR /= 20.0;
   
   // Compression = ratio ATR rÃ©cent / moyenne ATR
   if(avgATR == 0) return 0.0;
   return recentATR / avgATR;
}

// Calcule l'accÃ©lÃ©ration du prix (prÃ©dicteur de momentum)
double CalculatePriceAcceleration()
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   
   if(CopyRates(_Symbol, PERIOD_M1, 0, 10, rates) < 10) return 0.0;
   
   // Calculer les variations de prix sur 3 pÃ©riodes
   double change1 = (rates[0].close - rates[1].close) / rates[1].close;
   double change2 = (rates[1].close - rates[2].close) / rates[2].close;
   double change3 = (rates[2].close - rates[3].close) / rates[3].close;
   
   // AccÃ©lÃ©ration = variation des variations
   double acceleration = (change1 - change3) / 3.0;
   
   return acceleration;
}

// DÃ©tecte les pics de volume anormaux
bool DetectVolumeSpike()
{
   long volume[];
   ArraySetAsSeries(volume, true);
   
   if(CopyTickVolume(_Symbol, PERIOD_M1, 0, 20, volume) < 20) return false;
   
   double recentVolume = (double)volume[0];
   double avgVolume = 0.0;
   
   // Calculer la moyenne de volume sur 20 pÃ©riodes
   for(int i = 1; i < 20; i++) // Exclure la pÃ©riode la plus rÃ©cente
   {
      avgVolume += (double)volume[i];
   }
   avgVolume /= 19.0;
   
   // Spike si volume > 2x la moyenne
   return (recentVolume > avgVolume * 2.0);
}

// DÃ©tecte les patterns prÃ©-spike spÃ©cifiques Boom/Crash
bool IsPreSpikePattern()
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   
   if(CopyRates(_Symbol, PERIOD_M1, 0, 50, rates) < 50) return false;
   
   // 1. DÃ©tection de compression (range qui se resserre)
   double high50 = rates[0].high;
   double low50  = rates[0].low;
   for(int i = 1; i < 50; i++)
   {
      if(rates[i].high > high50) high50 = rates[i].high;
      if(rates[i].low  < low50)  low50  = rates[i].low;
   }
   double range50 = high50 - low50;
   
   double high10 = rates[0].high;
   double low10  = rates[0].low;
   for(int i = 1; i < 10; i++)
   {
      if(rates[i].high > high10) high10 = rates[i].high;
      if(rates[i].low  < low10)  low10  = rates[i].low;
   }
   double range10 = high10 - low10;
   
   // Compression rÃ©cente si range10 < (ratio) du range50
   bool compression = (range10 < range50 * PreSpike_CompressionRatio);
   
   // 2. DÃ©tection de formation en coin/wedge
   double ma5 = 0, ma20 = 0;
   for(int i = 0; i < 5; i++) ma5 += rates[i].close;
   ma5 /= 5.0;
   for(int i = 0; i < 20; i++) ma20 += rates[i].close;
   ma20 /= 20.0;
   
   // Prix proche de la moyenne mobile (consolidation)
   bool consolidation = (MathAbs(rates[0].close - ma20) / ma20 < PreSpike_ConsolidationPct);
   
   // 3. VÃ©rifier si le prix est Ã  un niveau clÃ©
   bool keyLevel = IsNearKeyLevel(rates[0].close);
   
   return (compression && consolidation && keyLevel);
}

// VÃ©rifie si le prix est prÃ¨s d'un niveau clÃ© (support/rÃ©sistance)
bool IsNearKeyLevel(double price)
{
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 100, rates) < 100) return false;
   
   // Chercher les niveaux de swing points rÃ©cents
   for(int i = 5; i < 50; i++)
   {
      double high = rates[i].high;
      double low = rates[i].low;
      
      // Si prix est Ã  moins de X% d'un swing high/low
      if(MathAbs(price - high) / high < PreSpike_KeyLevelPct || MathAbs(price - low) / low < PreSpike_KeyLevelPct)
      {
         return true;
      }
   }
   
   return false;
}

//+------------------------------------------------------------------+
//| Compte les ticks consÃ©cutifs dans chaque direction               |
//| Spike imminent quand drift contraire = 15+ ticks                 |
//+------------------------------------------------------------------+
void SpikeCountConsecutiveTicks()
{
   if(!SpikeUseAdvancedSignals) return;

   MqlRates r[];
   ArraySetAsSeries(r, true);
   int n = CopyRates(_Symbol, PERIOD_M1, 0, SpikeTickLookback + 2, r);
   if(n < 3) return;

   int consecUp = 0, consecDown = 0;
   for(int i = 0; i < MathMin(n - 1, SpikeTickLookback); i++)
   {
      if(r[i].close > r[i + 1].close)
      {
         consecUp++;
         consecDown = 0;
      }
      else if(r[i].close < r[i + 1].close)
      {
         consecDown++;
         consecUp = 0;
      }
      else
      {
         consecUp = 0;
         consecDown = 0;
      }
   }
   g_spikeTickConsecUp   = consecUp;
   g_spikeTickConsecDown = consecDown;
}

//+------------------------------------------------------------------+
//| VÃ©rifie si on est en session London ou New York                  |
//| London: 08:00-17:00 UTC, NY: 13:00-22:00 UTC                    |
//| +15-20% prÃ©cision spike pendant overlap London/NY                |
//+------------------------------------------------------------------+
bool SpikeIsSessionActive()
{
   if(!SpikeUseAdvancedSignals || SpikeSessionFilterMode == 0) return true;

   MqlDateTime dt;
   TimeGMT(dt);
   int hour = dt.hour;

   bool london = (hour >= 8 && hour < 17);
   bool ny     = (hour >= 13 && hour < 22);

   g_spikeSessionActive = false;
   switch(SpikeSessionFilterMode)
   {
      case 1: g_spikeSessionActive = (london || ny);       break; // London + NY
      case 2: g_spikeSessionActive = london;                break; // London only
      case 3: g_spikeSessionActive = ny;                    break; // NY only
   }
   return g_spikeSessionActive;
}

//+------------------------------------------------------------------+
//| Calcule le score du timing depuis le dernier spike               |
//| Plus on approche de l'intervalle moyen â†’ score plus Ã©levÃ©        |
//+------------------------------------------------------------------+
double SpikeTimeSinceLast()
{
   if(!SpikeUseAdvancedSignals) return 0.0;

   ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(_Symbol);
   if(cat != SYM_BOOM_CRASH) return 0.0;

   // Intervalle moyen en ticks selon l'indice
   double avgTicks = 1000.0;
   if(StringFind(_Symbol, "Boom300") >= 0 || StringFind(_Symbol, "Crash300") >= 0) avgTicks = 300.0;
   else if(StringFind(_Symbol, "Boom500") >= 0 || StringFind(_Symbol, "Crash500") >= 0) avgTicks = 500.0;
   else if(StringFind(_Symbol, "Boom600") >= 0 || StringFind(_Symbol, "Crash600") >= 0) avgTicks = 600.0;
   else if(StringFind(_Symbol, "Boom1000") >= 0 || StringFind(_Symbol, "Crash1000") >= 0) avgTicks = 1000.0;
   else if(StringFind(_Symbol, "Boom1500") >= 0 || StringFind(_Symbol, "Crash1500") >= 0) avgTicks = 1500.0;

   // DÃ©tecter le dernier spike via mouvement > 8x moyen
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   int n = CopyRates(_Symbol, PERIOD_M1, 0, 200, rates);
   if(n < 50) return 0.0;

   double avgMove = 0;
   for(int i = 1; i < MathMin(n, 100); i++)
      avgMove += MathAbs(rates[i].close - rates[i - 1].close);
   avgMove /= MathMin(n - 1, 99);

   double spikeThresh = avgMove * 5.0;
   datetime lastSpikeTime = 0;

   for(int i = 2; i < n; i++)
   {
      if(MathAbs(rates[i].close - rates[i - 1].close) > spikeThresh)
      {
         lastSpikeTime = rates[i].time;
         break;
      }
   }

   if(lastSpikeTime == 0)
   {
      g_spikeLastSpikeTime     = 0;
      g_spikeLastSpikeInterval = 0.0;
      return 0.5; // Pas de spike trouvÃ© = score neutre
   }

   g_spikeLastSpikeTime = lastSpikeTime;
   double elapsed = (double)(TimeCurrent() - lastSpikeTime);
   double avgSec = avgTicks * 2.0; // ~2 sec par tick en moyenne

   // Score: 0 = vient de spiker, 1 = Ã  l'intervalle moyen, 1.5 = en retard
   double ratio = elapsed / avgSec;
   double score = MathMin(1.5, ratio);
   g_spikeLastSpikeInterval = ratio;

   return score;
}

//+------------------------------------------------------------------+
//| Confirmation multi-timeframe (M1 + M5)                           |
//| VÃ©rifie que M5 est dans la mÃªme direction que M1                 |
//+------------------------------------------------------------------+
double SpikeMTFConfirm()
{
   if(!SpikeUseAdvancedSignals) return 0.0;

   ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(_Symbol);
   if(cat != SYM_BOOM_CRASH) return 0.0;

   MqlRates rM1[];
   ArraySetAsSeries(rM1, true);
   int n1 = CopyRates(_Symbol, PERIOD_M1, 0, 5, rM1);
   if(n1 < 3) return 0.0;

   // Trend M1: EMA3 vs EMA10
   double ema3 = (rM1[0].close + rM1[1].close + rM1[2].close) / 3.0;
   double ema10sum = 0;
   for(int i = 0; i < 10 && i < n1; i++) ema10sum += rM1[i].close;
   double ema10 = ema10sum / MathMin(10, n1);
   bool m1Bullish = (ema3 > ema10);
   bool m1Bearish = (ema3 < ema10);

   // Trend M5
   MqlRates rM5[];
   ArraySetAsSeries(rM5, true);
   int n5 = CopyRates(_Symbol, PERIOD_M5, 0, 10, rM5);
   if(n5 < 5) return 0.0;

   double ema3M5 = (rM5[0].close + rM5[1].close + rM5[2].close) / 3.0;
   double ema10M5sum = 0;
   for(int i = 0; i < MathMin(10, n5); i++) ema10M5sum += rM5[i].close;
   double ema10M5 = ema10M5sum / MathMin(10, n5);
   bool m5Bullish = (ema3M5 > ema10M5);
   bool m5Bearish = (ema3M5 < ema10M5);

   double score = 0.0;

   // Boom = bullish, Crash = bearish
   bool isBoom = IsBoomLikeSymbol(_Symbol);

   if(isBoom)
   {
      if(m1Bullish && m5Bullish) score = 1.0;  // Les deux bullish = forte confirmation
      else if(m1Bullish || m5Bullish) score = 0.5; // Un seul = faible confirmation
   }
   else // Crash
   {
      if(m1Bearish && m5Bearish) score = 1.0;
      else if(m1Bearish || m5Bearish) score = 0.5;
   }

   g_spikeMTFScore = score;
   return score;
}

//+------------------------------------------------------------------+
//| Dessine le panneau spike sur le chart                            |
//+------------------------------------------------------------------+
void SpikeDrawPanel(double prob, bool tickReady, bool sessActive, double lastSpikeScore, double mtfScore)
{
   if(!SpikeShowPanel) return;

   ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(_Symbol);
   if(cat != SYM_BOOM_CRASH) return;

   if(UseUnifiedDashboard)
   {
      // RemplacÃ© par la ligne "Spike:" du panneau unique â€” plus de cadre sÃ©parÃ©.
      ObjectsDeleteAll(0, "SPIKE_PNL_");
      g_unifiedSpikeLine = StringFormat("Spike: P=%.0f%% Ticks:\x2191%d\x2193%d%s | Sess=%s | MTF=%.0f%%",
                              prob * 100, g_spikeTickConsecUp, g_spikeTickConsecDown,
                              tickReady ? " OK" : "", sessActive ? "ON" : "OFF", mtfScore * 100);
      return;
   }

   // x=10,y=30 collisionnait en permanence avec le panneau natif MT5
   // "One Click Trading" (SELL/BUY), qui s'affiche toujours en haut Ã 
   // gauche du graphique et n'est pas dÃ©plaÃ§able par l'EA â€” d'oÃ¹ le
   // panneau PATTERNS/AvancÃ© recouvert et illisible. On le descend sous
   // cette zone ; ajuster SpikePanelY si le recouvrement persiste sur
   // ton Ã©cran (rÃ©solution/zoom diffÃ©rents).
   int x = 10, y = SpikePanelY;
   string prefix = "SPIKE_PNL_";

   // Fond du panneau
   ObjectCreate(0, prefix + "BG", OBJ_RECTANGLE_LABEL, 0, 0, 0);
   ObjectSetInteger(0, prefix + "BG", OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, prefix + "BG", OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, prefix + "BG", OBJPROP_XSIZE, 220);
   ObjectSetInteger(0, prefix + "BG", OBJPROP_YSIZE, 160);
   ObjectSetInteger(0, prefix + "BG", OBJPROP_BGCOLOR, C'20,20,30');
   ObjectSetInteger(0, prefix + "BG", OBJPROP_BORDER_COLOR, C'60,60,80');
   ObjectSetInteger(0, prefix + "BG", OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, prefix + "BG", OBJPROP_BACK, false);

   // Titre
   string title = "âš¡ SPIKE DETECTOR â€” " + _Symbol;
   ObjectCreate(0, prefix + "TITLE", OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, prefix + "TITLE", OBJPROP_XDISTANCE, x + 5);
   ObjectSetInteger(0, prefix + "TITLE", OBJPROP_YDISTANCE, y + 5);
   ObjectSetString(0, prefix + "TITLE", OBJPROP_TEXT, title);
   ObjectSetString(0, prefix + "TITLE", OBJPROP_FONT, "Arial Bold");
   ObjectSetInteger(0, prefix + "TITLE", OBJPROP_FONTSIZE, 9);
   ObjectSetInteger(0, prefix + "TITLE", OBJPROP_COLOR, clrWhite);

   // Ligne 1: ProbabilitÃ©
   string probStr = "ProbabilitÃ©: " + DoubleToString(prob * 100, 1) + "%";
   ObjectCreate(0, prefix + "PROB", OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, prefix + "PROB", OBJPROP_XDISTANCE, x + 5);
   ObjectSetInteger(0, prefix + "PROB", OBJPROP_YDISTANCE, y + 25);
   ObjectSetString(0, prefix + "PROB", OBJPROP_TEXT, probStr);
   ObjectSetString(0, prefix + "PROB", OBJPROP_FONT, "Arial");
   ObjectSetInteger(0, prefix + "PROB", OBJPROP_FONTSIZE, 8);
   ObjectSetInteger(0, prefix + "PROB", OBJPROP_COLOR, prob > 0.75 ? clrLime : prob > 0.50 ? clrYellow : clrGray);

   // Ligne 2: Tick Count
   string tickStr = "Ticks: â†‘" + IntegerToString(g_spikeTickConsecUp) + " â†“" + IntegerToString(g_spikeTickConsecDown);
   if(tickReady) tickStr += " âœ“";
   ObjectCreate(0, prefix + "TICK", OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, prefix + "TICK", OBJPROP_XDISTANCE, x + 5);
   ObjectSetInteger(0, prefix + "TICK", OBJPROP_YDISTANCE, y + 45);
   ObjectSetString(0, prefix + "TICK", OBJPROP_TEXT, tickStr);
   ObjectSetString(0, prefix + "TICK", OBJPROP_FONT, "Arial");
   ObjectSetInteger(0, prefix + "TICK", OBJPROP_FONTSIZE, 8);
   ObjectSetInteger(0, prefix + "TICK", OBJPROP_COLOR, tickReady ? clrLime : clrGray);

   // Ligne 3: Session
   string sessStr = "Session: " + (sessActive ? "ACTIVE âœ“" : "OFF");
   ObjectCreate(0, prefix + "SESS", OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, prefix + "SESS", OBJPROP_XDISTANCE, x + 5);
   ObjectSetInteger(0, prefix + "SESS", OBJPROP_YDISTANCE, y + 65);
   ObjectSetString(0, prefix + "SESS", OBJPROP_TEXT, sessStr);
   ObjectSetString(0, prefix + "SESS", OBJPROP_FONT, "Arial");
   ObjectSetInteger(0, prefix + "SESS", OBJPROP_FONTSIZE, 8);
   ObjectSetInteger(0, prefix + "SESS", OBJPROP_COLOR, sessActive ? clrLime : clrGray);

   // Ligne 4: Timing
   string timingStr = "Timing: " + DoubleToString(lastSpikeScore, 2) + "x";
   if(g_spikeLastSpikeInterval > 0)
      timingStr += " (/" + DoubleToString(g_spikeLastSpikeInterval, 1) + "x)";
   ObjectCreate(0, prefix + "TIME", OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, prefix + "TIME", OBJPROP_XDISTANCE, x + 5);
   ObjectSetInteger(0, prefix + "TIME", OBJPROP_YDISTANCE, y + 85);
   ObjectSetString(0, prefix + "TIME", OBJPROP_TEXT, timingStr);
   
   // FenÃªtre probabiliste du prochain spike (jamais prÃ©sentÃ©e comme une certitude).
   string timingLabel = "SPIKE_TIMING_INFO";
   string earlyLine = "SPIKE_TIME_EARLY";
   string centerLine = "SPIKE_TIME_CENTER";
   string lateLine = "SPIKE_TIME_LATE";
   ObjectDelete(0, timingLabel);
   ObjectDelete(0, earlyLine);
   ObjectDelete(0, centerLine);
   ObjectDelete(0, lateLine);

   if(ShowSpikeTimingForecast && ObjectCreate(0, timingLabel, OBJ_LABEL, 0, 0, 0))
   {
      ObjectSetInteger(0, timingLabel, OBJPROP_CORNER, CORNER_RIGHT_UPPER);
      ObjectSetInteger(0, timingLabel, OBJPROP_XDISTANCE, 20);
      ObjectSetInteger(0, timingLabel, OBJPROP_YDISTANCE, 100);
      ObjectSetInteger(0, timingLabel, OBJPROP_FONTSIZE, 10);
      ObjectSetString(0, timingLabel, OBJPROP_FONT, "Arial Bold");

      string msg = "Timing spike: historique insuffisant";
      color timingColor = clrSilver;

      if(g_spikeLastSpikeTime > 0)
      {
         string upperSymbol = _Symbol;
         StringToUpper(upperSymbol);
         double avgTicks = 1000.0;
         if(StringFind(upperSymbol, "300") >= 0) avgTicks = 300.0;
         else if(StringFind(upperSymbol, "500") >= 0) avgTicks = 500.0;
         else if(StringFind(upperSymbol, "600") >= 0) avgTicks = 600.0;
         else if(StringFind(upperSymbol, "1500") >= 0) avgTicks = 1500.0;

         // Conversion ticksâ†’temps avec la cadence rÃ©ellement observÃ©e ; fallback historique 0,5 tick/s.
         double ticksPerSecond = (g_tickFreqAvg > 0.05) ? g_tickFreqAvg : 0.5;
         double avgSec = MathMax(60.0, avgTicks / ticksPerSecond);
         double earlySec = avgSec * 0.80;
         double lateSec = avgSec * 1.20;
         double elapsed = MathMax(0.0, (double)(TimeCurrent() - g_spikeLastSpikeTime));
         double toEarly = earlySec - elapsed;
         double toCenter = avgSec - elapsed;
         double toLate = lateSec - elapsed;

         double timingConfidence = MathMax(5.0, MathMin(99.0, g_spikeAdvancedScore * 100.0));
         if(toEarly > 0)
         {
            msg = "FenÃªtre spike estimÃ©e dans " + IntegerToString((int)(toEarly / 60.0)) + "m" +
                  IntegerToString((int)toEarly % 60) + "s Ã  " +
                  IntegerToString((int)(toLate / 60.0)) + "m" + IntegerToString((int)toLate % 60) + "s";
            timingColor = clrYellow;
         }
         else if(toLate >= 0)
         {
            msg = "FENÃŠTRE SPIKE ACTIVE | centre " +
                  ((toCenter >= 0) ? "dans " + IntegerToString((int)toCenter) + "s" :
                                     "dÃ©passÃ© de " + IntegerToString((int)MathAbs(toCenter)) + "s") +
                  " | score " + DoubleToString(timingConfidence, 0) + "%";
            timingColor = clrOrange;
         }
         else
         {
            msg = "SPIKE EN RETARD STATISTIQUE de " + IntegerToString((int)MathAbs(toLate)) +
                  "s | pression " + DoubleToString(timingConfidence, 0) + "%";
            timingColor = clrTomato;
         }
         msg += " (estimation, non garantie)";

         datetime tEarly = g_spikeLastSpikeTime + (datetime)earlySec;
         datetime tCenter = g_spikeLastSpikeTime + (datetime)avgSec;
         datetime tLate = g_spikeLastSpikeTime + (datetime)lateSec;

         if(ObjectCreate(0, earlyLine, OBJ_VLINE, 0, tEarly, 0))
         {
            ObjectSetInteger(0, earlyLine, OBJPROP_COLOR, clrYellow);
            ObjectSetInteger(0, earlyLine, OBJPROP_STYLE, STYLE_DOT);
            ObjectSetInteger(0, earlyLine, OBJPROP_BACK, true);
            ObjectSetInteger(0, earlyLine, OBJPROP_SELECTABLE, false);
            ObjectSetString(0, earlyLine, OBJPROP_TOOLTIP, "DÃ©but estimÃ© de fenÃªtre spike");
         }
         if(ObjectCreate(0, centerLine, OBJ_VLINE, 0, tCenter, 0))
         {
            ObjectSetInteger(0, centerLine, OBJPROP_COLOR, clrOrange);
            ObjectSetInteger(0, centerLine, OBJPROP_WIDTH, 2);
            ObjectSetInteger(0, centerLine, OBJPROP_BACK, true);
            ObjectSetInteger(0, centerLine, OBJPROP_SELECTABLE, false);
            ObjectSetString(0, centerLine, OBJPROP_TOOLTIP, "Centre statistique estimÃ© â€” non garanti");
         }
         if(ObjectCreate(0, lateLine, OBJ_VLINE, 0, tLate, 0))
         {
            ObjectSetInteger(0, lateLine, OBJPROP_COLOR, clrTomato);
            ObjectSetInteger(0, lateLine, OBJPROP_STYLE, STYLE_DOT);
            ObjectSetInteger(0, lateLine, OBJPROP_BACK, true);
            ObjectSetInteger(0, lateLine, OBJPROP_SELECTABLE, false);
            ObjectSetString(0, lateLine, OBJPROP_TOOLTIP, "Fin estimÃ©e de fenÃªtre spike");
         }
      }

      ObjectSetString(0, timingLabel, OBJPROP_TEXT, msg);
      ObjectSetInteger(0, timingLabel, OBJPROP_COLOR, timingColor);
   }
   ObjectSetString(0, prefix + "TIME", OBJPROP_FONT, "Arial");
   ObjectSetInteger(0, prefix + "TIME", OBJPROP_FONTSIZE, 8);
   ObjectSetInteger(0, prefix + "TIME", OBJPROP_COLOR, lastSpikeScore > 0.8 ? clrLime : clrGray);

   // Ligne 5: Multi-TF
   string mtfStr = "Multi-TF: " + DoubleToString(mtfScore, 2);
   ObjectCreate(0, prefix + "MTF", OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, prefix + "MTF", OBJPROP_XDISTANCE, x + 5);
   ObjectSetInteger(0, prefix + "MTF", OBJPROP_YDISTANCE, y + 105);
   ObjectSetString(0, prefix + "MTF", OBJPROP_TEXT, mtfStr);
   ObjectSetString(0, prefix + "MTF", OBJPROP_FONT, "Arial");
   ObjectSetInteger(0, prefix + "MTF", OBJPROP_FONTSIZE, 8);
   ObjectSetInteger(0, prefix + "MTF", OBJPROP_COLOR, mtfScore > 0.7 ? clrLime : mtfScore > 0.3 ? clrYellow : clrGray);

   // Ligne 6: Score avancÃ©
   string advStr = "AvancÃ©: " + DoubleToString(g_spikeAdvancedScore * 100, 1) + "%";
   ObjectCreate(0, prefix + "ADV", OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, prefix + "ADV", OBJPROP_XDISTANCE, x + 5);
   ObjectSetInteger(0, prefix + "ADV", OBJPROP_YDISTANCE, y + 125);
   ObjectSetString(0, prefix + "ADV", OBJPROP_TEXT, advStr);
   ObjectSetString(0, prefix + "ADV", OBJPROP_FONT, "Arial Bold");
   ObjectSetInteger(0, prefix + "ADV", OBJPROP_FONTSIZE, 9);
   ObjectSetInteger(0, prefix + "ADV", OBJPROP_COLOR, g_spikeAdvancedScore > 0.75 ? clrLime : g_spikeAdvancedScore > 0.50 ? clrYellow : clrOrange);

   // Ligne 7: Verdict
   string verdict = "â¸ ATTENTE";
   color verdictClr = clrGray;
   if(prob > 0.75 && g_spikeAdvancedScore > 0.60) { verdict = "ðŸŸ¢ SPIKE IMMINENT"; verdictClr = clrLime; }
   else if(prob > 0.50 || g_spikeAdvancedScore > 0.50) { verdict = "ðŸŸ¡ Ã‰LEVÃ‰"; verdictClr = clrYellow; }

   ObjectCreate(0, prefix + "VERDICT", OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, prefix + "VERDICT", OBJPROP_XDISTANCE, x + 5);
   ObjectSetInteger(0, prefix + "VERDICT", OBJPROP_YDISTANCE, y + 142);
   ObjectSetString(0, prefix + "VERDICT", OBJPROP_TEXT, verdict);
   ObjectSetString(0, prefix + "VERDICT", OBJPROP_FONT, "Arial Bold");
   ObjectSetInteger(0, prefix + "VERDICT", OBJPROP_FONTSIZE, 10);
   ObjectSetInteger(0, prefix + "VERDICT", OBJPROP_COLOR, verdictClr);
}

//+------------------------------------------------------------------+
//| Dessine l'histogramme spike sous le panneau                      |
//+------------------------------------------------------------------+
void SpikeDrawHistogram(double prob)
{
   if(!SpikeShowHistogram) return;

   ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(_Symbol);
   if(cat != SYM_BOOM_CRASH) return;

   int x = 10, y = 200;
   string prefix = "SPIKE_HIST_";

   // Fond histogramme
   ObjectCreate(0, prefix + "BG", OBJ_RECTANGLE_LABEL, 0, 0, 0);
   ObjectSetInteger(0, prefix + "BG", OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, prefix + "BG", OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, prefix + "BG", OBJPROP_XSIZE, 220);
   ObjectSetInteger(0, prefix + "BG", OBJPROP_YSIZE, 30);
   ObjectSetInteger(0, prefix + "BG", OBJPROP_BGCOLOR, C'15,15,25');
   ObjectSetInteger(0, prefix + "BG", OBJPROP_BORDER_COLOR, C'50,50,70');
   ObjectSetInteger(0, prefix + "BG", OBJPROP_CORNER, CORNER_LEFT_UPPER);

   // Barre de probabilitÃ©
   int barWidth = (int)(prob * 210);
   color barColor = prob > 0.75 ? clrLime : prob > 0.50 ? clrYellow : prob > 0.25 ? clrOrange : clrRed;

   ObjectCreate(0, prefix + "BAR", OBJ_RECTANGLE_LABEL, 0, 0, 0);
   ObjectSetInteger(0, prefix + "BAR", OBJPROP_XDISTANCE, x + 5);
   ObjectSetInteger(0, prefix + "BAR", OBJPROP_YDISTANCE, y + 5);
   ObjectSetInteger(0, prefix + "BAR", OBJPROP_XSIZE, barWidth);
   ObjectSetInteger(0, prefix + "BAR", OBJPROP_YSIZE, 20);
   ObjectSetInteger(0, prefix + "BAR", OBJPROP_BGCOLOR, barColor);
   ObjectSetInteger(0, prefix + "BAR", OBJPROP_CORNER, CORNER_LEFT_UPPER);

   // Pourcentage
   ObjectCreate(0, prefix + "TXT", OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, prefix + "TXT", OBJPROP_XDISTANCE, x + 80);
   ObjectSetInteger(0, prefix + "TXT", OBJPROP_YDISTANCE, y + 8);
   ObjectSetString(0, prefix + "TXT", OBJPROP_TEXT, DoubleToString(prob * 100, 0) + "%");
   ObjectSetString(0, prefix + "TXT", OBJPROP_FONT, "Arial Bold");
   ObjectSetInteger(0, prefix + "TXT", OBJPROP_FONTSIZE, 10);
   ObjectSetInteger(0, prefix + "TXT", OBJPROP_COLOR, clrWhite);
}

//+------------------------------------------------------------------+
//| Dessine une flÃ¨che sur le chart quand spike imminent             |
//+------------------------------------------------------------------+
void SpikeDrawArrow(double prob)
{
   if(!SpikeShowArrows) return;

   ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(_Symbol);
   if(cat != SYM_BOOM_CRASH) return;

   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 1, rates) < 1) return;

   bool isBoom = IsBoomLikeSymbol(_Symbol);
   bool spikeReady = (prob > 0.75 && g_spikeAdvancedScore > 0.60);

   if(!spikeReady) return;

   string arrowName = "SPIKE_ARROW_" + TimeToString(rates[0].time, TIME_DATE | TIME_MINUTES);

   if(ObjectFind(0, arrowName) >= 0) return;

   int arrowCode = isBoom ? 233 : 234; // UP pour Boom, DOWN pour Crash
   color arrowColor = isBoom ? clrLime : clrRed;
   double price = isBoom ? rates[0].low - _Point * 50 : rates[0].high + _Point * 50;

   ObjectCreate(0, arrowName, OBJ_ARROW, 0, rates[0].time, price);
   ObjectSetInteger(0, arrowName, OBJPROP_ARROWCODE, arrowCode);
   ObjectSetInteger(0, arrowName, OBJPROP_COLOR, arrowColor);
   ObjectSetInteger(0, arrowName, OBJPROP_WIDTH, 3);
   ObjectSetString(0, arrowName, OBJPROP_TOOLTIP,
      "âš¡ SPIKE " + (isBoom ? "UP" : "DOWN") + " | Prob: " + DoubleToString(prob * 100, 0) + "%");
}

// Calcule la probabilitÃ© de spike imminent
double CalculateSpikeProbability()
{
   // Objectif: fournir une proba 0..1 stable et exploitable mÃªme quand le serveur IA ne renvoie rien.
   // Signaux originaux + 4 signaux avancÃ©s: tick count, session, timing, multi-TF.
   ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(_Symbol);

   double volCompression = 1.0;
   if(atrHandle != INVALID_HANDLE)
   {
      double atrBuf[];
      ArraySetAsSeries(atrBuf, true);
      if(CopyBuffer(atrHandle, 0, 0, 10, atrBuf) >= 6)
      {
         double recentATR = atrBuf[0];
         double avgATR = 0.0;
         for(int i = 1; i <= 5; i++) avgATR += atrBuf[i];
         avgATR /= 5.0;
         if(avgATR > 0.0) volCompression = recentATR / avgATR;
      }
   }

   // Rates M1 rapides
   MqlRates r5[];
   ArraySetAsSeries(r5, true);
   double accel = 0.0;
   double rangeRatio = 1.0;
   if(CopyRates(_Symbol, PERIOD_M1, 0, 6, r5) >= 3)
   {
      double change1 = (r5[0].close - r5[1].close) / (r5[1].close == 0 ? 1.0 : r5[1].close);
      double change2 = (r5[1].close - r5[2].close) / (r5[2].close == 0 ? 1.0 : r5[2].close);
      accel = (change1 - change2) / 2.0;

      double range0 = MathAbs(r5[0].high - r5[0].low);
      double avgRange = 0.0;
      for(int i = 1; i < 6; i++) avgRange += MathAbs(r5[i].high - r5[i].low);
      avgRange /= 5.0;
      if(avgRange > 0.0) rangeRatio = range0 / avgRange;
   }

   // Volume ratio
   double volRatio = 1.0;
   bool volumeSpike = false;
   long volTicks[];
   ArraySetAsSeries(volTicks, true);
   if(CopyTickVolume(_Symbol, PERIOD_M1, 0, 10, volTicks) >= 6)
   {
      double recentV = (double)volTicks[0];
      double avgV = 0.0;
      for(int i = 1; i <= 5; i++) avgV += (double)volTicks[i];
      avgV /= 5.0;
      if(avgV > 0.0) volRatio = recentV / avgV;
      volumeSpike = (volRatio >= 1.6);
   }

   // PrÃ©-spike "light" (sans scan swing complet)
   bool preSpikePattern = false;
   MqlRates r60[];
   ArraySetAsSeries(r60, true);
   if(cat == SYM_BOOM_CRASH && CopyRates(_Symbol, PERIOD_M1, 0, 60, r60) >= 50)
   {
      double hi10 = r60[0].high, lo10 = r60[0].low;
      for(int i = 0; i < 10; i++) { hi10 = MathMax(hi10, r60[i].high); lo10 = MathMin(lo10, r60[i].low); }
      double range10 = hi10 - lo10;
      double hi50 = r60[0].high, lo50 = r60[0].low;
      for(int i = 0; i < 50; i++) { hi50 = MathMax(hi50, r60[i].high); lo50 = MathMin(lo50, r60[i].low); }
      double range50 = hi50 - lo50;

      double ma20 = 0.0;
      for(int i = 0; i < 20; i++) ma20 += r60[i].close;
      ma20 /= 20.0;
      bool compression = (range50 > 0.0 && range10 < range50 * PreSpike_CompressionRatio);
      bool consolidation = (ma20 > 0.0 && (MathAbs(r60[0].close - ma20) / ma20) < PreSpike_ConsolidationPct);
      preSpikePattern = (compression && consolidation);
   }

   // ProximitÃ© canal SMC H1
   bool touchChannel = false;
   if(cat == SYM_BOOM_CRASH)
   {
       if(IsBoomLikeSymbol(_Symbol))  touchChannel = PriceTouchesLowerChannel();
       if(IsCrashLikeSymbol(_Symbol)) touchChannel = PriceTouchesUpperChannel();
   }

   // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   // SIGNAUX AVANCÃ‰S (4 nouveaux)
   // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

   // 1) Tick Count directionnel â€” drift contraire long = spike probable
   SpikeCountConsecutiveTicks();
   bool tickReady = false;
   double sTick = 0.0;
   if(cat == SYM_BOOM_CRASH)
   {
      bool isBoom = IsBoomLikeSymbol(_Symbol);
      // Boom: drift baissier (ticks down) = prÃ©-spike haussier
      // Crash: drift haussier (ticks up) = prÃ©-spike baissier
      int contraCount = isBoom ? g_spikeTickConsecDown : g_spikeTickConsecUp;
      if(contraCount >= SpikeTickConsecTarget)
      {
         sTick = MathMin(1.0, (double)contraCount / (SpikeTickConsecTarget * 2.0));
         tickReady = true;
      }
      else
         sTick = (double)contraCount / (SpikeTickConsecTarget * 2.0);
   }

   // 2) Session filter â€” London/NY = +15-20% prÃ©cision
   SpikeIsSessionActive();
   double sSess = g_spikeSessionActive ? 1.0 : 0.3; // Pas en session = score rÃ©duit

   // 3) Timing dernier spike â€” plus on approche de l'intervalle moyen = plus probable
   double lastSpikeScore = SpikeTimeSinceLast();
   double sTime = MathMin(1.0, lastSpikeScore);

   // 4) Multi-TF confirmation (M1 + M5)
   double mtfScore = SpikeMTFConfirm();
   double sMTF = mtfScore;

   // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   // PONDÃ‰RATION FINALE (rebasÃ©e pour inclure les 4 nouveaux signaux)
   // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

   double sCompression = 0.0;
   if(volCompression < 1.0) sCompression = MathMin((1.0 - volCompression) / 0.6, 1.0);
   double sAccel = MathMin(MathAbs(accel) / 0.003, 1.0);
   double sVolume = 0.0;
   if(volRatio > 1.0) sVolume = MathMin((volRatio - 1.0) / 1.5, 1.0);
   double sRange = 0.0;
   if(rangeRatio > 1.0) sRange = MathMin((rangeRatio - 1.0) / 1.0, 1.0);
   double sPre = preSpikePattern ? 1.0 : 0.0;
   double sChan = touchChannel ? 1.0 : 0.0;

   double probability =
      0.20 * sCompression +   // 20% (was 25%)
      0.15 * sAccel +         // 15% (was 20%)
      0.15 * sVolume +        // 15% (was 20%)
      0.10 * sRange +         // 10% (same)
      0.05 * sPre +           //  5% (was 10%)
      0.05 * sChan +          //  5% (was 10%)
      SpikeTickWeight    * sTick +   // 10% NEW
      SpikeSessionWeight * sSess +   // 10% NEW
      SpikeLastSpikeWeight * sTime + // 15% NEW
      SpikeMTFWeight     * sMTF;     // 10% NEW

   probability = MathMax(0.0, MathMin(probability, 1.0));

   // Score avancÃ© global
   g_spikeAdvancedScore = probability;

   // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   // Ã‰LÃ‰MENTS GRAPHIQUES
   // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   SpikeDrawPanel(probability, tickReady, g_spikeSessionActive, lastSpikeScore, mtfScore);
   SpikeDrawHistogram(probability);
   SpikeDrawArrow(probability);

   // Publier pour les filtres/affichages
   g_lastSpikeProbability = probability;
   g_lastSpikeUpdate      = TimeCurrent();

   return probability;
}

// Algo Deriv reproduit : conditions prÃ©-spike mÃ»res (Z-Score ATR + EMA + Cooldown)
// Retourne true quand les conditions sont rÃ©unies pour un spike imminent
bool IsAlgoSpikeReady()
{
   if(atrHandle == INVALID_HANDLE) return false;

   // 1) Z-Score ATR (fenÃªtre 20 pÃ©riodes)
   double atrBuf[];
   ArraySetAsSeries(atrBuf, true);
   if(CopyBuffer(atrHandle, 0, 0, 21, atrBuf) < 21) return false;

   double sum = 0.0, sumSq = 0.0;
   for(int i = 1; i <= 20; i++) { sum += atrBuf[i]; sumSq += atrBuf[i] * atrBuf[i]; }
   double mean = sum / 20.0;
   double variance = (sumSq / 20.0) - (mean * mean);
   double stdDev = (variance > 0) ? MathSqrt(variance) : 0.0;
   double zScore = (stdDev > 0) ? (atrBuf[0] - mean) / stdDev : 0.0;

   // Compression = Z-Score nÃ©gatif (volatilitÃ© basse = prÃ©-spike)
   // OU Z-Score trÃ¨s Ã©levÃ© = spike en cours/imminent
   bool atrReady = (zScore <= -1.0 || zScore >= 2.0);

   // 2) EMA(14) condition â€” prix dans la tendance du spike attendu
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 15, rates) < 15) return false;
   double close = rates[0].close;

   double emaSum = 0.0;
   double k = 2.0 / (14.0 + 1.0);
   double ema = rates[14].close;
   for(int i = 13; i >= 0; i--)
      ema = rates[i].close * k + ema * (1.0 - k);

   bool isBoom = IsBoomLikeSymbol(_Symbol);
   bool emaOk = isBoom ? (close > ema) : (close < ema);

   // 3) Cooldown estimÃ© : pas de gros mouvement rÃ©cent (5 derniÃ¨res bougies)
   double maxMove = 0.0;
   for(int i = 0; i < 5; i++)
      maxMove = MathMax(maxMove, MathAbs(rates[i].close - rates[i].open));
   double avgBody = 0.0;
   for(int i = 5; i < 15; i++)
      avgBody += MathAbs(rates[i].close - rates[i].open);
   avgBody /= 10.0;
   bool cooldownOk = (avgBody > 0 && maxMove < avgBody * 3.0);

   // 4) Tick Frequency Analysis â€” ralentissement = fin de cooldown = spike imminent
   //    Ratio < 0.6 signifie que les ticks arrivent 40%+ plus lentement que la moyenne
   //    C'est le signal que le gÃ©nÃ©rateur Deriv est en phase de cooldown terminal
   bool tickFreqReady = false;
   if(g_tickFreqAvg > 2.0) // besoin d'au moins quelques secondes de donnÃ©es
   {
      // Ralentissement : ticks/sec actuel < 60% de la moyenne = cooldown actif
      double recentRate = (double)g_tickFreqCurrent;
      double ratio = recentRate / g_tickFreqAvg;
      g_tickFreqRatio = ratio;
      tickFreqReady = (ratio <= 0.6);
   }

   // Combinaison : Z-Score + EMA + (Cooldown candles OU Tick Frequency)
   bool conditionsReady = atrReady && emaOk && (cooldownOk || tickFreqReady);

   if(conditionsReady)
   {
      Print("[ALGO-SPIKE] âœ… Conditions mÃ»res | Z-Score=", DoubleToString(zScore, 2),
            " | EMA=", DoubleToString(ema, _Digits),
            " | close=", DoubleToString(close, _Digits),
            " | ", isBoom ? "close>EMA" : "close<EMA",
            " | TickFreq=", DoubleToString(g_tickFreqRatio, 2),
            tickFreqReady ? " [TICK-SLOW]" : " [CANDLE-OK]");
      return true;
   }
   return false;
}

//+------------------------------------------------------------------+
//| Override GOM WAIT par chaÃ®ne spike native (fiable et alignÃ©e).    |
//| N'accepte QUE les raisons forecast faibles/absentes ; jamais une  |
//| opposition forte. VÃ©rifie fraÃ®cheur, alignement M1/M5/M15 et      |
//| l'absence de correction / trade en cours.                         |
//+------------------------------------------------------------------+
bool SMC_SpikeChainGomReasonIsOverridable(const string reason)
{
   return (reason == "5m_forecast_unavailable" ||
           reason == "5m_forecast_unconfirmed" ||
           reason == "weak_opposing_5m_m1_structure" ||
           reason == "weak_opposing_5m_with_native_spike_htf");
}

bool SMC_SpikeChainGomEntryOverrideAllowed(const string symbol, const int dirSign)
{
   if(dirSign == 0) return false;
   if(symbol != _Symbol) return false;

   // Symboles Ã  spikes uniquement, sens natif strict (Boom/GainX=BUY, Crash/PainX=SELL)
   if(!SMC_IsSpikeStyleSymbol(symbol)) return false;
   if(!((IsBoomLikeSymbol(symbol) && dirSign > 0) ||
        (IsCrashLikeSymbol(symbol) && dirSign < 0)))
      return false;

   // Pas de verdict serveur dÃ©jÃ  exploitable
   int serverVn = g_smcGomVerdictNumServer;
   if(!(MathAbs(serverVn) < 2)) return false;

   // FraÃ®cheur du poll GOM + du prix marchÃ©
   long pollAgeSec = (g_smcLastGOMPoll > 0)
                     ? (long)(TimeCurrent() - g_smcLastGOMPoll)
                     : 1000000;
   if(pollAgeSec > 90) return false;
   double priceAgeSec = g_smcMarketPriceAgeSec;
   if(!g_smcMarketPriceFresh || priceAgeSec < 0.0 || priceAgeSec > 90.0)
      return false;

   // ChaÃ®ne de spikes native active et assez puissante
   if(g_spikeChainState != SPIKE_STATE_CHAIN_ACTIVE) return false;
   if(g_spikeChainStrongBars < 2) return false;

   // Alignement M1 / M5 / M15 dans le sens natif
   string m1Dir = (StringLen(g_smcTfM1DirLive) > 0) ? g_smcTfM1DirLive : g_smcTfM1Dir;
   if(!SMC_TfDirMatchesSign(dirSign, m1Dir)) return false;
   if(!SMC_TfDirMatchesSign(dirSign, g_smcTfM5Dir)) return false;
   if(!SMC_TfDirMatchesSign(dirSign, g_smcTfM15Dir)) return false;

   // Aucune position ni ordre en attente sur ce symbole
   if(CountPositionsForSymbol(symbol) > 0) return false;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong tk = OrderGetTicket(i);
      if(tk == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) == symbol) return false;
   }

   // Aucune correction dure / attente serveur / blocage M1 en cours
   if(g_smcGomHardDollarCorrection) return false;
   if(g_smcGomServerCorrWait) return false;
   if(g_smcM1EntryBlocked) return false;
   if(g_smcPaInCorrection && !g_smcCorrEntrySafe) return false;

   // Raison de correction : JAMAIS une opposition forte
   string corrReason = g_smcGomCorrectionReason;
   StringToLower(corrReason);
   if(StringFind(corrReason, "strongly_opposes") >= 0) return false;

   // Forecast 5m : raison faible/absente uniquement
   string entryBlockReason = g_smcGomEntryBlockReason;
   StringToLower(entryBlockReason);
   string gateReason = g_smcMarketForecastGateReason;
   StringToLower(gateReason);
   bool forecastHasNoConfirmation =
      SMC_SpikeChainGomReasonIsOverridable(entryBlockReason) ||
      SMC_SpikeChainGomReasonIsOverridable(gateReason);
   if(!forecastHasNoConfirmation && entryBlockReason == "wait")
      forecastHasNoConfirmation = true;
   if(!forecastHasNoConfirmation) return false;

   return true;
}

// Envoie une alerte de spike imminent - VERSION OPTIMISÃ‰E

//+------------------------------------------------------------------+
//| FIX 2026-09-26 : entrÃ©e auto quand flÃ¨che spike / proba imminente |
//| Ã‰tait dÃ©clarÃ©e mais JAMAIS dÃ©finie ni appelÃ©e â†’ EA "sourd" Ã  la   |
//| flÃ¨che clignotante.                                               |
//+------------------------------------------------------------------+
bool SMC_SpikePredictConfirms(const int dirSign)
{
   if(!(IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol) || SMC_IsSynthSpikeFamily(_Symbol)))
      return true;
   if(dirSign == 0) return false;

   double chain = ChainPred_GetImminence();
   double cross = UseChainPredictor ? CrossCorr_GetImminenceBoost() : 0.0;
   double total = MathMin(100.0, chain + cross);
   double localP = CalculateSpikeProbability() * 100.0;
   int chainDir = ChainPred_GetChainDirection();
   bool dirOk = (chainDir == 0 || (dirSign > 0 && chainDir > 0) || (dirSign < 0 && chainDir < 0));
   if(!dirOk && ChainPred_GetChainLength() >= 2)
      return false;
   if(g_smcGomSpikeTradable && dirOk) return true;
   if(g_smcGomImminencePct >= 55.0 && dirOk) return true;
   if(localP >= 55.0 && dirOk) return true;
   if(total >= ChainPredWeakThresh && dirOk) return true;
   if(ChainPred_GetChainLength() >= 2 && dirOk) return true;
   if(chain <= 0.0 && g_smcGomImminencePct <= 0.0)
      return true;
   return false;
}

bool SMC_SpikeChainImminent(const int dirSign)
{
   if(!UseChainPredictor) return false;
   if(!(IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol) || SMC_IsSynthSpikeFamily(_Symbol)))
      return false;
   if(!IsDirectionAllowedForBoomCrash(_Symbol, dirSign > 0 ? "BUY" : "SELL"))
      return false;
   double total = MathMin(100.0, ChainPred_GetImminence() + CrossCorr_GetImminenceBoost());
   if(total < ChainPredStrongThresh && g_smcGomImminencePct < 70.0
      && CalculateSpikeProbability() < 0.70)
      return false;
   return SMC_SpikePredictConfirms(dirSign);
}

void TrySpikeImminentAutoEntry(const double spikeProb)
{
   if(!UseSpikeImminentAutoTrade) return;
   if(spikeProb < 0.75) return;
   if(!(IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol) || SMC_IsSynthSpikeFamily(_Symbol)))
      return;
   if(IsTerminalFull()) return;
   if(CountPositionsForSymbol(_Symbol) > 0) return;
   if(CountPositionsOurEA() >= MathMax(1, MaxPositionsTerminal)) return;

   // Anti-spam : 1 tentative / symbole / 15 s
   static datetime s_lastTry = 0;
   static string   s_lastSym = "";
   if(s_lastSym == _Symbol && (TimeCurrent() - s_lastTry) < 15)
      return;

   // PainX/Crash â†’ SELL, Boom/GainX â†’ BUY
   string su = _Symbol; StringToUpper(su);
   bool wantBuy = true;
   if(StringFind(su, "CRASH") >= 0 || StringFind(su, "PAINX") >= 0)
      wantBuy = false;
   else if(StringFind(su, "BOOM") >= 0 || StringFind(su, "GAINX") >= 0)
      wantBuy = true;
   else
      wantBuy = IsBoomLikeSymbol(_Symbol);

   int dirSign = wantBuy ? 1 : -1;
   ENUM_ORDER_TYPE ot = wantBuy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;

   SMCGP_RestoreCachedIfDisconnected();
   if(!SMCGP_GomLinkOK())
   {
      Print("âš¡ SPIKE-IMMINENT skip â€” GOM dÃ©connectÃ© | prob=", DoubleToString(spikeProb*100,1), "%");
      return;
   }
   if(!SMCGP_SpikeFireAllowed(_Symbol, dirSign))
   {
      Print("âš¡ SPIKE-IMMINENT skip â€” flÃ¨che/proba seuls insuffisants | besoin GOM GOOD/PERFECT + M1/M5/M15 | ",
            _Symbol, " vn=", g_smcGomVerdictNum, " srv=", g_smcGomVerdictNumServer,
            " M1=", g_smcTfM1Dir, " M5=", g_smcTfM5Dir, " M15=", g_smcTfM15Dir,
            " | prob=", DoubleToString(spikeProb*100,1), "%");
      return;
   }

   TradingSignal requiredSignal = wantBuy ? SIGNAL_BUY_ENTER : SIGNAL_SELL_ENTER;
   if(g_gomCommittedSignal != requiredSignal || g_gomCommittedDir != dirSign ||
      !IsSignalConfirmed() || GetConfirmedSignalDir() != dirSign)
   {
      Print("âš¡ SPIKE-IMMINENT diffÃ©rÃ© â€” ENTER GOM correspondant non confirmÃ© | ",
            _Symbol, " dir=", dirSign);
      return;
   }

   double levelAtr = SMC_EffectiveSymbolATR(_Symbol);
   double levelPrice = wantBuy ? SymbolInfoDouble(_Symbol, SYMBOL_ASK)
                               : SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double touchedLevel = 0.0;
   string touchedLevelSource = "";
   if(levelAtr <= 0.0 || levelPrice <= 0.0 ||
      !SMC_UnifiedFindTouchedLevel(dirSign, levelPrice,
                                   levelAtr * MathMax(0.05, UnifiedLevelTouchATR),
                                   touchedLevel, touchedLevelSource))
   {
      Print("âš¡ SPIKE-IMMINENT diffÃ©rÃ© â€” aucun niveau S/R ou FVG touchÃ© | ", _Symbol);
      return;
   }

   MqlRates entryM1[];
   ArraySetAsSeries(entryM1, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 2, entryM1) < 2)
   {
      Print("âš¡ SPIKE-IMMINENT diffÃ©rÃ© â€” historique M1 indisponible | ", _Symbol);
      return;
   }
   bool closedM1Confirms = wantBuy
                           ? (entryM1[1].close > entryM1[1].open)
                           : (entryM1[1].close < entryM1[1].open);
   bool liveM1Confirms = wantBuy
                         ? (entryM1[0].close > entryM1[0].open)
                         : (entryM1[0].close < entryM1[0].open);
   if(!closedM1Confirms || !liveM1Confirms)
   {
      Print("âš¡ SPIKE-IMMINENT diffÃ©rÃ© â€” M1 ne confirme pas le retournement | ",
            _Symbol, " clÃ´turÃ©e=", closedM1Confirms, " en cours=", liveM1Confirms,
            " | niveau=", touchedLevelSource);
      return;
   }

   if(!TryAcquireOpenLock()) return;

   double atrVal = 0.0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[]; ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atrVal = ab[0];
   }
   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double lot = CalculateLotSize();
   if(lot <= 0) { ReleaseOpenLock(); return; }

   if(!CanTradeOnSymbol(_Symbol, wantBuy ? "BUY" : "SELL"))
   {
      Print("âš¡ SPIKE-IMMINENT bloquÃ© CanTradeOnSymbol");
      ReleaseOpenLock();
      g_secondSpikeInFlight = false;
      return;
   }
   if(!SMC_FinalOpenGate(_Symbol, ot))
   {
      Print("âš¡ SPIKE-IMMINENT bloquÃ© FinalOpenGate vn=", g_smcGomVerdictNum);
      ReleaseOpenLock();
      g_secondSpikeInFlight = false;
      return;
   }

   bool ok = false;
   double entry, sl, tp;
   if(wantBuy)
   {
      entry = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      sl = (atrVal > 0) ? NormalizeDouble(entry - atrVal * 1.5, dg) : 0;
      tp = (atrVal > 0) ? NormalizeDouble(entry + atrVal * 3.0, dg) : 0;
      ok = SafeTradeBuy(lot, _Symbol, entry, sl, tp, "SPIKE-IMMINENT BUY");
   }
   else
   {
      entry = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      sl = (atrVal > 0) ? NormalizeDouble(entry + atrVal * 1.5, dg) : 0;
      tp = (atrVal > 0) ? NormalizeDouble(entry - atrVal * 3.0, dg) : 0;
      ok = SafeTradeSell(lot, _Symbol, entry, sl, tp, "SPIKE-IMMINENT SELL");
   }

   s_lastTry = TimeCurrent();
   s_lastSym = _Symbol;
   g_secondSpikeInFlight = false;
   ReleaseOpenLock();

   if(ok)
   {
      RegisterOrderPlaced();
      SMC_GateRegisterOpened(_Symbol, wantBuy);
      Print("âš¡ SPIKE-IMMINENT ", (wantBuy ? "BUY" : "SELL"), " ", _Symbol,
            " @", DoubleToString(entry, dg),
            " | prob=", DoubleToString(spikeProb*100,1), "%",
            " | GOM vn=", g_smcGomVerdictNum,
            " | SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg));
      if(UseNotifications)
      {
         Alert("âš¡ SPIKE-IMMINENT ", (wantBuy ? "BUY" : "SELL"), " ", _Symbol);
         SendNotification("âš¡ SPIKE " + (wantBuy ? "BUY " : "SELL ") + _Symbol);
      }
   }
}

//+------------------------------------------------------------------+
//| FIX 2026-09-26 : notification push sÃ©rie de spikes BUY/SELL       |
//| DÃ©tecte dÃ©but (â‰¥ SpikeSeriesMinCount) et fin (N barres calmes).   |
//+------------------------------------------------------------------+
void CheckAndNotifySpikeSeries()
{
   if(!SpikeSeriesPushNotify) return;
   if(!(IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol) || SMC_IsSynthSpikeFamily(_Symbol)))
      return;

   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 25, r) < 12) return;

   double atr = 0.0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[];
      ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 5, ab) >= 1)
         atr = ab[0];
   }
   if(atr <= 0.0)
   {
      // fallback range moyen
      double s = 0;
      for(int i = 1; i < 15 && i < ArraySize(r); i++)
         s += (r[i].high - r[i].low);
      atr = s / 14.0;
   }
   if(atr <= 0.0) return;

   double thr = atr * MathMax(0.6, SpikeSeriesBodyATRMult);

   // Compter depuis la barre 1 (derniÃ¨re clÃ´turÃ©e) la sÃ©rie en cours
   int consecBuy = 0;
   int consecSell = 0;
   for(int i = 1; i < ArraySize(r); i++)
   {
      double body = MathAbs(r[i].close - r[i].open);
      bool isSpike = (body >= thr) || ((r[i].high - r[i].low) >= thr * 1.15);
      if(!isSpike)
      {
         if(i == 1) break; // derniÃ¨re close n'est pas spike â†’ sÃ©rie potentiellement finie
         break;
      }
      if(r[i].close > r[i].open)
      {
         if(consecSell > 0) break;
         consecBuy++;
      }
      else if(r[i].close < r[i].open)
      {
         if(consecBuy > 0) break;
         consecSell++;
      }
      else break;
   }

   // Barres calmes depuis la derniÃ¨re close (pour fin de sÃ©rie)
   int quietBars = 0;
   for(int i = 1; i < ArraySize(r) && i <= MathMax(2, SpikeSeriesEndQuietBars) + 2; i++)
   {
      double body = MathAbs(r[i].close - r[i].open);
      bool isSpike = (body >= thr) || ((r[i].high - r[i].low) >= thr * 1.15);
      if(isSpike) break;
      quietBars++;
   }

   // Ã‰tat persistant par symbole (GlobalVariable pour multi-chart)
   string keyDir   = "SMC_SPIKE_SERIES_DIR_" + _Symbol;
   string keyCnt   = "SMC_SPIKE_SERIES_CNT_" + _Symbol;
   string keyActive= "SMC_SPIKE_SERIES_ON_" + _Symbol;
   string keyLastN = "SMC_SPIKE_SERIES_NOTIFY_" + _Symbol; // anti-spam timestamp

   int prevDir = GlobalVariableCheck(keyDir) ? (int)GlobalVariableGet(keyDir) : 0; // +1 BUY -1 SELL
   int prevCnt = GlobalVariableCheck(keyCnt) ? (int)GlobalVariableGet(keyCnt) : 0;
   bool wasOn  = GlobalVariableCheck(keyActive) && GlobalVariableGet(keyActive) > 0.5;

   int curDir = 0;
   int curCnt = 0;
   if(consecBuy >= 1)  { curDir = 1;  curCnt = consecBuy; }
   if(consecSell >= 1) { curDir = -1; curCnt = consecSell; }

   int minN = MathMax(2, SpikeSeriesMinCount);
   datetime now = TimeCurrent();
   datetime lastN = GlobalVariableCheck(keyLastN) ? (datetime)GlobalVariableGet(keyLastN) : 0;

   // --- DÃ‰MARRAGE sÃ©rie ---
   if(curCnt >= minN && curDir != 0)
   {
      bool started = (!wasOn) || (wasOn && prevDir != curDir);
      bool grew    = (wasOn && prevDir == curDir && curCnt > prevCnt && curCnt == minN);
      // Notifier au franchissement du seuil min (et changement de sens)
      if((started || grew) && (now - lastN >= 30))
      {
         string side = (curDir > 0) ? "BUY" : "SELL";
         string msg = StringFormat("âš¡ SÃ‰RIE SPIKE %s DÃ‰MARRÃ‰E | %s | x%d spikes M1",
                                   side, _Symbol, curCnt);
         Print(msg);
         if(UseNotifications)
         {
            Alert(msg);
            SendNotification(msg);
         }
         GlobalVariableSet(keyLastN, (double)now);
      }
      GlobalVariableSet(keyDir, (double)curDir);
      GlobalVariableSet(keyCnt, (double)curCnt);
      GlobalVariableSet(keyActive, 1.0);
   }
   // --- FIN sÃ©rie ---
   else if(wasOn && quietBars >= MathMax(1, SpikeSeriesEndQuietBars))
   {
      if(now - lastN >= 20)
      {
         string side = (prevDir > 0) ? "BUY" : (prevDir < 0 ? "SELL" : "?");
         string msg = StringFormat("âœ… SÃ‰RIE SPIKE %s TERMINÃ‰E | %s | Ã©tait x%d | %d barres calmes",
                                   side, _Symbol, prevCnt, quietBars);
         Print(msg);
         if(UseNotifications)
         {
            Alert(msg);
            SendNotification(msg);
         }
         GlobalVariableSet(keyLastN, (double)now);
      }
      GlobalVariableSet(keyActive, 0.0);
      GlobalVariableSet(keyCnt, 0.0);
      GlobalVariableSet(keyDir, 0.0);
   }
   else if(curCnt > 0)
   {
      // sÃ©rie en construction (< min) â€” mÃ©moriser sans notifier
      GlobalVariableSet(keyDir, (double)curDir);
      GlobalVariableSet(keyCnt, (double)curCnt);
   }
}

void CheckImminentSpike()
{
   if(!(IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol) || SMC_IsSynthSpikeFamily(_Symbol)))
      return;
   
   // ProbabilitÃ© unifiÃ©e (mÃªme algo que l'affichage / filtre)
   double finalSpikeProb = CalculateSpikeProbability();
   double volCompression = CalculateVolatilityCompression();
   bool volumeSpike = DetectVolumeSpike();
   
   // VÃ©rification finale
   if(finalSpikeProb < 0.0 || finalSpikeProb > 1.0) return;
   
   // Alerte si probabilitÃ© Ã©levÃ©e (ajustÃ©e Ã  75% pour correspondre aux trades)
   if(finalSpikeProb > 0.75)
   {
      string alertMsg = "ðŸš¨ SPIKE IMMINENT sur " + _Symbol + 
                      " | ProbabilitÃ©: " + DoubleToString(finalSpikeProb*100, 1) + "%" +
                      " | Compression: " + DoubleToString(volCompression*100, 1) + "%" +
                      " | Volume: " + (volumeSpike ? "SPIKE" : "Normal");
      
      Print(alertMsg);
      
      if(UseNotifications)
      {
         Alert(alertMsg);
         SendNotification("ðŸš¨ SPIKE " + _Symbol + " " + DoubleToString(finalSpikeProb*100, 1) + "%");
      }
      
      // Dessiner un marqueur visuel rapide
      DrawSpikeWarning(finalSpikeProb);
      // FIX 2026-09-26 : rÃ©agir Ã  la flÃ¨che / proba (Ã©tait manquant)
      TrySpikeImminentAutoEntry(finalSpikeProb);
   }
   else if(finalSpikeProb > 0.60)
   {
      // PrÃ©-alerte : dessiner flÃ¨che si score avancÃ© OK, tenter entrÃ©e si >= 0.75 ailleurs
      SpikeDrawArrow(finalSpikeProb);
   }
}

//| RSI SQUEEZE PREDICTOR â€” squeeze RSI + tendance H1 + auto-trade       |
void CheckRSISqueezeAndTrade()
{
   if(!UseRSISqueezePredictor) return;

   ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(_Symbol);
   if(cat != SYM_BOOM_CRASH) return;

   if(rsiSqueezeHandle == INVALID_HANDLE) return;

   double rsi[];
   ArraySetAsSeries(rsi, true);
   if(CopyBuffer(rsiSqueezeHandle, 0, 0, 3, rsi) < 3) return;

   bool isBoom = IsBoomLikeSymbol(_Symbol);

   // --- DÃ‰TECTION SQUEEZE ---
   bool squeezeSignal = false;
   if(isBoom && rsi[0] < RSISqueezeLowThreshold)
      squeezeSignal = true;
   if(!isBoom && rsi[0] > RSISqueezeHighThreshold)
      squeezeSignal = true;

   // --- FILTRE H1 TREND ---
   bool h1Aligned = true;
   if(RSISqueezeH1Filter && ema50H != INVALID_HANDLE)
   {
      double ema50H1Arr[];
      ArraySetAsSeries(ema50H1Arr, true);
      if(CopyBuffer(ema50H, 0, 0, 1, ema50H1Arr) >= 1)
      {
         double closeH1[];
         ArraySetAsSeries(closeH1, true);
         if(CopyClose(_Symbol, PERIOD_H1, 0, 1, closeH1) >= 1)
         {
            // Boom BUY need H1 BULL (close > EMA50), Crash SELL need H1 BEAR
            if(isBoom && closeH1[0] < ema50H1Arr[0]) h1Aligned = false;
            if(!isBoom && closeH1[0] > ema50H1Arr[0]) h1Aligned = false;
         }
      }
   }

    // --- GLOBALS pour dashboard GOM ---
    g_dashSqueezeActive = squeezeSignal;
    g_dashSqueezeRSI    = rsi[0];
    g_dashH1Aligned     = h1Aligned;

    // --- DASHBOARD SQUEEZE STATUS ---
    if(RSISqueezeShowDashboard)
   {
      string squeezeTxt = squeezeSignal ? "SQUEEZE!" : "Normal";
      color squeezeClr  = squeezeSignal ? clrLime : clrGray;
      string h1Txt      = h1Aligned ? "Aligned" : "Counter";
      color h1Clr       = h1Aligned ? clrLime : clrOrange;

      string objName = "RSI_SQUEEZE_DASH_" + _Symbol;
      if(ObjectFind(0, objName) < 0)
         ObjectCreate(0, objName, OBJ_LABEL, 0, 0, 0);

      ObjectSetInteger(0, objName, OBJPROP_CORNER, CORNER_LEFT_LOWER);
      ObjectSetInteger(0, objName, OBJPROP_XDISTANCE, 10);
      ObjectSetInteger(0, objName, OBJPROP_YDISTANCE, 90);
      ObjectSetString(0, objName, OBJPROP_TEXT,
         "RSI(" + IntegerToString(RSISqueezePeriod) + "): " + DoubleToString(rsi[0], 1) +
         " [" + squeezeTxt + "] H1: " + h1Txt);
      ObjectSetInteger(0, objName, OBJPROP_COLOR, squeezeSignal ? squeezeClr : clrGray);
      ObjectSetInteger(0, objName, OBJPROP_FONTSIZE, 9);
      ObjectSetString(0, objName, OBJPROP_FONT, "Consolas");
   }

   if(!squeezeSignal) return;

   // --- LOGIQUE PRÃ‰DICTIVE ---
   Print("ðŸ” RSI SQUEEZE dÃ©tectÃ© sur ", _Symbol,
         " | RSI: ", DoubleToString(rsi[0], 1),
         " | H1: ", h1Aligned ? "AlignÃ©" : "Contre-tendance",
         " | Type: ", isBoom ? "BOOM â†’ BUY" : "CRASH â†’ SELL");

   if(UseNotifications && h1Aligned)
   {
      Alert("ðŸ” RSI SQUEEZE ", _Symbol, " RSI=", DoubleToString(rsi[0], 1),
            " H1=", h1Aligned ? "OK" : "NOK");
      SendNotification("ðŸ” SQUEEZE " + _Symbol + " RSI=" + DoubleToString(rsi[0], 1));
   }

   // --- AUTO-TRADE ---
   if(!RSISqueezeAutoTrade) return;
   if(!h1Aligned) return;
   if(PositionsTotal() > 0) return; // Pas de position ouverte
   if(CountPositionsForSymbol(_Symbol) > 0) return;

   if(!TryAcquireOpenLock()) return;

   double lot = CalculateLotSize();
   if(lot <= 0) { ReleaseOpenLock(); return; }

   double atrArr[];
   ArraySetAsSeries(atrArr, true);
   double atrVal = 0;
   if(atrHandle != INVALID_HANDLE && CopyBuffer(atrHandle, 0, 0, 1, atrArr) >= 1)
      atrVal = atrArr[0];
   if(atrVal <= 0) { ReleaseOpenLock(); return; }

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   int    dg  = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);

   bool orderOK = false;

    if(isBoom)
    {
       if(!g_smcGomConnected || g_smcGomVerdictNum < 2)
       {
           Print("ðŸš« RSI-SQUEEZE BUY BLOQUÃ‰ â€” GOM non connectÃ©/WAIT/SIMPLE (connectÃ©=", g_smcGomConnected,
                 ", verdict=", g_smcGomVerdict, " vn=", g_smcGomVerdictNum, ") â€” exige GOOD/PERFECT BUY");
           ReleaseOpenLock(); return;
        }
         double sl = NormalizeDouble(ask - atrVal * 2.0, dg);
         double tp = NormalizeDouble(ask + atrVal * 5.0, dg);
         if(!CanTradeOnSymbol(_Symbol, "BUY")) { Print("ðŸš« RSI-SQUEEZE BUY BLOQUÃ‰ â€” Terminal plein, sens interdit, retournement ou ordre existant sur ", _Symbol); ReleaseOpenLock(); return; }
         if(!SMC_FinalOpenGate(_Symbol, ORDER_TYPE_BUY)) { ReleaseOpenLock(); return; }
         if(SafeTradeBuy(lot, _Symbol, ask, sl, tp, "RSI-SQUEEZE BUY"))
       {
          RegisterOrderPlaced();
          SMC_GateRegisterOpened(_Symbol, true);
          orderOK = true;
          ulong ticket = trade.ResultOrder();
          if(ticket > 0) SMC_ApplyPostEntrySLBuffer(_Symbol, ticket, 1.0);
          Print("ðŸš€ RSI-SQUEEZE BUY ", _Symbol, " @", DoubleToString(ask, dg),
                " SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg),
                " RSI=", DoubleToString(rsi[0], 1));
       }
    }
     else
     {
        if(!g_smcGomConnected || g_smcGomVerdictNum > -2)
        {
           Print("ðŸš« RSI-SQUEEZE SELL BLOQUÃ‰ â€” GOM non connectÃ©/WAIT/SIMPLE (connectÃ©=", g_smcGomConnected,
                 ", verdict=", g_smcGomVerdict, " vn=", g_smcGomVerdictNum, ") â€” exige GOOD/PERFECT SELL");
            ReleaseOpenLock(); return;
         }
         double sl = NormalizeDouble(bid + atrVal * 2.0, dg);
         double tp = NormalizeDouble(bid - atrVal * 5.0, dg);
         if(!CanTradeOnSymbol(_Symbol, "SELL")) { Print("ðŸš« RSI-SQUEEZE SELL BLOQUÃ‰ â€” Terminal plein, sens interdit, retournement ou ordre existant sur ", _Symbol); ReleaseOpenLock(); return; }
         if(!SMC_FinalOpenGate(_Symbol, ORDER_TYPE_SELL)) { ReleaseOpenLock(); return; }
         if(SafeTradeSell(lot, _Symbol, bid, sl, tp, "RSI-SQUEEZE SELL"))
       {
          RegisterOrderPlaced();
          SMC_GateRegisterOpened(_Symbol, false);
          orderOK = true;
          ulong ticket = trade.ResultOrder();
          if(ticket > 0) SMC_ApplyPostEntrySLBuffer(_Symbol, ticket, 1.0);
          Print("ðŸš€ RSI-SQUEEZE SELL ", _Symbol, " @", DoubleToString(bid, dg),
                " SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg),
                " RSI=", DoubleToString(rsi[0], 1));
       }
    }

   ReleaseOpenLock();

   if(orderOK)
   {
      g_maxProfit = 0;
      if(UseNotifications)
         SendNotification("ðŸš€ SQUEEZE TRADE " + _Symbol + (isBoom ? " BUY" : " SELL") +
                          " RSI=" + DoubleToString(rsi[0], 1));
   }
}

//| DÃ‰TECTION DES MOUVEMENTS DE RETOUR VERS CANAUX SMC               |
void CheckSMCChannelReturnMovements()
{
   // Uniquement sur Boom/Crash
   ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(_Symbol);
   if(cat != SYM_BOOM_CRASH) return;
   
   // RÃ©cupÃ©rer les canaux SMC H1
   string upperName = "SMC_CH_H1_UPPER";
   string lowerName = "SMC_CH_H1_LOWER";
   if(ObjectFind(0, upperName) < 0 || ObjectFind(0, lowerName) < 0) return;
   
   double upperPrice = ObjectGetDouble(0, upperName, OBJPROP_PRICE);
   double lowerPrice = ObjectGetDouble(0, lowerName, OBJPROP_PRICE);
   if(upperPrice <= 0 || lowerPrice <= 0) return;
   
   // Obtenir les prix actuels
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if(bid <= 0 || ask <= 0) return;
   
   // Obtenir l'ATR pour les calculs de distance
   double atrVal = 0.0;
   if(atrHandle != INVALID_HANDLE)
   {
      double atrBuf[];
      ArraySetAsSeries(atrBuf, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, atrBuf) > 0)
         atrVal = atrBuf[0];
   }
   if(atrVal <= 0) atrVal = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 100;
   
   bool isBoom = IsBoomLikeSymbol(_Symbol);
   bool isCrash = IsCrashLikeSymbol(_Symbol);
   
   // RÃˆGLE STRICTE: BLOQUER TOUS LES MOUVEMENTS DE RETOUR BUY SUR BOOM SI IA = SELL
   string aiAction = g_lastAIAction;
   if(aiAction == "buy") aiAction = "BUY";
   if(aiAction == "sell") aiAction = "SELL";
   
   if(isBoom && aiAction == "SELL")
   {
      // Ne mÃªme pas analyser les mouvements de retour si IA = SELL sur Boom
      return;
   }
   
   if(isCrash && aiAction == "BUY")
   {
      // Ne mÃªme pas analyser les mouvements de retour si IA = BUY sur Crash
      return;
   }
   
   // Analyser les 5 derniÃ¨res bougies pour dÃ©tecter un mouvement de retour
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 5, rates) < 3) return;
   
   // DÃ©tecter si le prix fait un mouvement de retour vers un canal
   bool returnMovementDetected = false;
   string returnDirection = "";
   double returnStrength = 0.0;
   
   if(isBoom)
   {
      // Pour Boom: vÃ©rifier si le prix monte vers le canal infÃ©rieur aprÃ¨s Ãªtre descendu
      double currentDistance = bid - lowerPrice;
      double previousDistance = rates[1].close - lowerPrice;
      
      // Mouvement de retour: la distance au canal diminue significativement
      if(previousDistance > currentDistance && previousDistance - currentDistance > atrVal * 0.3)
      {
         returnMovementDetected = true;
         returnDirection = "BUY";
         returnStrength = (previousDistance - currentDistance) / atrVal;
         
         // VÃ©rifier si le mouvement est assez fort pour justifier une entrÃ©e immÃ©diate
         if(returnStrength >= 0.5 && currentDistance <= atrVal * 3.0)
         {
            Print("ðŸ”„ MOUVEMENT RETOUR BOOM - Vers canal infÃ©rieur | Force: ", DoubleToString(returnStrength, 1), " ATR | Distance: ", DoubleToString(currentDistance/atrVal, 1), " ATR");
            
            // Placer un ordre limite plus proche pour capturer ce mouvement
            PlaceReturnMovementLimitOrder("BUY", bid, lowerPrice, atrVal, returnStrength);
         }
      }
   }
   else if(isCrash)
   {
      // Pour Crash: vÃ©rifier si le prix descend vers le canal supÃ©rieur aprÃ¨s Ãªtre montÃ©
      double currentDistance = upperPrice - ask;
      double previousDistance = upperPrice - rates[1].close;
      
      // Mouvement de retour: la distance au canal diminue significativement
      if(previousDistance > currentDistance && previousDistance - currentDistance > atrVal * 0.3)
      {
         returnMovementDetected = true;
         returnDirection = "SELL";
         returnStrength = (previousDistance - currentDistance) / atrVal;
         
         // VÃ©rifier si le mouvement est assez fort pour justifier une entrÃ©e immÃ©diate
         if(returnStrength >= 0.5 && currentDistance <= atrVal * 3.0)
         {
            Print("ðŸ”„ MOUVEMENT RETOUR CRASH - Vers canal supÃ©rieur | Force: ", DoubleToString(returnStrength, 1), " ATR | Distance: ", DoubleToString(currentDistance/atrVal, 1), " ATR");
            
            // Placer un ordre limite plus proche pour capturer ce mouvement
            PlaceReturnMovementLimitOrder("SELL", ask, upperPrice, atrVal, returnStrength);
         }
      }
   }
}

//| PLACEMENT D'ORDRE LIMITE POUR MOUVEMENT DE RETOUR               |
void PlaceReturnMovementLimitOrder(string direction, double currentPrice, double channelPrice, double atrVal, double strength)
{
   // Mode DOW-only : pas de LIMIT hors trendline DOW
   if(Dow_IsDowOnlyLimitMode()) return;

   // DOW GATE: seul l'ordre alignÃ© avec DOW Proj est autorisÃ©
   if(UseDowTrendline)
   {
      if(!g_dowState.active) { Print("[DOW] ReturnMovement bloquÃ© â€” DOW inactif"); return; }
      bool dowBullish = !g_dowState.isBearish;
      if(direction == "BUY" && g_dowState.isBearish) { Print("[DOW] ReturnMovement bloquÃ© â€” DOW=SELL mais direction=BUY"); return; }
      if(direction == "SELL" && dowBullish) { Print("[DOW] ReturnMovement bloquÃ© â€” DOW=BUY mais direction=SELL"); return; }
   }

   // Bloquer si GOM dÃ©connectÃ© ou en WAIT (vn==0) â€” toujours, quel que soit le rÃ©glage
   if(!g_smcGomConnected || g_smcGomVerdictNum == 0)
   {
      Print("[GOM-WAIT] PlaceReturnMovementLimitOrder bloquÃ© â€” GOM dÃ©connectÃ© ou verdict=WAIT");
      return;
   }
   if(UseGOMVerdictFilter && MathAbs(g_smcGomVerdictNum) < MinGOMVerdictNumAbs)
   {
      Print("[GOM-SIMPLE] PlaceReturnMovementLimitOrder bloquÃ© â€” verdict pas GOOD/PERFECT (vn=", g_smcGomVerdictNum, ")");
      return;
   }

   // OTE Filter: prix doit Ãªtre dans zone Fib 61.8-78.6%
   if(GOMRequireOTE && UseOTE && g_smcOteTop > 0 && g_smcOteBot > 0 && !g_smcInOTE)
   {
      Print("[OTE] PlaceReturnMovementLimitOrder bloquÃ© â€” prix hors zone OTE");
      return;
   }

   // VÃ©rifier si on a dÃ©jÃ  un ordre de retour en cours
   int countReturnOrders = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      if(OrderGetString(ORDER_SYMBOL) != _Symbol) continue;
      if(StringFind(OrderGetString(ORDER_COMMENT), "RETURN_MOVE") >= 0) countReturnOrders++;
   }
   if(countReturnOrders >= 1) return; // Un seul ordre de retour Ã  la fois
   
   // Limite globale: maximum 2 ordres LIMIT par symbole, dont 1 seul hors canal
   {
      int totalLimits = CountOpenLimitOrdersForSymbol(_Symbol);
      int chanLimits  = CountChannelLimitOrdersForSymbol(_Symbol);
      int otherLimits = totalLimits - chanLimits;
      // Pour Boom/Crash: un seul LIMIT proche Ã  la fois
      if(totalLimits >= 1 || otherLimits >= 1) return;
   }
   
   // RÃ©entrÃ©e aprÃ¨s perte sur ce symbole: exiger conditions exceptionnelles (IA â‰¥90% + spike/setup fort)
   if(!AllowReentryAfterRecentLoss(_Symbol, direction, strength >= 0.8))
      return;
   
   if(CountPositionsForSymbol(_Symbol) > 0) return; // Pas d'ordre si dÃ©jÃ  en position
   if(!TryAcquireOpenLock()) return;
   
   double lot = CalculateLotSize();
   if(lot <= 0) { ReleaseOpenLock(); return; }
   
   // Calculer le prix d'entrÃ©e optimisÃ© pour le mouvement de retour
   double entryPrice;
   double distanceToChannel = MathAbs(currentPrice - channelPrice);
   
   if(direction == "BUY")
   {
      // PrioritÃ© SuperTrend support: entrÃ©e juste au-dessus du support, mais < prix actuel
      double stSupp = 0.0, stRes = 0.0;
      double tmpS = 0.0, tmpR = 0.0;
      if(GetSuperTrendLevel(PERIOD_M5, tmpS, tmpR) && tmpS > 0) stSupp = tmpS;
      else if(GetSuperTrendLevel(PERIOD_H1, tmpS, tmpR) && tmpS > 0) stSupp = tmpS;
      if(stSupp > 0 && stSupp < currentPrice)
      {
         double candidate = stSupp + atrVal * 0.15;
         if(candidate < currentPrice)
            entryPrice = candidate;
         else
            entryPrice = currentPrice - atrVal * 0.5;
      }
      else
      {
      // BUY: placer l'ordre entre le prix actuel et le canal, plus proche du prix
      if(distanceToChannel <= atrVal * 2.0)
         entryPrice = channelPrice + (atrVal * 0.2); // TrÃ¨s proche du canal
      else if(distanceToChannel <= atrVal * 4.0)
         entryPrice = currentPrice - (atrVal * 0.8); // Plus proche du prix
      else
         entryPrice = currentPrice - (atrVal * 1.2); // Distance modÃ©rÃ©e
      }
      
      if(entryPrice >= currentPrice) { ReleaseOpenLock(); return; }
      
      // Placer l'ordre BUY LIMIT
      MqlTradeRequest req;
      MqlTradeResult  res;
      ZeroMemory(req);
      ZeroMemory(res);
      req.action = TRADE_ACTION_PENDING;
      req.symbol = _Symbol;
      req.magic = InpMagicNumber;
      req.volume = lot;
      req.type = ORDER_TYPE_BUY_LIMIT;
      req.price = entryPrice;
      req.sl = entryPrice - atrVal * 2.0;
      req.tp = entryPrice + atrVal * 4.0;
      req.comment = "RETURN_MOVE BUY LIMIT";
      
      if(!CanPlaceLimitOrder(_Symbol, ORDER_TYPE_BUY_LIMIT)) { ReleaseOpenLock(); return; }
      CleanupExcessLimits(_Symbol, 2);
      if(!SMC_FinalOpenGate(_Symbol, ORDER_TYPE_BUY_LIMIT)) { ReleaseOpenLock(); return; }
      if(SafeOrderSend(req, res, req.comment))
      {
         SMC_GateRegisterOpened(_Symbol, true);
         Print("âœ… ORDRE RETOUR BUY PLACÃ‰ - Entry: ", DoubleToString(entryPrice, _Digits), 
               " | Force: ", DoubleToString(strength, 1), " ATR");
      }
      else
      {
         Print("âŒ Ã‰CHEC ORDRE RETOUR BUY - Erreur: ", res.retcode);
      }
   }
   else // SELL
   {
      // PrioritÃ© SuperTrend rÃ©sistance: entrÃ©e juste en-dessous de la rÃ©sistance, mais > prix actuel
      double stSupp = 0.0, stRes = 0.0;
      double tmpS = 0.0, tmpR = 0.0;
      if(GetSuperTrendLevel(PERIOD_M5, tmpS, tmpR) && tmpR > 0) stRes = tmpR;
      else if(GetSuperTrendLevel(PERIOD_H1, tmpS, tmpR) && tmpR > 0) stRes = tmpR;
      if(stRes > 0 && stRes > currentPrice)
      {
         double candidate = stRes - atrVal * 0.15;
         if(candidate > currentPrice)
            entryPrice = candidate;
         else
            entryPrice = currentPrice + atrVal * 0.5;
      }
      else
      {
      // SELL: placer l'ordre entre le prix actuel et le canal, plus proche du prix
      if(distanceToChannel <= atrVal * 2.0)
         entryPrice = channelPrice - (atrVal * 0.2); // TrÃ¨s proche du canal
      else if(distanceToChannel <= atrVal * 4.0)
         entryPrice = currentPrice + (atrVal * 0.8); // Plus proche du prix
      else
         entryPrice = currentPrice + (atrVal * 1.2); // Distance modÃ©rÃ©e
      }
      
      if(entryPrice <= currentPrice) { ReleaseOpenLock(); return; }
      
      // Placer l'ordre SELL LIMIT
      MqlTradeRequest req;
      MqlTradeResult  res;
      ZeroMemory(req);
      ZeroMemory(res);
      req.action = TRADE_ACTION_PENDING;
      req.symbol = _Symbol;
      req.magic = InpMagicNumber;
      req.volume = lot;
      req.type = ORDER_TYPE_SELL_LIMIT;
      req.price = entryPrice;
      req.sl = entryPrice + atrVal * 2.0;
      req.tp = entryPrice - atrVal * 4.0;
      req.comment = "RETURN_MOVE SELL LIMIT";
      
      if(!CanPlaceLimitOrder(_Symbol, ORDER_TYPE_SELL_LIMIT)) { ReleaseOpenLock(); return; }
      CleanupExcessLimits(_Symbol, 2);
      if(!SMC_FinalOpenGate(_Symbol, ORDER_TYPE_SELL_LIMIT)) { ReleaseOpenLock(); return; }
      if(SafeOrderSend(req, res, req.comment))
      {
         SMC_GateRegisterOpened(_Symbol, false);
         Print("âœ… ORDRE RETOUR SELL PLACÃ‰ - Entry: ", DoubleToString(entryPrice, _Digits), 
               " | Force: ", DoubleToString(strength, 1), " ATR");
      }
      else
      {
         Print("âŒ Ã‰CHEC ORDRE RETOUR SELL - Erreur: ", res.retcode);
      }
   }
   
   ReleaseOpenLock();
}

// Dessine un avertissement visuel de spike imminent - VERSION AMÃ‰LIORÃ‰E
void DrawSpikeWarning(double probability)
{
   string warningName = "SPIKE_WARNING_" + _Symbol;
   string probTextName = "SPIKE_PROB_TEXT_" + _Symbol;
   
   // Supprimer les avertissements prÃ©cÃ©dents
   if(ObjectFind(0, warningName) >= 0)
      ObjectDelete(0, warningName);
   if(ObjectFind(0, probTextName) >= 0)
      ObjectDelete(0, probTextName);
   
   // CrÃ©er un nouvel avertissement
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, PERIOD_CURRENT, 0, 1, r) < 1) return;
   
   // DÃ©terminer la couleur selon la probabilitÃ©
   color spikeColor = clrRed;
   if(probability >= 0.85) spikeColor = clrRed;      // 85%+ = Rouge critique
   else if(probability >= 0.70) spikeColor = clrOrange; // 70-84% = Orange alerte
   else if(probability >= 0.60) spikeColor = clrYellow; // 60-69% = Jaune attention
   else spikeColor = clrWhite; // < 60% = Blanc info
   
   // Dessiner une flÃ¨che d'avertissement
   ObjectCreate(0, warningName, OBJ_ARROW, 0, r[0].time, r[0].high);
   ObjectSetInteger(0, warningName, OBJPROP_ARROWCODE, 241); // Point d'exclamation
   ObjectSetInteger(0, warningName, OBJPROP_COLOR, spikeColor);
   ObjectSetInteger(0, warningName, OBJPROP_WIDTH, 4);
   ObjectSetInteger(0, warningName, OBJPROP_BACK, false);
   
   // Ajouter un texte avec la probabilitÃ©
   string probText = "SPIKE " + DoubleToString(probability*100, 0) + "%";
   ObjectCreate(0, probTextName, OBJ_TEXT, 0, r[0].time, r[0].high + (r[0].high - r[0].low) * 0.5);
   ObjectSetString(0, probTextName, OBJPROP_TEXT, probText);
   ObjectSetInteger(0, probTextName, OBJPROP_COLOR, clrWhite);
   ObjectSetInteger(0, probTextName, OBJPROP_FONTSIZE, 12);
   ObjectSetString(0, probTextName, OBJPROP_FONT, "Arial Bold");
   ObjectSetInteger(0, probTextName, OBJPROP_ANCHOR, ANCHOR_LEFT_UPPER);
   ObjectSetInteger(0, probTextName, OBJPROP_BACK, true);
   
   // Log de l'affichage
   Print("ðŸ“Š SPIKE WARNING AFFICHÃ‰ - ", _Symbol, 
         " | ProbabilitÃ©: ", DoubleToString(probability*100, 1), "%",
         " | Couleur: ", (probability >= 0.85 ? "ROUGE CRITIQUE" : 
                         (probability >= 0.70 ? "ORANGE ALERTE" : 
                         (probability >= 0.60 ? "JAUNE ATTENTION" : "BLANC INFO"))));
}

// Affiche l'Ã©tat IA et les prÃ©dictions sur le graphique
void DrawAIStatusAndPredictions()
{
   ObjectDelete(0, "AI_STATUS_BOX_" + _Symbol);
   ObjectDelete(0, "AI_STATUS_TEXT_" + _Symbol);
}

//| DÃ‰TECTER UN SPIKE RÃ‰CENT sur Boom/Crash                           |
bool DetectRecentSpike()
{
   Print("ðŸ” DEBUG - DÃ©tection de spike pour: ", _Symbol);
   
   // VÃ©rifier les 5 derniÃ¨res bougies pour un spike significatif
   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   
   if(CopyRates(_Symbol, PERIOD_M1, 0, 5, rates) < 5)
   {
      Print("âŒ Impossible de copier les rates pour dÃ©tecter spike");
      return false;
   }
   
   // Calculer le mouvement moyen des bougies
   double avgMovement = 0.0;
   for(int i = 1; i < 5; i++) // Ignorer la bougie actuelle (0)
   {
      avgMovement += MathAbs(rates[i].high - rates[i].low);
   }
   avgMovement /= 4.0;
   
   // VÃ©rifier si la derniÃ¨re bougie a un mouvement significatif
   double lastMovement = MathAbs(rates[0].high - rates[0].low);
   
   // Rendre la dÃ©tection plus permissive - seuil diffÃ©rent pour Boom/Crash
   double spikeMultiplier = 1.5; // 1.5x par dÃ©faut
    if(IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol))
    {
       spikeMultiplier = 1.2; // 1.2x pour Boom/Crash/Painx/Gainx (plus sensible)
   }
   
   double spikeThreshold = avgMovement * spikeMultiplier;
   
   bool isSpike = lastMovement > spikeThreshold;
   
   Print("ðŸ” DEBUG - Analyse spike - Mouvement actuel: ", DoubleToString(lastMovement, _Digits), 
         " | Moyenne: ", DoubleToString(avgMovement, _Digits), 
         " | Seuil: ", DoubleToString(spikeThreshold, _Digits), 
         " | Ratio: ", DoubleToString(lastMovement/avgMovement, 1),
         " | Spike: ", isSpike ? "OUI" : "NON");
   
   // Ajouter une dÃ©tection alternative basÃ©e sur le prix
   double priceChange = MathAbs(rates[0].close - rates[1].close) / rates[1].close;
   
   // Seuil diffÃ©rent pour Boom/Crash vs autres symboles
   double priceThreshold = 0.001; // 0.1% par dÃ©faut
    if(IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol))
    {
       priceThreshold = 0.0001; // 0.01% pour Boom/Crash/Painx/Gainx (plus sensible)
   }
   
   bool priceSpike = priceChange > priceThreshold;
   
   Print("ðŸ” DEBUG - Spike prix - Changement: ", DoubleToString(priceChange*100, 4), "% | Seuil: ", DoubleToString(priceThreshold*100, 4), "% | Spike: ", priceSpike ? "OUI" : "NON");
   
   // Ajouter une dÃ©tection basÃ©e sur le volume pour Boom/Crash
   bool volumeSpike = false;
    if(IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol))
   {
      long volume[];
      ArraySetAsSeries(volume, true);
      if(CopyTickVolume(_Symbol, PERIOD_M1, 0, 3, volume) >= 3)
      {
         double recentVolume = (double)volume[0];
         double avgVolume = ((double)volume[1] + (double)volume[2]) / 2.0;
         volumeSpike = recentVolume > avgVolume * 1.3; // 30% plus Ã©levÃ©
         
         Print("ðŸ” DEBUG - Spike volume - RÃ©cent: ", DoubleToString(recentVolume, 0), 
               " | Moyenne: ", DoubleToString(avgVolume, 0), 
               " | Spike: ", volumeSpike ? "OUI" : "NON");
      }
   }
   
   // ConsidÃ©rer comme spike si l'un des trois est vrai
   bool finalSpike = isSpike || priceSpike || volumeSpike;
   
   if(finalSpike)
   {
      string spikeType = "";
      if(isSpike) spikeType += "Mouvement";
      if(priceSpike) spikeType += (spikeType != "" ? "+" : "") + "Prix";
      if(volumeSpike) spikeType += (spikeType != "" ? "+" : "") + "Volume";
      
      Print("ðŸš¨ SPIKE DÃ‰TECTÃ‰ - Type: ", spikeType, 
            " | Mouvement: ", DoubleToString(lastMovement, _Digits), 
            " | Changement prix: ", DoubleToString(priceChange*100, 3), "%");
   }
   
   return finalSpike;
}

//| Trouver le meilleur niveau d'entrÃ©e spike (FVG/OB/Swing/Liquidity)
double GetBestSpikeEntryLevel(string direction, double currentPrice, double atrValue, string &sourceOut)
{
   sourceOut = "ATR Fallback";
   double bestLevel = 0.0;
   double maxDist = atrValue * 2.0;
   
   // 1) FVG zones â€” prix dans ou proche d'un FVG
   if(UseFVG)
   {
      FVGData fvg;
      if(SMC_DetectFVG(_Symbol, LTF, 30, fvg))
      {
         if(direction == "BUY" && fvg.direction == 1)
         {
            double entry = fvg.bottom;
            double dist = MathAbs(currentPrice - entry);
            if(dist <= maxDist && dist > 0)
            {
               bestLevel = entry;
               sourceOut = "FVG Bull @ " + DoubleToString(fvg.bottom, _Digits);
            }
         }
         else if(direction == "SELL" && fvg.direction == -1)
         {
            double entry = fvg.top;
            double dist = MathAbs(entry - currentPrice);
            if(dist <= maxDist && dist > 0)
            {
               bestLevel = entry;
               sourceOut = "FVG Bear @ " + DoubleToString(fvg.top, _Digits);
            }
         }
      }
   }
   
   // 2) Order Block zones
   if(UseOrderBlocks)
   {
      OrderBlockData ob;
      if(SMC_DetectOrderBlock(_Symbol, LTF, ob))
      {
         if(direction == "BUY" && ob.direction == 1)
         {
            double entry = ob.low;
            double dist = MathAbs(currentPrice - entry);
            if(dist <= maxDist && dist > 0 && (bestLevel == 0 || dist < MathAbs(currentPrice - bestLevel)))
            {
               bestLevel = entry;
               sourceOut = "OB Bull @ " + DoubleToString(ob.low, _Digits);
            }
         }
         else if(direction == "SELL" && ob.direction == -1)
         {
            double entry = ob.high;
            double dist = MathAbs(entry - currentPrice);
            if(dist <= maxDist && dist > 0 && (bestLevel == 0 || dist < MathAbs(bestLevel - currentPrice)))
            {
               bestLevel = entry;
               sourceOut = "OB Bear @ " + DoubleToString(ob.high, _Digits);
            }
         }
      }
   }
   
   // 3) Swing levels (proches)
   if(direction == "BUY")
   {
      double swingLevel = GetClosestBuyLevel(currentPrice, atrValue, 2.0, sourceOut);
      if(swingLevel > 0)
      {
         double dist = MathAbs(currentPrice - swingLevel);
         if(dist <= maxDist && dist > 0 && (bestLevel == 0 || dist < MathAbs(currentPrice - bestLevel)))
         {
            bestLevel = swingLevel;
            sourceOut = sourceOut;
         }
      }
   }
   else
   {
      double swingLevel = GetClosestSellLevel(currentPrice, atrValue, 2.0, sourceOut);
      if(swingLevel > 0)
      {
         double dist = MathAbs(swingLevel - currentPrice);
         if(dist <= maxDist && dist > 0 && (bestLevel == 0 || dist < MathAbs(bestLevel - currentPrice)))
         {
            bestLevel = swingLevel;
            sourceOut = sourceOut;
         }
      }
   }
   
   // 4) Fallback ATR offset
   if(bestLevel == 0)
   {
      if(direction == "BUY")
         bestLevel = currentPrice - atrValue * 0.3;
      else
         bestLevel = currentPrice + atrValue * 0.3;
      sourceOut = "ATR Offset";
   }
   
   return bestLevel;
}

//| EXÃ‰CUTER UN TRADE BASÃ‰ SUR SPIKE                                  |
void ExecuteSpikeTrade(string direction)
{
   int dirSignEx = (direction == "BUY") ? 1 : ((direction == "SELL") ? -1 : 0);
   if(!SMCGP_SpikeFireAllowed(_Symbol, dirSignEx))
   {
      Print("ðŸš« SPIKE TRADE BLOQUÃ‰ â€” pas de signal valide (GOM GOOD/PERFECT + M1/M5/M15) | ",
            _Symbol, " ", direction, " vn=", g_smcGomVerdictNum,
            " srv=", g_smcGomVerdictNumServer,
            " M1=", g_smcTfM1Dir, " M5=", g_smcTfM5Dir, " M15=", g_smcTfM15Dir);
      return;
   }
   // FIX v1.35: CHECK OBLIGATOIRE ALIGNEMENT TF - M1/M5/M15 ne doivent pas Ãªtre opposÃ©s
   string m1Dir = g_smcTfM1Dir;
   if((direction == "BUY"  && m1Dir == "BEAR") ||
      (direction == "SELL" && m1Dir == "BULL"))
   {
      Print("ðŸš« SPIKE TRADE BLOQUÃ‰ â€” M1=", m1Dir, " opposÃ© Ã  ", direction, " sur ", _Symbol);
      return;
   }
   string m5Dir = g_smcTfM5Dir;
   if((direction == "BUY"  && m5Dir == "BEAR") ||
      (direction == "SELL" && m5Dir == "BULL"))
   {
      Print("ðŸš« SPIKE TRADE BLOQUÃ‰ â€” M5=", m5Dir, " opposÃ© Ã  ", direction, " sur ", _Symbol);
      return;
   }
   string m15Dir = g_smcTfM15Dir;
   if((direction == "BUY"  && m15Dir == "BEAR") ||
      (direction == "SELL" && m15Dir == "BULL"))
   {
      Print("ðŸš« SPIKE TRADE BLOQUÃ‰ â€” M15=", m15Dir, " opposÃ© Ã  ", direction, " sur ", _Symbol);
      return;
   }
   // Anti-doublon et Conflit: Utiliser le gate universel
   if(!CanTradeOnSymbol(_Symbol, direction))
   {
      Print("ðŸš« SPIKE TRADE BLOQUÃ‰ â€” Terminal plein, sens interdit, retournement ou ordre existant sur ", _Symbol);
      return;
   }

   // Calculer lot size (recovery: doubler le lot min sur un autre symbole aprÃ¨s une perte)
   double lot = CalculateLotSize();
   lot = ApplyRecoveryLot(lot);
   if(lot <= 0) 
   {
      Print("âŒ Erreur calcul lot size - trade annulÃ©");
      return;
   }
   
   // Calculer SL/TP basÃ©s sur l'ATR
   double atrValue = 0.0;
   if(atrHandle != INVALID_HANDLE)
   {
      double atr[];
      ArraySetAsSeries(atr, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, atr) >= 1)
         atrValue = atr[0];
   }
   
   if(atrValue == 0) atrValue = SymbolInfoDouble(_Symbol, SYMBOL_BID) * 0.002; // 0.2% par dÃ©faut
   
   Print("ðŸ” DEBUG - ATR pour SL/TP: ", DoubleToString(atrValue, _Digits), " | Symbol: ", _Symbol);
   
   // FIX v1.34: perte max / SL hard-cap = MaxLossPerSpikeTradeDollars ($2)
   double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   double tickVal  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   if(tickSize <= 0) tickSize = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   if(tickVal <= 0) tickVal = 1.0;
   double spikeSLCapUSD = MathMax(0.50, MaxLossPerSpikeTradeDollars);
   double atrSLDist = atrValue * 1.2; // serrÃ© pour spike scalp ICT
   double dollarSLDist = (spikeSLCapUSD / MathMax(lot, 0.01)) * (tickSize / tickVal);
   double useSLDist = MathMin(atrSLDist, dollarSLDist);
   double riskPerLotDollars = useSLDist * (tickVal / tickSize);
   if(riskPerLotDollars <= 0) riskPerLotDollars = 1.0;
   double potentialLoss = lot * riskPerLotDollars;
   if(potentialLoss > MaxLossPerSpikeTradeDollars)
   {
      double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
      double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
      double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
      if(lotStep <= 0) lotStep = 0.01;
      double lotCap = MaxLossPerSpikeTradeDollars / riskPerLotDollars;
      lot = MathFloor(lotCap / lotStep) * lotStep;
      lot = MathMax(minLot, MathMin(maxLot, lot));
      lot = NormalizeDouble(lot, 2);
      potentialLoss = lot * riskPerLotDollars;
      if(potentialLoss > MaxLossPerSpikeTradeDollars * 1.01)
      {
         Print("âŒ TRADE BLOQUÃ‰ - Perte min (lot min ", DoubleToString(minLot, 2), ") = ", DoubleToString(potentialLoss, 2), "$ > ", MaxLossPerSpikeTradeDollars, "$");
         return;
      }
      Print("ðŸ”§ Lot rÃ©duit pour perte max ", MaxLossPerSpikeTradeDollars, "$ â†’ Lot: ", DoubleToString(lot, 2), " | Perte potentielle: ", DoubleToString(potentialLoss, 2), "$");
   }
   else
      Print("âœ… Perte potentielle VALIDÃ‰E: ", DoubleToString(potentialLoss, 2), "$ <= ", MaxLossPerSpikeTradeDollars, "$");
   
   // Envoyer notification
   double currentPrice = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double notificationSL = 0, notificationTP = 0;
   
   if(direction == "BUY")
   {
      notificationSL = currentPrice - (currentPrice * 0.001);
      notificationTP = currentPrice + (currentPrice * 0.003);
   }
   else // SELL
   {
      notificationSL = currentPrice + (currentPrice * 0.001);
      notificationTP = currentPrice - (currentPrice * 0.003);
   }
   
   SendDerivArrowNotification(direction, currentPrice, notificationSL, notificationTP);
   
   // ExÃ©cuter l'ordre
   bool orderExecuted = false;

   // DEBUG: VÃ©rifier l'option NoSLTP_BoomCrash
   Print("ðŸ” DEBUG - NoSLTP_BoomCrash: ", NoSLTP_BoomCrash ? "OUI" : "NON", " | CatÃ©gorie: ", (SMC_GetSymbolCategory(_Symbol) == SYM_BOOM_CRASH ? "BOOM_CRASH" : "AUTRE"));

   if(direction == "BUY")
   {
      // SPIKE TRADE autonome: le spike captÃ© est le signal, pas besoin de flÃ¨che SMC_DERIV_ARROW
      double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      double sl = 0, tp = 0;

      // PrioritÃ© 1: Si trendline Dow actif et direction compatible â†’ utiliser le prix projetÃ© par la flÃ¨che DOW
      string entrySource = "";
      double limitPrice = 0.0;
      if(UseDowTrendline && g_dowState.active && !g_dowState.isBearish)
       {
          limitPrice = g_dowState.projectedPrice;
          entrySource = "DOW TRENDLINE";
          atrValue = g_dowState.currentATR; // ATR du DOW pour SL/TP
          Print("ðŸŽ¯ SPIKE BUY USING DOW ARROW: ", entrySource, " @ ", DoubleToString(limitPrice, _Digits),
                " | Trendline bullish (higher lows)");
       }
       // PrioritÃ© 2: Zones prÃ©dÃ©calculÃ©es (proactives)
       else if(g_cachedBestBuyLevel > 0 && g_cachedBestBuyLevel < ask)
       {
          limitPrice = g_cachedBestBuyLevel;
          entrySource = g_cachedBuySource;
          Print("ðŸŽ¯ SPIKE BUY USING CACHED ZONE: ", entrySource, " @ ", DoubleToString(limitPrice, _Digits));
       }
       // FIX v1.34: MARKET si GOOD/PERFECT (|vn|>=2) + M1/M5/M15 â€” SL cap $2
       int vnBuy = g_smcGomVerdictNum;
       if(MathAbs(vnBuy) < 2 && MathAbs(g_smcGomVerdictNumServer) >= 2)
          vnBuy = g_smcGomVerdictNumServer;
       bool gomGoodPerfect = (g_smcGomConnected && MathAbs(vnBuy) >= 2 && vnBuy > 0);
       string m1Buy = (StringLen(g_smcTfM1DirLive) > 0) ? g_smcTfM1DirLive : g_smcTfM1Dir;
       bool tfAligned = SMC_TfDirMatchesSign(1, m1Buy) &&
                       SMC_TfDirMatchesSign(1, g_smcTfM5Dir) &&
                       SMC_TfDirMatchesSign(1, g_smcTfM15Dir);
       bool useMarketOrder = (gomGoodPerfect && tfAligned);

if(useMarketOrder)
        {
           Print("âš¡ SPIKE BUY MARKET - GOOD/PERFECT + 3 TF alignÃ©s + spike (SL max $",
                 MaxLossPerSpikeTradeDollars, ")");
           limitPrice = ask;
           entrySource = "MARKET (GOOD+3TF)";

           // FIX: Always calculate SL/TP - NoSLTP_BoomCrash should NOT bypass SL/TP calculation
           sl = ask - atrValue * 1.2; // v1.34: SL serrÃ© puis cap $2
           SMC_CapSLToMaxLossUSD(_Symbol, 1, ask, lot, sl);
           // Forcer cap explicite MaxLossPerSpikeTradeDollars
           {
              double tickSz = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
              double tickVl = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
              if(tickSz <= 0) tickSz = _Point;
              if(tickVl > 0 && lot > 0)
              {
                 double maxDist = (MaxLossPerSpikeTradeDollars / (tickVl * lot)) * tickSz;
                 double curDist = ask - sl;
                 if(curDist > maxDist)
                    sl = NormalizeDouble(ask - maxDist, _Digits);
              }
           }
           double buySpikeRR = UseSniperScalperMode ? MinRewardRiskRatio : 1.5;
           tp = ask + (ask - sl) * buySpikeRR;
           if(SCH1_TPUseSRExtension && g_sch1_tpHint > ask)
           {
              tp = g_sch1_tpHint;
              Print("ðŸŽ¯ SPIKE BUY MARKET - TP ajuste par extension S/R H1: ", DoubleToString(tp, _Digits));
           }
        }
       else
       {
// LIMIT normal si conditions non remplies
        if(g_cachedBestBuyLevel > 0 && g_cachedBestBuyLevel < ask)
        {
           limitPrice = g_cachedBestBuyLevel;
           entrySource = g_cachedBuySource;
           Print("ðŸŽ¯ SPIKE BUY USING CACHED ZONE: ", entrySource, " @ ", DoubleToString(limitPrice, _Digits));
        }
        else
        {
           limitPrice = GetBestSpikeEntryLevel("BUY", ask, atrValue, entrySource);
           Print("ðŸŽ¯ SPIKE BUY FALLBACK TO DYNAMIC: ", entrySource, " @ ", DoubleToString(limitPrice, _Digits));
        }

        // SL/TP LIMIT â€” v1.34: serrÃ© + cap $2
        // FIX: Always calculate SL/TP - NoSLTP_BoomCrash should NOT bypass SL/TP calculation
        sl = limitPrice - atrValue * 1.2;
        SMC_CapSLToMaxLossUSD(_Symbol, 1, limitPrice, lot, sl);
        {
           double tickSz = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
           double tickVl = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
           if(tickSz <= 0) tickSz = _Point;
           if(tickVl > 0 && lot > 0)
           {
              double maxDist = (MaxLossPerSpikeTradeDollars / (tickVl * lot)) * tickSz;
              double curDist = limitPrice - sl;
              if(curDist > maxDist)
                 sl = NormalizeDouble(limitPrice - maxDist, _Digits);
           }
        }
        double buySpikeRR = UseSniperScalperMode ? MinRewardRiskRatio : 1.5;
        tp = limitPrice + (limitPrice - sl) * buySpikeRR;
        if(SCH1_TPUseSRExtension && g_sch1_tpHint > limitPrice)
        {
           tp = g_sch1_tpHint;
           Print("ðŸŽ¯ SPIKE BUY LIMIT - TP ajuste par extension S/R H1: ", DoubleToString(tp, _Digits));
        }
       }

       Print("ðŸŽ¯ SPIKE BUY ", useMarketOrder ? "MARKET" : "LIMIT", " - Source: ", entrySource,
             " | Ask: ", DoubleToString(ask, _Digits), " | Limit: ", DoubleToString(limitPrice, _Digits),
             " | SL: ", DoubleToString(sl, _Digits), " | TP: ", DoubleToString(tp, _Digits));

      // FIX 2026-09-09 (Claude, demande Sidoine): remplace l'appel OrderSend()
      // direct par SMC_SubmitEntry() â€” point d'entrÃ©e unique documentÃ© dans
      // SMC_TradeExecutor.mqh. Avant ce fix, ce LIMIT BUY contournait
      // SMC_FinalOpenGate (cap global, anti-hedge 90s, reaction tracker) et
      // SafeOrderSend (GOM WAIT, contre-trend Boom/Crash, cap SL $) â€” seul
      // chemin d'entrÃ©e du projet Ã  le faire.
      SMC_EntryRequest er;
      SMC_EntryRequest_Init(er);
      er.symbol      = _Symbol;
      er.orderType   = useMarketOrder ? ORDER_TYPE_BUY : ORDER_TYPE_BUY_LIMIT;
      er.volume      = lot;
      er.price       = limitPrice;
      er.sl          = sl;
      er.tp          = tp;
      er.deviation   = 50;
      er.comment     = useMarketOrder ? "SPIKE TRADE BUY MARKET (GOOD+3TF)" :
                      (g_lastSpikeEntryWasEarly ? "SPIKE CHAIN EARLY BUY LIMIT" : "SPIKE TRADE BUY LIMIT");
      er.sourceLabel = "SPIKE TRADE";

      MqlTradeResult res;
      if(!useMarketOrder && !CanPlaceLimitOrder(_Symbol, ORDER_TYPE_BUY_LIMIT)) return;
       if(SMC_SubmitEntry(er, res))
       {
          orderExecuted = true;
          Print("âœ… SPIKE TRADE BUY ", useMarketOrder ? "MARKET" : "LIMIT", " @ ", DoubleToString(limitPrice, _Digits),
                " | Lot: ", DoubleToString(lot, 2), " | Ticket: ", res.order);
          // ChaÃ®ne de spikes enrichie : enregistrer + notifier (Dow + type chaÃ®ne + TP1-3)
          SMCSCS_RegisterSpike(_Symbol, 1.0, 0);
          SMCSCS_NotifyChainSignal(_Symbol, 1.0, atrValue);
       }
      else
      {
         Print("âŒ Ã‰chec SPIKE TRADE BUY ", useMarketOrder ? "MARKET" : "LIMIT", " - Erreur: ", res.retcode, " - ", res.comment);
      }
   }
     else // SELL
     {
         // SPIKE TRADE autonome: le spike captÃ© est le signal, pas besoin de flÃ¨che SMC_DERIV_ARROW
        double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
       double sl = 0, tp = 0;
       
       // PrioritÃ© 1: Si trendline Dow actif et direction compatible â†’ utiliser le prix projetÃ© par la flÃ¨che DOW
       string entrySource = "";
       double limitPrice = 0.0;
       if(UseDowTrendline && g_dowState.active && g_dowState.isBearish)
       {
          limitPrice = g_dowState.projectedPrice;
          entrySource = "DOW TRENDLINE";
          atrValue = g_dowState.currentATR; // ATR du DOW pour SL/TP
          Print("ðŸŽ¯ SPIKE SELL USING DOW ARROW: ", entrySource, " @ ", DoubleToString(limitPrice, _Digits),
                " | Trendline bearish (lower highs)");
       }
       // PrioritÃ© 2: Zones prÃ©dÃ©calculÃ©es (proactives)
       else if(g_cachedBestSellLevel > 0 && g_cachedBestSellLevel > bid)
       {
          limitPrice = g_cachedBestSellLevel;
          entrySource = g_cachedSellSource;
          Print("ðŸŽ¯ SPIKE SELL USING CACHED ZONE: ", entrySource, " @ ", DoubleToString(limitPrice, _Digits));
       }
       // FIX v1.34: MARKET si GOOD/PERFECT (|vn|>=2) + M1/M5/M15 â€” SL cap $2
       int vnSell = g_smcGomVerdictNum;
       if(MathAbs(vnSell) < 2 && MathAbs(g_smcGomVerdictNumServer) >= 2)
          vnSell = g_smcGomVerdictNumServer;
       bool gomGoodPerfect = (g_smcGomConnected && MathAbs(vnSell) >= 2 && vnSell < 0);
       string m1Sell = (StringLen(g_smcTfM1DirLive) > 0) ? g_smcTfM1DirLive : g_smcTfM1Dir;
       bool tfAligned = SMC_TfDirMatchesSign(-1, m1Sell) &&
                       SMC_TfDirMatchesSign(-1, g_smcTfM5Dir) &&
                       SMC_TfDirMatchesSign(-1, g_smcTfM15Dir);
       bool useMarketOrder = (gomGoodPerfect && tfAligned);

if(useMarketOrder)
        {
           Print("âš¡ SPIKE SELL MARKET - GOOD/PERFECT + 3 TF alignÃ©s + spike (SL max $",
                 MaxLossPerSpikeTradeDollars, ")");
           limitPrice = bid;
           entrySource = "MARKET (GOOD+3TF)";

           // FIX: Always calculate SL/TP - NoSLTP_BoomCrash should NOT bypass SL/TP calculation
           sl = bid + atrValue * 1.2; // v1.34: SL serrÃ© puis cap $2
           SMC_CapSLToMaxLossUSD(_Symbol, -1, bid, lot, sl);
           {
              double tickSz = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
              double tickVl = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
              if(tickSz <= 0) tickSz = _Point;
              if(tickVl > 0 && lot > 0)
              {
                 double maxDist = (MaxLossPerSpikeTradeDollars / (tickVl * lot)) * tickSz;
                 double curDist = sl - bid;
                 if(curDist > maxDist)
                    sl = NormalizeDouble(bid + maxDist, _Digits);
              }
           }
           double sellSpikeRR = UseSniperScalperMode ? MinRewardRiskRatio : 1.5;
           tp = bid - (sl - bid) * sellSpikeRR;
           if(SCH1_TPUseSRExtension && g_sch1_tpHint > 0 && g_sch1_tpHint < bid)
           {
              tp = g_sch1_tpHint;
              Print("ðŸŽ¯ SPIKE SELL MARKET - TP ajuste par extension S/R H1: ", DoubleToString(tp, _Digits));
           }
        }
       else
       {
if(g_cachedBestSellLevel > 0 && g_cachedBestSellLevel > bid)
           {
              limitPrice = g_cachedBestSellLevel;
              entrySource = g_cachedSellSource;
              Print("ðŸŽ¯ SPIKE SELL USING CACHED ZONE: ", entrySource, " @ ", DoubleToString(limitPrice, _Digits));
           }
           else
           {
              limitPrice = GetBestSpikeEntryLevel("SELL", bid, atrValue, entrySource);
              Print("ðŸŽ¯ SPIKE SELL FALLBACK TO DYNAMIC: ", entrySource, " @ ", DoubleToString(limitPrice, _Digits));
           }

           // FIX: Always calculate SL/TP - NoSLTP_BoomCrash should NOT bypass SL/TP calculation
           sl = limitPrice + atrValue * 1.2;
           SMC_CapSLToMaxLossUSD(_Symbol, -1, limitPrice, lot, sl);
           {
              double tickSz = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
              double tickVl = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
              if(tickSz <= 0) tickSz = _Point;
              if(tickVl > 0 && lot > 0)
              {
                 double maxDist = (MaxLossPerSpikeTradeDollars / (tickVl * lot)) * tickSz;
                 double curDist = sl - limitPrice;
                 if(curDist > maxDist)
                    sl = NormalizeDouble(limitPrice + maxDist, _Digits);
              }
           }
           double sellSpikeRR = UseSniperScalperMode ? MinRewardRiskRatio : 1.5;
           tp = limitPrice - (sl - limitPrice) * sellSpikeRR;
           if(SCH1_TPUseSRExtension && g_sch1_tpHint > 0 && g_sch1_tpHint < limitPrice)
           {
              tp = g_sch1_tpHint;
              Print("ðŸŽ¯ SPIKE SELL LIMIT - TP ajuste par extension S/R H1: ", DoubleToString(tp, _Digits));
           }
       }

       Print("ðŸŽ¯ SPIKE SELL ", useMarketOrder ? "MARKET" : "LIMIT", " - Source: ", entrySource,
             " | Bid: ", DoubleToString(bid, _Digits), " | Limit: ", DoubleToString(limitPrice, _Digits),
             " | SL: ", DoubleToString(sl, _Digits), " | TP: ", DoubleToString(tp, _Digits));

      // FIX 2026-09-09 (Claude, demande Sidoine): idem BUY LIMIT ci-dessus â€”
      // SMC_SubmitEntry() au lieu d'OrderSend() direct.
      SMC_EntryRequest er;
      SMC_EntryRequest_Init(er);
      er.symbol      = _Symbol;
      er.orderType   = useMarketOrder ? ORDER_TYPE_SELL : ORDER_TYPE_SELL_LIMIT;
      er.volume      = lot;
      er.price       = limitPrice;
      er.sl          = sl;
      er.tp          = tp;
      er.deviation   = 50;
      er.comment     = useMarketOrder ? "SPIKE TRADE SELL MARKET (GOOD+3TF)" :
                      (g_lastSpikeEntryWasEarly ? "SPIKE CHAIN EARLY SELL LIMIT" : "SPIKE TRADE SELL LIMIT");
      er.sourceLabel = "SPIKE TRADE";

      MqlTradeResult res;
      if(!useMarketOrder && !CanPlaceLimitOrder(_Symbol, ORDER_TYPE_SELL_LIMIT)) return;
       if(SMC_SubmitEntry(er, res))
       {
          orderExecuted = true;
          Print("âœ… SPIKE TRADE SELL ", useMarketOrder ? "MARKET" : "LIMIT", " @ ", DoubleToString(limitPrice, _Digits),
                " | Lot: ", DoubleToString(lot, 2), " | Ticket: ", res.order);
          // ChaÃ®ne de spikes enrichie : enregistrer + notifier (Dow + type chaÃ®ne + TP1-3)
          SMCSCS_RegisterSpike(_Symbol, -1.0, 0);
          SMCSCS_NotifyChainSignal(_Symbol, -1.0, atrValue);
       }
      else
      {
         Print("âŒ Ã‰chec SPIKE TRADE SELL ", useMarketOrder ? "MARKET" : "LIMIT", " - Erreur: ", res.retcode, " - ", res.comment);
      }
   }
   
   if(orderExecuted)
   {
      Print("ðŸŽ¯ SPIKE TRADE EXÃ‰CUTÃ‰ AVEC SUCCÃˆS - Direction: ", direction, " | Symbole: ", _Symbol,
            g_lastSpikeEntryWasEarly ? " | Mode: ENTRÃ‰E PRÃ‰COCE (Spike Chain)" : "");
      
      // MT5 Push Notification (Mobile)
      string notifMsg = StringFormat("SPIKE %s %s | Lot: %s",
                                     direction, _Symbol, DoubleToString(lot, 2));
      SendNotification(notifMsg);
      Print("ðŸ“± PUSH NOTIFICATION envoyÃ©e: ", notifMsg);
      
      // DÃ©marrer la surveillance pour clÃ´ture immÃ©diate en gain positif
      StartSpikePositionMonitoring(direction);
   }
    g_lastSpikeEntryWasEarly = false;
}

void ExecuteVolatilityTrade(string direction)
{
   Print("ðŸ” VOLATILITY TRADE - Direction: ", direction, " | Symbole: ", _Symbol);

   // FIX v1.34: GOOD/PERFECT (|vn|>=2) + M1/M5/M15 â€” serveur si overlay WAIT
   int vnVol = g_smcGomVerdictNum;
   if(MathAbs(vnVol) < 2 && MathAbs(g_smcGomVerdictNumServer) >= 2)
      vnVol = g_smcGomVerdictNumServer;
   int dirSign = (direction == "BUY") ? 1 : -1;
   bool gomGoodPerfect = (g_smcGomConnected && MathAbs(vnVol) >= 2 &&
                          ((dirSign > 0 && vnVol > 0) || (dirSign < 0 && vnVol < 0)));
   string m1Vol = (StringLen(g_smcTfM1DirLive) > 0) ? g_smcTfM1DirLive : g_smcTfM1Dir;
   bool tfAligned = SMC_TfDirMatchesSign(dirSign, m1Vol) &&
                   SMC_TfDirMatchesSign(dirSign, g_smcTfM5Dir) &&
                   SMC_TfDirMatchesSign(dirSign, g_smcTfM15Dir);
   bool directMarketEntry = (gomGoodPerfect && tfAligned);

   if(CountPositionsForSymbol(_Symbol) > 0 || CountPositionsOurEA() >= MathMax(1, MaxPositionsTerminal))
   {
      Print("ðŸš« VOLATILITY BLOQUÃ‰ â€” dÃ©jÃ  en position (1 max) | ", _Symbol);
      return;
   }
   if(!CanTradeOnSymbol(_Symbol, direction))
   {
      Print("ðŸš« VOLATILITY BLOQUÃ‰ â€” Terminal plein, sens interdit, retournement ou ordre existant sur ", _Symbol);
      return;
   }

   if(directMarketEntry)
   {
      Print("âš¡ VOLATILITY MARKET DIRECT - GOOD/PERFECT + 3 TF alignÃ©s (sans spike)");
      if(g_smcGomVerdictNum == 0 && MathAbs(vnVol) >= 2)
      {
         g_smcGomVerdictNum = vnVol;
         g_smcGomVerdict = g_smcGomVerdictServer;
      }
   }
   
   // L'exÃ©cuteur commun plafonne FX Vol/SFX Vol au lot minimum broker.
   // Utiliser le lot Weltrade fixe ici Ã©vite le rejet systÃ©matique du lot
   // dynamique, souvent supÃ©rieur Ã  ce plafond.
   bool isWeltradeVol = SMC_IsWeltradeVolSymbol(_Symbol);
   double lot = isWeltradeVol ? SMC_WeltradeFxVolLot() : CalculateLotSize();
   if(!isWeltradeVol)
      lot = ApplyRecoveryLot(lot);
   if(lot <= 0)
   {
      Print("âŒ VOLATILITY - Lot invalide");
      return;
   }
   
   // ATR pour SL/TP
   double atrValue = 0.0;
   if(atrHandle != INVALID_HANDLE)
   {
      double atrBuf[];
      ArraySetAsSeries(atrBuf, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, atrBuf) >= 1)
         atrValue = atrBuf[0];
   }
   if(atrValue <= 0)
      atrValue = SymbolInfoDouble(_Symbol, SYMBOL_BID) * 0.002;

   // FIX 2026-09-13 (Claude, demande Sidoine â€” SFX Vol 20 "Invalid stops",
   // TP calculÃ© nÃ©gatif Ã  -124535.85) : un ATR(14) M1 anormal (tick/bougie
   // corrompue cÃ´tÃ© broker, ou lecture d'indicateur pas encore stabilisÃ©e
   // juste aprÃ¨s attachement) peut renvoyer une valeur aberrante â€” ici
   // ATR â‰ˆ 35-45% du prix, ce qui a fait dÃ©border tpDist au point de rendre
   // le TP nÃ©gatif. Clamp dÃ©fensif : un ATR M1 crÃ©dible ne dÃ©passe jamais
   // ~3% du prix courant pour ces symboles ; au-delÃ , on retombe sur le
   // fallback 0.2% plutÃ´t que de propager une valeur aberrante dans SL/TP.
   double refPxForAtrSanity = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   if(refPxForAtrSanity > 0 && atrValue > refPxForAtrSanity * 0.03)
   {
      Print("âš ï¸ VOLATILITY - ATR aberrant dÃ©tectÃ© (", DoubleToString(atrValue, _Digits),
            " = ", DoubleToString(atrValue / refPxForAtrSanity * 100.0, 1),
            "% du prix) â€” clamp appliquÃ© au fallback 0.2%");
      atrValue = refPxForAtrSanity * 0.002;
   }
   
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   long stopsLevel = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL);
   double minStopDistance = (double)stopsLevel * point;
   if(minStopDistance <= 0) minStopDistance = 5 * point;
   
   // SL/TP basÃ©s sur ATR avec RR ratio
   double slDist = atrValue * SL_ATRMult;
   double rrRatio = UseSniperScalperMode ? MinRewardRiskRatio : 2.0;
   double tpDist = slDist * rrRatio;
   
   // S'assurer que SL respecte le min du courtier
   slDist = MathMax(slDist, minStopDistance * 2.0);
   tpDist = MathMax(tpDist, slDist * rrRatio);
   // FIX v1.35: SL â‰¥ 10 pips, TP â‰¥ 30 pips (SFX VOL / FXVOL)
   {
      double pip = SMCGP_PipSize(_Symbol);
      int slPips = (MarketSLPips > 0) ? MarketSLPips : 10;
      int tpPips = (MarketTPPips > 0) ? MarketTPPips : 30;
      slDist = MathMax(slDist, pip * (double)slPips);
      tpDist = MathMax(tpDist, pip * (double)tpPips);
   }
   
   // VÃ©rifier perte max en $
   double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   double tickVal  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   if(tickSize <= 0) tickSize = point;
   if(tickVal <= 0) tickVal = 1.0;
   double riskPerLotDollars = slDist * (tickVal / tickSize);
   if(riskPerLotDollars <= 0) riskPerLotDollars = 1.0;
   double potentialLoss = lot * riskPerLotDollars;
   double dynMaxLossUSD = SMC_GetDynamicMaxLossUSD();
   if(potentialLoss > dynMaxLossUSD)
   {
      double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
      double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
      double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
      if(lotStep <= 0) lotStep = 0.01;
      double lotCap = dynMaxLossUSD / riskPerLotDollars;
      lot = MathFloor(lotCap / lotStep) * lotStep;
      lot = MathMax(minLot, MathMin(maxLot, lot));
      lot = NormalizeDouble(lot, 2);
      potentialLoss = lot * riskPerLotDollars;
      if(potentialLoss > dynMaxLossUSD * 1.01)
      {
         // FIX 2026-09-13 (Claude, demande Sidoine): sur verdict GOM GOOD/PERFECT
         // alignÃ©, ne plus bloquer l'entrÃ©e mÃªme si le lot minimum dÃ©passe le cap $
         // dynamique (compte trop petit pour l'ATR courant) â€” on force le lot
         // minimum et on laisse passer, au lieu de rater un signal GOOD/PERFECT.
         // Les verdicts WAIT/SIMPLE restent protÃ©gÃ©s par le cap (comportement
         // inchangÃ©) : seul GOOD/PERFECT alignÃ© bÃ©nÃ©ficie de l'override.
         bool isGoodPerfectAligned = OverrideRiskCapOnGoodPerfect &&
             SMCGP_IsGoodPerfect(g_smcGomVerdictNum) &&
             ((direction == "BUY" && g_smcGomVerdictNum > 0) ||
              (direction == "SELL" && g_smcGomVerdictNum < 0));

         if(isGoodPerfectAligned)
         {
            lot = minLot;
            potentialLoss = lot * riskPerLotDollars;
            Print("âš ï¸ VOLATILITY - Cap $ dÃ©passÃ© mÃªme au lot min (", DoubleToString(potentialLoss, 2),
                  "$ > cap ", DoubleToString(dynMaxLossUSD, 2),
                  "$) MAIS verdict GOOD/PERFECT alignÃ© (vn=", g_smcGomVerdictNum,
                  ") â†’ override, entrÃ©e forcÃ©e au lot minimum ", DoubleToString(lot, 2));
         }
         else
         {
            Print("âŒ VOLATILITY BLOQUÃ‰ - Perte min (lot ", DoubleToString(minLot, 2), ") = ",
                  DoubleToString(potentialLoss, 2), "$ > cap dynamique ", dynMaxLossUSD, "$");
            return;
         }
      }
      else
         Print("ðŸ”§ VOLATILITY Lot rÃ©duit â†’ ", DoubleToString(lot, 2), " | Perte: ", DoubleToString(potentialLoss, 2), "$");
   }
   
   // Prix actuel + SL/TP
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double sl = 0, tp = 0;
   
   if(direction == "BUY")
   {
      sl = NormalizeDouble(ask - slDist, _Digits);
      tp = NormalizeDouble(ask + tpDist, _Digits);
   }
   else
   {
      sl = NormalizeDouble(bid + slDist, _Digits);
      tp = NormalizeDouble(bid - tpDist, _Digits);
   }

   // FIX 2026-09-13 (Claude, demande Sidoine) : filet de sÃ©curitÃ© ultime â€”
   // mÃªme avec le clamp ATR ci-dessus, on ne laisse jamais partir un ordre
   // avec un SL/TP nÃ©gatif, nul, ou incohÃ©rent (TP du mauvais cÃ´tÃ© du prix).
   // C'est exactement ce qui a produit l'erreur broker "Invalid stops" sur
   // SFX Vol 20 (TP=-124535.85).
   bool stopsSane = (sl > 0 && tp > 0);
   if(stopsSane)
   {
      if(direction == "BUY")  stopsSane = (tp > ask && sl < ask);
      else                    stopsSane = (tp < bid && sl > bid);
   }
   if(!stopsSane)
   {
      Print("âŒ VOLATILITY BLOQUÃ‰ â€” SL/TP invalide aprÃ¨s calcul (SL=", DoubleToString(sl, _Digits),
            " TP=", DoubleToString(tp, _Digits), " ", direction, " @ ",
            DoubleToString(direction == "BUY" ? ask : bid, _Digits),
            ") â€” ordre non envoyÃ©, ATR probablement corrompu ce tick.");
      return;
   }

   Print("ðŸŽ¯ VOLATILITY ", direction, " | Ask/Bid: ", DoubleToString(direction == "BUY" ? ask : bid, _Digits),
         " | SL: ", DoubleToString(sl, _Digits), " | TP: ", DoubleToString(tp, _Digits),
         " | SL dist: ", DoubleToString(slDist/point, 0), " pts | RR: ", DoubleToString(rrRatio, 1),
         " | ATR: ", DoubleToString(atrValue, _Digits));
   
   // Envoyer notification
   SendDerivArrowNotification(direction, direction == "BUY" ? ask : bid, sl, tp);
   
// ExÃ©cuter ordre au marchÃ©
    // FIX 2026-09-13 (Claude, demande Sidoine) : SMC_SubmitEntry() au lieu
    // d'OrderSend() direct â€” un des 10 sites encore non migrÃ©s, ne bÃ©nÃ©ficiait
    // pas de SafeOrderSend (cap SL$, cohÃ©rence GOM) au-delÃ  de FinalOpenGate.
    SMC_EntryRequest er;
    SMC_EntryRequest_Init(er);
    er.symbol      = _Symbol;
    er.orderType   = (direction == "BUY") ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
    er.volume      = lot;
    er.price       = (direction == "BUY") ? ask : bid;
    er.sl          = sl;
    er.tp          = tp;
    er.deviation   = 50;
    er.comment     = directMarketEntry ? "VOLATILITY " + direction + " (GOOD+3TF DIRECT)" : "VOLATILITY " + direction;
    er.sourceLabel = directMarketEntry ? "VOLATILITY DIRECT" : "VOLATILITY";

    MqlTradeResult res;
    if(SMC_SubmitEntry(er, res))
    {
       ulong ticket = res.order;
       if(ticket > 0) SMC_ApplyPostEntrySLBuffer(_Symbol, ticket, 1.0);
       Print("âœ… VOLATILITY TRADE EXÃ‰CUTÃ‰ - ", direction, " ", _Symbol,
             " | Lot: ", DoubleToString(lot, 2),
             " | Ticket: ", res.order,
            " | SL: ", DoubleToString(sl, _Digits),
            " | TP: ", DoubleToString(tp, _Digits));
      
      string notifMsg = StringFormat("VOLATILITY %s %s | Lot: %s | RR: %s",
                                     direction, _Symbol, DoubleToString(lot, 2),
                                     DoubleToString(rrRatio, 1));
      SendNotification(notifMsg);
      Print("ðŸ“± PUSH NOTIFICATION envoyÃ©e: ", notifMsg);
   }
   else
   {
      Print("âŒ VOLATILITY TRADE Ã‰CHOUÃ‰ - Erreur: ", res.retcode, " - ", res.comment);
   }
}

