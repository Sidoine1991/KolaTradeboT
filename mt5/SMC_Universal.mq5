// ==========================================================================
// === PROFIL OR / FOREX / CRYPTO â€” IMPLÃ‰MENTATIONS                       ===
// ==========================================================================

// Variables TP partiel Or
bool     g_goldHalfClosed    = false;
double   g_goldSlDistance    = 0.0;
double   g_goldEntryPrice    = 0.0;
ulong    g_goldPartialTicket = 0;
// Variables rÃ©gime marchÃ© Or (W1)
int      g_goldRegimeW1_50  = INVALID_HANDLE;
int      g_goldRegimeW1_200 = INVALID_HANDLE;
int      g_goldRegime       = 0;        // 1=BULL, -1=BEAR, 0=TRANSITION
datetime g_goldRegimeUpdate = 0;
// Variables Gold Scalp (COG vert)
datetime g_goldScalpLastEntry = 0;
string   g_goldScalpCogPrev   = "";
int      g_goldScalpEma9M1    = INVALID_HANDLE;

bool SMC_IsGoldProfileActive()
{
   return UseGoldHybridProfile && SMC_GetSymbolCategory(_Symbol) == SYM_METAL;
}
bool SMC_IsForexProfileActive()
{
   return UseForexProfile && SMC_GetSymbolCategory(_Symbol) == SYM_FOREX;
}
bool SMC_IsCryptoProfileActive()
{
   return UseCryptoProfile && SMC_GetSymbolCategory(_Symbol) == SYM_CRYPTO;
}

double SMC_EffectiveSLMult()
{
   if(SMC_IsGoldProfileActive())   return GoldSL_ATRMult;
   if(SMC_IsForexProfileActive())  return ForexSL_ATRMult;
   if(SMC_IsCryptoProfileActive()) return CryptoSL_ATRMult;
   return SL_ATRMult;
}

double SMC_EffectiveTPMult()
{
   double base;
   if(SMC_IsGoldProfileActive())   base = GoldTP_ATRMult;
   else if(SMC_IsForexProfileActive())  base = ForexTP_ATRMult;
   else if(SMC_IsCryptoProfileActive()) base = CryptoTP_ATRMult;
   else base = TP_ATRMult;

   if(UseAIServer && g_agentLastUpdate > 0 && g_agentRegime != "")
   {
      if(g_agentRegime == "TRENDING_UP" || g_agentRegime == "TRENDING_DOWN")
         base *= 1.30;
      else if(g_agentRegime == "BREAKOUT")
         base *= 1.15;
      else if(g_agentRegime == "RANGING")
         base *= 0.80;
      else if(g_agentRegime == "VOLATILE")
         base *= 0.70;
   }
   return base;
}

double SMC_EffectiveMaxDailyDDPct()
{
   if(SMC_IsGoldProfileActive())   return GoldMaxDailyLossPct;
   if(SMC_IsForexProfileActive())  return ForexMaxDailyLossPct;
   if(SMC_IsCryptoProfileActive()) return CryptoMaxDailyLossPct;
   return MaxDailyDrawdownPercent;
}

double SMC_EffectiveRiskPct()
{
   if(SMC_IsGoldProfileActive())   return GoldMaxRiskPct;
   if(SMC_IsForexProfileActive())  return ForexMaxRiskPct;
   if(SMC_IsCryptoProfileActive()) return CryptoMaxRiskPct;
   return MaxRiskPerTradePercent;
}

double SMC_EffectiveMaxTotalLossUSD()
{
   return SMC_IsGoldProfileActive() ? GoldMaxTotalLossUSD : MaxTotalLossDollars;
}

int SMC_EffectiveMaxPositionsTerminal()
{
   int cap = MaxPositionsTerminal;
   if(SMC_IsGoldProfileActive())
      cap = MathMin(cap, GoldMaxPositions);
   return MathMax(1, cap);
}

bool SMC_TerminalPositionCapReached()
{
   return CountTerminalAllOrders() >= SMC_EffectiveMaxPositionsTerminal();
}

double SMC_EffectiveGOMMinCoherence()
{
   if(SMC_IsGoldProfileActive())   return GoldGOMMinCoherencePct;
   if(SMC_IsForexProfileActive())  return ForexGOMMinCoherencePct;
   if(SMC_IsCryptoProfileActive()) return CryptoGOMMinCoherencePct;
   if(SMC_GetSymbolCategory(_Symbol) == SYM_BOOM_CRASH
      || SMC_GetSymbolCategory(_Symbol) == SYM_VOLATILITY)
      return 25.0;
   return GOMMinCoherencePct;
}

double SMC_EffectiveMinAIConfidence()
{
   return SMC_IsGoldProfileActive() ? GoldMinAIConfidencePct : MinAIConfidencePercent;
}

double SMC_EffectiveGOMTrailingMinUSD()
{
   return SMC_IsGoldProfileActive() ? GoldTrailingMinUSD : GOMTrailingMinProfitUSD;
}

bool SMC_EffectiveRequireDerivArrow()
{
   if(SMC_IsGoldProfileActive() && GoldDisableDerivArrow)
      return false;
   return RequireSMCDerivArrowForMarketOrders;
}

bool SMC_IsInProfileSessionWindow()
{
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   int h = dt.hour;
   if(SMC_IsForexProfileActive() && ForexUseSessionFilter)
      return (h >= ForexSessionStart && h < ForexSessionEnd);
   if(SMC_IsCryptoProfileActive() && CryptoUseSessionFilter)
      return (h >= CryptoSessionStart && h < CryptoSessionEnd);
   return true;
}

// VÃ©rifie si on est dans une session Volatility optimale (2 fenÃªtres UTC)
bool SMC_IsVolSessionActive()
{
   if(!VolUseSessionFilter) return true;
   if(SMC_GetSymbolCategory(_Symbol) != SYM_VOLATILITY) return true;
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   int h = dt.hour;
   bool inSession1 = (h >= VolSessionStart1 && h < VolSessionEnd1);
   bool inSession2 = (h >= VolSessionStart2 && h < VolSessionEnd2);
   return (inSession1 || inSession2);
}

int SMC_GetGoldRegimeW1()
{
   if(!GoldUseRegimeFilter) return 1;
   if(TimeCurrent() - g_goldRegimeUpdate < 300) return g_goldRegime;

   if(g_goldRegimeW1_50  == INVALID_HANDLE) g_goldRegimeW1_50  = iMA(_Symbol, PERIOD_W1, 50,  0, MODE_EMA, PRICE_CLOSE);
   if(g_goldRegimeW1_200 == INVALID_HANDLE) g_goldRegimeW1_200 = iMA(_Symbol, PERIOD_W1, 200, 0, MODE_EMA, PRICE_CLOSE);
   if(g_goldRegimeW1_50 == INVALID_HANDLE || g_goldRegimeW1_200 == INVALID_HANDLE) return g_goldRegime;

   double buf50[], buf200[];
   ArraySetAsSeries(buf50, true); ArraySetAsSeries(buf200, true);
   if(CopyBuffer(g_goldRegimeW1_50,  0, 0, 2, buf50)  < 2) return g_goldRegime;
   if(CopyBuffer(g_goldRegimeW1_200, 0, 0, 2, buf200) < 2) return g_goldRegime;

   double ema50  = buf50[1];
   double ema200 = buf200[1];
   if(ema200 <= 0) return g_goldRegime;

   double thresh = ema200 * 0.005;
   int newRegime;
   if(ema50 > ema200 + thresh)       newRegime = 1;
   else if(ema50 < ema200 - thresh)  newRegime = -1;
   else                               newRegime = 0;

   if(newRegime != g_goldRegime)
   {
      string names[] = {"BEAR", "TRANSITION", "BULL"};
      Print(StringFormat("[SMC-Gold] RÃ©gime W1 changÃ© : %s ? %s | EMA50=%.2f EMA200=%.2f",
            names[g_goldRegime+1], names[newRegime+1], ema50, ema200));
   }
   g_goldRegime       = newRegime;
   g_goldRegimeUpdate = TimeCurrent();
   return g_goldRegime;
}

bool SMC_IsGoldDirectionAllowed(const string direction)
{
   if(!SMC_IsGoldProfileActive()) return true;
   int regime = SMC_GetGoldRegimeW1();
   if(regime ==  1) return (direction == "BUY");
   if(regime == -1) return true;
   return true;
}

double SMC_GoldTransitionLotFactor()
{
   if(!SMC_IsGoldProfileActive() || !GoldUseRegimeFilter) return 1.0;
   return (SMC_GetGoldRegimeW1() == 0) ? 0.5 : 1.0;
}

void SMC_ManageGoldPartialTP()
{
   if(!SMC_IsGoldProfileActive() || !GoldUsePartialTP) return;
   if(g_goldPartialTicket == 0) return;
   if(!posInfo.SelectByTicket(g_goldPartialTicket)) { g_goldPartialTicket = 0; return; }
   if(posInfo.Symbol() != _Symbol || posInfo.Magic() != InpMagicNumber) { g_goldPartialTicket = 0; return; }

   double curPrice = posInfo.PriceCurrent();
   double ep       = g_goldEntryPrice;
   double slDist   = g_goldSlDistance;
   if(slDist <= 0) return;

   bool isBuy = (posInfo.PositionType() == POSITION_TYPE_BUY);

   if(!g_goldHalfClosed)
   {
      double tp1dist = slDist * GoldTP_ATRMult / SMC_EffectiveSLMult();
      bool tp1Hit = isBuy ? (curPrice >= ep + slDist * 1.5) : (curPrice <= ep - slDist * 1.5);

      if(tp1Hit)
      {
         double halfLot = posInfo.Volume() * 0.5;
         double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
         double stepLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
         halfLot = MathMax(minLot, MathFloor(halfLot / stepLot) * stepLot);

         if(halfLot >= minLot && trade.PositionClosePartial(g_goldPartialTicket, halfLot))
         {
            g_goldHalfClosed = true;
            int    dg      = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
            double newSL   = NormalizeDouble(ep, dg);
            double minStop = (double)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * _Point;
            bool   slOk    = isBuy ? (newSL < curPrice - minStop) : (newSL > curPrice + minStop);
            if(slOk)
            {
               double currentSL = posInfo.StopLoss();
               newSL = NormalizeSLForBroker(_Symbol, newSL, currentSL);
               trade.PositionModify(g_goldPartialTicket, newSL, posInfo.TakeProfit());
            }
            Print(StringFormat("[SMC-Gold] TP1 PARTIEL Or | %.2f lots fermÃ©s Ã  RR=1.5 | SL?BE (%.2f)",
                  halfLot, ep));
         }
      }
   }
}

void SMC_ManageGoldScalp()
{
   if(!GoldScalpEnabled) return;
   if(!SMC_IsGoldProfileActive()) return;
   if(BlockAllTrades) return;

   string cogDir = g_cogDirection;
   int    gomVn  = g_smcGomVerdictNum;

   bool cogTurnedOff  = (cogDir != "BUY");
   bool gomWait       = (gomVn == 0);

   if(cogTurnedOff || gomWait)
   {
      if(g_goldScalpCogPrev == "BUY" && cogTurnedOff)
      {
         Print("[GOLD-SCALP] COG changÃ© (", cogDir, ") â€” fermeture de tous les scalps Or");
         for(int i = PositionsTotal() - 1; i >= 0; i--)
         {
            if(!posInfo.SelectByIndex(i)) continue;
            if(posInfo.Symbol() != _Symbol)     continue;
            if(posInfo.Magic()  != InpMagicNumber) continue;
            if(StringFind(posInfo.Comment(), "GOLD_SCALP") < 0) continue;
            PositionCloseWithLog(posInfo.Ticket(), "COG changÃ© â€” sortie scalp Or");
         }
      }
      else if(gomWait && g_goldScalpCogPrev == "BUY")
      {
         Print("[GOLD-SCALP] GOM=WAIT â€” fermeture scalps Or");
         for(int i = PositionsTotal() - 1; i >= 0; i--)
         {
            if(!posInfo.SelectByIndex(i)) continue;
            if(posInfo.Symbol() != _Symbol)        continue;
            if(posInfo.Magic()  != InpMagicNumber) continue;
            if(StringFind(posInfo.Comment(), "GOLD_SCALP") < 0) continue;
            PositionCloseWithLog(posInfo.Ticket(), "GOM WAIT â€” sortie scalp Or");
         }
      }
      g_goldScalpCogPrev = cogDir;
      return;
   }

    // --- STRICT GOM GATE: Only GOOD/PERFECT (vn >= 2 or vn <= -2) ---
    if(!UseGOMVerdictFilter || !g_smcGomConnected) return;
    if(!SMCGP_IsGoodPerfect(gomVn))
    {
       static datetime lastScalpGomLog = 0;
       if(TimeCurrent() - lastScalpGomLog >= 30)
       { lastScalpGomLog = TimeCurrent();
         Print("[GOLD-SCALP] BloquÃ© â€” verdict=", g_smcGomVerdict, " vn=", gomVn); }
       return;
    }

    g_goldScalpCogPrev = "BUY";

    if(g_smcIAStatusAction != "BUY")
   {
      static datetime s_iaGoldLog = 0;
      if(TimeCurrent() - s_iaGoldLog >= 120)
      { s_iaGoldLog = TimeCurrent();
        Print("[GOLD-SCALP] IA Status=", g_smcIAStatusAction, " â€” scalp bloquÃ©"); }
      return;
   }

   if(!g_smcCorrEntrySafe && g_smcCorrExhaustPct < 65.0)
   {
      static datetime s_corrGoldLog = 0;
      if(TimeCurrent() - s_corrGoldLog >= 120)
      { s_corrGoldLog = TimeCurrent();
        Print("[GOLD-SCALP] Correction active (", g_smcCorrPhase, " ",
              DoubleToString(g_smcCorrExhaustPct, 0), "%) â€” scalp bloquÃ©"); }
      return;
   }

   if(TimeCurrent() - g_goldScalpLastEntry < GoldScalpCooldownSec) return;

   int scalpCount = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Symbol() != _Symbol)        continue;
      if(posInfo.Magic()  != InpMagicNumber) continue;
      if(StringFind(posInfo.Comment(), "GOLD_SCALP") >= 0) scalpCount++;
   }
   if(scalpCount >= GoldScalpMaxPositions) return;
   if(SMC_TerminalPositionCapReached()) return;

   double atr = GOM_GetATRValue();
   if(atr <= 0) return;
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if(ask <= 0) return;

   bool trigger = false;
   string reason = "";

   if(GoldScalpUseEMA9 && g_goldScalpEma9M1 != INVALID_HANDLE)
   {
      double ema9[];
      ArraySetAsSeries(ema9, true);
      if(CopyBuffer(g_goldScalpEma9M1, 0, 0, 3, ema9) == 3)
      {
         double low1[];
         ArraySetAsSeries(low1, true);
         if(CopyLow(_Symbol, PERIOD_M1, 0, 3, low1) == 3)
         {
            bool touchedEma = (low1[1] <= ema9[1] + atr * 0.1);
            bool recovering = (ask > ema9[0]);
            if(touchedEma && recovering)
            {
               trigger = true;
               reason  = "EMA9_REBOND";
            }
         }
      }
   }

   if(!trigger && GoldScalpUseOBBull)
   {
      MqlRates rates[];
      ArraySetAsSeries(rates, true);
      if(CopyRates(_Symbol, PERIOD_M1, 0, 30, rates) == 30)
      {
         double tol = atr * GoldScalpOBTolATR;
         for(int k = 2; k < 28 && !trigger; k++)
         {
            bool isBullOB = (rates[k].close < rates[k].open &&
                             rates[k+1].close > rates[k+1].open &&
                             (rates[k+1].high - rates[k].low) > SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10);
            if(!isBullOB) continue;
            double obHigh = rates[k].high;
            double obLow  = rates[k].low;
            if(ask >= obLow - tol && ask <= obHigh + tol)
            {
               trigger = true;
               reason  = StringFormat("OB_BULL@%.2f-%.2f", obLow, obHigh);
            }
         }
      }
   }

   if(!trigger) return;

   double sl = ask - atr * GoldScalpSL_ATRMult;
   double tp = ask + atr * GoldScalpTP_ATRMult;

   double balance   = AccountInfoDouble(ACCOUNT_BALANCE);
   double riskAmt   = balance * GoldScalpRiskPct / 100.0;
   double slPips    = atr * GoldScalpSL_ATRMult;
   double tickVal   = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   double minLot    = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double lotStep   = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   double maxLot    = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double lot = 0.01;
   if(tickVal > 0 && tickSize > 0 && slPips > 0)
      lot = riskAmt / (slPips / tickSize * tickVal);
   lot = MathMax(minLot, MathFloor(lot / lotStep) * lotStep);
   lot = MathMin(lot, maxLot);

   MqlTradeRequest req = {};
   MqlTradeResult  res = {};
   req.action    = TRADE_ACTION_DEAL;
   req.symbol    = _Symbol;
   req.volume    = lot;
   req.type      = ORDER_TYPE_BUY;
   req.price     = ask;
   req.sl        = NormalizeDouble(sl, _Digits);
   req.tp        = NormalizeDouble(tp, _Digits);
   req.deviation = 10;
   req.magic     = InpMagicNumber;
   req.comment   = "GOLD_SCALP|" + reason;
   {
      long fillFlags = SymbolInfoInteger(_Symbol, SYMBOL_FILLING_MODE);
      if((fillFlags & SYMBOL_FILLING_IOC) != 0)
         req.type_filling = ORDER_FILLING_IOC;
      else if((fillFlags & SYMBOL_FILLING_FOK) != 0)
         req.type_filling = ORDER_FILLING_FOK;
      else
         req.type_filling = ORDER_FILLING_RETURN;
   }

   // DerniÃ¨re barriÃ¨re avant envoi : aucune exposition opposÃ©e ni pending inverse.
   if(!CanTradeOnSymbol(_Symbol, "BUY"))
   {
      Print("[GOLD-SCALP] BUY bloquÃ© par le gate anti-hedge/sniper sur ", _Symbol);
      return;
   }

   g_goldScalpLastEntry = TimeCurrent();

   if(SafeOrderSendAndAlert(req, res) && res.retcode == TRADE_RETCODE_DONE)
   {
      Print(StringFormat("[GOLD-SCALP] BUY %.2f lots @ %.2f | SL=%.2f TP=%.2f | %s | COG=%s GOM=%s",
            lot, ask, sl, tp, reason, cogDir, g_smcGomVerdict));
   }
   else
   {
      Print(StringFormat("[GOLD-SCALP] Ã‰chec BUY retcode=%d | %s â€” cooldown %ds avant prochain essai",
            res.retcode, reason, GoldScalpCooldownSec));
   }
}

// ==========================================================================
// === FIN PROFIL OR / FOREX / CRYPTO                                     ===
// ==========================================================================

// ==========================================================================
// === PROACTIVE ENTRY ZONE CACHING (FVG / OB / Swing / ATR)              ===
// ==========================================================================
// Zones calculÃ©es AVANT spike â€” le spike arrive â†’ on place l'ordre au prix de la zone
// g_cachedBestBuyLevel / g_cachedBestSellLevel : SMC_SharedCore.mqh
string   g_cachedBuySource      = "";
string   g_cachedSellSource     = "";
datetime g_cachedZoneUpdate     = 0;
#define ZONE_CACHE_TTL_SEC  5   // Recalculer les zones toutes les 5 secondes

void UpdateCachedEntryZones()
{
   if(TimeCurrent() - g_cachedZoneUpdate < ZONE_CACHE_TTL_SEC) return;
   g_cachedZoneUpdate = TimeCurrent();

   double atr = 0.0;
   if(atrHandle != INVALID_HANDLE)
   {
      double atrBuf[];
      ArraySetAsSeries(atrBuf, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, atrBuf) >= 1) atr = atrBuf[0];
   }
   if(atr <= 0) return;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if(bid <= 0 || ask <= 0) return;

   // --- BUY zones: Swing low (plus proche support) ---
   string srcBuy = "";
   double swingBuy = GetClosestBuyLevel(bid, atr, 2.0, srcBuy);
   if(swingBuy > 0 && swingBuy < bid && (bid - swingBuy) <= atr * 2.5)
   {
      g_cachedBestBuyLevel = swingBuy;
      g_cachedBuySource    = "SWING_" + srcBuy;
   }
   else
   {
      g_cachedBestBuyLevel = bid - atr * 1.5;
      g_cachedBuySource    = "ATR";
   }

   // --- SELL zones: Swing high (plus proche rÃ©sistance) ---
   string srcSell = "";
   double swingSell = GetClosestSellLevel(ask, atr, 2.0, srcSell);
   if(swingSell > 0 && swingSell > ask && (swingSell - ask) <= atr * 2.5)
   {
      g_cachedBestSellLevel = swingSell;
      g_cachedSellSource    = "SWING_" + srcSell;
   }
   else
   {
      g_cachedBestSellLevel = ask + atr * 1.5;
      g_cachedSellSource    = "ATR";
   }
}

void DrawCachedEntryZones()
{
   if(!ShowChartGraphics) return;

   double atr = 0.0;
   if(atrHandle != INVALID_HANDLE)
   {
      double atrBuf[];
      ArraySetAsSeries(atrBuf, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, atrBuf) >= 1) atr = atrBuf[0];
   }
   if(atr <= 0) return;

   datetime now = TimeCurrent();
   int barSec = PeriodSeconds();

   // Zone BUY
   if(g_cachedBestBuyLevel > 0)
   {
      string name = "SMC_CachedBuyZone";
      double upper = g_cachedBestBuyLevel + atr * 0.1;
      double lower = g_cachedBestBuyLevel - atr * 0.1;
      ObjectCreate(0, name, OBJ_RECTANGLE, 0, now - barSec * 20, lower, now + barSec * 50, upper);
      ObjectSetInteger(0, name, OBJPROP_COLOR, clrDodgerBlue);
      ObjectSetInteger(0, name, OBJPROP_FILL, true);
      ObjectSetInteger(0, name, OBJPROP_BACK, true);
      ObjectSetInteger(0, name, OBJPROP_WIDTH, 1);
      ObjectSetString(0, name, OBJPROP_TEXT, "BUY zone [" + g_cachedBuySource + "]");
   }

   // Zone SELL
   if(g_cachedBestSellLevel > 0)
   {
      string name = "SMC_CachedSellZone";
      double upper = g_cachedBestSellLevel + atr * 0.1;
      double lower = g_cachedBestSellLevel - atr * 0.1;
      ObjectCreate(0, name, OBJ_RECTANGLE, 0, now - barSec * 20, lower, now + barSec * 50, upper);
      ObjectSetInteger(0, name, OBJPROP_COLOR, clrCrimson);
      ObjectSetInteger(0, name, OBJPROP_FILL, true);
      ObjectSetInteger(0, name, OBJPROP_BACK, true);
      ObjectSetInteger(0, name, OBJPROP_WIDTH, 1);
      ObjectSetString(0, name, OBJPROP_TEXT, "SELL zone [" + g_cachedSellSource + "]");
   }
}

//| GESTION DES POSITIONS ET VARIABLES GLOBALES                    |

// Vrai si ce symbole a subi une perte rÃ©cente (SL ou autre) â†’ rÃ©entrÃ©e soumise Ã  conditions strictes
bool IsRecentLossOnSymbol(const string symbol)
{
   if(g_lastLossSymbol == "" || symbol == "") return false;
   if(g_lastLossSymbol != symbol) return false;
   return (TimeCurrent() - g_lastLossTime <= LossCooldownMinutes * 60);
}

// Vrai si ce symbole a eu un gain rÃ©cent â†’ rÃ©entrÃ©e soumise Ã  cooldown (demande Sidoine)
bool IsRecentGainOnSymbol(const string symbol)
{
   if(!UseGainCooldown) return false;
   if(g_lastGainSymbol == "" || symbol == "")
   {
      static datetime s_debugLog = 0;
      if(TimeCurrent() - s_debugLog >= 60)
      {
         Print("[GAIN-COOLDOWN-DEBUG] g_lastGainSymbol='", g_lastGainSymbol, "' symbol='", symbol, "' UseGainCooldown=", UseGainCooldown);
         s_debugLog = TimeCurrent();
      }
      return false;
   }
   if(g_lastGainSymbol != symbol)
   {
      static datetime s_debugLog2 = 0;
      if(TimeCurrent() - s_debugLog2 >= 60)
      {
         Print("[GAIN-COOLDOWN-DEBUG] Symbole diffÃ©rent: g_lastGainSymbol='", g_lastGainSymbol, "' vs symbol='", symbol, "'");
         s_debugLog2 = TimeCurrent();
      }
      return false;
   }

   int elapsed = (int)(TimeCurrent() - g_lastGainTime);
   int cooldownSec = GainCooldownMinutes * 60;
   bool inCooldown = (elapsed <= cooldownSec);

   static datetime s_debugLog3 = 0;
   if(TimeCurrent() - s_debugLog3 >= 30)
   {
      Print("[GAIN-COOLDOWN-DEBUG] ", symbol, " | Ã‰coulÃ©: ", elapsed, "s | Cooldown: ", cooldownSec, "s | En cooldown: ", inCooldown);
      s_debugLog3 = TimeCurrent();
   }

   return inCooldown;
}

// Autorise ou bloque une rÃ©entrÃ©e aprÃ¨s perte rÃ©cente sur ce symbole.
// spikeImminent: vrai si le contexte actuel indique un spike / setup exceptionnel (dÃ©jÃ  calculÃ© par l'appelant).
bool AllowReentryAfterRecentLoss(const string symbol, const string direction, bool spikeImminent)
{
   // Mode patient aprÃ¨s 2 pertes: bloquer TOUT signal normal
   if(SMC_DoubleLossPatientBlocks(symbol))
   {
      Print("ðŸš« RÃ©entrÃ©e PATIENT FVG â€” ", symbol,
            " | ", g_symConsecLosses, " pertes â€” attendre FVG_TRAIL react ou spike GOM_TF_TL_M5");
      return false;
   }

   if(!IsRecentLossOnSymbol(symbol)) return true;

   string dir = direction;
   StringToUpper(dir);

   double conf = g_lastAIConfidence;
   bool iaStrong = (conf >= 0.90) &&
                   (g_lastAIAction == "BUY" || g_lastAIAction == "buy" ||
                    g_lastAIAction == "SELL" || g_lastAIAction == "sell");

   if(!spikeImminent)
   {
      double p = CalculateSpikeProbability();
      spikeImminent = (p >= 0.80);
   }

   if(iaStrong && spikeImminent)
   {
      Print("âœ… RÃ©entrÃ©e aprÃ¨s perte autorisÃ©e sur ", symbol,
            " - conf IA ", DoubleToString(conf*100, 1), "% + spike fort");
      return true;
   }

   Print("ðŸš« RÃ©entrÃ©e aprÃ¨s perte sur ", symbol, " bloquÃ©e");
   return false;
}

void SMC_RecordSymbolTradeResult(const string symbol, const double profit)
{
   if(symbol == "") return;
   if(profit < 0.0)
   {
      if(g_symLossSymbol == symbol)
         g_symConsecLosses++;
      else
      {
         g_symLossSymbol   = symbol;
         g_symConsecLosses = 1;
      }
      g_symLastLossTime = TimeCurrent();
      Print("ðŸ“‰ Perte #", g_symConsecLosses, " sur ", symbol,
            (g_symConsecLosses >= DoubleLossThreshold ? " â†’ MODE PATIENT FVG TRAIL armÃ©" : ""),
            (g_symConsecLosses >= g_lossRecoverMinLosses ? " â†’ MODE LOSS RECOVER armÃ©" : ""));
      if(UseDoubleLossFVGTrail && g_symConsecLosses >= DoubleLossThreshold)
         SMC_ArmFVGTrailPatient(symbol);
      // FIX v1.30: Activer Loss Recover aprÃ¨s 2 pertes pour autoriser BUY sur PainX/SELL sur GainX
      if(g_symConsecLosses >= g_lossRecoverMinLosses)
      {
         g_lossRecoverArmed = true;
         g_lossRecoverSymbol = symbol;
         g_lossRecoverSince = TimeCurrent();
         Print("ðŸ”„ LOSS RECOVER ACTIVÃ‰ sur ", symbol, " - BUY sur PainX/SELL sur GainX autorisÃ©s");
      }
   }
   else if(g_symLossSymbol == symbol)
   {
      if(g_fvgTrailPatientArmed)
         SMC_DisarmFVGTrailPatient("gain sur " + symbol);
      // FIX v1.30: DÃ©sactiver Loss Recover aprÃ¨s gain
      if(g_lossRecoverArmed)
      {
         g_lossRecoverArmed = false;
         g_lossRecoverSymbol = "";
         g_lossRecoverSince = 0;
         Print("âœ… LOSS RECOVER DÃ‰SACTIVÃ‰ sur ", symbol, " - gain dÃ©tectÃ©");
      }
      g_symLossSymbol   = "";
      g_symConsecLosses = 0;
      g_symLastLossTime = 0;
   }
}

bool SMC_DoubleLossPatientBlocks(const string symbol)
{
   if(!UseDoubleLossFVGTrail) return false;
   if(!g_fvgTrailPatientArmed) return false;
   if(g_symLossSymbol != symbol) return false;
   if(g_symConsecLosses < DoubleLossThreshold) return false;
   if(g_fvgTrailPatientSince > 0 &&
      (TimeCurrent() - g_fvgTrailPatientSince) > FVGTrailPatientMaxMin * 60)
   {
      SMC_DisarmFVGTrailPatient("timeout patient");
      return false;
   }
   int native = 0;
   if(IsBoomLikeSymbol(symbol)) native = 1;
   else if(IsCrashLikeSymbol(symbol)) native = -1;
   if(native != 0 && SMCGP_SpikeFireAllowed(symbol, native))
      return false;
   return true;
}

// FIX v1.30: VÃ©rification des conditions strictes pour Loss Recover
// Conditions requises:
// - GOM PERFECT (|vn| >= 2)
// - Au moins 3 timeframes alignÃ©s (M1, M5, M15, H1)
// - Prix loin des rÃ©sistances/20-bar/pivots (BUY: loin rÃ©sistances, SELL: loin supports)
bool SMC_LossRecoverConditionsOK(const string symbol, const int dirSign)
{
   if(!g_lossRecoverArmed || g_lossRecoverSymbol != symbol)
      return false;

   // 1) VÃ©rifier timeout Loss Recover
   if(g_lossRecoverSince > 0 &&
      (TimeCurrent() - g_lossRecoverSince) > g_lossRecoverMaxMin * 60)
   {
      g_lossRecoverArmed = false;
      g_lossRecoverSymbol = "";
      g_lossRecoverSince = 0;
      Print("â±ï¸ LOSS RECOVER TIMEOUT - dÃ©sactivÃ© sur ", symbol);
      return false;
   }

   // 2) VÃ©rifier GOM GOOD/PERFECT requis
   int vnRec = g_smcGomVerdictNum;
   if(MathAbs(vnRec) < 2) vnRec = g_smcGomVerdictNumServer;
   if(MathAbs(vnRec) < 2)
   {
      Print("âŒ LOSS RECOVER - GOM pas GOOD/PERFECT (vn=", g_smcGomVerdictNum, ")");
      return false;
   }

   // 3) VÃ©rifier alignement direction GOM
   if((dirSign > 0 && vnRec <= 0) ||
      (dirSign < 0 && vnRec >= 0))
   {
      Print("âŒ LOSS RECOVER - GOM oppose Ã  direction");
      return false;
   }

   // 4) VÃ©rifier alignement minimum 3 timeframes
   string m1Dir = (StringLen(g_smcTfM1DirLive) > 0) ? g_smcTfM1DirLive : g_smcTfM1Dir;
   string m5Dir = g_smcTfM5Dir;
   string m15Dir = g_smcTfM15Dir;
   string h1Dir = g_smcTfH1Dir;

   int alignedCount = 0;
   if(SMC_TfDirMatchesSign(dirSign, m1Dir)) alignedCount++;
   if(SMC_TfDirMatchesSign(dirSign, m5Dir)) alignedCount++;
   if(SMC_TfDirMatchesSign(dirSign, m15Dir)) alignedCount++;
   if(SMC_TfDirMatchesSign(dirSign, h1Dir)) alignedCount++;

   if(alignedCount < 3)
   {
      Print("âŒ LOSS RECOVER - Timeframes alignÃ©s: ", alignedCount, "/4 (min 3 requis)");
      return false;
   }

   // 5) VÃ©rifier distance par rapport aux rÃ©sistances/ supports/ pivots
   double currentPrice = SymbolInfoDouble(symbol, SYMBOL_BID);
   double atr = 0.0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[];
      ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1)
         atr = ab[0];
   }
   if(atr <= 0.0)
      atr = SymbolInfoDouble(symbol, SYMBOL_POINT) * 50.0;
   double minDist = atr * 0.5; // Distance minimum: 0.5 ATR

   // Pour BUY: vÃ©rifier distance aux rÃ©sistances (20-bar, pivot high)
   if(dirSign > 0)
   {
      double resistance20 = GetResistanceLevel(20);
      if(resistance20 > 0 && (resistance20 - currentPrice) < minDist)
      {
         Print("âŒ LOSS RECOVER - Trop proche rÃ©sistance 20-bar (dist=",
               DoubleToString(resistance20 - currentPrice, 2), ")");
         return false;
      }

      // VÃ©rifier pivot high proche
      MqlRates rates[];
      ArraySetAsSeries(rates, true);
      if(CopyRates(symbol, PERIOD_M5, 0, 25, rates) >= 20)
      {
         for(int i = 2; i < 18; i++)
         {
            if(rates[i].high > rates[i-1].high && rates[i].high > rates[i+1].high &&
               rates[i].high > rates[i-2].high && rates[i].high > rates[i+2].high)
            {
               if((rates[i].high - currentPrice) < minDist)
               {
                  Print("âŒ LOSS RECOVER - Trop proche pivot high (dist=",
                        DoubleToString(rates[i].high - currentPrice, 2), ")");
                  return false;
               }
            }
         }
      }
   }
   // Pour SELL: vÃ©rifier distance aux supports (20-bar, pivot low)
   else if(dirSign < 0)
   {
      double support20 = GetSupportLevel(20);
      if(support20 > 0 && (currentPrice - support20) < minDist)
      {
         Print("âŒ LOSS RECOVER - Trop proche support 20-bar (dist=",
               DoubleToString(currentPrice - support20, 2), ")");
         return false;
      }

      // VÃ©rifier pivot low proche
      MqlRates rates[];
      ArraySetAsSeries(rates, true);
      if(CopyRates(symbol, PERIOD_M5, 0, 25, rates) >= 20)
      {
         for(int i = 2; i < 18; i++)
         {
            if(rates[i].low < rates[i-1].low && rates[i].low < rates[i+1].low &&
               rates[i].low < rates[i-2].low && rates[i].low < rates[i+2].low)
            {
               if((currentPrice - rates[i].low) < minDist)
               {
                  Print("âŒ LOSS RECOVER - Trop proche pivot low (dist=",
                        DoubleToString(currentPrice - rates[i].low, 2), ")");
                  return false;
               }
            }
         }
      }
   }

   Print("âœ… LOSS RECOVER - Conditions OK sur ", symbol,
         " | TF alignÃ©s: ", alignedCount, "/4 | GOM PERFECT | Distance OK");
   return true;
}

void SMC_ArmFVGTrailPatient(const string symbol)
{
   g_fvgTrailPatientArmed  = true;
   g_fvgTrailPatientSince  = TimeCurrent();
   g_fvgTrailTouched       = false;
   g_fvgTrailTouchDir      = 0;
   g_fvgTrailTouchTime     = 0;
   Print("â³ MODE PATIENT FVG TRAIL armÃ© sur ", symbol,
         " | pertes=", g_symConsecLosses,
         " | FVG react OU (si cassure) spike GOM_TF_TL_M5 uniquement");
}

void SMC_DisarmFVGTrailPatient(const string reason)
{
   if(!g_fvgTrailPatientArmed) return;
   Print("âœ… MODE PATIENT FVG TRAIL dÃ©sarmÃ© â€” ", reason);
   g_fvgTrailPatientArmed = false;
   g_fvgTrailPatientSince = 0;
   g_fvgTrailTouched      = false;
   g_fvgTrailTouchDir     = 0;
   g_fvgTrailTouchTime    = 0;
}

bool SMC_GetNearestFVGTrail(const int dirSign, double &midOut, double &botOut, double &topOut)
{
   midOut = 0; botOut = 0; topOut = 0;
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   if(bid <= 0) return false;
   if(dirSign > 0 && g_fvgTrailBullMid > 0)
   {
      midOut = g_fvgTrailBullMid; botOut = g_fvgTrailBullBot; topOut = g_fvgTrailBullTop;
      return true;
   }
   if(dirSign < 0 && g_fvgTrailBearMid > 0)
   {
      midOut = g_fvgTrailBearMid; botOut = g_fvgTrailBearBot; topOut = g_fvgTrailBearTop;
      return true;
   }
   double bestDist = 1e100;
   string prefix = (dirSign > 0) ? "SMC_DISP_FVG_TRAIL_Bull_" : "SMC_DISP_FVG_TRAIL_Bear_";
   int total = ObjectsTotal(0, 0, -1);
   for(int i = 0; i < total; i++)
   {
      string name = ObjectName(0, i, 0, -1);
      if(StringFind(name, prefix) != 0) continue;
      double p1 = ObjectGetDouble(0, name, OBJPROP_PRICE, 0);
      if(p1 <= 0) continue;
      double d = MathAbs(bid - p1);
      if(d < bestDist) { bestDist = d; midOut = p1; botOut = p1; topOut = p1; }
   }
   return (midOut > 0);
}

void SMC_ManageDoubleLossFVGTrailEntry()
{
   if(!UseDoubleLossFVGTrail) return;
   if(!g_fvgTrailPatientArmed) return;
   if(g_symLossSymbol != _Symbol) return;
   if(BlockAllTrades) return;

   // FIX v1.34: BLOQUER si verdict est WAIT
   if(g_smcGomVerdictNum == 0) return;

   if(g_fvgTrailPatientSince > 0 &&
      (TimeCurrent() - g_fvgTrailPatientSince) > FVGTrailPatientMaxMin * 60)
   {
      SMC_DisarmFVGTrailPatient("timeout " + IntegerToString(FVGTrailPatientMaxMin) + " min");
      return;
   }
   if(g_fvgTrailLastEntryTime > 0 &&
      (TimeCurrent() - g_fvgTrailLastEntryTime) < FVGTrailEntryCooldownSec)
      return;
   if(CountPositionsForSymbol(_Symbol) > 0) return;

   bool isBoom  = IsBoomLikeSymbol(_Symbol);
   bool isCrash = IsCrashLikeSymbol(_Symbol);
   int  dirSign = 0;
   if(isBoom)  dirSign = 1;
   else if(isCrash) dirSign = -1;
   else if(g_smcGomConnected && MathAbs(g_smcGomVerdictNum) >= MinGOMVerdictNumAbs)
      dirSign = (g_smcGomVerdictNum > 0) ? 1 : -1;
   if(dirSign == 0) return;

   if(FVGTrailRequireGOMGood)
   {
      if(!g_smcGomConnected || MathAbs(g_smcGomVerdictNum) < MinGOMVerdictNumAbs)
         return;
      if((dirSign > 0 && g_smcGomVerdictNum < 0) || (dirSign < 0 && g_smcGomVerdictNum > 0))
         return;
   }

   double atrVal = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double ab[];
      ArraySetAsSeries(ab, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atrVal = ab[0];
   }
   if(atrVal <= 0) atrVal = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 50.0;

   double mid = 0, bot = 0, top = 0;
   if(!SMC_GetNearestFVGTrail(dirSign, mid, bot, top))
      return;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double px  = (bid + ask) * 0.5;
   double touchDist = atrVal * FVGTrailTouchATRMult;
   double reactDist = atrVal * FVGTrailReactATRMult;

   bool inZone = false;
   if(bot > 0 && top > bot)
      inZone = (px >= bot - touchDist && px <= top + touchDist);
   else
      inZone = (MathAbs(px - mid) <= touchDist);

   // Cassure FVG sans rÃ©action = forte correction â†’ aucune initiative
   static bool s_fvgBrokenNoReact = false;
   static datetime s_fvgBrokenTime = 0;

   bool brokenDown = false, brokenUp = false;
   if(dirSign > 0)
      brokenDown = (px < ((bot > 0) ? bot : mid) - touchDist);
   else
      brokenUp = (px > ((top > 0) ? top : mid) + touchDist);

   if((brokenDown || brokenUp) && !g_fvgTrailTouched)
   {
      if(!s_fvgBrokenNoReact)
      {
         s_fvgBrokenNoReact = true;
         s_fvgBrokenTime = TimeCurrent();
         Print("â›” FVG TRAIL CASSÃ‰ sans rÃ©action â€” ", _Symbol,
               " | forte correction | AUCUNE entrÃ©e | observer spike GOM_TF_TL_M5");
      }
   }
   else if(inZone)
      s_fvgBrokenNoReact = false;

   if(inZone && !g_fvgTrailTouched && !s_fvgBrokenNoReact)
   {
      g_fvgTrailTouched = true;
      g_fvgTrailTouchDir = dirSign;
      g_fvgTrailTouchTime = TimeCurrent();
      Print("ðŸ“ FVG TRAIL TOUCHÃ‰ â€” ", _Symbol, " | mid=", DoubleToString(mid, _Digits),
            " | attendre rÃ©action (sinon â†’ GOM_TF_TL_M5)");
      return;
   }

   if(g_fvgTrailTouched && g_fvgTrailTouchTime > 0 &&
      (TimeCurrent() - g_fvgTrailTouchTime) > 120)
   {
      if(!inZone)
      {
         s_fvgBrokenNoReact = true;
         s_fvgBrokenTime = TimeCurrent();
         Print("â›” FVG TRAIL touch sans rÃ©action â€” correction | observer GOM_TF_TL_M5");
      }
      g_fvgTrailTouched = false;
      g_fvgTrailTouchDir = 0;
      g_fvgTrailTouchTime = 0;
   }

   bool fvgReacted = false;
   if(g_fvgTrailTouched && g_fvgTrailTouchDir == dirSign && !s_fvgBrokenNoReact)
   {
      MqlRates r[];
      ArraySetAsSeries(r, true);
      if(CopyRates(_Symbol, PERIOD_M1, 0, 3, r) >= 2)
      {
         if(dirSign > 0)
            fvgReacted = (px >= mid + reactDist) || (r[0].close > r[0].open && r[0].close > mid) ||
                         ((bot > 0) ? (px > top) : (px > mid + reactDist * 0.5));
         else
            fvgReacted = (px <= mid - reactDist) || (r[0].close < r[0].open && r[0].close < mid) ||
                         ((top > 0) ? (px < bot) : (px < mid - reactDist * 0.5));
      }
   }

   // Spike rÃ©action sur GOM_TF_TL_M5 (surtout aprÃ¨s cassure)
   bool m5TlSpikeReact = false;
   double m5TlLevel = 0.0;
   string tlNames[6];
   tlNames[0] = "GOM_TF_TL_M5";
   tlNames[1] = "GOM_TF_TL_M5_" + _Symbol;
   tlNames[2] = "GOM_TL_M5";
   tlNames[3] = "TF_TL_M5";
   tlNames[4] = "GOM_TF_TL_M5_SUP";
   tlNames[5] = "GOM_TF_TL_M5_RES";
   for(int ti = 0; ti < 6; ti++)
   {
      if(ObjectFind(0, tlNames[ti]) < 0) continue;
      double p0 = ObjectGetDouble(0, tlNames[ti], OBJPROP_PRICE, 0);
      double p1 = ObjectGetDouble(0, tlNames[ti], OBJPROP_PRICE, 1);
      if(p0 > 0) { m5TlLevel = p0; break; }
      if(p1 > 0) { m5TlLevel = p1; break; }
   }
   if(m5TlLevel <= 0)
   {
      int total = ObjectsTotal(0, 0, -1);
      for(int i = 0; i < total; i++)
      {
         string name = ObjectName(0, i, 0, -1);
         if(StringFind(name, "GOM_TF_TL_M5") < 0 && StringFind(name, "TF_TL_M5") < 0) continue;
         double p0 = ObjectGetDouble(0, name, OBJPROP_PRICE, 0);
         if(p0 > 0) { m5TlLevel = p0; break; }
      }
   }
   if(m5TlLevel <= 0)
   {
      int emaH = iMA(_Symbol, PERIOD_M5, 21, 0, MODE_EMA, PRICE_CLOSE);
      if(emaH != INVALID_HANDLE)
      {
         double eb[];
         ArraySetAsSeries(eb, true);
         if(CopyBuffer(emaH, 0, 0, 1, eb) >= 1) m5TlLevel = eb[0];
      }
   }

   if(m5TlLevel > 0)
   {
      bool nearTL = (MathAbs(px - m5TlLevel) <= atrVal * 0.35);
      MqlRates m1r[], m5r[];
      ArraySetAsSeries(m1r, true);
      ArraySetAsSeries(m5r, true);
      bool spikeBar = false;
      if(CopyRates(_Symbol, PERIOD_M1, 0, 5, m1r) >= 3)
      {
         double body = MathAbs(m1r[0].close - m1r[0].open);
         double rng  = m1r[0].high - m1r[0].low;
         double avgBody = 0;
         for(int k = 1; k < 4; k++) avgBody += MathAbs(m1r[k].close - m1r[k].open);
         avgBody /= 3.0;
         bool bigBody = (avgBody > 0 && body >= avgBody * 1.6) || (rng >= atrVal * 0.8);
         bool dirOk = (dirSign > 0 && m1r[0].close > m1r[0].open) ||
                      (dirSign < 0 && m1r[0].close < m1r[0].open);
         spikeBar = bigBody && dirOk;
      }
      bool rejectTL = false;
      if(nearTL && CopyRates(_Symbol, PERIOD_M5, 0, 3, m5r) >= 2)
      {
         if(dirSign > 0)
            rejectTL = (m5r[0].low <= m5TlLevel + atrVal * 0.15) &&
                       (m5r[0].close > m5TlLevel) && (m5r[0].close > m5r[0].open);
         else
            rejectTL = (m5r[0].high >= m5TlLevel - atrVal * 0.15) &&
                       (m5r[0].close < m5TlLevel) && (m5r[0].close < m5r[0].open);
      }
      m5TlSpikeReact = nearTL && (spikeBar || rejectTL);
      if(s_fvgBrokenNoReact && m5TlSpikeReact)
         Print("âš¡ SPIKE GOM_TF_TL_M5 â€” ", _Symbol, " | TL=", DoubleToString(m5TlLevel, _Digits),
               " | aprÃ¨s cassure FVG â†’ entrÃ©e 2e spike");
   }

   // A) FVG react  B) cassÃ© + spike TL M5  C) sinon silence
   bool allowEntry = false;
   string entryWhy = "";
   if(fvgReacted)
   {
      allowEntry = true;
      entryWhy = "FVG-TRAIL react";
   }
   else if(m5TlSpikeReact && s_fvgBrokenNoReact)
   {
      allowEntry = true;
      entryWhy = "GOM_TF_TL_M5 spike";
      s_fvgBrokenNoReact = false;
   }
   else
      return;

   string direction = (dirSign > 0) ? "BUY" : "SELL";
   if(!IsDirectionAllowedForBoomCrash(_Symbol, direction)) return;
   if(!CanTradeOnSymbol(_Symbol, direction)) return;
   if(!CanPlaceMarketOrder(_Symbol, dirSign)) return;
   if(!TryAcquireOpenLock()) return;

   double lot = CalculateLotSize();
   if(lot <= 0) { ReleaseOpenLock(); return; }

   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double slDist = atrVal * MathMax(1.5, SL_ATRMult * 0.8);
   double tpDist = slDist * (UseSniperScalperMode ? MinRewardRiskRatio : 2.5);
   if(UseSniperScalperMode)
   {
      double tpAdj = tpDist;
      if(!SMC_ApplySniperRiskCap(_Symbol, slDist, lot, tpAdj))
      { ReleaseOpenLock(); return; }
      tpDist = tpAdj;
   }

   bool ok = false;
   string cmt = "FVG-TRAIL 2ndSPIKE " + entryWhy + " " + direction;
   if(dirSign > 0)
   {
      double sl = NormalizeDouble(ask - slDist, dg);
      double tp = NormalizeDouble(ask + tpDist, dg);
      if(!SMC_FinalOpenGate(_Symbol, ORDER_TYPE_BUY)) { ReleaseOpenLock(); return; }
      ok = SafeTradeBuy(lot, _Symbol, ask, sl, tp, cmt);
      if(ok) SMC_GateRegisterOpened(_Symbol, true);
   }
   else
   {
      double sl = NormalizeDouble(bid + slDist, dg);
      double tp = NormalizeDouble(bid - tpDist, dg);
      if(!SMC_FinalOpenGate(_Symbol, ORDER_TYPE_SELL)) { ReleaseOpenLock(); return; }
      ok = SafeTradeSell(lot, _Symbol, bid, sl, tp, cmt);
      if(ok) SMC_GateRegisterOpened(_Symbol, false);
   }

   if(ok)
   {
      RegisterOrderPlaced();
      g_fvgTrailLastEntryTime = TimeCurrent();
      ulong ticket = trade.ResultOrder();
      if(ticket > 0) SMC_ApplyPostEntrySLBuffer(_Symbol, ticket, 1.0);
      Print("ðŸš€ ", cmt, " ", _Symbol,
            " @", DoubleToString(dirSign > 0 ? ask : bid, dg),
            " | FVG mid=", DoubleToString(mid, dg),
            " | M5 TL=", DoubleToString(m5TlLevel, dg),
            " | GOM vn=", g_smcGomVerdictNum);
      if(UseNotifications)
         SendNotification(cmt + " " + _Symbol);
      SMC_DisarmFVGTrailPatient("entrÃ©e 2e spike (" + entryWhy + ")");
      g_symConsecLosses = 0;
      g_symLossSymbol = "";
      s_fvgBrokenNoReact = false;
   }
   ReleaseOpenLock();
}

void SMC_TryLossRecoverNativeEntry()
{
   if(!g_lossRecoverArmed) return;
   if(g_lossRecoverSymbol != _Symbol) return;
   if(CountPositionsForSymbol(_Symbol) > 0) return;
   if(IsTerminalFull()) return;

   int dirSign = 0;
   if(IsBoomLikeSymbol(_Symbol)) dirSign = 1;
   else if(IsCrashLikeSymbol(_Symbol)) dirSign = -1;
   else return;

   if(g_lossRecoverSince > 0 &&
      (TimeCurrent() - g_lossRecoverSince) > g_lossRecoverMaxMin * 60)
   {
      g_lossRecoverArmed = false;
      g_lossRecoverSymbol = "";
      g_lossRecoverSince = 0;
      Print("â±ï¸ LOSS RECOVER TIMEOUT â€” ", _Symbol);
      return;
   }

   if(!SMCGP_SpikeFireAllowed(_Symbol, dirSign))
      return;

   static datetime s_lastRecov = 0;
   if(TimeCurrent() - s_lastRecov < 20) return;
   s_lastRecov = TimeCurrent();

   Print("ðŸ”„ LOSS RECOVER â€” relance native ", (dirSign > 0 ? "BUY" : "SELL"),
         " ", _Symbol, " | pertes=", g_symConsecLosses,
         " | GOM GOOD/PERFECT + M1/M5/M15");
   ExecuteSpikeTrade(dirSign > 0 ? "BUY" : "SELL");
}

// Lot minimal par dÃ©faut: 0.5 pour Boom 300 / Crash 300, sinon min du courtier
double GetMinLotForSymbol(const string symbol)
{
   if(StringFind(symbol, "Boom 300") >= 0 || StringFind(symbol, "Crash 300") >= 0)
      return 0.5;
   return SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
}

// Recovery: aprÃ¨s une perte sur un symbole, le prochain signal sur un AUTRE symbole peut doubler le lot (une seule fois)
double ApplyRecoveryLot(double baseLot)
{
   bool recoverHere = (g_lossRecoverArmed && g_lossRecoverSymbol == _Symbol && g_symConsecLosses >= 1);
   if(!EnableLossRecoveryLot && !recoverHere) return baseLot;
   if(!recoverHere && (g_lastLossSymbol == "" || g_lastLossSymbol == _Symbol))
      return baseLot;
   double minL = GetMinLotForSymbol(_Symbol);
   double maxL = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double recoveryLot = MathMin(maxL, 2.0 * minL);
   recoveryLot = NormalizeVolumeForSymbol(recoveryLot);
   if(recoveryLot < minL) recoveryLot = minL;
   string lostSym = recoverHere ? g_lossRecoverSymbol : g_lastLossSymbol;
   if(!recoverHere)
   {
      g_lastLossSymbol = "";
      g_lastLossTime   = 0;
   }
   Print("ðŸ“ˆ RECOVERY - Lot ", DoubleToString(recoveryLot, 2), " sur ", _Symbol,
         " pour compenser perte(s) sur ", lostSym,
         recoverHere ? " (mÃªme symbole, 2+ pertes)" : "");
   return recoveryLot;
}

// VÃ©rifie si, pour ce symbole, la dÃ©cision IA est suffisamment forte
// ET alignÃ©e en direction (jamais contre-tendance IA) pour autoriser
// l'ouverture d'une nouvelle position (hors Boom/Crash).
bool IsAITradeAllowedForDirection(const string direction)
{
   if(!UseAIServer) return true; // Pas d'IA requise si serveur dÃ©sactivÃ©
   
   ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(_Symbol);
   // Sur Boom/Crash, on garde la logique actuelle DERIV ARROW + rÃ¨gles spÃ©cifiques
   if(cat == SYM_BOOM_CRASH) return true;
   
   // Seuil FIXE Ã  65% pour les autres symboles :
   // on ne trade QUE si l'IA est BUY ou SELL avec confiance suffisante.
   double minConf = 0.65;
   if(g_lastAIAction == "" || g_lastAIConfidence < minConf)
   {
      Print("ðŸš« TRADE BLOQUÃ‰ - Pas de dÃ©cision IA forte (conf: ",
            DoubleToString(g_lastAIConfidence*100, 1), "% < ",
            DoubleToString(minConf*100, 1), "%) sur ", _Symbol);
      return false;
   }
   
   if(g_lastAIAction == "HOLD" || g_lastAIAction == "hold")
   {
      Print("ðŸš« TRADE BLOQUÃ‰ - IA en HOLD sur ", _Symbol, " (", DoubleToString(g_lastAIConfidence*100,1), "%)");
      return false;
   }

   // Ne jamais trader CONTRE la direction IA:
   // - Si IA = BUY, seules les entrÃ©es BUY sont autorisÃ©es
   // - Si IA = SELL, seules les entrÃ©es SELL sont autorisÃ©es
   string iaDir = g_lastAIAction;
   StringToUpper(iaDir);

   // On ne laisse trader que si l'IA est clairement BUY ou SELL
   if(iaDir != "BUY" && iaDir != "SELL")
   {
      Print("ðŸš« TRADE BLOQUÃ‰ - DÃ©cision IA non directionnelle (", iaDir,
            ") ou incompatible pour ", _Symbol,
            " (conf: ", DoubleToString(g_lastAIConfidence*100,1), "%)");
      return false;
   }

   string dir = direction;
   StringToUpper(dir);

   if((iaDir == "BUY"  && dir != "BUY") ||
      (iaDir == "SELL" && dir != "SELL"))
   {
      Print("ðŸš« TRADE BLOQUÃ‰ - Direction '", dir,
            "' contraire au signal IA '", iaDir,
            "' (conf: ", DoubleToString(g_lastAIConfidence*100,1), "%) sur ", _Symbol);
      return false;
   }

   return true;
}

