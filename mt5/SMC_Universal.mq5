//+------------------------------------------------------------------+
//| GOM Immediate Market + Retrace State Machine (tick handler)
//| - Met a jour les trackers de confirmation M1
//| - Gere la sortie par timeout (pas de spike / pas de confirmation)
//+------------------------------------------------------------------+

//+------------------------------------------------------------------+
//| v1.34: MARKET sur GOOD/PERFECT + M5 confirmÃ©e + niveau touchÃ©     |
//| Quand le dashboard clignote ENTER BUY/SELL et le prix touche une  |
//| zone (DOW EP / SR / GOM TL), on entre au marchÃ©.                   |
//+------------------------------------------------------------------+
bool TryExecuteGOMPerfectEntry()
{
   if(!GOMPerfectAutoEntry) return false;
   if(!g_smcGomConnected) return false;
   if(MathAbs(g_smcGomVerdictNum) < 2) return false; // GOOD ou PERFECT
   if(IsTerminalFull()) return false;
   if(CountPositionsOurEA() >= MaxPositionsTerminal) return false;
   if(CountPositionsForSymbol(_Symbol) > 0) return false;

   string src = g_smcGomSource;
   StringToUpper(src);
   if(StringFind(src, "CACHE_STALE") >= 0 || StringFind(src, "NO_HTTP") >= 0)
      return false;
   if(g_smcLastGOMPoll > 0 && (TimeCurrent() - g_smcLastGOMPoll) > 120)
      return false;

   int dirSign = (g_smcGomVerdictNum > 0) ? 1 : -1;
   string wantDir = (dirSign > 0) ? "BUY" : "SELL";

   // M5 clÃ´turÃ©e dans le sens â€” obligatoire
   if(!SMC_HasM5Confirmation(_Symbol, dirSign))
   {
      static datetime s_m5w = 0;
      if(TimeCurrent() - s_m5w >= 30)
      {
         s_m5w = TimeCurrent();
         Print("[GOM-PERFECT] attente M5 clÃ´turÃ©e ", wantDir, " | vn=", g_smcGomVerdictNum);
      }
      return false;
   }

   // Prix proche d'un niveau d'entrÃ©e (SMC / DOW / setup)
   string levelName = "";
   bool atLevel = SMC_IsAtValidSMCLevel(_Symbol, dirSign, levelName);
   // PERFECT (|vn|>=3) : tolÃ©rance Ã©largie â€” si setup TV valide dans le mÃªme sens
   if(!atLevel && MathAbs(g_smcGomVerdictNum) >= 3 && g_smcSetupValid)
   {
      double entry = g_smcSetupEntry;
      double price = (dirSign > 0) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK)
                                  : SymbolInfoDouble(_Symbol, SYMBOL_BID);
      double atr = 0;
      int hAtr = iATR(_Symbol, PERIOD_M5, 14);
      if(hAtr != INVALID_HANDLE)
      {
         double b[]; ArraySetAsSeries(b, true);
         if(CopyBuffer(hAtr, 0, 0, 1, b) >= 1) atr = b[0];
         IndicatorRelease(hAtr);
      }
      if(atr <= 0) atr = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 100;
      if(entry > 0 && MathAbs(price - entry) <= atr * 0.35)
      {
         atLevel = true;
         levelName = "GOM Setup Entry";
      }
   }
   // GOOD: aussi autoriser si proche du bid/ask rÃ©cent swing dans le sens (0.25 ATR)
   if(!atLevel)
   {
      MqlRates r[]; ArraySetAsSeries(r, true);
      if(CopyRates(_Symbol, PERIOD_M5, 0, 15, r) >= 10)
      {
         double price = (dirSign > 0) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK)
                                     : SymbolInfoDouble(_Symbol, SYMBOL_BID);
         double atr = MathMax(r[1].high - r[1].low, SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10);
         if(dirSign > 0)
         {
            double swingLow = r[2].low;
            for(int i = 3; i < 12; i++) if(r[i].low < swingLow) swingLow = r[i].low;
            if(MathAbs(price - swingLow) <= atr * 0.40)
            { atLevel = true; levelName = "M5 Swing Low"; }
         }
         else
         {
            double swingHigh = r[2].high;
            for(int i = 3; i < 12; i++) if(r[i].high > swingHigh) swingHigh = r[i].high;
            if(MathAbs(price - swingHigh) <= atr * 0.40)
            { atLevel = true; levelName = "M5 Swing High"; }
         }
      }
   }
   if(!atLevel)
   {
      static datetime s_lv = 0;
      if(TimeCurrent() - s_lv >= 45)
      {
         s_lv = TimeCurrent();
         Print("[GOM-PERFECT] niveau non touchÃ© â€” attente pullback | ", wantDir,
               " vn=", g_smcGomVerdictNum);
      }
      return false;
   }

   // Cooldown anti-spam
   static datetime s_lastPerfectEntry = 0;
   static string   s_lastPerfectSym = "";
   if(s_lastPerfectSym == _Symbol && (TimeCurrent() - s_lastPerfectEntry) < 90)
      return false;

   if(!TryAcquireOpenLock()) return false;

   ENUM_ORDER_TYPE ot = (dirSign > 0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   if(!SMC_FinalOpenGate(_Symbol, ot))
   {
      ReleaseOpenLock();
      return false;
   }

   double lot = CalculateLotSize();
   if(lot <= 0) { ReleaseOpenLock(); return false; }

   string cmt = "GOM_PERFECT " + wantDir + " " + levelName;
   bool ok = false;
   if(dirSign > 0)
      ok = SafeTradeBuy(lot, _Symbol, 0, 0, 0, cmt);
   else
      ok = SafeTradeSell(lot, _Symbol, 0, 0, 0, cmt);

   if(ok)
   {
      s_lastPerfectEntry = TimeCurrent();
      s_lastPerfectSym = _Symbol;
      SMC_GateRegisterOpened(_Symbol, dirSign > 0);
      Print("âœ… GOM-PERFECT MARKET ", wantDir, " | ", _Symbol,
            " | vn=", g_smcGomVerdictNum, " | niveau=", levelName,
            " | lot=", DoubleToString(lot, 2));
   }
   else
      Print("âŒ GOM-PERFECT Ã©chec OrderSend | ret=", trade.ResultRetcode(),
            " ", trade.ResultRetcodeDescription());

   ReleaseOpenLock();
   return ok;
}


void SMC_GOM_ImmediateOnTick()
{
   if(!UseGOMImmediateMarket) return;
   if(!g_smcGomConnected) return;

   // Mise a jour des compteurs de barres / confirmation M1
   GOM_UpdateConfirmationTrackers();

   // Sortie par timeout (pas de spike / pas de confirmation) des positions GOM immediates
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      string cmt = posInfo.Comment();
      if(!SMC_IsImmediateEntryComment(cmt)) continue;
      ulong ticket = posInfo.Ticket();

      int barsSinceEntry = 0;
      if(!GOM_ShouldExitDueToTimeout(ticket, barsSinceEntry)) continue;

      Print("[GOM-IMM] Timeout no-spike exit â€” #", ticket,
            " ", posInfo.Symbol(), " bars=", barsSinceEntry,
            " | ", cmt);
      if(!PositionCloseWithLog(ticket, "GOM_IMM timeout no-spike", true))
         Print("âš ï¸ Ã‰chec fermeture GOM_IMM timeout â€” ticket=", ticket,
               " err=", GetLastError());
   }
}

