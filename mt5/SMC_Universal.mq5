//| Corps force dans .mq5 (evite bug MQL5 forward/.mqh)              |
//+------------------------------------------------------------------+
bool SMCPS_TryExecutePatternConfluenceEntry(const string symbol, const int dirSign, const string direction)
{
   if(!UsePatternConfluenceEntry || !UsePatternEntrySignals) return false;
   if(dirSign == 0) return false;

   // IRON: WAIT / OFF = aucune entrÃ©e pattern (le bypass AlignExec Ã©tait un bug)
   if(!g_smcGomConnected || g_smcGomVerdictNum == 0)
   {
      static datetime s_patW = 0;
      if(TimeCurrent() - s_patW >= 45)
      {
         s_patW = TimeCurrent();
         Print("[PATTERN-CONFLUENCE] BLOQUÃ‰ â€” GOM WAIT/OFF | ", symbol);
      }
      return false;
   }
   // Adaptive instrument filtering (Index Synthetics EA pattern)
   double adaptiveThreshold = SMC_AI_AdaptiveGOMThreshold(symbol);
   if(MathAbs(g_smcGomVerdictNum) < adaptiveThreshold)
   {
      static datetime s_patS = 0;
      if(TimeCurrent() - s_patS >= 45)
      {
         s_patS = TimeCurrent();
         Print("[PATTERN-CONFLUENCE] BLOQUÃ‰ â€” SIMPLE vn=", g_smcGomVerdictNum, " | Adaptive threshold: ", DoubleToString(adaptiveThreshold, 1), " | ", symbol);
      }
      return false;
   }
   if(dirSign > 0 && g_smcGomVerdictNum < 0) return false;
   if(dirSign < 0 && g_smcGomVerdictNum > 0) return false;

   SMCPS_EnsureScanned(symbol);

   int effVn = SMCPS_EffectiveGOMVerdictNum();
   if(dirSign == 1 && effVn <= -2) return false;
   if(dirSign == -1 && effVn >= 2) return false;

   // Inline SMCPS_PatternConfluenceOK (evite undeclared selon ordre include MQL5)
   int confCount = (dirSign > 0) ? g_smcps.bullScore : g_smcps.bearScore;
   if(confCount < PatternConfluenceMinCount) return false;

   static datetime s_lastConfTry = 0;
   if(TimeCurrent() - s_lastConfTry < 5) return false;

   if(!SMCPS_BreakoutConfirmed(symbol, dirSign))
   {
      static datetime s_boLog2 = 0;
      if(TimeCurrent() - s_boLog2 >= 45)
      {
         s_boLog2 = TimeCurrent();
         Print("[PATTERN-CONFLUENCE] Attente breakout | ", direction,
               " | bull=", g_smcps.bullScore, " bear=", g_smcps.bearScore,
               " (seuil ", PatternConfluenceMinCount, ") | GOM vn=", g_smcGomVerdictNum);
      }
      return false;
   }

   s_lastConfTry = TimeCurrent();
   int count = (dirSign > 0) ? g_smcps.bullScore : g_smcps.bearScore;
   string tag = SMCPS_BestPatternTag(dirSign) + "_CONF" + IntegerToString(count);

   // Advanced Range Detection (EA Gold Stuff fix pattern)
   if(!SMC_Range_AllowEntry(_Symbol, g_smcGomVerdictNum))
   {
      Print("ðŸš« [PATTERN-CONFLUENCE] EntrÃ©e bloquÃ©e par dÃ©tection de range | ", _Symbol);
      return false;
   }

   // Advanced Risk Manager (SpikeRider EA pattern) - check if trading allowed
   if(!SMC_Risk_AllowTrade())
   {
      Print("ðŸš« [PATTERN-CONFLUENCE] EntrÃ©e bloquÃ©e par gestionnaire de risque | ", _Symbol);
      return false;
   }

   // Pas de AlignExecBypass â€” FinalOpenGate + CanPlaceOrderByGOM restent actifs
   bool ok = PlaceGOMMarketOrder(direction, "GOM_PATTERN_CONFLUENCE", tag);

   if(ok)
      Print("[PATTERN-CONFLUENCE] MARKET ", direction, " | ", count,
            " patterns meme sens (seuil ", PatternConfluenceMinCount,
            ") | GOM vn=", g_smcGomVerdictNum, " | ", g_smcps.summary);
   else
      Print("[PATTERN-CONFLUENCE] ECHEC ", direction, " | ", count,
            " patterns meme sens mais ordre refuse | vn=", g_smcGomVerdictNum);
   return ok;
}

//+------------------------------------------------------------------+
//| CASCADE M15 -> M5 (lent, cassure confirmÃ©e) / M1 (rapide, scalp) |
//| Demande Sidoine 2026-09-19 : quand un pattern chartiste est      |
//| dÃ©tectÃ© sur M15, l'EA cherche une entrÃ©e sur M5 en attendant la  |
//| confirmation de cassure (lent), et une entrÃ©e sur M1 dÃ¨s qu'un   |
//| signal apparaÃ®t, sans attendre de cassure (rapide/scalp), mais   |
//| avec des garde-fous de prudence (GOM alignÃ© fort, pas de move    |
//| dÃ©jÃ  Ã©tendu, lot rÃ©duit, anti-surtrading).                       |
//| Les deux volets sont indÃ©pendants : le scalp M1 n'empÃªche pas    |
//| l'entrÃ©e M5 plus tard si la cassure se confirme, et vice versa.  |
//+------------------------------------------------------------------+
bool SMCPS_TryExecuteM15CascadeM5Entry(const string symbol, const int dirSign, const string direction)
{
   if(!UseM15CascadeEntry || !UsePatternEntrySignals) return false;
   if(dirSign == 0) return false;

   if(!g_smcGomConnected || g_smcGomVerdictNum == 0) return false;
   if(MathAbs(g_smcGomVerdictNum) < MinGOMVerdictNumAbs) return false;
   if(dirSign > 0 && g_smcGomVerdictNum < 0) return false;
   if(dirSign < 0 && g_smcGomVerdictNum > 0) return false;

   SMCPS_EnsureScanned(symbol);

   int effVn = SMCPS_EffectiveGOMVerdictNum();
   if(dirSign == 1 && effVn <= -2) return false;
   if(dirSign == -1 && effVn >= 2) return false;

   // DÃ©clencheur : pattern chartiste confirmÃ© sur M15
   if(!SMCPS_HasQualifyingM15Pattern(dirSign, M15CascadeMinWeight)) return false;

   // Confirmation : un pattern doit aussi exister sur M5 dans le mÃªme sens
   bool hasM5Pattern = false;
   for(int i = 0; i < g_smcps.hitCount; i++)
      if(g_smcps.hits[i].dirSign == dirSign && g_smcps.hits[i].tf == PERIOD_M5)
      { hasM5Pattern = true; break; }
   if(!hasM5Pattern) return false;

   // EntrÃ©e "lente" : on attend toujours la cassure du niveau M5, jamais immÃ©diate
   if(!SMCPS_BreakoutConfirmedOnTF(symbol, dirSign, PERIOD_M5))
   {
      static datetime s_boM5Log = 0;
      if(TimeCurrent() - s_boM5Log >= 45)
      {
         s_boM5Log = TimeCurrent();
         Print("[M15-CASCADE-M5] Attente cassure M5 | ", direction, " | ", g_smcps.summary,
               " | GOM vn=", g_smcGomVerdictNum);
      }
      return false;
   }

   // Un seul essai par fenÃªtre M15 (bougie M15 courante) pour Ã©viter les doublons
   datetime m15Bar = iTime(symbol, PERIOD_M15, 1);
   static datetime s_lastM15BarBuy = 0, s_lastM15BarSell = 0;
   if(dirSign > 0 && m15Bar == s_lastM15BarBuy) return false;
   if(dirSign < 0 && m15Bar == s_lastM15BarSell) return false;

   string tag = SMCPS_BestPatternTag(dirSign) + "_M15CASC_M5";
   bool ok = PlaceGOMMarketOrder(direction, "GOM_M15_CASCADE_M5", tag);
   if(ok)
   {
      if(dirSign > 0) s_lastM15BarBuy = m15Bar; else s_lastM15BarSell = m15Bar;
      Print("[M15-CASCADE-M5] MARKET ", direction, " (entrÃ©e lente, cassure M5 confirmÃ©e) | ",
            g_smcps.summary, " | GOM vn=", g_smcGomVerdictNum);
   }
   else
      Print("[M15-CASCADE-M5] ECHEC ", direction, " | ordre refusÃ© | vn=", g_smcGomVerdictNum);
   return ok;
}

bool SMCPS_TryExecuteM15CascadeM1ScalpEntry(const string symbol, const int dirSign, const string direction)
{
   if(!UseM15CascadeEntry || !UseM15CascadeM1Scalp || !UsePatternEntrySignals) return false;
   if(dirSign == 0) return false;

   if(!g_smcGomConnected || g_smcGomVerdictNum == 0) return false;
   // Le scalp n'attend pas de cassure : on exige en Ã©change un GOM franchement
   // alignÃ© (GOOD/PERFECT, |vn|>=2), jamais un simple SIMPLE â€” prudence.
   if(MathAbs(g_smcGomVerdictNum) < 2) return false;
   if(dirSign > 0 && g_smcGomVerdictNum < 0) return false;
   if(dirSign < 0 && g_smcGomVerdictNum > 0) return false;

   SMCPS_EnsureScanned(symbol);

   int effVn = SMCPS_EffectiveGOMVerdictNum();
   if(dirSign == 1 && effVn <= -2) return false;
   if(dirSign == -1 && effVn >= 2) return false;

   // DÃ©clencheur : pattern chartiste confirmÃ© sur M15 (toujours actif)
   if(!SMCPS_HasQualifyingM15Pattern(dirSign, M15CascadeMinWeight)) return false;

   // Signal M1 dans le mÃªme sens â€” entrÃ©e immÃ©diate, pas d'attente de cassure
   bool hasM1Pattern = false;
   for(int i = 0; i < g_smcps.hitCount; i++)
      if(g_smcps.hits[i].dirSign == dirSign && g_smcps.hits[i].tf == PERIOD_M1)
      { hasM1Pattern = true; break; }
   if(!hasM1Pattern) return false;

   // Prudence : ne jamais scalper un mouvement dÃ©jÃ  Ã©tendu
   if(!SMCPS_NotExtended(symbol, dirSign)) return false;

   // Anti-surtrading : 1 scalp par bougie M1 + cooldown mini entre deux scalps
   datetime m1Bar = iTime(symbol, PERIOD_M1, 1);
   static datetime s_lastM1BarBuy = 0, s_lastM1BarSell = 0;
   static datetime s_lastScalpTime = 0;
   if(dirSign > 0 && m1Bar == s_lastM1BarBuy) return false;
   if(dirSign < 0 && m1Bar == s_lastM1BarSell) return false;
   if(TimeCurrent() - s_lastScalpTime < M1ScalpCooldownSec) return false;

   string tag = SMCPS_BestPatternTag(dirSign) + "_M15CASC_M1SCALP";

   // Lot rÃ©duit pour ce volet scalp (prudence), via le multiplicateur global
   // dÃ©jÃ  utilisÃ© ailleurs pour les entrÃ©es Ã  taille rÃ©duite (ex. contre-tendance).
   // NB: Ã  vÃ©rifier que PlaceGOMMarketOrder() lit bien g_agentLotMultiplier â€”
   // fonction dÃ©finie hors des fichiers fournis (probablement SMC_GOM_Immediate.mqh).
   double savedMult = g_agentLotMultiplier;
   g_agentLotMultiplier = savedMult * MathMax(0.05, M1ScalpLotMultiplier);
   bool ok = PlaceGOMMarketOrder(direction, "GOM_M15_CASCADE_M1_SCALP", tag);
   g_agentLotMultiplier = savedMult;

   if(ok)
   {
      s_lastScalpTime = TimeCurrent();
      if(dirSign > 0) s_lastM1BarBuy = m1Bar; else s_lastM1BarSell = m1Bar;
      Print("[M15-CASCADE-M1-SCALP] MARKET ", direction, " (entrÃ©e rapide, lot x",
            DoubleToString(M1ScalpLotMultiplier, 2), ") | ", g_smcps.summary,
            " | GOM vn=", g_smcGomVerdictNum);
   }
   else
      Print("[M15-CASCADE-M1-SCALP] ECHEC ", direction, " | ordre refusÃ© | vn=", g_smcGomVerdictNum);
   return ok;
}

#include "modules/SMC_ProbabilityGate.mqh"
#include "modules/SMC_DowTrendline.mqh"
struct SpikeBlinkWatchState
{
   bool     active;
   int      dirSign;
   datetime barTime;
   double   price;
   string   message;
   bool     blinkVisible;
   uint     lastToggleMs;
   uint     lastRenderMs;
   uint     lastSignalMs;
};
SpikeBlinkWatchState g_spikeBlinkWatch;
void SMC_SpikeBlink_ClearWatchArrow();
void SMC_SpikeBlink_UpdateWatchArrow(const int dirSign);
void SMC_SpikeBlink_WatchArrowOnTimer();
#define G_SMC_GOM_EXTERN
#include "modules/SMC_SpikeBlinkDetector.mqh"
void SMC_SpikeBlink_ClearWatchArrow()
{
   ObjectDelete(0, "SPIKE_WATCH_" + _Symbol + "_ARR");
   ObjectDelete(0, "SPIKE_WATCH_" + _Symbol + "_LBL");
   g_spikeBlinkWatch.active = false;
   g_spikeBlinkWatch.dirSign = 0;
   g_spikeBlinkWatch.barTime = 0;
   g_spikeBlinkWatch.price = 0.0;
   g_spikeBlinkWatch.message = "";
   g_spikeBlinkWatch.lastRenderMs = 0;
}

void SMC_SpikeBlink_DrawWatchArrow()
{
   if(!g_spikeBlinkWatch.active || g_spikeBlinkWatch.price <= 0.0)
      return;

   uint nowMs = GetTickCount();
   bool phaseChanged = false;
   if(nowMs - g_spikeBlinkWatch.lastToggleMs >= (uint)MathMax(200, SpikeBlinkIntervalMs))
   {
      g_spikeBlinkWatch.blinkVisible = !g_spikeBlinkWatch.blinkVisible;
      g_spikeBlinkWatch.lastToggleMs = nowMs;
      phaseChanged = true;
   }
   if(!phaseChanged && g_spikeBlinkWatch.lastRenderMs > 0 &&
      nowMs - g_spikeBlinkWatch.lastRenderMs < 250)
      return;
   g_spikeBlinkWatch.lastRenderMs = nowMs;

   bool isBuy = (g_spikeBlinkWatch.dirSign > 0);
   bool isPreSpike = (StringFind(g_spikeBlinkWatch.message, "PRE-SPIKE") == 0);
   color onColor = isPreSpike ? clrGold : (isBuy ? clrLime : clrRed);
   color offColor = isPreSpike ? C'90,70,0' : (isBuy ? C'0,65,0' : C'70,0,0');
   color arrowColor = g_spikeBlinkWatch.blinkVisible ? onColor : offColor;
   string arrowName = "SPIKE_WATCH_" + _Symbol + "_ARR";
   string labelName = "SPIKE_WATCH_" + _Symbol + "_LBL";
   datetime t = (g_spikeBlinkWatch.barTime > 0)
                ? g_spikeBlinkWatch.barTime : iTime(_Symbol, PERIOD_M1, 0);
   if(t <= 0) t = TimeCurrent();

   if(ObjectFind(0, arrowName) < 0 &&
      !ObjectCreate(0, arrowName, OBJ_ARROW, 0, t, g_spikeBlinkWatch.price))
   {
      static datetime s_lastCreateError = 0;
      if(TimeCurrent() - s_lastCreateError >= 30)
      {
         Print("[SPIKE-WATCH] Ã‰chec crÃ©ation flÃ¨che | ", _Symbol,
               " | erreur=", GetLastError());
         s_lastCreateError = TimeCurrent();
      }
      return;
   }

   ObjectMove(0, arrowName, 0, t, g_spikeBlinkWatch.price);
   ObjectSetInteger(0, arrowName, OBJPROP_ARROWCODE, isBuy ? 233 : 234);
   ObjectSetInteger(0, arrowName, OBJPROP_WIDTH, 5);
   ObjectSetInteger(0, arrowName, OBJPROP_ANCHOR, isBuy ? ANCHOR_TOP : ANCHOR_BOTTOM);
   ObjectSetInteger(0, arrowName, OBJPROP_COLOR, arrowColor);
   ObjectSetInteger(0, arrowName, OBJPROP_BACK, false);
   ObjectSetInteger(0, arrowName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, arrowName, OBJPROP_HIDDEN, true);
   ObjectSetInteger(0, arrowName, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
   ObjectSetString(0, arrowName, OBJPROP_TOOLTIP, g_spikeBlinkWatch.message);

   if(ObjectFind(0, labelName) < 0 &&
      !ObjectCreate(0, labelName, OBJ_TEXT, 0, t, g_spikeBlinkWatch.price))
   {
      static datetime s_lastLabelError = 0;
      if(TimeCurrent() - s_lastLabelError >= 30)
      {
         Print("[SPIKE-WATCH] Ã‰chec crÃ©ation libellÃ© | ", _Symbol,
               " | erreur=", GetLastError());
         s_lastLabelError = TimeCurrent();
      }
      ChartRedraw(0);
      return;
   }

   ObjectMove(0, labelName, 0, t, g_spikeBlinkWatch.price);
   ObjectSetString(0, labelName, OBJPROP_TEXT,
                   g_spikeBlinkWatch.blinkVisible ? g_spikeBlinkWatch.message : " ");
   ObjectSetString(0, labelName, OBJPROP_FONT, "Arial Bold");
   ObjectSetInteger(0, labelName, OBJPROP_FONTSIZE, 10);
   ObjectSetInteger(0, labelName, OBJPROP_ANCHOR, isBuy ? ANCHOR_UPPER : ANCHOR_LOWER);
   ObjectSetInteger(0, labelName, OBJPROP_COLOR, arrowColor);
   ObjectSetInteger(0, labelName, OBJPROP_BACK, false);
   ObjectSetInteger(0, labelName, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, labelName, OBJPROP_HIDDEN, true);
   ObjectSetInteger(0, labelName, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
   ChartRedraw(0);
}

void SMC_SpikeBlink_UpdateWatchArrow(const int dirSign)
{
   if(!SpikeShowArrows || dirSign == 0)
   {
      SMC_SpikeBlink_ClearWatchArrow();
      return;
   }

   MqlRates rates[];
   ArraySetAsSeries(rates, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 1, rates) < 1)
      return;

   datetime spikeBar = 0;
   double spikePrice = 0.0;
   bool liveSpike = SMC_SpikeBlink_LiveCandle(dirSign, spikeBar, spikePrice);
   bool preSpike = (g_spikeChainState == SPIKE_STATE_PRE_SPIKE);
   bool activeChain = (g_spikeChainState == SPIKE_STATE_CHAIN_ACTIVE &&
                       g_spikeChainDirection == dirSign &&
                       g_spikeChainStrongBars >= 2);
   bool freshHighProbability = (g_lastSpikeUpdate > 0 &&
                                TimeCurrent() >= g_lastSpikeUpdate &&
                                TimeCurrent() - g_lastSpikeUpdate <= 60 &&
                                g_lastSpikeProbability >= 0.75);

   if(!liveSpike && !preSpike && !activeChain && !freshHighProbability)
   {
      SMC_SpikeBlink_ClearWatchArrow();
      return;
   }

   string message = liveSpike ? "SPIKE DETECTE"
                    : activeChain ? "CHAINE SPIKE ACTIVE"
                    : preSpike ? "PRE-SPIKE - A SURVEILLER"
                    : "SPIKE POSSIBLE";
   double range = rates[0].high - rates[0].low;
   double offset = MathMax(range * 0.25, _Point * 20.0);
   double price = liveSpike ? spikePrice
                  : (dirSign > 0 ? rates[0].low - offset : rates[0].high + offset);
   datetime barTime = liveSpike ? spikeBar : rates[0].time;

   if(!g_spikeBlinkWatch.active ||
      g_spikeBlinkWatch.dirSign != dirSign ||
      g_spikeBlinkWatch.message != message)
   {
      g_spikeBlinkWatch.blinkVisible = true;
      g_spikeBlinkWatch.lastToggleMs = GetTickCount();
      g_spikeBlinkWatch.lastRenderMs = 0;
   }
   g_spikeBlinkWatch.active = true;
   g_spikeBlinkWatch.dirSign = dirSign;
   g_spikeBlinkWatch.barTime = barTime;
   g_spikeBlinkWatch.price = price;
   g_spikeBlinkWatch.message = message;
   g_spikeBlinkWatch.lastSignalMs = GetTickCount();
   SMC_SpikeBlink_DrawWatchArrow();
}

void SMC_SpikeBlink_WatchArrowOnTimer()
{
   if(!g_spikeBlinkWatch.active)
      return;
   if(GetTickCount() - g_spikeBlinkWatch.lastSignalMs > 30000)
   {
      SMC_SpikeBlink_ClearWatchArrow();
      return;
   }
   SMC_SpikeBlink_DrawWatchArrow();
}

void SMC_SpikeBlink_Deinit()
{
   SMC_SpikeBlink_ClearWatchArrow();
   if(g_spikeBlinkAtrHandle != INVALID_HANDLE)
   {
      IndicatorRelease(g_spikeBlinkAtrHandle);
      g_spikeBlinkAtrHandle = INVALID_HANDLE;
   }
}

