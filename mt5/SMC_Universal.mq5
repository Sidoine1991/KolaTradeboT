   if(ema31LTF != INVALID_HANDLE) { IndicatorRelease(ema31LTF); ema31LTF = INVALID_HANDLE; }
   if(ema50LTF != INVALID_HANDLE) { IndicatorRelease(ema50LTF); ema50LTF = INVALID_HANDLE; }
   if(ema100LTF != INVALID_HANDLE) { IndicatorRelease(ema100LTF); ema100LTF = INVALID_HANDLE; }
   if(ema200LTF != INVALID_HANDLE) { IndicatorRelease(ema200LTF); ema200LTF = INVALID_HANDLE; }
}

bool IsBullishHTF()
{
   if(ema50H == INVALID_HANDLE || ema200H == INVALID_HANDLE) return false;
   double f[], s[];
   ArraySetAsSeries(f, true); ArraySetAsSeries(s, true);
   if(CopyBuffer(ema50H, 0, 0, 1, f) < 1 || CopyBuffer(ema200H, 0, 0, 1, s) < 1) return false;
   return f[0] > s[0];
}
bool IsBearishHTF()
{
   if(ema50H == INVALID_HANDLE || ema200H == INVALID_HANDLE) return false;
   double f[], s[];
   ArraySetAsSeries(f, true); ArraySetAsSeries(s, true);
   if(CopyBuffer(ema50H, 0, 0, 1, f) < 1 || CopyBuffer(ema200H, 0, 0, 1, s) < 1) return false;
   return f[0] < s[0];
}
bool FVGKill_LiquiditySweepDetected()
{
   double prevHigh = iHigh(_Symbol, LTF, 2);
   double prevLow  = iLow(_Symbol, LTF, 2);
   double h1 = iHigh(_Symbol, LTF, 1);
   double l1 = iLow(_Symbol, LTF, 1);
   return (h1 > prevHigh || l1 < prevLow);
}
bool FVGKill_SweepConfirmed(int minBarsAgo = 2)
{
   string lsType;
   int barsAgo = 0;
   if(!SMC_DetectLiquiditySweepEx(_Symbol, LTF, lsType, barsAgo)) return false;
   return (barsAgo >= minBarsAgo);
}

bool IsInDiscountZone()
{
   double high[], low[], close[];
   ArraySetAsSeries(high, true); ArraySetAsSeries(low, true); ArraySetAsSeries(close, true);
   if(CopyHigh(_Symbol, PERIOD_H1, 0, 100, high) < 100 || CopyLow(_Symbol, PERIOD_H1, 0, 100, low) < 100 || CopyClose(_Symbol, PERIOD_H1, 0, 100, close) < 100) return false;
   int n = ArraySize(close);
   if(n < 25) return false;
   double sma20[];
   ArrayResize(sma20, n);
   ArraySetAsSeries(sma20, true);
   for(int i = 0; i < n - 20; i++) { double s = 0; for(int j = 0; j < 20; j++) s += close[i + j]; sma20[i] = s / 20; }
   for(int i = n - 20; i < n; i++) sma20[i] = sma20[MathMax(0, n - 21)];
   double eq = sma20[0];
   double discLow = low[ArrayMinimum(low, 0, 20)];
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   return (bid >= discLow && bid <= eq && discLow < eq);
}
bool IsInPremiumZone()
{
   double high[], low[], close[];
   ArraySetAsSeries(high, true); ArraySetAsSeries(low, true); ArraySetAsSeries(close, true);
   if(CopyHigh(_Symbol, PERIOD_H1, 0, 100, high) < 100 || CopyLow(_Symbol, PERIOD_H1, 0, 100, low) < 100 || CopyClose(_Symbol, PERIOD_H1, 0, 100, close) < 100) return false;
   int n = ArraySize(close);
   if(n < 25) return false;
   double sma20[];
   ArrayResize(sma20, n);
   ArraySetAsSeries(sma20, true);
   for(int i = 0; i < n - 20; i++) { double s = 0; for(int j = 0; j < 20; j++) s += close[i + j]; sma20[i] = s / 20; }
   for(int i = n - 20; i < n; i++) sma20[i] = sma20[MathMax(0, n - 21)];
   double eq = sma20[0];
   double premHigh = high[ArrayMaximum(high, 0, 20)];
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   return (ask >= eq && ask <= premHigh && premHigh > eq);
}

//+------------------------------------------------------------------+
//| EntrÃ©e MARKET au touch du rectangle DOW EP (DOW_CORRECTION_RECT)  |
//| Verdict GOM GOOD/PERFECT + M1/M5/M15 alignÃ©s                     |
//| + structure (zone discount/premium) + tendance claire (EMA H1)    |
//+------------------------------------------------------------------+
void SMC_TryDowEpRectMarketEntry()
{
   if(!UseDowEpRectMarketEntry) return;

   string symUpper = _Symbol;
   StringToUpper(symUpper);
   bool isSpike = (StringFind(symUpper, "BOOM") >= 0 || StringFind(symUpper, "CRASH") >= 0 ||
                   StringFind(symUpper, "PAINX") >= 0 || StringFind(symUpper, "GAINX") >= 0 ||
                   SMC_GetSymbolCategory(_Symbol) == SYM_VOLATILITY);
   if(!isSpike) return;

   if(CountPositionsForSymbol(_Symbol) > 0) return;

   // â”€â”€ Verdict GOOD/PERFECT uniquement (|vn|>=2) â€” WAIT/SIMPLE bloquÃ©s â”€â”€
   if(!g_smcGomConnected || g_smcGomVerdictNum == 0) return;
   if(!SMCGP_IsGoodPerfect(g_smcGomVerdictNum)) return;
   bool isBearish = (g_smcGomVerdictNum < 0);
   if(!SMC_SpikeBlink_TripleTFAligned(isBearish ? -1 : 1)) return;

   // FIX 2026-09-08 (Claude, demande Sidoine): garde correction M5 pour SIMPLE.
   // FIX 2026-09-09 (Claude, demande Sidoine): l'hypothÃ¨se "GOOD/PERFECT restent
   // couverts par ailleurs" Ã©tait fausse â€” structure (discount/premium) + tendance
   // H1 ne dÃ©tectent PAS un retracement M5 en cours (EMA21/EMA50 traversÃ©es, ATR
   // compressÃ©, range Ã©troit). GOOD/PERFECT pouvait donc rentrer en pleine
   // correction, comme SIMPLE avant le fix d'hier. Garde dÃ©sormais appliquÃ©e Ã 
   // TOUS les verdicts (SIMPLE, GOOD, PERFECT) â€” plus d'exception.
   int rectDirSign = isBearish ? -1 : 1;

   // â”€â”€ Structure : zone discount/premium (proxy MasterScore, indisponible) â”€â”€
   if(isBearish && !IsInPremiumZone()) return;
   if(!isBearish && !IsInDiscountZone()) return;

   // â”€â”€ Tendance claire EMA50H vs EMA200H â”€â”€
   if(!isBearish && !IsBullishHTF()) return;
   if(isBearish && !IsBearishHTF()) return;

   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double epPrice = 0.0;
   string epToken = isBearish ? "DOW_BEAR_EP" : "DOW_BULL_EP";
   if(!SMC_FindReactionObjectLevel(_Symbol, epToken, epPrice) || epPrice <= 0.0)
      epPrice = (g_dowState.currentEpPrice > 0.0) ? g_dowState.currentEpPrice
               : ((g_dowState.projectedPrice > 0.0) ? g_dowState.projectedPrice : 0.0);
   if(epPrice <= 0.0) return;

   // â”€â”€ TouchÃ© EP: Bullâ†’low retrace â‰¤ EP, Bearâ†’high retrace â‰¥ EP â”€â”€
   double low1 = iLow(_Symbol, PERIOD_M1, 0);
   double high1 = iHigh(_Symbol, PERIOD_M1, 0);
   bool epTouched = isBearish ? (high1 >= epPrice) : (low1 <= epPrice);

   static datetime s_rectTouchBar = 0;
   if(epTouched)
      s_rectTouchBar = iTime(_Symbol, PERIOD_M1, 0);

   // Attendre 1 bougie M1 aprÃ¨s le touchÃ©
   if(s_rectTouchBar == 0 || iTime(_Symbol, PERIOD_M1, 0) <= s_rectTouchBar) return;

   // â”€â”€ Cooldown entre 2 entrÃ©es rectangle â”€â”€
   static datetime s_lastRectEntry = 0;
   if(s_lastRectEntry > 0 && TimeCurrent() - s_lastRectEntry < DowEpRectCooldownSec) return;

   // â›” Pattern Forecast hard block
   if(Dow_PatternForecastBlocksTrade()) return;

   // â”€â”€ ATR (garde standard) â”€â”€
   double atrVal = 0.0;
   double atrBuf[];
   ArraySetAsSeries(atrBuf, true);
   if(atrHandle != INVALID_HANDLE && CopyBuffer(atrHandle, 0, 0, 2, atrBuf) >= 2)
      atrVal = atrBuf[1];
   if(atrVal <= 0.0) return;

   if(!SMC_HasM1LevelRejection(isBearish ? -1 : 1, epPrice, atrVal))
   {
      Print("â³ DOW EP touch sans rejet M1 exploitable â€” pas d'entrÃ©e tardive sur ",
            _Symbol, " | EP=", DoubleToString(epPrice, dg));
      return;
   }

   // â”€â”€ Gate final (cap global, anti-hedge, OTE, tracker) â”€â”€
   if(!SMC_FinalOpenGate(_Symbol, isBearish ? ORDER_TYPE_SELL : ORDER_TYPE_BUY)) return;

   double lot = CalculateLotSize();
   if(lot <= 0.0) return;

   MqlTradeRequest rectReq = {};
   MqlTradeResult  rectRes = {};
   rectReq.action    = TRADE_ACTION_DEAL;
   rectReq.symbol    = _Symbol;
   rectReq.volume    = lot;
   rectReq.magic     = InpMagicNumber;
   rectReq.deviation = 30;

   if(isBearish)
   {
      rectReq.type    = ORDER_TYPE_SELL;
      rectReq.price   = bid;
      rectReq.sl      = NormalizeDouble(bid + atrVal * DOW_SL_ATRMULT, dg);
      rectReq.tp      = NormalizeDouble(bid - atrVal * DOW_TP_ATRMULT, dg);
      rectReq.comment = "DOW RECT SELL";
   }
   else
   {
      rectReq.type    = ORDER_TYPE_BUY;
      rectReq.price   = ask;
      rectReq.sl      = NormalizeDouble(ask - atrVal * DOW_SL_ATRMULT, dg);
      rectReq.tp      = NormalizeDouble(ask + atrVal * DOW_TP_ATRMULT, dg);
      rectReq.comment = "DOW RECT BUY";
   }

   if(SafeOrderSend(rectReq, rectRes, rectReq.comment) && rectRes.retcode == TRADE_RETCODE_DONE)
   {
      s_lastRectEntry = TimeCurrent();
      s_rectTouchBar = 0;
      string tsRect = TimeToString(TimeCurrent(), TIME_DATE|TIME_SECONDS);
      Print("ðŸ“ DOW RECT ", (isBearish ? "SELL" : "BUY"), " MARKET @ ", rectReq.price,
            " (touch rectangle EP) | SL=", rectReq.sl, " | TP=", rectReq.tp, " ", tsRect);
      if(UseNotifications)
         SendNotification("ðŸ“ DOW RECT " + (isBearish ? "SELL" : "BUY") + " MARKET " + _Symbol +
                          " @ " + DoubleToString(rectReq.price, dg) +
                          " SL=" + DoubleToString(rectReq.sl, dg) +
                          " TP=" + DoubleToString(rectReq.tp, dg) +
                          " " + tsRect);
   }
   else
      Print("âŒ DOW RECT MARKET failed: ", rectRes.retcode, " - ", rectRes.comment);
}

//+------------------------------------------------------------------+
//| CONTRE-TENDANCE CHARTISTE (recouvrement de perte, EXCEPTIONNEL)  |
//| SELL sur Boom/GainX ou BUY sur Crash/PainX, UNIQUEMENT si une    |
//| figure chartiste confirmÃ©e (avec entry+target) est servie par    |
//| ai_server via GET /chartist/counter_trend/{symbol}. BridÃ© par :  |
//| opt-in explicite, score/RR mini, tolÃ©rance de prix vs l'entry,   |
//| cooldown + quota journalier LOCAL (en plus du garde-fou serveur),|
//| lot rÃ©duit, et toutes les autres gardes de sÃ©curitÃ© habituelles  |
//| (SMC_FinalOpenGate : cap global, anti-hedge, reaction tracker).  |
//| Ne passe PAS par CanTradeOnSymbol()/CanPlaceMarketOrder() car ce |
//| sont eux qui imposent "Boom/Gainx=BUY only, Crash/Painx=SELL     |
//| only" â€” c'est prÃ©cisÃ©ment cette rÃ¨gle qu'on lÃ¨ve ici, Ã  titre    |
//| exceptionnel et non systÃ©matique.                                |
//+------------------------------------------------------------------+
struct SMC_CounterTrendState
{
   string   symbol;
   datetime lastEntryTime;
   int      countToday;
   long     dayStamp;
};
SMC_CounterTrendState g_ctState[64];
int g_ctStateCount = 0;

int SMC_GetCounterTrendState(const string symbol)
{
   for(int i = 0; i < g_ctStateCount; i++)
      if(g_ctState[i].symbol == symbol) return i;
   if(g_ctStateCount >= 64) return -1;
   int n = g_ctStateCount++;
   g_ctState[n].symbol = symbol;
   g_ctState[n].lastEntryTime = 0;
   g_ctState[n].countToday = 0;
   g_ctState[n].dayStamp = 0;
   return n;
}

void SMC_TryChartistCounterTrendEntry()
{
   if(!AllowCounterTrendChartistRecovery) return;

   // FIX v1.34: BLOQUER si verdict est WAIT
   if(g_smcGomVerdictNum == 0) return;

   bool isBoom  = IsBoomLikeSymbol(_Symbol);
   bool isCrash = IsCrashLikeSymbol(_Symbol);
   if(!isBoom && !isCrash) return; // uniquement Boom/GainX/Crash/PainX, comme demandÃ©

   if(CountPositionsForSymbol(_Symbol) > 0) return; // jamais si dÃ©jÃ  en position sur ce symbole
   if(IsTerminalFull()) return;

   int st = SMC_GetCounterTrendState(_Symbol);
   if(st < 0) return;

   datetime now = TimeCurrent();

   // Quota journalier + cooldown LOCAUX (ceinture + bretelles en plus du
   // garde-fou dÃ©jÃ  appliquÃ© cÃ´tÃ© ai_server) â€” "pas systÃ©matique".
   long today = (long)now / 86400;
   if(g_ctState[st].dayStamp != today)
   {
      g_ctState[st].dayStamp = today;
      g_ctState[st].countToday = 0;
   }
   if(g_ctState[st].countToday >= CounterTrendMaxPerDay) return;
   if(g_ctState[st].lastEntryTime > 0 && (now - g_ctState[st].lastEntryTime) < CounterTrendCooldownSec) return;

   // Anti-spam requÃªtes HTTP : 1 poll / 20s max
   static datetime s_lastCTPoll = 0;
   if(now - s_lastCTPoll < 20) return;
   s_lastCTPoll = now;

   string symEnc = _Symbol;
   StringReplace(symEnc, " ", "%20");
   string body = "";
   if(!SMCGP_HttpGet("/chartist/counter_trend/" + symEnc, body, 4000)) return;
   if(!SMCGP_JsonBool(body, "ok")) return;

   string pattern   = SMCGP_JsonString(body, "pattern");
   string direction = SMCGP_JsonString(body, "direction");
   bool   confirmed = SMCGP_JsonBool(body, "confirmed");
   bool   isCT      = SMCGP_JsonBool(body, "counter_trend");
   double entryLvl  = SMCGP_JsonDouble(body, "entry", 0.0);
   double slLvl     = SMCGP_JsonDouble(body, "sl", 0.0);
   double tpLvl     = SMCGP_JsonDouble(body, "tp", 0.0);
   double score     = SMCGP_JsonDouble(body, "score", 0.0);
   double rr        = SMCGP_JsonDouble(body, "rr", 0.0);

   // Figure absente, pas confirmÃ©e, ou pas explicitement taguÃ©e contre-tendance
   // par le serveur â†’ on ne prend aucun risque, on abandonne.
   if(!confirmed || !isCT) return;
   if(StringLen(direction) == 0 || entryLvl <= 0.0 || slLvl <= 0.0 || tpLvl <= 0.0) return;
   if(score < CounterTrendMinScore || rr < CounterTrendMinRR) return;

   StringToUpper(direction);
   int dirSign = (direction == "BUY") ? 1 : (direction == "SELL" ? -1 : 0);
   if(dirSign == 0) return;

   // SÃ©curitÃ© supplÃ©mentaire : ce chemin ne sert QUE le sens contre-tendance.
   // Si jamais le serveur renvoyait par erreur le sens natif ici, on refuse â€”
   // ce chemin ne doit jamais devenir une 2e voie pour le sens normal.
   if(isBoom && dirSign > 0) return;   // Boom/GainX natif = BUY â†’ ici on n'autorise que SELL
   if(isCrash && dirSign < 0) return;  // Crash/PainX natif = SELL â†’ ici on n'autorise que BUY

   // Le niveau d'entrÃ©e affichÃ© (pointillÃ©) doit encore Ãªtre d'actualitÃ© :
   // le prix ne doit pas s'en Ãªtre trop Ã©loignÃ©.
   double atr = 0.0;
   double ab[];
   ArraySetAsSeries(ab, true);
   if(atrHandle != INVALID_HANDLE && CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1)
      atr = ab[0];
   if(atr <= 0.0) atr = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 50.0;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if(bid <= 0.0 || ask <= 0.0) return;
   double px = (bid + ask) * 0.5;
   if(MathAbs(px - entryLvl) > atr * MathMax(0.1, CounterTrendEntryATRTol)) return;

   // Gate final classique : cap global, anti-hedge, reaction tracker, OTE si
   // actif sur ce symbole. Volontairement PAS de CanTradeOnSymbol() /
   // CanPlaceMarketOrder() : ce sont eux qui imposent la rÃ¨gle native
   // "Boom/Gainx=BUY only, Crash/Painx=SELL only" â€” la lever est le but de
   // cette fonction, Ã  titre exceptionnel et sur figure de haute qualitÃ©.
   ENUM_ORDER_TYPE ot = (dirSign > 0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   if(!SMC_FinalOpenGate(_Symbol, ot)) return;

   double lot = CalculateLotSize() * MathMax(0.05, CounterTrendLotMultiplier);
   lot = NormalizeVolumeForSymbol(lot);
   if(lot <= 0.0) return;

   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double sl = NormalizeDouble(slLvl, dg);
   double tp = NormalizeDouble(tpLvl, dg);

   if(!TryAcquireOpenLock()) return;
   bool ok = false;
   string cmt = "CT RECOVERY " + pattern;
   if(dirSign > 0)
      ok = SafeTradeBuy(lot, _Symbol, ask, sl, tp, cmt);
   else
      ok = SafeTradeSell(lot, _Symbol, bid, sl, tp, cmt);
   ReleaseOpenLock();

   if(ok)
   {
      g_ctState[st].lastEntryTime = now;
      g_ctState[st].countToday++;
      RegisterOrderPlaced();
      SMC_GateRegisterOpened(_Symbol, dirSign > 0);

      Print("ðŸŽ¯ CONTRE-TENDANCE RECOVERY ", direction, " MARKET | ", _Symbol,
            " | figure=", pattern, " score=", DoubleToString(score, 2),
            " rr=", DoubleToString(rr, 2), " | entry~", DoubleToString(entryLvl, dg),
            " SL=", DoubleToString(sl, dg), " TP=", DoubleToString(tp, dg),
            " | lot=", DoubleToString(lot, 2), " | EXCEPTIONNEL â€” quota ",
            g_ctState[st].countToday, "/", CounterTrendMaxPerDay, " aujourd'hui sur ", _Symbol);
      if(UseNotifications)
         SendNotification("ðŸŽ¯ CT RECOVERY " + direction + " " + _Symbol + " | " + pattern +
                          " score=" + DoubleToString(score, 2));

      // LibÃ¨re le slot cÃ´tÃ© ai_server (retire l'ordre du store contre-tendance)
      string ackBody = "{\"mt5_ticket\":\"" + IntegerToString((long)trade.ResultOrder()) + "\"}";
      SMCGP_HttpPost("/chartist/counter_trend/" + symEnc + "/executed", ackBody, 3000);
   }
   else
   {
      Print("âŒ CONTRE-TENDANCE RECOVERY Ã©chouÃ©e ", direction, " sur ", _Symbol,
            " | err=", GetLastError());
   }
}

//+------------------------------------------------------------------+
//| ENTRÃ‰ES CHARTISTE NORMALES â€” figures native direction (SMC_OTE,  |
//| triangles, double bottom, BOS+FVG+OB...) via ai_server.          |
//| Voie NORMALE (â‰  contre-tendance) : GOM GOOD/PERFECT requis, sens |
//| natif Boom/Crash respectÃ©, SL/TP serveur.                        |
//+------------------------------------------------------------------+
void SMC_TryChartistOrderEntry()
{
   if(!UseChartistOrderEntries) return;

   if(IsTerminalFull()) return;
   if(CountPositionsForSymbol(_Symbol) > 0) return; // jamais en pile sur le mÃªme symbole

   // Anti-spam HTTP : 1 dÃ©tection / ChartistOrderPollSec
   static datetime s_lastChartistPoll = 0;
   datetime now = TimeCurrent();
   if(now - s_lastChartistPoll < ChartistOrderPollSec) return;
   s_lastChartistPoll = now;

   // Payload avec les 96 derniÃ¨res bougies M1 â†’ fraÃ®cheur garantie :
   // l'entrÃ©e est calculÃ©e sur ces bougies (pas de store serveur stale).
   MqlRates rlist[];
   int got = CopyRates(_Symbol, PERIOD_M1, 0, 96, rlist);
   if(got < 40) return;
   int dg = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   string candles = "";
   for(int i = 0; i < got; i++)
   {
      MqlRates r = rlist[i];
      if(i > 0) candles += ",";
      candles += StringFormat("{\"open\":%s,\"high\":%s,\"low\":%s,\"close\":%s,\"volume\":%f}",
                  DoubleToString(r.open, dg), DoubleToString(r.high, dg),
                  DoubleToString(r.low,  dg), DoubleToString(r.close, dg), (double)r.tick_volume);
   }
   string body = "{\"candles\":[" + candles + "]}";

   string symEnc = _Symbol;
   StringReplace(symEnc, " ", "%20");
   string resp = "";
   if(!SMCGP_HttpPostWithResponse("/chartist/detect/" + symEnc, body, resp, 6000)) return;
   if(!SMCGP_JsonBool(resp, "ok")) return;

   // best == orders[0] cÃ´tÃ© serveur â†’ le premier hit JSON est le best.
   string pattern   = SMCGP_JsonString(resp, "pattern");
   string direction = SMCGP_JsonString(resp, "direction");
   bool   confirmed = SMCGP_JsonBool(resp, "confirmed");
   bool   isCT      = SMCGP_JsonBool(resp, "counter_trend");
   double entryLvl  = SMCGP_JsonDouble(resp, "entry", 0.0);
   double slLvl     = SMCGP_JsonDouble(resp, "sl", 0.0);
   double tpLvl     = SMCGP_JsonDouble(resp, "tp", 0.0);
   double score     = SMCGP_JsonDouble(resp, "score", 0.0);
   double rr        = SMCGP_JsonDouble(resp, "rr", 0.0);

   // Figure absente / pas confirmÃ©e / taguÃ©e contre-tendance â†’ abandon.
   if(!confirmed || isCT) return;
   if(StringLen(pattern) == 0 || StringLen(direction) == 0) return;
   if(entryLvl <= 0.0 || slLvl <= 0.0 || tpLvl <= 0.0) return;
   if(score < ChartistOrderMinScore || rr < ChartistOrderMinRR) return;

   StringToUpper(direction);
   int dirSign = (direction == "BUY") ? 1 : (direction == "SELL" ? -1 : 0);
   if(dirSign == 0) return;

   // Sens natif respectÃ© (Boom/GainX = BUY uniquement, Crash/PainX = SELL uniquement)
   if(IsBoomLikeSymbol(_Symbol) && dirSign < 0) return;
   if(IsCrashLikeSymbol(_Symbol) && dirSign > 0) return;

   // SL/TP cohÃ©rents par rapport au niveau d'entrÃ©e
   if(dirSign > 0 && (slLvl >= entryLvl || tpLvl <= entryLvl)) return;
   if(dirSign < 0 && (slLvl <= entryLvl || tpLvl >= entryLvl)) return;

   // Le prix ne doit pas s'Ãªtre trop Ã©loignÃ© du niveau d'entrÃ©e affichÃ©
   double atr = 0.0;
   double ab[];
   ArraySetAsSeries(ab, true);
   if(atrHandle != INVALID_HANDLE && CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1)
      atr = ab[0];
   if(atr <= 0.0) atr = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 50.0;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if(bid <= 0.0 || ask <= 0.0) return;
   double px = (bid + ask) * 0.5;
   if(MathAbs(px - entryLvl) > atr * MathMax(0.1, ChartistOrderEntryATRTol)) return;

   // Gate GOM voie normale : GOOD/PERFECT + direction alignÃ©e + connectÃ©
   if(!SMC_EntryVerdictOK(_Symbol, dirSign)) return;

   // Gates classiques voie normale (nano, rÃ©action, OTE, discipline...)
   ENUM_ORDER_TYPE ot = (dirSign > 0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   if(!CanTradeOnSymbol(_Symbol, direction)) return;
   if(!CanPlaceMarketOrder(_Symbol, dirSign)) return;
   if(!SMC_FinalOpenGate(_Symbol, ot)) return;

   double lot = CalculateLotSize();
   lot = NormalizeVolumeForSymbol(lot);
   if(lot <= 0.0) return;

   double sl = NormalizeDouble(slLvl, dg);
   double tp = NormalizeDouble(tpLvl, dg);

   if(!TryAcquireOpenLock()) return;
   bool ok = false;
   string cmt = "CHARTIST " + pattern;
   if(dirSign > 0)
      ok = SafeTradeBuy(lot, _Symbol, ask, sl, tp, cmt);
   else
      ok = SafeTradeSell(lot, _Symbol, bid, sl, tp, cmt);
   ReleaseOpenLock();

   if(ok)
   {
      RegisterOrderPlaced();
      SMC_GateRegisterOpened(_Symbol, dirSign > 0);
      Print("ðŸš€ CHARTISTE ", direction, " MARKET | ", _Symbol, " | figure=", pattern,
            " score=", DoubleToString(score, 2), " rr=", DoubleToString(rr, 2),
            " | entry~", DoubleToString(entryLvl, dg), " SL=", DoubleToString(sl, dg),
            " TP=", DoubleToString(tp, dg), " | lot=", DoubleToString(lot, 2));
      if(UseNotifications)
         SendNotification("ðŸš€ CHARTISTE " + direction + " " + _Symbol + " | " + pattern +
                          " score=" + DoubleToString(score, 2));

      // LibÃ¨re le slot cÃ´tÃ© ai_server (retire l'ordre du store chartiste)
      string ackBody = "{\"mt5_ticket\":\"" + IntegerToString((long)trade.ResultOrder()) + "\"}";
      SMCGP_HttpPost("/chartist/order/" + symEnc + "/executed", ackBody, 3000);
   }
   else
   {
      Print("âŒ CHARTISTE Ã©chouÃ©e ", direction, " sur ", _Symbol,
            " | err=", GetLastError());
   }
}

// Protection capital: vrai si en zone Discount et prix a touchÃ© le bord infÃ©rieur (zone d'achat)
// UtilisÃ© pour exiger confiance IA >= 85% avant d'exÃ©cuter un SELL dans ce cas.
bool IsAtDiscountLowerEdge()
{
   double high[], low[], close[];
   ArraySetAsSeries(high, true); ArraySetAsSeries(low, true); ArraySetAsSeries(close, true);
   if(CopyHigh(_Symbol, PERIOD_H1, 0, 100, high) < 100 || CopyLow(_Symbol, PERIOD_H1, 0, 100, low) < 100 || CopyClose(_Symbol, PERIOD_H1, 0, 100, close) < 100) return false;
   int n = ArraySize(close);
   if(n < 25) return false;
   double sma20[];
   ArrayResize(sma20, n);
   ArraySetAsSeries(sma20, true);
   for(int i = 0; i < n - 20; i++) { double s = 0; for(int j = 0; j < 20; j++) s += close[i + j]; sma20[i] = s / 20; }
   for(int i = n - 20; i < n; i++) sma20[i] = sma20[MathMax(0, n - 21)];
   double eq = sma20[0];
   double discLow = low[ArrayMinimum(low, 0, 20)];
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   if(discLow >= eq) return false;
   if(bid < discLow || bid > eq) return false; // pas en zone discount
   double zoneHeight = eq - discLow;
   double edgeThreshold = discLow + zoneHeight * 0.15; // bord infÃ©rieur = 15% du bas de la zone
   return (bid <= edgeThreshold);
}

// Protection capital: vrai si en zone Premium et prix au bord supÃ©rieur (zone de vente)
// UtilisÃ© pour exiger confiance IA >= 85% avant d'exÃ©cuter un BUY sur Boom dans ce cas.
bool IsAtPremiumUpperEdge()
{
   double high[], low[], close[];
   ArraySetAsSeries(high, true); ArraySetAsSeries(low, true); ArraySetAsSeries(close, true);
   if(CopyHigh(_Symbol, PERIOD_H1, 0, 100, high) < 100 || CopyLow(_Symbol, PERIOD_H1, 0, 100, low) < 100 || CopyClose(_Symbol, PERIOD_H1, 0, 100, close) < 100) return false;
   int n = ArraySize(close);
   if(n < 25) return false;
   double sma20[];
   ArrayResize(sma20, n);
   ArraySetAsSeries(sma20, true);
   for(int i = 0; i < n - 20; i++) { double s = 0; for(int j = 0; j < 20; j++) s += close[i + j]; sma20[i] = s / 20; }
   for(int i = n - 20; i < n; i++) sma20[i] = sma20[MathMax(0, n - 21)];
   double eq = sma20[0];
   double premHigh = high[ArrayMaximum(high, 0, 20)];
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if(premHigh <= eq) return false;
   if(ask < eq || ask > premHigh) return false; // pas en zone premium
   double zoneHeight = premHigh - eq;
   double edgeThreshold = premHigh - zoneHeight * 0.15; // bord supÃ©rieur = 15% du haut de la zone
   return (ask >= edgeThreshold);
}

bool PriceTouchesLowerChannel()
{
   string lowerName = "SMC_CH_H1_LOWER";
   if(ObjectFind(0, lowerName) < 0) return false;
   double lowerPrice = ObjectGetDouble(0, lowerName, OBJPROP_PRICE);
   if(lowerPrice <= 0) return false;
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double atrVal = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double atr[];
      ArraySetAsSeries(atr, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, atr) >= 1) atrVal = atr[0];
   }
   if(atrVal <= 0) atrVal = SymbolInfoDouble(_Symbol, SYMBOL_BID) * 0.002;
   double tolerance = atrVal * 0.4;
   return (bid >= lowerPrice - tolerance && bid <= lowerPrice + tolerance);
}

bool PriceTouchesUpperChannel()
{
   string upperName = "SMC_CH_H1_UPPER";
   if(ObjectFind(0, upperName) < 0) return false;
   double upperPrice = ObjectGetDouble(0, upperName, OBJPROP_PRICE);
   if(upperPrice <= 0) return false;
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double atrVal = 0;
   if(atrHandle != INVALID_HANDLE)
   {
      double atr[];
      ArraySetAsSeries(atr, true);
      if(CopyBuffer(atrHandle, 0, 0, 1, atr) >= 1) atrVal = atr[0];
   }
   if(atrVal <= 0) atrVal = SymbolInfoDouble(_Symbol, SYMBOL_BID) * 0.002;
   double tolerance = atrVal * 0.4;
   return (ask >= upperPrice - tolerance && ask <= upperPrice + tolerance);
}

void ExecuteFVGKillBuy()
{
   // VÃ©rifier si l'ATR handle est valide
   if(atrHandle == INVALID_HANDLE) return;
   // STRATÃ‰GIE UNIQUE SPIKE POUR BOOM/CRASH: ne pas utiliser FVG_Kill sur ces indices
   if(SMC_GetSymbolCategory(_Symbol) == SYM_BOOM_CRASH) return;
   
   double atr[];
   ArraySetAsSeries(atr, true);
   if(CopyBuffer(atrHandle, 0, 0, 1, atr) < 1) return;
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, LTF, 0, 3, r) < 3) return;
   double sl = r[1].low - atr[0] * ATR_Mult;
   double tp = SymbolInfoDouble(_Symbol, SYMBOL_ASK) + (SymbolInfoDouble(_Symbol, SYMBOL_ASK) - sl) * 2.0;
   if(IsTerminalFull()) return;
   if(!TryAcquireOpenLock()) return;
   
   // RÃ¨gle duplication / IA avant ouverture d'une nouvelle position
   if(!CanOpenAdditionalPositionForSymbol(_Symbol, "BUY"))
   {
      Print("âŒ FVG_Kill BUY bloquÃ© (rÃ¨gle duplication / IA) sur ", _Symbol);
      ReleaseOpenLock();
      return;
   }
   double lot = CalculateLotSize();
   if(lot <= 0) { ReleaseOpenLock(); return; }
   if(UseSniperScalperMode)
   {
      double askRef = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      double slDistFVGB = MathAbs(askRef - sl);
      double tpDistFVGB = 0;
      if(!SMC_ApplySniperRiskCap(_Symbol, slDistFVGB, lot, tpDistFVGB))
      {
         Print("ðŸš« FVG_Kill BUY bloquÃ© par Sniper Risk Cap sur ", _Symbol);
         ReleaseOpenLock();
         return;
      }
      tp = askRef + tpDistFVGB;
   }
   
   // Exiger une dÃ©cision IA forte pour tous les marchÃ©s non Boom/Crash
   if(!IsAITradeAllowedForDirection("BUY"))
   {
      ReleaseOpenLock();
      return;
   }

   // RÃ©entrÃ©e aprÃ¨s perte sur ce symbole: exiger conditions exceptionnelles (context FVG = setup fort)
   if(!AllowReentryAfterRecentLoss(_Symbol, "BUY", false))
   {
      ReleaseOpenLock();
      return;
   }
   
   // RÃ©initialiser le gain maximum pour la nouvelle position
   g_maxProfit = 0;
   
    if(RequireSMCDerivArrowForAllOrders && !HasRecentSMCDerivArrowForDirection("BUY"))
    {
       Print("ðŸš« FVG_Kill BUY bloquÃ© - Attendre flÃ¨che SMC_DERIV_ARROW BUY sur ", _Symbol);
       ReleaseOpenLock();
      return;
   }
   if(g_smcGomConnected && g_smcGomVerdictNum < 0)
   {
      Print("ðŸš« FVG_Kill BUY BLOQUÃ‰ â€” GOM verdict=", g_smcGomVerdict, " (vn=", g_smcGomVerdictNum, ") â€” direction SELL");
      ReleaseOpenLock(); return;
   }
   if(g_smcGomConnected && g_smcGomVerdictNum == 0)
   {
      Print("ðŸš« FVG_Kill BUY BLOQUÃ‰ â€” GOM verdict=WAIT (vn=0) â€” pas de direction");
      ReleaseOpenLock(); return;
   }
   if(!CanTradeOnSymbol(_Symbol, "BUY")) { Print("ðŸš« FVG_Kill BUY BLOQUÃ‰ â€” Terminal plein, sens interdit, retournement ou ordre existant sur ", _Symbol); ReleaseOpenLock(); return; }
   if(!SMC_FinalOpenGate(_Symbol, ORDER_TYPE_BUY)) { ReleaseOpenLock(); return; }
   if(SafeTradeBuy(lot, _Symbol, 0, sl, tp, "FVG_Kill BUY"))
   {
      RegisterOrderPlaced();
      SMC_GateRegisterOpened(_Symbol, true);
      ulong ticket = trade.ResultOrder();
      if(ticket > 0) SMC_ApplyPostEntrySLBuffer(_Symbol, ticket, 1.0);
   }
   ReleaseOpenLock();
   if(trade.ResultRetcode() == TRADE_RETCODE_DONE && UseNotifications)
   { Alert("FVG_Kill BUY ", _Symbol); SendNotification("FVG_Kill BUY " + _Symbol); }
}
void ExecuteFVGKillSell()
{
   // VÃ©rifier si l'ATR handle est valide
   if(atrHandle == INVALID_HANDLE) return;
   // STRATÃ‰GIE UNIQUE SPIKE POUR BOOM/CRASH: ne pas utiliser FVG_Kill sur ces indices
   if(SMC_GetSymbolCategory(_Symbol) == SYM_BOOM_CRASH) return;
   
   double atr[];
   ArraySetAsSeries(atr, true);
   if(CopyBuffer(atrHandle, 0, 0, 1, atr) < 1) return;
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(_Symbol, LTF, 0, 3, r) < 3) return;
   double sl = r[1].high + atr[0] * ATR_Mult;
   double tp = SymbolInfoDouble(_Symbol, SYMBOL_BID) - (sl - SymbolInfoDouble(_Symbol, SYMBOL_BID)) * 2.0;
   if(IsTerminalFull()) return;
   if(!TryAcquireOpenLock()) return;
   
   if(!CanOpenAdditionalPositionForSymbol(_Symbol, "SELL"))
   {
      Print("âŒ FVG_Kill SELL bloquÃ© (rÃ¨gle duplication / IA) sur ", _Symbol);
      ReleaseOpenLock();
      return;
   }
   double lot = CalculateLotSize();
   if(lot <= 0) { ReleaseOpenLock(); return; }
   if(UseSniperScalperMode)
   {
      double bidRef = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      double slDistFVGS = MathAbs(sl - bidRef);
      double tpDistFVGS = 0;
      if(!SMC_ApplySniperRiskCap(_Symbol, slDistFVGS, lot, tpDistFVGS))
      {
         Print("ðŸš« FVG_Kill SELL bloquÃ© par Sniper Risk Cap sur ", _Symbol);
         ReleaseOpenLock();
         return;
      }
      tp = bidRef - tpDistFVGS;
   }
   
   // Exiger une dÃ©cision IA forte pour tous les marchÃ©s non Boom/Crash
   if(!IsAITradeAllowedForDirection("SELL"))
   {
      ReleaseOpenLock();
      return;
   }

   // RÃ©entrÃ©e aprÃ¨s perte sur ce symbole: exiger conditions exceptionnelles (context FVG = setup fort)
   if(!AllowReentryAfterRecentLoss(_Symbol, "SELL", false))
   {
      ReleaseOpenLock();
      return;
   }
   
   // RÃ©initialiser le gain maximum pour la nouvelle position
   g_maxProfit = 0;
   
    if(RequireSMCDerivArrowForAllOrders && !HasRecentSMCDerivArrowForDirection("SELL"))
    {
       Print("ðŸš« FVG_Kill SELL bloquÃ© - Attendre flÃ¨che SMC_DERIV_ARROW SELL sur ", _Symbol);
       ReleaseOpenLock();
      return;
   }
   if(g_smcGomConnected && g_smcGomVerdictNum > 0)
   {
      Print("ðŸš« FVG_Kill SELL BLOQUÃ‰ â€” GOM verdict=", g_smcGomVerdict, " (vn=", g_smcGomVerdictNum, ") â€” direction BUY");
      ReleaseOpenLock(); return;
   }
   if(g_smcGomConnected && g_smcGomVerdictNum == 0)
   {
      Print("ðŸš« FVG_Kill SELL BLOQUÃ‰ â€” GOM verdict=WAIT (vn=0) â€” pas de direction");
      ReleaseOpenLock(); return;
   }
   if(!CanTradeOnSymbol(_Symbol, "SELL")) { Print("ðŸš« FVG_Kill SELL BLOQUÃ‰ â€” Terminal plein, sens interdit, retournement ou ordre existant sur ", _Symbol); ReleaseOpenLock(); return; }
   if(!SMC_FinalOpenGate(_Symbol, ORDER_TYPE_SELL)) { ReleaseOpenLock(); return; }
   if(SafeTradeSell(lot, _Symbol, 0, sl, tp, "FVG_Kill SELL"))
   {
      RegisterOrderPlaced();
      SMC_GateRegisterOpened(_Symbol, false);
      ulong ticket = trade.ResultOrder();
      if(ticket > 0) SMC_ApplyPostEntrySLBuffer(_Symbol, ticket, 1.0);
   }
   ReleaseOpenLock();
   if(trade.ResultRetcode() == TRADE_RETCODE_DONE && UseNotifications)
   { Alert("FVG_Kill SELL ", _Symbol); SendNotification("FVG_Kill SELL " + _Symbol); }
}

int CountPositionsForSymbol(string symbol)
{
   int n = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) == symbol)
         n++;
   }
   return n;
}

// Retourne true si une position "SPIKE TRADE" est dÃ©jÃ  ouverte sur ce symbole
bool HasOpenSpikeTradeForSymbol(string symbol)
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) 
         continue;
      if(posInfo.Magic() != InpMagicNumber) 
         continue;
      if(posInfo.Symbol() != symbol) 
         continue;
      
      string comment = posInfo.Comment();
      if(StringFind(comment, "SPIKE TRADE") >= 0)
         return true;
   }
   return false;
}

int CountPositionsOurEA()
{
   int n = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
      if(posInfo.SelectByIndex(i) && posInfo.Magic() == InpMagicNumber)
         n++;
   return n;
}

//+------------------------------------------------------------------+
//| Anti-hedge ABSOLU : jamais BUY+SELL mÃªme symbole (notre magic)   |
//| Si Ã©tat MIXED dÃ©tectÃ© â†’ ferme la jambe la plus rÃ©cente (ou la    |
//| plus perdante). AppelÃ© chaque tick.                              |
//+------------------------------------------------------------------+
void SMC_EnforceNoHedgeAllSymbols()
{
   // Collecter symboles avec positions de notre EA
   string syms[];
   int nSym = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      string sy = posInfo.Symbol();
      bool known = false;
      for(int k = 0; k < nSym; k++)
         if(syms[k] == sy) { known = true; break; }
      if(!known)
      {
         ArrayResize(syms, nSym + 1);
         syms[nSym++] = sy;
      }
   }

   for(int s = 0; s < nSym; s++)
   {
      string sy = syms[s];
      ulong buyTk = 0, sellTk = 0;
      datetime buyT = 0, sellT = 0;
      double buyPl = 0, sellPl = 0;
      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         if(!posInfo.SelectByIndex(i)) continue;
         if(posInfo.Magic() != InpMagicNumber) continue;
         if(posInfo.Symbol() != sy) continue;
         double pl = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
         datetime ot = (datetime)posInfo.Time();
         if(posInfo.PositionType() == POSITION_TYPE_BUY)
         {
            if(buyTk == 0 || ot > buyT) { buyTk = posInfo.Ticket(); buyT = ot; buyPl = pl; }
         }
         else
         {
            if(sellTk == 0 || ot > sellT) { sellTk = posInfo.Ticket(); sellT = ot; sellPl = pl; }
         }
      }
      if(buyTk == 0 || sellTk == 0) continue;

      // Hedge dÃ©tectÃ© : fermer la position la plus rÃ©cente (entrÃ©e fautive)
      ulong closeTk = (buyT >= sellT) ? buyTk : sellTk;
      string closeDir = (closeTk == buyTk) ? "BUY" : "SELL";
      Print("ðŸš¨ ANTI-HEDGE ENFORCE â€” ", sy, " a BUY+SELL simultanÃ©s ! Fermeture ",
            closeDir, " #", closeTk, " (plus rÃ©cente). ConservÃ© l'autre sens.");
      PositionCloseWithLog(closeTk, "ANTI-HEDGE enforce - jambe opposee", true);
   }

   // FIX v1.35: 1 seule position par symbole (SFX VOL pile interdite)
   if(OnePositionPerSymbol)
   {
      for(int s = 0; s < nSym; s++)
      {
         string sy = syms[s];
         ulong tks[];
         datetime tms[];
         double pls[];
         int n = 0;
         for(int i = PositionsTotal() - 1; i >= 0; i--)
         {
            if(!posInfo.SelectByIndex(i)) continue;
            if(posInfo.Magic() != InpMagicNumber) continue;
            if(posInfo.Symbol() != sy) continue;
            ArrayResize(tks, n + 1);
            ArrayResize(tms, n + 1);
            ArrayResize(pls, n + 1);
            tks[n] = posInfo.Ticket();
            tms[n] = (datetime)posInfo.Time();
            pls[n] = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
            n++;
         }
         if(n <= 1) continue;
         // Garder la plus ancienne (ou la plus profitable si mÃªme seconde)
         int keep = 0;
         for(int k = 1; k < n; k++)
         {
            if(tms[k] < tms[keep] || (tms[k] == tms[keep] && pls[k] > pls[keep]))
               keep = k;
         }
         for(int k = 0; k < n; k++)
         {
            if(k == keep) continue;
            Print("ðŸš¨ 1 POS/SYMBOLE â€” fermeture doublon #", tks[k], " ", sy,
                  " | conservÃ© #", tks[keep]);
            PositionCloseWithLog(tks[k], "1 pos/symbole - doublon", true);
         }
      }
   }

   // Aussi : plus d'1 position globale EA â†’ fermer les plus rÃ©centes au-delÃ  de MaxPositionsTerminal
   int cap = MathMax(1, MaxPositionsTerminal);
   int our = CountPositionsOurEA();
   if(our > cap)
   {
      // Trier par temps ouverture desc, fermer surplus
      ulong tks[];
      datetime tms[];
      int n = 0;
      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         if(!posInfo.SelectByIndex(i)) continue;
         if(posInfo.Magic() != InpMagicNumber) continue;
         ArrayResize(tks, n + 1);
         ArrayResize(tms, n + 1);
         tks[n] = posInfo.Ticket();
         tms[n] = (datetime)posInfo.Time();
         n++;
      }
      // bubble: plus rÃ©cent en premier
      for(int a = 0; a < n; a++)
         for(int b = a + 1; b < n; b++)
            if(tms[b] > tms[a])
            {
               datetime td = tms[a]; tms[a] = tms[b]; tms[b] = td;
               ulong tk = tks[a]; tks[a] = tks[b]; tks[b] = tk;
            }
      for(int k = cap; k < n; k++)
      {
         Print("ðŸš¨ CAP GLOBAL â€” fermeture surplus #", tks[k], " (", k + 1, "/", n,
               ") MaxPositionsTerminal=", cap);
         PositionCloseWithLog(tks[k], "CAP global - surplus position", true);
      }
   }
}


//+------------------------------------------------------------------+
//| Compte TOUT : positions + pending orders, tous magics, terminal  |
//| UtilisÃ© pour le gate MaxPositionsTerminal (max 2 au total)       |
//+------------------------------------------------------------------+
int CountTerminalAllOrders()
{
   int count = 0;
   count += PositionsTotal();
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(t == ORDER_TYPE_BUY_LIMIT || t == ORDER_TYPE_SELL_LIMIT ||
         t == ORDER_TYPE_BUY_STOP  || t == ORDER_TYPE_SELL_STOP)
         count++;
   }
   return count;
}

//+------------------------------------------------------------------+
//| VÃ©rifie si le terminal est plein                                  |
//| Compte TOUT: positions ouvertes + pending orders, tous symboles   |
//| Les pending orders sont visibles immÃ©diatement aprÃ¨s OrderSend    |
//+------------------------------------------------------------------+
bool IsTerminalFull()
{
   // FIX v1.18: 1 seule position de NOTRE EA dans tout le terminal
   int ourPos = CountPositionsOurEA();
   if(ourPos >= MathMax(1, MaxPositionsTerminal))
      return true;
   // Filet: aussi positions+pending global si cap strict
   if(CountTerminalAllOrders() >= MathMax(1, MaxPositionsTerminal) + 5)
      return true; // laisse un peu de marge pour pending d'autres EA
   return false;
}

// Verrou GLOBAL inter-graphiques (GlobalVariable) â€” anti double ordre mÃªme tick
bool SMC_AcquireTerminalOpenLock()
{
   string key = "SMC_TERM_OPEN_" + IntegerToString(InpMagicNumber);
   datetime now = TimeCurrent();
   if(GlobalVariableCheck(key))
   {
      double v = GlobalVariableGet(key);
      // lock actif si posÃ© il y a < 90s
      if(v > 0 && (now - (datetime)v) < 90)
      {
         // VÃ©rifier s'il y a vraiment dÃ©jÃ  une position; sinon lock pÃ©rimÃ© logique
         if(CountPositionsOurEA() >= 1)
            return false;
         // Pas de position mais lock rÃ©cent: autre chart en train d'ouvrir
         if((now - (datetime)v) < 15)
            return false;
      }
   }
   GlobalVariableSet(key, (double)now);
   return true;
}

void SMC_ReleaseTerminalOpenLock()
{
   string key = "SMC_TERM_OPEN_" + IntegerToString(InpMagicNumber);
   // Ne libÃ©rer que si plus aucune position (sinon le lock reste jusqu'Ã  fermeture)
   if(CountPositionsOurEA() == 0 && GlobalVariableCheck(key))
      GlobalVariableDel(key);
}

bool SMC_TerminalHasOurPosition()
{
   return (CountPositionsOurEA() >= 1);
}

//+------------------------------------------------------------------+
//| Compte les positions + pending orders pour UN symbole donnÃ©      |
//+------------------------------------------------------------------+
int CountOrdersForSymbol(const string symbol)
{
   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      if(posInfo.Symbol() == symbol)
         count++;
   }
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if((long)OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      if(OrderGetString(ORDER_SYMBOL) == symbol)
      {
         ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
         if(t == ORDER_TYPE_BUY_LIMIT || t == ORDER_TYPE_SELL_LIMIT ||
            t == ORDER_TYPE_BUY_STOP  || t == ORDER_TYPE_SELL_STOP)
            count++;
      }
   }
   return count;
}

//+------------------------------------------------------------------+
//| VÃ©rifie si un symbole a dÃ©jÃ  un ordre actif (position ou pending)|
//+------------------------------------------------------------------+
bool SymbolHasActiveOrder(const string symbol)
{
   return CountOrdersForSymbol(symbol) > 0;
}

//+------------------------------------------------------------------+
//| Retourne "BUY"/"SELL" si notre EA a une position ouverte sur ce  |
//| symbole, "" si aucune position                                   |
//+------------------------------------------------------------------+
string GetOpenPositionDirectionForSymbol(const string symbol)
{
   string found = "";
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      if(posInfo.Symbol() != symbol) continue;

      string dir = (posInfo.PositionType() == POSITION_TYPE_BUY) ? "BUY" : "SELL";
      if(found == "") found = dir;
      else if(found != dir) return "MIXED"; // Etat interdit dÃ©tectÃ© sur compte hedging
   }
   return found;
}

int SMC_CountPositionsByDirection(const string symbol, const string direction)
{
   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber || posInfo.Symbol() != symbol) continue;
      bool isBuy = (posInfo.PositionType() == POSITION_TYPE_BUY);
      if((direction == "BUY" && isBuy) || (direction == "SELL" && !isBuy)) count++;
   }
   return count;
}

int SMC_EstimatedEntryUnits(const string symbol, const string direction)
{
   double minLot = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
   if(minLot <= 0) minLot = 0.01;
   double volume = 0.0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber || posInfo.Symbol() != symbol) continue;
      bool isBuy = (posInfo.PositionType() == POSITION_TYPE_BUY);
      if((direction == "BUY" && isBuy) || (direction == "SELL" && !isBuy))
         volume += posInfo.Volume();
   }
   if(volume <= 0) return 0;
   return MathMax(1, (int)MathCeil(volume / minLot - 1e-8));
}

datetime SMC_LastPositionOpenTime(const string symbol, const string direction)
{
   datetime latest = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber || posInfo.Symbol() != symbol) continue;
      bool isBuy = (posInfo.PositionType() == POSITION_TYPE_BUY);
      if((direction == "BUY" && isBuy) || (direction == "SELL" && !isBuy))
         latest = MathMax(latest, (datetime)posInfo.Time());
   }
   return latest;
}

int SMC_CurrentGOMQuality(const string symbol, const string direction)
{
   int vn = (symbol == _Symbol) ? g_smcGomVerdictNum : SMCGP_GetCachedVerdictNum(symbol);
   if(vn == -999) return 0;
   if(direction == "BUY" && vn < 0) return 0;
   if(direction == "SELL" && vn > 0) return 0;
   return MathAbs(vn); // 2=GOOD, 3+=PERFECT
}

bool SMC_HasOppositePendingOrder(const string symbol, const string direction)
{
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if((long)OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      if(OrderGetString(ORDER_SYMBOL) != symbol) continue;
      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      bool buyPending = (t == ORDER_TYPE_BUY_LIMIT || t == ORDER_TYPE_BUY_STOP || t == ORDER_TYPE_BUY_STOP_LIMIT);
      bool sellPending = (t == ORDER_TYPE_SELL_LIMIT || t == ORDER_TYPE_SELL_STOP || t == ORDER_TYPE_SELL_STOP_LIMIT);
      if((direction == "BUY" && sellPending) || (direction == "SELL" && buyPending)) return true;
   }
   return false;
}

bool SMC_CancelOppositePendingOrders(const string symbol, const string direction)
{
   bool found = false;
   bool allDeleted = true;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if((long)OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      if(OrderGetString(ORDER_SYMBOL) != symbol) continue;
      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      bool buyPending = (t == ORDER_TYPE_BUY_LIMIT || t == ORDER_TYPE_BUY_STOP || t == ORDER_TYPE_BUY_STOP_LIMIT);
      bool sellPending = (t == ORDER_TYPE_SELL_LIMIT || t == ORDER_TYPE_SELL_STOP || t == ORDER_TYPE_SELL_STOP_LIMIT);
      bool opposite = (direction == "BUY" && sellPending) || (direction == "SELL" && buyPending);
      if(!opposite) continue;
      found = true;
      if(!trade.OrderDelete(ticket))
      {
         allDeleted = false;
         Print("âŒ ANTI-HEDGE â€” suppression pending opposÃ© Ã©chouÃ©e #", ticket,
               " retcode=", trade.ResultRetcode(), " ", trade.ResultRetcodeDescription());
      }
      else
         Print("ðŸ§¹ ANTI-HEDGE â€” pending opposÃ© supprimÃ© #", ticket, " avant signal ", direction, " sur ", symbol);
   }
   return (!found || allDeleted);
}

void SMC_EnforceNoHedgeState(const string symbol)
{
   static datetime s_lastCheck = 0;
   if(TimeCurrent() == s_lastCheck) return; // une vÃ©rification par seconde suffit
   s_lastCheck = TimeCurrent();

   string state = GetOpenPositionDirectionForSymbol(symbol);
   if(state == "BUY" || state == "SELL")
   {
      // Une position peut coexister avec un vieux pending opposÃ© : le supprimer.
      SMC_CancelOppositePendingOrders(symbol, state);
      return;
   }
   if(state != "MIXED") return;

   // Etat interdit dÃ©jÃ  prÃ©sent : conserver prioritairement le sens GOOD/PERFECT.
   string keepDirection = "";
   if(MathAbs(g_smcGomVerdictNum) >= 2)
      keepDirection = (g_smcGomVerdictNum > 0) ? "BUY" : "SELL";
   else if(IsBoomLikeSymbol(symbol))
      keepDirection = "BUY";
   else if(IsCrashLikeSymbol(symbol))
      keepDirection = "SELL";

   // Sans verdict exploitable, conserver la position la plus ancienne.
   if(keepDirection == "")
   {
      datetime oldest = 0;
      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         if(!posInfo.SelectByIndex(i)) continue;
         if(posInfo.Magic() != InpMagicNumber || posInfo.Symbol() != symbol) continue;
         datetime opened = (datetime)posInfo.Time();
         if(oldest == 0 || opened < oldest)
         {
            oldest = opened;
            keepDirection = (posInfo.PositionType() == POSITION_TYPE_BUY) ? "BUY" : "SELL";
         }
      }
   }

   Print("ðŸš¨ ANTI-HEDGE HARD â€” BUY+SELL dÃ©tectÃ©s sur ", symbol,
         " | sens conservÃ©=", keepDirection);

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber || posInfo.Symbol() != symbol) continue;
      string dir = (posInfo.PositionType() == POSITION_TYPE_BUY) ? "BUY" : "SELL";
      if(dir == keepDirection) continue;

      ulong ticket = posInfo.Ticket();
      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      if(trade.PositionClose(ticket))
         Print("âœ… ANTI-HEDGE HARD â€” position opposÃ©e ", dir, " fermÃ©e #", ticket,
               " | P/L=", DoubleToString(profit, 2), "$");
      else
         Print("âŒ ANTI-HEDGE HARD â€” Ã©chec fermeture #", ticket,
               " retcode=", trade.ResultRetcode(), " ", trade.ResultRetcodeDescription());
   }

   if(keepDirection != "") SMC_CancelOppositePendingOrders(symbol, keepDirection);
}

//+------------------------------------------------------------------+
//| BLINDAGE DUR â€” DERNIER REMPART : quel que soit le module qui a   |
//| ouvert un ordre (y compris un chemin non auditÃ©/bug), on ferme   |
//| ou supprime IMMÃ‰DIATEMENT toute position/pending dont le sens    |
//| viole la rÃ¨gle Boom/Crash/Painx/Gainx :                          |
//|   Boom/Gainx  â†’ BUY uniquement                                   |
//|   Crash/Painx â†’ SELL uniquement                                  |
//| Ceci s'exÃ©cute AVANT toute autre logique dans OnTick() afin       |
//| qu'aucun ordre contre-tendance ne puisse survivre au-delÃ  du      |
//| tick oÃ¹ il apparaÃ®t.                                              |
//+------------------------------------------------------------------+
void SMC_EnforceDirectionRuleHard(const string symbol)
{
   if(!SMC_IsSpikeStyleSymbol(symbol)) return; // rÃ¨gle spÃ©cifique Boom/Crash/Painx/Gainx uniquement

   // 1) Positions ouvertes dans le mauvais sens â†’ fermeture immÃ©diate
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber || posInfo.Symbol() != symbol) continue;

      string dir = (posInfo.PositionType() == POSITION_TYPE_BUY) ? "BUY" : "SELL";
      if(IsDirectionAllowedForBoomCrash(symbol, dir)) continue;

      ulong  ticket = posInfo.Ticket();
      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      // v1.34: attendre au moins -1$ avant fermeture structure contre-tendance
      if(profit > -1.0)
      {
         static datetime s_dirSoft = 0;
         if(TimeCurrent() - s_dirSoft >= 60)
         {
            s_dirSoft = TimeCurrent();
            Print("â³ DIRECTION-GUARD â€” contre-tendance mais P/L=", DoubleToString(profit, 2),
                  "$ > -1$ â€” pas de close anticipÃ© #", ticket);
         }
         continue;
      }
      if(trade.PositionClose(ticket))
         Print("ðŸš¨ DIRECTION-GUARD â€” position CONTRE-TENDANCE ", dir, " fermÃ©e #", ticket,
               " sur ", symbol, " | P/L=", DoubleToString(profit, 2), "$");
      else
         Print("âŒ DIRECTION-GUARD â€” Ã©chec fermeture contre-tendance #", ticket,
               " retcode=", trade.ResultRetcode(), " ", trade.ResultRetcodeDescription());
   }

   // 2) Pending orders dans le mauvais sens â†’ suppression immÃ©diate
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if((long)OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      if(OrderGetString(ORDER_SYMBOL) != symbol) continue;

      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      string dir = "";
      if(t == ORDER_TYPE_BUY_LIMIT || t == ORDER_TYPE_BUY_STOP || t == ORDER_TYPE_BUY_STOP_LIMIT)
         dir = "BUY";
      else if(t == ORDER_TYPE_SELL_LIMIT || t == ORDER_TYPE_SELL_STOP || t == ORDER_TYPE_SELL_STOP_LIMIT)
         dir = "SELL";
      if(dir == "" || IsDirectionAllowedForBoomCrash(symbol, dir)) continue;

      if(trade.OrderDelete(ticket))
         Print("ðŸš¨ DIRECTION-GUARD â€” pending CONTRE-TENDANCE ", dir, " supprimÃ© #", ticket, " sur ", symbol);
      else
         Print("âŒ DIRECTION-GUARD â€” Ã©chec suppression pending contre-tendance #", ticket,
               " retcode=", trade.ResultRetcode(), " ", trade.ResultRetcodeDescription());
   }
}

//+------------------------------------------------------------------+
//| GARDE VERDICT LIVE : SMC_EnforceDirectionRuleHard() ne vÃ©rifie   |
//| que la rÃ¨gle STRUCTURELLE de famille (GainX/Boom=BUY,             |
//| PainX/Crash=SELL) via IsDirectionAllowedForBoomCrash() â€” un BUY   |
//| sur GainX y est donc toujours "autorisÃ©" mÃªme si le verdict GOM   |
//| du moment est baissier. Cette garde-ci ferme/supprime en plus,    |
//| Ã  chaque tick (pas de discipline d'Ã¢ge), TOUTE position ou pending|
//| de l'EA (magic InpMagicNumber) dont le sens contredit le SIGNE    |
//| LIVE de g_smcGomVerdictNum â€” quel que soit le module qui l'a      |
//| ouvert (DOW, GOM-ALIGN, RSI-SQUEEZE, IMPULSE, IA/ai_server, etc.).|
//| FIX 2026-09-17 (Claude, capture d'Ã©cran Sidoine) : la portÃ©e Ã©tait|
//| jusqu'ici restreinte aux positions/pendings commentÃ©s "DOW", donc |
//| un SELL ouvert par un autre module restait ouvert indÃ©finiment    |
//| pendant que le verdict live repassait haussier (HOLD L).          |
//| FIX 2026-09-10 (Claude, demande Sidoine) : cause du BUY exÃ©cutÃ©   |
//| et laissÃ© ouvert sur GainX 800 pendant un verdict WAIT/tendance   |
//| SELL forte.                                                       |
//+------------------------------------------------------------------+
void SMC_EnforceDowLiveVerdictGuard(const string symbol)
{
   if(!g_smcGomConnected || g_smcGomVerdictNum == 0) return; // WAIT strict: laissÃ© Ã  SMC_CancelAllPendingOnGomWait / CloseOnVerdictWait
   bool verdictBearish = (g_smcGomVerdictNum < 0);

   // 1) Positions ouvertes Ã  contre-sens du verdict live
   // FIX: cette garde ne surveillait QUE les positions commentÃ©es "DOW",
   // laissant sans protection toute position ouverte par un autre module
   // (GOM-ALIGN, RSI-SQUEEZE, IMPULSE, IA/ai_server contre-tendance, etc.)
   // quand le verdict live devenait ensuite opposÃ© Ã  son sens â€” exactement
   // le scÃ©nario "SELL ouvert pendant que GOM affiche HOLD L" remontÃ© par
   // Sidoine. On applique dÃ©sormais la rÃ¨gle Ã  TOUTE position de l'EA sur
   // ce symbole, plus seulement Ã  celles taguÃ©es "DOW".
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber || posInfo.Symbol() != symbol) continue;

      bool posBuy = (posInfo.PositionType() == POSITION_TYPE_BUY);
      bool contradicts = (posBuy && verdictBearish) || (!posBuy && !verdictBearish);
      if(!contradicts) continue;

      ulong  ticket = posInfo.Ticket();
      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      // v1.34: ne pas fermer structure/verdict tant que perte < 1$
      if(profit > -1.0)
      {
         static datetime s_softV = 0;
         if(TimeCurrent() - s_softV >= 60)
         {
            s_softV = TimeCurrent();
            Print("â³ LIVE-VERDICT-GUARD â€” contre-sens mais P/L=", DoubleToString(profit, 2),
                  "$ > -1$ â€” on laisse respirer #", ticket);
         }
         continue;
      }
      if(PositionCloseWithLog(ticket, "LIVE-VERDICT-GUARD: verdict live opposÃ© (vn=" + IntegerToString(g_smcGomVerdictNum) + ")", true))
         Print("ðŸš¨ LIVE-VERDICT-GUARD â€” position ", (posBuy ? "BUY" : "SELL"), " fermÃ©e #", ticket,
               " sur ", symbol, " | verdict live vn=", g_smcGomVerdictNum, " | P/L=", DoubleToString(profit, 2), "$");
   }

   // 2) Pendings Ã  contre-sens du verdict live (mÃªme Ã©largissement qu'au-dessus,
   // plus seulement "DOW" â€” un pending contraire au verdict live ne devrait
   // jamais rester armÃ©, quel que soit le module qui l'a posÃ©).
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if((long)OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      if(OrderGetString(ORDER_SYMBOL) != symbol) continue;

      ENUM_ORDER_TYPE t = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      bool ordBuy;
      if(t == ORDER_TYPE_BUY_LIMIT || t == ORDER_TYPE_BUY_STOP || t == ORDER_TYPE_BUY_STOP_LIMIT) ordBuy = true;
      else if(t == ORDER_TYPE_SELL_LIMIT || t == ORDER_TYPE_SELL_STOP || t == ORDER_TYPE_SELL_STOP_LIMIT) ordBuy = false;
      else continue;

      bool contradicts = (ordBuy && verdictBearish) || (!ordBuy && !verdictBearish);
      if(!contradicts) continue;

      if(LimitSafeOrderDelete(ticket, true, "LIVE-VERDICT-GUARD verdict live opposÃ©"))
         Print("ðŸš¨ LIVE-VERDICT-GUARD â€” pending ", (ordBuy ? "BUY" : "SELL"), " supprimÃ© #", ticket,
               " sur ", symbol, " | verdict live vn=", g_smcGomVerdictNum);
   }
}

//+------------------------------------------------------------------+
//| RETOURNEMENT DE TENDANCE : un ordre contraire est demandÃ© sur un |
//| symbole oÃ¹ une position "normale" est dÃ©jÃ  ouverte dans le sens  |
//| opposÃ©. Au lieu de laisser cet ordre contraire s'exÃ©cuter (ce qui|
//| crÃ©erait un hedge BUY+SELL simultanÃ© sur la mÃªme position), on   |
//| clÃ´ture la position normale en cours : l'ordre contraire est     |
//| interprÃ©tÃ© comme un signal que la tendance part contre elle.     |
//+------------------------------------------------------------------+
void SMC_CloseOnReversalSignal(const string symbol, const string newDirection)
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      if(posInfo.Symbol() != symbol) continue;

      string curDir = (posInfo.PositionType() == POSITION_TYPE_BUY) ? "BUY" : "SELL";
      if(curDir == newDirection) continue; // mÃªme sens : rien Ã  faire ici

      ulong  ticket = posInfo.Ticket();
      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      if(PositionCloseWithLog(ticket,
            "RETOURNEMENT - ordre " + newDirection + " contraire dÃ©tectÃ© sur " + symbol +
            ", clÃ´ture position " + curDir + " normale", true))
      {
         Print("ðŸ”„ REVERSAL ", symbol, ": position ", curDir, " (ticket #", ticket,
               ", P/L=", DoubleToString(profit, 2), "$) clÃ´turÃ©e â€” ordre contraire ",
               newDirection, " dÃ©tectÃ© = tendance inversÃ©e contre la position normale");
         if(UseNotifications)
            SendNotification("ðŸ”„ " + symbol + ": " + curDir + " clÃ´turÃ©e (retournement " + newDirection + ")");
      }
   }
}

//+------------------------------------------------------------------+
//| Gate combinÃ© et UNIVERSEL avant tout SafeTradeBuy/SafeTradeSell : |
//| 1) Terminal plein â†’ refus                                        |
//| 2) Symbole Boom/Crash/Painx/Gainx : sens interdit â†’ refus DÃ‰FINITIF|
//|    (Boom/Gainx = BUY uniquement, Crash/Painx = SELL uniquement,   |
//|    quelle que soit la stratÃ©gie qui appelle ce gate)              |
//| 3) Position ouverte en sens opposÃ© sur ce symbole â†’ au lieu de    |
//|    laisser le nouvel ordre contraire s'exÃ©cuter (hedge), on       |
//|    clÃ´ture la position normale en cours et on refuse ce tick-ci   |
//|    (une nouvelle entrÃ©e sera rÃ©Ã©valuÃ©e normalement au tick suivant)|
//| 4) Position/ordre dÃ©jÃ  actif dans le mÃªme sens â†’ refus (doublon)  |
//+------------------------------------------------------------------+
bool CanTradeOnSymbol(const string symbol, const string direction = "")
{
   int requestedDir = (direction == "BUY") ? 1 : ((direction == "SELL") ? -1 : 0);
   bool spikeHTFOverride = SMC_SpikeBlink_HTFOverrideInFlight(symbol, requestedDir);
      if(IsTerminalFull()) return false;
   if(!g_dowPriceLeadInFlight && SMC_ReactionEntryBlocked(symbol, direction)) return false;
   // FIX v1.14
   if(!SMC_LowCapitalAllowsSymbol(symbol)) return false;
   if(!SMC_SpreadAllowsEntry(symbol)) return false;
   if(AccountInfoDouble(ACCOUNT_MARGIN_FREE) < 1.0) return false;

   // PRO v1.55 â€” stop journalier global + cooldown global + score de confluence
   if(!PRO_CanTradeGate(symbol, direction)) return false;

   // â”€â”€ GAIN COOLDOWN: pause aprÃ¨s gain rÃ©cent sur ce symbole (demande Sidoine) â”€â”€
   // Ã‰vite la rÃ©entrÃ©e immÃ©diate aprÃ¨s un gain pour attendre une nouvelle entrÃ©e bien calculÃ©e
   static datetime s_canTradeLog = 0;
   if(TimeCurrent() - s_canTradeLog >= 30)
   {
      Print("[CanTradeOnSymbol] ", symbol, " | UseGainCooldown=", UseGainCooldown, " | g_lastGainSymbol='", g_lastGainSymbol, "' | g_lastGainTime=", TimeToString(g_lastGainTime, TIME_DATE|TIME_MINUTES));
      s_canTradeLog = TimeCurrent();
   }

   if(UseGainCooldown && !SMC_SpikeChainReentryWindow(requestedDir) && IsRecentGainOnSymbol(symbol))
   {
      int remain = (int)(GainCooldownMinutes * 60 - (TimeCurrent() - g_lastGainTime));
      if(remain > 0)
      {
         static datetime s_lastGainCoolLog = 0;
         if(TimeCurrent() - s_lastGainCoolLog >= 15)
         {
            Print("â³ GAIN COOLDOWN â€” ", symbol, " : ", remain, "s restantes avant rÃ©entrÃ©e autorisÃ©e");
            s_lastGainCoolLog = TimeCurrent();
         }
         return false;
      }
   }
   // WAIT = jamais (sauf symboles synthÃ©tiques autonomes : FXVOL, FLIPX, PLUSX, Boom/Crash, PainX/GainX)
   bool isSynthAutoCanTrade = SMC_IsSyntheticAutonomousSym(symbol);
   if(!isSynthAutoCanTrade && !spikeHTFOverride &&
      (!g_smcGomConnected || g_smcGomVerdictNum == 0 || g_smcGomVerdictNum == -999))
   {
      Print("ðŸš« CanTrade â€” WAIT/OFF, aucun ordre sur ", symbol);
      return false;
   }

   // Tout nouvel ordre doit annoncer son sens afin que l'anti-hedge soit vÃ©rifiable.

   if(direction != "BUY" && direction != "SELL")
   {
      Print("ðŸš« TRADE BLOQUÃ‰ â€” direction absente/invalide pour ", symbol);
      return false;
   }

   if(!IsDirectionAllowedForBoomCrash(symbol, direction))
   {
      static datetime s_lastDirBlockLog = 0;
      if(TimeCurrent() - s_lastDirBlockLog >= 15)
      {
         Print("ðŸš« DIRECTION INTERDITE â€” ", direction, " refusÃ© sur ", symbol,
               " (Boom/Gainx=BUY seul, Crash/Painx=SELL seul)");
         s_lastDirBlockLog = TimeCurrent();
      }
      return false;
   }

   // Un pending inverse pourrait se dÃ©clencher aprÃ¨s le market order : le supprimer,
   // puis attendre le tick suivant afin de confirmer sa disparition cÃ´tÃ© serveur.
   if(SMC_HasOppositePendingOrder(symbol, direction))
   {
      SMC_CancelOppositePendingOrders(symbol, direction);
      return false;
   }

   string curDir = GetOpenPositionDirectionForSymbol(symbol);

   // Etat hÃ©ritÃ© interdit (BUY et SELL dÃ©jÃ  ouverts) : ne jamais rajouter d'exposition.
   // On conserve le sens du nouveau signal et tente de fermer toutes les jambes opposÃ©es.
   if(curDir == "MIXED")
   {
      Print("ðŸš¨ ANTI-HEDGE â€” Ã©tat MIXED dÃ©tectÃ© sur ", symbol,
            "; fermeture des positions opposÃ©es au signal ", direction);
      SMC_CloseOnReversalSignal(symbol, direction);
      return false;
   }

   // Position inverse ouverte : fermer l'inverse et ne PAS entrer pendant le mÃªme tick.
   if(curDir != "" && curDir != direction)
   {
      Print("âš ï¸ CONFLIT DÃ‰TECTÃ‰ sur ", symbol, " : position ", curDir,
            " en cours, signal ", direction, " reÃ§u â€” nouvel ordre refusÃ©.");
      SMC_CloseOnReversalSignal(symbol, direction);
      return false;
   }

   // Aucun trade ouvert : interdire tout market si un pending, mÃªme sens, est dÃ©jÃ  armÃ©.
   int activeForEA = CountOrdersForSymbol(symbol);
   int openForEA = CountPositionsForSymbol(symbol);
   int pendingForEA = MathMax(0, activeForEA - openForEA);
   if(curDir == "" && pendingForEA > 0)
   {
      Print("ðŸš« TRADE BLOQUÃ‰ â€” ", pendingForEA, " pending dÃ©jÃ  actif sur ", symbol);
      return false;
   }

   // FIX v1.18: 1 seule position EA dans tout le terminal
   if(CountPositionsOurEA() >= 1 || curDir == direction || openForEA > 0)
   {
      Print("ðŸš« 2e POSITION INTERDITE â€” dÃ©jÃ  ", CountPositionsOurEA(),
            " pos EA (symbole ", symbol, " open=", openForEA, ") â€” MAX 1 dans le terminal.");
      return false;
      // --- ancien scale-in dÃ©sactivÃ© (gardÃ© inatteignable) ---
      if(!AllowGoodPerfectScaleIn) return false;

      int quality = SMC_CurrentGOMQuality(symbol, direction);
      if(quality < 2)
      {
         Print("ðŸš« SCALE-IN BLOQUÃ‰ â€” verdict non GOOD/PERFECT dans le sens ", direction,
               " sur ", symbol);
         return false;
      }

      if(pendingForEA > 0)
      {
         Print("ðŸš« SCALE-IN BLOQUÃ‰ â€” un pending est dÃ©jÃ  armÃ© sur ", symbol);
         return false;
      }

      int maxEntries = (int)MathMax(1, MathMin(MaxGoodPerfectEntriesPerSymbol, MaxPositionsTerminal));
      int units = SMC_EstimatedEntryUnits(symbol, direction);
      if(units >= maxEntries)
      {
         Print("ðŸš« SCALE-IN BLOQUÃ‰ â€” cap atteint ", units, "/", maxEntries,
               " sur ", symbol, " ", direction);
         return false;
      }

      datetime lastOpen = SMC_LastPositionOpenTime(symbol, direction);
      int cooldown = (quality >= 3) ? PerfectScaleInCooldownSec : GoodScaleInCooldownSec;
      if(lastOpen > 0 && (int)(TimeCurrent() - lastOpen) < MathMax(0, cooldown))
      {
         Print("â³ SCALE-IN ", (quality >= 3 ? "PERFECT" : "GOOD"),
               " en cooldown sur ", symbol);
         return false;
      }

      Print("ðŸŽ¯ SCALE-IN SNIPER ", (quality >= 3 ? "PERFECT" : "GOOD"),
            " autorisÃ© sur ", symbol, " ", direction, " | unitÃ©s=", units,
            "/", maxEntries);
   }

   return true;
}

//+------------------------------------------------------------------+
//| â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• GARDE FINALE ABSOLUE (ANTI-HEDGE) â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• |
//| Dernier verrou, appelÃ© juste avant CHAQUE OrderSend/trade.OrderSend|
//| qui OUVRE une position ou un ordre pending (jamais pour fermer). |
//| Objectif demandÃ© : (1) ne JAMAIS avoir BUY et SELL en mÃªme temps  |
//| sur le mÃªme symbole (position ou pending), (2) ne JAMAIS dÃ©passer |
//| MaxPositionsTerminal positions/ordres au total, sinon TOUT bloquer|
//|                                                                    |
//| Utilise une mÃ©moire locale en plus du comptage broker car         |
//| PositionsTotal()/OrdersTotal() peuvent mettre quelques instants   |
//| Ã  reflÃ©ter un ordre qui vient d'Ãªtre envoyÃ© (latence broker) â€” la |
//| mÃ©moire locale comble ce dÃ©lai et empÃªche deux ordres opposÃ©s     |
//| d'Ãªtre envoyÃ©s dans le mÃªme tick avant confirmation du premier.   |
//+------------------------------------------------------------------+
string   g_gateSymbol[];
string   g_gateDirection[];
datetime g_gateStamp[];
#define  SMC_GATE_MEMORY_SEC 90

int SMC_GateIndexForSymbol(const string symbol, bool createIfMissing)
{
   int n = ArraySize(g_gateSymbol);
   for(int i = 0; i < n; i++)
      if(g_gateSymbol[i] == symbol) return i;
   if(!createIfMissing) return -1;
   ArrayResize(g_gateSymbol, n + 1);
   ArrayResize(g_gateDirection, n + 1);
   ArrayResize(g_gateStamp, n + 1);
   g_gateSymbol[n] = symbol;
   g_gateDirection[n] = "";
   g_gateStamp[n] = 0;
   return n;
}

// Ã€ appeler JUSTE APRÃˆS un OrderSend/trade.OrderSend rÃ©ussi qui ouvre une position/ordre
// MÃ©moire mono-ouverture : empÃªche 2 modules d'ouvrir dans le mÃªme tick/barre M1
string   g_monoOpenSymbol = "";
datetime g_monoOpenBarTime = 0;
datetime g_monoOpenStamp = 0;

void SMC_GateRegisterOpened(const string symbol, const bool isBuy)
{
   int idx = SMC_GateIndexForSymbol(symbol, true);
   g_gateDirection[idx] = isBuy ? "BUY" : "SELL";
   g_gateStamp[idx] = TimeCurrent();
   // Verrou mono-ouverture (mÃªme tick / mÃªme barre M1)
   g_monoOpenSymbol  = symbol;
   g_monoOpenBarTime = iTime(symbol, PERIOD_M1, 0);
   g_monoOpenStamp   = TimeCurrent();
}

// Ã€ appeler JUSTE AVANT tout OrderSend/trade.OrderSend qui ouvre une position/ordre.
// Retourne false = envoi interdit, ne pas appeler OrderSend.

//+------------------------------------------------------------------+
//| FIX v1.14: capital bas â†’ uniquement FX Vol / SFX Vol              |
//| PainX/GainX/Boom/Crash interdits si equity < MinEquityForSpike    |
//+------------------------------------------------------------------+
bool SMC_IsFxVolFamily(const string symbol)
{
   return SMC_IsWeltradeVolSymbol(symbol);
}

bool SMC_IsHighCostSpikeSymbol(const string symbol)
{
   // PainX/GainX/Boom/Crash : spread Ã©levÃ© + marge lourde sur micro-compte
   return (SMC_IsWeltradeBoomCrash(symbol) || SMC_IsSpikeStyleSymbol(symbol))
          && !SMC_IsWeltradeVolSymbol(symbol);
}

bool SMC_LowCapitalAllowsSymbol(const string symbol)
{
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   if(equity >= MinEquityForSpikeSymbols)
      return true;
   // Sous le seuil: uniquement famille FX Vol / SFX Vol
   if(SMC_IsFxVolFamily(symbol))
      return true;
   Print("ðŸš« CAPITAL BAS â€” equity=$", DoubleToString(equity, 2),
         " < $", DoubleToString(MinEquityForSpikeSymbols, 0),
         " â†’ ", symbol, " INTERDIT (PainX/GainX/Boom/Crash). FX Vol/SFX Vol uniquement.");
   return false;
}

bool SMC_SpreadAllowsEntry(const string symbol)
{
   double bid = SymbolInfoDouble(symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(symbol, SYMBOL_ASK);
   if(bid <= 0 || ask <= bid) return false;
   double spreadPct = (ask - bid) / bid * 100.0;
   double maxPct = SMC_IsHighCostSpikeSymbol(symbol) ? MaxSpreadPctSpike : MathMax(MaxSpreadPctSpike, 0.25);
   if(SMC_IsWeltradeVolSymbol(symbol))
      maxPct = MathMin(maxPct, 0.08);
   if(spreadPct > maxPct)
   {
      Print("ðŸš« SPREAD TROP Ã‰LEVÃ‰ â€” ", symbol, " spread=", DoubleToString(spreadPct, 4),
            "% > max ", DoubleToString(maxPct, 4), "% â€” refus (PainX 999 typique)");
      return false;
   }
   if(SMC_IsWeltradeVolSymbol(symbol))
   {
      double atr = 0.0;
      int h = iATR(symbol, PERIOD_M1, 14);
      if(h != INVALID_HANDLE)
      {
         double b[];
         ArraySetAsSeries(b, true);
         if(CopyBuffer(h, 0, 0, 1, b) >= 1)
            atr = b[0];
         IndicatorRelease(h);
      }
      if(atr > 0.0 && (ask - bid) > atr * 0.35)
      {
         Print("ðŸš« SPREAD vs ATR â€” ", symbol, " spread=", DoubleToString(ask - bid, 2),
               " > 0.35xATR ", DoubleToString(atr, 2));
         return false;
      }
   }
   return true;
}

//+------------------------------------------------------------------+
//| Gate final M1+M5 + GOM GOOD/PERFECT (mÃªme sens).                 |
//| Obligatoire sur Painx/Gainx, Boom/Crash et volatilitÃ©s           |
//| (FxVol / SFxVol) : confluence spikes sur GOM_TF_TL_M1 / DOW.     |
//+------------------------------------------------------------------+
bool SMC_IsM1M5GomAlignSymbol(const string symbol)
{
   ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(symbol);
   if(cat == SYM_BOOM_CRASH || cat == SYM_VOLATILITY) return true;
   if(SMC_IsSpikeStyleSymbol(symbol)) return true;
   if(SMC_IsWeltradeBoomCrash(symbol) || SMC_IsWeltradeVolSymbol(symbol)) return true;
   return false;
}

bool SMC_M1M5GomAlignGateOK(const string symbol, const int dirSign, string &reasonOut)
{
   reasonOut = "";
   if(!RequireM1M5GomAlignGate) return true;
   if(!SMC_IsM1M5GomAlignSymbol(symbol)) return true;
   if(dirSign == 0)
   {
      reasonOut = "dirSign=0";
      return false;
   }

   if(!g_smcGomConnected)
   {
      SMCGP_RestoreCachedIfDisconnected();
      if(!SMCGP_GomLinkOK())
      {
         reasonOut = "GOM dÃ©connectÃ©";
         return false;
      }
   }
   if(!SMCGP_IsGoodPerfect(g_smcGomVerdictNum))
   {
      if(g_secondSpikeInFlight && SMC_SpikePredictConfirms(dirSign))
         return true;
      // VÃ©rifier M1 Scalp Simple pour verdict SIMPLE
      if(MathAbs(g_smcGomVerdictNum) == 1 && SMCGP_M1ScalpSimpleAllowsDirection(symbol, dirSign))
         return true;
      reasonOut = StringFormat("GOM pas GOOD/PERFECT (vn=%d, verdict=%s)",
                               g_smcGomVerdictNum, g_smcGomVerdict);
      return false;
   }
   if((dirSign > 0 && g_smcGomVerdictNum <= 0) || (dirSign < 0 && g_smcGomVerdictNum >= 0))
   {
      reasonOut = StringFormat("GOM %s vn=%d oppose a l'ordre %s",
                               g_smcGomVerdict, g_smcGomVerdictNum,
                               (dirSign > 0 ? "BUY" : "SELL"));
      return false;
   }
   // GOOD/PERFECT : le verdict GOM suffit (M1/M5/M15 peuvent lagguer, ex. SELL vs M1 BULL)
   if(SMCGP_IsGoodPerfect(g_smcGomVerdictNum))
      return true;

   string m1Dir = (StringLen(g_smcTfM1DirLive) > 0) ? g_smcTfM1DirLive : g_smcTfM1Dir;
   string m5Dir = g_smcTfM5Dir;
   string m15Dir = g_smcTfM15Dir;
   bool m1Ok = SMC_TfDirMatchesSign(dirSign, m1Dir);
   bool m5Ok = SMC_TfDirMatchesSign(dirSign, m5Dir);
   bool m15Ok = SMC_TfDirMatchesSign(dirSign, m15Dir);
   if(m1Ok && m5Ok && m15Ok)
      return true;
   // Spike dump/rally : M1 dÃ©jÃ  dans le sens GOM + GOOD/PERFECT (M5/M15 peuvent lagguer)
   if(m1Ok && SMCGP_IsGoodPerfect(g_smcGomVerdictNum))
      return true;
   if(m1Ok && SMC_SpikePredictConfirms(dirSign))
      return true;
   if(!m1Ok || !m5Ok || !m15Ok)
   {
      reasonOut = StringFormat("alignement M1+M5+M15 obligatoire | M1=%s M5=%s M15=%s GOM=%s vn=%d ordre=%s",
                               m1Dir, m5Dir, m15Dir, g_smcGomVerdict, g_smcGomVerdictNum,
                               (dirSign > 0 ? "BUY" : "SELL"));
      return false;
   }
   return true;
}

//+------------------------------------------------------------------+
//| LIQUIDITY SWEEP + CHoCH (2026-09-26, demande Kola)                |
//| Moteur 100% local (fractals M5), sans dÃ©pendance GOM/serveur.     |
//| DÃ©tecte : liquiditÃ© (equal highs/lows ou dernier extrÃªme swing),  |
//| balayage (mÃ¨che au-delÃ  + clÃ´ture qui rÃ©intÃ¨gre le range), puis   |
//| Change of Character (clÃ´ture qui casse la structure opposÃ©e).    |
//+------------------------------------------------------------------+
input bool   RequireLiquiditySweepCHoCH = false; // Gate STRICT (toutes entrÃ©es) â€” reste OFF par dÃ©faut, Ã  activer aprÃ¨s test dÃ©mo
input ENUM_TIMEFRAMES LSW_StructureTF   = PERIOD_M5; // Timeframe d'analyse structure/liquiditÃ©
input int    LSW_SwingLookback          = 80;    // Bougies analysÃ©es pour les swings
input int    LSW_SwingPeriod            = 3;     // Bougies de chaque cÃ´tÃ© pour valider un swing
input double LSW_EqualTolATR            = 0.15;  // TolÃ©rance "equal high/low" en x ATR
input int    LSW_CHoCH_MaxBars          = 12;     // FenÃªtre max (bougies structure TF) entre sweep et CHoCH

struct SMC_LSWState
{
   string   symbol;
   double   eqHighLevel;
   double   eqLowLevel;
   bool     sweepHighDone;   // liquiditÃ© haute prise (biais bearish)
   bool     sweepLowDone;    // liquiditÃ© basse prise (biais bullish)
   datetime sweepHighTime;
   datetime sweepLowTime;
   double   priorLowBeforeSweepHigh;  // structure Ã  casser pour CHoCH bearish
   double   priorHighBeforeSweepLow;  // structure Ã  casser pour CHoCH bullish
   bool     chochBull;
   bool     chochBear;
   datetime chochBullTime;
   datetime chochBearTime;
   datetime lastRefresh;
};
SMC_LSWState g_lswStates[64];
int g_lswStateCount = 0;

int SMC_LSW_GetSlot(const string symbol)
{
   for(int i = 0; i < g_lswStateCount; i++)
      if(g_lswStates[i].symbol == symbol) return i;
   if(g_lswStateCount >= 64) return 0;
   int n = g_lswStateCount++;
   ZeroMemory(g_lswStates[n]);
   g_lswStates[n].symbol = symbol;
   return n;
}

void SMC_LSW_FindSwings(const string symbol, ENUM_TIMEFRAMES tf, int lookback, int period,
                         double &highs[], datetime &highTimes[], double &lows[], datetime &lowTimes[])
{
   ArrayResize(highs, 0); ArrayResize(highTimes, 0);
   ArrayResize(lows, 0);  ArrayResize(lowTimes, 0);
   MqlRates r[];
   ArraySetAsSeries(r, true);
   if(CopyRates(symbol, tf, 0, lookback, r) < lookback) return;

   for(int i = period; i < lookback - period; i++)
   {
      bool isHigh = true, isLow = true;
      for(int j = 1; j <= period; j++)
      {
         if(r[i].high <= r[i+j].high || r[i].high <= r[i-j].high) isHigh = false;
         if(r[i].low  >= r[i+j].low  || r[i].low  >= r[i-j].low)  isLow  = false;
      }
      if(isHigh)
      {
         int s = ArraySize(highs);
         ArrayResize(highs, s+1); ArrayResize(highTimes, s+1);
         highs[s] = r[i].high; highTimes[s] = r[i].time;
      }
      if(isLow)
      {
         int s = ArraySize(lows);
         ArrayResize(lows, s+1); ArrayResize(lowTimes, s+1);
         lows[s] = r[i].low; lowTimes[s] = r[i].time;
      }
   }
   // SÃ©ries -> ordre chronologique croissant (le plus ancien en premier)
   ArrayReverse(highs); ArrayReverse(highTimes);
   ArrayReverse(lows);  ArrayReverse(lowTimes);
}

// Recherche une paire "equal high/low" (liquiditÃ© en pool) ; Ã  dÃ©faut,
// retourne le dernier extrÃªme swing significatif (liquiditÃ© simple).
double SMC_LSW_FindLiquidityLevel(const double &pts[], double tol, bool wantHigh)
{
   int n = ArraySize(pts);
   if(n == 0) return 0.0;
   for(int i = n - 1; i > 0; i--)
   {
      for(int j = i - 1; j >= 0 && j >= i - 6; j--)
      {
         if(MathAbs(pts[i] - pts[j]) <= tol)
            return wantHigh ? MathMax(pts[i], pts[j]) : MathMin(pts[i], pts[j]);
      }
   }
   return pts[n-1]; // fallback: dernier swing
}

void SMC_LSW_Refresh(const string symbol)
{
   int slot = SMC_LSW_GetSlot(symbol);
   if(TimeCurrent() - g_lswStates[slot].lastRefresh < 2) return;
   g_lswStates[slot].lastRefresh = TimeCurrent();

   double atr = (atrM1 != INVALID_HANDLE) ? SCH1_GetATRAt(atrM1, 0) : 0.0;
   if(atr <= 0.0) return;
   double tol = atr * LSW_EqualTolATR;

   double highs[], lows[]; datetime highTimes[], lowTimes[];
   SMC_LSW_FindSwings(symbol, LSW_StructureTF, LSW_SwingLookback, LSW_SwingPeriod,
                      highs, highTimes, lows, lowTimes);
   if(ArraySize(highs) < 2 || ArraySize(lows) < 2) return;

   g_lswStates[slot].eqHighLevel = SMC_LSW_FindLiquidityLevel(highs, tol, true);
   g_lswStates[slot].eqLowLevel  = SMC_LSW_FindLiquidityLevel(lows,  tol, false);
   g_lswStates[slot].priorLowBeforeSweepHigh  = lows[ArraySize(lows)-1];
   g_lswStates[slot].priorHighBeforeSweepLow  = highs[ArraySize(highs)-1];

   MqlRates last[];
   ArraySetAsSeries(last, true);
   if(CopyRates(symbol, LSW_StructureTF, 0, 3, last) < 2) return;
   MqlRates c = last[1]; // derniÃ¨re bougie CLÃ”TURÃ‰E

   int maxAgeSec = LSW_CHoCH_MaxBars * PeriodSeconds(LSW_StructureTF);

   // Timeout des sweeps non confirmÃ©s par un CHoCH
   if(g_lswStates[slot].sweepHighDone && TimeCurrent() - g_lswStates[slot].sweepHighTime > maxAgeSec)
      g_lswStates[slot].sweepHighDone = false;
   if(g_lswStates[slot].sweepLowDone && TimeCurrent() - g_lswStates[slot].sweepLowTime > maxAgeSec)
      g_lswStates[slot].sweepLowDone = false;

   // DÃ©tection sweep haut (mÃ¨che > liquiditÃ©, clÃ´ture rentrÃ©e) â†’ biais bearish
   if(!g_lswStates[slot].sweepHighDone && g_lswStates[slot].eqHighLevel > 0.0 &&
      c.high > g_lswStates[slot].eqHighLevel && c.close < g_lswStates[slot].eqHighLevel)
   {
      g_lswStates[slot].sweepHighDone = true;
      g_lswStates[slot].sweepHighTime = c.time;
      g_lswStates[slot].chochBear = false;
      Print("ðŸ’§ LSW â€” sweep HAUT (liquiditÃ© prise) sur ", symbol, " @ ",
            DoubleToString(g_lswStates[slot].eqHighLevel, _Digits));
   }
   // DÃ©tection sweep bas â†’ biais bullish
   if(!g_lswStates[slot].sweepLowDone && g_lswStates[slot].eqLowLevel > 0.0 &&
      c.low < g_lswStates[slot].eqLowLevel && c.close > g_lswStates[slot].eqLowLevel)
   {
      g_lswStates[slot].sweepLowDone = true;
      g_lswStates[slot].sweepLowTime = c.time;
      g_lswStates[slot].chochBull = false;
      Print("ðŸ’§ LSW â€” sweep BAS (liquiditÃ© prise) sur ", symbol, " @ ",
            DoubleToString(g_lswStates[slot].eqLowLevel, _Digits));
   }

   // CHoCH bullish : aprÃ¨s sweep bas, clÃ´ture au-dessus de la structure haute antÃ©rieure
   if(g_lswStates[slot].sweepLowDone && !g_lswStates[slot].chochBull &&
      c.close > g_lswStates[slot].priorHighBeforeSweepLow)
   {
      g_lswStates[slot].chochBull = true;
      g_lswStates[slot].chochBullTime = c.time;
      Print("ðŸ”€ LSW â€” CHoCH BULLISH confirmÃ© sur ", symbol);
   }
   // CHoCH bearish : aprÃ¨s sweep haut, clÃ´ture sous la structure basse antÃ©rieure
   if(g_lswStates[slot].sweepHighDone && !g_lswStates[slot].chochBear &&
      c.close < g_lswStates[slot].priorLowBeforeSweepHigh)
   {
      g_lswStates[slot].chochBear = true;
      g_lswStates[slot].chochBearTime = c.time;
      Print("ðŸ”€ LSW â€” CHoCH BEARISH confirmÃ© sur ", symbol);
   }
}

// dirSign > 0 (BUY) : valide si sweep bas + CHoCH bullish rÃ©cents
// dirSign < 0 (SELL): valide si sweep haut + CHoCH bearish rÃ©cents
bool SMC_LSW_SignalOK(const string symbol, const int dirSign, string &reasonOut)
{
   reasonOut = "";
   SMC_LSW_Refresh(symbol);
   int slot = SMC_LSW_GetSlot(symbol);
   int maxAgeSec = LSW_CHoCH_MaxBars * PeriodSeconds(LSW_StructureTF);

   if(dirSign > 0)
   {
      if(g_lswStates[slot].chochBull && TimeCurrent() - g_lswStates[slot].chochBullTime <= maxAgeSec)
      {
         reasonOut = "Sweep bas + CHoCH bullish";
         return true;
      }
      reasonOut = "Pas de sweep/CHoCH bullish rÃ©cent";
      return false;
   }
   else if(dirSign < 0)
   {
      if(g_lswStates[slot].chochBear && TimeCurrent() - g_lswStates[slot].chochBearTime <= maxAgeSec)
      {
         reasonOut = "Sweep haut + CHoCH bearish";
         return true;
      }
      reasonOut = "Pas de sweep/CHoCH bearish rÃ©cent";
      return false;
   }
   return false;
}

//+------------------------------------------------------------------+
//| FALLBACK LOCAL SANS GOM (2026-09-26, demande Kola)                |
//| S'active UNIQUEMENT si ai_server.py est injoignable               |
//| (g_smcGomConnected == false). Direction = DOW trendline locale    |
//| (Dow_DetectTrend, aucune dÃ©pendance serveur). EntrÃ©e exigÃ©e sur   |
//| au moins LocalFallbackMinScore confirmations locales sur 6, pour  |
//| rester aussi prÃ©cis que possible malgrÃ© l'absence de GOM.         |
//+------------------------------------------------------------------+
input bool   UseLocalFallbackNoGOM      = true;  // Secours local si GOM dÃ©connectÃ©
input bool   UseLocalFallbackOnWait     = true;  // FIX v1.28: secours local aussi si GOM=WAIT (spike dump clair)
input bool   UseLocalFallbackOnDegrade  = true;  // Secours local si verdict GOM dÃ©grade GOOD/PERFECT â†’ WAIT
input bool   LocalFallbackAllSymbols    = true;  // FIX v1.28: true - autorise fallback sur tous symboles
input int    LocalFallbackMinScore      = 3;     // FIX v1.28: 3/6 (Ã©tait 4 â€” trop strict)

bool g_localFallbackOverrideActive = false;
int  g_lastGomVerdictNum           = 0;  // Pour dÃ©tecter dÃ©gradation

bool SMC_LocalFallback_TryEntry(const string symbol)
{
   // FIX v1.28: GOM OFF ou GOM WAIT
   bool allowOff  = UseLocalFallbackNoGOM && !g_smcGomConnected;
   bool allowWait = UseLocalFallbackOnWait && g_smcGomConnected &&
                    (g_smcGomVerdictNum == 0 || g_smcGomVerdictNum == -999);
   if(!allowOff && !allowWait) return false;
   if(BlockAllTrades) return false;
   // FIX v1.28: plus de return si GOM connectÃ© â€” allowWait gÃ¨re le cas WAIT
   if(!LocalFallbackAllSymbols &&
      !SMC_IsSpikeStyleSymbol(symbol) && !SMC_IsFxVolFamily(symbol))
      return false;
   if(CountPositionsForSymbol(symbol) > 0) return false;
   if(!SMC_SpreadAllowsEntry(symbol)) return false;
   if(!g_dowState.active || g_dowState.broken) return false;   // pas de structure DOW fiable

   int dir = g_dowState.isBearish ? -1 : 1;
   double px = SymbolInfoDouble(symbol, dir > 0 ? SYMBOL_ASK : SYMBOL_BID);
   if(px <= 0.0) return false;

   double atr = (atrM1 != INVALID_HANDLE) ? SCH1_GetATRAt(atrM1, 0) : g_dowState.currentATR;
   if(atr <= 0.0) return false;

   int score = 0;
   string parts = "";

   // 1) Touch de la trendline DOW (locale, fractals/swings)
   double trendPx = SMC_DTE_GetDowTrendlinePrice(symbol);
   double tol = atr * 0.5;
   if(trendPx > 0.0 && MathAbs(px - trendPx) <= tol) { score++; parts += "DOW "; }

   // 2) FVG non mitigÃ©e dans le sens du trade, prix dedans (boÃ®tes locales ICT)
   bool fvgOk = false;
   for(int i = 0; i < g_fvgBoxCount; i++)
   {
      if(g_fvgBoxes[i].mitigated) continue;
      if(g_fvgBoxes[i].dir != dir) continue;
      if(FVGBox_PriceInBox(g_fvgBoxes[i], px)) { fvgOk = true; break; }
   }
   if(fvgOk) { score++; parts += "FVG "; }

   // 3) Bougie M1 de confirmation dans le sens du trade
   if(SMC_HasM1ConfirmCandle(dir, atr)) { score++; parts += "M1 "; }

   // 4) Tendance M5 locale (EMA20 M5, calculÃ©e directement â€” pas via GOM)
   double emaM5[];
   ArraySetAsSeries(emaM5, true);
   int emaH = iMA(symbol, PERIOD_M5, 20, 0, MODE_EMA, PRICE_CLOSE);
   if(emaH != INVALID_HANDLE && CopyBuffer(emaH, 0, 0, 1, emaM5) > 0)
   {
      bool m5Ok = (dir > 0 && px > emaM5[0]) || (dir < 0 && px < emaM5[0]);
      if(m5Ok) { score++; parts += "M5 "; }
      IndicatorRelease(emaH);
   }

   // 5) Pas de contre-tendance : structure DOW valide + spread dÃ©jÃ  filtrÃ© ci-dessus
   score++; parts += "Struct ";

   // 6) Bonus Liquidity Sweep + CHoCH (moteur local dÃ©diÃ©)
   string lswReason = "";
   if(SMC_LSW_SignalOK(symbol, dir, lswReason)) { score++; parts += "Sweep+CHoCH "; }

   if(score < LocalFallbackMinScore)
   {
      static datetime s_fbLog = 0;
      if(TimeCurrent() - s_fbLog >= 30)
      {
         s_fbLog = TimeCurrent();
         Print("[FALLBACK LOCAL] score ", score, "/6 insuffisant (min=", LocalFallbackMinScore,
               ") [", parts, "] sur ", symbol, " â€” pas d'entrÃ©e");
      }
      return false;
   }

   g_localFallbackOverrideActive = true;
   bool gateOk = SMC_FinalOpenGate(symbol, dir > 0 ? ORDER_TYPE_BUY : ORDER_TYPE_SELL);
   g_localFallbackOverrideActive = false;
   if(!gateOk) return false;

   double sl, tp;
   int dg = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);
   if(dir > 0) { sl = NormalizeDouble(px - atr * 1.5, dg); tp = NormalizeDouble(px + atr * 3.0, dg); }
   else        { sl = NormalizeDouble(px + atr * 1.5, dg); tp = NormalizeDouble(px - atr * 3.0, dg); }

   double lot = CalculateLotSize(symbol, px, sl);
   if(lot <= 0.0) return false;

   if(!TryAcquireOpenLock()) return false;
   bool ok = (dir > 0)
             ? SafeTradeBuy(lot, symbol, px, sl, tp, "FALLBACK LOCAL BUY")
             : SafeTradeSell(lot, symbol, px, sl, tp, "FALLBACK LOCAL SELL");
   ReleaseOpenLock();

   if(ok)
   {
      Print("ðŸŸ¢ FALLBACK LOCAL (GOM off) â€” score ", score, "/6 [", parts, "] ",
            (dir > 0 ? "BUY" : "SELL"), " ", symbol, " @ ", DoubleToString(px, dg));
      RegisterOrderPlaced();
   }
   return ok;
}

bool SMC_GOMLiveQuoteAllowsEntry(const string symbol, const bool isBuySide, string &reasonOut)
{
   reasonOut = "";
   if(!GOMRequireLiveQuote || g_localFallbackOverrideActive ||
      (!g_smcGomConnected && !g_secondSpikeInFlight))
      return true;

   MqlTick tick;
   if(!SymbolInfoTick(symbol, tick) || tick.time <= 0)
   {
      reasonOut = "cotation live indisponible";
      return false;
   }

   int ageSec = (int)(TimeCurrent() - tick.time);
   int maxAgeSec = MathMax(1, GOMMaxLiveQuoteAgeSec);
   if(ageSec < 0 || ageSec > maxAgeSec)
   {
      reasonOut = StringFormat("tick pÃ©rimÃ© (%ds, max %ds)",
                               ageSec, maxAgeSec);
      return false;
   }
   if((isBuySide && tick.ask <= 0.0) || (!isBuySide && tick.bid <= 0.0))
   {
      reasonOut = isBuySide ? "ASK live invalide" : "BID live invalide";
      return false;
   }
   return true;
}

bool SMC_FinalOpenGate(const string symbol, const ENUM_ORDER_TYPE orderType)
{
   bool isBuySide;
   if(orderType == ORDER_TYPE_BUY || orderType == ORDER_TYPE_BUY_LIMIT ||
      orderType == ORDER_TYPE_BUY_STOP || orderType == ORDER_TYPE_BUY_STOP_LIMIT)
      isBuySide = true;
   else if(orderType == ORDER_TYPE_SELL || orderType == ORDER_TYPE_SELL_LIMIT ||
           orderType == ORDER_TYPE_SELL_STOP || orderType == ORDER_TYPE_SELL_STOP_LIMIT)
      isBuySide = false;
   else
      return true; // type non directionnel â€” hors pÃ©rimÃ¨tre de ce verrou

   string wantDir = isBuySide ? "BUY" : "SELL";
   int dirSign = isBuySide ? 1 : -1;

   // The scanner dashboard and the chart-symbol entry gate must refer to the
   // same successful, recent GOM poll. Off-chart execution is not safe here:
   // several downstream gates still consume _Symbol-scoped market/GOM globals.
   GomScannerSymbol gomSnapshot;
   string gomSnapshotReason = "";
   if(!GOMSCAN_GetFreshSnapshot(symbol, gomSnapshot, gomSnapshotReason))
   {
      Print("[GOM-COHERENCE] VETO first_gate=SMC_FinalOpenGate | symbol=", symbol,
            " | chart=", _Symbol, " | dir=", wantDir,
            " | reason=", gomSnapshotReason);
      return false;
   }

   int gomSnapshotAgeSec = (int)(TimeCurrent() - gomSnapshot.lastPoll);
   Print("[GOM-COHERENCE] SNAPSHOT first_gate=SMC_FinalOpenGate | symbol=",
         symbol, " | source=", gomSnapshot.source,
         " | age=", gomSnapshotAgeSec, "s | verdict=", gomSnapshot.verdict,
         " (vn=", gomSnapshot.verdictNum, ") | forecast5m=",
         gomSnapshot.forecast5mVerdict, " (vn=", gomSnapshot.forecast5mVerdictNum,
         ") | TF[M1/M5/M15/H1/H4/D1]=", gomSnapshot.tfM1Dir, "/",
         gomSnapshot.tfM5Dir, "/", gomSnapshot.tfM15Dir, "/",
         gomSnapshot.tfH1Dir, "/", gomSnapshot.tfH4Dir, "/", gomSnapshot.tfD1Dir);

   if(StringCompare(symbol, _Symbol, true) != 0)
   {
      Print("[GOM-COHERENCE] VETO first_gate=SMC_FinalOpenGate | symbol=", symbol,
            " | exact per-symbol scanner row exists, but downstream GOM/price "
            "gates are chart-scoped (", _Symbol,
            "); refusing cross-symbol global reuse");
      return false;
   }

   string chartM1Dir = StringLen(g_smcTfM1DirLive) > 0
                       ? g_smcTfM1DirLive : g_smcTfM1Dir;
   bool snapshotMatchesChart =
      gomSnapshot.verdictNum == g_smcGomVerdictNum &&
      gomSnapshot.forecast5mVerdictNum == g_smcGomVerdictForecastNum &&
      gomSnapshot.tfM1Dir == chartM1Dir &&
      gomSnapshot.tfM5Dir == g_smcTfM5Dir &&
      gomSnapshot.tfM15Dir == g_smcTfM15Dir &&
      gomSnapshot.tfH1Dir == g_smcTfH1Dir &&
      gomSnapshot.tfH4Dir == g_smcTfH4Dir &&
      gomSnapshot.tfD1Dir == g_smcTfD1Dir;
   if(!snapshotMatchesChart)
   {
      Print("[GOM-COHERENCE] VETO first_gate=SMC_FinalOpenGate | symbol=", symbol,
            " | scanner snapshot differs from chart execution inputs | scanVn=",
            gomSnapshot.verdictNum, " liveVn=", g_smcGomVerdictNum,
            " | scanForecast=", gomSnapshot.forecast5mVerdictNum,
            " liveForecast=", g_smcGomVerdictForecastNum,
            " | scanTF=", gomSnapshot.tfM1Dir, "/", gomSnapshot.tfM5Dir, "/",
            gomSnapshot.tfM15Dir, "/", gomSnapshot.tfH1Dir, "/",
            gomSnapshot.tfH4Dir, "/", gomSnapshot.tfD1Dir,
            " | liveTF=", chartM1Dir, "/", g_smcTfM5Dir, "/",
            g_smcTfM15Dir, "/", g_smcTfH1Dir, "/",
            g_smcTfH4Dir, "/", g_smcTfD1Dir);
      return false;
   }

   bool spikeHTFOverride = SMC_SpikeBlink_HTFOverrideInFlight(symbol, dirSign);
   bool spikeChainGomOverride = SMC_SpikeChainGomEntryOverrideAllowed(symbol, dirSign);
   string spikeReason = "";
if(!SMC_SpikeBlink_OrderAllowed(symbol, dirSign,
                                    orderType == ORDER_TYPE_BUY || orderType == ORDER_TYPE_SELL,
                                    spikeReason))
    {
       static datetime s_spikeBlinkGateLog = 0;
       if(TimeCurrent() - s_spikeBlinkGateLog >= 5)
       {
          s_spikeBlinkGateLog = TimeCurrent();
          Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (Spike Blink requis) : ", symbol, " ",
                wantDir, " â€” ", spikeReason);
       }
       return false;
    }

    // FIX v1.46 (profil de volume / POC): le prix doit Ãªtre HORS de la Value
    // Area (zone d'oscillation/correction) pour entrer. BUY exigera > VAH,
    // SELL < VAL. Les zones de correction oÃ¹ le prix a vraiment oscillÃ© sont
    // ainsi modÃ©lisÃ©es par le volume et bloquent l'entrÃ©e.
    if(!SMC_VP_EntryGateOK(symbol, dirSign))
    {
       static datetime s_vpGateLog = 0;
       if(TimeCurrent() - s_vpGateLog >= 15)
       {
          s_vpGateLog = TimeCurrent();
          Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (VP/POC Value Area) : ", symbol, " ", wantDir,
                " | POC=", DoubleToString(g_vpPocPrice, (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS)),
                " VA=[", DoubleToString(g_vpVal, (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS)),
                "-", DoubleToString(g_vpVah, (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS)), "]");
       }
       return false;
    }

    // Symboles synthÃ©tiques autonomes (Weltrade FXVOL/FLIPX/PLUSX, Boom/Crash, PainX/GainX) :
    // contournent le blocage GOM WAIT â€” ils tradent sur leur propre logique (spike chain, etc.)
    bool isSynthAuto = SMC_IsSyntheticAutonomousSym(symbol);
    
    if(!isSynthAuto && MathAbs(g_smcGomVerdictNum) < 2 && MathAbs(g_smcGomVerdictNumServer) < 2 &&
       SMC_GOMCurrentVerdictIsWait(symbol))
   {
      // FIX 2026-10-07: Contournement GOM WAIT si SMC/TF alignÃ©s
      if(OverrideGOMWaitOnSMCAlign)
      {
         // VÃ©rifier si SMC/TF sont alignÃ©s (implÃ©mentation simplifiÃ©e)
         // Dans un cas rÃ©el, il faudrait appeler une fonction de vÃ©rification d'alignement
         Print("âš ï¸ GOM WAIT dÃ©tectÃ© mais OverrideGOMWaitOnSMCAlign activÃ© - contournement activÃ© : ", symbol, " ", wantDir);
         // Ne pas bloquer, continuer vers les autres validations
      }
      else
      {
         if(symbol == _Symbol)
         {
            Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (verdict GOM courant WAIT) : ", symbol, " ", wantDir,
                  " | GOM=", g_smcGomVerdict, " vn=", g_smcGomVerdictNum,
                  " | prixM1_frais=", g_smcMarketPriceFresh,
                  " Ã¢ge_prix=", DoubleToString(g_smcMarketPriceAgeSec, 1), "s",
                  " | forecast5m_prÃªt=", g_smcForecast5mReady,
                  " horizon=", g_smcForecastHorizonMinutes, "m",
                  " forecastVn=", g_smcGomVerdictForecastNum,
                  " | entry_allowed=", g_smcGomEntryAllowed,
                  " raison=", g_smcGomCorrectionReason);
         }
         else
         {
            Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (verdict GOM courant WAIT) : ", symbol, " ", wantDir,
                  " | Ã©tat marchÃ© non disponible dans le cache de ce symbole");
         }
         return false;
      }
   }

   // Revalider le contexte au dernier point commun d'ouverture. Les anciens
   // payloads peuvent omettre entry_allowed; l'absence de ce champ ne vaut pas
   // confirmation du prix ni du forecast 5 minutes.
   // â”€â”€ v1.54 ANTI-CHASE DOW â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   // LeÃ§on #643767661 (FX Vol 40 -1.51): verdict PERFECT cohÃ©rent mais prix
   // Ã  170 pts au-dessus de la zone DOW â†’ entrÃ©e avalÃ©e en haut de rallye,
   // corrigÃ©e sous SL en 103s. Ce n'Ã©tait pas un signal faux, c'Ã©tait un
   // NIVEAU faux. On exige que le prix soit proche du niveau structurel.
   // Exceptions: overrides spike (la capture de chaÃ®ne chase PAR DESIGN),
   // fallback local, et les entrÃ©es DTE-REVIVAL (dÃ©jÃ  au contact TL).
   if(ChaseGuardEnable && StringCompare(symbol, _Symbol, true) == 0 &&
      !spikeHTFOverride && !spikeChainGomOverride)
   {
      double tlDow = SMC_TrendLineValueAt("DOW_TL_line", TimeCurrent());
      if(tlDow > 0.0)
      {
         double cgPoint = SymbolInfoDouble(symbol, SYMBOL_POINT);
         double cgPx    = (isBuySide) ? SymbolInfoDouble(symbol, SYMBOL_BID)
                                      : SymbolInfoDouble(symbol, SYMBOL_ASK);
         if(cgPx > 0.0 && cgPoint > 0.0)
         {
            double cgDist = (cgPx - tlDow) / cgPoint * (isBuySide ? 1.0 : -1.0);
            if(cgDist > (double)ChaseGuardMaxDistPts)
            {
               static datetime s_chaseLog = 0;
               if(TimeCurrent() - s_chaseLog >= 15)
               {
                  s_chaseLog = TimeCurrent();
                  Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (CHASE DOW) : ", symbol, " ", wantDir,
                        " | prix=", DoubleToString(cgPx, (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS)),
                        " DOW=", DoubleToString(tlDow, (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS)),
                        " dist=", DoubleToString(cgDist, 0), "pts > ", ChaseGuardMaxDistPts,
                        " â€” attendre la correction vers la ligne (ou DTE-REVIVAL)");
               }
               return false;
            }
            // cibler aussi le REBOND: si le prix est "derriÃ¨re" la ligne hors sens... on laisse les autres gates dÃ©cider.
         }
      }
   }

   if(g_smcGomConnected && !g_localFallbackOverrideActive && !spikeHTFOverride && !spikeChainGomOverride)
   {
      bool marketContextFresh =
         g_smcMarketPriceFresh &&
         g_smcGomPrice > 0.0 &&
         g_smcMarketPriceAgeSec >= 0.0 &&
         g_smcMarketPriceAgeSec <= 90.0;
      int forecastAgeSec = (g_smcForecastLastUpdate > 0) ? (int)(TimeCurrent() - g_smcForecastLastUpdate) : 1000000;
      int serverVerdictAgeSec = (g_smcServerVerdictLastUpdate > 0) ? (int)(TimeCurrent() - g_smcServerVerdictLastUpdate) : 1000000;
      bool forecastContextReady =
         g_smcForecast5mReady &&
         g_smcForecastHorizonMinutes == 5 &&
         g_smcGomVerdictForecastNum != 0 &&
         forecastAgeSec <= 120;
      bool serverContextFresh = (serverVerdictAgeSec <= 120);
      // Forecast 5m manquant: ne bloque PAS. Forecast GOOD/PERFECT opposÃ©: bloque.
      bool forecastOpposes =
         forecastContextReady &&
         ((g_smcGomVerdictForecastNum > 0) != isBuySide) &&
         MathAbs(g_smcGomVerdictForecastNum) >= 2;
      bool serverOpposes =
         g_smcGomVerdictNumServer != 0 &&
         ((g_smcGomVerdictNumServer > 0) != isBuySide) &&
         serverContextFresh;

      const bool gomStrong = (MathAbs(g_smcGomVerdictNum) >= 2 ||
                              MathAbs(g_smcGomVerdictNumServer) >= 2);
      bool serverOpposesStrong =
         MathAbs(g_smcGomVerdictNumServer) >= 2 &&
         ((g_smcGomVerdictNumServer > 0) != isBuySide) &&
         serverContextFresh;
      if((!gomStrong && (!g_smcGomEntryAllowed || !marketContextFresh)) ||
         forecastOpposes || (!gomStrong && serverOpposes) || serverOpposesStrong)
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (contexte GOM non confirmÃ©) : ", symbol, " ",
               wantDir, " â€” entry_allowed=", g_smcGomEntryAllowed,
               " prix_frais=", marketContextFresh,
               " Ã¢ge_prix=", DoubleToString(g_smcMarketPriceAgeSec, 1), "s",
               " forecast5m_prÃªt=", forecastContextReady,
               " forecastVn=", g_smcGomVerdictForecastNum,
               " forecastAgeSec=", forecastAgeSec,
               " forecastOppose=", forecastOpposes,
               " serveurVn=", g_smcGomVerdictNumServer,
               " serveurAgeSec=", serverVerdictAgeSec,
               " serveurOppose=", serverOpposes,
               " | reason=",
            g_smcGomCorrectionReason,
               " GOM=", g_smcGomVerdict, " vn=", g_smcGomVerdictNum);
         return false;
      }
   }

   string liveQuoteReason = "";
   if(!SMC_GOMLiveQuoteAllowsEntry(symbol, isBuySide, liveQuoteReason))
   {
      static datetime s_liveQuoteBlockLog = 0;
      if(TimeCurrent() - s_liveQuoteBlockLog >= 5)
      {
         s_liveQuoteBlockLog = TimeCurrent();
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (prix live) : ", symbol, " ", wantDir,
               " â€” ", liveQuoteReason);
      }
      return false;
   }
   datetime now = TimeCurrent();

   // Filtre optionnel Liquidity Sweep + CHoCH (OFF par dÃ©faut â€” activer aprÃ¨s test dÃ©mo)
   if(RequireLiquiditySweepCHoCH && !g_localFallbackOverrideActive)
   {
      string lswReason = "";
      if(!SMC_LSW_SignalOK(symbol, isBuySide ? 1 : -1, lswReason))
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (Sweep+CHoCH manquant) : ", symbol, " ", wantDir,
               " â€” ", lswReason);
         return false;
      }
   }

   // PurePA exclusif (opt-in) : refuse tout ordre hors PurePA
   if(SMC_IsPurePAExclusive() && !g_purePAEntryInFlight)
   {
      Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (PurePA exclusif) : ", symbol, " ", wantDir,
            " â€” seul le moteur Pure Price Action peut ouvrir.");
      return false;
   }

   // â”€â”€ ANTI-HEDGE / 1 POS DUR : dÃ¨s l'entrÃ©e dans le gate â”€â”€
   {
      string cur = GetOpenPositionDirectionForSymbol(symbol);
      if(cur == "MIXED")
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (HEDGE MIXED) : ", symbol, " a dÃ©jÃ  BUY+SELL â€” purge");
         SMC_EnforceNoHedgeAllSymbols();
         return false;
      }
      if(cur != "" && cur != wantDir)
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (ANTI-HEDGE) : ", symbol, " dÃ©jÃ  ", cur,
               " â€” refus ", wantDir);
         return false;
      }
      if(cur == wantDir || CountPositionsForSymbol(symbol) > 0)
      {
         // Message clair : ce n'est PAS un rejet du PERFECT/GOOD â€” 1 pos max / symbole.
         static datetime s_posLockLog = 0;
         if(TimeCurrent() - s_posLockLog >= 20)
         {
            s_posLockLog = TimeCurrent();
            Print("ðŸ”’ GATE FINAL â€” LOCK (1 pos max) : ", symbol, " dÃ©jÃ  ",
                  (cur != "" ? cur : "ouvert"),
                  " â€” pas de 2e ordre | GOM vn=", g_smcGomVerdictNum,
                  " ", g_smcGomVerdict,
                  " (le PERFECT/GOOD reste valide pour la position en cours)");
         }
         return false;
      }
      if(CountPositionsOurEA() >= MathMax(1, MaxPositionsTerminal))
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (cap terminal) : dÃ©jÃ  ", CountPositionsOurEA(),
               " pos EA â€” refus ", symbol, " ", wantDir);
         return false;
      }
   }

// â”€â”€ BLOQUER SI VERDICT GOM EST WAIT OU DÃ‰CONNECTÃ‰ â”€â”€
    // RÃ¨gle absolue: pas d'entrÃ©e sans GOM live non-WAIT
    // FIX 2026-09-26 : exception spike imminent (g_secondSpikeInFlight) â€”
    // la flÃ¨che clignotante / proba >= 85% ne doit pas Ãªtre tuÃ©e par un lag GOM WAIT.
    // FIX v1.34 ICT: serveur GOOD/PERFECT + M1/M5/M15 alignÃ©s â†’ pas de blocage WAIT
    // (bandeau jaune) â€” SPIKE_BLINK / ExecuteSpikeTrade doivent passer.
    SMCGP_RestoreCachedIfDisconnected();
    if(!SMCGP_GomLinkOK() || g_smcGomVerdictNum == 0 || g_smcGomVerdictNum == -999)
    {
       int spDir = isBuySide ? 1 : -1;
       bool spikeAlignedSrv = (MathAbs(g_smcGomVerdictNumServer) >= 2) &&
                              ((spDir > 0 && g_smcGomVerdictNumServer > 0) ||
                               (spDir < 0 && g_smcGomVerdictNumServer < 0));
       if(spikeAlignedSrv)
       {
          SMCGP_RestoreAlignedGoodIfWait(symbol);
          Print("âœ… GATE FINAL â€” WAIT override srv GOOD/PERFECT : ", symbol, " ",
                wantDir, " srvVn=", g_smcGomVerdictNumServer);
       }
       else if(spikeHTFOverride)
       {
          Print("âœ… GATE FINAL â€” SPIKE HTF SIMPLE : ", symbol, " ", wantDir,
                " | D1/H4 + chaÃ®ne + flÃ¨che confirmÃ©s");
       }
       else if(g_localFallbackOverrideActive)
       {
          // FIX v1.28: fallback local valide aussi sous WAIT (pas seulement GOM OFF)
          Print("âœ… GATE FINAL â€” override FALLBACK LOCAL : ", symbol, " ", wantDir,
                " | GOM connected=", g_smcGomConnected, " vn=", g_smcGomVerdictNum);
       }
       else
       {
          if(g_dowPriceLeadInFlight)
             Print("ðŸ”’ GATE FINAL â€” WAIT (override DOW ignorÃ©) : ", symbol, " ", wantDir);
          Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (GOM WAIT/OFF) : ", symbol, " ", wantDir,
                " connected=", g_smcGomConnected, " vn=", g_smcGomVerdictNum);
          return false;
       }
    }

    // â”€â”€ GARDE DIRECTION GOM ABSOLUE (FIX 2026-09-20) â”€â”€
    // Un ordre BUY ne peut Ãªtre exÃ©cutÃ© que si le verdict GOM est BUY-side
    // (vn > 0). GOOD/PERFECT SELL (vn < 0) doit BLOQUER un BUY, mÃªme si
    // d'autres conditions sont remplies. C'est la rÃ¨gle qui empÃªche l'exÃ©cution
    // d'un ordre dans le sens opposÃ© au verdict GOM.
    if(isBuySide && g_smcGomVerdictNum < 0)
    {
       Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (GOM SELL vs BUY) : ", symbol, " ", wantDir,
             " â€” GOM vn=", g_smcGomVerdictNum, " = SELL (verdict dÃ©cide â€” pas d'ordre BUY)");
       return false;
    }
    if(!isBuySide && g_smcGomVerdictNum > 0)
    {
       Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (GOM BUY vs SELL) : ", symbol, " ", wantDir,
             " â€” GOM vn=", g_smcGomVerdictNum, " = BUY (verdict dÃ©cide â€” pas d'ordre SELL)");
       return false;
    }

    // FIX v1.29: Bypass SWING precision si GOM PERFECT (pour capturer sÃ©ries de spikes)
    bool isGomPerfect = (MathAbs(g_smcGomVerdictNum) >= 2);
    if(!spikeHTFOverride && !isGomPerfect &&
       !SMCSP_PrecisionOK(symbol, isBuySide ? 1 : -1))
    {
       Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (SWING) : ", symbol, " ", wantDir,
             " â€” prix hors zone SH/SL");
       return false;
    }

   // â”€â”€ GATE M1+M5 + GOM GOOD/PERFECT (2026-09-20) â”€â”€
   // Avant validation finale / execution d'un ordre prÃ©validÃ© : sur
   // Painx/Gainx, Boom/Crash et FxVol/SFxVol, la tendance M1 ET M5
   // doit Ãªtre alignÃ©e dans le mÃªme sens que le verdict GOM GOOD/PERFECT.
   // Aucune exception PERFECT contre M1 : les spikes rejaillissent sur
   // GOM_TF_TL_M1 / ligne DOW uniquement avec cette confluence.
   // Exception : 1er rebond DOW â€” GOM M1/M5 trop lents.
   if(!g_dowPriceLeadInFlight && !spikeHTFOverride)
   {
      int alignDir = isBuySide ? 1 : -1;
      string alignReason = "";
      if(!SMC_M1M5GomAlignGateOK(symbol, alignDir, alignReason))
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (M1+M5 / GOM) : ", symbol, " ", wantDir,
               " â€” ", alignReason);
         return false;
      }
      if(RequireM1M5GomAlignGate && SMC_IsM1M5GomAlignSymbol(symbol))
      {
         static datetime s_m1m5OkLog = 0;
         if(TimeCurrent() - s_m1m5OkLog >= 20)
         {
            s_m1m5OkLog = TimeCurrent();
            string m1DirLog = (StringLen(g_smcTfM1DirLive) > 0) ? g_smcTfM1DirLive : g_smcTfM1Dir;
            Print("âœ… GATE FINAL â€” M1+M5 + GOM alignÃ©s : ", symbol, " ", wantDir,
                  " | M1=", m1DirLog, " M5=", g_smcTfM5Dir,
                  " GOM=", g_smcGomVerdict, " vn=", g_smcGomVerdictNum);
         }
      }
   }

   // â”€â”€ QUALITÃ‰ A+ : SIMPLE interdit sauf IPA avec structure claire â”€â”€
   // FIX 2026-09-17g (Sidoine): Intelligent PA peut entrer en SIMPLE si HTF alignÃ©.
   if(!spikeHTFOverride && !g_dowPriceLeadInFlight && !g_secondSpikeInFlight && g_smcGomConnected && MathAbs(g_smcGomVerdictNum) > 0
      && MathAbs(g_smcGomVerdictNum) < MinGOMVerdictNumAbs)
   {
      if(g_ipaEntryInFlight)
      {
         static datetime s_ipaSimpleOk = 0;
         if(TimeCurrent() - s_ipaSimpleOk >= 30)
         {
            s_ipaSimpleOk = TimeCurrent();
            Print("âœ… GATE FINAL â€” SIMPLE autorisÃ© (IPA structure claire) : ", symbol, " ", wantDir,
                  " vn=", g_smcGomVerdictNum);
         }
      }
      else
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (GOM SIMPLE trop faible) : ", symbol, " ", wantDir,
               " vn=", g_smcGomVerdictNum, " â€” exige |vn|>=", MinGOMVerdictNumAbs,
               " (GOOD/PERFECT) ou IPA structure claire.");
         return false;
      }
   }

    // â”€â”€ IA HOLD / sens opposÃ© : pas de nouvelle entrÃ©e â”€â”€
    // Exception : VolatilitÃ© Weltrade (FXVOL/SFVVOL/SFXVOL) â€” pas de dÃ©cision IA
    // valide, ils s'appuient uniquement sur GOM GOOD/PERFECT.
    // Exception : PainX/GainX/Boom/Crash/Vol â€” l'IA dashboard est souvent HOLD
    // sans dÃ©cision utile ; GOM GOOD/PERFECT + tendance locale dÃ©cident.
    bool isWeltradeVol = SMC_IsWeltradeVolSymbol(symbol);
    bool skipAiHold = isWeltradeVol || SMC_IsM1M5GomAlignSymbol(symbol);
    // FIX v1.42: le blocage IA HOLD ne s applique qu a une source SERVER.
    // Un HOLD local (fallback EMA / random / tendance) ne doit pas bloquer
    // des entrees par ailleurs validees par GOM (causait des refus opaques).
    if(BlockEntryWhenAIHold && UseAIServer && !skipAiHold && g_lastAISource == "SERVER")
    {
       string aiUp = g_lastAIAction;
       StringToUpper(aiUp);
       StringReplace(aiUp, " ", "");
       if(aiUp == "HOLD" || aiUp == "" || aiUp == "NONE")
       {
          Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (IA HOLD) : ", symbol, " ", wantDir,
                " â€” IA=", g_lastAIAction, " conf=", DoubleToString(g_lastAIConfidence * 100.0, 1),
                "% â€” pas d'entrÃ©e sans feu vert IA alignÃ©");
          return false;
       }
       if(isBuySide && (aiUp == "SELL" || aiUp == "SHORT"))
       {
          Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (IA SELL vs BUY) : ", symbol);
          return false;
       }
       if(!isBuySide && (aiUp == "BUY" || aiUp == "LONG"))
       {
          Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (IA BUY vs SELL) : ", symbol);
          return false;
       }
    }

   // â”€â”€ Pattern chartiste contraire (ex. 3 Crows M5 vs BUY) â”€â”€
   if(UseStrictPatternGateInFinal && !spikeHTFOverride)
   {
      int patDir = isBuySide ? 1 : -1;
      if(!SMCPS_PatternGateOK(symbol, patDir, true))
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (pattern contraire) : ", symbol, " ", wantDir,
               " â€” figure chartiste opposÃ©e active (ex. 3 Crows vs BUY). Pas d'entrÃ©e.");
         return false;
      }
   }

    // â”€â”€ VALIDATION NIVEAU SMC PRÃ‰CIS â€” Ã©viter entrÃ©es pÃªle-mÃªle â”€â”€
    // Exige que le prix soit Ã  un niveau SMC clÃ© + confirmation M5
    // Exception : VolatilitÃ© Weltrade (FXVOL/SFVVOL/SFXVOL) â€” pas de niveaux SMC
    // (FVG/OB/DOW/BOS) sur ce type de symbole, on se fie au verdict GOM uniquement.
    if(UsePreciseSMCEntryGate && !isWeltradeVol &&
       !g_dowPriceLeadInFlight && !spikeHTFOverride)
    {
       int dirSign = isBuySide ? 1 : -1;
       string smcLevelName = "";
       if(!SMC_IsAtValidSMCLevel(symbol, dirSign, smcLevelName))
       {
          Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (NIVEAU SMC INVALIDE) : ", symbol, " ", wantDir,
                " refusÃ© â€” prix pas Ã  un niveau SMC clÃ© (Support/Res 20, DOW, GOM_TF_TL, Pivot, FVG, BOS)");
          return false;
       }

       // â”€â”€ CONFIRMATION M5 OBLIGATOIRE â”€â”€
       // Exige une bougie M5 confirmÃ©e dans la direction
       if(RequireM5Confirmation && !g_dowPriceLeadInFlight && !SMC_HasM5Confirmation(symbol, dirSign))
       {
          Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (PAS DE CONFIRMATION M5) : ", symbol, " ", wantDir,
                " refusÃ© â€” niveau SMC: ", smcLevelName, " mais pas de confirmation M5");
          return false;
       }

       Print("âœ… GATE FINAL â€” NIVEAU SMC VALIDÃ‰ : ", symbol, " ", wantDir,
             " | Niveau: ", smcLevelName, " | Confirmation M5 OK");
    }

   // â”€â”€ BLOQUER SI RANGE / CONSOLIDATION sans cassure â”€â”€
   // Tant que le prix oscille dans le box M1 (correction range), AUCUNE
   // entrÃ©e (MARKET ni LIMIT) : on attend une cassure claire du high (BUY)
   // ou du low (SELL). C'est exactement le cas "pleine correction range"
   // visible sur FX Vol / Boom-Crash â€” ne pas trader l'intÃ©rieur du range.
   if(UseConsolidationFilter && !g_dowPriceLeadInFlight && !spikeHTFOverride)
   {
      int rangeDir = isBuySide ? 1 : -1;
      if(!SMC_RangeAllowsEntry(rangeDir))
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (RANGE sans cassure) : ", symbol, " ", wantDir,
               " | box=[", DoubleToString(g_consolidationData.rangeLow, (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS)),
               " - ", DoubleToString(g_consolidationData.rangeHigh, (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS)), "]",
               " | width=", DoubleToString(g_consolidationData.rangeWidthATR, 2), "xATR",
               " | brkBuy=", (g_consolidationData.breakoutBuy ? "Y" : "N"),
               " | brkSell=", (g_consolidationData.breakoutSell ? "Y" : "N"),
               " â€” attendre cassure du range dans le sens du trade");
         return false;
      }
   }

   // â”€â”€ BLOQUER SI NIVEAUX LIMIT TROP SERRÃ‰S (range serrÃ©) â”€â”€
   // Ã‰vite les entrÃ©es MARKET quand BUY/SELL levels sont proches (indique range)
   bool isPendingType = (orderType == ORDER_TYPE_BUY_LIMIT || orderType == ORDER_TYPE_SELL_LIMIT ||
                         orderType == ORDER_TYPE_BUY_STOP || orderType == ORDER_TYPE_SELL_STOP ||
                         orderType == ORDER_TYPE_BUY_STOP_LIMIT || orderType == ORDER_TYPE_SELL_STOP_LIMIT);

   // Refuser les entrÃ©es marchÃ© tant que M1 reste opposÃ© au trade alors que
   // la majoritÃ© des unitÃ©s supÃ©rieures confirme encore sa direction.
   // Les ordres en attente restent autorisÃ©s pour viser un niveau de pullback.
   int correctionDirSign = isBuySide ? 1 : -1;
   if(!isPendingType && SMC_IsCorrectionZoneForDirection(symbol, correctionDirSign))
   {
      Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (correction M1 non rÃ©solue) : ",
            symbol, " ", wantDir,
            " â€” M1 opposÃ© aux unitÃ©s supÃ©rieures, attendre la reprise confirmÃ©e.");
      return false;
   }

   if(UseLimitSpacingFilter && !isPendingType)
   {
      int atrHandleLocal = iATR(symbol, PERIOD_M1, 14);
      double atrVal = 0;
      if(atrHandleLocal != INVALID_HANDLE)
      {
         double atrBuf[];
         ArraySetAsSeries(atrBuf, true);
         if(CopyBuffer(atrHandleLocal, 0, 0, 1, atrBuf) >= 1)
            atrVal = atrBuf[0];
      }
      if(atrVal <= 0) atrVal = SymbolInfoDouble(symbol, SYMBOL_POINT) * 50;

      if(AreLimitLevelsTooClose(atrVal))
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (NIVEAUX LIMIT SERRÃ‰S) : ", symbol, " ", wantDir,
               " refusÃ© â€” BUY/SELL levels trop proches (range serrÃ©)");
         return false;
      }
   }

   // â”€â”€ BLOQUER SI WHIPSAW (oscillations gain/perte) â”€â”€
   // Ã‰vite les trades quand le prix oscille rapidement
   if(UseWhipsawFilter && IsInWhipsawMode())
   {
      Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (WHIPSAW) : ", symbol, " ", wantDir,
            " refusÃ© â€” marchÃ© en whipsaw (", g_whipsawData.gainLossTransitions,
            " transitions gain/perte)");
      return false;
   }

   // â”€â”€ PRÃ‰FÃ‰RER IMPULSION FRANCHE â”€â”€
   // Log info si marchÃ© en impulsion (idÃ©al pour entrÃ©es)
   if(HasStrongImpulse(symbol))
   {
      Print("âœ… GATE FINAL â€” IMPULSION FRANCHE dÃ©tectÃ©e : ", symbol, " ", wantDir);
   }

   // Confluence OTE/Fibonacci obligatoire pour les symboles OTE actifs :
   // une zone calculÃ©e et un prix rÃ©ellement dans 61.8â€“78.6 % sont requis.
   // Le tracker reste contrÃ´lÃ© juste aprÃ¨s et demeure prioritaire en pratique.
   if(symbol == _Symbol && EnforceOTEConfluence && UseOTE && OTE_IsActiveSymbol(symbol))
   {
      if(g_smcOteTop <= 0.0 || g_smcOteBot <= 0.0 || !g_smcInOTE)
      {
         Print("ðŸ”’ GATE FINAL â€” OTE/Fibonacci non confirmÃ© : ", symbol,
               " ", wantDir, " refusÃ©");
         return false;
      }
   }

   // FIX 2026-09-09 (Claude, demande Sidoine): filet final anti-correction.
   // SMC_FinalOpenGate est LE point de passage obligÃ© de tout ordre (cf.
   // SMC_TradeExecutor.mqh + tous les sites d'appel directs) â€” c'est donc
   // l'endroit le plus sÃ»r pour bloquer un MARKET qui partirait en pleine
   // correction M5 (EMA21/EMA50 traversÃ©es + ATR compressÃ© + range Ã©troit),
   // quel que soit le module appelant, sans devoir auditer chaque site un
   // par un. Ne s'applique PAS aux LIMIT/STOP (pending) : ceux-ci ciblent
   // dÃ©libÃ©rÃ©ment une zone de retracement (OTE, DOW projetÃ©) â€” les bloquer
   // ici casserait la stratÃ©gie de retracement elle-mÃªme.
   // isPendingType dÃ©jÃ  dÃ©clarÃ© plus haut (ligne 7248)
   // La dÃ©tection M1 contre les unitÃ©s supÃ©rieures est appliquÃ©e ci-dessus
   // aux entrÃ©es marchÃ©; les pending restent disponibles pour le pullback.

   // Verrou absolu : certains chemins d'entrÃ©e appellent directement cette
   // garde finale sans passer par CanTradeOnSymbol(). Le tracker doit donc
   // Ãªtre contrÃ´lÃ© ici aussi, juste avant tout envoi au broker.
   if(!g_dowPriceLeadInFlight && SMC_ReactionEntryBlocked(symbol, wantDir))
   {
      Print("ðŸ”’ GATE FINAL â€” entrÃ©e refusÃ©e par le REACTION TRACKER : ",
            symbol, " ", wantDir);
      return false;
   }

   // â”€â”€ FIX 2026-09-15: Filtre de sensibilitÃ© du prix â”€â”€
   // VÃ©rifie que le prix a une sensibilitÃ© suffisante (momentum, compression, volume)
   // avant d'autoriser l'entrÃ©e. Ã‰vite les entrÃ©es sur prix plat ou sans impulsion.
   if(!g_dowPriceLeadInFlight && !spikeHTFOverride &&
      !PriceSensitivity_AllowEntry(symbol, dirSign))
   {
      Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (sensibilitÃ© prix insuffisante) : ",
            symbol, " ", wantDir, " refusÃ©");
      return false;
   }

   // â”€â”€ FIX 2026-09-22: GOM LIVE â€” ne pas faire confiance au seul verdict serveur â”€â”€
   {
      string liveReason = "";
      if(!spikeHTFOverride &&
         !SMC_LiveGOMEntryOK(symbol, dirSign, isPendingType, liveReason))
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (GOM LIVE) : ", symbol, " ", wantDir,
               " â€” ", liveReason);
         return false;
      }
   }

   // â”€â”€ 1) CAP GLOBAL ABSOLU : jamais plus de MaxPositionsTerminal positions/ordres â”€â”€
   int brokerCount = CountTerminalAllOrders();
   int localFreshCount = 0;
   for(int i = 0; i < ArraySize(g_gateSymbol); i++)
      if(g_gateDirection[i] != "" && (now - g_gateStamp[i]) <= SMC_GATE_MEMORY_SEC)
         localFreshCount++;
   int totalOpen = MathMax(brokerCount, localFreshCount);
   if(totalOpen >= MaxPositionsTerminal)
   {
      Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (cap global) : ", totalOpen, "/", MaxPositionsTerminal,
            " positions+ordres actifs (broker=", brokerCount, ", mÃ©moire=", localFreshCount, ") â€” ",
            symbol, " ", wantDir, " refusÃ©.");
      return false;
   }

   // â”€â”€ 2) ANTI-HEDGE ABSOLU : jamais BUY + SELL simultanÃ© sur le mÃªme symbole â”€â”€
   int idx = SMC_GateIndexForSymbol(symbol, false);
   if(idx >= 0 && g_gateDirection[idx] != "" && (now - g_gateStamp[idx]) <= SMC_GATE_MEMORY_SEC
      && g_gateDirection[idx] != wantDir)
   {
      Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (anti-hedge mÃ©moire) : ", symbol, " a un ordre ",
            g_gateDirection[idx], " envoyÃ© il y a ", (int)(now - g_gateStamp[idx]),
            "s â€” ", wantDir, " refusÃ©.");
      return false;
   }

   // â”€â”€ 2bis) ANTI-DOUBLON MÃŠME SENS (course entre deux modules d'entrÃ©e) â”€â”€
   // FIX 2026-09-09 (Claude, demande Sidoine, GainX 800 double BUY 21:48:42/43):
   // PositionsTotal()/CanTradeOnSymbol() peuvent ne pas encore reflÃ©ter un ordre
   // tout juste envoyÃ© (latence broker) : deux modules d'entrÃ©e dÃ©clenchÃ©s sur le
   // mÃªme spike (ex. ExecuteDerivArrowTrade + DetectAndPlaceBoomCrashSpikeOrders)
   // passaient alors tous les deux, faute de blocage mÃªme-sens ici â€” seul le sens
   // OPPOSÃ‰ Ã©tait bloquÃ© ci-dessus. Un scale-in GOOD/PERFECT lÃ©gitime (validÃ© par
   // CanTradeOnSymbol, cooldown 45-90s) reste trÃ¨s largement au-delÃ  de cette
   // fenÃªtre de quelques secondes et n'est donc jamais impactÃ©.
   // FIX 2026-09-14: fenÃªtre anti-doublon Ã©largie 5s â†’ 30s
   #define SMC_GATE_MIN_SAME_DIR_SEC 30
   if(idx >= 0 && g_gateDirection[idx] == wantDir && g_gateStamp[idx] > 0
      && (now - g_gateStamp[idx]) < SMC_GATE_MIN_SAME_DIR_SEC)
   {
      Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (doublon mÃªme sens <", SMC_GATE_MIN_SAME_DIR_SEC,
            "s) : ", symbol, " ", wantDir, " dÃ©jÃ  envoyÃ© il y a ",
            (int)(now - g_gateStamp[idx]), "s â€” ordre refusÃ©.");
      return false;
   }

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Symbol() != symbol) continue;
      bool existingIsBuy = (posInfo.PositionType() == POSITION_TYPE_BUY);
      if(existingIsBuy != isBuySide)
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (anti-hedge position) : position ",
               (existingIsBuy ? "BUY" : "SELL"), " dÃ©jÃ  ouverte sur ", symbol,
               " â€” ", wantDir, " refusÃ©.");
         return false;
      }
   }

   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) != symbol) continue;
      ENUM_ORDER_TYPE ot = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      bool pendIsBuy  = (ot == ORDER_TYPE_BUY_LIMIT  || ot == ORDER_TYPE_BUY_STOP  || ot == ORDER_TYPE_BUY_STOP_LIMIT);
      bool pendIsSell = (ot == ORDER_TYPE_SELL_LIMIT || ot == ORDER_TYPE_SELL_STOP || ot == ORDER_TYPE_SELL_STOP_LIMIT);
      if(!pendIsBuy && !pendIsSell) continue;
      if(pendIsBuy != isBuySide)
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (anti-hedge pending) : ordre pending ",
               (pendIsBuy ? "BUY" : "SELL"), " dÃ©jÃ  actif sur ", symbol,
               " â€” ", wantDir, " refusÃ©.");
         return false;
      }
   }

   // FIX 2026-09-13 (Claude, demande Sidoine): garde WAIT + pattern chartiste
   // AU NIVEAU DU VERROU FINAL. Avant ce fix, seul SMCGP_ExecutePipelineOrder()
   // (chemin "pipeline" serveur) vÃ©rifiait le verdict WAIT et la confirmation
   // par figure chartiste (SMCPS_PatternGateOK/SMCPS_BreakoutConfirmed) â€” les
   // entrÃ©es DOW EP RECT, DOW LIMIT, GOM IMMEDIATE et SPIKE TRADE (la majoritÃ©
   // des trades rÃ©els) ne les consultaient jamais, alors mÃªme que les figures
   // Ã©taient correctement dÃ©tectÃ©es et affichÃ©es Ã  l'Ã©cran. Objectif de
   // Sidoine : jamais d'entrÃ©e en WAIT, jamais contre-tendance, et une figure
   // chartiste M1/M5/H1 comme confirmation systÃ©matique â€” dÃ©sormais vrai pour
   // TOUT ordre passant par SMC_SubmitEntry, quel que soit le module appelant.
   int finalDirSign = isBuySide ? 1 : -1;

   // WAIT / OFF STRICT â€” aucune exception
   if(!g_smcGomConnected || g_smcGomVerdictNum == 0 || g_smcGomVerdictNum == -999)
   {
      Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (GOM WAIT/OFF) : ", symbol, " ", wantDir,
            " refusÃ© â€” connected=", g_smcGomConnected, " vn=", g_smcGomVerdictNum);
      return false;
   }

   // FIX v1.19: pause globale / symbole (2 gains ou 3 pertes > $4)
   if(IsSymbolPaused(symbol) || IsGlobalTradingPaused())
   {
      Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (PAUSE trading) : ", symbol, " ", wantDir);
      return false;
   }

   // FIX v1.14: capital < 15$ â†’ pas de PainX/GainX (spread/marge trop lourds)
   if(!SMC_LowCapitalAllowsSymbol(symbol))
      return false;
   if(!SMC_SpreadAllowsEntry(symbol))
      return false;
   // Marge libre nÃ©gative ou < coÃ»t d'un lot min â†’ refus
   if(AccountInfoDouble(ACCOUNT_MARGIN_FREE) < 1.0)
   {
      Print("ðŸš« MARGIN FREE insuffisante ($",
            DoubleToString(AccountInfoDouble(ACCOUNT_MARGIN_FREE), 2),
            ") â€” aucun nouvel ordre sur ", symbol);
      return false;
   }
   // Contre-tendance GOM toujours interdite (vn=0 n'est pas un SELL)
   if(!g_dowPriceLeadInFlight && g_smcGomVerdictNum != 0)
   {
      int finalGomDir = (g_smcGomVerdictNum > 0) ? 1 : -1;
      if(finalGomDir != finalDirSign)
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (contre-tendance GOM) : ", symbol, " ", wantDir,
               " refusÃ© â€” verdict ", g_smcGomVerdict, " (vn=", g_smcGomVerdictNum, ").");
         return false;
      }
   }

   // Dump/rally M1 live : jamais de BUY GainX en correction, mÃªme si GOM dit GOOD BUY.
   // Le pipeline ne fournit pas ce calcul ; on mesure localement
   // le dÃ©placement des trois derniÃ¨res bougies M1 clÃ´turÃ©es.
   {
      int liveImp = 0;
      MqlRates liveM1[];
      ArraySetAsSeries(liveM1, true);
      if(CopyRates(symbol, PERIOD_M1, 1, 4, liveM1) >= 4)
      {
         double move = liveM1[0].close - liveM1[2].open;
         double liveAtr = 0.0;
         int liveAtrHandle = iATR(symbol, PERIOD_M1, 14);
         if(liveAtrHandle != INVALID_HANDLE)
         {
            double atrBuf[];
            ArraySetAsSeries(atrBuf, true);
            if(CopyBuffer(liveAtrHandle, 0, 1, 1, atrBuf) >= 1)
               liveAtr = atrBuf[0];
            IndicatorRelease(liveAtrHandle);
         }
         double threshold = (liveAtr > 0.0) ? liveAtr * MathMax(0.01, LiveAgainstATR) : 0.0;
         if(threshold <= 0.0 || MathAbs(move) >= threshold)
            liveImp = (move > 0.0) ? 1 : ((move < 0.0) ? -1 : 0);
      }
      if(finalDirSign > 0 && liveImp < 0)
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (M1 dump vs BUY) : ", symbol,
               " â€” prix 1b+3b baissier, correction, pas d'achat.");
         return false;
      }
      if(finalDirSign < 0 && liveImp > 0)
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (M1 rally vs SELL) : ", symbol,
               " â€” prix 1b+3b haussier, pas de vente.");
         return false;
      }
   }

   // FIX 2026-09-20 (Sidoine) : gate Dow ABSOLU cÃ´tÃ© EA
   // MÃªme si le verdict Python est GOOD/PERFECT, si la ligne Dow est contre-tendance
   // â†’ blocage immÃ©diat. Le Dow est la vÃ©ritÃ© structurelle.
   {
      bool dowActive = g_dowState.active;
      bool dowBearish = false;
      if(dowActive)
      {
         dowBearish = g_dowState.isBearish
                      || g_dowState.slope < 0.0
                      || (g_dowState.startPrice > 0.0 && g_dowState.endPrice > 0.0
                          && g_dowState.endPrice < g_dowState.startPrice);
      }
      bool dowBullish = dowActive && !dowBearish;

      // Dow BULL interdit SELL (mÃªme correction buy)
      if(dowBullish && finalDirSign < 0)
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (Dow BULL vs SELL) : ", symbol, " ", wantDir,
               " refusÃ© â€” Dow=BULL | verdict ", g_smcGomVerdict, " (vn=", g_smcGomVerdictNum, ").");
         return false;
      }
      // Dow BEAR interdit BUY (mÃªme correction sell)
      if(dowBearish && finalDirSign > 0)
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (Dow BEAR vs BUY) : ", symbol, " ", wantDir,
               " refusÃ© â€” Dow=BEAR | verdict ", g_smcGomVerdict, " (vn=", g_smcGomVerdictNum, ").");
         return false;
      }
   }

   // FIX 2026-09-20 (Sidoine) : gate M1+M5 OBLIGATOIRE pour TOUS les symboles
   // Plus d'exception - M1 et M5 doivent Ãªtre alignÃ©s avec le sens de l'ordre.
   string m1 = g_smcTfM1Dir;
   string m5 = g_smcTfM5Dir;
   StringToUpper(m1);
   StringToUpper(m5);

   bool m1Bear = (StringFind(m1, "BEAR") >= 0 || m1 == "SELL" || m1 == "DOWN");
   bool m1Bull = (StringFind(m1, "BULL") >= 0 || m1 == "BUY" || m1 == "UP");
   bool m5Bear = (StringFind(m5, "BEAR") >= 0 || m5 == "SELL" || m5 == "DOWN");
   bool m5Bull = (StringFind(m5, "BULL") >= 0 || m5 == "BUY" || m5 == "UP");

   // Conflit M1: prix opposÃ© au sens voulu
   bool m1Conflict = (finalDirSign > 0 && m1Bear) || (finalDirSign < 0 && m1Bull);
   // Conflit M5: prix opposÃ© au sens voulu
   bool m5Conflict = (finalDirSign > 0 && m5Bear) || (finalDirSign < 0 && m5Bull);

   // Si M1 OU M5 en conflit â†’ blocage (sauf 1er rebond DOW : labels GOM souvent figÃ©s)
   if(!g_dowPriceLeadInFlight && (m1Conflict || m5Conflict))
   {
      string conflictTF = m1Conflict ? "M1" : (m5Conflict ? "M5" : "M1+M5");
      Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (M1+M5 non alignÃ©s) : ", symbol, " ", wantDir,
            " | M1=", g_smcTfM1Dir, " | M5=", g_smcTfM5Dir,
            " | GOM=", g_smcGomVerdict, " vn=", g_smcGomVerdictNum,
            " â€” conflit sur ", conflictTF);
      return false;
   }
   // FIX 2026-09-20 (Sidoine) : GOOD/PERFECT obligatoire si capital < 10$
   // Si capital >= 10$ â†’ exception spike-tradable autorisÃ©e (SIMPLE acceptÃ©)
   double accountEquity = AccountInfoDouble(ACCOUNT_EQUITY);
   bool lowCapital = (accountEquity < 10.0);
   int minAbs = lowCapital ? 2 : 1;  // Capital faible: GOOD/PERFECT requis | Capital OK: SIMPLE acceptÃ©

   // FIX 2026-09-20: Exception pour rÃ©entrÃ©e aprÃ¨s spike manquÃ©
   int wantDirSign = (wantDir == "BUY") ? 1 : -1;
   if(SMC_MSR_CanReentry(symbol, wantDirSign))
   {
      // RÃ©entrÃ©e autorisÃ©e mÃªme avec verdict SIMPLE
      minAbs = 1;
      Print("ðŸ”„ GATE FINAL â€” RÃ‰ENTRÃ‰E SPIKE MANQUÃ‰ autorisÃ©e : ", symbol, " ", wantDir,
            " | ", SMC_MSR_GetState());
   }

   if(!g_dowPriceLeadInFlight && MathAbs(g_smcGomVerdictNum) < minAbs)
   {
      string reason = lowCapital ? "capital<10$ exige GOOD/PERFECT" : "verdict trop faible";
      Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (verdict trop faible) : ", symbol, " ", wantDir,
            " vn=", g_smcGomVerdictNum, " | Equity=$", DoubleToString(accountEquity, 2),
            " | ", reason);
      return false;
   }

   // â”€â”€ FIX 2026-09-14: mono-ouverture par symbole / barre M1 â”€â”€
   datetime barM1 = iTime(symbol, PERIOD_M1, 0);
   if(g_monoOpenSymbol == symbol && g_monoOpenBarTime == barM1 && g_monoOpenStamp > 0
      && (now - g_monoOpenStamp) < 60)
   {
      Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (mono-ouverture) : ", symbol, " ", wantDir,
            " dÃ©jÃ  une ouverture sur cette barre M1 il y a ", (int)(now - g_monoOpenStamp), "s");
      return false;
   }
   // â”€â”€ VERROU UNIQUE ET ATOMIQUE : MAX 1 POSITION DANS TOUT LE TERMINAL â”€â”€
   // CORRECTIF DUPLICATION (demande Sidoine) : le verrou inter-graphiques doit
   // Ãªtre acquis AVANT le comptage des positions, pas aprÃ¨s. Dans l'ancien
   // ordre, deux appels quasi simultanÃ©s (2 charts, ou 2 modules du mÃªme tick)
   // pouvaient tous les deux lire "0 position" avant qu'aucun des deux ordres
   // n'ait Ã©tÃ© confirmÃ© par le broker (latence PositionsTotal()), et donc tous
   // les deux passer le gate â†’ double position. En acquÃ©rant le verrou GLOBAL
   // (GlobalVariable, partagÃ© par tous les graphiques du terminal) en premier,
   // le second appelant est bloquÃ© immÃ©diatement par SMC_AcquireTerminalOpenLock
   // lui-mÃªme, quel que soit l'Ã©tat encore non rafraÃ®chi de PositionsTotal().
   if(!SMC_AcquireTerminalOpenLock())
   {
      Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (lock terminal) : ", symbol, " ", wantDir,
            " â€” une ouverture est dÃ©jÃ  en cours ou une position existe dÃ©jÃ  ailleurs dans le terminal.");
      return false;
   }
   // Verrou obtenu : on est dÃ©sormais le SEUL appelant autorisÃ© Ã  vÃ©rifier/ouvrir.
   // FIX v1.18: JAMAIS 2 positions de notre EA dans TOUT le terminal (tous symboles)
   int ourTotal = CountPositionsOurEA();
   if(ourTotal >= 1 || CountPositionsForSymbol(symbol) > 0)
   {
      Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (dÃ©jÃ  ", ourTotal, " pos EA dans terminal) : ",
            symbol, " ", wantDir, " â€” MAX 1 position globale, 2e ordre REFUSÃ‰.");
      SMC_ReleaseTerminalOpenLock(); // pas d'ouverture ici : on libÃ¨re tout de suite pour ne pas geler les tentatives suivantes
      return false;
   }
   // Aussi bloquer si mÃ©moire mono-open rÃ©cente (course multi-modules mÃªme tick)
   // dÃ©jÃ  gÃ©rÃ© plus haut via g_monoOpenSymbol â€” renforcÃ© ici pour pending
   int pendingSame = 0;
   for(int pi = OrdersTotal() - 1; pi >= 0; pi--)
   {
      ulong ptk = OrderGetTicket(pi);
      if(ptk == 0) continue;
      if(OrderGetString(ORDER_SYMBOL) != symbol) continue;
      if((long)OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
      ENUM_ORDER_TYPE pot = (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);
      if(pot == ORDER_TYPE_BUY || pot == ORDER_TYPE_SELL) continue; // positions comptÃ©es ailleurs
      if(pot == ORDER_TYPE_BUY_LIMIT || pot == ORDER_TYPE_SELL_LIMIT ||
         pot == ORDER_TYPE_BUY_STOP || pot == ORDER_TYPE_SELL_STOP ||
         pot == ORDER_TYPE_BUY_STOP_LIMIT || pot == ORDER_TYPE_SELL_STOP_LIMIT)
         pendingSame++;
   }
   // Si MARKET et dÃ©jÃ  un pending mÃªme sens qui pourrait doubler l'expo au fill â€” OK pour 1 pending
   // Si on tente un 2e MARKET alors qu'un pending existe: autoriser seulement si pas de position
   // (dÃ©jÃ  couvert). Blocage: 2e MARKET si mÃ©moire gate < 30s dÃ©jÃ  en place.

   // FIX 2026-09-14 v1.10: les symboles SPIKE (PainX/GainX/Boom/Crash/Vol)
   // ne passent PAS par le gate figure chartiste â€” un spike n'est pas un
   // triangle/harami. Exiger PatternGateOK ici bloquait 100% des entrÃ©es
   // Weltrade pendant des heures. Forex/Gold/indices restent filtrÃ©s.
   bool isSpikeSym = SMC_IsSpikeStyleSymbol(symbol) || SMC_IsWeltradeBoomCrash(symbol)
                     || SMC_IsWeltradeVolSymbol(symbol);
   if(UsePatternEntrySignals && !isSpikeSym)
   {
      if(!SMCPS_PatternGateOK(symbol, finalDirSign, true))
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (aucune figure chartiste) : ", symbol, " ", wantDir, " refusÃ©.");
         SMC_ReleaseTerminalOpenLock(); // verrou dÃ©jÃ  acquis plus haut : libÃ©rer puisqu'on n'ouvre pas
         return false;
      }
      if(!isPendingType && !SMCPS_BreakoutConfirmed(symbol, finalDirSign))
      {
         Print("ðŸ”’ GATE FINAL â€” BLOQUÃ‰ (breakout figure non confirmÃ©) : ", symbol, " ", wantDir, " refusÃ©.");
         SMC_ReleaseTerminalOpenLock(); // idem
         return false;
      }
   }

   // FIX v1.12: verrou IMMÃ‰DIAT avant OrderSend â€” le 2e module du mÃªme tick
   // voit dÃ©jÃ  g_monoOpen* et est refusÃ© (Ã©vite double BUY Ã  1s d'Ã©cart).
   g_monoOpenSymbol  = symbol;
   g_monoOpenBarTime = iTime(symbol, PERIOD_M1, 0);
   g_monoOpenStamp   = TimeCurrent();
   int gidx = SMC_GateIndexForSymbol(symbol, true);
   g_gateDirection[gidx] = wantDir;
   g_gateStamp[gidx] = TimeCurrent();
   return true;
}

//+------------------------------------------------------------------+
//| IncrÃ©mente le compteur (noop â€” gardÃ© pour compatibilitÃ©)         |
//+------------------------------------------------------------------+
void RegisterOrderPlaced()
{
   // Les pending orders sont comptÃ©s immÃ©diatement par CountTerminalAllOrders()
   // AprÃ¨s une 1Ã¨re entrÃ©e spike/DOW sur Boom-like/Crash-like â†’ armer la fenÃªtre 2e spike
   if(UseSecondSpikeCapture)
   {
      int dirSign = 0;
      if(IsBoomLikeSymbol(_Symbol)) dirSign = 1;
      else if(IsCrashLikeSymbol(_Symbol)) dirSign = -1;
      else if(g_smcGomConnected && g_smcGomVerdictNum != 0)
         dirSign = (g_smcGomVerdictNum > 0) ? 1 : -1;
      if(dirSign != 0)
         SMC_ArmSecondSpikeWindow(dirSign, "post-entry " + _Symbol);
   }
}

void CloseWorstPositionIfTotalLossExceeded()
{
   double totalProfit = 0;
   double worstProfit = 0;
   ulong worstTicket = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      double p = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      totalProfit += p;
      if(worstTicket == 0 || p < worstProfit)
      {
         worstProfit = p;
         worstTicket = posInfo.Ticket();
      }
   }
   double effMaxTotalLoss = SMC_EffectiveMaxTotalLossUSD(); // profil Gold sinon MaxTotalLossDollars
   if(totalProfit > -effMaxTotalLoss) return;
   if(worstTicket != 0 && PositionCloseWithLog(worstTicket, "Perte totale max atteinte"))
      Print("ðŸ›‘ Perte totale (", DoubleToString(totalProfit, 2), "$) >= ", DoubleToString(effMaxTotalLoss, 0), "$ â†’ position la plus perdante fermÃ©e (", DoubleToString(worstProfit, 2), "$)");
}

void CloseAllPositionsIfTotalProfitReached()
{
   double totalProfit = 0;
   ulong allTickets[];
   ArrayResize(allTickets, 0);
   
   // Calculer le profit total pour tous les symboles
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      double p = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      totalProfit += p;
      ArrayResize(allTickets, ArraySize(allTickets) + 1);
      allTickets[ArraySize(allTickets) - 1] = posInfo.Ticket();
   }
   
   // Fermer toutes les positions si le profit total atteint 3$
   if(totalProfit >= 3.0)
   {
      Print("ðŸ’° PROFIT TOTAL ATTEINT (", DoubleToString(totalProfit, 2), "$ >= 3.00$) â†’ Fermeture de toutes les positions...");
      
      for(int i = 0; i < ArraySize(allTickets); i++)
      {
         ulong ticket = allTickets[i];
         // VALIDATION: VÃ©rifier que la position existe toujours avant de fermer
         if(!PositionSelectByTicket(ticket))
         {
            Print("âš ï¸ Position dÃ©jÃ  fermÃ©e avant profit total close - ticket=", ticket);
            continue;
         }
         
         double profit = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
         string symbol = PositionGetString(POSITION_SYMBOL);
         
         if(PositionCloseWithLog(ticket, "Profit total atteint"))
         {
            Print("âœ… Position fermÃ©e - ", symbol, ": ", DoubleToString(profit, 2), "$");
         }
         else
         {
            Print("âŒ Ã‰chec fermeture - ", symbol, ": ", DoubleToString(profit, 2), "$");
         }
      }
      
      Print("ðŸŽ¯ FERMETURE COMPLÃˆTE - Profit total rÃ©alisÃ©: ", DoubleToString(totalProfit, 2), "$");
   }
}

// Fermeture par ordre inverse (comme Spike_Close_BoomCrash) pour compatibilitÃ© brokers
bool ClosePositionByDeal(ulong ticket)
{
   if(!PositionSelectByTicket(ticket)) return false;
   if(!SMC_AllowEAExitAfterM1Bars(ticket, "ClosePositionByDeal")) return false;
   ENUM_ORDER_TYPE orderType = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? ORDER_TYPE_SELL : ORDER_TYPE_BUY;
   string symbol = PositionGetString(POSITION_SYMBOL);
   double volume = PositionGetDouble(POSITION_VOLUME);
   MqlTradeRequest request;
   MqlTradeResult  result;
   ZeroMemory(request);
   request.action   = TRADE_ACTION_DEAL;
   request.position = ticket;
   request.symbol   = symbol;
   request.volume   = volume;
   request.type     = orderType;
   request.price    = (orderType == ORDER_TYPE_SELL) ? SymbolInfoDouble(symbol, SYMBOL_BID) : SymbolInfoDouble(symbol, SYMBOL_ASK);
   request.deviation = 50;
   return OrderSend(request, result);
}

bool CloseBoomCrashPosition(ulong ticket, const string symbol)
{
   if(!SMC_AllowEAExitAfterM1Bars(ticket, "Boom/Crash position close")) return false;
   // NOUVEAU: VÃ©rifier l'Ã¢ge minimum avant fermeture par deal direct
   if(PositionSelectByTicket(ticket))
   {
      datetime openTime = (datetime)PositionGetInteger(POSITION_TIME);
      int ageSec = (int)(TimeCurrent() - openTime);
      if(ageSec < MinPositionLifetimeSec)
      {
         // Fallback vers PositionCloseWithLog qui a ses propres protections
         if(PositionCloseWithLog(ticket, "Boom/Crash position close"))
         {
            Print("ðŸ§© EA POSITION CLOSE OK (via log) - ", symbol, " | ticket=", ticket);
            return true;
         }
         return false;
      }
   }
   if(ClosePositionByDeal(ticket))
   {
      Print("ðŸ§© EA CLOSE DEAL OK - ", symbol, " | ticket=", ticket);
      return true;
   }
   if(PositionCloseWithLog(ticket, "Boom/Crash position close"))
   {
      Print("ðŸ§© EA POSITION CLOSE OK - ", symbol, " | ticket=", ticket);
      return true;
   }
   int err = GetLastError();
   Print("âŒ EA Ã‰CHEC FERMETURE Boom/Crash - ", symbol, " | ticket=", ticket, " | code=", err);
   return false;
}

void CloseBoomCrashAfterSpike(ulong ticket, string symbol, double currentProfit)
{
   if(posInfo.Magic() != InpMagicNumber) return;
   if(SMC_GetSymbolCategory(symbol) != SYM_BOOM_CRASH) return;
   
   // RÃˆGLE UNIVERSELLE D'ABORD: 2 dollars pour TOUS les symboles
   if(currentProfit >= 2.0)
   {
      if(CloseBoomCrashPosition(ticket, symbol))
      {
         Print("âœ… Boom/Crash fermÃ©: bÃ©nÃ©fice 2$ atteint (", DoubleToString(currentProfit, 2), "$) - ", symbol);
         if(symbol == _Symbol) { g_lastBoomCrashPrice = 0; }
      }
      return;
   }
   
   // Ensuite, les rÃ¨gles spÃ©cifiques Boom/Crash si < 2$
   if(currentProfit >= TargetProfitBoomCrashUSD && currentProfit < 2.0)
   {
      if(CloseBoomCrashPosition(ticket, symbol))
      {
         Print("ðŸš€ Boom/Crash fermÃ© (gain >= ", DoubleToString(TargetProfitBoomCrashUSD, 2), "$): ", DoubleToString(currentProfit, 2), "$) - ", symbol);
         if(symbol == _Symbol) { g_lastBoomCrashPrice = 0; }
      }
      return;
   }
   
   // Spike detection (si < 2$) - DÃ‰SACTIVÃ‰ par dÃ©faut pour Ã©viter fermetures prÃ©maturÃ©es
   if(g_lastBoomCrashPrice > 0 && false) // false = DÃ‰SACTIVÃ‰
   {
      double price = SymbolInfoDouble(symbol, SYMBOL_BID);
      double movePct = (price - g_lastBoomCrashPrice) / g_lastBoomCrashPrice * 100.0;
       if(IsBoomLikeSymbol(symbol) && movePct >= BoomCrashSpikePct)
      {
         if(CloseBoomCrashPosition(ticket, symbol))
         {
            Print("ðŸš€ Boom/Crash fermÃ© (spike prix ", DoubleToString(currentProfit, 2), "$) - ", symbol);
            g_lastBoomCrashPrice = 0;
            s_lastRefUpdate = 0;
         }
      }
       if(IsCrashLikeSymbol(symbol) && movePct <= -BoomCrashSpikePct)
      {
         if(CloseBoomCrashPosition(ticket, symbol))
         {
            Print("ðŸš€ Boom/Crash fermÃ© (spike prix ", DoubleToString(currentProfit, 2), "$) - ", symbol);
            g_lastBoomCrashPrice = 0;
            s_lastRefUpdate = 0;
         }
      }
   }
}

// Parcourt toutes les positions spike et ferme dÃ¨s capture du spike M1 favorable
void ManageBoomCrashSpikeClose()
{
   if(!UseSpikeAutoClose) return;
   if(PositionsTotal() == 0) return;

   static ulong    s_ticket[32];
   static double   s_peak[32];
   static datetime s_firstSpike[32];
   static int      s_smallBars[32];
   static bool     s_init = false;
   if(!s_init)
   {
      ArrayInitialize(s_ticket, 0);
      ArrayInitialize(s_peak, 0.0);
      ArrayInitialize(s_firstSpike, 0);
      ArrayInitialize(s_smallBars, 0);
      s_init = true;
   }

   const double minGain    = MathMax(0.10, SpikeCloseMinProfitUSD);
   const double keepPct    = MathMax(50.0, MathMin(95.0, SpikeCloseKeepPct)) / 100.0;
   const int    waitMaxSec = MathMax(15, SpikeCloseWaitSecondMaxSec);
   const int    maxSmall   = MathMax(2, SpikeCloseMaxSmallM1Bars);
   const double smallBody  = MathMax(0.25, SpikeCloseSmallBodyATR);

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;

      string symbol = posInfo.Symbol();
      if(symbol != _Symbol) continue;
      if(SMC_GetSymbolCategory(symbol) != SYM_BOOM_CRASH &&
         !IsBoomLikeSymbol(symbol) && !IsCrashLikeSymbol(symbol) &&
         !SMC_IsWeltradeBoomCrash(symbol) && !SMC_IsWeltradeVolSymbol(symbol))
         continue;

      ulong ticket = posInfo.Ticket();
      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      datetime openTime = posInfo.Time();
      int ageSec = (int)(TimeCurrent() - openTime);
      string cmt = posInfo.Comment();
      bool isSpikeCmt = (StringFind(cmt, "SPIKE") >= 0 || StringFind(cmt, "GOM") >= 0 ||
                         StringFind(cmt, "DOW") >= 0 || StringFind(cmt, "IMPULSE") >= 0);
      if(!isSpikeCmt && ageSec < 5) continue;

      int slot = -1;
      for(int s = 0; s < 32; s++)
         if(s_ticket[s] == ticket) { slot = s; break; }
      if(slot < 0)
      {
         for(int s = 0; s < 32; s++)
            if(s_ticket[s] == 0) { slot = s; s_ticket[s] = ticket; break; }
         if(slot < 0) slot = 0;
         s_peak[slot] = 0;
         s_firstSpike[slot] = 0;
         s_smallBars[slot] = 0;
         s_ticket[slot] = ticket;
      }

      if(profit > s_peak[slot])
      {
         s_peak[slot] = profit;
         s_smallBars[slot] = 0;
      }
      double peak = s_peak[slot];

      double atrVal = 0.0;
      if(atrHandle != INVALID_HANDLE)
      {
         double ab[]; ArraySetAsSeries(ab, true);
         if(CopyBuffer(atrHandle, 0, 0, 1, ab) >= 1) atrVal = ab[0];
      }
      if(atrVal <= 0.0) atrVal = SymbolInfoDouble(symbol, SYMBOL_POINT) * 50.0;

      int posDir = (posInfo.PositionType() == POSITION_TYPE_BUY) ? 1 : -1;
      bool favorableSpike = SMC_ReactionSpikeNow(posDir, atrVal);

      if(favorableSpike && profit >= minGain && s_firstSpike[slot] <= 0)
      {
         s_firstSpike[slot] = TimeCurrent();
         Print("ðŸŽ¯ SPIKE CAPTÃ‰ (1er) ", symbol, " #", ticket,
               " $", DoubleToString(profit, 2), " peak=$", DoubleToString(peak, 2));
         bool posIsBuy = (posInfo.PositionType() == POSITION_TYPE_BUY);
         double curPx = posIsBuy ? SymbolInfoDouble(symbol, SYMBOL_BID)
                                 : SymbolInfoDouble(symbol, SYMBOL_ASK);
         SMC_BC_RegisterSpike(curPx, posIsBuy ? 1 : -1);
      }

      bool strong = false;
      if(g_smcGomConnected && MathAbs(g_smcGomVerdictNum) >= MinGOMVerdictNumAbs)
         strong = true;
      if(g_spikeChainState == SPIKE_STATE_CHAIN_ACTIVE || g_spikeChainStrongBars >= 2)
         strong = true;

      if(s_firstSpike[slot] > 0 && peak >= minGain)
      {
         MqlRates r[];
         ArraySetAsSeries(r, true);
         if(CopyRates(symbol, PERIOD_M1, 0, maxSmall + 4, r) >= maxSmall + 1)
         {
            int smallCount = 0;
            for(int b = 1; b <= maxSmall + 2 && b < ArraySize(r); b++)
            {
               if(r[b].time < s_firstSpike[slot]) break;
               double body = MathAbs(r[b].close - r[b].open);
               if(body < atrVal * smallBody) smallCount++;
               else if(body >= atrVal * MathMax(0.9, smallBody * 1.8))
               {
                  double signedBody = r[b].close - r[b].open;
                  if((posDir > 0 && signedBody > 0) || (posDir < 0 && signedBody < 0))
                     break;
               }
            }
            s_smallBars[slot] = smallCount;
         }
      }

      bool shouldClose = false;
      string closeReason = "";

      if(favorableSpike && profit >= minGain)
      {
         shouldClose = true;
         closeReason = StringFormat("Spike captÃ© $%.2f â€” close immÃ©diat", profit);
      }
      else if(peak >= minGain && profit <= 0.0)
      {
         shouldClose = true;
         closeReason = StringFormat("spike rendu en perte (pic $%.2f)", peak);
      }
      else if(peak >= minGain && profit > 0.0 && profit <= peak * 0.85)
      {
         shouldClose = true;
         closeReason = StringFormat("Giveback 15%% aprÃ¨s spike peak=$%.2f", peak);
      }
      else if(peak >= minGain && profit > 0.0 && profit <= peak * keepPct)
      {
         shouldClose = true;
         closeReason = StringFormat("Giveback max %.0f%% peak=$%.2f", (1.0 - keepPct) * 100.0, peak);
      }
      else if(s_firstSpike[slot] > 0 && peak >= minGain && s_smallBars[slot] >= maxSmall && !strong)
      {
         shouldClose = true;
         closeReason = StringFormat("%d petites M1 sans 2e spike", s_smallBars[slot]);
      }
      else if(profit >= minGain && strong && s_firstSpike[slot] > 0)
      {
         int waited = (int)(TimeCurrent() - s_firstSpike[slot]);
         if(waited >= waitMaxSec)
         {
            shouldClose = true;
            closeReason = StringFormat("Timeout %ds sans 2e spike", waited);
         }
      }
      else if(profit >= BoomCrashSpikeTP)
      {
         shouldClose = true;
         closeReason = StringFormat("Spike TP $%.2f", profit);
      }

      if(!shouldClose) continue;

      bool captureSpikeExit = favorableSpike && profit >= minGain;
      bool closedSpike = captureSpikeExit
         ? PositionCloseWithLogSpikeCapture(ticket, "Spike close - " + closeReason, true)
         : PositionCloseWithLog(ticket, "Spike close - " + closeReason, true);
      if(closedSpike)
      {
         Print("ðŸŽ¯ SPIKE FERMÃ‰ ", symbol, " #", ticket, " | ", closeReason);
         if(UseNotifications)
            SendNotification("ðŸŽ¯ Spike fermÃ© - " + symbol + " - " + closeReason);
         s_ticket[slot] = 0; s_peak[slot] = 0; s_firstSpike[slot] = 0; s_smallBars[slot] = 0;
         g_maxProfit = 0.0;
         if(favorableSpike && posDir != 0 && StringFind(cmt, "2nd SPIKE") < 0)
            SMC_ArmSecondSpikeWindow(posDir, "spike capture close");
      }
   }

   for(int s = 0; s < 32; s++)
   {
      if(s_ticket[s] == 0) continue;
      if(!PositionSelectByTicket(s_ticket[s]))
      {
         s_ticket[s] = 0; s_peak[s] = 0; s_firstSpike[s] = 0; s_smallBars[s] = 0;
      }
   }
}

//+------------------------------------------------------------------+
//| Coupure de perte maximale â€” prioritÃ© absolue                     |
//| Cette protection ne dÃ©pend ni de UseDollarExits, ni de l'Ã¢ge de   |
//| la position, ni de la catÃ©gorie Boom/Crash, ni de BlockAllTrades. |
//| Elle doit empÃªcher qu'une position dÃ©passe durablement le plafond |
//| MaxLossDollars lorsque le SL broker est absent, invalide ou trop   |
//| Ã©loignÃ©.                                                         |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| FIX â€” Fermeture sur SPIKE ADVERSE (va contre la position)         |
//| ManageBoomCrashSpikeClose() ci-dessus ne ferme QUE sur spike       |
//| favorable ("jamais sur perte, laisser le SL naturel"). Or un      |
//| spike qui va CONTRE la position (ex: spike haussier pendant un    |
//| SELL PainX) peut a lui seul faire perdre plusieurs $ avant que le |
//| SL naturel ne soit touche. Cette fonction detecte un tel spike    |
//| M1 dÃ©favorable et ferme immÃ©diatement, comme demandÃ©.             |
//+------------------------------------------------------------------+
void ManageAdverseSpikeClose()
{
   if(!UseAdverseSpikeClose) return;
   if(PositionsTotal() == 0) return;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;

      string symbol = posInfo.Symbol();
      if(symbol != _Symbol) continue;
      if(SMC_GetSymbolCategory(symbol) != SYM_BOOM_CRASH && !SMC_IsSpikeStyleSymbol(symbol))
         continue; // cette garde cible Boom/Crash/PainX/GainX comme le reste du bloc spike

      if(atrM1 == INVALID_HANDLE) continue;
      double atrVal = SCH1_GetATRAt(atrM1, 0);
      if(atrVal <= 0) continue;

      double high  = iHigh(symbol, PERIOD_M1, 0);
      double low   = iLow(symbol, PERIOD_M1, 0);
      double open  = iOpen(symbol, PERIOD_M1, 0);
      double close = iClose(symbol, PERIOD_M1, 0);
      if(high <= 0 || low <= 0) continue;

      double range = high - low;
      if(range < AdverseSpikeATRMult * atrVal) continue; // pas un spike

      bool bullishBar = (close > open);
      bool isBuy      = (posInfo.PositionType() == POSITION_TYPE_BUY);
      // Spike adverse = bougie haussiere pendant un SELL, ou baissiere pendant un BUY
      bool adverseSpike = isBuy ? !bullishBar : bullishBar;
      if(!adverseSpike) continue;

      // Alimente le moteur BC (zones de spike / post-spike-recovery) mÃªme sur
      // un spike dÃ©favorable : c'est une information utile pour les futures
      // entrÃ©es, pas seulement pour la fermeture de celle-ci.
      SMC_BC_RegisterSpike(bullishBar ? high : low, bullishBar ? 1 : -1);

      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      if(profit >= 0) continue; // le spike joue dÃ©jÃ  pour nous, rien Ã  protÃ©ger ici

      ulong ticket = posInfo.Ticket();
      Print("â›” SPIKE ADVERSE DÃ‰TECTÃ‰ (M1 range=", DoubleToString(range, _Digits),
            " >= ", DoubleToString(AdverseSpikeATRMult, 2), "xATR) â€” fermeture protectrice ",
            symbol, " | ticket=", ticket, " | P/L=$", DoubleToString(profit, 2));

      if(!PositionSelectByTicket(ticket)) continue; // dÃ©jÃ  fermÃ©e entretemps
      PositionCloseWithLog(ticket, "Spike adverse - fermeture protectrice");
   }
}

//+------------------------------------------------------------------+
//| FIX 2026-09-20: Deadline universelle pour fermer position si      |
//| second spike n'arrive pas dans le dÃ©lai - APPLIQUÃ‰ Ã€ TOUS LES     |
//| SYMBOLES pour protÃ©ger 30% du gain max aprÃ¨s spike capture        |
//+------------------------------------------------------------------+
void ManageUniversalSpikeDeadline()
{
   if(PositionsTotal() <= 0) return;
   
   const double minGain    = MathMax(0.10, SpikeCloseMinProfitUSD);
   const double keepPct    = MathMax(50.0, MathMin(95.0, SpikeCloseKeepPct)) / 100.0;
   const int    waitMaxSec = MathMax(15, SpikeCloseWaitSecondMaxSec);
   
   // Variables statiques pour suivre l'Ã©tat par ticket
   static ulong    s_ticket[64];
   static double   s_peak[64];
   static datetime s_peakTime[64];
   static bool     s_init = false;
   if(!s_init)
   {
      ArrayInitialize(s_ticket, 0);
      ArrayInitialize(s_peak, 0.0);
      ArrayInitialize(s_peakTime, 0);
      s_init = true;
   }
   
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;
      
      string symbol = posInfo.Symbol();
      ulong ticket = posInfo.Ticket();
      double profit = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      
      // Trouver ou crÃ©er un slot pour ce ticket
      int slot = -1;
      for(int s = 0; s < 64; s++)
         if(s_ticket[s] == ticket) { slot = s; break; }
      
      if(slot < 0)
      {
         // Nouveau ticket - trouver un slot libre
         for(int s = 0; s < 64; s++)
            if(s_ticket[s] == 0) { slot = s; break; }
         if(slot < 0) continue; // tableau plein
         s_ticket[slot] = ticket;
         s_peak[slot] = profit;
         s_peakTime[slot] = TimeCurrent();
      }
      
      // Mettre Ã  jour le pic si le profit actuel est plus Ã©levÃ©
      if(profit > s_peak[slot])
      {
         s_peak[slot] = profit;
         s_peakTime[slot] = TimeCurrent();
      }
      
      double peak = s_peak[slot];
      if(peak < minGain) continue; // Pas encore atteint le seuil minimum
      
      // VÃ©rifier si le profit est tombÃ© en dessous du pourcentage de protection
      if(profit > 0.0 && profit <= peak * keepPct)
      {
         int waited = (int)(TimeCurrent() - s_peakTime[slot]);
         string reason = StringFormat("Giveback %.0f%% peak=$%.2f (attendu %ds)", 
                                      (1.0 - keepPct) * 100.0, peak, waited);
         
         Print("â° DEADLINE SPIKE - Fermeture protectrice ", symbol, " #", ticket,
               " | ", reason,
               " | P/L=$", DoubleToString(profit, 2));
         
         if(PositionCloseWithLog(ticket, "Spike deadline - " + reason, true))
         {
            // Nettoyer le slot
            s_ticket[slot] = 0;
            s_peak[slot] = 0;
            s_peakTime[slot] = 0;
            if(UseNotifications)
               SendNotification("â° Spike deadline - " + symbol + " - " + reason);
         }
      }
      // VÃ©rifier le timeout si le signal est fort et on attend un second spike
      else if(profit >= minGain)
      {
         int waited = (int)(TimeCurrent() - s_peakTime[slot]);
         if(waited >= waitMaxSec)
         {
            // VÃ©rifier si le signal est encore fort (GOM ou spike chain)
            bool strong = false;
            if(g_smcGomConnected && MathAbs(g_smcGomVerdictNum) >= MinGOMVerdictNumAbs)
               strong = true;
            if(g_spikeChainState == SPIKE_STATE_CHAIN_ACTIVE || g_spikeChainStrongBars >= 2)
               strong = true;
            
            if(strong)
            {
               string reason = StringFormat("Timeout %ds sans 2e spike (signal fort)", waited);
               Print("â° DEADLINE SPIKE - Fermeture timeout ", symbol, " #", ticket,
                     " | ", reason,
                     " | P/L=$", DoubleToString(profit, 2));
               
               if(PositionCloseWithLog(ticket, "Spike deadline - " + reason, true))
               {
                  s_ticket[slot] = 0;
                  s_peak[slot] = 0;
                  s_peakTime[slot] = 0;
                  if(UseNotifications)
                     SendNotification("â° Spike deadline - " + symbol + " - " + reason);
               }
            }
         }
      }
   }
   
   // Nettoyer les slots des positions fermÃ©es
   for(int s = 0; s < 64; s++)
   {
      if(s_ticket[s] > 0)
      {
         bool found = false;
         for(int i = PositionsTotal() - 1; i >= 0; i--)
         {
            if(posInfo.SelectByIndex(i) && posInfo.Ticket() == s_ticket[s])
            {
               found = true;
               break;
            }
         }
         if(!found)
         {
            s_ticket[s] = 0;
            s_peak[s] = 0;
            s_peakTime[s] = 0;
         }
      }
   }
}

bool SMC_EnforceHardLossCutoff()
{
   if(MaxLossDollars <= 0.0 || PositionsTotal() <= 0) return false;
   bool cutoffTriggered = false;

   double effectiveMaxLoss = SMC_GetDynamicMaxLossUSD();
   // Respect minimum loss threshold before auto-close (user configurable)
   if(effectiveMaxLoss < MinLossBeforeAutoCloseUSD)
      effectiveMaxLoss = MinLossBeforeAutoCloseUSD;
   
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;

      ulong ticket = posInfo.Ticket();
      if(ticket == 0) continue;

      double loss = posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
      if(loss > -effectiveMaxLoss) continue;
      cutoffTriggered = true;

      string symbol = posInfo.Symbol();
      string side = (posInfo.PositionType() == POSITION_TYPE_BUY) ? "BUY" : "SELL";
      
      // FIX 2026-09-20: Enregistrer spike manquÃ© si SL touchÃ© sans atteindre spike
      int direction = (posInfo.PositionType() == POSITION_TYPE_BUY) ? 1 : -1;
      SMC_MSR_RegisterMissedSpike(symbol, direction);
      
      Print("ðŸš¨ COUPURE PERTE MAX â€” fermeture immÃ©diate ", symbol, " ", side,
            " ticket=", ticket, " | P/L=$", DoubleToString(loss, 2),
            " | limite effective=$", DoubleToString(effectiveMaxLoss, 2),
            " (dynamique=% solde, hard cap=$", DoubleToString(MaxLossHardCapDollars, 2), ")");

      // Appel direct volontaire : aucune protection d'Ã¢ge ou de seuil de
      // PositionCloseWithLog ne doit retarder cette fermeture d'urgence.
      if(trade.PositionClose(ticket))
      {
         Print("âœ… COUPURE PERTE MAX rÃ©ussie â€” ", symbol, " ticket=", ticket);
         // FIX v1.45: armer IMMEDIATEMENT le cooldown aprÃ¨s perte. Avant,
         // l armement dependait du scan async de l historique (deals) â€” le
         // SELL FX Vol 20 de 23:12 est passe sous le grill 15min pour ~2 min
         // aprÃ¨s une coupure Ã  22:58 (pertes consecutives observees).
         g_lastLossSymbol = symbol;
         g_lastLossTime   = TimeCurrent();
         SMC_OPF_RegisterLoss(symbol);
      }
      else
         Print("âŒ Ã‰CHEC COUPURE PERTE MAX â€” ", symbol, " ticket=", ticket,
               " | retcode=", trade.ResultRetcode(), " | err=", GetLastError());
   }
   return cutoffTriggered;
}

// FIX v1.44 (leÃ§on du 2026-10-11 22:58): pendant les micro-deconnexions
// Weltrade (connection lost toutes les 10-30s), la coupure EA a -1.50$ tirait
// bien mais CHAQUE PositionClose timeout (retcode 10012, err 4756) -> la perte
// glissait au-dela pendant ce temps. LE seul protecteur actif quand la
// connexion tombe est le SL SERVEUR. Cette fonction aligne en permanence le SL
// serveur de chaque position sur la limite de perte dynamique ($ % du solde):
// le broker devient le garde-fou -1.50$ meme terminal muet.
// - Ne jamais desserrer: on ne modifie que si le SL actuel implique PLUS de
//   perte que la limite (le trailing qui verrouille des gains reste maitre).
// - Echecs broker (stops level/freeze): logues throtte, retry au cycle suivant.
void SMC_SyncServerSLToDynamicLimit()
{
   if(MaxLossDollars <= 0.0 || PositionsTotal() <= 0) return;

   double dynMax = SMC_GetDynamicMaxLossUSD();
   if(dynMax < MinLossBeforeAutoCloseUSD)
      dynMax = MinLossBeforeAutoCloseUSD;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(!posInfo.SelectByIndex(i)) continue;
      if(posInfo.Magic() != InpMagicNumber) continue;

      string symbol = posInfo.Symbol();
      ulong ticket  = posInfo.Ticket();
      double lot    = posInfo.Volume();
      double entry  = posInfo.PriceOpen();
      double curSL  = posInfo.StopLoss();
      long   ptype  = posInfo.PositionType();
      if(ticket == 0 || lot <= 0 || entry <= 0) continue;

      double tickVal  = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_VALUE);
      double tickSize = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);
      int    dg       = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);
      if(tickVal <= 0 || tickSize <= 0) continue;

      double lossPerPrice = (tickVal * lot) / tickSize; // $ par unitÃ© de prix
      if(lossPerPrice <= 0) continue;
      double allowedDist = dynMax / lossPerPrice;       // distance pour -$dynMax

      double target;
      bool needMove;
      if(ptype == POSITION_TYPE_BUY)
      {
         target   = NormalizeDouble(entry - allowedDist, dg);
         needMove = (curSL == 0.0 || curSL < target);
      }
      else
      {
         target   = NormalizeDouble(entry + allowedDist, dg);
         needMove = (curSL == 0.0 || curSL > target);
      }
      if(!needMove) continue; // SL actuel deja plus protecteur (trailing etc.)

      if(trade.PositionModify(ticket, target, posInfo.TakeProfit()))
      {
         static datetime s_syncOkLog = 0;
         if(TimeCurrent() - s_syncOkLog >= 60)
         {
            s_syncOkLog = TimeCurrent();
            Print("ðŸ›¡ï¸ SL-SERVEUR SYNC ", symbol, " ticket=", ticket,
                  " SLâ†’", DoubleToString(target, dg),
                  " (perte max broker $", DoubleToString(dynMax, 2), ")");
         }
      }
      else
      {
         static datetime s_syncFailLog = 0;
         if(TimeCurrent() - s_syncFailLog >= 30)
         {
            s_syncFailLog = TimeCurrent();
            Print("âš ï¸ SL-SERVEUR SYNC ", symbol, " ticket=", ticket,
                  " SLâ†’", DoubleToString(target, dg), " REJETE (retcode=",
                  trade.ResultRetcode(), " err=", GetLastError(),
                  ") â€” retry au cycle suivant");
         }
      }
   }
}

void ManageDollarExits()
{
   // Si les sorties en dollars sont dÃ©sactivÃ©es, sortir immÃ©diatement
   if(!UseDollarExits)
   {
      static datetime lastLog = 0;
      if(TimeCurrent() - lastLog >= 30) // Log toutes les 30 secondes maximum
      {
         Print("ðŸ” DEBUG - ManageDollarExits DÃ‰SACTIVÃ‰E - laisse SL/TP normal fonctionner");
         lastLog = TimeCurrent();
      }
      return;
   }
   
   // DEBUG: Log pour voir si cette fonction est appelÃ©e
   static datetime lastLog = 0;
   if(TimeCurrent() - lastLog >= 5) // Log toutes les 5 secondes maximum
   {
      Print("ðŸ” DEBUG - ManageDollarExits appelÃ©e | MaxLossDollars: ", MaxLossDollars, " | BoomCrashSpikeTP: ", BoomCrashSpikeTP);
      lastLog = TimeCurrent();
   }
   
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      string symbol = PositionGetSymbol(i);
      if(symbol == "") continue;
      
      ulong ticket = PositionGetInteger(POSITION_TICKET);
      if(ticket == 0) continue;
      double profit = PositionGetDouble(POSITION_PROFIT);
      ENUM_SYMBOL_CATEGORY cat = SMC_GetSymbolCategory(symbol);
      
      // 2e spike estimÃ© imminent (chaÃ®ne forte confirmÃ©e - GOM_TF_TL_M1/M5,
      // DOW, SMC_DISP_FVG_TRAIL, pivots H/L M5) : ne pas prendre le profit ici,
      // laisser SMC_ManageFirstSpikeGiveBackGuard gÃ©rer la sortie (max 30% de
      // giveback sur le pic de gain).
      bool secondSpikeImminent = (g_firstSpikeChainQualified && g_secondSpikeArmed &&
                                   ticket == g_firstSpikeTicket);
      
      // Laisser les trades respirer aprÃ¨s ouverture
      datetime openTime = (datetime)PositionGetInteger(POSITION_TIME);
      int secondsSinceOpen = (int)(TimeCurrent() - openTime);
      int minAgeSec = MathMax(MinPositionLifetimeSec, 60); // Au moins MinPositionLifetimeSec
      
      if(secondsSinceOpen < minAgeSec && profit > -MathMin(MaxLossHardCapDollars, 4.50))
      {
         continue; // Ignorer ce trade â€” trop rÃ©cent (sauf hard loss)
      }
      
      // DEBUG: Log chaque position analysÃ©e
      Print("ðŸ” DEBUG - Position analysÃ©e - ", symbol, " | Profit: ", DoubleToString(profit, 2), "$ | Ticket: ", ticket, " | CatÃ©gorie: ", (cat == SYM_BOOM_CRASH ? "BOOM_CRASH" : "AUTRE"), " | Ã‚ge: ", secondsSinceOpen, "s");
      
      // RÃˆGLE UNIVERSELLE: Fermer TOUTES les positions Ã  2 dollars de profit
      if(profit >= 2.0 && !secondSpikeImminent)
      {
         Print("âš ï¸ TENTATIVE FERMETURE TP 2$ - ", symbol, " | Profit: ", DoubleToString(profit, 2), "$");
         // VALIDATION: VÃ©rifier que la position existe toujours avant de fermer
         if(!PositionSelectByTicket(ticket))
         {
            Print("âš ï¸ Position dÃ©jÃ  fermÃ©e avant 2$ TP - ", symbol, " | ticket=", ticket);
            continue;
         }
         
         if(PositionCloseWithLog(ticket, "Profit total atteint"))
            Print("âœ… EA Position fermÃ©e: bÃ©nÃ©fice 2$ atteint (", DoubleToString(profit, 2), "$) - ", symbol, " | ticket=", ticket);
         else
         {
            int err = GetLastError();
            Print("âŒ EA Ã‰CHEC FERMETURE TP GLOBAL - ", symbol, " | ticket=", ticket, " | code=", err);
         }
         continue;
      }
      
      // RÃ¨gle de perte maximale pour TOUTES les catÃ©gories, y compris
      // Boom/Crash, en complÃ©ment de la coupure prioritaire par tick.
      int posDir = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? 1 : -1;
      bool onChartSymbol = (symbol == _Symbol);
      double maxLossForPos = SMC_HardMaxLossUSD();
      if(onChartSymbol && UseGOMVerdictFilter && g_smcGomConnected)
         maxLossForPos = SMC_GetPositionMaxLossUSD(posDir, false);

      if(onChartSymbol && g_smcGomVerdictNum == 0 && profit <= -GOMWaitCloseMinLossUSD)
      {
         Print("âš ï¸ TENTATIVE FERMETURE PERTE MAX - ", symbol, " | Profit: ", DoubleToString(profit, 2),
               "$ | WAIT ", DoubleToString(GOMWaitCloseMinLossUSD, 2), "$");
         if(!PositionSelectByTicket(ticket))
            continue;
         if(PositionCloseWithLog(ticket, "GOM WAIT â€” perte >= seuil $"))
            Print("ðŸ›‘ EA fermÃ© WAIT+perte (", DoubleToString(profit, 2), "$) - ", symbol, " | ticket=", ticket);
         continue;
      }

      if(profit <= -maxLossForPos)
      {
         // Respect minimum loss threshold before auto-close
         if(MathAbs(profit) < MinLossBeforeAutoCloseUSD)
            continue;
         Print("âš ï¸ TENTATIVE FERMETURE PERTE MAX - ", symbol, " | Profit: ", DoubleToString(profit, 2),
               "$ | MaxLoss: ", DoubleToString(maxLossForPos, 2), "$");
         // VALIDATION: VÃ©rifier que la position existe toujours avant de fermer
         if(!PositionSelectByTicket(ticket))
         {
            Print("âš ï¸ Position dÃ©jÃ  fermÃ©e avant perte max - ", symbol, " | ticket=", ticket);
            continue;
         }
         
         if(PositionCloseWithLog(ticket, "Perte max atteinte"))
            Print("ðŸ›‘ EA Position fermÃ©e: perte max atteinte (", DoubleToString(profit, 2), "$) - ", symbol, " | ticket=", ticket);
         else
         {
            int err = GetLastError();
            Print("âŒ EA Ã‰CHEC FERMETURE SL GLOBAL - ", symbol, " | ticket=", ticket, " | code=", err);
         }
         continue;
      }
      
      // RÃ¨gles spÃ©cifiques Boom/Crash (en plus de la rÃ¨gle universelle)
      if(cat == SYM_BOOM_CRASH)
      {
         // Spike TP pour Boom/Crash
         if(profit >= BoomCrashSpikeTP && profit < 2.0 && !secondSpikeImminent) // Si entre spike TP et 2$
         {
            Print("âš ï¸ TENTATIVE FERMETURE BOOM/CRASH SPIKE TP - ", symbol, " | Profit: ", DoubleToString(profit, 2), "$ | SpikeTP: ", DoubleToString(BoomCrashSpikeTP, 2), "$");
            // VALIDATION: VÃ©rifier que la position existe toujours avant de fermer
            if(!PositionSelectByTicket(ticket))
            {
               Print("âš ï¸ Position dÃ©jÃ  fermÃ©e avant Boom/Crash spike TP - ", symbol, " | ticket=", ticket);
               continue;
            }
            
            if(CloseBoomCrashPosition(ticket, symbol))
            {
               Print("ðŸš€ EA Boom/Crash fermÃ© aprÃ¨s spike (gain > ", DoubleToString(BoomCrashSpikeTP, 2), "$): ", DoubleToString(profit, 2), "$ | ticket=", ticket, " - ", symbol);
               if(symbol == _Symbol) { g_lastBoomCrashPrice = 0; }
            }
            continue;
         }
      }
   }
}

// Ferme les positions et ordres en conflit avec l'IA (optionnel)
void ClosePositionsOnDirectionConflict()
{
   // SÃ©curitÃ© : ne rien faire si la fermeture sur conflit est dÃ©sactivÃ©e
   if(!UseDirectionConflictClose || !UseAIServer)
      return;

   // IA doit Ãªtre clairement BUY ou SELL avec une confiance suffisante
   string ai = g_lastAIAction;
   StringToUpper(ai);
   if(ai != "BUY" && ai != "SELL")
      return;

   double conf = g_lastAIConfidence;
   if(conf < MinAIConfidence)
      return;

   string sym = _Symbol;
   ENUM_SYMBOL_CATEGORY symCat = SMC_GetSymbolCategory(sym);

   // 1) Fermer les POSITIONS en conflit sur ce symbole (BUY vs SELL)
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string psym = PositionGetString(POSITION_SYMBOL);
      ulong pmagic = (ulong)PositionGetInteger(POSITION_MAGIC);
      if(psym != sym || pmagic != InpMagicNumber)
         continue;

      ENUM_POSITION_TYPE ptype = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      bool conflict = false;

      if(ptype == POSITION_TYPE_SELL && ai == "BUY")
         conflict = true;
      else if(ptype == POSITION_TYPE_BUY && ai == "SELL")
         conflict = true;

      if(!conflict)
         continue;

      // IMPORTANT: sur Boom/Crash, ne pas fermer les positions issues d'ordres LIMIT canal/retour
      // (sinon on "coupe" immÃ©diatement aprÃ¨s un fill et on rate le spike).
      if(symCat == SYM_BOOM_CRASH)
      {
         string cmt = PositionGetString(POSITION_COMMENT);
         if(StringFind(cmt, "SMC_CH") >= 0 || StringFind(cmt, "RETURN_MOVE") >= 0)
         {
            Print("ðŸ›‘ SKIP CLOSE (conflit IA) - Boom/Crash LIMIT protÃ©gÃ© | ", psym,
                  " | Ticket=", ticket,
                  " | Type=", (ptype == POSITION_TYPE_BUY ? "BUY" : "SELL"),
                  " | IA=", ai, " ", DoubleToString(conf * 100.0, 1), "% | Comment=", cmt);
            continue;
         }
      }

      double profit = PositionGetDouble(POSITION_PROFIT);

      // RÃˆGLE STRICTE: Fermer TOUTES les positions en conflit avec l'IA
      // mÃªme si elles sont en perte - pour Ã©viter de maintenir des positions opposÃ©es Ã  l'IA
      // Log: afficher si la position est en perte ou en profit

      if(trade.PositionClose(ticket))
      {
         string profitStatus = (profit >= 0) ? "GAIN" : "PERTE";
         Print("âš ï¸ POSITION FERMÃ‰E (conflit IA) - ", psym,
               " | Type=", (ptype == POSITION_TYPE_BUY ? "BUY" : "SELL"),
               " | IA=", ai, " ",
               DoubleToString(conf * 100.0, 1), "% | ",
               profitStatus, "=", DoubleToString(MathAbs(profit), 2), "$");
      }
      else
      {
         Print("âŒ ECHEC FERMETURE (conflit IA) - ", psym,
               " | Ticket=", ticket,
               " | Erreur=", _LastError);
      }
   }
}

// Ferme toutes les positions de l'EA quand l'IA passe en HOLD
void ClosePositionsOnIAHold()
{
   // SÃ©curitÃ© : ne rien faire si la fermeture sur HOLD est dÃ©sactivÃ©e
   if(!UseIAHoldClose || !UseAIServer)
      return;
   
   // VÃ©rifier si l'IA est en HOLD
   string aiAction = g_lastAIAction;
   StringToUpper(aiAction);
   
   if(aiAction != "HOLD") return;

   // FIX v1.42: ne fermer QUE sur un HOLD reellement calcule par le serveur.
   // Les fallbacks locaux (EMA/tendance/random des timeouts) taggent
   // g_lastAISource != "SERVER" : fermer une position dessus tuait des gains
   // (observe: FX Vol 40 +$0.09/11s ferme sur un HOLD degre d un timeout 1003).
   if(g_lastAISource != "SERVER")
   {
      static datetime s_iaHoldSkipLog = 0;
      if(TimeCurrent() - s_iaHoldSkipLog >= 60)
      {
         s_iaHoldSkipLog = TimeCurrent();
         Print("[IA-HOLD] SKIP fermeture â€” source statut IA = ", g_lastAISource,
               " (non-serveur) : pas de decision valide pour clore des positions");
      }
      return;
   }
   
   // Parcourir toutes les positions de l'EA
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      if(PositionGetSymbol(i) == _Symbol && PositionGetInteger(POSITION_MAGIC) == InpMagicNumber)
      {
         ulong ticket = PositionGetInteger(POSITION_TICKET);
         string symbol = PositionGetString(POSITION_SYMBOL);
         double profit = PositionGetDouble(POSITION_PROFIT);
         ENUM_POSITION_TYPE type = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
         string cmt = PositionGetString(POSITION_COMMENT);

         // IMPORTANT: sur Boom/Crash, ne pas fermer automatiquement les positions issues d'ordres LIMIT canal/retour
         // mÃªme si l'IA passe en HOLD (sinon on rate le spike juste aprÃ¨s le fill).
         if(SMC_GetSymbolCategory(symbol) == SYM_BOOM_CRASH)
         {
            if(StringFind(cmt, "SMC_CH") >= 0 || StringFind(cmt, "RETURN_MOVE") >= 0)
            {
               Print("ðŸ›‘ SKIP CLOSE (IA HOLD) - Boom/Crash LIMIT protÃ©gÃ© | ",
                     (type == POSITION_TYPE_BUY ? "BUY" : "SELL"),
                     " sur ", symbol,
                     " | Ticket=", ticket,
                     " | Profit=", DoubleToString(profit, 2), "$",
                     " | Comment=", cmt);
               continue;
            }
         }
         
         // FIX v1.41 (protection des gains FX Vol) : sur les symboles de
         // volatilite Weltrade (FX Vol / SFX Vol / SFV Vol), la sortie est geree
         // par le trailing dollar dedie (FxVolTrail*). L auto-close IA HOLD tuait
         // le trade au premier HOLD de g_lastAIAction â€” y compris les HOLD
         // fallback apres chaque timeout HTTP 1003 de /decision (serveur charge) :
         // position fermee 11s apres ouverture (observe: FX Vol 40, +$0.09,
         // ticket 643548633). Exemption -> le trailing $ decide, la garde de
         // perte dure (hard loss) reste active en amont.
         if(SMC_IsWeltradeVolSymbol(symbol))
         {
            Print("ðŸ›‘ SKIP CLOSE (IA HOLD) - ", symbol, " exit gÃ©rÃ© par le trailing $ FXVOL | Ticket=", ticket,
                  " | Profit=", DoubleToString(profit, 2), "$");
            continue;
         }

         // Respecter le seuil -1$ avant fermeture sur IA HOLD
         if(profit < 0 && profit > -1.0)
         {
            Print("[IA-HOLD] Ticket=", ticket, " perte=", DoubleToString(profit,2), "$ > -1$ â€” attente seuil avant fermeture");
            continue;
         }

         bool closed = PositionCloseWithLog(ticket, "IA HOLD - Fermeture automatique", true);

         if(closed)
            Print("[IA-HOLD] Position fermee | ", (type == POSITION_TYPE_BUY ? "BUY" : "SELL"),
                  " sur ", symbol, " | Profit: ", DoubleToString(profit, 2), "$");
         else
            Print("âŒ ECHEC FERMETURE - IA HOLD | Erreur: ", GetLastError());
      }
   }
}

//+------------------------------------------------------------------+
//| GOM VERDICTS INTEGRATION â€” Fetch from ai_server /gom-verdicts   |
//+------------------------------------------------------------------+

static datetime last_gom_fetch = 0;
static int GOM_fetch_interval = 3;  // Fetch every 3 seconds (was 60)
static string last_notified_symbols = "";  // Track which symbols were notified

void UpdateGOMDashboard()
{
    // Fetch from ai_server every 60 seconds â€” WhatsApp alerts for PERFECT signals
    datetime now = TimeCurrent();

    if((now - last_gom_fetch) < GOM_fetch_interval)
        return;

    last_gom_fetch = now;

    string url = "http://127.0.0.1:8000/gom-verdicts";
    string headers = "Content-Type: application/json\r\n";

    uchar request[];
    uchar response[];
    string result_headers = "";
    int timeout = 5000;

    // MQL5 WebRequest signature: (url, method, headers, timeout, request[], response[], result_headers)
    int res = WebRequest("GET", url, headers, timeout, request, response, result_headers);

    if(res != 200)
    {
        return;
    }

    string response_str = CharArrayToString(response);

    // Check for "ok": true (with or without quotes â€” MQL5 string comparison)
    if(StringFind(response_str, "\"ok\":true") < 0 && StringFind(response_str, "\"ok\": true") < 0)
        return;

    // GOM scan WhatsApp DÃ‰SACTIVÃ‰ â€” on garde seulement les signaux SR20
    // (les alerts GOM PERFECT BUY/SELL sont maintenant gÃ©rÃ©es par les ordres SR20 + spike chain)

    // Reset tracking every 24 hours to allow re-notifications
    static datetime last_reset = 0;
    if((now - last_reset) >= 86400)  // 24 hours
    {
        last_notified_symbols = "";
        last_reset = now;
    }
}

void SendGOMWhatsAppAlert(const string &message)
{
    string url = "http://127.0.0.1:8000/notify-whatsapp";
    string payload = "{\"message\": \"ðŸŽ¯ GOM Signal: " + message + "\"}";

    uchar request[];
    StringToCharArray(payload, request);
    uchar response[];
    string result_headers = "";

    // MQL5 WebRequest signature: (url, method, headers, timeout, request[], response[], result_headers)
    int res = WebRequest("POST", url, "Content-Type: application/json\r\n", 3000, request, response, result_headers);

    if(res == 200)
    {
        Print("âœ… WhatsApp alert sent: ", message);
    }
    else if(res == -1)
    {
        Print("âš ï¸ WebRequest not allowed (check Tools > Options > EA > Allow WebRequest)");
    }
    else
    {
        Print("âš ï¸ WhatsApp send failed (HTTP ", res, ")");
    }
}

// â”€â”€ SR20 WhatsApp Signal: trade signal, entry, SL, TP, SR20 evolution, spike prediction, exit â”€â”€
void SendSR20WhatsAppSignal(const string &event, const string &symbol, const string &direction,
                            double entry, double sl, double tp, double price,
                            double sr20Level, const string &sr20Type, double atr,
                            double spikeProb, int greenBars, const string &exitReason)
{
    if(!UseWhatsAppAlerts) return;

    string ts = TimeToString(TimeCurrent(), TIME_MINUTES);
    string icon = "ðŸ“Š";
    if(event == "SR20_ENTRY")       icon = "ðŸŽ¯";
    else if(event == "SR20_SPIKE")  icon = "âš¡";
    else if(event == "SR20_EXIT")   icon = "ðŸ";
    else if(event == "SR20_TP")     icon = "âœ…";
    else if(event == "SR20_SL")     icon = "ðŸ›‘";
    else if(event == "SR20_WARN")   icon = "âš ï¸";

    string msg = icon + " " + event + " [" + ts + "]\n";
    msg += "Symbole: " + symbol + "\n";
    msg += "Direction: " + direction + "\n";
    msg += "Prix: " + DoubleToString(price, _Digits) + "\n";
    msg += "Entree: " + DoubleToString(entry, _Digits) + "\n";
    msg += "SL: " + DoubleToString(sl, _Digits) + " | TP: " + DoubleToString(tp, _Digits) + "\n";

    // SR20 evolution
    if(sr20Level > 0)
    {
        double dist = MathAbs(price - sr20Level);
        double distPct = (price > 0) ? (dist / price * 100.0) : 0;
        msg += "SR20 " + sr20Type + ": " + DoubleToString(sr20Level, _Digits) + "\n";
        msg += "Distance: " + DoubleToString(dist, _Digits) + " (" + DoubleToString(distPct, 2) + "%)\n";
        if(atr > 0)
        {
            double atrRatio = dist / atr;
            msg += "ATR ratio: " + DoubleToString(atrRatio, 2) + "\n";
        }
    }

    // Spike chain prediction
    if(spikeProb > 0)
    {
        msg += "Spike pred: " + DoubleToString(spikeProb * 100, 0) + "%";
        if(greenBars > 0)
            msg += " (" + IntegerToString(greenBars) + " bougies vertes)";
        msg += "\n";
    }

    // Exit reason
    if(exitReason != "")
        msg += "Sortie: " + exitReason + "\n";

    // Build JSON payload
    string payload = "{\"event\":\"" + event + "\",\"symbol\":\"" + symbol
        + "\",\"direction\":\"" + direction
        + "\",\"price\":" + DoubleToString(price, _Digits)
        + ",\"entry_price\":" + DoubleToString(entry, _Digits)
        + ",\"sl\":" + DoubleToString(sl, _Digits)
        + ",\"tp1\":" + DoubleToString(tp, _Digits)
        + ",\"message\":\"" + msg + "\"}";

    string url = "http://127.0.0.1:8000/notify-whatsapp";
    string headers = "Content-Type: application/json\r\n";
    uchar request[];
    StringToCharArray(payload, request);
    uchar response[];
    string result_headers = "";

    int res = WebRequest("POST", url, headers, 5000, request, response, result_headers);
    if(res == 200)
        Print("âœ… SR20 WhatsApp: ", event, " ", symbol);
    else if(res == -1)
        Print("âš ï¸ SR20 WhatsApp: WebRequest not allowed");
    else
        Print("âš ï¸ SR20 WhatsApp failed (HTTP ", res, ")");
}

// â”€â”€ RAPPORT QUOTIDIEN WHATSAPP (v1.50 â€” demande trader) â”€â”€
input group "=== RAPPORT QUOTIDIEN WHATSAPP (v1.50) ==="
input bool   WA_DailyReport      = true;   // Envoyer un rapport quand le jour se clÃ´ture
input int    WA_DailyReportHour  = 21;     // Heure d'envoi (0-23, heure serveur MT5)
input int    WA_DailyReportWindow= 24;     // FenÃªtre couverte (heures d'historique)

void SMC_WA_DailyReportTick()
{
   if(!WA_DailyReport) return;

   MqlDateTime dt; TimeToStruct(TimeCurrent(), dt);
   string dayKey = StringFormat("%04d%02d%02d", dt.year, dt.mon, dt.day);
   string gvName = "SMC_WA_REPORT_" + dayKey;

   if(GlobalVariableCheck(gvName)) return;
   if(dt.hour < WA_DailyReportHour) return;

   datetime from = TimeCurrent() - 86400 * (long)MathMax(1, WA_DailyReportWindow);
   if(!HistorySelect(from, TimeCurrent() + 60)) return;
   int wins = 0, losses = 0;
   double sumW = 0, sumL = 0, best = -1e9, worst = 1e9;
   string bestSym = "-", worstSym = "-";
   int tot = HistoryDealsTotal();
   for(int i = tot - 1; i >= 0; i--)
   {
      ulong dticket = HistoryDealGetTicket(i);
      if(dticket == 0) continue;
      if((ulong)HistoryDealGetInteger(dticket, DEAL_MAGIC) != InpMagicNumber) continue;
      long entryT = HistoryDealGetInteger(dticket, DEAL_ENTRY);
      if(entryT != DEAL_ENTRY_OUT && entryT != DEAL_ENTRY_OUT_BY) continue;
      double pf = HistoryDealGetDouble(dticket, DEAL_PROFIT)
                + HistoryDealGetDouble(dticket, DEAL_SWAP)
                + HistoryDealGetDouble(dticket, DEAL_COMMISSION);
      string sym = HistoryDealGetString(dticket, DEAL_SYMBOL);
      if(pf > 0) { wins++; sumW += pf; if(pf > best) { best = pf; bestSym = sym; } }
      else if(pf < 0) { losses++; sumL += pf; if(pf < worst) { worst = pf; worstSym = sym; } }
   }
   if(wins + losses == 0) return;

   double net = sumW + sumL;
   double wr  = 100.0 * wins / (wins + losses);
   string msg = StringFormat(
      "RAPPORT 24h %s\nGains: %d trades (%.2f$)\nPertes: %d trades (%.2f$)\nNET: %+.2f$ | Winrate: %.0f%%\nMeilleur: %+.2f$ (%s)\nPire: %+.2f$ (%s)\nProtections: coupure dollar + trail + SL serveur + POC",
      dayKey, wins, sumW, losses, sumL, net, wr, best, bestSym, worst, worstSym);
   if(StringLen(msg) > 700) msg = StringSubstr(msg, 0, 700);
   StringReplace(msg, "\\\\", "\\\\\\\\");
   StringReplace(msg, "\"", "\\\"");

   string payload = "{\"event\":\"CUSTOM\",\"symbol\":\"PORTFOLIO\",\"message\":\"" + msg + "\"}";
   uchar request[]; StringToCharArray(payload, request);
   uchar response[]; string respH = "";
   int res = WebRequest("POST", "http://127.0.0.1:8000/notify-whatsapp",
                        "Content-Type: application/json\\r\\n", 5000, request, response, respH);
   if(res == 200)
   {
      GlobalVariableSet(gvName, 1);
      Print("RAPPORT QUOTIDIEN WhatsApp envoye | ", wins, "W / ", losses,
            "L | net=", DoubleToString(net, 2), "$");
   }
   else
      Print("RAPPORT QUOTIDIEN echec HTTP ", res);
}

// â”€â”€ NOTIFICATIONS WHATSAPP TRADES (v1.53) â”€â”€
input group "=== NOTIFICATIONS WHATSAPP TRADES (v1.53) ==="
input bool   WA_TradeEvents   = true;   // Notifier chaque ouverture/fermeture de trade
input bool   WA_ReportCapital = true;   // Ajouter capital restant + winrate du jour aux fermetures

void SMC_WA_Send(const string &msg)
{
   string payload = "{\"event\":\"CUSTOM\",\"symbol\":\"PORTFOLIO\",\"message\":\"" + msg + "\"}";
   uchar rq[]; StringToCharArray(payload, rq);
   uchar rs[]; string rh = "";
   int res = WebRequest("POST", "http://127.0.0.1:8000/notify-whatsapp",
                        "Content-Type: application/json\r\n", 5000, rq, rs, rh);
   if(res != 200) Print("WA-TRADEEVENT echec HTTP ", res);
}

void SMC_WA_StatsJour(int &wins, int &losses)
{
   wins = 0; losses = 0;
   datetime from = TimeCurrent() - 86400;
   if(!HistorySelect(from, TimeCurrent() + 60)) return;
   int tot = HistoryDealsTotal();
   for(int i = tot - 1; i >= 0; i--)
   {
      ulong tk = HistoryDealGetTicket(i);
      if(tk == 0) continue;
      if((ulong)HistoryDealGetInteger(tk, DEAL_MAGIC) != InpMagicNumber) continue;
      long eT = HistoryDealGetInteger(tk, DEAL_ENTRY);
      if(eT != DEAL_ENTRY_OUT && eT != DEAL_ENTRY_OUT_BY) continue;
      double pf = HistoryDealGetDouble(tk, DEAL_PROFIT) + HistoryDealGetDouble(tk, DEAL_SWAP) + HistoryDealGetDouble(tk, DEAL_COMMISSION);
      if(pf > 0) wins++; else if(pf < 0) losses++;
   }
}

void SMC_WA_TradeEventTick()
{
   if(!WA_TradeEvents) return;
   static ulong s_lastDeal = 0;
   bool firstRun = (s_lastDeal == 0);
   if(!HistorySelect(TimeCurrent() - 86400, TimeCurrent() + 60)) return;
   int tot = HistoryDealsTotal();
   if(tot == 0) return;
   for(int i = 0; i < tot; i++)
   {
      ulong tk = HistoryDealGetTicket(i);
      if(tk == 0 || tk <= s_lastDeal) continue;
      s_lastDeal = tk;
      if(firstRun) continue;   // ne pas flooder l'historique au dÃ©marrage
      if((ulong)HistoryDealGetInteger(tk, DEAL_MAGIC) != InpMagicNumber) continue;
      string gv = "SMC_WA_DEAL_" + (string)tk;
      if(GlobalVariableCheck(gv)) continue;   // dÃ©jÃ  notifiÃ© (12 charts)
      long eT = HistoryDealGetInteger(tk, DEAL_ENTRY);
      string sym  = HistoryDealGetString(tk, DEAL_SYMBOL);
      double pr   = HistoryDealGetDouble(tk, DEAL_PRICE);
      double vol  = HistoryDealGetDouble(tk, DEAL_VOLUME);
      long   typ  = HistoryDealGetInteger(tk, DEAL_TYPE);
      string dir  = (typ == DEAL_TYPE_BUY) ? "BUY" : "SELL";
      int    dg   = (int)SymbolInfoInteger(sym, SYMBOL_DIGITS);
      string msg;
      if(eT == DEAL_ENTRY_IN)
      {
         msg = StringFormat("IN %s %s %.2f @ %s", sym, dir, vol, DoubleToString(pr, dg));
         if(WA_ReportCapital)
            msg += StringFormat(" | Capital: %.2f$", AccountInfoDouble(ACCOUNT_BALANCE));
      }
      else if(eT == DEAL_ENTRY_OUT || eT == DEAL_ENTRY_OUT_BY)
      {
         double pf = HistoryDealGetDouble(tk, DEAL_PROFIT) + HistoryDealGetDouble(tk, DEAL_SWAP) + HistoryDealGetDouble(tk, DEAL_COMMISSION);
         long rsn = HistoryDealGetInteger(tk, DEAL_REASON);
         string why = (rsn == DEAL_REASON_SL) ? " (SL)" : (rsn == DEAL_REASON_TP) ? " (TP)" : "";
         msg = StringFormat("OUT %s %s %+.2f$%s", sym, dir, pf, why);
         if(WA_ReportCapital)
         {
            int w = 0, l = 0; SMC_WA_StatsJour(w, l);
            double wr = (w + l > 0) ? 100.0 * w / (w + l) : 0.0;
            msg += StringFormat(" | Capital: %.2f$ | Jour: %dW/%dL (%.0f%%)", AccountInfoDouble(ACCOUNT_BALANCE), w, l, wr);
         }
      }
      else continue;
      SMC_WA_Send(msg);
      GlobalVariableSet(gv, 1);
      Print("WA-TRADEEVENT: ", msg);
   }
}


// â”€â”€ Spike Chain Prediction: modelise les chaines de spikes a venir â”€â”€
void PredictSpikeChainAndAlert()
{
    if(!UseWhatsAppAlerts) return;
    bool isSpike = IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol);
    if(!isSpike) return;

    // RSI squeeze + green bar count for spike probability
    static int rsiM1HandleLocal = INVALID_HANDLE;
    if(rsiM1HandleLocal == INVALID_HANDLE)
        rsiM1HandleLocal = iRSI(_Symbol, PERIOD_M1, 7, PRICE_CLOSE);
    if(rsiM1HandleLocal == INVALID_HANDLE) return;

    double rsi[];
    ArraySetAsSeries(rsi, true);
    if(CopyBuffer(rsiM1HandleLocal, 0, 0, 20, rsi) < 20) return;

    // Count consecutive green (bullish) candles
    MqlRates rates[];
    ArraySetAsSeries(rates, true);
    if(CopyRates(_Symbol, PERIOD_M1, 0, 10, rates) < 10) return;

    int greenBars = 0;
    for(int i = 0; i < 5; i++)
    {
        if(rates[i].close > rates[i].open)
            greenBars++;
        else
            break;
    }

    // Spike probability: based on RSI(7) squeeze + green bar count
    bool isBoom = IsBoomLikeSymbol(_Symbol);
    bool isCrash = IsCrashLikeSymbol(_Symbol);
    if(!isBoom && !isCrash) return;

    double rsiVal = rsi[0];
    double spikeProb = 0;

    // For Boom: spike = sudden drop (BUY). High RSI + green bars = spike imminent
    if(isBoom && rsiVal > 65 && greenBars >= 2)
    {
        spikeProb = MathMin(0.95, 0.4 + (rsiVal - 65) / 100.0 + greenBars * 0.1);
    }
    // For Crash/Painx: spike = sudden drop (SELL). Low RSI + green bars = spike imminent
    if(isCrash && rsiVal < 35 && greenBars >= 2)
    {
        spikeProb = MathMin(0.95, 0.4 + (35 - rsiVal) / 100.0 + greenBars * 0.1);
    }

    if(spikeProb < 0.5) return;

    // Check last notification time to avoid spam
    static datetime lastSpikeNotif = 0;
    if(TimeCurrent() - lastSpikeNotif < 120) return;  // max 1 per 2 min

    string dir = isBoom ? "BUY" : "SELL";
    string sr20Type = isBoom ? "SUP" : "RES";
    double sr20Level = isBoom ? g_impulseSupport20 : g_impulseResistance20;

    double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
    double atrVal = 0;
    if(atrHandle != INVALID_HANDLE)
    {
        double atr[];
        ArraySetAsSeries(atr, true);
        if(CopyBuffer(atrHandle, 0, 0, 1, atr) >= 1) atrVal = atr[0];
    }

    double entry = price;
    double sl = isBoom ? (price - atrVal * 2.0) : (price + atrVal * 2.0);
    double tp = isBoom ? (price + atrVal * 5.0) : (price - atrVal * 5.0);

    SendSR20WhatsAppSignal("SR20_SPIKE", _Symbol, dir,
                           entry, sl, tp, price,
                           sr20Level, sr20Type, atrVal,
                           spikeProb, greenBars,
                           "Spike imminent detecte");

    lastSpikeNotif = TimeCurrent();
}

// Chain Predictor + Cross Corr: inscription continue du spike courant.
// L'ancien bloc ne tournait que dans le chemin d'entree (CheckAndExecuteDerivArrowTrade)
// -> panneaux figures hors tentative. Ce helper tourne chaque tick OnTick.
void SMC_ChainPred_RegisterRecentSpike()
{
   if(!UseChainPredictor) return;
   if(!(IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol) ||
        SMC_IsWeltradeSynthSymbol(_Symbol))) return;

   MqlRates chainRates[];
   ArraySetAsSeries(chainRates, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 10, chainRates) < 5) return;

   double chainAtr = ChainPred_GetATR(_Symbol, PERIOD_M1, 14);
   if(chainAtr <= 0) return;

   int cIdx = -1;
   for(int ci = 1; ci <= 5 && ci < ArraySize(chainRates); ci++)
   {
      double bodyCi = MathAbs(chainRates[ci].close - chainRates[ci].open);
      if(bodyCi >= chainAtr * SpikeChainBodyATRMult)
      { cIdx = ci; break; }
   }
   if(cIdx <= 0)
   {
      ChainPred_Evaluate();
      return;
   }

   static datetime s_lastChainSpikeTime = 0;
   if(chainRates[cIdx].time == s_lastChainSpikeTime)
   {
      ChainPred_Evaluate();
      return;
   }
   s_lastChainSpikeTime = chainRates[cIdx].time;

   double cBody = MathAbs(chainRates[cIdx].close - chainRates[cIdx].open);
   double cAtr  = cBody / chainAtr;
   int cDir    = (chainRates[cIdx].close > chainRates[cIdx].open) ? 1 : -1;
   ChainPred_RegisterSpike(chainRates[cIdx].time, cAtr, cDir);
   CrossCorr_RegisterSpike(_Symbol, chainRates[cIdx].time, cAtr, cDir);
}

//+------------------------------------------------------------------+
//| UNIFIED ENTRY: GOM + M1/M5 + one essential reaction level        |
//|                                                                  |
//| This is deliberately the only opening trigger used when          |
//| UnifiedGOMEntryMode=true. Levels are read from the objects already|
//| published by the GOM/SMC/DOW/Pivot modules, so this function does  |
//| not create a second, divergent level calculation.                 |
//+------------------------------------------------------------------+
struct SMC_ReconstructedVisualState
{
   int      bias;
   int      direction;
   bool     analysisValid;
   bool     impulseValid;
   bool     confirmed;
   double   rangeHigh;
   double   rangeLow;
   double   impulseHigh;
   double   impulseLow;
   double   execHigh;
   double   execLow;
   datetime rangeTime;
   datetime impulseTime;
   datetime confirmTime;
};
SMC_ReconstructedVisualState g_reconState;

double SMC_ReconATR(const string symbol, const ENUM_TIMEFRAMES tf, const int period)
{
   int h = iATR(symbol, tf, period);
   if(h == INVALID_HANDLE) return 0.0;
   double b[];
   ArraySetAsSeries(b, true);
   double out = (CopyBuffer(h, 0, 1, 1, b) >= 1) ? b[0] : 0.0;
   IndicatorRelease(h);
   return out;
}

void SMC_ReconDrawRect(const string name, const datetime t1, const datetime t2,
                       const double low, const double high, const color c)
{
   ObjectDelete(0, name);
   if(!ReconDrawZones || !ShowChartGraphics || low <= 0.0 || high <= low) return;
   if(ObjectCreate(0, name, OBJ_RECTANGLE, 0, t1, low, t2, high))
   {
      ObjectSetInteger(0, name, OBJPROP_COLOR, c);
      ObjectSetInteger(0, name, OBJPROP_WIDTH, 1);
      ObjectSetInteger(0, name, OBJPROP_STYLE, STYLE_SOLID);
      ObjectSetInteger(0, name, OBJPROP_FILL, true);
      ObjectSetInteger(0, name, OBJPROP_BACK, true);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   }
}

void SMC_ReconUpdateVisualState()
{
   if(!UseReconstructedVisualStrategy) return;
   static datetime lastReconBar = 0;
   datetime reconBar = iTime(_Symbol, PERIOD_M1, 0);
   if(reconBar > 0 && reconBar == lastReconBar) return;
   lastReconBar = reconBar;
   ZeroMemory(g_reconState);
   ObjectDelete(0, "RECON_ANALYSIS_" + _Symbol);
   ObjectDelete(0, "RECON_IMPULSE_" + _Symbol);
   ObjectDelete(0, "RECON_EXEC_" + _Symbol);
   ObjectDelete(0, "RECON_ARROW_" + _Symbol);
   SMC_ReconstructedVisualState st;
   ZeroMemory(st);
   st.direction = 0;

   MqlRates h4[];
   ArraySetAsSeries(h4, true);
   if(CopyRates(_Symbol, PERIOD_H4, 1, 25, h4) < 20) return;
   double h4Avg = 0.0;
   for(int i = 0; i < 20; i++) h4Avg += h4[i].close;
   h4Avg /= 20.0;
   if(h4[0].close > h4[0].open && h4[0].close > h4Avg) st.bias = 1;
   else if(h4[0].close < h4[0].open && h4[0].close < h4Avg) st.bias = -1;
   else return;

   MqlRates m15[];
   ArraySetAsSeries(m15, true);
   int n15 = MathMax(6, ReconM15RangeBars);
   if(CopyRates(_Symbol, PERIOD_M15, 1, n15, m15) < n15) return;
   st.rangeHigh = m15[0].high;
   st.rangeLow = m15[0].low;
   for(int i = 1; i < n15; i++)
   {
      st.rangeHigh = MathMax(st.rangeHigh, m15[i].high);
      st.rangeLow = MathMin(st.rangeLow, m15[i].low);
   }
   st.rangeTime = m15[n15 - 1].time;
   st.analysisValid = (st.rangeHigh > st.rangeLow);

   MqlRates m5[];
   ArraySetAsSeries(m5, true);
   if(CopyRates(_Symbol, PERIOD_M5, 1, 3, m5) < 3) return;
   double atr5 = SMC_ReconATR(_Symbol, PERIOD_M5, 14);
   double body5 = MathAbs(m5[0].close - m5[0].open);
   if(atr5 <= 0.0 || body5 < atr5 * MathMax(0.50, ReconImpulseATR)) return;
   int impulseDir = (m5[0].close > m5[0].open) ? 1 : -1;
   if(impulseDir != st.bias) return;
   st.direction = impulseDir;
   st.impulseHigh = m5[0].high;
   st.impulseLow = m5[0].low;
   st.impulseTime = m5[0].time;
   st.impulseValid = true;

   double mid = (st.rangeHigh + st.rangeLow) * 0.5;
   // Beige analysis range; green execution half is deliberately on the
   // pullback side of the H4/M5 direction, not at the impulse extreme.
   if(st.direction > 0)
   {
      st.execLow = st.rangeLow;
      st.execHigh = mid;
   }
   else
   {
      st.execLow = mid;
      st.execHigh = st.rangeHigh;
   }

   MqlRates m1[];
   ArraySetAsSeries(m1, true);
   if(CopyRates(_Symbol, PERIOD_M1, 1, 3, m1) < 3) return;
   double atr1 = SMC_ReconATR(_Symbol, PERIOD_M1, 14);
   double current = (SymbolInfoDouble(_Symbol, SYMBOL_BID) + SymbolInfoDouble(_Symbol, SYMBOL_ASK)) * 0.5;
   bool m1Direction = (st.direction > 0) ? (m1[0].close > m1[0].open) : (m1[0].close < m1[0].open);
   bool inExec = (current >= st.execLow - atr1 * ReconConfirmATR &&
                  current <= st.execHigh + atr1 * ReconConfirmATR);
   bool rejected = (st.direction > 0) ? (m1[0].low <= st.execHigh && m1[0].close > m1[0].open)
                                      : (m1[0].high >= st.execLow && m1[0].close < m1[0].open);
   st.confirmed = m1Direction && inExec && rejected;
   if(st.confirmed) st.confirmTime = m1[0].time;

   g_reconState = st;
   datetime future15 = TimeCurrent() + PeriodSeconds(PERIOD_M15) * 8;
   datetime future5 = TimeCurrent() + PeriodSeconds(PERIOD_M5) * 12;
   SMC_ReconDrawRect("RECON_ANALYSIS_" + _Symbol, st.rangeTime, future15,
                     st.rangeLow, st.rangeHigh, C'210,180,160');
   SMC_ReconDrawRect("RECON_IMPULSE_" + _Symbol, st.impulseTime, future5,
                     st.impulseLow, st.impulseHigh, C'30,120,240');
   SMC_ReconDrawRect("RECON_EXEC_" + _Symbol, st.rangeTime, future15,
                     st.execLow, st.execHigh, C'40,170,55');

   string arrow = "RECON_ARROW_" + _Symbol;
   ObjectDelete(0, arrow);
   if(ReconDrawZones && ShowChartGraphics && st.confirmed)
   {
      double p = (st.direction > 0) ? iLow(_Symbol, PERIOD_M1, 1) : iHigh(_Symbol, PERIOD_M1, 1);
      if(ObjectCreate(0, arrow, OBJ_ARROW, 0, st.confirmTime, p))
      {
         ObjectSetInteger(0, arrow, OBJPROP_COLOR, st.direction > 0 ? clrLime : clrTomato);
         ObjectSetInteger(0, arrow, OBJPROP_ARROWCODE, st.direction > 0 ? 233 : 234);
         ObjectSetInteger(0, arrow, OBJPROP_WIDTH, 2);
         ObjectSetInteger(0, arrow, OBJPROP_SELECTABLE, false);
      }
   }
}

bool SMC_UnifiedFindTouchedLevel(const int dirSign, const double price,
                                 const double tolerance, double &levelOut,
                                 string &sourceOut)
{
   levelOut = 0.0;
   sourceOut = "";
   double bestDistance = DBL_MAX;
   // Prefer the live FVG trail state; chart objects are refreshed less often
   // than ticks and may be disabled in the lightweight display mode.
   double fvgBot = (dirSign > 0) ? g_fvgTrailBullBot : g_fvgTrailBearBot;
   double fvgTop = (dirSign > 0) ? g_fvgTrailBullTop : g_fvgTrailBearTop;
   if(fvgBot > 0.0 && fvgTop > 0.0)
   {
      double fvgCandidate = price;
      if(price < fvgBot) fvgCandidate = fvgBot;
      else if(price > fvgTop) fvgCandidate = fvgTop;
      double fvgDistance = MathAbs(price - fvgCandidate);
      if(fvgDistance <= tolerance)
      {
         bestDistance = fvgDistance;
         levelOut = fvgCandidate;
         sourceOut = "GOM_DISP_FVG";
      }
   }
   if(UseFVGDetection)
   {
      for(int fi = 0; fi < ArraySize(fvgDataArray); fi++)
      {
         if(fvgDataArray[fi].isMitigated) continue;
         if(fvgDataArray[fi].direction != dirSign) continue;
         double ictLow = MathMin(fvgDataArray[fi].bottom, fvgDataArray[fi].top);
         double ictHigh = MathMax(fvgDataArray[fi].bottom, fvgDataArray[fi].top);
         if(ictHigh <= 0.0) continue;
         double ictCandidate = price;
         if(price < ictLow) ictCandidate = ictLow;
         else if(price > ictHigh) ictCandidate = ictHigh;
         double ictDist = MathAbs(price - ictCandidate);
         if(ictDist > tolerance || ictDist >= bestDistance) continue;
         bestDistance = ictDist;
         levelOut = ictCandidate;
         sourceOut = (dirSign > 0) ? "ICT_FVG_BULL" : "ICT_FVG_BEAR";
      }
   }
   int total = ObjectsTotal(0, -1, -1);
   for(int i = total - 1; i >= 0; i--)
   {
      string name = ObjectName(0, i, -1, -1);
      if(StringLen(name) == 0) continue;
      string upper = name;
      StringToUpper(upper);

      bool isFVG   = (StringFind(upper, "GOM_DISP_FVG") >= 0 ||
                      StringFind(upper, "SMC_DISP_FVG") >= 0 ||
                      StringFind(upper, "FVG") >= 0);
      bool isGomTL = (StringFind(upper, "GOM_TF_TL") >= 0);
      bool isLSL   = (StringFind(upper, "SMCSP_LSL") >= 0 || StringFind(upper, "LSL") >= 0);
      bool isLSH   = (StringFind(upper, "SMCSP_LSH") >= 0 || StringFind(upper, "LSH") >= 0);
      bool isDowB  = (StringFind(upper, "DOW_BULLISH_LEVEL") >= 0 ||
                     StringFind(upper, "DOW_BULL") >= 0);
      bool isDowS  = (StringFind(upper, "DOW_BEARISH_LEVEL") >= 0 ||
                     StringFind(upper, "DOW_BEAR") >= 0);
      bool isPivotL = (StringFind(upper, "PIVOT_LOW") >= 0 ||
                      StringFind(upper, "PIVOT_LOW_LEVEL") >= 0);
      bool isPivotH = (StringFind(upper, "PIVOT_HIGH") >= 0 ||
                      StringFind(upper, "PIVOT_HIGH_LEVEL") >= 0);

      bool directionSpecific = (dirSign > 0 && (isLSL || isDowB || isPivotL)) ||
                               (dirSign < 0 && (isLSH || isDowS || isPivotH));
      if(!isFVG && !isGomTL && !directionSpecific) continue;
      if(dirSign > 0 && (isLSH || isDowS || isPivotH)) continue;
      if(dirSign < 0 && (isLSL || isDowB || isPivotL)) continue;

      double p0 = ObjectGetDouble(0, name, OBJPROP_PRICE, 0);
      double p1 = ObjectGetDouble(0, name, OBJPROP_PRICE, 1);
      if(p0 <= 0.0) continue;
      if(p1 <= 0.0) p1 = p0;
      double low = MathMin(p0, p1);
      double high = MathMax(p0, p1);
      double candidate = price;
      if(price < low) candidate = low;
      else if(price > high) candidate = high;
      double distance = MathAbs(price - candidate);
      if(distance > tolerance || distance >= bestDistance) continue;

      // Generic FVG objects must also be on the correct side of price;
      // a bearish FVG above price cannot authorize a BUY, and vice versa.
      if(isFVG && !directionSpecific)
      {
         if(dirSign > 0 && low > price + tolerance) continue;
         if(dirSign < 0 && high < price - tolerance) continue;
      }
      bestDistance = distance;
      levelOut = candidate;
      sourceOut = name;
   }
   return levelOut > 0.0;
}

void SMC_UnifiedGOMEntryOnTick()
{
   if(!UnifiedGOMEntryMode) return;
   if(BlockAllTrades) return;

   // v1.46: apres un spike capture, ne pas trader la correction (petites M1).
   // SMC_TrySecondSpikeCapture gere la re-entree au bon moment (pause 3-5 M1 puis expansion).
   if(CountPositionsForSymbol(_Symbol) == 0 && SMC_SpikeChainReentryWindow(0))
      return;

   // Diagnostic pÃ©riodique â€” pourquoi pas d'ordre
   static datetime s_diag = 0;
   bool doDiag = (TimeCurrent() - s_diag >= 10);
   if(doDiag) s_diag = TimeCurrent();

   // Diagnostic initial - Ã©tat EA
   static datetime s_initDiag = 0;
   bool initDiag = (TimeCurrent() - s_initDiag >= 60);
   if(initDiag) s_initDiag = TimeCurrent();
   if(initDiag) Print("[UNIFIED-INIT] EA actif | UnifiedGOMEntryMode=", UnifiedGOMEntryMode,
                    " BlockAllTrades=", BlockAllTrades, " symbol=", _Symbol);

   SMCGP_RestoreCachedIfDisconnected();
   if(g_smcGomVerdictNum == 0 && MathAbs(g_smcGomVerdictNumServer) >= 2)
      SMCGP_RestoreAlignedGoodIfWait(_Symbol);
   int spikeChainDir = IsBoomLikeSymbol(_Symbol) ? 1 : (IsCrashLikeSymbol(_Symbol) ? -1 : 0);
   bool spikeChainGoodException = (spikeChainDir != 0) &&
      SMC_SpikeChainGomEntryOverrideAllowed(_Symbol, spikeChainDir);
   int wantDir = (g_smcGomVerdictNum > 0) ? 1 : (g_smcGomVerdictNum < 0 ? -1 : 0);
   if(spikeChainGoodException) wantDir = spikeChainDir;
   bool chainLead = (wantDir == 0) && SMC_SpikeChainImminent(
      (IsCrashLikeSymbol(_Symbol) || StringFind(_Symbol, "Pain") >= 0) ? -1 : 1);
   if(chainLead)
   {
      wantDir = (IsCrashLikeSymbol(_Symbol) || StringFind(_Symbol, "Pain") >= 0) ? -1 : 1;
      g_secondSpikeInFlight = true;
   }
   if(g_smcGomVerdictNum == 0 && !spikeChainGoodException && !SMC_IsSyntheticAutonomousSym(_Symbol))
   {
      if(doDiag) Print("[UNIFIED] BLOQUÃ‰ - verdict WAIT | vn=", g_smcGomVerdictNum,
                       " srv=", g_smcGomVerdictNumServer, " chainLead=", chainLead);
      return;
   }
   if(!SMCGP_GomLinkOK() || g_smcGomVerdictNum == -999)
   {
      if(doDiag) Print("[UNIFIED] skip OFF | connected=", g_smcGomConnected,
                       " link=", SMCGP_GomLinkOK(), " vn=", g_smcGomVerdictNum);
      return;
   }
   bool isSynthAuto = SMC_IsSyntheticAutonomousSym(_Symbol);
   int minVnAbs = isSynthAuto ? 1 : MinGOMVerdictNumAbs;
   if(!chainLead && !spikeChainGoodException && MathAbs(g_smcGomVerdictNum) < minVnAbs)
   {
      if(doDiag) Print("[UNIFIED] skip SIMPLE | vn=", g_smcGomVerdictNum, " min=", minVnAbs, " synthAuto=", isSynthAuto);
      return;
   }

   // Zone recon : informatif seulement sauf si ReconRequireZoneForEntry=true
   if(UseReconstructedVisualStrategy && ReconRequireZoneForEntry && !chainLead)
   {
      int wanted = (g_smcGomVerdictNum > 0) ? 1 : -1;
      if(!g_reconState.analysisValid || !g_reconState.impulseValid ||
         g_reconState.direction != wanted || !g_reconState.confirmed)
      {
         if(doDiag) Print("[UNIFIED] skip recon zone | valid=", g_reconState.analysisValid,
                          " impulse=", g_reconState.impulseValid, " conf=", g_reconState.confirmed);
         return;
      }
   }

   if(!SMC_LowCapitalAllowsSymbol(_Symbol) || !SMC_SpreadAllowsEntry(_Symbol))
   {
      if(doDiag) Print("[UNIFIED] skip capital/spread | ", _Symbol);
      return;
   }
   // OPF / Trust : ne bloquent plus GOOD/PERFECT
   if(MathAbs(g_smcGomVerdictNum) < 2 && !chainLead)
   {
      if(UseOpportunityFilter && !SMC_OPF_IsMarketFavorable(_Symbol))
      {
         if(doDiag) Print("[UNIFIED] skip OPF | ", _Symbol);
         return;
      }
      if(UseGOMTrustSystem && !SMC_GOMTrust_IsSymbolAllowed(_Symbol))
      {
         if(doDiag) Print("[UNIFIED] skip TRUST | ", _Symbol);
         return;
      }
   }

   int dirSign = (wantDir != 0) ? wantDir : ((g_smcGomVerdictNum > 0) ? 1 : -1);
   const bool gomPerfect = (MathAbs(g_smcGomVerdictNum) >= 3);
   const bool gomExecutable = (MathAbs(g_smcGomVerdictNum) >= 2) || spikeChainGoodException;
   TradingSignal requiredSignal = (dirSign > 0) ? SIGNAL_BUY_ENTER : SIGNAL_SELL_ENTER;
   if(!gomExecutable && (g_gomCommittedSignal != requiredSignal || g_gomCommittedDir != dirSign))
   {
      if(doDiag) Print("[UNIFIED] attente ENTER GOM confirmÃ© | dir=",
                       (dirSign > 0 ? "BUY" : "SELL"),
                       " | signal=", (int)g_gomCommittedSignal,
                       " signalDir=", g_gomCommittedDir);
      return;
   }
   if(!gomExecutable && (!IsSignalConfirmed() || GetConfirmedSignalDir() != dirSign))
   {
      if(doDiag) Print("[UNIFIED] attente fin du clignotement de confirmation | dir=",
                       (dirSign > 0 ? "BUY" : "SELL"));
      return;
   }

   if(SMC_IsSpikeStyleSymbol(_Symbol) && MathAbs(g_smcGomVerdictNum) < 2
      && ChainPred_GetImminence() >= ChainPredWeakThresh
      && !SMC_SpikePredictConfirms(dirSign))
   {
      if(doDiag) Print("[UNIFIED] skip jauge spike contre | score=",
                       DoubleToString(ChainPred_GetImminence(), 1), " dir=", dirSign);
      return;
   }
   SMC_RefreshLocalTfDirsForDisplay();
   string m1Dir = (StringLen(g_smcTfM1DirLive) > 0) ? g_smcTfM1DirLive : g_smcTfM1Dir;
   string m5Dir = g_smcTfM5Dir;
   bool m5Ok = SMC_TfDirMatchesSign(dirSign, m5Dir);
   bool m1Ok = SMC_TfDirMatchesSign(dirSign, m1Dir);
   bool m1Neut = (m1Dir == "NEUT" || m1Dir == "" || m1Dir == "NONE");

   // FIX v1.28: dÃ©sactivation temporaire des checks TF pour dÃ©bogage
   // PERFECT : M5 OK OU M1 OK OU M1 NEUT suffit (micro-pullback tolÃ©rÃ©)
   // GOOD : M5 OK requis ; M1 OK ou NEUT
   if(false) // Temporairement dÃ©sactivÃ©
   {
      if(MathAbs(g_smcGomVerdictNum) >= 3)
      {
         if(!m5Ok && !m1Ok && !m1Neut)
         {
            if(doDiag) Print("[UNIFIED] PERFECT bloquÃ© TF | vn=", g_smcGomVerdictNum,
                             " M1=", m1Dir, " M5=", m5Dir);
            return;
         }
      }
      else if(!chainLead)
      {
         if(!m5Ok)
         {
            if(doDiag) Print("[UNIFIED] GOOD bloquÃ© M5 | vn=", g_smcGomVerdictNum,
                             " M1=", m1Dir, " M5=", m5Dir);
            return;
         }
         if(!m1Ok && !m1Neut)
         {
            if(doDiag) Print("[UNIFIED] GOOD bloquÃ© M1 | vn=", g_smcGomVerdictNum,
                             " M1=", m1Dir, " M5=", m5Dir);
            return;
         }
      }
   }

   static datetime lastEntry = 0;
   static string   lastEntrySym = "";
   if(TimeCurrent() - lastEntry < MathMax(5, UnifiedEntryCooldownSec) && lastEntrySym == _Symbol)
   {
      if(doDiag) Print("[UNIFIED] skip cooldown ", UnifiedEntryCooldownSec, "s | ", _Symbol);
      return;
   }

   double atr = SMC_EffectiveSymbolATR(_Symbol);
   if(atr <= 0.0)
   {
      // fallback ATR M1
      int h = iATR(_Symbol, PERIOD_M1, 14);
      if(h != INVALID_HANDLE)
      {
         double b[]; ArraySetAsSeries(b, true);
         if(CopyBuffer(h, 0, 0, 1, b) >= 1) atr = b[0];
         IndicatorRelease(h);
      }
   }
   if(atr <= 0.0)
   {
      if(doDiag) Print("[UNIFIED] skip ATR=0 | ", _Symbol);
      return;
   }
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if(bid <= 0.0 || ask <= bid) return;
   double price = (dirSign > 0) ? ask : bid;
   double level = 0.0;
   string source = "";

   bool forecastGo =
      g_smcForecast5mReady &&
      g_smcForecastHorizonMinutes == 5 &&
      g_smcGomVerdictForecastNum != 0 &&
      ((g_smcGomVerdictForecastNum > 0) == (dirSign > 0));
   bool forecastOppose = (g_smcForecast5mReady &&
                          g_smcForecastHorizonMinutes == 5 &&
                          MathAbs(g_smcGomVerdictForecastNum) >= 2 &&
                          ((g_smcGomVerdictForecastNum > 0) != (dirSign > 0)));
   bool autoMarketGom = (MathAbs(g_smcGomVerdictNum) >= 2 && !forecastOppose);

   bool hasLevel = SMC_UnifiedFindTouchedLevel(
      dirSign, price, atr * MathMax(0.05, UnifiedLevelTouchATR), level, source);
   if(!hasLevel && autoMarketGom)
   {
      hasLevel = true;
      level = price;
      source = forecastGo ? "FORECAST_5M" : "GOM_MARKET";
      if(doDiag) Print("[UNIFIED] GOOD/PERFECT marchÃ© ",
                       (dirSign > 0 ? "BUY" : "SELL"),
                       " â€” sans attendre FVG | vn=", g_smcGomVerdictNum,
                       " src=", source);
   }
   if(!hasLevel)
   {
      if(doDiag) Print("[UNIFIED] entrÃ©e diffÃ©rÃ©e â€” aucun niveau S/R ou FVG touchÃ© | vn=",
                       g_smcGomVerdictNum);
      return;
   }
   MqlRates entryM1[];
   ArraySetAsSeries(entryM1, true);
   if(CopyRates(_Symbol, PERIOD_M1, 0, 2, entryM1) < 2)
   {
      if(doDiag) Print("[UNIFIED] entrÃ©e diffÃ©rÃ©e â€” historique M1 indisponible | niveau=", source);
      return;
   }
   bool closedM1Confirms = (dirSign > 0)
                           ? (entryM1[1].close > entryM1[1].open)
                           : (entryM1[1].close < entryM1[1].open);
   bool liveM1Confirms = (dirSign > 0)
                         ? (entryM1[0].close > entryM1[0].open)
                         : (entryM1[0].close < entryM1[0].open);
   if(autoMarketGom)
   {
      ; // GOOD/PERFECT : le verdict GOM suffit, pas d'attente M1/FVG
   }
   else if(gomPerfect)
   {
      if(!closedM1Confirms && !liveM1Confirms)
      {
         if(doDiag) Print("[UNIFIED] PERFECT diffÃ©rÃ© â€” M1 ni clÃ´turÃ©e ni live dans le sens | niveau=", source);
         return;
      }
   }
   else if(!closedM1Confirms)
   {
      if(doDiag) Print("[UNIFIED] entrÃ©e diffÃ©rÃ©e â€” M1 clÃ´turÃ©e n'a pas confirmÃ© ",
                       (dirSign > 0 ? "BUY" : "SELL"), " | niveau=", source);
      return;
   }

   if(!CanPlaceMarketOrder(_Symbol, dirSign))
   {
      if(doDiag) Print("[UNIFIED] CanPlaceMarketOrder=false | vn=", g_smcGomVerdictNum, " dir=", dirSign);
      return;
   }
   ENUM_ORDER_TYPE orderType = (dirSign > 0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   if(!TryAcquireOpenLock())
   {
      if(doDiag) Print("[UNIFIED] entrÃ©e diffÃ©rÃ©e â€” verrou/capital/session bloque l'ouverture | ",
                       _Symbol, " vn=", g_smcGomVerdictNum);
      return;
   }

   double risk = MathMax(atr * 0.80, MathAbs(price - level) + atr * 0.20);
   double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   double tickVal  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double minLot   = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxUSD   = SMC_GetDynamicMaxLossUSD();
   if(tickSize <= 0.0) tickSize = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   if(minLot <= 0.0) minLot = 0.01;
   if(tickVal > 0.0 && tickSize > 0.0 && maxUSD > 0.0)
   {
      double maxDist = (maxUSD / minLot) * (tickSize / tickVal);
      if(maxDist > 0.0 && risk > maxDist)
         risk = maxDist;
   }
   double rr = MathMax(2.0, MinRewardRiskRatio);
   double sl = (dirSign > 0) ? price - risk : price + risk;
   double tp = (dirSign > 0) ? price + risk * rr : price - risk * rr;
   int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   sl = NormalizeDouble(sl, digits);
   tp = NormalizeDouble(tp, digits);
   double lot = CalculateLotSize(_Symbol, price, sl);
   if(lot <= 0.0)
   {
      lot = minLot;
      Print("[UNIFIED] lot forcÃ© au min ", DoubleToString(lot, 2),
            " | cap $", DoubleToString(maxUSD, 2), " | ", _Symbol);
   }

   bool ok = (dirSign > 0)
             ? SafeTradeBuy(lot, _Symbol, ask, sl, tp, "UNIFIED-GOM BUY " + source)
             : SafeTradeSell(lot, _Symbol, bid, sl, tp, "UNIFIED-GOM SELL " + source);
   if(ok)
   {
      lastEntry = TimeCurrent();
      lastEntrySym = _Symbol;
      RegisterOrderPlaced();
      SMC_GateRegisterOpened(_Symbol, dirSign > 0);
      Print("[UNIFIED-GOM] ", (dirSign > 0 ? "BUY" : "SELL"), " exÃ©cutÃ© | GOM=",
            g_smcGomVerdict, " vn=", g_smcGomVerdictNum, " M1=", m1Dir,
            " M5=", g_smcTfM5Dir, " level=", source, " @", DoubleToString(level, digits));
   }
   ReleaseOpenLock();
}

void OnTick()
{
   // ICT Improved: scan FVG/structure â€” moved after rate-limiting for performance
   // SL/TP functions are handled above for safety; ICT functions are non-critical
   ICT_UpdateMarketStructure();
   ICT_ScanForFVGs();
   ICT_UpdateFVGStatus(SymbolInfoDouble(_Symbol, SYMBOL_BID));

   // FIX 2026-09-20 (Performance) : OpÃ©rations CRITIQUES uniquement avant rate-limiting
   // SÃ‰CURITÃ‰ PRIORITAIRE : aucune stratÃ©gie ni BlockAllTrades ne doit
   // empÃªcher la fermeture d'une position ayant dÃ©passÃ© la perte maximale.
   SMC_SyncServerSLToDynamicLimit(); // FIX v1.44: SL broker aligne sur limite $ (avant tout)
   if(SMC_EnforceHardLossCutoff()) return;
   SMC_ManageDynamicDollarSL(); // FIX v1.35: trailing $ AVANT rate-limit (chaque tick)
   SMC_EnforceNoHedgeAllSymbols(); // FIX v1.37: 1 pos/symbole CHAQUE tick

   // FIX 2026-09-20 (Performance) : Rate-limiting AVANT les opÃ©rations non-critiques
   // Cela rÃ©duit de 60-80% les opÃ©rations sur symboles volatils
   static datetime lastProcess = 0;
   static datetime lastGraphicsUpdate = 0;
   static datetime lastAIUpdate = 0;
   static datetime lastDashboardUpdate = 0;
   // Track GOM verdict and gate changes for future zone redraw
   static int s_lastGomVerdictNum = 0;
   static bool s_lastGomGateOk = false;
   datetime currentTime = TimeCurrent();

   // Traitement contrÃ´lÃ© pour stabilitÃ© (max ~1 tick toutes les 0.5 seconde)
   if(currentTime - lastProcess < 0.5) return;
   lastProcess = currentTime;
   SMCGP_RestoreCachedIfDisconnected();
   SMC_RefreshLocalTfDirsForDisplay();
   if(UseDashboard || UseUnifiedDashboard)
      SMC_DrawTFTrendPanel();

   // FIX 2026-09-20 (Performance) : OpÃ©rations NON-CRITIQUES aprÃ¨s rate-limiting
   // Mettre Ã  jour le cache de performance (rÃ©duit les appels CopyBuffer)
   SMC_PC_UpdateCache(_Symbol);

   // Learning Journal tick update (MAE/MFE + phantom trades)
   LJ_OnTick();

   // FIX 2026-09-20 (Opportunity Filter) : Mettre Ã  jour le filtre d'opportunitÃ©
   // Bloque les entrÃ©es pendant moments dÃ©favorables
   SMC_OPF_Update(_Symbol);

   // Mise Ã  jour dÃ©tection consolidation (toutes les 30 secondes)
   if(UseConsolidationFilter || UseWhipsawFilter)
      UpdateConsolidationDetection(_Symbol);
   if(MR_Enable)
      MR_Update(_Symbol, PERIOD_M1);

   // Advanced Range Detection (EA Gold Stuff fix pattern)
   SMC_Range_Update(_Symbol, PERIOD_CURRENT);

   // Advanced Risk Manager (SpikeRider EA pattern) - update daily stats
   SMC_Risk_Update();

   // Auto break-even management (SpikeRider EA pattern)
   SMC_Risk_UpdateBreakEven();

   // Missed Spike Reentry - update state
   SMC_MSR_Update(_Symbol);

   // FIX 2026-09-20: DOW Touch Entry - update state
   SMC_DTE_Update(_Symbol);

   // Swing M15 Strategy - dÃ©sactivÃ© (demande utilisateur)
   // if(SWING_Enable)
   //    SWING_OnTick(_Symbol);

   // FIX 2026-09-26 (demande Kola) : fallback local prÃ©cis si ai_server.py
   // est injoignable â€” ne se dÃ©clenche que quand g_smcGomConnected == false.
   if(UseLocalFallbackNoGOM && !g_smcGomConnected)
      SMC_LocalFallback_TryEntry(_Symbol);
   else if(UseLocalFallbackOnWait && g_smcGomConnected &&
           (g_smcGomVerdictNum == 0 || g_smcGomVerdictNum == -999))
      SMC_LocalFallback_TryEntry(_Symbol);
   else if(UseLocalFallbackOnDegrade && g_smcGomConnected &&
           SMCGP_IsGoodPerfect(g_lastGomVerdictNum) &&
           (g_smcGomVerdictNum == 0 || g_smcGomVerdictNum == -999))
   {
      // Verdict a dÃ©gradÃ© de GOOD/PERFECT â†’ WAIT
      Print("âš ï¸ GOM DÃ‰GRADATION dÃ©tectÃ©e: vn passÃ©=", g_lastGomVerdictNum, " â†’ actuel=", g_smcGomVerdictNum, " â€” fallback local activÃ©");
      SMC_LocalFallback_TryEntry(_Symbol);
   }

   // Mettre Ã  jour le verdict prÃ©cÃ©dent pour prochaine itÃ©ration
   // Reset si GOM vient de se reconnecter (Ã©vite faux positif sur ancien verdict)
   static bool s_wasGomConnected = false;
   if(g_smcGomConnected && !s_wasGomConnected)
   {
      g_lastGomVerdictNum = 0; // Reset sur reconnexion
      Print("[GOM] Reconnexion dÃ©tectÃ©e â€” g_lastGomVerdictNum remis Ã  0");
   }
   s_wasGomConnected = g_smcGomConnected;
   
   if(g_smcGomConnected)
      g_lastGomVerdictNum = g_smcGomVerdictNum;

   if(UsePurePriceActionMode)
      SMC_ManagePurePAPendingLimits(_Symbol);

   // FIX 2026-09-14: PurePA uniquement si GOM connectÃ© et non-WAIT.
   if(UsePurePriceActionMode && !UnifiedGOMEntryMode)
   {
      if(g_smcGomConnected && g_smcGomVerdictNum != 0 && g_smcGomVerdictNum != -999)
         PurePA_OnTick(_Symbol);
      else
      {
         PurePA_UpdateDrawings(_Symbol);
         PurePA_ManageOpenPositions(_Symbol);
      }
   }
   // FIX 2026-09-05: fait vivre le moteur BC (compteurs post-spike, zones,
   // compression, acceleration) - condition requise avant d'utiliser
   // SMC_BC_GenerateSetup() dans SMC_MarketEntryTripleGateOK().
   if(SMC_IsSpikeStyleSymbol(_Symbol))
      SMC_BC_Update(_Symbol);
   SH_OnTick();
   SMC_EnforceDirectionRuleHard(_Symbol);   // 1) tue tout contre-tendance Ã  la rÃ¨gle STRUCTURELLE de famille
   SMC_EnforceDowLiveVerdictGuard(_Symbol); // 1b) tue tout DOW contraire au verdict GOM LIVE (indÃ©pendant de la famille)
   SMC_EnforceNoHedgeState(_Symbol);        // 2) tue tout BUY+SELL simultanÃ© restant
   // Track signal transitions for blink confirmation gate
   // Passer le verdict GOM : WAIT (vn=0) coupe immÃ©diatement le blink BUY/SELL
   UpdateSignalAppearTime(g_lastAIAction, g_smcGomConnected ? g_smcGomVerdictNum : 0);

   // Gate global: bloquer toutes les nouvelles entrÃ©es si terminal plein
   g_terminalFull = IsTerminalFull();

   // Tick Frequency Tracker (runs on EVERY tick, before rate-limiting)
   datetime tNow = TimeCurrent();
   if(tNow == g_tickFreqLastSec)
   {
      g_tickFreqCurrent++;
   }
   else
   {
      // Stocker le compte de la seconde prÃ©cÃ©dente
      if(g_tickFreqLastSec > 0)
      {
         g_tickFreqBuf[g_tickFreqIdx] = g_tickFreqCurrent;
         g_tickFreqIdx = (g_tickFreqIdx + 1) % 60;
      }
      g_tickFreqCurrent = 1;
      g_tickFreqLastSec = tNow;
      // Calculer moyenne sur 60s
      double sum = 0; int cnt = 0;
      for(int i = 0; i < 60; i++) { if(g_tickFreqBuf[i] > 0) { sum += g_tickFreqBuf[i]; cnt++; } }
      g_tickFreqAvg = (cnt > 5) ? sum / cnt : 0.0;
      g_tickFreqRatio = (g_tickFreqAvg > 0) ? g_tickFreqCurrent / g_tickFreqAvg : 1.0;
   }
   
    // Mise Ã  jour de la machine Ã  Ã©tats Spike Chain (Boom/Crash/Painx/Gainx uniquement)
    SMC_UpdateSpikeChainState();
    SMC_TrySecondSpikeCapture(); // v1.46: actif aussi en mode unifie (re-entree chaine de spikes)
    // SL d'abord (verrouiller 70% du pic), giveback marchÃ© ensuite si le SL n'a pas tenu
    SMC_ProtectCapturedSpikeSL();
    SMC_EnforceNoHedgeAllSymbols(); // jamais BUY+SELL mÃªme symbole / cap global
    SMC_ManageFirstSpikeGiveBackGuard();
    // Remplace l'ancienne garde gÃ©nÃ©rale (fermeture sÃ¨che Ã  30%, sans ajustement
    // de SL entre-temps) par la garde dynamique v2 : verrouillage progressif du SL
    // dÃ¨s qu'on approche du seuil, seuil diffÃ©renciÃ© GOOD/PERFECT (30%) vs SIMPLE
    // (45%), sortie forcÃ©e Ã  50% en filet de sÃ©curitÃ©. Voir modules/SMC_DynamicGiveBack.mqh.
    SMC_ManageDynamicGiveBack();
    SMC_ManageStagnationTimeExit(); // Stagnation gain + filet de securite par temps de detention
    SCH1_UpdateChainTracking(); // Chaine de Spikes H1/M5 (Kola)
    SCH1_ManageOpenPositions();
    SCH1_UpdatePanel();

      // Chain Predictor + Cross Correlation â€” panneau fusionnÃ© centrÃ©
      CrossCorr_ScanPartner(_Symbol);
      SMC_ChainPred_RegisterRecentSpike();
      if(UseChainPredictor) ChainPred_Evaluate();
      if(!UseUnifiedDashboard) ChainCorr_DrawMergedPanel(g_sch1PanelText); // sinon voir ligne "Corr:" du panneau unique

     // Pure PA exclusif UNIQUEMENT si PurePA_ExclusiveEntries=true.
     // Par dÃ©faut : GOM pipeline + DOW line/EP + FVG DISP restent actifs.
     const bool purePAExclusive = SMC_IsPurePAExclusive();
     if(purePAExclusive)
     {
        static datetime s_ppaExclLog = 0;
        if(TimeCurrent() - s_ppaExclLog >= 120)
        {
           s_ppaExclLog = TimeCurrent();
           Print("ðŸ”’ [PURE-PA EXCLUSIF] Autres modules d'entrÃ©e COUPÃ‰S â€” seule PurePA peut ouvrir | ",
                 _Symbol, " | GOM vn=", g_smcGomVerdictNum);
        }
     }

     // PRIORITÃ‰ 1â€“2c : entrÃ©es privilÃ©giÃ©es UNIQUEMENT si GOM GOOD/PERFECT
     // FIX 2026-09-14: avant, vn!=0 laissait passer SIMPLE â†’ trades de correction.
     // FIX v1.21: entiÃ¨rement sautÃ© si PurePA exclusif.
     const bool gomAllowsPriority =
        !UnifiedGOMEntryMode && !purePAExclusive && g_smcGomConnected && SMCGP_IsGoodPerfect(g_smcGomVerdictNum);

      // DOW scan/draw + 1er rebond mÃªme si GOM=WAIT (le verdict lag derriÃ¨re le prix)
      // v1.37: la ligne DOW est TOUJOURS dessinÃ©e. En mode unifiÃ©, on appelle en
      //        "affichage seul" (displayOnly=true) : visuel OK, trading DOW OFF.
      if(!purePAExclusive)
      {
         DowTrendline_OnTick(UnifiedGOMEntryMode);
         if(!UnifiedGOMEntryMode) SMCSP_OnTick();
      }

     if(gomAllowsPriority)
     {
        // PRIORITÃ‰ 1: GOM_TF_TL_M1 touch â†’ MARKET (dans le tracker) â€” exige GOOD/PERFECT
        SMC_TrackReactionLevelsOnTick();

        // PRIORITÃ‰ 2b: MARKET au touch du rectangle DOW EP
        SMC_TryDowEpRectMarketEntry();

        // FIX v1.16: CONTRE-TENDANCE INTERDITE (demande Sidoine)
        // SMC_TryChartistCounterTrendEntry(); // DÃ‰SACTIVÃ‰ â€” plus d'ordres contre tendance

        // â”€â”€ GOM Immediate Market + Retrace State Machine â”€â”€
        SMC_GOM_ImmediateOnTick();

        // FVG ICT boxes : retest / IFVG, GOM GOOD/PERFECT
        SMC_FVGBox_OnTick(_Symbol);

        // v1.34: MARKET si GOOD/PERFECT + M5 + touch niveau (ENTER BUY/SELL)
        TryExecuteGOMPerfectEntry();

        // Recovery spike M5 (GOOD/PERFECT only)
        SMC_TryM5RecoverySpikeEntry();

        // AprÃ¨s 2 pertes: FVG react OU (cassure â†’ spike GOM_TF_TL_M5 uniquement)
        SMC_ManageDoubleLossFVGTrailEntry();
        SMC_TryLossRecoverNativeEntry();
     }

     // PRIORITÃ‰ 2c: EntrÃ©e AGGRESSIVE â€” dÃ©sactivÃ©e par le dÃ©clencheur unifiÃ©
     if(!UnifiedGOMEntryMode && !purePAExclusive)
        SMC_TryAggressiveDowGomEntry();

     // FIX v1.16: SIMPLE dÃ©sactivÃ© â€” uniquement GOOD/PERFECT (|vn|>=2)
     // if(g_smcGomConnected && MathAbs(g_smcGomVerdictNum) == 1)
     //    SMC_TryPatientSimpleEntry();

     // â”€â”€ OTE Strategy (secondaire / confluence) â”€â”€
     if(UseOTEStrategy)
     {
        SMC_CalculateLocalOTE();
        SMC_ManageOTEPositions();
     }

     // â”€â”€ Dynamic Dollar SL : max perte 3$ + lock gains dÃ¨s 0.50$ â”€â”€
     SMC_ManageDynamicDollarSL();

     // NOTE: Dow_PurgeNonDowLimitOrders() retirÃ© du OnTick â€” trop agressif (supprimait
     // les LIMIT non-DOW Ã  chaque tick). L'enforcement Ã  30s gÃ¨re la discipline LIMIT.

     // DOW Scanner â€” scan multi-symbole + execution adaptive (OFF si PurePA exclusif)
     if(UseDowScanner && !UnifiedGOMEntryMode && !purePAExclusive)
     {
        static datetime lastScan = 0;
        if(currentTime - lastScan >= ScannerIntervalSec)
        {
           lastScan = currentTime;

           // Scanner les symboles
           DOWSCAN_ScanAllSymbols();

           // Executer les meilleures opportunites
           TMScannerOpportunity opportunities[];
           int oppCount = DOWSCAN_GetTopN(ScannerTopN, opportunities);

           for(int opp = 0; opp < oppCount; opp++)
           {
              if(!ADAPTIVE_CanExecute(opportunities[opp])) continue;

              // Choisir LIMIT ou MARKET selon le mode
              bool executed = false;
              if(opportunities[opp].limitReady)
                 executed = ADAPTIVE_ExecuteLimit(opportunities[opp]);
              else if(opportunities[opp].marketReady)
                 executed = ADAPTIVE_ExecuteMarket(opportunities[opp]);

               if(executed)
                  Print(StringFormat("[DOW-SCANNER] Trade registered: %s %s score=%.1f",
                                    (opportunities[opp].direction > 0 ? "BUY" : "SELL"),
                                    opportunities[opp].symbol, opportunities[opp].score));
           }

           // Nettoyer les trades inactifs
           ADAPTIVE_Cleanup();
        }

        // Gerer les pending LIMIT orders
        ADAPTIVE_ManagePendingOrders();

        // ATR Trailing Stop
        if(ScannerUseATRTrail)
        {
           ATRTRAIL_ManageAll();
           ATRTRAIL_Cleanup();
        }
     }

     // â”€â”€ GATE GOM WAIT / DÃ‰CONNECTÃ‰: rejeter TOUTES les entrÃ©es â”€â”€
    // MÃªme logique que connexion internet indisponible: aucun trade tant que GOM n'a pas un verdict actif
    bool gomBlocked = false;
    // FIX v1.16: capital bas â†’ bloquer entrÃ©es sur PainX/GainX
    SMCGP_RestoreCachedIfDisconnected();
    if(!SMC_LowCapitalAllowsSymbol(_Symbol))
       gomBlocked = true;
    // Allow local fallback to bypass GOM link check
    bool fallbackActive = g_localFallbackOverrideActive;
    if(!fallbackActive && !SMCGP_GomLinkOK())
    {
       gomBlocked = true;
       static datetime s_lastGomBlockLog = 0;
       if(currentTime - s_lastGomBlockLog >= 30)
       {
          Print("âŒ ORDRE REJETÃ‰ â€” Connexion GOM indisponible â€” Toutes entrÃ©es bloquÃ©es");
          Print("   â†’ VÃ©rifier ai_server sur ", AI_ServerURL, " (UseAIServer=", UseAIServer, ")");
          Print("   â†’ Onglet Experts: chercher erreurs WebRequest / 401 / timeout");
          s_lastGomBlockLog = currentTime;
       }
    }
    // FIX 2026-09-20 (Opportunity Filter) : VÃ©rifier si le marchÃ© est favorable
    else if(UseOpportunityFilter && !SMC_OPF_IsMarketFavorable(_Symbol))
    {
       gomBlocked = true;
       static datetime s_lastOpfBlockLog = 0;
       if(currentTime - s_lastOpfBlockLog >= 30)
       {
          Print("âŒ ORDRE REJETÃ‰ â€” Filtre d'opportunitÃ© â€” Conditions dÃ©favorables");
          Print("   â†’ Raison: ", SMC_OPF_GetRejectionReason());
          Print("   â†’ Ã‰tat: ", SMC_OPF_GetState());
          s_lastOpfBlockLog = currentTime;
       }
    }
    // FIX 2026-09-20 (GOM Trust) : VÃ©rifier si le symbole est autorisÃ© (confiance GOM suffisante)
    else if(UseGOMTrustSystem && !SMC_GOMTrust_IsSymbolAllowed(_Symbol))
    {
       gomBlocked = true;
       static datetime s_lastGomTrustBlockLog = 0;
       if(currentTime - s_lastGomTrustBlockLog >= 30)
       {
          Print("âŒ ORDRE REJETÃ‰ â€” SystÃ¨me de confiance GOM â€” Symbole bloquÃ©");
          Print("   â†’ Score de confiance: ", DoubleToString(SMC_GOMTrust_GetTrustScore(_Symbol), 2));
          Print("   â†’ Statistiques: ", SMC_GOMTrust_GetSymbolStats(_Symbol));
          s_lastGomTrustBlockLog = currentTime;
       }
    }
else if(g_smcGomVerdictNum == 0)
    {
       // Allow local fallback on WAIT to bypass
       if(fallbackActive && UseLocalFallbackOnWait)
       {
          // fallback will handle entry
       }
       else
       {
          gomBlocked = true;
          static datetime s_lastWaitBlockLog = 0;
          if(currentTime - s_lastWaitBlockLog >= 30)
          {
             Print("âŒ ORDRE REJETÃ‰ â€” GOM verdict = WAIT (vn=0) â€” Toutes entrÃ©es bloquÃ©es");
             Print("   â†’ ", _Symbol, " | connected=OK | verdict=WAIT â€” attendre GOOD/PERFECT");
             s_lastWaitBlockLog = currentTime;
          }
       }
    }
else if(MathAbs(g_smcGomVerdictNum) < 2)
    {
       // FIX v1.16: SIMPLE aussi bloquÃ© partout (plus d'exception spike)
       // Allow fallback to bypass SIMPLE block
       if(fallbackActive)
       {
          // fallback will handle entry
       }
       else
       {
          gomBlocked = true;
          static datetime s_lastSimpleBlockLog = 0;
          if(TimeCurrent() - s_lastSimpleBlockLog >= 30)
          {
             Print("âŒ ORDRE REJETÃ‰ â€” GOM vn=", g_smcGomVerdictNum,
                  " (SIMPLE/faible) â€” exige GOOD/PERFECT |vn|>=2 â€” Toutes entrÃ©es bloquÃ©es");
             s_lastSimpleBlockLog = TimeCurrent();
          }
       }
    }
    else
    {
       // GOM NOT blocked - log for debugging
       static datetime s_lastGomOkLog = 0;
       if(TimeCurrent() - s_lastGomOkLog >= 60)
       {
          Print("[BLOCK-DEBUG] GOM OK | connected=", g_smcGomConnected, 
                " vn=", g_smcGomVerdictNum, " verdict=", g_smcGomVerdict,
                " MinGOM=", MinGOMVerdictNumAbs,
                " SpikeTradable=", SMCGP_IsSpikeTradableSym(_Symbol));
          s_lastGomOkLog = TimeCurrent();
       }
    }

     // â”€â”€ ANNULER pending si GOM=WAIT soutenu â€” min 3-5 min (discipline LIMIT)
    if(gomBlocked)
    {
       const bool waitSustained = SMC_GomWaitSustained(45) || !g_smcGomConnected;
       if(waitSustained)
       {
          for(int i = OrdersTotal() - 1; i >= 0; i--)
          {
             ulong tk = OrderGetTicket(i);
             if(tk == 0) continue;
             if(OrderGetString(ORDER_SYMBOL) != _Symbol) continue;
             if(OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;
             string cm = OrderGetString(ORDER_COMMENT);
             if(StringFind(cm, "DOW") >= 0) continue;
             if(StringFind(cm, "AUTOSCALP") >= 0 ||
                StringFind(cm, "PIPELINE") >= 0 || StringFind(cm, "SR20") >= 0 ||
                StringFind(cm, "SMC") >= 0 || StringFind(cm, "IMPULSE") >= 0 ||
                StringFind(cm, "RETURN") >= 0 || StringFind(cm, "POSTHOLD") >= 0 ||
                StringFind(cm, "GOM_") >= 0 || StringFind(cm, "PIVOT_") >= 0)
             {
                LimitSafeOrderDelete(tk, false,
                     "GOM=" + (!g_smcGomConnected ? "dÃ©connectÃ©" : "WAIT soutenu") + " | " + cm);
             }
          }
       }
    }

    // â”€â”€ TF GATE: Bloquer entrÃ©e si TFs supÃ©rieurs contredisent le verdict GOM â”€â”€
    bool tfBlocked = false;
    bool tfReduced = false;
    if(!gomBlocked && UseTFGate && g_smcGomVerdictNum != 0)
    {
       int gomDirSign = (g_smcGomVerdictNum > 0) ? 1 : -1;
       if(!TFGate_AllowEntry(gomDirSign, tfReduced))
       {
          tfBlocked = true;
          static datetime s_lastTfBlockLog = 0;
          if(currentTime - s_lastTfBlockLog >= 30)
          {
             Print("ðŸš« ORDRE REJETÃ‰ â€” TF Gate BLOCKED | verdict=", g_smcGomVerdict,
                   " score=", g_tfGateState.score,
                   " D1=", g_smcTfD1Dir, " H4=", g_smcTfH4Dir,
                   " H1=", g_smcTfH1Dir);
             s_lastTfBlockLog = currentTime;
          }
       }
    }
    else
    {
       // TF Gate not active or not blocking - log for debugging
       static datetime s_lastTfOkLog = 0;
       if(TimeCurrent() - s_lastTfOkLog >= 60)
       {
          Print("[BLOCK-DEBUG] TF Gate OK | UseTFGate=", UseTFGate, 
                " gomBlocked=", gomBlocked, " vn=", g_smcGomVerdictNum,
                " M1=", g_smcTfM1Dir, " M5=", g_smcTfM5Dir, 
                " M15=", g_smcTfM15Dir, " H1=", g_smcTfH1Dir);
          s_lastTfOkLog = TimeCurrent();
       }
     }
     
     // â”€â”€ DOW EXCLUSIVE MODE: si DOW actif, AUCUNE autre stratÃ©gie ne place d'ordre â”€â”€
     bool dowExclusiveMode = (UseDowTrendline && g_dowState.active);
     
     // Debug log for DOW exclusive mode
     static datetime s_lastDowLog = 0;
     if(TimeCurrent() - s_lastDowLog >= 60)
     {
        Print("[BLOCK-DEBUG] DOW Mode | UseDowTrendline=", UseDowTrendline,
              " g_dowState.active=", g_dowState.active,
              " dowExclusiveMode=", dowExclusiveMode);
        s_lastDowLog = TimeCurrent();
     }
     
     if(!UnifiedGOMEntryMode && !dowExclusiveMode)
     {
     // SETUP 1 - Scalping autonome synthÃ©tiques (fusion 30 ans + boucle, SL dur 3$)
     SMCASC_OnTickGuard();
     if(!SMC_IsPurePAExclusive() && !gomBlocked && !tfBlocked && SMCASC_Enable && SMC_IsSpikeStyleSymbol(_Symbol))
     {
        int ascDir = IsBoomLikeSymbol(_Symbol) ? 1 : (IsCrashLikeSymbol(_Symbol) ? -1 : 0);
        if(ascDir != 0) SMCASC_TryScalpSynthetic(_Symbol, ascDir);
     }
     
     // SETUP 1B - Scalp Dow: GOM PERFECT + Cognition â†’ entrer creux/sommet prÃ©dit
     if(!SMC_IsPurePAExclusive() && !gomBlocked && !tfBlocked && SMCASC_DowScalpEnable && SMC_IsSpikeStyleSymbol(_Symbol))
     {
        int dowDir = IsBoomLikeSymbol(_Symbol) ? 1 : (IsCrashLikeSymbol(_Symbol) ? -1 : 0);
        if(dowDir != 0) SMCASC_TryDowScalp(_Symbol, dowDir);
     }
     
     // SETUP 1C - Dow M5 + SR20 + Patterns: Dow M5 confirme â†’ prix au SR20 + pattern M1
      if(!SMC_IsPurePAExclusive() && !gomBlocked && !tfBlocked && SMCASC_DowSR20Enable && SMC_IsSpikeStyleSymbol(_Symbol))
      {
         int sr20Dir = IsBoomLikeSymbol(_Symbol) ? 1 : (IsCrashLikeSymbol(_Symbol) ? -1 : 0);
         if(sr20Dir != 0) SMCASC_TryDowSR20Scalp(_Symbol, sr20Dir);
      }
     
      // SETUP 1D - Vol Momentum + Fib Retrace: momentum chain â†’ Fib entry (Weltrade Volatility)
      if(!SMC_IsPurePAExclusive() && !gomBlocked && !tfBlocked && SMCASC_VolMomEnable && SMC_GetSymbolCategory(_Symbol) == SYM_VOLATILITY)
      {
         SMCASC_TryVolMomentumScalp(_Symbol);
      }
     
     // SETUP 2 - Chasse aux stops Forex/Crypto/Gold (SL dur 3$)
     SMCFX_OnTickGuard();
     if(!SMC_IsPurePAExclusive() && !gomBlocked && !tfBlocked && SMCFX_Enable && !SMC_IsSpikeStyleSymbol(_Symbol) && SMC_GetSymbolCategory(_Symbol) != SYM_VOLATILITY)
     {
        SMCFX_TryScalpSweep(_Symbol);
     }
     
     // SETUP 3 - Cassure de range extrÃªme Gold/Crypto (SL dur 3$)
     SMCR_OnTickGuard();
     if(!SMC_IsPurePAExclusive() && !gomBlocked && !tfBlocked && SMCR_Enable && !SMC_IsSpikeStyleSymbol(_Symbol) && SMC_GetSymbolCategory(_Symbol) != SYM_VOLATILITY)
     {
        SMCR_TryScalpRange(_Symbol);
     }
      } // fin !dowExclusiveMode

// ENTRÃ‰E DIRECTE MARKET Boom/Crash â€” COUPÃ‰E si PurePA exclusif (v1.21 Option A)
      if(!UnifiedGOMEntryMode && !SMC_IsPurePAExclusive() && !gomBlocked)
         ExecuteBoomCrashSpikeMarketOrder();

     // Garde-fou retracement multi-TF: met Ã  jour les zones / dÃ©tection dÃ©but/fin
    if(SMCGR_Enable)
    {
       SMCGR_Update(_Symbol);
       SMCGR_DrawRetracementZones(_Symbol);
       // Fermer TOUTES les positions (EA + manuelles) si prix en zone retracement
       SMCGR_ClosePositionsInRetrace(_Symbol, InpMagicNumber);
    }
    // Si le prix est en zone de retracement, NE RIEN EXÃ‰CUTER (bloque tout)
    g_inRetrace = SMCGR_IsInRetracement(_Symbol);
    
    // Debug log for correction cycle and retracement status
    static datetime s_lastCorrLog = 0;
    if(TimeCurrent() - s_lastCorrLog >= 60)
    {
       Print("[BLOCK-DEBUG] Correction/Retrace | inRetrace=", g_inRetrace,
             " corrPhase=", g_smcCorrPhase,
             " corrExhaust=", g_smcCorrExhaustPct, "%",
             " corrEntrySafe=", g_smcCorrEntrySafe,
             " m1EntryBlocked=", g_smcM1EntryBlocked);
       s_lastCorrLog = TimeCurrent();
    }
    
   // BLOCAGE TOTAL DES TRADES - Mode observation seul
   if(BlockAllTrades)
   {
      static datetime lastBlockLog = 0;
      if(currentTime - lastBlockLog >= 30) // Log toutes les 30 secondes
      {
         Print("ðŸ”’ MODE BLOCAGE ACTIVÃ‰ - Aucune entrÃ©e/sortie autorisÃ©e - Observation seule");
         lastBlockLog = currentTime;
      }
      
      // Garder seulement les graphiques et IA pour observation
      if(!UltraLightMode)
      {
         // MISE Ã€ JOUR IA pour observation
         if(UseAIServer && currentTime - lastAIUpdate >= AI_UpdateInterval_Seconds)
         {
            lastAIUpdate = currentTime;
            UpdateAIDecision(AI_Timeout_ms);
         }
         
         // GRAPHIQUES pour observation
         if(ShowChartGraphics && currentTime - lastGraphicsUpdate >= 30)
         {
            lastGraphicsUpdate = currentTime;
            if(ShowSignalArrow) { DrawSignalArrow(); UpdateSignalArrowBlink(); }
         }

         // GOM dashboard en mode observation (BlockAllTrades)
         if(ShowGOMDashboard || UseGOMVerdictFilter || UseGOMPipeline)
         {
            SMCGP_PollGOM();
            if(ShowGOMDashboard)
               SMCGP_DrawGOMDashboard();
         }
         
// TABLEAU DE BORD pour observation (15 s pour mise Ã  jour plus rÃ©active)
          if(currentTime - lastDashboardUpdate >= 15)
          {
             lastDashboardUpdate = currentTime;
             UpdateDashboard();
             // GOM Scanner dashboard live update
             if(UseGomScanner && g_gomScannerInitialized)
                GOMSCAN_DrawChartDashboard();
          }
      }
return; // Sortir immÃ©diatement - aucun trading
    }
    
    // âœ… AUTO TRADING LOOP â€” Placement + Trailing Stop + Profit targets
   // AutoTradingTick();  // TODO: Fix MQL5 compatibility

   if(UseDailyCapitalManager)
      CM_RefreshDailyStats();

   // âœ… POLL GOM â€” verdict propre au symbole de CE graphique
   SMCGP_PollGOM();

   // FIX 2026-09-26c : Pattern adjust AVANT tout affichage (grille GOM + bandeau)
   // Avant: grille dessinÃ©e avec vn brut, puis Pattern changeait vn â†’ bandeau
   // principal et grille divergeaient (ex. PERFECT SELL vs WAIT/GOOD).
   int originalGOMNum = g_smcGomVerdictNum;

   // FIX v1.32: Debounce Pattern Override - Ã©viter oscillations verdict GOM
   // Suivre le verdict original et n'appliquer override que si stable
   if(g_gomOriginalVerdictNum != originalGOMNum)
   {
      g_gomOriginalVerdictNum = originalGOMNum;
      g_gomOriginalSince = TimeCurrent();
      Print("ðŸ“Š GOM ORIGINAL changÃ©: ", originalGOMNum, " | Timestamp: ", TimeToString(g_gomOriginalSince, TIME_SECONDS));
   }

   // Calculer le verdict ajustÃ© par patterns
   int adjustedGOM = SMC_PGI_AdjustGOMVerdict(g_smcGomVerdictNum, _Symbol, PERIOD_CURRENT);

   // Pattern Override guards - traÃ§abilitÃ© corrections et source
   int patternCorrection = adjustedGOM - originalGOMNum;
   string patternSource = "";
   if(patternCorrection != 0)
   {
      // DÃ©terminer la source du pattern basÃ© sur l'Ã©tat des patterns
      if(g_patternGomState.patternDirection > 0 && g_patternGomState.patternBuyScore > g_patternGomState.patternSellScore)
         patternSource = "BUY_PATTERNS";
      else if(g_patternGomState.patternDirection < 0 && g_patternGomState.patternSellScore > g_patternGomState.patternBuyScore)
         patternSource = "SELL_PATTERNS";
      else
         patternSource = "PATTERN_CONFLUENCE";
      
      // Stocker pour traÃ§abilitÃ©
      g_gomPatternCorrection = patternCorrection;
      g_gomPatternSource = patternSource;
      g_gomPatternCorrectionTime = TimeCurrent();
   }
   else
   {
      g_gomPatternCorrection = 0;
      g_gomPatternSource = "";
   }

   // Les patterns locaux peuvent amÃ©liorer un verdict uniquement si la source
   // GOM, le prix M1 et le forecast 5m sont frais et confirment tous le mÃªme sens.
   // Sans cela, l'override transformait un WAIT/cache pÃ©rimÃ© en PERFECT BUY/SELL
   // affichÃ©, alors que le gate final bloquait lÃ©gitimement toute exÃ©cution.
   bool serverOk = (g_smcGomVerdictNumServer == 0 ||
                    ((g_smcGomVerdictNumServer > 0) == (adjustedGOM > 0)));
   bool forecastOk = (!g_smcForecast5mReady || g_smcForecastHorizonMinutes != 5 ||
                      g_smcGomVerdictForecastNum == 0 ||
                      ((g_smcGomVerdictForecastNum > 0) == (adjustedGOM > 0)));
   bool patternMayPromoteVerdict =
      MathAbs(adjustedGOM) >= 2 &&
      !g_smcGomHardDollarCorrection &&
      g_smcGomConnected &&
      g_smcGomSource != "CACHE_STALE_POLL_FORCED_WAIT" &&
      serverOk &&
      g_smcMarketPriceFresh &&
      g_smcMarketPriceAgeSec >= 0.0 &&
      g_smcMarketPriceAgeSec <= 90.0 &&
      forecastOk;
   if(adjustedGOM != originalGOMNum && adjustedGOM != 0 &&
      !patternMayPromoteVerdict)
   {
      Print("â›” Pattern Override BLOQUÃ‰ â€” contexte prix/forecast non confirmÃ© | ",
            _Symbol, " original=", originalGOMNum, " proposÃ©=", adjustedGOM,
            " serveur=", g_smcGomVerdictNumServer,
            " prixM1_frais=", g_smcMarketPriceFresh,
            " Ã¢ge=", DoubleToString(g_smcMarketPriceAgeSec, 1), "s",
            " forecast5m=", g_smcForecast5mReady,
            " horizon=", g_smcForecastHorizonMinutes,
            " forecastVn=", g_smcGomVerdictForecastNum);
      adjustedGOM = originalGOMNum;
   }

   // FIX v1.34: ne jamais laisser Pattern dÃ©grader GOOD/PERFECT â†’ WAIT
   // quand M1/M5/M15 sont alignÃ©s (ICT top-down confluence)
   if(SMCGP_SpikeAlignedGoodProtected(_Symbol, originalGOMNum) ||
      SMCGP_SpikeAlignedGoodProtected(_Symbol, g_smcGomVerdictNumServer))
   {
      int keepVn = (MathAbs(originalGOMNum) >= 2) ? originalGOMNum : g_smcGomVerdictNumServer;
      if(MathAbs(keepVn) >= 2 && MathAbs(adjustedGOM) < 2)
      {
         Print("ðŸ›¡ï¸ Pattern Override BLOQUÃ‰ (v1.34) â€” conserve GOOD/PERFECT vn=", keepVn,
               " (3 TF alignÃ©s) | pattern voulait ", adjustedGOM);
         adjustedGOM = keepVn;
      }
   }

   // FIX v1.32: N'appliquer l'override pattern que si:
   // 1. Le verdict original est stable depuis au moins g_gomDebounceMinSec secondes
   // 2. OU le verdict original est WAIT (0) et l'override est GOOD/PERFECT
   bool originalStable = (TimeCurrent() - g_gomOriginalSince >= g_gomDebounceMinSec);
   bool overrideAllowed = originalStable || (originalGOMNum == 0 && MathAbs(adjustedGOM) >= 2);

   if(overrideAllowed && adjustedGOM != originalGOMNum)
   {
      g_smcGomVerdictNum = adjustedGOM;
      g_gomLastAdjustedVerdict = adjustedGOM;
      g_gomLastAdjustTime = TimeCurrent();
      Print("ðŸ”„ Pattern Override APPLIQUÃ‰: Original=", originalGOMNum, " â†’ AjustÃ©=", adjustedGOM,
            " | Correction=", g_gomPatternCorrection, " Source=", g_gomPatternSource,
            " | Stable depuis ", (int)(TimeCurrent() - g_gomOriginalSince), "s");
   }
   else if(!overrideAllowed && adjustedGOM != originalGOMNum)
   {
      // Garder le verdict original, ignorer l'override pattern temporaire
      g_smcGomVerdictNum = originalGOMNum;
      Print("â¸ï¸ Pattern Override SUSPENDU: Original=", originalGOMNum, " (stable depuis ",
            (int)(TimeCurrent() - g_gomOriginalSince), "s < ", g_gomDebounceMinSec, "s requis)",
            " | Correction proposÃ©e=", g_gomPatternCorrection, " Source=", g_gomPatternSource);
   }
   else
   {
      // Pas de changement nÃ©cessaire
      g_smcGomVerdictNum = adjustedGOM;
   }

   SMC_SyncGomVerdictLabel(); // source unique : label = f(vn) aprÃ¨s adjust
   if(originalGOMNum != g_smcGomVerdictNum)
   {
      Print("ðŸ”„ Pattern-GOM Integration: Original vn=", originalGOMNum, " â†’ Adjusted vn=",
            g_smcGomVerdictNum, " label=", g_smcGomVerdict);
   }

   SMC_RefreshLocalTfDirsForDisplay(); // M1/M5 fidÃ¨les au prix (mÃªme GOM OFF)
   // AprÃ¨s MTF live : restituer GOOD/PERFECT si overlay WAIT + 3 TF alignÃ©s
   SMCGP_RestoreAlignedGoodIfWait(_Symbol);
   SMC_SyncGomVerdictLabel();
   if(UseDashboard || UseUnifiedDashboard)
      SMC_DrawTFTrendPanel();

   // Track GOM verdict and gate changes for future zone redraw
   int currentVerdictNum = SMCGP_DisplayVerdictNum();
   bool currentGateOk = SMC_M1M5GomAlignGateOK(_Symbol, (currentVerdictNum > 0) ? 1 : -1, g_smcGomCorrectionReason);
   if(currentVerdictNum != s_lastGomVerdictNum || currentGateOk != s_lastGomGateOk)
   {
      if(ShowGOMDashboard || ShowSignalArrow || ShowChartGraphics)
      {
         // Redraw future zone with updated GOM verdict
         GOMG_DrawFutureZone(0, 0, "GOM_FUTURE_ZONE", currentVerdictNum, SymbolInfoDouble(_Symbol, SYMBOL_BID));
      }
      s_lastGomVerdictNum = currentVerdictNum;
      s_lastGomGateOk = currentGateOk;
   }

   // Grille GOM + bandeau utilisent le MÃŠME vn/label post-adjust
   if(ShowGOMDashboard)
   {
      SMCGP_DrawGOMDashboard();
      SMC_ForceGomGridVerdictSync(); // aligne cellules texte sur g_smcGomVerdict
   }

   // FIX 2026-09-26 : flÃ¨che clignotante + rÃ©action spike chaque tick
   if(ShowSignalArrow)
   {
      DrawSignalArrow();
      UpdateSignalArrowBlink();
   }
   if(UseSpikeImminentAutoTrade && g_lastSpikeProbability >= 0.75 &&
      (IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol) || SMC_IsSynthSpikeFamily(_Symbol)))
   {
      TrySpikeImminentAutoEntry(g_lastSpikeProbability);
   }

   // DÃ©clencheur unique : toutes les anciennes stratÃ©gies d'ouverture sont
   // neutralisÃ©es par UnifiedGOMEntryMode. L'Ã©valuation intervient aprÃ¨s le
   // poll GOM (jamais avec un verdict du cycle prÃ©cÃ©dent).
   SMC_ReconUpdateVisualState();
   SMC_UnifiedGOMEntryOnTick();
   ICT_CheckLiquiditySweepsAndExecute();

// âœ… ENFORCEMENT LIMIT â€” hors mode DOW-only (sinon purge non-DOW uniquement)
    {
       static datetime s_lastEnforce = 0;
       if(TimeCurrent() - s_lastEnforce >= 30)
       {
          s_lastEnforce = TimeCurrent();
          if(Dow_IsDowOnlyLimitMode())
             Dow_PurgeNonDowLimitOrders();
          else
          {
             SMCGP_EnforceLimitDiscipline(InpMagicNumber, 2);
             CleanupExcessLimits(_Symbol, 2);
          }
       }
   }

      // âœ… Anti-flicker WAIT timer â€” must be called before any WAIT close logic
      SMC_UpdateGomWaitTimer();

      // WAIT = observer. Ne pas tuer LIMIT/positions au 1er tick WAIT
      // (flicker GOODâ†”WAIT = open/close et place/cancel). Annulation LIMIT
      // seulement si WAIT soutenu + Ã¢ge min ; positions via auto-close $2.
      SMC_CancelAllPendingOnGomWait();
      SMC_CloseExecutionsDuringGomWait();

      // âœ… GOM WAIT AUTO-CLOSE â€” Fermer TOUTES nos positions si verdict = WAIT (vn=0)
      // FIX: Age minimum 120s + anti-flicker 15s WAIT soutenu, ne fermer que les pertes
      bool gomWaitConfirmed = (g_smcGomVerdictNum == 0) &&
                              (g_smcGomConnected ||
                               (g_smcLastGOMPoll > 0 && TimeCurrent() - g_smcLastGOMPoll <= 900));
      if(UseGOMWaitAutoClose && gomWaitConfirmed)
      {
         // Anti-flicker: exiger WAIT soutenu depuis au moins 15 secondes
         if(g_gomWaitSince > 0 && TimeCurrent() - g_gomWaitSince >= 10) // v1.11
         {
            static datetime s_lastWaitCloseCheck = 0;
            if(TimeCurrent() - s_lastWaitCloseCheck >= 10) // check toutes les 10s
            {
               s_lastWaitCloseCheck = TimeCurrent();
               string sym = _Symbol;
               for(int i = PositionsTotal() - 1; i >= 0; i--)
               {
                  if(PositionGetSymbol(i) != sym) continue;
                  if((ulong)PositionGetInteger(POSITION_MAGIC) != (ulong)InpMagicNumber) continue;
                  ulong ticket = PositionGetInteger(POSITION_TICKET);
                  double profit = PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
                  datetime openTime = (datetime)PositionGetInteger(POSITION_TIME);
                  int ageSeconds = (int)(TimeCurrent() - openTime);
                  // v1.17: (A) perte >= 0.50$ ou (B) 5 min sans gain sous WAIT
                  if(profit > 0.0) continue; // winners: trailing/TP1
                  bool noGain5m = (ageSeconds >= CloseOnWaitNoGainSec && profit <= 0.0);
                  bool loss05   = (ageSeconds >= 15 && profit <= -GOMWaitCloseMinLossUSD);
                  if(!noGain5m && !loss05) continue;

                  string why = noGain5m ? "WAIT+no-gain-5min" : "WAIT+loss>=0.50";
                  Print("[GOM-WAIT] ", why, " | ", sym, " | age=", ageSeconds,
                        "s | profit=", DoubleToString(profit,2),
                        "$ | Fermeture #", ticket);
                  PositionCloseWithLog(ticket, "GOM verdict=WAIT auto-close", true);
               }
            }
         }
      }

    // ðŸŽ¯ GOM VERDICTS FROM ai_server â€” Every 60 seconds + WhatsApp alerts
   UpdateGOMDashboard();

   // Pipeline validÃ© + dessin GOM si activÃ© (tous symboles Deriv / forex / crypto)
   bool hasGOMData = (ShowGOMDashboard || UseGOMVerdictFilter || UseGOMPipeline);
   if(hasGOMData)
   {

      // Dessiner les Bollinger et zones GOM
      if(ShowGOMDashboard)
      {
         // Redessiner UNIQUEMENT si les valeurs GOM ont changÃ© depuis le dernier dessin
         // Ã‰vite ObjectsDeleteAll Ã  chaque tick (cause affichage absent sur Boom/Crash Ã  ticks rapides)
         static double s_lastBbUp = 0, s_lastBbDn = 0, s_lastBbMid = 0;
         static double s_lastKolaBuy = 0, s_lastKolaSell = 0;
         bool bbChanged    = (MathAbs(g_smcBbUp  - s_lastBbUp)    > 0.0001 ||
                              MathAbs(g_smcBbDn  - s_lastBbDn)    > 0.0001 ||
                              MathAbs(g_smcBbMid - s_lastBbMid)   > 0.0001);
         bool kolaChanged  = (MathAbs(g_smcGomKolaBuy  - s_lastKolaBuy)  > 0.0001 ||
                              MathAbs(g_smcGomKolaSell - s_lastKolaSell) > 0.0001);

         if(bbChanged || kolaChanged)
         {
            // Mettre Ã  jour les valeurs tracÃ©es
            s_lastBbUp    = g_smcBbUp;
            s_lastBbDn    = g_smcBbDn;
            s_lastBbMid   = g_smcBbMid;
            s_lastKolaBuy  = g_smcGomKolaBuy;
            s_lastKolaSell = g_smcGomKolaSell;

            // Supprimer les anciens dessins uniquement quand les valeurs changent
            ObjectsDeleteAll(0, "GOM_BB_");
            ObjectsDeleteAll(0, "GOM_KOLA_");
            ObjectsDeleteAll(0, "GOM_PRED_ZONE");

            // Dessiner toujours si ShowGOMDashboard = true, mÃªme sans connexion GOM
            if(g_smcBbUp > 0 && g_smcBbMid > 0 && g_smcBbDn > 0)
            {
               GOMG_DrawBollinger(g_smcBbUp, g_smcBbMid, g_smcBbDn);
               int gomDrawVn = g_smcGomVerdictNum;
               if(gomDrawVn == -999) gomDrawVn = 0;
               if(gomDrawVn == 0 && MathAbs(g_smcGomVerdictNumServer) >= 1)
                  gomDrawVn = g_smcGomVerdictNumServer;
               GOMG_DrawFutureZone(g_smcBbUp, g_smcBbDn, "GOM_PRED_ZONE",
                                   gomDrawVn, SymbolInfoDouble(_Symbol, SYMBOL_BID));
               Print("[GOMG] Bollinger redessinÃ©es (valeurs changÃ©es)");
            }

            if(g_smcGomKolaBuy > 0 || g_smcGomKolaSell > 0)
            {
               GOMG_DrawKolaLevels(g_smcGomKolaBuy, g_smcGomKolaSell);
               Print("[GOMG] Niveaux Kola redessinÃ©s (valeurs changÃ©es)");
            }
         }

         // Zone OTE (Optimal Trade Entry â€” Fib 61.8%â€“78.6% du swing MT5 live)
         if(UseOTE)
         {
            SMCGP_DrawOTEZone();
            if(g_smcOteTop > 0 && g_smcOteBot > 0)
               Print(StringFormat("[GOMG] OTE zone: [%.5f - %.5f] in_ote=%s",
                     g_smcOteBot, g_smcOteTop, g_smcInOTE ? "YES" : "NO"));
         }

         // Dessiner les prÃ©dictions Bollinger (300 bougies) si disponibles
         if(ArraySize(g_smcPredBbMid) > 0)
         {
            static int s_lastPredSize = 0;
            static double s_lastPredMid0 = 0;
            bool predChanged = (ArraySize(g_smcPredBbMid) != s_lastPredSize ||
                                MathAbs(g_smcPredBbMid[0] - s_lastPredMid0) > 0.0001);
            if(predChanged)
            {
            s_lastPredSize  = ArraySize(g_smcPredBbMid);
            s_lastPredMid0  = g_smcPredBbMid[0];
            // Supprimer les anciennes prÃ©dictions uniquement quand elles changent
            ObjectsDeleteAll(0, "GOM_PRED_MID_");
            ObjectsDeleteAll(0, "GOM_PRED_UP_");
            ObjectsDeleteAll(0, "GOM_PRED_DN_");

            datetime now = TimeCurrent();
            int n_points = ArraySize(g_smcPredBbMid);
            int time_step = 60; // 1 min per point

            // Tracer MID (bleu, solide)
            for(int i = 0; i < n_points - 1; i++)
            {
               string line_name = StringFormat("GOM_PRED_MID_%d", i);
               datetime t1 = now + (i * time_step);
               datetime t2 = now + ((i + 1) * time_step);
               ObjectDelete(0, line_name);
               ObjectCreate(0, line_name, OBJ_TREND, 0, t1, g_smcPredBbMid[i], t2, g_smcPredBbMid[i + 1]);
               ObjectSetInteger(0, line_name, OBJPROP_COLOR, clrBlue);
               ObjectSetInteger(0, line_name, OBJPROP_WIDTH, 2);
               ObjectSetInteger(0, line_name, OBJPROP_STYLE, STYLE_SOLID);
               ObjectSetInteger(0, line_name, OBJPROP_RAY_RIGHT, false);
               ObjectSetInteger(0, line_name, OBJPROP_BACK, false);
            }

            // Tracer UP (rouge, pointillÃ©)
            for(int i = 0; i < n_points - 1; i++)
            {
               string line_name = StringFormat("GOM_PRED_UP_%d", i);
               datetime t1 = now + (i * time_step);
               datetime t2 = now + ((i + 1) * time_step);
               ObjectDelete(0, line_name);
               ObjectCreate(0, line_name, OBJ_TREND, 0, t1, g_smcPredBbUp[i], t2, g_smcPredBbUp[i + 1]);
               ObjectSetInteger(0, line_name, OBJPROP_COLOR, clrRed);
               ObjectSetInteger(0, line_name, OBJPROP_WIDTH, 1);
               ObjectSetInteger(0, line_name, OBJPROP_STYLE, STYLE_DASH);
               ObjectSetInteger(0, line_name, OBJPROP_RAY_RIGHT, false);
               ObjectSetInteger(0, line_name, OBJPROP_BACK, false);
            }

            // Tracer DN (vert, pointillÃ©)
            for(int i = 0; i < n_points - 1; i++)
            {
               string line_name = StringFormat("GOM_PRED_DN_%d", i);
               datetime t1 = now + (i * time_step);
               datetime t2 = now + ((i + 1) * time_step);
               ObjectDelete(0, line_name);
               ObjectCreate(0, line_name, OBJ_TREND, 0, t1, g_smcPredBbDn[i], t2, g_smcPredBbDn[i + 1]);
               ObjectSetInteger(0, line_name, OBJPROP_COLOR, clrGreen);
               ObjectSetInteger(0, line_name, OBJPROP_WIDTH, 1);
               ObjectSetInteger(0, line_name, OBJPROP_STYLE, STYLE_DASH);
               ObjectSetInteger(0, line_name, OBJPROP_RAY_RIGHT, false);
               ObjectSetInteger(0, line_name, OBJPROP_BACK, false);
            }

            Print(StringFormat("[GOMG] Bollinger Predictions dessinÃ©es: %d points", n_points));
            } // end if(predChanged)
         }
      }

      if(!UnifiedGOMEntryMode && !SMC_IsPurePAExclusive() && UseGOMPipeline && !BlockAllTrades && !gomBlocked && !tfBlocked && !dowExclusiveMode)
         SMCGP_PollAndExecutePipeline();
      else if(UseGOMPipeline && SMC_IsPurePAExclusive())
         SMCGP_PollGOM(); // observation seule â€” pas d'exÃ©cution pipeline

      // âœ… ENTRÃ‰ES INDÃ‰PENDANTES EA â€” COUPÃ‰ES en PurePA exclusif
      if(!UnifiedGOMEntryMode && !SMC_IsPurePAExclusive() && !dowExclusiveMode && UseEAIndependentEntry && !BlockAllTrades && !gomBlocked && !tfBlocked && g_smcGomConnected)
      {
         if(SMCGP_IsGoodPerfect(g_smcGomVerdictNum))
         {
            // BUY si verdict positif (vn >= 2)
            if(g_smcGomVerdictNum >= 2)
            {
               static datetime lastBUYAttempt = 0;
               if(currentTime - lastBUYAttempt >= 60)
               {
                  lastBUYAttempt = currentTime;
                  Print("[EA-INDEP] âœ… BUY autorisÃ© | Verdict=", g_smcGomVerdict, " | vn=", g_smcGomVerdictNum);
               }
            }

            // SELL si verdict nÃ©gatif (vn <= -2)
            if(g_smcGomVerdictNum <= -2)
            {
               static datetime lastSELLAttempt = 0;
               if(currentTime - lastSELLAttempt >= 60)
               {
                  lastSELLAttempt = currentTime;
                  Print("[EA-INDEP] âœ… SELL autorisÃ© | Verdict=", g_smcGomVerdict, " | vn=", g_smcGomVerdictNum);
               }
            }
         }
      }
   }

   // === PROACTIVE ENTRY ZONE CACHING (avant spike detection) ===
   UpdateCachedEntryZones();
   DrawCachedEntryZones();

// STRATÃ‰GIE DERIV ARROW dÃ©sactivÃ©e â€” pipeline GOM uniquement
     if(!UnifiedGOMEntryMode && !SMC_IsPurePAExclusive() && !PipelineOnlyMode && UseDerivArrowTrades && !dowExclusiveMode && !gomBlocked)
        CheckAndExecuteDerivArrowTrade();
   
   // Gestion des positions existantes (fermeture rapide aprÃ¨s spike)
   ManageBoomCrashSpikeClose();
   ManageAdverseSpikeClose();
   // FIX 2026-09-20: Deadline universelle pour tous les symboles
   ManageUniversalSpikeDeadline();
   // Gestion des sorties en dollars (TP/SL globaux + BoomCrashSpikeTP)
   ManageDollarExits();
   // Fermer toute position sans profit aprÃ¨s 7 minutes (probable correction)
   CloseUnprofitableAfterDelay();

   // TP1$ : Fermer Ã  +1$ profit et rÃ©-entrÃ©e sur pullback S/R, OB, EMA
   if(!UnifiedGOMEntryMode) TP1_CloseAndReEntry();
   // Fermer si verdict â†’ WAIT et perte â‰¥ 1$
   CloseOnVerdictWait();
   ManageGOMVerdictExits();

   // ðŸ” PROFIT LOCK SL â€” verrou EA-level dÃ¨s que le trade devient gagnant
   // (indÃ©pendant de la catÃ©gorie symbole ; ne fait qu'avancer le SL, jamais le reculer)
   if(UseProfitLockSL)
      SMC_ProfitLockSL();

   // Trailing stop + SL structure â€” toujours actif (mÃªme UltraLight)
   if(UseTrailingStop)
      ManageTrailingStop();
   SMC_SpikeBlink_OnTick();
   
   // Si on est en mode ultra lÃ©ger: ne pas lancer l'IA ni mettre Ã  jour les graphiques/dashboard
   if(UltraLightMode)
      return;
   
   // MISE Ã€ JOUR IA - Appel au serveur IA pour obtenir les dÃ©cisions
   if(UseAIServer && currentTime - lastAIUpdate >= AI_UpdateInterval_Seconds)
   {
      lastAIUpdate = currentTime;
      UpdateAIDecision(AI_Timeout_ms);
      
      // Mettre Ã  jour les mÃ©triques ML si activÃ©es (30 s pour affichage rÃ©actif)
      if(ShowMLMetrics && (TimeCurrent() - g_lastMLMetricsUpdate) >= 30)
      {
         UpdateMLMetricsDisplay();
      }
   }
   
   // Si l'IA est passÃ©e en HOLD, couper immÃ©diatement les positions de l'EA
   Print("ðŸ” DEBUG - VÃ©rification IA HOLD | g_lastAIAction: '", g_lastAIAction, "' | UseAIServer: ", UseAIServer);
   ClosePositionsOnIAHold();
   
   // NOUVEAU: Surveillance des changements IA vers HOLD et fermeture automatique
   MonitorAndClosePositionsOnHold();
   
   // NOUVEAU: VÃ©rifier les conflits de direction sur Boom/Crash
   ClosePositionsOnDirectionConflict();
   
   // ROTATION AUTOMATIQUE DES POSITIONS pour Ã©viter de rester bloquÃ© sur un symbole
   static datetime lastRotationCheck = 0;
   if(currentTime - lastRotationCheck >= 60) // VÃ©rifier toutes les minutes
   {
      lastRotationCheck = currentTime;
      AutoRotatePositions();
   }
   
   // DÃ‰TECTION ULTRA-RAPIDE DE SPIKE (1s â€” FIX 2026-09-26: 5s trop lent vs flÃ¨che)
   static datetime lastSpikeCheck = 0;
   if(IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol) || SMC_IsSynthSpikeFamily(_Symbol))
   {
      if(currentTime - lastSpikeCheck >= 1)
      {
         lastSpikeCheck = currentTime;
         CheckImminentSpike(); // VÃ©rification rapide + auto-entry
         CheckAndNotifySpikeSeries(); // Push sÃ©rie spikes start/end
         if(!UnifiedGOMEntryMode) CheckRSISqueezeAndTrade(); // RSI squeeze hors dÃ©clencheur unifiÃ©
      }
   }
   
   // GRAPHIQUES SMC CONTRÃ”LÃ‰S (toutes les 15 secondes pour plus de rÃ©activitÃ©)
   if(ShowChartGraphics && currentTime - lastGraphicsUpdate >= 15)
   {
      lastGraphicsUpdate = currentTime;
      
      // DÃ‰TECTION ANTI-REPAINT DES SWING POINTS
      DetectNonRepaintingSwingPoints();
      DrawConfirmedSwingPoints();
      
       // DÃ‰TECTION SPÃ‰CIALE BOOM/CRASH (ANTI-SPIKE)
       if(IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol))
       {
          DetectBoomCrashSwingPoints();
         
         // DÃ‰TECTION AVANCÃ‰E DE SPIKE IMMINENT - OPTIMISÃ‰E
         CheckImminentSpike();
         // RSI SQUEEZE PREDICTOR â€” squeeze + H1 trend + auto-trade
         if(!UnifiedGOMEntryMode) CheckRSISqueezeAndTrade();
         
         // DÃ‰TECTION DES MOUVEMENTS DE RETOUR VERS CANAUX SMC
         if(!UnifiedGOMEntryMode) CheckSMCChannelReturnMovements();
      }
      
      // Bandeau IA/SPIKE retirÃ© (encombre le graphique)
      
      // PATTERNS CHARTISTES â€” scan et dessin (SMCPS_DrawMarker appelle SMCPS_Scan)
      if(UsePatternEntrySignals)
      {
         SMCPS_EnsureScanned(_Symbol);
         SMCPS_DrawMarker(_Symbol);
      }
      
      // OVERLAY CORRECTION GOM
      if(UseGOMCorrectionOverlay && g_showCorrectionOverlay)
         SMCCT_DrawCorrectionOverlay();
      
      // LIGNES EMA 200/100/50 + SESSIONS + LIQUIDITÃ‰
      if(ShowEMASupportResistance)
      {
         DrawEMASupportResistance();
         DrawEMACurveOnChart();
         SMCCT_DrawAllEMAs();
      }
      DrawBollingerCurve();
      DrawLiquidityZonesOnChart();
      SMCCT_DrawAllSessions();

      // MATÃ‰RIALISATION DES ZONES FVG + LIGNE DE TRAIL (SMC_DISP_FVG / SMC_DISP_FVG_TRAIL)
      if(UseFVGBoxStrategy)
         SMC_FVGBox_OnTick(_Symbol);
      else
         SMC_DISP_UpdateFVGZones();
      
      // Dessins TV synchronisÃ©s (KOLA, OB setup, zone OTE) â€” comme TradeManager
      if(ShowTVSyncedLevels)
      {
         Print("[SMC-DEBUG] TV Sync vars: SetupValid=", g_smcSetupValid, " Entry=", g_smcSetupEntry,
               " SL=", g_smcSetupSL, " KolaBuy=", g_smcGomKolaBuy, " KolaSell=", g_smcGomKolaSell);
         SMCGP_DrawTVLevels();
      }

      // MODE TV SYNCED ONLY: Afficher UNIQUEMENT les niveaux sync depuis TradingView
      if(UseMinimalICTDrawings)
      {
         // MODE MINIMAL: UNIQUEMENT les niveaux TV sync
         // - Bollinger Bands (courbes) â†’ dessinÃ©es dans bloc GOM (ShowGOMDashboard)
         // - KOLA Levels (BUY/SELL) â†’ dessinÃ©es dans bloc GOM
         // - Zone OTE future â†’ dessinÃ©e dans bloc GOM
         // - Fibonacci Retracements â†’ dessinÃ©es ici
         // - Bougies prÃ©dites â†’ dessinÃ©es dans bloc GOM
         // NO: SwingHighLow, BookmarkLevels, FVG, OB local, EMA, Liquidity

         DrawFibonacciOnChart();  // Retracements Fibonacci UNIQUEMENT
         if(ShowSignalArrow) { DrawSignalArrow(); UpdateSignalArrowBlink(); }
         UpdateSpikeWarningBlink();
      }
      else
      {
         // Full Mode: UNIQUEMENT TV Sync (Bollinger, 2 OB, Fibonacci, PrÃ©dictions, OTE)
         // Affichage propre : pas de Swing, Bookmark, FVG, EMA, Liquidity
         DrawFibonacciOnChart();
         if(ShowSignalArrow) { DrawSignalArrow(); UpdateSignalArrowBlink(); }
         UpdateSpikeWarningBlink();
          if(ShowLimitOrderLevels) DrawLimitOrderLevels();
          if(!UnifiedGOMEntryMode && !SMC_IsPurePAExclusive() && !Dow_IsDowOnlyLimitMode()) AdjustEMAScalpingLimitOrder();
         if(!UnifiedGOMEntryMode && !SMC_IsPurePAExclusive() && !Dow_IsDowOnlyLimitMode() && !dowExclusiveMode) PlaceSMCChannelLimitOrder();
      }
      if(UseOTE)
         SMC_DrawOTETrackerPanel();
   }
    
     // S/R 20 BAR LIMIT ORDERS â€” dÃ©sactivÃ© en mode DOW-only (LIMIT uniquement sur trendline DOW)
     if(!UnifiedGOMEntryMode && !SMC_IsPurePAExclusive() && !Dow_IsDowOnlyLimitMode() && !dowExclusiveMode) PlaceSRLimitOrders20Bars();
    UpdateSR20BounceState();      // S/R 20 bars touchÃ©+rebondi -> arme chaÃ®ne spikes
    
     // SPIKE CHAIN PREDICTION: modelise les chaines de spikes a venir + WhatsApp
     PredictSpikeChainAndAlert();
     
     // ENTRÃ‰E GOM-ALIGN marchÃ© : GOM GOOD/PERFECT seulement (pas sous WAIT)
     if(!UnifiedGOMEntryMode && !gomBlocked && (!dowExclusiveMode || Dow_IsDowOnlyLimitMode()))
        ExecuteGOMAlignmentMarketOrder();
    
     // ENTRÃ‰ES AU MARCHÃ‰ BASÃ‰ES SUR LA DÃ‰CISION IA SMC/EMA
   // FIX v1.21 Option A: AI/pattern MARKET coupÃ©s si PurePA exclusif
   if(!UnifiedGOMEntryMode && !SMC_IsPurePAExclusive() && !gomBlocked && !PipelineOnlyMode && (!dowExclusiveMode || Dow_IsDowOnlyLimitMode()))
   {
      ExecuteAIDecisionMarketOrder();
      // ENTRÃ‰ES PATTERN + GOM (MARKET si pattern + verdict GOOD/PERFECT uniquement)
      if(PatternTriggerMarketEntry && UsePatternEntrySignals)
      {
         // â”€â”€ DIAGNOSTIC: pourquoi l'entrÃ©e pattern est bloquÃ©e (30s debounce) â”€â”€
         static datetime s_patDiagLog = 0;
         if(TimeCurrent() - s_patDiagLog >= 30)
         {
            s_patDiagLog = TimeCurrent();
            int diagDir = (g_smcGomVerdictNum > 0) ? 1 : (g_smcGomVerdictNum < 0 ? -1 : 0);
            Print("[PATTERN-DIAG] ", _Symbol, " | dir=",
                  (diagDir > 0 ? "BUY" : (diagDir < 0 ? "SELL" : "none")), " | ",
                  SMCPS_PatternBlockReason(_Symbol, diagDir));
         }
         if(SMC_EntryVerdictOK(_Symbol, 1))
         {
            string patReason = "";
            if(!SMC_IsSpikeStyleSymbol(_Symbol) || SMC_MarketEntryTripleGateOK(1, patReason, true))
               SMCPS_TryExecutePatternEntry(_Symbol, 1, "BUY");
         }
         if(SMC_EntryVerdictOK(_Symbol, -1))
         {
            string patReason = "";
            if(!SMC_IsSpikeStyleSymbol(_Symbol) || SMC_MarketEntryTripleGateOK(-1, patReason, true))
               SMCPS_TryExecutePatternEntry(_Symbol, -1, "SELL");
         }

         // FIX 2026-09-14: confluence patterns exige aussi GOM GOOD/PERFECT alignÃ©.
         if(UsePatternConfluenceEntry)
         {
            if(SMC_EntryVerdictOK(_Symbol, 1))
               SMCPS_TryExecutePatternConfluenceEntry(_Symbol, 1, "BUY");
            if(SMC_EntryVerdictOK(_Symbol, -1))
               SMCPS_TryExecutePatternConfluenceEntry(_Symbol, -1, "SELL");
         }

         // NOUVEAU 2026-09-19: cascade M15 (dÃ©clencheur) -> M5 (lent, cassure
         // confirmÃ©e) / M1 (rapide, scalp prudent). Les deux volets sont
         // indÃ©pendants et peuvent se dÃ©clencher tous les deux dans la mÃªme
         // fenÃªtre M15 si leurs conditions respectives sont remplies.
         if(UseM15CascadeEntry)
         {
            if(SMC_EntryVerdictOK(_Symbol, 1))
            {
               string patReasonM15Buy = "";
               if(!SMC_IsSpikeStyleSymbol(_Symbol) || SMC_MarketEntryTripleGateOK(1, patReasonM15Buy, true))
               {
                  SMCPS_TryExecuteM15CascadeM5Entry(_Symbol, 1, "BUY");
                  SMCPS_TryExecuteM15CascadeM1ScalpEntry(_Symbol, 1, "BUY");
               }
            }
            if(SMC_EntryVerdictOK(_Symbol, -1))
            {
               string patReasonM15Sell = "";
               if(!SMC_IsSpikeStyleSymbol(_Symbol) || SMC_MarketEntryTripleGateOK(-1, patReasonM15Sell, true))
               {
                  SMCPS_TryExecuteM15CascadeM5Entry(_Symbol, -1, "SELL");
                  SMCPS_TryExecuteM15CascadeM1ScalpEntry(_Symbol, -1, "SELL");
               }
            }
         }
}
       }

       // FVG AUTO-ENTRY ON SPIKE SYMBOLS (PainX/GainX/Boom/Crash)
       // BUY on bullish FVG retest with GOOD/PERFECT BUY verdict
       // SELL on bearish FVG retest with GOOD/PERFECT SELL verdict
       if(UseFVGAutoEntrySpike && SMC_IsSpikeStyleSymbol(_Symbol) && g_smcGomConnected &&
          SMCGP_IsGoodPerfect(g_smcGomVerdictNum))
       {
          static datetime s_fvgAutoLastEntry = 0;
          if(TimeCurrent() - s_fvgAutoLastEntry >= FVGAutoEntryCooldownSec && CountPositionsForSymbol(_Symbol) == 0)
          {
             int dirSign = (g_smcGomVerdictNum > 0) ? 1 : -1;
             
             // Check TF alignment if required
             bool tfAligned = true;
             if(FVGAutoEntryRequireTFAlign)
             {
                // Need M1 and M5 aligned with verdict
                bool m1Aligned = (dirSign > 0 && g_smcTfM1Dir == "BULL") || (dirSign < 0 && g_smcTfM1Dir == "BEAR");
                bool m5Aligned = (dirSign > 0 && g_smcTfM5Dir == "BULL") || (dirSign < 0 && g_smcTfM5Dir == "BEAR");
                tfAligned = m1Aligned && m5Aligned;
             }
             
             if(tfAligned && CanPlaceMarketOrder(_Symbol, dirSign))
             {
                // Check for FVG retest in our direction
                double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
                double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
                if(bid > 0 && ask > bid)
                {
                   double price = (dirSign > 0) ? ask : bid;
                   bool fvgRetest = false;
                   
                   for(int i = 0; i < ArraySize(fvgDataArray); i++)
                   {
                      if(!fvgDataArray[i].isMitigated && fvgDataArray[i].direction == dirSign)
                      {
                         // Price is inside or very near the FVG
                         if(dirSign > 0 && price >= fvgDataArray[i].bottom && price <= fvgDataArray[i].top)
                         {
                            fvgRetest = true;
                            break;
                         }
                         else if(dirSign < 0 && price >= fvgDataArray[i].bottom && price <= fvgDataArray[i].top)
                         {
                            fvgRetest = true;
                            break;
                         }
                      }
                   }
                   
if(fvgRetest)
                    {
                       ENUM_ORDER_TYPE ot = (dirSign > 0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
                       if(SMC_FinalOpenGate(_Symbol, ot) && TryAcquireOpenLock())
                       {
                          double atrValue = 0;
                          double atr[];
                          ArraySetAsSeries(atr, true);
                          if(atrHandle != INVALID_HANDLE && CopyBuffer(atrHandle, 0, 0, 1, atr) >= 1)
                             atrValue = atr[0];
                          if(atrValue <= 0) atrValue = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 50.0;

                          double price = (dirSign > 0) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);
                          double sl = 0, tp = 0;

                          // Calculate initial SL based on ATR (similar to spike trades)
                          if(dirSign > 0)
                             sl = price - atrValue * 1.2;
                          else
                             sl = price + atrValue * 1.2;

                          // Cap SL to max loss per trade (e.g., $2 for spike symbols)
                          double maxLossUSD = MaxLossPerSpikeTradeDollars;
                          if(maxLossUSD <= 0) maxLossUSD = 2.0;
                          SMC_CapSLToMaxLossUSD(_Symbol, dirSign, price, 0.01, sl); // cap with min lot

                          // Calculate lot size based on capped SL
                          double vol = CalculateLotSize(_Symbol, price, sl);

                          // Recalculate TP based on risk/reward
                          double rr = UseSniperScalperMode ? MinRewardRiskRatio : 1.5;
                          if(dirSign > 0)
                             tp = price + (price - sl) * rr;
                          else
                             tp = price - (sl - price) * rr;

                          if(vol >= SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN))
                          {
                             string commentStr = "FVG_AUTO_" + (dirSign > 0 ? "BUY" : "SELL");
                             SMC_EntryRequest er;
                             SMC_EntryRequest_Init(er);
                             er.symbol      = _Symbol;
                             er.orderType   = ot;
                             er.volume      = vol;
                             er.price       = price;
                             er.sl          = sl;
                             er.tp          = tp;
                             er.deviation   = 50;
                             er.comment     = commentStr;
                             er.sourceLabel = "FVG AUTO";

                             MqlTradeResult res;
                             if(SMC_SubmitEntry(er, res))
                             {
                                Print("âš¡ FVG AUTO-ENTRY: ", (dirSign > 0 ? "BUY" : "SELL"), " ", _Symbol,
                                      " @ ", DoubleToString(price, _Digits), " | vol=", DoubleToString(vol, 2),
                                      " | verdict=", g_smcGomVerdictNum, " | FVG dir=", dirSign,
                                      " | SL=", DoubleToString(sl, _Digits), " | TP=", DoubleToString(tp, _Digits));
                                s_fvgAutoLastEntry = TimeCurrent();
                             }
                          }
                          ReleaseOpenLock();
                       }
                    }
                }
             }
          }
       }

       // ENTRÃ‰E SUR RETEST du pointillÃ© Entry (S/R 20 bars touchÃ©+rebondi = impulsion forte)
      if(PatternTriggerMarketEntry && UsePatternEntrySignals)
      {
         if(SMC_EntryVerdictOK(_Symbol, 1))
         {
            string patReason = "";
            if(!SMC_IsSpikeStyleSymbol(_Symbol) || SMC_MarketEntryTripleGateOK(1, patReason, true))
               SMCPS_TryExecutePatternEntryOnRetest(_Symbol, 1, "BUY");
         }
         if(SMC_EntryVerdictOK(_Symbol, -1))
         {
            string patReason = "";
            if(!SMC_IsSpikeStyleSymbol(_Symbol) || SMC_MarketEntryTripleGateOK(-1, patReason, true))
               SMCPS_TryExecutePatternEntryOnRetest(_Symbol, -1, "SELL");
}
       }
    }

//| FONCTIONS DE GESTION DES PAUSES ET BLACKLIST TEMPORAIRE        |

void UpdateDashboard()
{
   if(!UseDashboard) return;
   string catStr = "UNKNOWN";
   switch(SMC_GetSymbolCategory(_Symbol))
   {
      case SYM_BOOM_CRASH:  catStr = "Boom/Crash"; break;
      case SYM_VOLATILITY:  catStr = "Volatility"; break;
      case SYM_FOREX:       catStr = "Forex"; break;
      case SYM_COMMODITY:   catStr = "Commodity"; break;
      case SYM_METAL:       catStr = "Metal"; break;
      case SYM_CRYPTO:      catStr = "Crypto"; break;
   }
   int posCount = CountPositionsForSymbol(_Symbol);
   int totalPos = CountPositionsOurEA();
   
   double totalPL = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
      if(posInfo.SelectByIndex(i) && posInfo.Magic() == InpMagicNumber)
         totalPL += posInfo.Profit() + posInfo.Swap() + posInfo.Commission();
   string swingStr = "";
   if(g_lastSwingHigh > 0) swingStr += " SH=" + DoubleToString(g_lastSwingHigh, _Digits);
   if(g_lastSwingLow > 0)  swingStr += " SL=" + DoubleToString(g_lastSwingLow, _Digits);
   double atrVal = 0, emaVal = 0;
   double atrArr[], emaArr[];
   ArraySetAsSeries(atrArr, true); ArraySetAsSeries(emaArr, true);
   if(atrHandle != INVALID_HANDLE && CopyBuffer(atrHandle, 0, 0, 1, atrArr) >= 1) atrVal = atrArr[0];
   if(emaHandle != INVALID_HANDLE && CopyBuffer(emaHandle, 0, 0, 1, emaArr) >= 1) emaVal = emaArr[0];
   if(ShowMLMetrics && (TimeCurrent() - g_lastMLMetricsUpdate) >= 30)
       UpdateMLMetricsDisplay();
   SMC_SyncGomVerdictLabel();
   string gomStr = (UseGOMVerdictFilter || ShowGOMDashboard)
      ? StringFormat("%s %s vn=%+d Q=%.0f%% C=%.0f%% [%s] | TV->PY %s | sym=%s",
                     SMCGP_GomLinkOK() ? "OK" : "OFF", g_smcGomVerdict, g_smcGomVerdictNum,
                     g_smcGomQuality, g_smcGomCoherence,
                     g_smcSetupValid ? g_smcSetupType : "â€”",
                     g_smcGomSource, _Symbol)
      : "OFF";
   // NOUVEAU 2026-09-26 : si WAIT, on affiche la raison exacte envoyÃ©e par le
   // serveur (gap trop faible / indicateurs opposÃ©s / rÃ©gime instable) au
   // lieu de laisser deviner pourquoi un prix "en plein sell" reste WAIT.
   if(g_smcGomVerdictNum == 0 && StringLen(g_smcGomVerdictReason) > 0)
      gomStr += StringFormat(" | gap=%.2f (%s)", g_smcGomVerdictGap, g_smcGomVerdictReason);
   int spikeHTFDisplayDir = SMC_SpikeBlink_HTFDisplayDirection();
   if(spikeHTFDisplayDir != 0)
      gomStr += spikeHTFDisplayDir > 0
                ? " | SPIKE HTF BUY SIMPLE (base GOM=WAIT)"
                : " | SPIKE HTF SELL SIMPLE (base GOM=WAIT)";
int patDir = (g_smcGomVerdictNum > 0) ? 1 : (g_smcGomVerdictNum < 0 ? -1 : 0);
   string patLine = (UsePatternEntrySignals && PatternTriggerMarketEntry)
      ? "Pattern[" + (patDir > 0 ? "BUY" : (patDir < 0 ? "SELL" : "â€”")) + "]: "
        + SMCPS_PatternBlockReason(_Symbol, patDir)
      : "Pattern: off";
   string cmStr = CM_StatusLine();

   if(UseUnifiedDashboard)
   {
      Comment(""); // libÃ¨re le Comment() legacy, tout passe par le panneau unique
      SMC_DrawUnifiedDashboard(catStr, cmStr, gomStr, patLine, totalPos, posCount,
                                totalPL, swingStr, atrVal, emaVal);
      SMC_DrawTFTrendPanel();
      return;
   }

   Comment("â•â•â• SMC Universal + FVG_Kill PRO â•â•â• ", catStr, "\n",
            cmStr, " | GOM: ", gomStr,
            " | Pipe=", UseGOMPipeline ? "ON" : "OFF",
            " Dash=", ShowGOMDashboard ? "ON" : "OFF", "\n",
            patLine, "\n",
            "Positions: ", totalPos, "/", MaxPositionsTerminal, " | ", _Symbol, ": ", posCount, "/1",
            " | P&L: ", DoubleToString(totalPL, 2), " $ (max ", DoubleToString(MaxTotalLossDollars, 0), "$)\n",
            "Swing:", swingStr,
            " | ATR: ", DoubleToString(atrVal, _Digits),
            " | EMA(9): ", DoubleToString(emaVal, _Digits),
            (StringLen(g_mlMetricsStr) > 0 ? "\nML: " + g_mlMetricsStr : ""));

   SMC_DrawTFTrendPanel();
}

//+------------------------------------------------------------------+
//| NOUVEAU 2026-09-26 (demande Sidoine) : PANNEAU UNIQUE CONSOLIDÃ‰.  |
//| Remplace : Comment() legacy, TFPANEL (6 cases TF), OTE tracker,  |
//| SPIKE_PNL, grille GOM (V1/I0/R4/PM, ~45 cellules), CrossCorr.     |
//| Ne garde que l'info actionnable : verdict + qualitÃ©, tendance    |
//| MTF condensÃ©e en 1 ligne, setup actif (OTE/DOW/Pattern â€” un      |
//| seul, celui qui compte rÃ©ellement), position/P&L/discipline,     |
//| et 1 ligne spike / cross-corr uniquement si pertinente (sinon    |
//| la ligne est absente, pas juste grisÃ©e).                          |
//+------------------------------------------------------------------+
void SMC_DrawUnifiedDashboard(const string catStr, const string cmStr, const string gomStr,
                               const string patLine, int totalPos, int posCount,
                               double totalPL, const string swingStr, double atrVal, double emaVal)
{
   string name = "SMC_UNIFIED_DASH_" + _Symbol;

   // â”€â”€ Verdict : couleur du cadre â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   color frameColor = clrSilver;
   if(g_smcGomConnected)
   {
      if(g_smcGomVerdictNum >= 2) frameColor = clrLime;
      else if(g_smcGomVerdictNum == 1) frameColor = clrYellowGreen;
      else if(g_smcGomVerdictNum <= -2) frameColor = clrRed;
      else if(g_smcGomVerdictNum == -1) frameColor = clrOrange;
      else frameColor = clrGold; // WAIT
   }

   // â”€â”€ Tendance MTF condensÃ©e + grille TFPANEL live â”€â”€â”€â”€
   SMC_RefreshLocalTfDirsForDisplay();
   string labels[6] = {"D1","H4","H1","M15","M5","M1"};
   string m1Show = (StringLen(g_smcTfM1DirLive) > 0) ? g_smcTfM1DirLive : g_smcTfM1Dir;
   string dirs[6] = {g_smcTfD1Dir, g_smcTfH4Dir, g_smcTfH1Dir, g_smcTfM15Dir, g_smcTfM5Dir, m1Show};
   string mtfLine = "";
   for(int i = 0; i < 6; i++)
   {
      string arrow = (dirs[i] == "BULL") ? "\x2191" : (dirs[i] == "BEAR") ? "\x2193" : "=";
      mtfLine += labels[i] + arrow + " ";
   }
   string gArrow = (g_smcGomGlobalDir == "BULL" || g_smcGomGlobalDir == "BUY") ? "\x2191" :
                   ((g_smcGomGlobalDir == "BEAR" || g_smcGomGlobalDir == "SELL") ? "\x2193" : "=");
   mtfLine += "| GL" + gArrow + IntegerToString(g_smcGomGlobalStr) + "%";

   // â”€â”€ Setup actif : un seul, le plus pertinent maintenant (remplace  â”€â”€
   // â”€â”€ OTE tracker + Pattern-line + DOW affichÃ©s en parallÃ¨le) â”€â”€â”€â”€â”€â”€â”€
   string setupLine = "Setup: â€”";
   int n = SMC_GetReactionTracker(_Symbol);
   bool oteReady = (g_smcOteTop > 0 && g_smcOteBot > 0);
   if(oteReady && g_smcInOTE)
   {
      string tk = (n >= 0 && g_reactionTrackers[n].m5Reacted) ? "AUTORISÃ‰" :
                  (n >= 0 && g_reactionTrackers[n].stayAway) ? "BLOQUÃ‰ (M5 requis)" : "SURVEILLANCE";
      setupLine = StringFormat("Setup: OTE [%s..%s] â€” %s",
                     DoubleToString(g_smcOteBot, _Digits), DoubleToString(g_smcOteTop, _Digits), tk);
   }
   else if(g_dowState.active)
   {
      setupLine = "Setup: DOW " + (g_dowState.isBearish ? "SELL" : "BUY");
   }
   else if(patLine != "Pattern: off")
   {
      setupLine = patLine;
   }

   // â”€â”€ Ligne spike (seulement si le symbole est de type Boom/Crash/PainX/GainX) â”€â”€
   string spikeLine = (StringLen(g_unifiedSpikeLine) > 0 && SMC_GetSymbolCategory(_Symbol) == SYM_BOOM_CRASH)
                       ? g_unifiedSpikeLine : "";

   // â”€â”€ Ligne cross-corrÃ©lation (seulement si un signal est actif) â”€â”€â”€
   string corrLine = g_crossCorrState.signalActive
      ? StringFormat("Corr: signal depuis %s (%.0f%%)", g_crossCorrState.triggerSymbol, g_crossCorrState.signalStrength * 100)
      : "";

   // â”€â”€ Discipline / risque du jour â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   string discLine = StringFormat("Trades jour: %d/%d%s", g_dailyTradeCount, MaxDailyTrades,
                                   g_dailyTargetHit ? " (objectif atteint)" : "");

   string text = StringFormat(
      "%s | %s | GOM %s | %s\n"
      "%s\n"
      "MTF  %s\n"
      "%s\n"
      "Pos: %d/%d (%s: %d/1) | P&L: %s$ (max %s$) | %s%s%s%s",
      _Symbol, catStr, SMCGP_GomLinkOK() ? "OK" : "OFF", PRO_DashboardLine(),
      gomStr,
      mtfLine,
      setupLine,
      totalPos, MaxPositionsTerminal, _Symbol, posCount,
      DoubleToString(totalPL, 2), DoubleToString(MaxTotalLossDollars, 0),
      discLine,
      (StringLen(spikeLine) > 0 ? "\n" + spikeLine : ""),
      (StringLen(corrLine) > 0 ? "\n" + corrLine : ""),
      (ShowMLMetrics && StringLen(g_mlMetricsStr) > 0 ? "\n" + g_mlMetricsStr : ""));

   if(ObjectFind(0, name) < 0)
      ObjectCreate(0, name, OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, 8);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, 20);
   ObjectSetInteger(0, name, OBJPROP_COLOR, frameColor);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, 9);
   ObjectSetString(0, name, OBJPROP_FONT, "Consolas");
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_BACK, false);
   ObjectSetString(0, name, OBJPROP_TEXT, text);

   ChartRedraw(0);
}

//+------------------------------------------------------------------+
//| NOUVEAU 2026-09-19 (demande Sidoine) : rÃ©tablit l'affichage de la |
//| tendance par timeframe (D1/H4/H1/M15/M5/M1) sur le graphique.     |
//| Les variables g_smcTfXxxDir existent dÃ©jÃ  et pilotent le TF Gate  |
//| (voir SMC_TFGate.mqh) mais n'Ã©taient plus affichÃ©es Ã  l'Ã©cran â€”   |
//| ce panneau les rend visibles, indÃ©pendamment du TF Gate lui-mÃªme. |
//| La DÃ‰TERMINATION (direction + force %) est 100% calculÃ©e par      |
//| ai_server (tf_*_dir + tf_*_strength). L'EA ne fait QUE l'afficherâ€”|
//| aucun recalcul local de tendance sur le graphique.                |
//+------------------------------------------------------------------+

//+------------------------------------------------------------------+
//| FIX 2026-09-26b : direction M1/M5 locale fidÃ¨le au prix           |
//| Quand GOM est OFF ou en retard, le panneau TF ne doit pas rester  |
//| BULL alors que le prix corrige. Recalcul sur rates chart.         |
//+------------------------------------------------------------------+
string SMC_LocalTfDirFromRates(ENUM_TIMEFRAMES tf, const int lookBars = 6)
{
   MqlRates r[];
   ArraySetAsSeries(r, true);
   int need = MathMax(lookBars + 2, 12);
   if(CopyRates(_Symbol, tf, 0, need, r) < need) return "";

   int consecBear = 0, consecBull = 0;
   for(int i = 0; i < lookBars; i++)
   {
      if(r[i].close < r[i].open)
      {
         if(consecBull > 0) break;
         consecBear++;
      }
      else if(r[i].close > r[i].open)
      {
         if(consecBear > 0) break;
         consecBull++;
      }
      else break;
   }

   double d1 = r[0].close - r[1].close;
   double d3 = r[0].close - r[MathMin(3, ArraySize(r)-1)].close;
   // Pente nette sur la fenÃªtre (fidÃ©litÃ© structurelle)
   double slope = r[0].close - r[lookBars - 1].close;

   double hi = r[0].high, lo = r[0].low;
   for(int i = 1; i < lookBars; i++)
   {
      if(r[i].high > hi) hi = r[i].high;
      if(r[i].low < lo) lo = r[i].low;
   }
   double rng = hi - lo;
   if(rng <= 0) rng = _Point;
   double fromHigh = (hi - r[0].close) / rng;
   double fromLow  = (r[0].close - lo) / rng;

   // 1) Pente dominante de la fenÃªtre > micro-bougie isolÃ©e
   if(slope < -rng * 0.15 && fromHigh >= 0.35) return "BEAR";
   if(slope >  rng * 0.15 && fromLow  >= 0.35) return "BULL";

   if(d1 < 0 && d3 < 0 && consecBear >= 1) return "BEAR";
   if(d1 > 0 && d3 > 0 && consecBull >= 1) return "BULL";
   if(consecBear >= 2) return "BEAR";
   if(consecBull >= 2) return "BULL";
   if(fromHigh >= 0.50 && slope <= 0) return "BEAR";
   if(fromLow  >= 0.50 && slope >= 0) return "BULL";
   // Micro-correction isolÃ©e contre pente â†’ NEUT (pas faux UP/DOWN)
   if(slope < 0 && consecBull >= 1 && consecBear == 0) return "NEUT";
   if(slope > 0 && consecBear >= 1 && consecBull == 0) return "NEUT";
   if(consecBear >= 1 && d1 < 0) return "BEAR";
   if(consecBull >= 1 && d1 > 0) return "BULL";
   return "";
}

void SMC_RefreshLocalTfDirsForDisplay()
{
   // FIX v1.34: Utiliser UNIQUEMENT les tendances serveur (EMA)
   // Ne plus Ã©craser avec calcul local - incohÃ©rence entre serveur et EA
   // Fallback local uniquement si serveur dÃ©connectÃ©
   if(!g_smcGomConnected)
   {
      string m1loc = SMC_LocalTfDirFromRates(PERIOD_M1, 8);
      if(StringLen(m1loc) > 0)
      {
         g_smcTfM1DirLive = m1loc;
         g_smcTfM1Dir = m1loc;
      }
      string m5loc = SMC_LocalTfDirFromRates(PERIOD_M5, 6);
      if(StringLen(m5loc) > 0) g_smcTfM5Dir = m5loc;
      string m15loc = SMC_LocalTfDirFromRates(PERIOD_M15, 5);
      if(StringLen(m15loc) > 0) g_smcTfM15Dir = m15loc;
      string h1loc = SMC_LocalTfDirFromRates(PERIOD_H1, 5);
      if(StringLen(h1loc) > 0) g_smcTfH1Dir = h1loc;
      string h4loc = SMC_LocalTfDirFromRates(PERIOD_H4, 4);
      if(StringLen(h4loc) > 0) g_smcTfH4Dir = h4loc;
      string d1loc = SMC_LocalTfDirFromRates(PERIOD_D1, 4);
      if(StringLen(d1loc) > 0) g_smcTfD1Dir = d1loc;
   }
   // Si connectÃ©: ne rien faire - garder les valeurs serveur (dÃ©jÃ  assignÃ©es dans SMCGP_PollGOM)
}

void SMC_DrawTFTrendPanel()
{
   SMCGP_RestoreCachedIfDisconnected();
   SMC_RefreshLocalTfDirsForDisplay();
   if(!UseDashboard && !UseUnifiedDashboard) return;

   string labels[6] = {"D1", "H4", "H1", "M15", "M5", "M1"};
   string dirs[6];
   int srvStr[6];

   dirs[0] = g_smcTfD1Dir;  dirs[1] = g_smcTfH4Dir;  dirs[2] = g_smcTfH1Dir;
   dirs[3] = g_smcTfM15Dir; dirs[4] = g_smcTfM5Dir;
   // FIX 2026-09-26b : M1 affiche le flux live (correction) pas EMA lagguÃ©e
   dirs[5] = (StringLen(g_smcTfM1DirLive) > 0) ? g_smcTfM1DirLive : g_smcTfM1Dir;
   srvStr[0] = g_smcTfD1Str;  srvStr[1] = g_smcTfH4Str;  srvStr[2] = g_smcTfH1Str;
   srvStr[3] = g_smcTfM15Str; srvStr[4] = g_smcTfM5Str;  srvStr[5] = g_smcTfM1Str;

   int baseX = 10;
   int baseY = UseUnifiedDashboard ? 118 : 155;
   int boxW  = 54;
   int boxH  = 20;

   string title = "TFPANEL_TITLE";
   if(ObjectFind(0, title) < 0) ObjectCreate(0, title, OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, title, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, title, OBJPROP_XDISTANCE, baseX);
   ObjectSetInteger(0, title, OBJPROP_YDISTANCE, baseY - 15);
   ObjectSetString(0, title, OBJPROP_TEXT, "TENDANCE PAR TIMEFRAME (force %)");
   ObjectSetInteger(0, title, OBJPROP_COLOR, clrSilver);
   ObjectSetInteger(0, title, OBJPROP_FONTSIZE, 8);
   ObjectSetString(0, title, OBJPROP_FONT, "Arial Bold");
   ObjectSetInteger(0, title, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, title, OBJPROP_BACK, false);

   for(int i = 0; i < 6; i++)
   {
      color bg = clrDimGray;
      color fg = clrWhite;
      if(dirs[i] == "BULL") { bg = clrLimeGreen;  fg = clrBlack; }
      else if(dirs[i] == "BEAR") { bg = clrCrimson; fg = clrWhite; }

      string boxName = "TFPANEL_BOX_" + labels[i];
      if(ObjectFind(0, boxName) < 0)
      {
         ObjectCreate(0, boxName, OBJ_RECTANGLE_LABEL, 0, 0, 0);
         ObjectSetInteger(0, boxName, OBJPROP_CORNER, CORNER_LEFT_UPPER);
         ObjectSetInteger(0, boxName, OBJPROP_XSIZE, boxW - 3);
         ObjectSetInteger(0, boxName, OBJPROP_YSIZE, boxH);
         ObjectSetInteger(0, boxName, OBJPROP_BORDER_TYPE, BORDER_FLAT);
         ObjectSetInteger(0, boxName, OBJPROP_SELECTABLE, false);
         ObjectSetInteger(0, boxName, OBJPROP_BACK, false);
      }
      ObjectSetInteger(0, boxName, OBJPROP_XDISTANCE, baseX + i * boxW);
      ObjectSetInteger(0, boxName, OBJPROP_YDISTANCE, baseY);
      ObjectSetInteger(0, boxName, OBJPROP_BGCOLOR, bg);
      ObjectSetInteger(0, boxName, OBJPROP_COLOR, bg);

      string txtName = "TFPANEL_TXT_" + labels[i];
      if(ObjectFind(0, txtName) < 0)
      {
         ObjectCreate(0, txtName, OBJ_LABEL, 0, 0, 0);
         ObjectSetInteger(0, txtName, OBJPROP_CORNER, CORNER_LEFT_UPPER);
         ObjectSetInteger(0, txtName, OBJPROP_FONTSIZE, 8);
         ObjectSetString(0, txtName, OBJPROP_FONT, "Arial Bold");
         ObjectSetInteger(0, txtName, OBJPROP_SELECTABLE, false);
         ObjectSetInteger(0, txtName, OBJPROP_BACK, false);
      }
      string arrow = (dirs[i] == "BULL") ? "â–²" : (dirs[i] == "BEAR" ? "â–¼" : "â€”");
      string pctTxt = (srvStr[i] > 0) ? " " + IntegerToString(srvStr[i]) + "%" : "";
      ObjectSetInteger(0, txtName, OBJPROP_XDISTANCE, baseX + i * boxW + 3);
      ObjectSetInteger(0, txtName, OBJPROP_YDISTANCE, baseY + 4);
      ObjectSetString(0, txtName, OBJPROP_TEXT, labels[i] + " " + arrow + pctTxt);
      ObjectSetInteger(0, txtName, OBJPROP_COLOR, fg);
   }

   // Ligne globale : force GOM consolidÃ©e (toutes TFs)
   string gLine = "TFPANEL_GLOBAL";
   if(ObjectFind(0, gLine) < 0) ObjectCreate(0, gLine, OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, gLine, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, gLine, OBJPROP_XDISTANCE, baseX);
   ObjectSetInteger(0, gLine, OBJPROP_YDISTANCE, baseY + 24);
   int locBull = 0, locBear = 0;
   for(int gi = 0; gi < 6; gi++)
   {
      if(dirs[gi] == "BULL") locBull++;
      else if(dirs[gi] == "BEAR") locBear++;
   }
   string locDir = (locBull > locBear) ? "BULL" : ((locBear > locBull) ? "BEAR" : "NEUT");
   int locStr = (int)MathRound(100.0 * MathMax(locBull, locBear) / 6.0);
   string gDir = (SMCGP_GomLinkOK() && StringLen(g_smcGomGlobalDir) > 0) ? g_smcGomGlobalDir : locDir;
   int gStr = (SMCGP_GomLinkOK() && g_smcGomGlobalStr > 0) ? g_smcGomGlobalStr : locStr;
   string gArrow = (gDir == "BULL" || gDir == "BUY") ? "â–²" :
                   ((gDir == "BEAR" || gDir == "SELL") ? "â–¼" : "â€”");
   string gTxt = "GLOBAL " + gArrow + " " + IntegerToString(gStr) + "%";
   if(gStr <= 0 && g_smcGomVerdictNum != 0)
   {
      gArrow = (g_smcGomVerdictNum > 0) ? "â–²" : "â–¼";
      gTxt = "GLOBAL " + gArrow + " " + g_smcGomVerdict;
   }
   ObjectSetString(0, gLine, OBJPROP_TEXT, gTxt);
   ObjectSetInteger(0, gLine, OBJPROP_COLOR, (gStr >= 70) ? clrLime : clrGold);
   ObjectSetInteger(0, gLine, OBJPROP_FONTSIZE, 8);
   ObjectSetString(0, gLine, OBJPROP_FONT, "Arial Bold");
   ObjectSetInteger(0, gLine, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, gLine, OBJPROP_BACK, false);

   ChartRedraw(0);
}

void UpdateMLMetricsDisplay()
{
   Print("ðŸ” DEBUG - UpdateMLMetricsDisplay appelÃ©e pour: ", _Symbol);
   
   // Protection contre les appels excessifs - minimum 30 s entre les appels
   if((TimeCurrent() - g_lastMLMetricsUpdate) < 30)
   {
      Print("ðŸ” DEBUG - UpdateMLMetricsDisplay ignorÃ©e (trop rÃ©cent)");
      return;
   }
   
   g_lastMLMetricsUpdate = TimeCurrent();
   string symEnc = _Symbol;
   StringReplace(symEnc, " ", "%20");
   string baseUrl = AI_ServerURL;
   string pathMetrics = "/ml/metrics?symbol=" + symEnc + "&timeframe=M1";
   string pathStatus = "/ml/continuous/status";
   string headers = "";
   char post[], result[];
   string resultHeaders;
   
   Print("ðŸ” DEBUG - RequÃªte ML vers: ", baseUrl, pathMetrics);
   
   // RÃ©cupÃ©rer les mÃ©triques ML
   int res = WebRequest("GET", baseUrl + pathMetrics, headers, AI_Timeout_ms, post, result, resultHeaders);
   
   Print("ðŸ” DEBUG - WebRequest ML metrics - Code: ", res, " | Taille: ", ArraySize(result));
   
   if(res == 200)
   {
      string metricsData = CharArrayToString(result);
      Print("ðŸ” DEBUG - DonnÃ©es ML reÃ§ues: ", StringSubstr(metricsData, 0, MathMin(200, StringLen(metricsData))));
      
      // Parser les mÃ©triques et les afficher (clÃ©s plates: accuracy, model_name, total_samples, status, feedback_wins, feedback_losses)
      if(StringFind(metricsData, "accuracy") >= 0)
      {
         string acc = ExtractJsonValue(metricsData, "accuracy");
         string model = ExtractJsonValue(metricsData, "model_name");
         string samples = ExtractJsonValue(metricsData, "total_samples");
         string status = ExtractJsonValue(metricsData, "status");
         string wins = ExtractJsonValue(metricsData, "feedback_wins");
         string losses = ExtractJsonValue(metricsData, "feedback_losses");
         g_mlMetricsStr = "PrÃ©cision: " + acc + "% | ModÃ¨le: " + model + " | Samples: " + samples;
         if(wins != "N/A" && losses != "N/A")
            g_mlMetricsStr += " | Feedback: " + wins + "W/" + losses + "L";
         if(status != "N/A" && status != "trained")
            g_mlMetricsStr += " | " + (status == "collecting_data" ? "Collecte donnÃ©es..." : status);
         Print("âœ… DEBUG - MÃ©triques ML mises Ã  jour: ", g_mlMetricsStr);
      }
      else if(StringFind(metricsData, "status") >= 0)
      {
         string status = ExtractJsonValue(metricsData, "status");
         g_mlMetricsStr = (status == "collecting_data") ? "ML: Collecte de donnÃ©es en cours..." : "ML: " + status;
      }
      else
      {
         g_mlMetricsStr = "ML: En attente de donnÃ©es...";
         Print("âš ï¸ DEBUG - Pas de mÃ©triques trouvÃ©es");
      }
   }
   else
   {
      // Fallback vers les mÃ©triques par dÃ©faut
      g_mlMetricsStr = "ML: En attente de donnÃ©es...";
      Print("âŒ DEBUG - Erreur WebRequest ML metrics: ", res);
   }
   
   // RÃ©cupÃ©rer le statut du canal
   int resStatus = WebRequest("GET", baseUrl + pathStatus, headers, AI_Timeout_ms, post, result, resultHeaders);
   
   Print("ðŸ” DEBUG - WebRequest ML status - Code: ", resStatus);
   
   if(resStatus == 200)
   {
      string statusData = CharArrayToString(result);
      g_channelValid = (StringFind(statusData, "\"valid\": true") >= 0);
      Print("âœ… DEBUG - Canal ML valide: ", g_channelValid ? "OUI" : "NON");
   }
   else
   {
      g_channelValid = false;
      Print("âŒ DEBUG - Erreur WebRequest ML status: ", resStatus);
   }
}

string ExtractJsonValue(string json, string key)
{
   string searchKey = "\"" + key + "\":";
   int start = StringFind(json, searchKey);
   if(start < 0) return "N/A";
   
   start += StringLen(searchKey);
   while(start < StringLen(json) && (json[start] == ' ' || json[start] == '\t')) start++;
   
   int end = start;
   while(end < StringLen(json) && json[end] != ',' && json[end] != '}' && json[end] != '\n') end++;
   
   string value = StringSubstr(json, start, end - start);
   StringReplace(value, "\"", "");
   StringReplace(value, " ", "");
   
   return value;
}

//| FONCTIONS IA - COMMUNICATION AVEC LE SERVEUR (copie legacy)       |

bool UpdateAIDecision_Legacy(int timeoutMs = -1)
{
   // Protection contre les appels excessifs
   static datetime lastAttempt = 0;
   datetime currentTime = TimeCurrent();
   if(currentTime - lastAttempt < 5) return false; // Max 1 appel / 5 secondes
   lastAttempt = currentTime;
   
   string symEnc = _Symbol;
   StringReplace(symEnc, " ", "%20");
   
   // Utiliser Render en premier si configurÃ©
   string baseUrl = AI_ServerURL;
   string path = "/ml/decision?symbol=" + symEnc + "&timeframe=M1";
   string headers = "";
   char post[], result[];
   string resultHeaders;
   
   int res = WebRequest("GET", baseUrl + path, headers, timeoutMs > 0 ? timeoutMs : AI_Timeout_ms, post, result, resultHeaders);
   
   if(res != 200)
   {
      // Fallback vers l'autre URL si Ã©chec
      string fallbackUrl = AI_ServerURL;
      res = WebRequest("GET", fallbackUrl + path, headers, timeoutMs > 0 ? timeoutMs : AI_Timeout_ms, post, result, resultHeaders);
      
      if(res != 200)
      {
         Print("âŒ ERREUR IA - Ã‰chec des deux serveurs: ", res);
         return false;
      }
   }
   
   string jsonData = CharArrayToString(result);
   ProcessAIDecision(jsonData);
   
   Print("âœ… DÃ©cision IA reÃ§ue - Action: ", g_lastAIAction, " | Confiance: ", DoubleToString(g_lastAIConfidence*100, 1), "%");
   return true;
}

