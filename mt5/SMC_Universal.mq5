// Garde generale anti-giveback (TOUJOURS active, independante de la chaine confirmee) :
// suit le pic de profit par ticket et ferme immediatement (marche) des que la
// position a rendu plus de GeneralGiveBackMaxPct % de ce pic. C'est la regle
// "normale" par defaut ; la garde specifique 1er spike (ci-dessous) est l'EXCEPTION
// qui la suspend temporairement, mais uniquement quand une vraie chaine de
// compression forte (3 spikes, ~3-5 bougies d'ecart) est confirmee.
ulong    g_giveBackTicket[128];
double   g_giveBackPeak[128];
int      g_giveBackCount = 0;

// Garde stagnation/temps (SMC_ManageStagnationTimeExit) : suit par ticket le pic de
// profit et l'heure de son dernier nouveau pic, pour detecter un gain qui "fige"
// (oscille sans progresser) et le securiser au lieu de laisser le trailing classique
// prendre le relais. Sert aussi de filet de securite temporel pour les positions qui
// ne deviennent jamais franchement profitables (cf. StagnationMaxAgeMinutes /
// TimeCutMaxAgeMinutes ci-dessous).
ulong    g_stagTicket[128];
double   g_stagPeakProfit[128];
datetime g_stagPeakTime[128];
int      g_stagCount = 0;

// Garde anti-giveback sur le 1er spike tant qu'on attend le 2e (clÃ´ture bougie)
