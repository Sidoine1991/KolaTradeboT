void OnTimer()
{
   SMC_SpikeBlink_WatchArrowOnTimer();
   if(g_spikeBlink.state != SPIKE_BLINK_IDLE)
      SMC_SpikeBlink_Toggle();
   SMCGP_OnTimer();
   VP_OnTimerTick();   // FIX v1.46: profil de volume/POC temps rÃ©el
   SMC_WA_DailyReportTick();   // FIX v1.50: rapport quotidien PsychoBot
   SMC_WA_TradeEventTick();      // FIX v1.53: notif chaque trade

   // GOM Scanner 10-min multi-symbol
   GOMSCAN_ScanAll();

   // FIX v1.43: filet de gestion hors-tick. Observation 22:01-22:03 (Weltrade):
   // micro-deconnexions -> plus de ticks -> OnTick muet -> trailing $ inactif
   // pendant que le SL restait fige ("no connection" sur les modifies). OnTimer
   // tourne toutes les 1s meme sans tick: on revalide la gestion des positions
   // au max toutes les 2s horloge murale.
   static uint s_mgrSafetyLastMs = 0;
   const uint nowMs = GetTickCount();
   if(s_mgrSafetyLastMs == 0 || nowMs - s_mgrSafetyLastMs >= 2000)
   {
      s_mgrSafetyLastMs = nowMs;
      SMC_ManageDynamicDollarSL();
      ManageDollarExits();
      SMC_SyncServerSLToDynamicLimit();
   }

   // Canal + bougies futures : dessin visuel uniquement (aucun impact sur les gates d'entrÃ©e).
   static datetime s_lastForecastDraw = 0;
   if((ShowPredictionChannel || ShowPredictedSwing) &&
      TimeCurrent() - s_lastForecastDraw >= 5)
   {
      if(ShowPredictionChannel)
         DrawPredictionChannel();
      if(ShowPredictedSwing && PredictedCandlesCount > 0 && g_channelValid)
         DrawPredictedSwingPoints();
      s_lastForecastDraw = TimeCurrent();
   }
}

bool TryAcquireOpenLock()
{
   if(UseDailyCapitalManager)
   {
      string cmReason = "";
      if(CM_IsEntryBlocked(cmReason))
      {
         static datetime s_lastCmLog = 0;
         if(TimeCurrent() - s_lastCmLog >= 60)
         {
            Print("ðŸ›‘ Capital Manager â€” entrÃ©e bloquÃ©e: ", cmReason);
            s_lastCmLog = TimeCurrent();
         }
         return false;
      }
   }

   // â”€â”€ SESSION FILTER: Volatility hors fenÃªtre optimale â†’ bloquer â”€â”€
   if(!SMC_IsVolSessionActive())
   {
      static datetime s_lastSessLog = 0;
      if(TimeCurrent() - s_lastSessLog >= 300)
      {
         Print("ðŸ• SESSION VOL â€” hors fenÃªtre (", VolSessionStart1, "h-", VolSessionEnd1, "h / ",
               VolSessionStart2, "h-", VolSessionEnd2, "h UTC) | ", _Symbol);
         s_lastSessLog = TimeCurrent();
      }
      return false;
   }

   // â”€â”€ LOSS COOLDOWN: pause aprÃ¨s perte rÃ©cente sur ce symbole â”€â”€
   if(UseLossCooldown && IsRecentLossOnSymbol(_Symbol))
   {
      int remain = (int)(LossCooldownMinutes * 60 - (TimeCurrent() - g_lastLossTime));
      if(remain > 0)
      {
         static datetime s_lastCoolLog = 0;
         if(TimeCurrent() - s_lastCoolLog >= 60)
         {
            Print("â³ COOLDOWN â€” perte rÃ©cente sur ", _Symbol, " | reste ",
                  remain / 60, "min ", remain % 60, "s");
            s_lastCoolLog = TimeCurrent();
         }
         return false;
      }
   }

   string lockName = "SMC_OPEN_LOCK_" + IntegerToString(InpMagicNumber);
   string lockTimeName = lockName + "_TIME";
   
   // VÃ©rification simple sans Sleep pour Ã©viter dÃ©tachement
   double lockValue = GlobalVariableGet(lockName);
   if(lockValue != 0)
   {
      // VÃ©rifier si le lock est trop ancien (plus de 30 secondes) = deadlock possible
      double lockTime = GlobalVariableGet(lockTimeName);
      if(lockTime > 0 && (TimeCurrent() - lockTime) > 30)
      {
         Print("âš ï¸ OPEN LOCK TIMEOUT â€” libÃ©ration forcÃ©e aprÃ¨s ", (int)(TimeCurrent() - lockTime), "s");
         GlobalVariableSet(lockName, 0);
         GlobalVariableSet(lockTimeName, 0);
      }
      else
      {
         return false; // Lock actif et valide
      }
   }
   
   // VÃ©rifier cooldown minimum entre deux ordres (2 secondes)
   static datetime s_lastOpenTime = 0;
   if(s_lastOpenTime > 0 && (TimeCurrent() - s_lastOpenTime) < 2)
   {
      return false; // Cooldown actif
   }
   
   // AcquÃ©rir le lock
   GlobalVariableSet(lockName, 1);
   GlobalVariableSet(lockTimeName, (double)TimeCurrent());
   
   if(IsTerminalFull()) 
   { 
      GlobalVariableSet(lockName, 0); 
      GlobalVariableSet(lockTimeName, 0);
      return false; 
   }
   
   s_lastOpenTime = TimeCurrent();
   return true;
}
void ReleaseOpenLock() 
{ 
   GlobalVariableSet("SMC_OPEN_LOCK_" + IntegerToString(InpMagicNumber), 0); 
   GlobalVariableSet("SMC_OPEN_LOCK_" + IntegerToString(InpMagicNumber) + "_TIME", 0); 
   // CORRECTIF DUPLICATION (demande Sidoine) : ReleaseOpenLock() est appelÃ© Ã 
   // TOUS les points de sortie (~30 sites), succÃ¨s ou Ã©chec, aprÃ¨s chaque
   // tentative d'ouverture. SMC_ReleaseTerminalOpenLock() Ã©tait dÃ©finie mais
   // n'Ã©tait jamais appelÃ©e nulle part dans tout le fichier : le verrou global
   // inter-graphiques posÃ© par SMC_AcquireTerminalOpenLock() (dans
   // SMC_FinalOpenGate) restait donc actif jusqu'Ã  expiration (90s), qu'une
   // position ait rÃ©ellement Ã©tÃ© ouverte ou non. On le libÃ¨re ici aussi ;
   // SMC_ReleaseTerminalOpenLock() ne supprime le verrou QUE s'il n'y a
   // effectivement aucune position ouverte de notre EA (CountPositionsOurEA()==0),
   // donc si l'ouverture a rÃ©ussi, le verrou reste bien en place tant que la
   // position existe â€” ce qui est exactement le comportement voulu : jamais
   // une 2e position tant que la 1Ã¨re est ouverte, mais pas de blocage inutile
   // si la tentative a Ã©chouÃ©.
   SMC_ReleaseTerminalOpenLock();
}

//+------------------------------------------------------------------+
//| Helper pour normaliser le SL selon le minimum step du broker     |
//| FIX 2026-09-20: Ajout vÃ©rification distance minimale (stops level)|
//+------------------------------------------------------------------+
double NormalizeSLForBroker(const string symbol, double newSL, double currentSL)
{
   if(newSL == currentSL) return newSL;
   
   double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
   long digits = SymbolInfoInteger(symbol, SYMBOL_DIGITS);
   double minStep = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);
   if(minStep <= 0.0) minStep = point;
   
   // FIX 2026-09-20: VÃ©rifier distance minimale exigÃ©e par le broker (stops level)
   int stopsLvl = (int)SymbolInfoInteger(symbol, SYMBOL_TRADE_STOPS_LEVEL);
   double minDist = (double)(stopsLvl + 2) * point;
   
   double bid = SymbolInfoDouble(symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(symbol, SYMBOL_ASK);
   
   // VÃ©rifier que le SL respecte la distance minimale par rapport au prix
   bool isBuySL = (newSL < bid); // SL pour position BUY est sous le prix
   if(isBuySL && (bid - newSL) < minDist)
   {
      // Ajuster pour respecter la distance minimale
      newSL = NormalizeDouble(bid - minDist, (int)digits);
   }
   else if(!isBuySL && (newSL - ask) < minDist)
   {
      // SL pour position SELL est au-dessus du prix
      newSL = NormalizeDouble(ask + minDist, (int)digits);
   }
   
   double slDiff = MathAbs(newSL - currentSL);
   if(slDiff < minStep && slDiff > 0.0)
   {
      // Ajuster au step le plus proche
      if(newSL > currentSL)
         newSL = NormalizeDouble(currentSL + MathCeil((newSL - currentSL) / minStep) * minStep, (int)digits);
      else
         newSL = NormalizeDouble(currentSL + MathFloor((newSL - currentSL) / minStep) * minStep, (int)digits);
   }
   
   return newSL;
}

void OnDeinit(const int reason)
{
   VP_Cleanup(); // FIX v1.46

   // Diagnostic du dÃ©tachement - identifier la cause exacte
   string reasonStr = "";
   switch(reason)
   {
      case REASON_PROGRAM:     reasonStr = "EA supprimÃ© manuellement"; break;
      case REASON_REMOVE:      reasonStr = "EA retirÃ© du graphique"; break;
      case REASON_RECOMPILE:   reasonStr = "EA recompilÃ©"; break;
      case REASON_CHARTCHANGE: reasonStr = "Symbole/pÃ©riode changÃ©"; break;
      case REASON_CHARTCLOSE:  reasonStr = "Graphique fermÃ©"; break;
      case REASON_PARAMETERS:  reasonStr = "ParamÃ¨tres modifiÃ©s"; break;
      case REASON_ACCOUNT:     reasonStr = "Compte changÃ©"; break;
      case REASON_TEMPLATE:    reasonStr = "Template appliquÃ©"; break;
      case REASON_INITFAILED:  reasonStr = "OnInit a Ã©chouÃ© (CRASH)"; break;
      case REASON_CLOSE:       reasonStr = "Terminal fermÃ©"; break;
      default:                 reasonStr = "Autre (code " + IntegerToString(reason) + ")"; break;
   }
   Print("ðŸš¨ DÃ‰TACHEMENT ROBOT SMC | ", _Symbol, " | Raison: ", reasonStr);
   if(reason == REASON_INITFAILED)
      Print("âš ï¸ CAUSE: Erreur dans OnInit ou crash (indicateurs, mÃ©moire, etc.)");

   SMC_SpikeBlink_Deinit();
   SMCGP_Deinit();

   // Cleanup new algorithmic modules
   SMC_AI_Deinit();              // Adaptive Instrument Filtering
   SMC_Range_Deinit();           // Advanced Range Detection
   SMC_Risk_Deinit();            // Advanced Risk Manager
   SMC_PGI_Deinit();             // Pattern-GOM Integration
   SMC_MSR_Deinit();             // Missed Spike Reentry
   SMC_DTE_Deinit();             // DOW Touch Entry
   SMC_PC_Deinit();              // Performance Cache
   SMC_OPF_Deinit();             // Opportunity Filter
   SMC_GOMTrust_Deinit();        // GOM Trust System

   if(atrHandle != INVALID_HANDLE) { IndicatorRelease(atrHandle); atrHandle = INVALID_HANDLE; }
   if(emaHandle != INVALID_HANDLE) { IndicatorRelease(emaHandle); emaHandle = INVALID_HANDLE; }
   if(ema50H != INVALID_HANDLE) { IndicatorRelease(ema50H); ema50H = INVALID_HANDLE; }
   if(ema200H != INVALID_HANDLE) { IndicatorRelease(ema200H); ema200H = INVALID_HANDLE; }
   if(fractalH != INVALID_HANDLE) { IndicatorRelease(fractalH); fractalH = INVALID_HANDLE; }
   if(emaM1H != INVALID_HANDLE) { IndicatorRelease(emaM1H); emaM1H = INVALID_HANDLE; }
   if(emaM5H != INVALID_HANDLE) { IndicatorRelease(emaM5H); emaM5H = INVALID_HANDLE; }
   if(emaH1H != INVALID_HANDLE) { IndicatorRelease(emaH1H); emaH1H = INVALID_HANDLE; }
   if(emaFastM1 != INVALID_HANDLE) { IndicatorRelease(emaFastM1); emaFastM1 = INVALID_HANDLE; }
   if(emaSlowM1 != INVALID_HANDLE) { IndicatorRelease(emaSlowM1); emaSlowM1 = INVALID_HANDLE; }
   if(emaFastM5 != INVALID_HANDLE) { IndicatorRelease(emaFastM5); emaFastM5 = INVALID_HANDLE; }
   if(emaSlowM5 != INVALID_HANDLE) { IndicatorRelease(emaSlowM5); emaSlowM5 = INVALID_HANDLE; }
   if(emaFastH1 != INVALID_HANDLE) { IndicatorRelease(emaFastH1); emaFastH1 = INVALID_HANDLE; }
   if(emaSlowH1 != INVALID_HANDLE) { IndicatorRelease(emaSlowH1); emaSlowH1 = INVALID_HANDLE; }
   if(atrM1 != INVALID_HANDLE) { IndicatorRelease(atrM1); atrM1 = INVALID_HANDLE; }
   if(atrM5 != INVALID_HANDLE) { IndicatorRelease(atrM5); atrM5 = INVALID_HANDLE; }
   if(atrH1 != INVALID_HANDLE) { IndicatorRelease(atrH1); atrH1 = INVALID_HANDLE; }
   if(atrH4 != INVALID_HANDLE) { IndicatorRelease(atrH4); atrH4 = INVALID_HANDLE; }
