//+------------------------------------------------------------------+

//| FIX 2026-10-22 : LIMIT DOW conserve pendant un WAIT court          |

//| Cause : SMC_CancelAllPendingsOnWait supprimait tout pending des    |

//| le 1er tick WAIT (appelee par SMC_UpdateGomWaitTimer).             |

//+------------------------------------------------------------------+

input int DowLimitKeepOnWaitSec = 86400; // Garder LIMIT DOW pendant WAIT (defaut 24h — ne pas purger les LIMIT inutilises)



bool SMC_IsDowLimitComment(const string cm)

{

   string u = cm;

   StringToUpper(u);

   return (StringFind(u, "DOW") >= 0);

}



// true = LIMIT DOW survit au WAIT (jamais purger un LIMIT DOW non rempli)

bool SMC_DowLimitSurvivesWait(const ENUM_ORDER_TYPE otype, const string cm)

{

   if(otype != ORDER_TYPE_BUY_LIMIT && otype != ORDER_TYPE_SELL_LIMIT) return false;

   if(!SMC_IsDowLimitComment(cm)) return false;

   if(DowLimitKeepOnWaitSec <= 0) return false;

   // Toujours conserver le LIMIT DOW tant que KeepOnWait > 0 (demande: ne pas supprimer les LIMIT inutilises)

   return true;

}



void SMC_CancelAllPendingsOnWait(const string symbol)

{

   if(g_smcGomConnected && g_smcGomVerdictNum != 0 && g_smcGomVerdictNum != -999)

      return;

   for(int i = OrdersTotal() - 1; i >= 0; i--)

   {

      ulong ticket = OrderGetTicket(i);

      if(ticket == 0) continue;

      if(!OrderSelect(ticket)) continue;

      if(OrderGetString(ORDER_SYMBOL) != symbol) continue;

      if((long)OrderGetInteger(ORDER_MAGIC) != InpMagicNumber) continue;

      long otype = OrderGetInteger(ORDER_TYPE);

      if(otype <= ORDER_TYPE_SELL) continue; // market deals not pending

      if(SMC_DowLimitSurvivesWait((ENUM_ORDER_TYPE)otype, OrderGetString(ORDER_COMMENT))) continue; // FIX 2026-10-22

      if(trade.OrderDelete(ticket))

         Print("PENDING annule (GOM WAIT/OFF) #", ticket, " ", symbol);

   }

}



void SMC_UpdateGomWaitTimer()

{

   if(!g_smcGomConnected || g_smcGomVerdictNum == 0)

   {

      if(g_gomWaitSince <= 0)

         g_gomWaitSince = TimeCurrent();

      SMC_CancelAllPendingsOnWait(_Symbol);

   }

   else

      g_gomWaitSince = 0;

}



bool SMC_GomWaitSustained(const int minSec)

{

   if(g_smcGomConnected && g_smcGomVerdictNum != 0)

      return false;

   if(g_gomWaitSince <= 0)

      return false;

   return ((int)(TimeCurrent() - g_gomWaitSince) >= minSec);

}



