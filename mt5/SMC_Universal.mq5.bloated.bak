// --- Repli de compatibilite : actif UNIQUEMENT si modules/SMC_Stubs.mqh est une ancienne version

//     (sans SMC_LimitMinGap / SMC_AlignToTick). Avec le nouveau stub, ce bloc est ignore (aucun doublon).

input bool LimitLegacyMinFloors = false; // true = anciens planchers fixes (Volatility 500 / Gold 200 / Forex 100 / defaut 30 pts) => LIMIT tres eloignes

#ifndef SMC_STUBS_LIMIT_HELPERS

input int LimitSafetyTicks = 15; // marge (ticks) entre un LIMIT et le prix marche (repli)

double SMC_LimitMinGap(const string sym)

{

   double point = SymbolInfoDouble(sym, SYMBOL_POINT);

   double tick  = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_SIZE);

   if(tick <= 0.0) tick = point;

   long lvl = MathMax(SymbolInfoInteger(sym, SYMBOL_TRADE_STOPS_LEVEL),

                      SymbolInfoInteger(sym, SYMBOL_TRADE_FREEZE_LEVEL));

   double spread = SymbolInfoDouble(sym, SYMBOL_ASK) - SymbolInfoDouble(sym, SYMBOL_BID);

   if(spread < 0.0) spread = 0.0;

   return (double)lvl * point + 2.0 * spread + (double)MathMax(0, LimitSafetyTicks) * tick;

}

double SMC_AlignToTick(const string sym, const double price, const bool roundUp)

{

   double tick = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_SIZE);

   int dg = (int)SymbolInfoInteger(sym, SYMBOL_DIGITS);

   double p = price;

   if(tick > 0.0)

   {

      double n = p / tick;

      n = roundUp ? MathCeil(n - 1e-9) : MathFloor(n + 1e-9);

      p = n * tick;

   }

   return NormalizeDouble(p, dg);

}

#endif

