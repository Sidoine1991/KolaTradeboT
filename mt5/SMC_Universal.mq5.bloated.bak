               if(currentTime - lastBUYAttempt >= 60)

               {

                  lastBUYAttempt = currentTime;

                  Print("[EA-INDEP] [OK] BUY autorise | Verdict=", g_smcGomVerdict, " | vn=", g_smcGomVerdictNum);

               }

            }



            // SELL si verdict negatif (vn <= -2)

            if(g_smcGomVerdictNum <= -2)

