input bool   UseGeneralGiveBackGuard      = true;  // Garde 30% TOUJOURS active (captures isolees, hors chaine confirmee)

input double GeneralGiveBackMaxPct        = 30.0;  // % max du pic de gain qu'on autorise a rendre (regle par defaut)

input double GeneralGiveBackMinPeakUSD    = 0.20;  // Pic de gain min ($) avant d'activer la garde generale



// FIX 2026-09-20 (Sidoine) : Entree sur touch DOW trendline pour synthetiques

// Basee sur l'observation historique : la majorite des spikes sur PainX 999

// respectent le touch de la trendline DOW en M1

// Note: UseDowTrendline est defini dans modules/SMC_DowTrendline.mqh

input bool   UseDowTouchEntry        = true;   // Activer entrée sur touch DOW

input double DowTouchDistancePoints  = 8.0;   // LIMIT un peu plus loin (évite fill au premier tick du touch)

input double DowTouchTolerancePoints = 1.5;   // Tolérance plus stricte

input int    DowTouchTimeoutSec      = 90;    // Timeout si pas de touch

input int    DowTouchMinHoldBarsM1   = 1;     // Attendre N bougies M1 après arm avant fill (anti entrée trop tôt)



input group "=== DOW TOUCH REVIVAL (v1.52) ==="

input bool   DTE_RevivalEnable     = false;  // Activer le rejaillissement DOW en correction (TEST - tuer si le pattern ne paye pas)

input int    DTE_RevivalCoherence  = 40;     // Coherence serveur min (%) pour le revival

input int    DTE_RevivalMaxPerDay  = 3;      // Max entrees revival par jour et par symbole

input int    DTE_RevivalTlBandPts  = 30;     // Bande de contact autour de la DOW line (points)

input bool   ChaseGuardEnable      = true;   // v1.54: bloquer les entrees trop loin de la DOW line (anti-chase)

input int    ChaseGuardMaxDistPts  = 80;     // v1.54: distance max Prix->DOW line (points)

input double DowTouchMinConfidence   = 0.7;   // Confiance minimale de la trendline



input group "=== OPPORTUNITY FILTER (modules/SMC_OpportunityFilter.mqh) ==="

input bool   UseOpportunityFilter    = false;  // FIX 2026-09-26e: false par defaut - bloquait trop d'entrees

input double MinVolatilityATR        = 0.5;    // Volatilite minimale (multiple de ATR)

input int    MaxConsecutiveLosses    = 3;      // Arreter apres X pertes consecutives

input int    CooldownAfterLossMin    = 30;     // Temps d'attente apres perte (minutes)

input bool   UseSessionFilter        = false;  // FIX v1.28: false - bloquait hors sessions

input bool   TradeLondonSession      = true;   // Autoriser session Londres

input bool   TradeNewYorkSession     = true;   // Autoriser session New York

input bool   TradeAsianSession       = false;  // Autoriser session Asie

input double MinTrendStrength        = 0.3;    // Force de tendance minimale (0-1)

input int    MinRangeBars            = 5;      // Nombre minimum de bougies avec range suffisant



input group "=== ICT KILLZONE FILTER (integre depuis SMC_Universal_Improved) ==="

input bool   UseICTKillzoneFilter    = false;  // Soft: uniquement les entrees ICT sweep (jamais le SL/TP)

input int    ServerToNYOffset        = 7;      // Decalage horaire (Heures) entre le Serveur et New York



input group "=== FAIR VALUE GAPS (FVG) (integre depuis SMC_Universal_Improved) ==="

input bool   UseFVGDetection         = true;   // FVG clotures + confluence Unified

input int    FVGMaxStored            = 50;     // Nombre max de FVGs stockes

input bool   UseFVGAutoEntrySpike    = true;   // Entree auto market sur FVG + verdict GOOD/PERFECT (spike symbols)

input bool   FVGAutoEntryRequireTFAlign = true; // Exiger alignement M1/M5 avec verdict pour entree FVG

input int    FVGAutoEntryCooldownSec = 300;    // Cooldown entre 2 entrees FVG auto (sec)

input bool   UseICTLiquiditySweep    = true;   // Sweep + reintegration (GOM GOOD/PERFECT)

input int    ICTSwingLookback        = 15;     // Lookback CHoCH M5 (Improved)



input group "=== GOM TRUST SYSTEM (modules/SMC_GOMTrust.mqh) ==="

input bool   UseGOMTrustSystem      = false;  // FIX 2026-09-26e: false par defaut - confiance froide bloquait tout

input int    MinTradesBeforeTrust    = 5;      // Nombre minimum de trades avant evaluation

input double MinTrustScore           = 0.4;    // Score de confiance minimum (0-1)

input int    TrustResetTrades        = 20;     // Nombre de trades pour reinitialiser le score

input bool   AutoBlockLowTrust      = true;   // Bloquer automatiquement les symboles a  faible confiance



input group "=== DYNAMIC GIVEBACK v2 (modules/SMC_DynamicGiveBack.mqh) ==="

input bool   UseAggressiveGiveBackCheck   = true;  // true = verifie a chaque tick (garde dynamique v2 active)

input double GiveBackMinPeakActivate      = 1.00;  // Pic min $1 avant giveback dynamique (évite coupe micro-spike)

input double GiveBackMaxPctGoodPerfect    = 30.0;  // % max de giveback tolere si verdict GOOD/PERFECT

input double GiveBackMaxPctSimple         = 45.0;  // % max de giveback tolere hors GOOD/PERFECT (capture simple)

input double GiveBackSoftWarningPct       = 30.0;  // % de giveback -> avertissement (log) + verrouillage progressif du SL

input double GiveBackHardExitPct          = 50.0;  // % de giveback -> cloture forcee au marche (filet de securite)



input group "=== PRICE SENSITIVITY (modules/SMC_PriceSensitivity.mqh) ==="

input bool   UsePriceSensitivityFilter = false;  // FIX v1.28: false - bloquait trop d'entrees

input double MinM1MomentumThreshold    = 0.00015; // Momentum M1 minimum (absolu)

input double MinM5MomentumThreshold    = 0.00025; // Momentum M5 minimum (absolu)

input double VolatilityCompressionThreshold = 0.70; // Seuil compression volatilite (BB squeeze)

input double VolumeSpikeMultiplier     = 1.35;    // Multiplicateur volume spike

input int    FlatPriceMaxBars          = 3;       // Max bougies prix plat autorisees

input double FlatPriceATRTolerance      = 0.00030; // Tolerance ATR pour prix plat

input bool   RequireVolumeConfirmation = true;   // Exiger confirmation volume

input bool   RequireCompressionForEntry = true; // Exiger compression pour entree



input group "=== ENTREES SMC PRECISES (niveaux cles uniquement) ==="

input bool   UsePreciseSMCEntryGate    = false;  // FIX v1.28: false - bloquait trop d'entrå°¤å…¶æ˜¯ FXVOL

input double SMCLevelATRTolerance      = 0.15;  // Tolerance ATR pour touch niveau SMC (15% ATR)

input bool   RequireM5Confirmation     = true;  // Exiger confirmation bougie M5 pour entree



input group "=== GOM LIVE ENTRY QUALITY (anti-verdict fige) ==="

input bool   UseLiveGOMEntryGate     = false;  // FIX v1.28: false - bloquait trop d'entrees

input bool   OverrideGOMWaitOnSMCAlign = false;  // FIX 2026-10-07: Contourner GOM WAIT si SMC/TF alignes

input double LiveAgainstATR          = 0.12;   // 1b+3b contre GOM (x ATR) -> refus

input double LiveChaseATR            = 2.20;   // Impulse 1200 / defaut (x ATR) sans pullback -> refus

input double LivePullbackMaxATR      = 0.45;   // Distance max au niveau (TL/DOW/swing) pour MARKET

input int    LiveLossPauseCount      = 3;      // Pertes rapides avant pause symbole

input int    LiveLossWindowMin       = 20;     // Fenetre des pertes rapides (min)

input int    LiveLossPauseMin        = 15;     // Duree de pause (min)

input int    LiveGOMMaxAgeSec        = 8;      // GOM trop vieux + M1 contraire -> refus

input bool   LiveRequireM5Closed     = true;   // MARKET : M5 cloturee (Vol/SFX toujours ; 1200 optionnel)



input group "=== CONSOLIDATION & WHIPSAW DETECTION ==="

input bool   UseConsolidationFilter    = false; // OFF: le range bloquait GOOD/PERFECT sans cassure

input bool   UseWhipsawFilter          = true;  // Bloquer les trades en mode whipsaw (oscillations gain/perte)

input int    ConsolidationLookbackBars = 30;    // Nombre de bougies M1 pour analyse consolidation

input double ConsolidationSlopeThreshold = 0.02; // Seuil pente ATR pour consolidation (2% ATR - plus strict)

input double ConsolidationR2Threshold   = 0.60;  // Seuil R² pour consolidation (fit qualite - plus strict)

input double ConsolidationMaxRangeATR  = 2.50;  // Largeur max du range (x ATR) pour le bloquer - avant: 0.5 trop strict

input bool   RequireRangeBreakout      = false; // OFF par defaut - Unified + ICT sweep gerent le timing

input double RangeBreakoutBufferATR    = 0.10;  // Marge de cassure au-dela  du high/low (x ATR)



input group "=== LIMIT LEVELS SPACING FILTER ==="

input bool   UseLimitSpacingFilter     = true;  // Bloquer MARKET si BUY/SELL limit trop serres (range)

input double LimitSpacingMinATR        = 0.50;  // Distance min entre BUY/SELL levels (x ATR)

input int    WhipsawMaxTransitions     = 2;     // Max transitions gain/perte avant blocage (plus strict)

input int    WhipsawResetMinutes       = 5;     // Minutes sans transition avant reset whipsaw



input group "=== STAGNATION / TEMPS DE DETENTION ==="

input bool   UseStagnationTimeExit     = true;   // Active la garde stagnation + filet de securite temps

input double StagnationMinPeakUSD      = 1.00;   // Pic min $ avant stagnation (évite sécuriser micro-gains PainX)

input int    StagnationMaxAgeMinutes   = 8;       // Sans nouveau pic pendant N min -> ferme si encore en gain

// Filet de securite temps - paliers DEGRESSIFS (Sidoine, 2026-09-14) :

// plus une position stagne longtemps sans jamais devenir franchement

// profitable, plus on tolere un plafond de perte eleve pour la couper -

// au lieu d'attendre systematiquement le stop $ fixe (MaxLossDollars).

// Avant, un seul palier (10 min / -1.00$) laissait une position bloquee

// entre -1.00$ et -MaxLossDollars$ ouverte indefiniment tant que le prix

// ne bougeait pas et que le verdict GOM ne passait pas a WAIT.

input int    TimeCutStage1AgeMinutes   = 8;       // Palier 1 : age min (minutes) — FX only (synth exempt)

input double TimeCutStage1MaxLossUSD   = 2.50;    // Palier 1 : proche du SL $3 (plus de coupe à $0.60)

input int    TimeCutMaxAgeMinutes      = 15;      // Palier 2 : age min (minutes)

input double TimeCutMaxLossUSD         = 2.80;    // Palier 2

input int    TimeCutStage3AgeMinutes   = 25;      // Palier 3 : age min (minutes)

input double TimeCutStage3MaxLossUSD   = 3.00;    // Palier 3 = SL max $3

input bool   TimeCutSkipSpikeSymbols   = true;    // PainX/GainX/Boom/Crash: pas de TimeCut (laisse SL $3)

input bool   RequireReactionConfluenceForChain = true; // Exiger confluence GOM_TF_TL_M1/DOW/DISP_FVG/M5 pour qualifier la chaine

input double ReactionBreakLossUSD = 1.50;            // Sortie apres cassure FVG sans spike (seuil $1.5)

input double ReactionTouchATRMult = 0.20;            // Tolerance de touch tick

input int    ReactionRearmWindowSec = 90;            // Fenetre de reentree apres retouch DOW

input int    ReactionM5RearmWindowSec = 300;         // Fenetre apres reaction GOM_TF_TL_M5

input bool   FirstSpikeGuardRequireChain = true;  // Exiger compression forte + chaine confirmee

input double FirstSpikeGuardMaxCompression = 0.65; // Ratio ATR recent/moyen maximum

input int    FirstSpikeGuardMinIntervalBars = 2;    // Ecart individuel minimum entre spikes

input int    FirstSpikeGuardMaxIntervalBars = 6;    // Ecart individuel maximum entre spikes

input double FirstSpikeGuardAvgIntervalMin = 3.0;   // Ecart moyen minimum (M1)

input double FirstSpikeGuardAvgIntervalMax = 5.0;   // Ecart moyen maximum (M1)

input int    SpikeChainExtraConfluenceGates = 2; // +1 confluence pour retarder entrée trop tôt sur DOW



input group "=== STRATEGIE CHAINE DE SPIKES H1/M5 (Kola) ==="

input bool   UseSCH1_Strategy          = true;  // Active la strategie "Chaine de Spikes" H1/M5

input bool   SCH1_RequireForBoomCrash  = true;  // Rend cette validation OBLIGATOIRE pour les trades Boom/Crash/Painx/Gainx

input int    SCH1_SR_Lookback          = 20;    // Nb bougies H1 pour Support/Resistance

input double SCH1_SR_ProximityATR      = 1.0;   // Proximite zone S/R H1 (x ATR H1)

input int    InpSCH1_ATR_Period        = 14;    // Periode ATR (M5/H1/H4) utilisee par le module

input double SCH1_SpikeATRMultiplier   = 2.0;   // Seuil range/ATR pour qu une bougie compte comme spike

input int    SCH1_ForceThreshold       = 60;    // Score de force mini (0-100, H1/H4) pour valider l impulsion

input int    SCH1_ForceLookbackH1      = 20;    // Bougies H1 pour la densite de spikes recents

input int    SCH1_MomentumBarsH1       = 10;    // Bougies H1 pour le momentum directionnel

input double SCH1_MomentumScale        = 10.0;  // Facteur d echelle du score momentum H1

input double SCH1_RejectionCloseThresholdPct = 50.0; // % max de retour dans le corps du spike M5 (rejet)

input int    SCH1_ChainMaxSpikes       = 4;     // Taille moyenne cible de la chaine (3 a 4 spikes)

input int    SCH1_ChainRetraceMaxBars  = 3;     // Nb de bougies M5 de retracement max avant chaine essoufflee

input bool   SCH1_TPUseSRExtension     = true;  // TP = extension mesuree au-dela de la S/R H1 opposee

input bool   SCH1_ManageChainPositions = true;  // Partial close + verrouillage SL a chaque nouveau spike

input double SCH1_PartialClosePct      = 30.0;  // % de cloture partielle a chaque spike supplementaire

input bool   SCH1_ShowPanel            = true;  // Afficher un panneau d info dedie sur le graphique



input group "=== SPIKE CHAIN ONNX PREDICTOR ==="

input bool   UseOnnxSpikeFilter    = true;   // Activer le filtre directionnel ONNX sur les trades spike

input string OnnxSpikeModelFile    = "spike_chain_model.onnx"; // Nom du fichier ONNX dans MQL5/Files/

input double MarkovUpGivenUp       = 0.80;   // P(spike UP | spike precedent UP) - remplacer par valeur reelle

input double MarkovUpGivenDown     = 0.80;   // P(spike UP | spike precedent DOWN) - remplacer par valeur reelle

input double OnnxBuyThreshold      = 0.65;   // Seuil P(up) min pour autoriser BUY sur Boom/Crash

input double OnnxSellThreshold     = 0.35;   // Seuil P(up) max pour autoriser SELL sur Boom/Crash

input bool   UseSessions       = true;   // Trader seulement LO/NYO

