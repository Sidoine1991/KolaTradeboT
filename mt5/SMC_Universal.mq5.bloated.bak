//+------------------------------------------------------------------+

//| GOM Immediate Market + Retrace State Machine (tick handler)

//| - Met a jour les trackers de confirmation M1

//| - Gere la sortie par timeout (pas de spike / pas de confirmation)

//+------------------------------------------------------------------+



//+------------------------------------------------------------------+

//| v1.34: MARKET sur GOOD/PERFECT + M5 confirmee + niveau touche     |

//| Quand le dashboard clignote ENTER BUY/SELL et le prix touche une  |

//| zone (DOW EP / SR / GOM TL), on entre au marche.                   |

//+------------------------------------------------------------------+

bool TryExecuteGOMPerfectEntry()

{

   if(!GOMPerfectAutoEntry) return false;

   if(!g_smcGomConnected) return false;

   if(MathAbs(g_smcGomVerdictNum) < 2) return false; // GOOD ou PERFECT

   if(IsTerminalFull()) return false;

   if(CountPositionsOurEA() >= MaxPositionsTerminal) return false;

   if(CountPositionsForSymbol(_Symbol) > 0) return false;



   string src = g_smcGomSource;

   StringToUpper(src);

   if(StringFind(src, "CACHE_STALE") >= 0 || StringFind(src, "NO_HTTP") >= 0)

      return false;

   if(g_smcLastGOMPoll > 0 && (TimeCurrent() - g_smcLastGOMPoll) > 120)

      return false;



   int dirSign = (g_smcGomVerdictNum > 0) ? 1 : -1;

   string wantDir = (dirSign > 0) ? "BUY" : "SELL";



   // M5 cloturee dans le sens - obligatoire

   if(!SMC_HasM5Confirmation(_Symbol, dirSign))

   {

      static datetime s_m5w = 0;

      if(TimeCurrent() - s_m5w >= 30)

      {

         s_m5w = TimeCurrent();

         Print("[GOM-PERFECT] attente M5 cloturee ", wantDir, " | vn=", g_smcGomVerdictNum);

      }

      return false;

   }



   // Prix proche d'un niveau d'entree (SMC / DOW / setup)

   string levelName = "";

   bool atLevel = SMC_IsAtValidSMCLevel(_Symbol, dirSign, levelName);

   // PERFECT (|vn|>=3) : tolerance elargie - si setup TV valide dans le meme sens

   if(!atLevel && MathAbs(g_smcGomVerdictNum) >= 3 && g_smcSetupValid)

   {

      double entry = g_smcSetupEntry;

      double price = (dirSign > 0) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK)

                                  : SymbolInfoDouble(_Symbol, SYMBOL_BID);

      double atr = 0;

      int hAtr = iATR(_Symbol, PERIOD_M5, 14);

      if(hAtr != INVALID_HANDLE)

      {

         double b[]; ArraySetAsSeries(b, true);

         if(CopyBuffer(hAtr, 0, 0, 1, b) >= 1) atr = b[0];

         IndicatorRelease(hAtr);

      }

      if(atr <= 0) atr = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 100;

      if(entry > 0 && MathAbs(price - entry) <= atr * 0.35)

      {

         atLevel = true;

         levelName = "GOM Setup Entry";

      }

   }

   // GOOD: aussi autoriser si proche du bid/ask recent swing dans le sens (0.25 ATR)

   if(!atLevel)

   {

      MqlRates r[]; ArraySetAsSeries(r, true);

      if(CopyRates(_Symbol, PERIOD_M5, 0, 15, r) >= 10)

      {

         double price = (dirSign > 0) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK)

                                     : SymbolInfoDouble(_Symbol, SYMBOL_BID);

         double atr = MathMax(r[1].high - r[1].low, SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10);

         if(dirSign > 0)

         {

            double swingLow = r[2].low;

            for(int i = 3; i < 12; i++) if(r[i].low < swingLow) swingLow = r[i].low;

            if(MathAbs(price - swingLow) <= atr * 0.40)

            { atLevel = true; levelName = "M5 Swing Low"; }

         }

         else

         {

            double swingHigh = r[2].high;

            for(int i = 3; i < 12; i++) if(r[i].high > swingHigh) swingHigh = r[i].high;

            if(MathAbs(price - swingHigh) <= atr * 0.40)

            { atLevel = true; levelName = "M5 Swing High"; }

         }

      }

   }

   if(!atLevel)

   {

      static datetime s_lv = 0;

      if(TimeCurrent() - s_lv >= 45)

      {

         s_lv = TimeCurrent();

         Print("[GOM-PERFECT] niveau non touche - attente pullback | ", wantDir,

               " vn=", g_smcGomVerdictNum);

      }

      return false;

   }



   // Cooldown anti-spam

   static datetime s_lastPerfectEntry = 0;

   static string   s_lastPerfectSym = "";

   if(s_lastPerfectSym == _Symbol && (TimeCurrent() - s_lastPerfectEntry) < 90)

      return false;



   if(!TryAcquireOpenLock()) return false;



   ENUM_ORDER_TYPE ot = (dirSign > 0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;

   if(!SMC_FinalOpenGate_Impl(_Symbol, ot))

   {

      ReleaseOpenLock();

      return false;

   }



   double lot = CalculateLotSize();

   if(lot <= 0) { ReleaseOpenLock(); return false; }



   string cmt = "GOM_PERFECT " + wantDir + " " + levelName;

   bool ok = false;

   if(dirSign > 0)

      ok = SafeTradeBuy(lot, _Symbol, 0, 0, 0, cmt);

   else

      ok = SafeTradeSell(lot, _Symbol, 0, 0, 0, cmt);



   if(ok)

   {

      s_lastPerfectEntry = TimeCurrent();

      s_lastPerfectSym = _Symbol;

      SMC_GateRegisterOpened(_Symbol, dirSign > 0);

      Print("[OK] GOM-PERFECT MARKET ", wantDir, " | ", _Symbol,

            " | vn=", g_smcGomVerdictNum, " | niveau=", levelName,

            " | lot=", DoubleToString(lot, 2));

   }

   else

      Print("âŒ GOM-PERFECT echec OrderSend | ret=", trade.ResultRetcode(),

            " ", trade.ResultRetcodeDescription());



   ReleaseOpenLock();

   return ok;

}





void SMC_GOM_ImmediateOnTick()

{

   if(!UseGOMImmediateMarket) return;

   if(!g_smcGomConnected) return;



   // Mise a jour des compteurs de barres / confirmation M1

   GOM_UpdateConfirmationTrackers();



   // Sortie par timeout (pas de spike / pas de confirmation) des positions GOM immediates

   for(int i = PositionsTotal() - 1; i >= 0; i--)

   {

      if(!posInfo.SelectByIndex(i)) continue;

      if(posInfo.Magic() != InpMagicNumber) continue;

      string cmt = posInfo.Comment();

      if(!SMC_IsImmediateEntryComment(cmt)) continue;

      ulong ticket = posInfo.Ticket();



      int barsSinceEntry = 0;

      if(!GOM_ShouldExitDueToTimeout(ticket, barsSinceEntry)) continue;



      Print("[GOM-IMM] Timeout no-spike exit - #", ticket,

            " ", posInfo.Symbol(), " bars=", barsSinceEntry,

            " | ", cmt);

      if(!PositionCloseWithLog(ticket, "GOM_IMM timeout no-spike", true))

         Print("âš ï¸ Echec fermeture GOM_IMM timeout - ticket=", ticket,

               " err=", GetLastError());

   }

}



int OnInit()

{

   Print("â•â•â• SMC_Universal v1.54 (anti-chase DOW - entrer pres du niveau, pas en haut) - build 2026-10-12 04:55 - chart=", _Symbol,

         " | gates scanner/chart harmonises + clamp ±3 + scan 2/cycle â•â•â•");



   if(ShowCognitionPath || ShowPredictionChannel || ShowPredictedSwing)

   {

      if(!ChartSetInteger(0, CHART_SHIFT, true))

         Print("[PRED-CANDLES] Impossible d'activer le decalage graphique: ", GetLastError());

      if(!ChartSetDouble(0, CHART_SHIFT_SIZE, 35.0))

         Print("[PRED-CANDLES] Impossible de reserver la marge future: ", GetLastError());

   }



   // FIX 2026-09-05: initialise le moteur de strategies Boom/Crash/PainX/GainX

   // (etait ecrit mais jamais appele nulle part avant).

   SMC_BC_Init();

   ArrayFill(g_tickFreqBuf, 0, 60, 0);



   trade.SetExpertMagicNumber(InpMagicNumber);

   trade.SetDeviationInPoints(20);

   trade.SetTypeFilling(ORDER_FILLING_IOC);

   

   atrHandle = iATR(_Symbol, LTF, 14);

   emaHandle = iMA(_Symbol, LTF, 9, 0, MODE_EMA, PRICE_CLOSE);

   rsiSqueezeHandle = iRSI(_Symbol, PERIOD_M5, RSISqueezePeriod, PRICE_CLOSE);

   ema50H = iMA(_Symbol, HTF, EMA50_Period, 0, MODE_EMA, PRICE_CLOSE);

   ema200H = iMA(_Symbol, HTF, EMA200_Period, 0, MODE_EMA, PRICE_CLOSE);

    // EMAs SMC sur le timeframe d'entree (LTF)

    ema21LTF = iMA(_Symbol, LTF, 21, 0, MODE_EMA, PRICE_CLOSE);

    ema23LTF = iMA(_Symbol, LTF, 23, 0, MODE_EMA, PRICE_CLOSE);

    ema25LTF = iMA(_Symbol, LTF, 25, 0, MODE_EMA, PRICE_CLOSE);

    ema28LTF = iMA(_Symbol, LTF, 28, 0, MODE_EMA, PRICE_CLOSE);

    ema31LTF = iMA(_Symbol, LTF, 31, 0, MODE_EMA, PRICE_CLOSE);

    ema50LTF = iMA(_Symbol, LTF, 50, 0, MODE_EMA, PRICE_CLOSE);

    ema100LTF = iMA(_Symbol, LTF, 100, 0, MODE_EMA, PRICE_CLOSE);

    ema200LTF = iMA(_Symbol, LTF, 200, 0, MODE_EMA, PRICE_CLOSE);

   ema50Chart  = iMA(_Symbol, PERIOD_CURRENT, 50,  0, MODE_EMA, PRICE_CLOSE);

   ema100Chart = iMA(_Symbol, PERIOD_CURRENT, 100, 0, MODE_EMA, PRICE_CLOSE);

   ema200Chart = iMA(_Symbol, PERIOD_CURRENT, 200, 0, MODE_EMA, PRICE_CLOSE);

   

   // Initialiser le systeme de gestion des pauses

   InitializeSymbolPauseSystem();

   CM_ResetIfNewDay();

   CM_RefreshDailyStats();



   // FIX 2026-10-07: Initialiser le tableau FVG

   ArrayResize(fvgDataArray, 0);

   ArraySetAsSeries(fvgDataArray, false);



   // Initialize Learning Journal + Trade Journal (apprentissage unifié)

   LJ_Init();

   if(ShowMLMetrics)

   {

      g_mlMetricsStr = "ML: sync...";

      g_lastMLMetricsUpdate = 0; // forcer 1er fetch au prochain tick

   }

   // FIX v1.57: charger learn_entry.onnx (gate P(win) sur shadows)

   if(UseLearnEntryOnnxGate)

   {

      if(!LE_OnnxInit())

         Print("[WARN] [LEARN-ONNX] init echouee — fail-open=", LE_OnnxFailOpen);

   }

   SMC_JournalConfigure(UseTradeJournal, InpMagicNumber, "SMC_Universal", TradeJournalBackfillDays);

   if(UseTradeJournal)

      SMC_JournalInit();



   Print("[INFO] SMC Universal + FVG_Kill PRO | 1 pos/symbole | Strategie visible");

   SH_Init();

   if(UseOTEStrategy) OTE_InitHandles();

   emaM1H = iMA(_Symbol, PERIOD_M1, 20, 0, MODE_EMA, PRICE_CLOSE);

   emaM5H = iMA(_Symbol, PERIOD_M5, 20, 0, MODE_EMA, PRICE_CLOSE);

   emaH1H = iMA(_Symbol, PERIOD_H1, 20, 0, MODE_EMA, PRICE_CLOSE);

   

   // Handles pour EMA Supertrend Multi-TF

   emaFastM1 = iMA(_Symbol, PERIOD_M1, EMAFastPeriod, 0, MODE_EMA, PRICE_CLOSE);

   emaSlowM1 = iMA(_Symbol, PERIOD_M1, EMASlowPeriod, 0, MODE_EMA, PRICE_CLOSE);

   emaFastM5 = iMA(_Symbol, PERIOD_M5, EMAFastPeriod, 0, MODE_EMA, PRICE_CLOSE);

   emaSlowM5 = iMA(_Symbol, PERIOD_M5, EMASlowPeriod, 0, MODE_EMA, PRICE_CLOSE);

   emaFastH1 = iMA(_Symbol, PERIOD_H1, EMAFastPeriod, 0, MODE_EMA, PRICE_CLOSE);

   emaSlowH1 = iMA(_Symbol, PERIOD_H1, EMASlowPeriod, 0, MODE_EMA, PRICE_CLOSE);

   atrM1 = iATR(_Symbol, PERIOD_M1, 14);

   atrM5 = iATR(_Symbol, PERIOD_M5, 14);

   atrH1 = iATR(_Symbol, PERIOD_H1, 14);

   atrH4 = iATR(_Symbol, PERIOD_H4, InpSCH1_ATR_Period); // Chaine de Spikes H1/M5

   // Verification robuste des handles

   if(atrHandle == INVALID_HANDLE)

   {

      Print("âŒ Erreur creation ATR - Tentative de recuperation...");

      atrHandle = iATR(_Symbol, LTF, 14);

      if(atrHandle == INVALID_HANDLE)

      {

         Print("âš ï¸ Erreur ATR - Utilisation ATR calcule manuellement pour eviter detachement");

         Comment("âš ï¸ ATR MANUEL - Robot fonctionnel");

         atrHandle = INVALID_HANDLE; // Garder INVALID_HANDLE mais continuer

      }

   }

   // Les indicateurs seront ajoutes dynamiquement si necessaire pour eviter le detachement

   GlobalVariableSet("SMC_OPEN_LOCK_" + IntegerToString(InpMagicNumber), 0);

   Print("[INFO] SMC Universal + FVG_Kill PRO | 1 pos/symbole | Strategie visible");

   Print("   Categorie: ", EnumToString(SMC_GetSymbolCategory(_Symbol)));

   Print("   Symbole GOM: ", _Symbol, " | Serveur: ", AI_ServerURL);

   Print("   IA: ", UseAIServer ? AI_ServerURL : "Desactive");

   SMCGP_Init();

   if(GOMSyncSymbolToTV)

      SMCGP_SendHeartbeat();



   // Spike Chain ONNX Predictor

   if(UseOnnxSpikeFilter && (IsBoomLikeSymbol(_Symbol) || IsCrashLikeSymbol(_Symbol)))

   {

      g_spikePredictorReady = g_spikePredictor.Init(OnnxSpikeModelFile, MarkovUpGivenUp, MarkovUpGivenDown);

      if(!g_spikePredictorReady)

         Print("âš ï¸ [ONNX] Modele spike chain non charge - filtre directionnel desactive sur ", _Symbol);

   }



   // Chain Predictor - moteur predictif de chaines

   ChainPred_Init();



   // Cross-Correlation - correlation croisee PainXâ†”GainX

   CrossCorr_Init();



   // Dow Trendline - trendline de Dow + LIMIT orders

   DowTrendline_Init();



    // TF Gate - alignement multi-timeframe

    TFGate_Init();



   // Nouveaux modules algorithmiques (Index Synthetics EA / EA Gold Stuff fix / SpikeRider EA / Infinity Trader EA)

   SMC_AI_Init();              // Adaptive Instrument Filtering

   SMC_Range_Init();           // Advanced Range Detection

   SMC_Risk_Init();            // Advanced Risk Manager

   SMC_PGI_Init();             // Pattern-GOM Integration

   SMC_MSR_Init();             // Missed Spike Reentry

   SMC_DTE_Init();             // DOW Touch Entry

   SMC_PC_Init();              // Performance Cache

   SMC_OPF_Init();             // Opportunity Filter

   SMC_GOMTrust_Init();        // GOM Trust System



    // DOW Scanner - scanner multi-symbole

    if(UseDowScanner)

    {

       // Configurer le scanner via g_state.config

       g_state.config.useDowScanner = UseDowScanner;

       g_state.config.inpPollSymbols = ScannerSymbols;

       g_state.config.scannerMaxSymbols = ScannerMaxSymbols;

       g_state.config.scannerIntervalSec = ScannerIntervalSec;

       g_state.config.scannerTopN = ScannerTopN;

       g_state.config.scannerMinScore = ScannerMinScore;

       g_state.config.maxLossUSD = ScannerMaxLossUSD;

       g_state.config.targetProfitUSD = ScannerTargetProfitUSD;

       g_state.config.maxOpenPositions = ScannerMaxOpenPos;

       g_state.config.maxPositionsPerSymbol = ScannerMaxPerSym;

       g_state.config.useWhatsApp2 = ScannerUseWhatsApp;

       g_state.config.useATRTrail = ScannerUseATRTrail;

       g_state.config.limitATRThreshold = ScannerLimitATRThresh;



       DOWSCAN_Init();

       ADAPTIVE_Init();

       ATRTRAIL_Init();

    }



    //--- GOM Auto-Convert: configurer depuis inputs

    g_state.config.gomAutoConvertPending     = GOMAutoConvertPending;

    g_state.config.gomAutoConvertMinQuality  = GOMAutoConvertMinQuality;

    g_state.config.gomAutoConvertMinRuntimeSec = GOMAutoConvertMinRuntimeSec;



   // PRO v1.55 : calcul initial; PRO_Update initialise aussi ses handles à la demande.

   PRO_OnTimer(); // FIX 2026-10-24: réactivé pour calculer g_confluenceScore, g_orderMoneyFlow, g_isImpulsiveRegime



   // FIX v1.28: Diagnostic au demarrage

   if(RunDiagnosticOnInit)

      SMC_RunTerminalDiagnostic();



   if(PlaceDiagnosticTestOrder)

      SMC_PlaceDiagnosticTestOrder();



    EventSetTimer(1);

    return INIT_SUCCEEDED;

}



void OnTimer()

{

   SMC_SpikeBlink_WatchArrowOnTimer();

   if(g_spikeBlink.state != SPIKE_BLINK_IDLE)

      SMC_SpikeBlink_Toggle();

   SMCGP_OnTimer();

   VP_OnTimerTick();   // FIX v1.46: profil de volume/POC temps reel

   // PRO v1.55 : actualiser régime impulsif, money flow et score après le POC.

   // PRO_OnTimer(); // v1.56: desactive — absent de ton modules/SMC_Universal_PRO_v155.mqh local (remettre si tu copies le PRO du ZIP)

   SMC_WA_DailyReportTick();   // FIX v1.50: rapport quotidien PsychoBot

   SMC_WA_TradeEventTick();      // FIX v1.53: notif chaque trade



   // GOM Scanner 10-min multi-symbol

   GOMSCAN_ScanAll();



   // FIX v1.43: filet de gestion hors-tick. Observation 22:01-22:03 (Weltrade):

   // micro-deconnexions -> plus de ticks -> OnTick muet -> trailing $ inactif

   // pendant que le SL restait fige ("no connection" sur les modifies). OnTimer

   // tourne toutes les 1s meme sans tick: on revalide la gestion des positions

   // au max toutes les 2s horloge murale.

   static uint s_mgrSafetyLastMs = 0;

   const uint nowMs = GetTickCount();

   if(s_mgrSafetyLastMs == 0 || nowMs - s_mgrSafetyLastMs >= 2000)

   {

      s_mgrSafetyLastMs = nowMs;

      SMC_ManageDynamicDollarSL();

      ManageDollarExits();

      SMC_SyncServerSLToDynamicLimit();

   }



   // Canal + bougies futures : dessin visuel uniquement (aucun impact sur les gates d'entree).

   static datetime s_lastForecastDraw = 0;

   if((ShowPredictionChannel || ShowPredictedSwing) &&

      TimeCurrent() - s_lastForecastDraw >= 5)

   {

      if(ShowPredictionChannel)

         DrawPredictionChannel();

      if(ShowPredictedSwing && PredictedCandlesCount > 0 && g_channelValid)

         DrawPredictedSwingPoints();

      s_lastForecastDraw = TimeCurrent();

   }

}



bool TryAcquireOpenLock()

{

   if(UseDailyCapitalManager)

   {

      string cmReason = "";

      if(CM_IsEntryBlocked(cmReason))

      {

         static datetime s_lastCmLog = 0;

         if(TimeCurrent() - s_lastCmLog >= 60)

         {

            Print("[STOP] Capital Manager - entree bloquee: ", cmReason);

            s_lastCmLog = TimeCurrent();

         }

         return false;

      }

   }



   // â”€â”€ SESSION FILTER: Volatility hors fenetre optimale -> bloquer â”€â”€

   if(!SMC_IsVolSessionActive())

   {

      static datetime s_lastSessLog = 0;

      if(TimeCurrent() - s_lastSessLog >= 300)

      {

         Print("[TIME] SESSION VOL - hors fenetre (", VolSessionStart1, "h-", VolSessionEnd1, "h / ",

               VolSessionStart2, "h-", VolSessionEnd2, "h UTC) | ", _Symbol);

         s_lastSessLog = TimeCurrent();

      }

      return false;

   }



   // â”€â”€ LOSS COOLDOWN: pause apres perte recente sur ce symbole â”€â”€

   if(UseLossCooldown && IsRecentLossOnSymbol(_Symbol))

   {

      int remain = (int)(LossCooldownMinutes * 60 - (TimeCurrent() - g_lastLossTime));

      if(remain > 0)

      {

         static datetime s_lastCoolLog = 0;

         if(TimeCurrent() - s_lastCoolLog >= 60)

         {

            Print("â³ COOLDOWN - perte recente sur ", _Symbol, " | reste ",

                  remain / 60, "min ", remain % 60, "s");

            s_lastCoolLog = TimeCurrent();

         }

         return false;

      }

   }



   string lockName = "SMC_OPEN_LOCK_" + IntegerToString(InpMagicNumber);

   string lockTimeName = lockName + "_TIME";

   

   // Verification simple sans Sleep pour eviter detachement

   double lockValue = GlobalVariableGet(lockName);

   if(lockValue != 0)

   {

      // Verifier si le lock est trop ancien (plus de 30 secondes) = deadlock possible

      double lockTime = GlobalVariableGet(lockTimeName);

      if(lockTime > 0 && (TimeCurrent() - lockTime) > 30)

      {

         Print("âš ï¸ OPEN LOCK TIMEOUT - liberation forcee apres ", (int)(TimeCurrent() - lockTime), "s");

         GlobalVariableSet(lockName, 0);

         GlobalVariableSet(lockTimeName, 0);

      }

      else

      {

         return false; // Lock actif et valide

      }

   }

   

   // Verifier cooldown minimum entre deux ordres (2 secondes)

   static datetime s_lastOpenTime = 0;

   if(s_lastOpenTime > 0 && (TimeCurrent() - s_lastOpenTime) < 2)

   {

      return false; // Cooldown actif

   }

   

   // Acquerir le lock

   GlobalVariableSet(lockName, 1);

   GlobalVariableSet(lockTimeName, (double)TimeCurrent());

   

   if(IsTerminalFull()) 

   { 

      GlobalVariableSet(lockName, 0); 

      GlobalVariableSet(lockTimeName, 0);

      return false; 

   }

   

   s_lastOpenTime = TimeCurrent();

   return true;

}

void ReleaseOpenLock() 

{ 

   GlobalVariableSet("SMC_OPEN_LOCK_" + IntegerToString(InpMagicNumber), 0); 

   GlobalVariableSet("SMC_OPEN_LOCK_" + IntegerToString(InpMagicNumber) + "_TIME", 0); 

   // CORRECTIF DUPLICATION (demande Sidoine) : ReleaseOpenLock() est appele a 

   // TOUS les points de sortie (~30 sites), succes ou echec, apres chaque

   // tentative d'ouverture. SMC_ReleaseTerminalOpenLock() etait definie mais

   // n'etait jamais appelee nulle part dans tout le fichier : le verrou global

   // inter-graphiques pose par SMC_AcquireTerminalOpenLock() (dans

   // SMC_FinalOpenGate) restait donc actif jusqu'a  expiration (90s), qu'une

   // position ait reellement ete ouverte ou non. On le libere ici aussi ;

   // SMC_ReleaseTerminalOpenLock() ne supprime le verrou QUE s'il n'y a

   // effectivement aucune position ouverte de notre EA (CountPositionsOurEA()==0),

   // donc si l'ouverture a reussi, le verrou reste bien en place tant que la

   // position existe - ce qui est exactement le comportement voulu : jamais

   // une 2e position tant que la 1ere est ouverte, mais pas de blocage inutile

   // si la tentative a echoue.

   SMC_ReleaseTerminalOpenLock();

}



//+------------------------------------------------------------------+

//| Helper pour normaliser le SL selon le minimum step du broker     |

//| FIX 2026-09-20: Ajout verification distance minimale (stops level)|

//+------------------------------------------------------------------+

double NormalizeSLForBroker(const string symbol, double newSL, double currentSL)

{

   if(newSL == currentSL) return newSL;

   

   double point = SymbolInfoDouble(symbol, SYMBOL_POINT);

   long digits = SymbolInfoInteger(symbol, SYMBOL_DIGITS);

   double minStep = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);

   if(minStep <= 0.0) minStep = point;

   

   // FIX 2026-09-20: Verifier distance minimale exigee par le broker (stops level)

   int stopsLvl = (int)SymbolInfoInteger(symbol, SYMBOL_TRADE_STOPS_LEVEL);

   double minDist = (double)(stopsLvl + 2) * point;

   

   double bid = SymbolInfoDouble(symbol, SYMBOL_BID);

   double ask = SymbolInfoDouble(symbol, SYMBOL_ASK);

   

   // Verifier que le SL respecte la distance minimale par rapport au prix

   bool isBuySL = (newSL < bid); // SL pour position BUY est sous le prix

   if(isBuySL && (bid - newSL) < minDist)

   {

      // Ajuster pour respecter la distance minimale

      newSL = NormalizeDouble(bid - minDist, (int)digits);

   }

   else if(!isBuySL && (newSL - ask) < minDist)

   {

      // SL pour position SELL est au-dessus du prix

      newSL = NormalizeDouble(ask + minDist, (int)digits);

   }

   

   double slDiff = MathAbs(newSL - currentSL);

   if(slDiff < minStep && slDiff > 0.0)

   {

      // Ajuster au step le plus proche

      if(newSL > currentSL)

         newSL = NormalizeDouble(currentSL + MathCeil((newSL - currentSL) / minStep) * minStep, (int)digits);

      else

         newSL = NormalizeDouble(currentSL + MathFloor((newSL - currentSL) / minStep) * minStep, (int)digits);

   }

   

   return newSL;

}



void OnDeinit(const int reason)

{

   VP_Cleanup(); // FIX v1.46



   // Diagnostic du detachement - identifier la cause exacte

   string reasonStr = "";

   switch(reason)

   {

      case REASON_PROGRAM:     reasonStr = "EA supprime manuellement"; break;

      case REASON_REMOVE:      reasonStr = "EA retire du graphique"; break;

      case REASON_RECOMPILE:   reasonStr = "EA recompile"; break;

      case REASON_CHARTCHANGE: reasonStr = "Symbole/periode change"; break;

      case REASON_CHARTCLOSE:  reasonStr = "Graphique ferme"; break;

      case REASON_PARAMETERS:  reasonStr = "Parametres modifies"; break;

      case REASON_ACCOUNT:     reasonStr = "Compte change"; break;

      case REASON_TEMPLATE:    reasonStr = "Template applique"; break;

      case REASON_INITFAILED:  reasonStr = "OnInit a echoue (CRASH)"; break;

      case REASON_CLOSE:       reasonStr = "Terminal ferme"; break;

      default:                 reasonStr = "Autre (code " + IntegerToString(reason) + ")"; break;

   }

   Print("[ALERT] DETACHEMENT ROBOT SMC | ", _Symbol, " | Raison: ", reasonStr);

   if(reason == REASON_INITFAILED)

      Print("[WARN] CAUSE: Erreur dans OnInit ou crash (indicateurs, memoire, etc.)");



   SMC_SpikeBlink_Deinit();

   SMCGP_Deinit();



   // Cleanup new algorithmic modules

   SMC_AI_Deinit();              // Adaptive Instrument Filtering

   SMC_Range_Deinit();           // Advanced Range Detection

   SMC_Risk_Deinit();            // Advanced Risk Manager

   SMC_PGI_Deinit();             // Pattern-GOM Integration

   SMC_MSR_Deinit();             // Missed Spike Reentry

   SMC_DTE_Deinit();             // DOW Touch Entry

   SMC_PC_Deinit();              // Performance Cache

   SMC_OPF_Deinit();             // Opportunity Filter

   SMC_GOMTrust_Deinit();        // GOM Trust System



   if(atrHandle != INVALID_HANDLE) { IndicatorRelease(atrHandle); atrHandle = INVALID_HANDLE; }

   if(emaHandle != INVALID_HANDLE) { IndicatorRelease(emaHandle); emaHandle = INVALID_HANDLE; }

   if(ema50H != INVALID_HANDLE) { IndicatorRelease(ema50H); ema50H = INVALID_HANDLE; }

   if(ema200H != INVALID_HANDLE) { IndicatorRelease(ema200H); ema200H = INVALID_HANDLE; }

   if(fractalH != INVALID_HANDLE) { IndicatorRelease(fractalH); fractalH = INVALID_HANDLE; }

   if(emaM1H != INVALID_HANDLE) { IndicatorRelease(emaM1H); emaM1H = INVALID_HANDLE; }

   if(emaM5H != INVALID_HANDLE) { IndicatorRelease(emaM5H); emaM5H = INVALID_HANDLE; }

   if(emaH1H != INVALID_HANDLE) { IndicatorRelease(emaH1H); emaH1H = INVALID_HANDLE; }

   if(emaFastM1 != INVALID_HANDLE) { IndicatorRelease(emaFastM1); emaFastM1 = INVALID_HANDLE; }

   if(emaSlowM1 != INVALID_HANDLE) { IndicatorRelease(emaSlowM1); emaSlowM1 = INVALID_HANDLE; }

   if(emaFastM5 != INVALID_HANDLE) { IndicatorRelease(emaFastM5); emaFastM5 = INVALID_HANDLE; }

   if(emaSlowM5 != INVALID_HANDLE) { IndicatorRelease(emaSlowM5); emaSlowM5 = INVALID_HANDLE; }

   if(emaFastH1 != INVALID_HANDLE) { IndicatorRelease(emaFastH1); emaFastH1 = INVALID_HANDLE; }

   if(emaSlowH1 != INVALID_HANDLE) { IndicatorRelease(emaSlowH1); emaSlowH1 = INVALID_HANDLE; }

   if(atrM1 != INVALID_HANDLE) { IndicatorRelease(atrM1); atrM1 = INVALID_HANDLE; }

   if(atrM5 != INVALID_HANDLE) { IndicatorRelease(atrM5); atrM5 = INVALID_HANDLE; }

   if(atrH1 != INVALID_HANDLE) { IndicatorRelease(atrH1); atrH1 = INVALID_HANDLE; }

   if(atrH4 != INVALID_HANDLE) { IndicatorRelease(atrH4); atrH4 = INVALID_HANDLE; }

   g_spikePredictor.Deinit();

   LE_OnnxDeinit();

   ChainPred_Cleanup();

   CrossCorr_Cleanup();

   DowTrendline_Cleanup();

   TFGate_Cleanup();

   SH_Cleanup();

   if(UseOTEStrategy) OTE_ReleaseHandles();

   if(UseDowScanner)

   {

      DOWSCAN_Cleanup();

   }

   EventKillTimer();

   SMCGP_CleanupChartObjects();

   ObjectsDeleteAll(0, "SCH1_PNL_");

