            win_vol = 6 if ultra else 10
            win_ma = 10 if ultra else 20
            vol = _pd.Series(closes).pct_change().rolling(win_vol).std().fillna(0).values
            ma = _pd.Series(closes).rolling(win_ma).mean().fillna(method='bfill').values
