                try:
                    # Détecter les pivots hauts et bas pour les trendlines
                    df_tail = st.session_state.real_time_data.tail(100)  # Utiliser les 100 dernières bougies
                    
                    # Détection des pivots hauts et bas
                    pivot_highs = df_tail[df_tail['high'] == df_tail['high'].rolling(window=5, center=True).max()].dropna()
                    pivot_lows = df_tail[df_tail['low'] == df_tail['low'].rolling(window=5, center=True).min()].dropna()
                
                except Exception:
                    pass
