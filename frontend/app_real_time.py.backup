            s_max = float(_np.percentile(s_tail, 95)) if len(s_tail) > 10 else float(score.max())
            if s_max <= s_min:
            if s_max <= s_min:
            s_max = s_min + 1e-6
            proba = _np.clip((score - s_min) / (s_max - s_min), 0, 1)
